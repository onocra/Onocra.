---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
const searchPath = getRelativeLocaleUrl(locale, "search");
---

<Layout>
  <Header />

  <!-- =========================================
       RESERVED ADVERTISEMENT SPACE
  ========================================== -->
  <aside
    class="border-border bg-background border-b"
    aria-label="Advertisement"
  >
    <div class="app-layout py-3 sm:py-4 lg:py-3">
      <div
        class="border-border flex h-20 items-center justify-center rounded-2xl border border-dashed bg-[var(--onocra-cream)] sm:h-24 lg:h-[72px]"
      >
        <span
          class="text-muted-foreground text-xs font-semibold tracking-[0.16em] uppercase"
        >
          Advertisement
        </span>
      </div>
    </div>
  </aside>

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <!-- =========================================
         ONOCRA WELCOME / HERO
    ========================================== -->
    <section class="border-border border-b py-8 sm:py-10 lg:py-10">

      <!-- =========================================
           ROW 1
           WELCOME + HOUSEHOLDER MESSAGE
      ========================================== -->
      <div
        class="grid items-center gap-6 md:grid-cols-[1.15fr_0.85fr] lg:gap-10"
      >
        <!-- LEFT: WELCOME -->
        <div>
          <p
            class="text-accent mb-2 text-sm font-bold tracking-[0.18em] uppercase"
          >
            Welcome!
          </p>

          <h1
            class="text-4xl leading-[1.05] font-bold tracking-tight sm:text-5xl lg:text-[3.5rem] xl:text-[4rem]"
          >
            <span class="block">TechnoNavigation</span>
            <span class="text-accent block">
              made easy.
            </span>
          </h1>

          <p
            class="mt-4 max-w-2xl text-lg leading-relaxed sm:text-xl"
          >
            Clear, practical answers for your everyday technology questions.
          </p>
        </div>

        <!-- RIGHT: HOUSEHOLDER MESSAGE -->
        <div
          class="rounded-3xl bg-[var(--onocra-sage)] p-6 sm:p-7 lg:p-8"
        >
          <p
            class="font-serif text-xl font-bold text-[var(--onocra-forest)] sm:text-2xl"
          >
            Designed for ordinary householders.
          </p>

          <p
            class="text-muted-foreground mt-3 leading-relaxed sm:text-lg"
          >
            Simple, step-by-step solutions for real-life technology
            problems at home — without the technical jargon.
          </p>
        </div>
      </div>

      <!-- =========================================
           ROW 2
           PELICAN + ONOCRA INTRODUCTION
      ========================================== -->
      <div
        class="mt-8 flex items-center gap-4 sm:gap-6 lg:mt-10 lg:gap-8"
      >
        <!--
          The current pelican faces toward the left.
          It is flipped horizontally here so that its
          face points toward the ONOCRA message.
        -->
        <img
          src="/welcomepelican.png"
          alt="ONOCRA pelican"
          class="w-28 shrink-0 object-contain sm:w-36 lg:w-44"
          style="transform: scaleX(-1);"
          loading="eager"
        />

        <div
          class="border-border flex-1 rounded-3xl border bg-[var(--onocra-cream)] p-5 shadow-sm sm:p-7 lg:p-8"
        >
          <p
            class="font-serif text-xl font-bold text-[var(--onocra-forest)] sm:text-2xl lg:text-3xl"
          >
            Hi there! I'm ONOCRA<span
              class="text-[var(--onocra-orange)]"
            >.</span>
          </p>

          <p
            class="text-muted-foreground mt-2 leading-relaxed sm:text-lg"
          >
            Let's make technology easier for your home.
          </p>
        </div>
      </div>

      <!-- =========================================
           ROW 3
           ASK ONOCRA
      ========================================== -->
      <div
        id="ask-onocra"
        class="mt-8 lg:mt-10"
      >
        <div
          class="mb-3 flex items-center justify-between gap-4"
        >
          <p
            class="text-sm font-bold tracking-[0.14em] uppercase"
          >
            Ask ONOCRA
          </p>

          <span
            class="text-muted-foreground hidden text-xs sm:inline"
          >
            Start with your question
          </span>
        </div>

        <form
          action={searchPath}
          method="get"
          class="border-border bg-background flex items-center gap-2 rounded-2xl border p-2 shadow-sm"
        >
          <input
            type="search"
            name="q"
            aria-label="Ask ONOCRA"
            placeholder="Tell me what's happening or ask a question..."
            class="text-foreground min-w-0 flex-1 bg-transparent px-3 py-3 outline-none"
          />

          <button
            type="submit"
            class="bg-accent text-accent-foreground shrink-0 rounded-xl px-5 py-3 font-bold sm:px-7"
          >
            Ask
          </button>
        </form>

        <div class="mt-3 flex flex-wrap gap-2">
          <a
            href={`${searchPath}?q=Wi-Fi%20not%20working`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Wi-Fi not working
          </a>

          <a
            href={`${searchPath}?q=Best%20phone%20for%20parents`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Best phone for parents
          </a>

          <a
            href={`${searchPath}?q=Windows%20update`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Windows update
          </a>

          <a
            href={`${searchPath}?q=Is%20this%20a%20scam`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Is this a scam?
          </a>

          <a
            href={`${searchPath}?q=Set%20parental%20controls`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Set parental controls
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================
         EXPLORE TECHNOLOGY TOPICS
    ========================================== -->
    <section
      id="topics"
      class="border-border border-b py-10 sm:py-14 lg:py-12"
    >
      <p
        class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
      >
        Start with what you need
      </p>

      <div
        class="mt-2 lg:flex lg:items-end lg:justify-between lg:gap-10"
      >
        <div>
          <h2 class="text-3xl font-bold sm:text-4xl">
            Explore Technology Topics
          </h2>

          <p
            class="text-muted-foreground mt-3 max-w-2xl leading-relaxed"
          >
            Choose the technology you need help with.
          </p>
        </div>
      </div>

      <div
        class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 xl:gap-4"
      >
        <!-- PHONES -->
        <a
          href={`${searchPath}?q=phones%20tablets`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/phones.png"
              alt="Phones and tablets"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Phones &amp; Tablets
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p
              class="text-muted-foreground mt-2 leading-relaxed xl:text-sm"
            >
              Setup, problems, features and buying help.
            </p>
          </div>
        </a>

        <!-- WI-FI -->
        <a
          href={`${searchPath}?q=home%20internet%20wifi`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/wifi.png"
              alt="Home internet and Wi-Fi"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Home Internet &amp; Wi-Fi
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p
              class="text-muted-foreground mt-2 leading-relaxed xl:text-sm"
            >
              Connections, routers, speed and coverage.
            </p>
          </div>
        </a>

        <!-- LAPTOPS -->
        <a
          href={`${searchPath}?q=computers%20laptops`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/laptops.png"
              alt="Computers and laptops"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Computers &amp; Laptops
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p
              class="text-muted-foreground mt-2 leading-relaxed xl:text-sm"
            >
              Windows, Mac, software and everyday fixes.
            </p>
          </div>
        </a>

        <!-- SAFETY -->
        <a
          href={`${searchPath}?q=safety%20security%20scams`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/safetysecurity.png"
              alt="Digital safety and security"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Safety &amp; Security
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p
              class="text-muted-foreground mt-2 leading-relaxed xl:text-sm"
            >
              Scams, privacy, passwords and safer accounts.
            </p>
          </div>
        </a>

        <!-- SMART HOME -->
        <a
          href={`${searchPath}?q=smart%20home`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/smarthome.png"
              alt="Smart home technology"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Smart Home
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p
              class="text-muted-foreground mt-2 leading-relaxed xl:text-sm"
            >
              TVs, cameras, speakers and connected devices.
            </p>
          </div>
        </a>

        <!-- APPS -->
        <a
          href={`${searchPath}?q=apps%20online%20services`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/apps.png"
              alt="Apps and online services"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />

    <!-- =========================================
         DIGITAL SAFETY — COMPACT HOMEPAGE TEASER
    ========================================== -->
    <section
      id="digital-safety"
      class="border-border border-b py-8 sm:py-10"
    >
      <div
        class="overflow-hidden rounded-3xl bg-[var(--onocra-forest)] text-white"
      >
        <div
          class="grid items-center md:grid-cols-[240px_1fr] lg:grid-cols-[280px_1fr]"
        >
          <!-- COMPACT VISUAL -->
          <div
            class="flex h-52 items-center justify-center overflow-hidden p-4 sm:h-56 md:h-full md:min-h-[290px]"
          >
            <img
              src="/DigitalSafety.png"
              alt="Digital Safety for families"
              class="h-full w-full rounded-2xl object-contain"
              loading="lazy"
            />
          </div>

          <!-- TEASER CONTENT -->
          <div class="p-6 pt-2 sm:p-7 md:p-8 md:pl-4 lg:p-9">
            <p
              class="text-sm font-bold tracking-[0.16em] uppercase opacity-80"
            >
              Stay Safe Online
            </p>

            <h2 class="mt-2 text-2xl font-bold sm:text-3xl">
              Digital Safety for Everyone
            </h2>

            <p
              class="mt-3 max-w-3xl leading-relaxed text-white/85"
            >
              Spot scams, protect your accounts and make everyday
              banking, shopping and communication safer.
            </p>

            <div
              class="mt-5 flex flex-wrap gap-2 text-sm"
            >
              <span class="rounded-full bg-white/10 px-4 py-2">
                Scam alerts
              </span>

              <span class="rounded-full bg-white/10 px-4 py-2">
                Safe payments
              </span>

              <span class="rounded-full bg-white/10 px-4 py-2">
                Privacy
              </span>

              <span class="rounded-full bg-white/10 px-4 py-2">
                Senior safety
              </span>
            </div>

            <a
              href={`${searchPath}?q=digital%20safety`}
              class="mt-5 inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 font-bold text-[var(--onocra-forest)]"
            >
              Explore Digital Safety
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================
         DIGITAL SAFETY
    ========================================== -->
    <section
      id="digital-safety"
      class="border-border border-b py-10 sm:py-14"
    >
      <div
        class="overflow-hidden rounded-3xl bg-[var(--onocra-forest)] text-white"
      >
        <div
          class="grid items-center lg:grid-cols-[0.72fr_1.28fr]"
        >
          <div
            class="flex items-center justify-center p-6 sm:p-8 lg:p-8"
          >
            <img
              src="/DigitalSafety.png"
              alt="Digital Safety for families"
              class="w-full max-w-sm rounded-2xl object-contain"
              loading="lazy"
            />
          </div>

          <div class="p-7 pt-2 sm:p-10 lg:pl-4">
            <p
              class="text-sm font-bold tracking-[0.16em] uppercase opacity-80"
            >
              Stay Safe Online
            </p>

            <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
              Digital Safety for Everyone
            </h2>

            <p class="mt-4 max-w-3xl text-lg leading-relaxed">
              Practical help to recognize scams, protect accounts and make
              online banking, shopping and communication safer for the whole
              household.
            </p>

            <div class="mt-7 grid gap-3 sm:grid-cols-2">
              <div class="rounded-xl bg-white/10 p-4">
                Spot scams and fake messages
              </div>

              <div class="rounded-xl bg-white/10 p-4">
                Safe banking and payments
              </div>

              <div class="rounded-xl bg-white/10 p-4">
                Privacy and account security
              </div>

              <div class="rounded-xl bg-white/10 p-4">
                Guides for seniors &amp; families
              </div>
            </div>

            <a
              href={`${searchPath}?q=digital%20safety`}
              class="mt-7 inline-block rounded-xl bg-white px-5 py-3 font-bold text-[var(--onocra-forest)]"
            >
              Explore Digital Safety →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================
         USEFUL NOW + REVIEWS
    ========================================== -->
    <section
      id="reviews"
      class="border-border border-b py-10 sm:py-14"
    >
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- USEFUL NOW -->
        <a
          href={`${searchPath}?q=useful%20now`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <img
            src="/usefulnow.png"
            alt="Useful Now technology help"
            class="aspect-[16/10] w-full object-cover lg:aspect-[16/8]"
            loading="lazy"
          />

          <div class="p-6 sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p
                  class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
                >
                  Useful Now
                </p>

                <h2 class="mt-2 text-2xl font-bold sm:text-3xl">
                  Help for everyday tech
                </h2>
              </div>

              <span
                class="text-accent text-3xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-3 leading-relaxed">
              Timely, practical answers to the technology questions households
              are dealing with right now.
            </p>
          </div>
        </a>

        <!-- REVIEWS -->
        <a
          href={`${searchPath}?q=reviews`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <img
            src="/reviews.png"
            alt="ONOCRA technology reviews"
            class="aspect-[16/10] w-full object-cover lg:aspect-[16/8]"
            loading="lazy"
          />

          <div class="p-6 sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p
                  class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
                >
                  Reviews
                </p>

                <h2 class="mt-2 text-2xl font-bold sm:text-3xl">
                  Understand before you buy
                </h2>
              </div>

              <span
                class="text-accent text-3xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-3 leading-relaxed">
              Practical product analysis, comparisons, alternatives and buying
              guidance for real households.
            </p>
          </div>
        </a>
      </div>
    </section>

    <!-- =========================================
         UPDATES ANCHOR
    ========================================== -->
    <div id="updates" class="scroll-mt-6"></div>

        <!-- =========================================
         DIGITAL PARENTING — COMPACT HOMEPAGE TEASER
    ========================================== -->
    <section
      id="digital-parenting"
      class="border-border border-b py-8 sm:py-10"
    >
      <div
        class="border-border overflow-hidden rounded-3xl border bg-[var(--onocra-cream)]"
      >
        <div
          class="grid items-stretch md:grid-cols-[1.25fr_0.75fr]"
        >
          <!-- CONTENT -->
          <div
            class="flex flex-col justify-center p-6 sm:p-8 lg:p-9"
          >
            <p
              class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
            >
              Digital Parenting
            </p>

            <h2
              class="mt-2 max-w-2xl text-2xl font-bold sm:text-3xl"
            >
              Helping families navigate technology together
            </h2>

            <p
              class="text-muted-foreground mt-3 max-w-2xl leading-relaxed"
            >
              Practical help with screen time, first phones, parental
              controls, gaming, social media, online safety and AI.
            </p>

            <!-- QUICK TOPICS -->
            <div class="mt-5 flex flex-wrap gap-2">
              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                Screen time
              </span>

              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                First phone
              </span>

              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                Parental controls
              </span>

              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                Online safety
              </span>
            </div>

            <!-- COLLABORATION + CTA -->
            <div
              class="mt-6 flex flex-wrap items-center gap-5"
            >
              <div
                class="border-border bg-background flex items-center gap-3 rounded-2xl border px-4 py-3"
              >
                <img
                  src="/seed%20and%20sapling.png"
                  alt="Seed & Sapling"
                  class="h-12 w-auto object-contain"
                  loading="lazy"
                />

                <div>
                  <p
                    class="text-muted-foreground text-xs font-semibold"
                  >
                    In collaboration with
                  </p>

                  <p class="text-sm font-bold">
                    Seed &amp; Sapling
                  </p>
                </div>
              </div>

              <a
                href={`${searchPath}?q=digital%20parenting`}
                class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-xl px-5 py-3 font-bold"
              >
                Explore Digital Parenting
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <!-- FAMILY VISUAL -->
          <div
            class="relative min-h-56 overflow-hidden sm:min-h-64 md:min-h-0"
          >
            <img
              src="/seedsapling2.png"
              alt="Parent and child learning together with technology"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />

            <div
              class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-5 pt-14 text-white"
            >
              <p class="text-sm font-semibold">
                Technology guidance for the whole family.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================
         GUIDES + ROUTES + STAY IN THE LOOP
    ========================================== -->
    <section class="border-border border-b py-10 sm:py-14">
      <div class="grid gap-6 lg:grid-cols-3">

        <!-- GUIDES -->
        <a
          id="guides"
          href={`${searchPath}?q=guides`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <img
            src="/guides.png"
            alt="ONOCRA step-by-step technology guides"
            class="aspect-[16/9] w-full object-cover"
            loading="lazy"
          />

          <div class="p-6">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p
                  class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
                >
                  Guides
                </p>

