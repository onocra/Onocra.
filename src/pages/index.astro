---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- ONOCRA HERO -->
    <section
      id="hero"
      class="border-border border-b pt-10 pb-10 sm:pt-14 sm:pb-14"
    >
      <p
        class="text-accent mb-4 text-sm font-bold tracking-[0.18em] uppercase"
      >
        TechnoNavigation Made Easy
      </p>

      <h1
        class="my-4 max-w-3xl text-4xl leading-tight font-bold tracking-tight sm:text-6xl"
      >
        From tech trouble to the right solution.
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-relaxed sm:text-xl">
        Clear, practical guidance to help you fix problems, understand
        technology, compare your options, and make smarter digital decisions.
      </p>
    </section>

    <!-- SIX ONOCRA HUBS -->
    <section class="border-border border-b py-10">
      <div class="grid gap-4 sm:grid-cols-2">

        <a
          href="/posts/"
          class="border-border hover:border-accent rounded-xl border p-5 transition"
        >
          <h2 class="text-xl font-bold">FIX</h2>
          <p class="mt-2">
            Solve a tech problem
          </p>
        </a>

        <a
          href="/posts/"
          class="border-border hover:border-accent rounded-xl border p-5 transition"
        >
          <h2 class="text-xl font-bold">CONNECT</h2>
          <p class="mt-2">
            Wi-Fi, mobile & networks
          </p>
        </a>

        <a
          href="/posts/"
          class="border-border hover:border-accent rounded-xl border p-5 transition"
        >
          <h2 class="text-xl font-bold">PROTECT</h2>
          <p class="mt-2">
            Security, privacy & safer digital life
          </p>
        </a>

        <a
          href="/posts/"
          class="border-border hover:border-accent rounded-xl border p-5 transition"
        >
          <h2 class="text-xl font-bold">USE</h2>
          <p class="mt-2">
            AI, apps & digital tools
          </p>
        </a>

        <a
          href="/posts/"
          class="border-border hover:border-accent rounded-xl border p-5 transition"
        >
          <h2 class="text-xl font-bold">UNDERSTAND</h2>
          <p class="mt-2">
            Technology explained clearly
          </p>
        </a>

        <a
          href="/posts/"
          class="border-border hover:border-accent rounded-xl border p-5 transition"
        >
          <h2 class="text-xl font-bold">BUY SMARTER</h2>
          <p class="mt-2">
            Compare before you buy
          </p>
        </a>

      </div>
    </section>

    <!-- ONOCRA DECISION JOURNEY -->
    <section class="py-10 sm:py-12">
      <p
        class="text-accent mb-3 text-sm font-bold tracking-[0.15em] uppercase"
      >
        The ONOCRA approach
      </p>

      <h2 class="text-2xl leading-relaxed font-bold sm:text-3xl">
        Trouble
        <span class="text-accent">→</span>
        Know-How
        <span class="text-accent">→</span>
        Compare
        <span class="text-accent">→</span>
        Solution
      </h2>

      <p class="mt-4 max-w-2xl leading-relaxed">
        Start with the problem. Understand what matters. Compare realistic
        options. Then choose the solution that actually makes sense.
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem(
        "backUrl",
        indexLayout.homePath ?? baseRoot
      );
    }
  });
</script>
