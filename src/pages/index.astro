<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem(
        "backUrl",
        indexLayout.homePath ?? baseRoot
      );
    }

    /* ASK ONOCRA — IMAGE CONTROL */

    const imageButton = document.querySelector(
      "#onocra-image-button"
    ) as HTMLButtonElement | null;

    const imageInput = document.querySelector(
      "#onocra-image-input"
    ) as HTMLInputElement | null;

    const imageStatus = document.querySelector(
      "#onocra-image-status"
    ) as HTMLElement | null;

    const imageName = document.querySelector(
      "#onocra-image-name"
    ) as HTMLElement | null;

    const imageRemove = document.querySelector(
      "#onocra-image-remove"
    ) as HTMLButtonElement | null;

    imageButton?.addEventListener("click", () => {
      imageInput?.click();
    });

    imageInput?.addEventListener("change", () => {
      const file = imageInput.files?.[0];

      if (!file) return;

      if (imageName) {
        imageName.textContent = file.name;
      }

      imageStatus?.classList.remove("hidden");
      imageStatus?.classList.add("flex");
    });

    imageRemove?.addEventListener("click", () => {
      if (imageInput) {
        imageInput.value = "";
      }

      imageStatus?.classList.add("hidden");
      imageStatus?.classList.remove("flex");
    });

    /* ASK ONOCRA — MICROPHONE CONTROL */

    const micButton = document.querySelector(
      "#onocra-mic-button"
    ) as HTMLButtonElement | null;

    const questionInput = document.querySelector(
      "#onocra-question"
    ) as HTMLInputElement | null;

    const SpeechRecognition =
      (window as any).SpeechRecognition ||
