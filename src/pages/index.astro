---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
const searchPath = getRelativeLocaleUrl(locale, "search");
const phonesPath = getRelativeLocaleUrl(locale, "phones");
const internetPath = getRelativeLocaleUrl(locale, "internet");
const computersPath = getRelativeLocaleUrl(locale, "computers");
const safetyPath = getRelativeLocaleUrl(locale, "safety");
---

<Layout
  title="ONOCRA — Practical Technology Help for Everyday Households"
  description="ONOCRA makes technology easier for ordinary householders with clear, practical answers, step-by-step fixes, plain-English explanations, useful comparisons and smarter buying guidance."
>
  <Header />


  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <!-- =========================================
         ONOCRA WELCOME HERO
    ========================================== -->
    <section class="border-border border-b pb-6 sm:pb-8">
      <div class="pt-3 sm:pt-4">
        <div class="overflow-hidden rounded-3xl">
          <img
            src="/homepage/pelicanhero.png"
            alt="ONOCRA welcomes ordinary householders to practical technology help, with Fix, Decode, Compare and Choose guidance for everyday tech questions."
            class="block h-auto w-full"
            width="2048"
            height="768"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <!--
          The hero artwork contains visual typography, but this real HTML gives
          people, assistive technology and search engines the same core message.
        -->
        <div class="mx-auto max-w-5xl px-1 pt-4 text-center sm:pt-5">
          <h1
            class="text-foreground font-serif text-2xl font-black tracking-[-0.02em] sm:text-3xl lg:text-4xl"
          >
            Practical technology help for ordinary householders
          </h1>

          <p
            class="text-muted-foreground dark:text-foreground/90 mx-auto mt-2 max-w-4xl text-sm leading-relaxed sm:text-base lg:text-lg"
          >
            ONOCRA makes TechnoNavigation easy with clear, practical answers for
            everyday technology questions — helping you fix problems, understand
            technology, compare your options and choose more confidently.
          </p>
        </div>
      </div>

      <!-- ASK ONOCRA -->
      <div id="ask-onocra" class="mt-4 sm:mt-5">
        <div class="mb-2.5 flex items-center justify-between gap-4">
          <p
            class="text-sm font-bold tracking-[0.14em] text-[#F4511E] uppercase sm:text-base"
          >
            Ask ONOCRA
          </p>

          <span class="text-muted-foreground hidden text-xs sm:inline">
            Type, speak or show me
          </span>
        </div>

        <form
          action={searchPath}
          method="get"
          class="border-border bg-background flex items-center gap-1 rounded-2xl border p-1.5 shadow-sm sm:gap-2"
        >
          <svg
            class="ml-2 h-5 w-5 shrink-0 text-[#F4511E] sm:ml-3"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>

          <input
            id="onocra-question"
            type="search"
            name="q"
            aria-label="Ask ONOCRA"
            placeholder="Tell me what's happening..."
            class="text-foreground min-w-0 flex-1 bg-transparent px-1.5 py-2.5 text-base outline-none sm:px-2"
          />

          <input
            id="onocra-image-input"
            type="file"
            accept="image/*"
            class="hidden"
          />

          <button
            id="onocra-image-button"
            type="button"
            title="Upload an image"
            aria-label="Upload an image"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-[#F4511E] transition hover:bg-[#F4511E]/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F4511E]"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14.5 4h-5L8 6H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-3z"></path>
              <circle cx="12" cy="13" r="3"></circle>
            </svg>
          </button>

          <button
            id="onocra-mic-button"
            type="button"
            title="Speak your question"
            aria-label="Speak your question"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-[#F4511E] transition hover:bg-[#F4511E]/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F4511E]"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="2" width="6" height="12" rx="3"></rect>
              <path d="M5 10a7 7 0 0 0 14 0"></path>
              <path d="M12 17v5"></path>
              <path d="M8 22h8"></path>
            </svg>
          </button>

          <button
            type="submit"
            class="shrink-0 rounded-xl bg-[#F4511E] px-4 py-2.5 font-bold text-white transition hover:bg-[#D84315] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F4511E] sm:px-7"
          >
            Ask
            <span class="hidden sm:inline" aria-hidden="true"> →</span>
          </button>
        </form>

        <div
          id="onocra-image-status"
          class="mt-2 hidden items-center gap-2 rounded-xl bg-[var(--onocra-sage)] px-3 py-2 text-sm text-[var(--onocra-forest)]"
        >
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <path d="m21 15-5-5L5 21"></path>
          </svg>

          <span id="onocra-image-name" class="min-w-0 flex-1 truncate">
            Image selected
          </span>

          <button
            id="onocra-image-remove"
            type="button"
            aria-label="Remove selected image"
            class="shrink-0 font-bold"
          >
            ×
          </button>
        </div>

        <div class="mt-2.5 flex items-center gap-2 overflow-x-auto pb-1">
          <span class="shrink-0 text-sm font-bold text-[#F4511E]">
            Try:
          </span>

          <a
            href={`${searchPath}?q=Wi-Fi%20not%20working`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Wi-Fi not working
          </a>

          <a
            href={`${searchPath}?q=Best%20phone%20for%20parents`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Best phone for parents
          </a>

          <a
            href={`${searchPath}?q=Windows%20update`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Windows update
          </a>

          <a
            href={`${searchPath}?q=Is%20this%20a%20scam`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Is this a scam?
          </a>

          <a
            href={`${searchPath}?q=Set%20parental%20controls`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Set parental controls
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================
         ADVERTISEMENT — AFTER HERO + ASK ONOCRA
         Keep advertising clearly separated from interactive controls.
    ========================================== -->
    <aside
      class="border-border border-b py-4 sm:py-5"
      aria-label="Advertisement"
    >
      <div
        class="border-border flex min-h-20 items-center justify-center rounded-2xl border border-dashed bg-[var(--onocra-cream)] px-4 sm:min-h-24 lg:min-h-[105px]"
      >
        <span
          class="text-muted-foreground text-[0.65rem] font-semibold tracking-[0.16em] uppercase"
        >
          Advertisement
        </span>
      </div>
    </aside>

    <!-- =========================================
         EXPLORE TECHNOLOGY TOPICS
    ========================================== -->
    <section
      id="topics"
      class="border-border border-b py-7 sm:py-9 lg:py-8"
    >
      <p class="text-accent text-sm font-bold tracking-[0.16em] uppercase">
        Start with what you need
      </p>

      <div class="mt-2">
        <h2 class="text-3xl font-bold sm:text-4xl">
          Explore Technology Topics
        </h2>

        <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed">
          Choose the technology you need help with.
        </p>
      </div>

      <div
        class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 xl:gap-4"
      >
        <!-- PHONES HUB -->
        <a
          href={phonesPath}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/phones.png"
              alt="Phones and tablets"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Phones &amp; Tablets
              </h3>

              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Setup, problems, features and buying help.
            </p>
          </div>
        </a>

        <!-- HOME INTERNET & WI-FI HUB -->
        <a
          href={internetPath}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/wifi.png"
              alt="Home internet and Wi-Fi"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Home Internet &amp; Wi-Fi
              </h3>

              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Connections, routers, speed and coverage.
            </p>
          </div>
        </a>

        <a
          href={computersPath}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/laptops.png"
              alt="Computers and laptops"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Computers &amp; Laptops
              </h3>

              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Windows, Mac, software and everyday fixes.
            </p>
          </div>
        </a>

        <a
          href={safetyPath}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/safetysecurity.png"
              alt="Digital safety and security"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Safety &amp; Security
              </h3>

              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Scams, privacy, passwords and safer accounts.
            </p>
          </div>
        </a>

        <a
          href={`${searchPath}?q=smart%20home`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/smarthome.png"
              alt="Smart home technology"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Smart Home
              </h3>

              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              TVs, cameras, speakers and connected devices.
            </p>
          </div>
        </a>

        <a
          href={`${searchPath}?q=apps%20online%20services`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/apps.png"
              alt="Apps and online services"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Apps &amp; Online Services
              </h3>

              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Useful apps, accounts, AI and digital services.
            </p>
          </div>
        </a>
      </div>
    </section>

    <!-- DIGITAL SAFETY -->
    <section
      id="digital-safety"
      class="border-border border-b py-7 sm:py-8"
    >
      <div class="mb-4 sm:mb-5">
        <p class="text-accent text-sm font-bold tracking-[0.16em] uppercase">
          Digital Safety
        </p>

        <h2
          class="mt-2 text-3xl font-bold text-[var(--onocra-forest)] sm:text-4xl"
        >
          Stay safer in your digital life
        </h2>

        <p
          class="text-muted-foreground mt-3 max-w-3xl text-lg leading-relaxed"
        >
          Practical guidance for protecting yourself, your family and your
          everyday online activity.
        </p>
      </div>

      <a
        href={safetyPath}
        aria-label="Explore Digital Safety"
        class="group block overflow-hidden rounded-3xl"
      >
        <img
          src="/DigitalSafety.png"
          alt="Digital Safety for Everyone — guidance about scams, safe payments, privacy and senior safety"
          class="block h-auto w-full transition duration-300 group-hover:scale-[1.01]"
          loading="lazy"
        />
      </a>
    </section>

    <!-- USEFUL NOW -->
    <section
      id="useful-now"
      class="border-border border-b py-2 sm:py-3"
    >
      <a
        href={`${searchPath}?q=useful%20now`}
        aria-label="Explore Useful Now"
        class="group block overflow-hidden rounded-3xl"
      >
        <img
          src="/usefulnow.png"
          alt="Useful Now — practical answers to technology questions households are dealing with right now"
          class="block h-auto w-full transition duration-300 group-hover:scale-[1.005]"
          loading="lazy"
        />
      </a>
    </section>

    <!-- REVIEWS -->
    <section
      id="reviews"
      class="border-border border-b py-2 sm:py-3"
    >
      <a
        href={`${searchPath}?q=reviews`}
        aria-label="Explore ONOCRA Reviews"
        class="group block overflow-hidden rounded-3xl"
      >
        <img
          src="/reviews.png"
          alt="ONOCRA Reviews — real-world technology analysis, comparisons and practical buying advice"
          class="block h-auto w-full transition duration-300 group-hover:scale-[1.005]"
          loading="lazy"
        />
      </a>
    </section>

    <!-- MID-PAGE ADVERTISEMENT -->
    <aside
      class="border-border border-b py-3"
      aria-label="Advertisement"
    >
      <div
        class="border-border flex h-20 items-center justify-center rounded-2xl border border-dashed bg-[var(--onocra-cream)] sm:h-24 lg:h-[72px]"
      >
        <span
          class="text-muted-foreground text-xs font-semibold tracking-[0.16em] uppercase"
        >
          Advertisement
        </span>
      </div>
    </aside>

    <div id="updates" class="scroll-mt-6"></div>

    <!-- DIGITAL PARENTING -->
    <section
      id="digital-parenting"
      class="border-border border-b py-7 sm:py-8"
    >
      <div
        class="border-border overflow-hidden rounded-3xl border bg-[var(--onocra-cream)]"
      >
        <div class="grid items-stretch md:grid-cols-[1.3fr_0.7fr]">
          <div class="flex flex-col justify-center p-6 sm:p-7 lg:p-8">
            <p class="text-accent text-sm font-bold tracking-[0.16em] uppercase">
              Digital Parenting
            </p>

            <h2 class="mt-2 max-w-2xl text-2xl font-bold sm:text-3xl">
              Helping families navigate technology together
            </h2>

            <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed">
              Practical help with screen time, first phones, parental controls,
              gaming, social media, online safety and AI.
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                Screen time
              </span>

              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                First phone
              </span>

              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                Parental controls
              </span>

              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                Online safety
              </span>
            </div>

            <div class="mt-5 flex flex-wrap items-center gap-4">
              <div
                class="border-border bg-background flex items-center gap-3 rounded-2xl border px-4 py-2.5"
              >
                <img
                  src="/seed%20and%20sapling.png"
                  alt="Seed & Sapling"
                  class="h-10 w-auto object-contain"
                  loading="lazy"
                />

                <div>
                  <p
                    class="text-muted-foreground text-[0.68rem] font-semibold"
                  >
                    In collaboration with
                  </p>

                  <p class="text-sm font-bold">
                    Seed &amp; Sapling
                  </p>
                </div>
              </div>

              <a
                href={`${searchPath}?q=digital%20parenting`}
                class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-xl px-5 py-3 font-bold"
              >
                Explore Digital Parenting
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <div
            class="relative min-h-48 overflow-hidden sm:min-h-56 md:min-h-0"
          >
            <img
              src="/seedsapling2.png"
              alt="Parent and child learning together with technology"
              class="absolute inset-0 h-full w-full object-cover md:object-[70%_center]"
              loading="lazy"
            />

            <div
              class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-4 pt-12 text-white"
            >
              <p class="text-sm font-semibold">
                Technology guidance for the whole family.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GUIDES -->
    <section
      id="guides"
      class="border-border border-b py-8 sm:py-10"
    >
      <a
        href={`${searchPath}?q=guides`}
        aria-label="Explore ONOCRA Guides"
        class="group block overflow-hidden rounded-3xl transition hover:-translate-y-1 hover:shadow-lg"
      >
        <img
          src="/guides.png"
          alt="ONOCRA Guides — step-by-step help for Wi-Fi, family digital safety and smartphone buying"
          class="block h-auto w-full transition duration-300 group-hover:scale-[1.01]"
          loading="lazy"
        />
      </a>
    </section>

    <!-- ONOCRA ROUTES + STAY IN THE LOOP -->
    <section class="border-border border-b py-6 sm:py-8">
      <div class="grid items-stretch gap-6 lg:grid-cols-2">

        <a
          id="routes"
          href={`${searchPath}?q=ONOCRA%20Routes`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <img
            src="/routes.png"
            alt="ONOCRA Routes technology navigation"
            class="block aspect-[16/9] w-full object-cover"
            loading="lazy"
          />

          <div class="p-6 sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p
                  class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
                >
                  ONOCRA Routes
                </p>

                <h2 class="mt-2 text-2xl font-bold">
                  Don't see what you need?
                </h2>
              </div>

              <span
                class="text-accent text-3xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-3 leading-relaxed">
              If ONOCRA doesn't have the answer, we'll help point you toward a
              useful and trustworthy resource.
            </p>
          </div>
        </a>

        <div
          class="border-border flex flex-col justify-center rounded-3xl border bg-[var(--onocra-cream)] p-6 sm:p-8"
        >
          <p class="text-accent text-sm font-bold tracking-[0.16em] uppercase">
            Stay in the Loop
          </p>

          <h2
            class="mt-2 text-2xl font-bold text-[var(--onocra-forest)] sm:text-3xl"
          >
