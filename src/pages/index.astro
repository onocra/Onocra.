---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
const searchPath = getRelativeLocaleUrl(locale, "search");
---

<Layout>
  <Header />

  <!-- =========================================
       RESERVED ADVERTISEMENT SPACE
  ========================================== -->
  <aside
    class="border-border bg-background border-b"
    aria-label="Advertisement"
  >
    <div class="app-layout py-4 sm:py-6">
      <div
        class="border-border flex h-24 items-center justify-center rounded-2xl border border-dashed bg-[var(--onocra-cream)] sm:h-28 lg:h-32"
      >
        <span
          class="text-muted-foreground text-xs font-semibold tracking-[0.16em] uppercase"
        >
          Advertisement
        </span>
      </div>
    </div>
  </aside>

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <!-- =========================================
         ONOCRA WELCOME / HERO
    ========================================== -->
    <section class="border-border border-b py-8 sm:py-14 lg:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <p
            class="text-accent mb-3 text-sm font-bold tracking-[0.18em] uppercase"
          >
            Welcome!
          </p>

          <h1
            class="max-w-4xl text-4xl leading-[1.05] font-bold tracking-tight sm:text-5xl lg:text-7xl"
          >
            <span class="block">TechnoNavigation</span>
            <span class="text-accent block whitespace-nowrap">
              made easy.
            </span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-relaxed sm:text-xl">
            Clear, practical answers for your everyday technology questions.
          </p>

          <div
            class="mt-7 max-w-2xl rounded-2xl bg-[var(--onocra-sage)] p-5 sm:p-6"
          >
            <p class="font-bold">
              Designed for ordinary householders.
            </p>

            <p class="mt-2 leading-relaxed">
              Simple, step-by-step solutions for real-life technology
              problems at home — without the technical jargon.
            </p>
          </div>

          <!-- ASK ONOCRA -->
          <div class="mt-8 max-w-3xl">
            <p
              class="mb-3 text-sm font-bold tracking-[0.14em] uppercase"
            >
              Ask ONOCRA
            </p>

            <form
              action={searchPath}
              method="get"
              class="border-border bg-background flex items-center gap-2 rounded-2xl border p-2 shadow-sm"
            >
              <input
                type="search"
                name="q"
                aria-label="Ask ONOCRA"
                placeholder="Tell me what's happening or ask a question..."
                class="text-foreground min-w-0 flex-1 bg-transparent px-3 py-3 outline-none"
              />

              <button
                type="submit"
                class="bg-accent text-accent-foreground rounded-xl px-5 py-3 font-bold"
              >
                Ask
              </button>
            </form>

            <div class="mt-4 flex flex-wrap gap-2">
              <a
                href={`${searchPath}?q=Wi-Fi%20not%20working`}
                class="border-border rounded-full border px-3 py-2 text-sm"
              >
                Wi-Fi not working
              </a>

              <a
                href={`${searchPath}?q=Best%20phone%20for%20parents`}
                class="border-border rounded-full border px-3 py-2 text-sm"
              >
                Best phone for parents
              </a>

              <a
                href={`${searchPath}?q=Windows%20update`}
                class="border-border rounded-full border px-3 py-2 text-sm"
              >
                Windows update
              </a>

              <a
                href={`${searchPath}?q=Is%20this%20a%20scam`}
                class="border-border rounded-full border px-3 py-2 text-sm"
              >
                Is this a scam?
              </a>

              <a
                href={`${searchPath}?q=Set%20parental%20controls`}
                class="border-border rounded-full border px-3 py-2 text-sm"
              >
                Set parental controls
              </a>
            </div>
          </div>
        </div>

        <!-- PELICAN WELCOME -->
        <div class="mx-auto max-w-sm text-center lg:max-w-md">
          <img
            src="/welcomepelican.png"
            alt="ONOCRA pelican"
            class="mx-auto w-52 sm:w-64 lg:w-72"
            loading="eager"
          />

          <div
            class="border-border bg-background mt-4 rounded-2xl border p-5 text-left shadow-sm"
          >
            <p class="font-bold">
              Hi there! I'm ONOCRA.
            </p>

            <p class="mt-1">
              Let's make technology easier for your home.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================
         EXPLORE TECHNOLOGY TOPICS
    ========================================== -->
    <section class="border-border border-b py-10 sm:py-14">
      <p
        class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
      >
        Start with what you need
      </p>

      <h2 class="mt-2 text-3xl font-bold sm:text-4xl">
        Explore Technology Topics
      </h2>

      <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed">
        Choose the technology you need help with.
      </p>

      <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <!-- PHONES & TABLETS -->
        <a
          href={`${searchPath}?q=phones%20tablets`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56"
          >
            <img
              src="/phones.png"
              alt="Phones and tablets"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold">
                Phones &amp; Tablets
              </h3>

              <span
                class="text-accent text-2xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed">
              Setup, problems, features and buying help.
            </p>
          </div>
        </a>

        <!-- HOME INTERNET & WI-FI -->
        <a
          href={`${searchPath}?q=home%20internet%20wifi`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56"
          >
            <img
              src="/wifi.png"
              alt="Home internet and Wi-Fi"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold">
                Home Internet &amp; Wi-Fi
              </h3>

              <span
                class="text-accent text-2xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed">
              Connections, routers, speed and coverage.
            </p>
          </div>
        </a>

        <!-- COMPUTERS & LAPTOPS -->
        <a
          href={`${searchPath}?q=computers%20laptops`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56"
          >
            <img
              src="/laptops.png"
              alt="Computers and laptops"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold">
                Computers &amp; Laptops
              </h3>

              <span
                class="text-accent text-2xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed">
              Windows, Mac, software and everyday fixes.
            </p>
          </div>
        </a>

        <!-- SAFETY & SECURITY -->
        <a
          href={`${searchPath}?q=safety%20security%20scams`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56"
          >
            <img
              src="/safetysecurity.png"
              alt="Digital safety and security"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold">
                Safety &amp; Security
              </h3>

              <span
                class="text-accent text-2xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed">
              Scams, privacy, passwords and safer accounts.
            </p>
          </div>
        </a>

        <!-- SMART HOME -->
        <a
          href={`${searchPath}?q=smart%20home`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56"
          >
            <img
              src="/smarthome.png"
              alt="Smart home technology"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold">
                Smart Home
              </h3>

              <span
                class="text-accent text-2xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed">
              TVs, cameras, speakers and connected devices.
            </p>
          </div>
        </a>

        <!-- APPS & ONLINE SERVICES -->
        <a
          href={`${searchPath}?q=apps%20online%20services`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56"
          >
            <img
              src="/apps.png"
              alt="Apps and online services"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-xl font-bold">
                Apps &amp; Online Services
              </h3>

              <span
                class="text-accent text-2xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed">
              Useful apps, accounts, AI and digital services.
            </p>
          </div>
        </a>
      </div>
    </section>

    <!-- =========================================
         DIGITAL SAFETY
    ========================================== -->
    <section class="border-border border-b py-10 sm:py-14">
      <div
        class="overflow-hidden rounded-3xl bg-[var(--onocra-forest)] text-white"
      >
        <div class="grid items-center lg:grid-cols-[0.8fr_1.2fr]">
          <!-- SAFETY VISUAL -->
          <div class="flex items-center justify-center p-6 sm:p-8 lg:p-10">
            <img
              src="/DigitalSafety.png"
              alt="Digital Safety for families"
              class="w-full max-w-sm rounded-2xl object-contain"
              loading="lazy"
            />
          </div>

          <!-- SAFETY CONTENT -->
          <div class="p-7 pt-2 sm:p-10 lg:pl-4">
            <p
              class="text-sm font-bold tracking-[0.16em] uppercase opacity-80"
            >
              Stay Safe Online
            </p>

            <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
              Digital Safety for Everyone
            </h2>

            <p class="mt-4 max-w-3xl text-lg leading-relaxed">
              Practical help to recognize scams, protect accounts and make
              online banking, shopping and communication safer for the whole
              household.
            </p>

            <div class="mt-7 grid gap-3 sm:grid-cols-2">
              <div class="rounded-xl bg-white/10 p-4">
                Spot scams and fake messages
              </div>

              <div class="rounded-xl bg-white/10 p-4">
                Safe banking and payments
              </div>

              <div class="rounded-xl bg-white/10 p-4">
                Privacy and account security
              </div>

              <div class="rounded-xl bg-white/10 p-4">
                Guides for seniors &amp; families
              </div>
            </div>

            <a
              href={`${searchPath}?q=digital%20safety`}
              class="mt-7 inline-block rounded-xl bg-white px-5 py-3 font-bold text-[var(--onocra-forest)]"
            >
              Explore Digital Safety
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================
         USEFUL NOW + REVIEWS
    ========================================== -->
    <section class="border-border border-b py-10 sm:py-14">
      <div class="grid gap-5 lg:grid-cols-2">
        <!-- USEFUL NOW -->
        <div
          class="border-border rounded-3xl border bg-[var(--onocra-sage)] p-7 sm:p-8"
        >
          <p
            class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
          >
            Useful Now
          </p>

          <h2 class="mt-2 text-3xl font-bold">
            Help for everyday tech
          </h2>

          <p class="mt-4 max-w-xl leading-relaxed">
            Practical answers to the technology questions households are
            dealing with right now.
          </p>

          <a
            href={`${searchPath}?q=everyday%20technology%20help`}
            class="text-accent mt-6 inline-block font-bold"
          >
            Find practical help →
          </a>
        </div>

        <!-- REVIEWS -->
        <div
          class="border-border rounded-3xl border bg-[var(--onocra-blue-soft)] p-7 sm:p-8"
        >
          <p
            class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
          >
            Reviews
          </p>

          <h2 class="mt-2 text-3xl font-bold">
            Understand before you buy
          </h2>

          <p class="mt-4 max-w-xl leading-relaxed">
            ONOCRA analysis, real-world considerations, alternatives and
            buying options — focused on whether something actually fits
            your household.
          </p>

          <a
            href={`${searchPath}?q=reviews`}
            class="text-accent mt-6 inline-block font-bold"
          >
            Explore reviews →
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================
         DIGITAL PARENTING
    ========================================== -->
    <section class="border-border border-b py-10 sm:py-14">
      <div
        class="overflow-hidden rounded-3xl bg-[var(--onocra-cream)]"
      >
        <div class="grid lg:grid-cols-[1.15fr_0.55fr_0.9fr]">
          <!-- DIGITAL PARENTING CONTENT -->
          <div class="p-7 sm:p-10">
            <p
              class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
            >
              Digital Parenting
            </p>

            <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
              Helping families navigate technology together
            </h2>

            <p class="mt-4 leading-relaxed">
              Parental controls, screen time, online safety, first phones,
              gaming, social media, privacy and AI — explained for parents,
              not technicians.
            </p>

            <a
              href={`${searchPath}?q=digital%20parenting`}
              class="bg-accent text-accent-foreground mt-7 inline-block rounded-xl px-5 py-3 font-bold"
            >
              Explore Digital Parenting
            </a>
          </div>

          <!-- SEED & SAPLING COLLABORATION -->
          <div
            class="flex flex-col items-center justify-center px-7 py-7 text-center lg:px-4"
          >
            <p class="mb-3 text-sm font-semibold">
              In collaboration with
            </p>

            <img
              src="/seed%20and%20sapling.png"
              alt="Seed & Sapling"
              class="w-32 max-w-full object-contain sm:w-36"
              loading="lazy"
            />

            <p class="mt-3 text-sm leading-relaxed">
              Nurture their roots.<br />
              Brighten their future.
            </p>
          </div>

          <!-- FAMILY VISUAL -->
          <div class="min-h-64 lg:min-h-full">
            <img
              src="/seedsapling2.png"
              alt="Mother and child learning together with technology"
              class="h-full min-h-64 w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================
         GUIDES + ONOCRA ROUTES
    ========================================== -->
    <section class="py-10 sm:py-14">
      <div class="grid gap-5 lg:grid-cols-2">
        <!-- GUIDES -->
        <div class="border-border rounded-3xl border p-6 sm:p-7">
          <p
            class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
          >
            Guides
          </p>

          <h2 class="mt-2 text-2xl font-bold">
            Do it step by step
          </h2>

          <p class="mt-3 leading-relaxed">
            Clear instructions designed to get you from problem to solution
            without unnecessary technical language.
          </p>

          <a
            href={`${searchPath}?q=step%20by%20step%20guides`}
            class="text-accent mt-6 inline-block font-bold"
          >
            Explore Guides →
          </a>
        </div>

        <!-- ONOCRA ROUTES -->
        <div class="border-border rounded-3xl border p-6 sm:p-7">
          <p
            class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
          >
            ONOCRA Routes
          </p>

          <h2 class="mt-2 text-2xl font-bold">
            When the answer is somewhere else
          </h2>

          <p class="mt-3 leading-relaxed">
            If ONOCRA isn't the right destination, we'll help point you
            toward a useful and trustworthy resource instead of leaving
            you at a dead end.
          </p>

          <a
            href={`${searchPath}?q=ONOCRA%20Routes`}
            class="text-accent mt-6 inline-block font-bold"
          >
            Explore Routes →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem(
        "backUrl",
        indexLayout.homePath ?? baseRoot
      );
    }
  });
</script>
