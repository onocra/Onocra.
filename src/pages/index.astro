---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
const searchPath = getRelativeLocaleUrl(locale, "search");
---

<Layout>
  <Header />

  <!-- RESERVED ADVERTISEMENT SPACE -->
  <aside
    class="border-border bg-background border-b"
    aria-label="Advertisement"
  >
    <div class="app-layout py-3 sm:py-4 lg:py-3">
      <div
        class="border-border flex h-20 items-center justify-center rounded-2xl border border-dashed bg-[var(--onocra-cream)] sm:h-24 lg:h-[72px]"
      >
        <span
          class="text-muted-foreground text-xs font-semibold tracking-[0.16em] uppercase"
        >
          Advertisement
        </span>
      </div>
    </div>
  </aside>

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <!-- ONOCRA WELCOME / HERO -->
    <section class="border-border border-b py-8 sm:py-10 lg:py-10">
      <div
        class="grid items-center gap-6 md:grid-cols-[1.15fr_0.85fr] lg:gap-10"
      >
        <div>
          <p
            class="text-accent mb-2 text-sm font-bold tracking-[0.18em] uppercase"
          >
            Welcome!
          </p>

          <h1
            class="text-4xl leading-[1.05] font-bold tracking-tight sm:text-5xl lg:text-[3.5rem] xl:text-[4rem]"
          >
            <span class="block">TechnoNavigation</span>
            <span class="text-accent block">made easy.</span>
          </h1>

          <p class="mt-4 max-w-2xl text-lg leading-relaxed sm:text-xl">
            Clear, practical answers for your everyday technology questions.
          </p>
        </div>

        <div class="rounded-3xl bg-[var(--onocra-sage)] p-6 sm:p-7 lg:p-8">
          <p
            class="font-serif text-xl font-bold text-[var(--onocra-forest)] sm:text-2xl"
          >
            Designed for ordinary householders.
          </p>

          <p class="text-muted-foreground mt-3 leading-relaxed sm:text-lg">
            Simple, step-by-step solutions for real-life technology problems at
            home — without the technical jargon.
          </p>
        </div>
      </div>

      <!-- PELICAN INTRODUCTION -->
      <div class="mt-8 flex items-center gap-4 sm:gap-6 lg:mt-10 lg:gap-8">
        <img
          src="/welcomepelican.png"
          alt="ONOCRA pelican"
          class="w-28 shrink-0 object-contain sm:w-36 lg:w-44"
          style="transform: scaleX(-1);"
          loading="eager"
        />

        <div
          class="border-border flex-1 rounded-3xl border bg-[var(--onocra-cream)] p-5 shadow-sm sm:p-7 lg:p-8"
        >
          <p
            class="font-serif text-xl font-bold text-[var(--onocra-forest)] sm:text-2xl lg:text-3xl"
          >
            Hi there! I'm ONOCRA<span class="text-[var(--onocra-orange)]">.</span>
          </p>

          <p class="text-muted-foreground mt-2 leading-relaxed sm:text-lg">
            Let's make technology easier for your home.
          </p>
        </div>
      </div>

      <!-- ASK ONOCRA -->
      <div id="ask-onocra" class="mt-8 lg:mt-10">
        <div class="mb-3 flex items-center justify-between gap-4">
          <p class="text-sm font-bold tracking-[0.14em] uppercase">
            Ask ONOCRA
          </p>

          <span class="text-muted-foreground hidden text-xs sm:inline">
            Start with your question
          </span>
        </div>

        <form
          action={searchPath}
          method="get"
          class="border-border bg-background flex items-center gap-2 rounded-2xl border p-2 shadow-sm"
        >
          <input
            type="search"
            name="q"
            aria-label="Ask ONOCRA"
            placeholder="Tell me what's happening or ask a question..."
            class="text-foreground min-w-0 flex-1 bg-transparent px-3 py-3 outline-none"
          />

          <button
            type="submit"
            class="bg-accent text-accent-foreground shrink-0 rounded-xl px-5 py-3 font-bold sm:px-7"
          >
            Ask
          </button>
        </form>

        <div class="mt-3 flex flex-wrap gap-2">
          <a
            href={`${searchPath}?q=Wi-Fi%20not%20working`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Wi-Fi not working
          </a>

          <a
            href={`${searchPath}?q=Best%20phone%20for%20parents`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Best phone for parents
          </a>

          <a
            href={`${searchPath}?q=Windows%20update`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Windows update
          </a>

          <a
            href={`${searchPath}?q=Is%20this%20a%20scam`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Is this a scam?
          </a>

          <a
            href={`${searchPath}?q=Set%20parental%20controls`}
            class="border-border rounded-full border px-3 py-1.5 text-sm"
          >
            Set parental controls
          </a>
        </div>
      </div>
    </section>

    <!-- EXPLORE TECHNOLOGY TOPICS -->
    <section
      id="topics"
      class="border-border border-b py-10 sm:py-14 lg:py-12"
    >
      <p class="text-accent text-sm font-bold tracking-[0.16em] uppercase">
        Start with what you need
      </p>

      <div class="mt-2">
        <h2 class="text-3xl font-bold sm:text-4xl">
          Explore Technology Topics
        </h2>

        <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed">
          Choose the technology you need help with.
        </p>
      </div>

      <div
        class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 xl:gap-4"
      >
        <!-- PHONES -->
        <a
          href={`${searchPath}?q=phones%20tablets`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/phones.png"
              alt="Phones and tablets"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Phones &amp; Tablets
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Setup, problems, features and buying help.
            </p>
          </div>
        </a>

        <!-- WI-FI -->
        <a
          href={`${searchPath}?q=home%20internet%20wifi`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/wifi.png"
              alt="Home internet and Wi-Fi"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Home Internet &amp; Wi-Fi
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Connections, routers, speed and coverage.
            </p>
          </div>
        </a>

        <!-- LAPTOPS -->
        <a
          href={`${searchPath}?q=computers%20laptops`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/laptops.png"
              alt="Computers and laptops"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Computers &amp; Laptops
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Windows, Mac, software and everyday fixes.
            </p>
          </div>
        </a>

        <!-- SAFETY -->
        <a
          href={`${searchPath}?q=safety%20security%20scams`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/safetysecurity.png"
              alt="Digital safety and security"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Safety &amp; Security
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Scams, privacy, passwords and safer accounts.
            </p>
          </div>
        </a>

        <!-- SMART HOME -->
        <a
          href={`${searchPath}?q=smart%20home`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/smarthome.png"
              alt="Smart home technology"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">Smart Home</h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              TVs, cameras, speakers and connected devices.
            </p>
          </div>
        </a>

        <!-- APPS -->
        <a
          href={`${searchPath}?q=apps%20online%20services`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div
            class="flex h-52 items-center justify-center bg-white p-5 sm:h-56 xl:h-36 xl:p-3"
          >
            <img
              src="/apps.png"
              alt="Apps and online services"
              class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <div class="p-5 xl:p-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-xl font-bold xl:text-base">
                Apps &amp; Online Services
              </h3>
              <span class="text-accent text-xl">→</span>
            </div>

            <p class="text-muted-foreground mt-2 leading-relaxed xl:text-sm">
              Useful apps, accounts, AI and digital services.
            </p>
          </div>
        </a>
      </div>
    </section>

    <!-- DIGITAL SAFETY -->
    <section
      id="digital-safety"
      class="border-border border-b py-8 sm:py-10"
    >
      <div class="mb-6 sm:mb-7">
        <p class="text-accent text-sm font-bold tracking-[0.16em] uppercase">
          Digital Safety
        </p>

        <h2
          class="mt-2 text-3xl font-bold text-[var(--onocra-forest)] sm:text-4xl"
        >
          Stay safer in your digital life
        </h2>

        <p
          class="text-muted-foreground mt-3 max-w-3xl text-lg leading-relaxed"
        >
          Practical guidance for protecting yourself, your family and your
          everyday online activity.
        </p>
      </div>

      <a
        href={`${searchPath}?q=digital%20safety`}
        aria-label="Explore Digital Safety"
        class="group block overflow-hidden rounded-3xl"
      >
        <img
          src="/DigitalSafety.png"
          alt="Digital Safety for Everyone — guidance about scams, safe payments, privacy and senior safety"
          class="block h-auto w-full transition duration-300 group-hover:scale-[1.01]"
          loading="lazy"
        />
      </a>
    </section>

    <!-- USEFUL NOW + REVIEWS -->
    <section
      id="reviews"
      class="border-border border-b py-10 sm:py-14"
    >
      <div class="grid gap-6 lg:grid-cols-2">
        <!-- USEFUL NOW -->
        <a
          href={`${searchPath}?q=useful%20now`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <img
            src="/usefulnow.png"
            alt="Useful Now technology help"
            class="aspect-[16/10] w-full object-cover lg:aspect-[16/8]"
            loading="lazy"
          />

          <div class="p-6 sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p
                  class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
                >
                  Useful Now
                </p>

                <h2 class="mt-2 text-2xl font-bold sm:text-3xl">
                  Help for everyday tech
                </h2>
              </div>

              <span
                class="text-accent text-3xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-3 leading-relaxed">
              Timely, practical answers to the technology questions households
              are dealing with right now.
            </p>
          </div>
        </a>

        <!-- REVIEWS -->
        <a
          href={`${searchPath}?q=reviews`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <img
            src="/reviews.png"
            alt="ONOCRA technology reviews"
            class="aspect-[16/10] w-full object-cover lg:aspect-[16/8]"
            loading="lazy"
          />

          <div class="p-6 sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p
                  class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
                >
                  Reviews
                </p>

                <h2 class="mt-2 text-2xl font-bold sm:text-3xl">
                  Understand before you buy
                </h2>
              </div>

              <span
                class="text-accent text-3xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-3 leading-relaxed">
              Practical product analysis, comparisons, alternatives and buying
              guidance for real households.
            </p>
          </div>
        </a>
      </div>
    </section>

    <!-- UPDATES ANCHOR -->
    <div id="updates" class="scroll-mt-6"></div>

    <!-- DIGITAL PARENTING -->
    <section
      id="digital-parenting"
      class="border-border border-b py-8 sm:py-10"
    >
      <div
        class="border-border overflow-hidden rounded-3xl border bg-[var(--onocra-cream)]"
      >
        <div class="grid items-stretch md:grid-cols-[1.3fr_0.7fr]">
          <!-- CONTENT -->
          <div class="flex flex-col justify-center p-6 sm:p-7 lg:p-8">
            <p class="text-accent text-sm font-bold tracking-[0.16em] uppercase">
              Digital Parenting
            </p>

            <h2 class="mt-2 max-w-2xl text-2xl font-bold sm:text-3xl">
              Helping families navigate technology together
            </h2>

            <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed">
              Practical help with screen time, first phones, parental controls,
              gaming, social media, online safety and AI.
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                Screen time
              </span>

              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                First phone
              </span>

              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                Parental controls
              </span>

              <span
                class="border-border bg-background rounded-full border px-3 py-1.5 text-sm"
              >
                Online safety
              </span>
            </div>

            <div class="mt-5 flex flex-wrap items-center gap-4">
              <div
                class="border-border bg-background flex items-center gap-3 rounded-2xl border px-4 py-2.5"
              >
                <img
                  src="/seed%20and%20sapling.png"
                  alt="Seed & Sapling"
                  class="h-10 w-auto object-contain"
                  loading="lazy"
                />

                <div>
                  <p
                    class="text-muted-foreground text-[0.68rem] font-semibold"
                  >
                    In collaboration with
                  </p>

                  <p class="text-sm font-bold">Seed &amp; Sapling</p>
                </div>
              </div>

              <a
                href={`${searchPath}?q=digital%20parenting`}
                class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-xl px-5 py-3 font-bold"
              >
                Explore Digital Parenting
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <!-- FAMILY VISUAL -->
          <div
            class="relative min-h-48 overflow-hidden sm:min-h-56 md:min-h-0"
          >
            <img
              src="/seedsapling2.png"
              alt="Parent and child learning together with technology"
              class="absolute inset-0 h-full w-full object-cover md:object-[70%_center]"
              loading="lazy"
            />

            <div
              class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/55 to-transparent p-4 pt-12 text-white"
            >
              <p class="text-sm font-semibold">
                Technology guidance for the whole family.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GUIDES -->
    <section
      id="guides"
      class="border-border border-b py-8 sm:py-10"
    >
      <a
        href={`${searchPath}?q=guides`}
        aria-label="Explore ONOCRA Guides"
        class="group block overflow-hidden rounded-3xl transition hover:-translate-y-1 hover:shadow-lg"
      >
        <img
          src="/guides.png"
          alt="ONOCRA Guides — step-by-step help for Wi-Fi, family digital safety and smartphone buying"
          class="block h-auto w-full transition duration-300 group-hover:scale-[1.01]"
          loading="lazy"
        />
      </a>
    </section>

    <!-- ONOCRA ROUTES + STAY IN THE LOOP -->
    <section class="border-border border-b py-8 sm:py-10">
      <div class="grid items-stretch gap-6 lg:grid-cols-2">
        <!-- ONOCRA ROUTES -->
        <a
          id="routes"
          href={`${searchPath}?q=ONOCRA%20Routes`}
          class="group border-border bg-background overflow-hidden rounded-3xl border transition hover:-translate-y-1 hover:shadow-lg"
        >
          <img
            src="/routes.png"
            alt="ONOCRA Routes technology navigation"
            class="block aspect-[16/9] w-full object-cover"
            loading="lazy"
          />

          <div class="p-6 sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p
                  class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
                >
                  ONOCRA Routes
                </p>

                <h2 class="mt-2 text-2xl font-bold">
                  Don't see what you need?
                </h2>
              </div>

              <span
                class="text-accent text-3xl transition group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>

            <p class="text-muted-foreground mt-3 leading-relaxed">
              If ONOCRA doesn't have the answer, we'll help point you toward a
              useful and trustworthy resource.
            </p>
          </div>
        </a>

        <!-- STAY IN THE LOOP -->
        <div
          class="border-border flex flex-col justify-center rounded-3xl border bg-[var(--onocra-cream)] p-6 sm:p-8"
        >
          <p class="text-accent text-sm font-bold tracking-[0.16em] uppercase">
            Stay in the Loop
          </p>

          <h2
            class="mt-2 text-2xl font-bold text-[var(--onocra-forest)] sm:text-3xl"
          >
            Useful technology, without the noise.
          </h2>

          <p
            class="text-muted-foreground mt-4 max-w-xl leading-relaxed sm:text-lg"
          >
            Follow ONOCRA for practical household technology help, useful
            updates and smarter digital decisions.
          </p>

          <div class="mt-6">
            <a
              href={searchPath}
              class="bg-accent text-accent-foreground inline-flex items-center gap-2 rounded-xl px-5 py-3 font-bold"
            >
              Search ONOCRA
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FOLLOW ONOCRA -->
    <section class="border-border border-b py-8 sm:py-10">
      <div
        class="relative overflow-hidden"
        aria-label="Follow ONOCRA on social media"
      >
        <img
          src="/followonocra.png"
          alt="Follow ONOCRA for practical technology help, useful updates and smarter digital decisions"
          class="block h-auto w-full"
          loading="lazy"
        />

        <!-- CLICKABLE SOCIAL MEDIA AREAS -->
        <div
          class="absolute right-[8%] bottom-[3%] left-[8%] grid h-[20%] grid-cols-6 gap-[2%]"
          aria-label="ONOCRA social media links"
        >
          <a
            href="https://www.youtube.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ONOCRA on YouTube"
            class="rounded-xl"
          ></a>

          <a
            href="https://www.tiktok.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ONOCRA on TikTok"
            class="rounded-xl"
          ></a>

          <a
            href="https://www.instagram.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ONOCRA on Instagram"
            class="rounded-xl"
          ></a>

          <a
            href="https://www.facebook.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ONOCRA on Facebook"
            class="rounded-xl"
          ></a>

          <a
            href="https://x.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ONOCRA on X"
            class="rounded-xl"
          ></a>

          <a
            href="https://www.pinterest.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ONOCRA on Pinterest"
            class="rounded-xl"
          ></a>
        </div>
      </div>
    </section>

    <!-- ANCHOR TARGETS -->
    <div id="fix" class="scroll-mt-6"></div>
    <div id="decode" class="scroll-mt-6"></div>
    <div id="compare" class="scroll-mt-6"></div>
    <div id="choose" class="scroll-mt-6"></div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem(
        "backUrl",
        indexLayout.homePath ?? baseRoot
      );
    }
  });
</script>
