<script is:inline>
  (() => {
    const initLatestFilter = () => {
      const filter = document.querySelector("[data-latest-filter]");
      if (!(filter instanceof HTMLSelectElement)) return;

      const items = Array.from(document.querySelectorAll("[data-latest-item]"));

      const apply = () => {
        const scope = filter.value || "all";

        items.forEach((item) => {
          if (!(item instanceof HTMLElement)) return;
          const itemScope = item.dataset.latestItem || "";
          item.hidden = scope !== "all" && itemScope !== scope;
        });
      };

      filter.addEventListener("change", apply);
      apply();
    };

    initLatestFilter();
    document.addEventListener("astro:page-load", initLatestFilter);
  })();
</script>



