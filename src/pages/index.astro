---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
const searchPath = getRelativeLocaleUrl(locale, "search");
const phonesPath = getRelativeLocaleUrl(locale, "phones");
const internetPath = getRelativeLocaleUrl(locale, "internet");
const computersPath = getRelativeLocaleUrl(locale, "computers");
const safetyPath = getRelativeLocaleUrl(locale, "safety");
---

<Layout
  title="ONOCRA — Practical Technology Help for Everyday Households"
  description="ONOCRA makes technology easier for ordinary householders with clear, practical answers, step-by-step fixes, plain-English explanations, useful comparisons and smarter buying guidance."
>
  <Header />


  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <!-- =========================================
         ONOCRA WELCOME HERO
    ========================================== -->
    <section class="border-border border-b pb-6 sm:pb-8">
      <div class="onocra-home-top pt-0">
        <div class="onocra-welcome-hero-frame overflow-hidden rounded-3xl">

          <img
            src="/homepage/pelicanhero.png?v=20261020-hero3"
            alt="ONOCRA welcomes ordinary householders to practical technology help, with Fix, Decode, Compare and Choose guidance for everyday tech questions."
            class="onocra-welcome-hero-image block w-full"
            width="2048"
            height="682"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <div class="onocra-botanical-divider" aria-hidden="true">
          <svg class="onocra-hero-botanical" viewBox="0 0 1800 150" aria-hidden="true" focusable="false" preserveAspectRatio="none">
            <defs>
              <linearGradient id="home-leaf-green" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0" stop-color="#2f7f52"/>
                <stop offset="0.55" stop-color="#71b97a"/>
                <stop offset="1" stop-color="#b7d996"/>
              </linearGradient>
              <radialGradient id="home-flower-soft">
                <stop offset="0" stop-color="#fffce9"/>
                <stop offset="0.74" stop-color="#f6f0d4"/>
                <stop offset="1" stop-color="#d7e1c6"/>
              </radialGradient>
              <filter id="home-bot-shadow" x="-20%" y="-40%" width="140%" height="190%">
                <feDropShadow dx="0" dy="2" stdDeviation="1.4" flood-color="#285541" flood-opacity=".16"/>
              </filter>
            </defs>
            <g fill="none" stroke="#6da678" stroke-width="3" stroke-linecap="round" opacity=".92">
              <path d="M0 70 C150 7 290 110 445 52 S760 14 930 60 S1260 104 1450 45 S1680 24 1800 66"/>
              <path d="M160 42 C260 2 360 8 450 48"/>
              <path d="M1030 42 C1135 2 1240 7 1330 42"/>
            </g>
            <g fill="url(#home-leaf-green)" stroke="#3f7f59" stroke-width="1" filter="url(#home-bot-shadow)">
              <path d="M95 47q-44-34-67 2 25 35 67-2Z"/><path d="M190 35q14-48 51-33 2 38-51 33Z"/>
              <path d="M315 64q-47 1-44 39 40 8 44-39Z"/><path d="M430 44q13-46 49-34 3 38-49 34Z"/>
              <path d="M640 38q-40-36-66-4 22 38 66 4Z"/><path d="M780 43q14-46 49-31 1 39-49 31Z"/>
              <path d="M970 61q-47-8-53 29 37 20 53-29Z"/><path d="M1110 41q17-44 52-26 0 38-52 26Z"/>
              <path d="M1305 63q-45-14-57 23 33 25 57-23Z"/><path d="M1460 44q13-43 49-31 4 37-49 31Z"/>
              <path d="M1620 59q-44-9-51 28 35 20 51-28Z"/><path d="M1730 40q13-42 47-30 3 35-47 30Z"/>
            </g>
            <g fill="url(#home-flower-soft)" stroke="#d0c79b" stroke-width="1" filter="url(#home-bot-shadow)">
              <g transform="translate(520 49) scale(.82)"><ellipse cy="-10" rx="7" ry="12"/><ellipse cy="-10" rx="7" ry="12" transform="rotate(72)"/><ellipse cy="-10" rx="7" ry="12" transform="rotate(144)"/><ellipse cy="-10" rx="7" ry="12" transform="rotate(216)"/><ellipse cy="-10" rx="7" ry="12" transform="rotate(288)"/><circle r="5" fill="#d9ad4f" stroke="none"/></g>
              <g transform="translate(1205 46) scale(.72)"><ellipse cy="-10" rx="7" ry="12"/><ellipse cy="-10" rx="7" ry="12" transform="rotate(72)"/><ellipse cy="-10" rx="7" ry="12" transform="rotate(144)"/><ellipse cy="-10" rx="7" ry="12" transform="rotate(216)"/><ellipse cy="-10" rx="7" ry="12" transform="rotate(288)"/><circle r="5" fill="#d9ad4f" stroke="none"/></g>
            </g>
          </svg>
        </div>

        <!--
          The hero artwork contains visual typography, but this real HTML gives
          people, assistive technology and search engines the same core message.
        -->
        <div class="onocra-intro-block max-w-none px-0 pt-1 pb-1 text-left sm:pt-1 sm:pb-1">
          <h1 class="onocra-intro-heading text-foreground m-0 font-serif font-black tracking-[-0.018em]">
            <span class="onocra-intro-heading-line">Practical technology help for</span>
            <span class="onocra-intro-heading-line">Ordinary householders in US, UK &amp; Germany</span>
          </h1>

          <div class="onocra-intro-media-grid">
            <div class="onocra-intro-copy">
              <ul class="onocra-intro-points" aria-label="How ONOCRA helps">
                <li>
                  <span class="onocra-intro-tick" aria-hidden="true">✓</span>
                  <span>ONOCRA makes TechnoNavigation easy with clear, practical answers for everyday technology questions.</span>
                </li>
                <li>
                  <span class="onocra-intro-tick" aria-hidden="true">✓</span>
                  <span>Fix problems, understand technology, compare options and choose with confidence — without the technical jargon.</span>
                </li>
                <li>
                  <span class="onocra-intro-tick" aria-hidden="true">✓</span>
                  <span>We focus on selected brands and services for the <strong>US, UK and Germany</strong>. We care about our visitors, so if you don’t see what you need, <strong>ONOCRA Routes</strong> points you to trustworthy resources beyond our core coverage.</span>
                </li>
              </ul>
            </div>

            <div class="onocra-promo-video-shell" data-home-promo-shell>
              <video
                class="onocra-promo-video"
                data-home-promo-video
                preload="metadata"
                playsinline
                aria-label="ONOCRA introduction video"
              >
                <source src="/homepage/onocrapromo.mp4" type="video/mp4" />
                Your browser does not support HTML video.
              </video>

              <button
                class="onocra-promo-launch"
                type="button"
                data-home-promo-launch
                aria-label="Play ONOCRA introduction video"
              >
                <span class="onocra-promo-play" aria-hidden="true">▶</span>
                <span class="onocra-promo-label">
                  <strong>Watch ONOCRA</strong>
                  <small>See how we make technology easier</small>
                </span>
              </button>

              <button
                class="onocra-promo-close"
                type="button"
                data-home-promo-close
                aria-label="Close ONOCRA introduction video"
                title="Close video"
              >×</button>
            </div>
          </div>
        </div>

      <!-- ASK ONOCRA — compact single-line desktop layout -->
      <div id="ask-onocra" class="mt-0.5 sm:mt-1">
        <div class="mb-1">
          <p class="text-[0.78rem] font-bold tracking-[0.14em] text-[#C79532] uppercase sm:text-[0.86rem]">Ask ONOCRA</p>
        </div>
        <div class="onocra-search-helper text-muted-foreground">Type, speak or show me</div>
        <div class="onocra-ask-row">
          <form action={searchPath} method="get" class="onocra-ask-form border-border bg-background flex items-center gap-1 rounded-2xl border p-1 shadow-sm">
            <svg class="ml-2 h-4 w-4 shrink-0 text-[#C79532]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input id="onocra-question" type="search" name="q" aria-label="Ask ONOCRA" placeholder="Tell me what's happening..." class="onocra-question-input text-foreground min-w-0 flex-1 bg-transparent px-1.5 py-2 outline-none" />
            <input id="onocra-image-input" type="file" accept="image/*" class="hidden" />
            <button id="onocra-image-button" type="button" title="Upload an image" aria-label="Upload an image" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-[#C79532] transition hover:bg-[#C79532]/10">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 4h-5L8 6H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-3z"></path><circle cx="12" cy="13" r="3"></circle></svg>
            </button>
            <button id="onocra-mic-button" type="button" title="Speak your question" aria-label="Speak your question" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-[#C79532] transition hover:bg-[#C79532]/10">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"></rect><path d="M5 10a7 7 0 0 0 14 0"></path><path d="M12 17v5"></path><path d="M8 22h8"></path></svg>
            </button>
            <button type="submit" class="shrink-0 rounded-xl bg-[#D3A64A] px-4 py-2 text-[0.74rem] font-bold text-[#173A2F] transition hover:bg-[#C79532]">Ask <span aria-hidden="true">→</span></button>
          </form>
          <div class="onocra-try-row">
            <span class="shrink-0 text-[0.66rem] font-bold text-[#C79532]">Try:</span>
            <a href={`${searchPath}?q=Wi-Fi%20not%20working`} class="onocra-try-chip">Wi-Fi not working</a>
            <a href={`${searchPath}?q=Best%20phone%20for%20parents`} class="onocra-try-chip">Best phone for parents</a>
            <a href={`${searchPath}?q=Windows%20update`} class="onocra-try-chip">Windows update</a>
            <a href={`${searchPath}?q=Is%20this%20a%20scam`} class="onocra-try-chip">Is this a scam?</a>
            <a href={`${searchPath}?q=Set%20parental%20controls`} class="onocra-try-chip">Set parental controls</a>
          </div>
        </div>
        <div id="onocra-image-status" class="mt-1.5 hidden items-center gap-2 rounded-xl bg-[var(--onocra-sage)] px-3 py-1.5 text-xs text-[var(--onocra-forest)]">
          <span id="onocra-image-name" class="min-w-0 flex-1 truncate">Image selected</span>
          <button id="onocra-image-remove" type="button" aria-label="Remove selected image" class="shrink-0 font-bold">×</button>
        </div>
      </div>
      </div>
    </section>

    <!-- HOMEPAGE ADVERTISEMENT — directly after ASK ONOCRA -->
    <aside class="onocra-home-ad border-border border-b py-2" aria-label="Advertisement">
      <div class="border-border flex h-[68px] items-center justify-center rounded-2xl border border-dashed bg-[var(--onocra-cream)] sm:h-[76px] lg:h-[72px]">
        <span class="text-muted-foreground text-[0.68rem] font-semibold tracking-[0.16em] uppercase">
          Advertisement
        </span>
      </div>
    </aside>

    <!-- =========================================
         EXPLORE TECHNOLOGY TOPICS — 3-COMPARTMENT CARDS
    ========================================== -->
    <section id="topics" class="border-border border-b py-2 sm:py-2.5">
      <div class="mb-3">
        <p class="text-accent text-[0.7rem] font-bold tracking-[0.18em] uppercase sm:text-xs">
          Start with what you need
        </p>
        <div class="mt-0.5 flex flex-wrap items-baseline gap-x-4 gap-y-0.5">
          <h2 class="text-foreground font-serif text-[1.55rem] font-black leading-tight tracking-[-0.025em] sm:text-[1.8rem] lg:text-[1.95rem]">
            Explore Technology Topics
          </h2>
          <p class="text-muted-foreground text-[0.78rem] font-medium sm:text-[0.86rem]">
            Choose a topic below to fix, understand, compare or choose.
          </p>
        </div>
      </div>

      <div class="grid gap-3 md:grid-cols-2 lg:gap-4">
        <article class="group border-border bg-background overflow-hidden rounded-[1.35rem] border shadow-[0_8px_28px_rgba(15,42,67,0.07)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(15,42,67,0.13)]">
          <!-- Compartment 1: visual — dominant 70–75% of the main card face -->
          <a href={phonesPath} aria-label="Explore Phones &amp; Tablets" class="flex h-[235px] items-center justify-center overflow-hidden bg-[#eaf7fc] sm:h-[250px] lg:h-[265px] dark:bg-[#102b3a]">
            <img src="/homepage/phones.png" alt="Phones and tablets for everyday households"
              class="h-full w-full scale-[1.28] object-contain drop-shadow-[0_12px_16px_rgba(15,42,67,0.14)] transition duration-300 group-hover:scale-[1.34]"
              loading="lazy" />
          </a>

          <!-- Compartment 2: title / hub entry — compact 25–30% -->
          <div class="border-border border-t px-4 py-2.5 sm:px-5">
            <a href={phonesPath} class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-foreground font-serif text-lg font-black leading-tight sm:text-xl">Phones &amp; Tablets</h3>
                <p class="text-muted-foreground mt-0.5 truncate text-xs sm:text-[0.82rem]">Setup, problems, features and buying help.</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#d8f0fb] text-xl font-bold text-[#087EBA] transition group-hover:translate-x-1 dark:bg-[#163d50]" aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Compartment 3: direct ONOCRA journeys -->
          <nav class="border-border grid grid-cols-4 divide-x divide-border border-t" aria-label="Phones &amp; Tablets help options">
            <a href={`${phonesPath}#fix`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#078fe3] transition hover:bg-[#078fe3]/10 sm:text-[0.7rem]" aria-label="Fix Phones &amp; Tablets problems"><span aria-hidden="true">🔧</span><span>FIX</span></a>
            <a href={`${phonesPath}#decode`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#42a54d] transition hover:bg-[#42a54d]/10 sm:text-[0.7rem]" aria-label="Understand Phones &amp; Tablets"><span aria-hidden="true">💡</span><span>DECODE</span></a>
            <a href={`${phonesPath}#compare`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#ef5b16] transition hover:bg-[#ef5b16]/10 sm:text-[0.7rem]" aria-label="Compare Phones &amp; Tablets options"><span aria-hidden="true">⚖</span><span>COMPARE</span></a>
            <a href={`${phonesPath}#choose`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#7c22e8] transition hover:bg-[#7c22e8]/10 sm:text-[0.7rem]" aria-label="Choose Phones &amp; Tablets products"><span aria-hidden="true">🛒</span><span>CHOOSE</span></a>
          </nav>
        </article>

        <article class="group border-border bg-background overflow-hidden rounded-[1.35rem] border shadow-[0_8px_28px_rgba(15,42,67,0.07)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(15,42,67,0.13)]">
          <!-- Compartment 1: visual — dominant 70–75% of the main card face -->
          <a href={internetPath} aria-label="Explore Home Internet &amp; Wi-Fi" class="flex h-[235px] items-center justify-center overflow-hidden bg-[#edf8ef] sm:h-[250px] lg:h-[265px] dark:bg-[#142f29]">
            <img src="/homepage/wifi.png" alt="Home internet and Wi-Fi"
              class="h-full w-full scale-[1.28] object-contain drop-shadow-[0_12px_16px_rgba(15,42,67,0.14)] transition duration-300 group-hover:scale-[1.34]"
              loading="lazy" />
          </a>

          <!-- Compartment 2: title / hub entry — compact 25–30% -->
          <div class="border-border border-t px-4 py-2.5 sm:px-5">
            <a href={internetPath} class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-foreground font-serif text-lg font-black leading-tight sm:text-xl">Home Internet &amp; Wi-Fi</h3>
                <p class="text-muted-foreground mt-0.5 truncate text-xs sm:text-[0.82rem]">Connections, routers, speed and coverage.</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#daf2df] text-xl font-bold text-[#18783a] transition group-hover:translate-x-1 dark:bg-[#1d4436]" aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Compartment 3: direct ONOCRA journeys -->
          <nav class="border-border grid grid-cols-4 divide-x divide-border border-t" aria-label="Home Internet &amp; Wi-Fi help options">
            <a href={`${internetPath}#fix`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#078fe3] transition hover:bg-[#078fe3]/10 sm:text-[0.7rem]" aria-label="Fix Home Internet &amp; Wi-Fi problems"><span aria-hidden="true">🔧</span><span>FIX</span></a>
            <a href={`${internetPath}#decode`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#42a54d] transition hover:bg-[#42a54d]/10 sm:text-[0.7rem]" aria-label="Understand Home Internet &amp; Wi-Fi"><span aria-hidden="true">💡</span><span>DECODE</span></a>
            <a href={`${internetPath}#compare`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#ef5b16] transition hover:bg-[#ef5b16]/10 sm:text-[0.7rem]" aria-label="Compare Home Internet &amp; Wi-Fi options"><span aria-hidden="true">⚖</span><span>COMPARE</span></a>
            <a href={`${internetPath}#choose`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#7c22e8] transition hover:bg-[#7c22e8]/10 sm:text-[0.7rem]" aria-label="Choose Home Internet &amp; Wi-Fi products"><span aria-hidden="true">🛒</span><span>CHOOSE</span></a>
          </nav>
        </article>

        <article class="group border-border bg-background overflow-hidden rounded-[1.35rem] border shadow-[0_8px_28px_rgba(15,42,67,0.07)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(15,42,67,0.13)]">
          <!-- Compartment 1: visual — dominant 70–75% of the main card face -->
          <a href={computersPath} aria-label="Explore Computers &amp; Laptops" class="flex h-[235px] items-center justify-center overflow-hidden bg-[#fff5df] sm:h-[250px] lg:h-[265px] dark:bg-[#382d1b]">
            <img src="/homepage/computers.png" alt="Computers and laptops"
              class="h-full w-full scale-[1.28] object-contain drop-shadow-[0_12px_16px_rgba(15,42,67,0.14)] transition duration-300 group-hover:scale-[1.34]"
              loading="lazy" />
          </a>

          <!-- Compartment 2: title / hub entry — compact 25–30% -->
          <div class="border-border border-t px-4 py-2.5 sm:px-5">
            <a href={computersPath} class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-foreground font-serif text-lg font-black leading-tight sm:text-xl">Computers &amp; Laptops</h3>
                <p class="text-muted-foreground mt-0.5 truncate text-xs sm:text-[0.82rem]">Windows, Mac, software and everyday fixes.</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#ffebc2] text-xl font-bold text-[#e66b00] transition group-hover:translate-x-1 dark:bg-[#503a1e]" aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Compartment 3: direct ONOCRA journeys -->
          <nav class="border-border grid grid-cols-4 divide-x divide-border border-t" aria-label="Computers &amp; Laptops help options">
            <a href={`${computersPath}#fix`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#078fe3] transition hover:bg-[#078fe3]/10 sm:text-[0.7rem]" aria-label="Fix Computers &amp; Laptops problems"><span aria-hidden="true">🔧</span><span>FIX</span></a>
            <a href={`${computersPath}#decode`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#42a54d] transition hover:bg-[#42a54d]/10 sm:text-[0.7rem]" aria-label="Understand Computers &amp; Laptops"><span aria-hidden="true">💡</span><span>DECODE</span></a>
            <a href={`${computersPath}#compare`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#ef5b16] transition hover:bg-[#ef5b16]/10 sm:text-[0.7rem]" aria-label="Compare Computers &amp; Laptops options"><span aria-hidden="true">⚖</span><span>COMPARE</span></a>
            <a href={`${computersPath}#choose`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#7c22e8] transition hover:bg-[#7c22e8]/10 sm:text-[0.7rem]" aria-label="Choose Computers &amp; Laptops products"><span aria-hidden="true">🛒</span><span>CHOOSE</span></a>
          </nav>
        </article>

        <article class="group border-border bg-background overflow-hidden rounded-[1.35rem] border shadow-[0_8px_28px_rgba(15,42,67,0.07)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(15,42,67,0.13)]">
          <!-- Compartment 1: visual — dominant 70–75% of the main card face -->
          <a href={safetyPath} aria-label="Explore Digital Security" class="flex h-[235px] items-center justify-center overflow-hidden bg-[#f5edfb] sm:h-[250px] lg:h-[265px] dark:bg-[#30243b]">
            <img src="/homepage/security.png" alt="Digital safety, scams and security"
              class="h-full w-full scale-[1.28] object-contain drop-shadow-[0_12px_16px_rgba(15,42,67,0.14)] transition duration-300 group-hover:scale-[1.34]"
              loading="lazy" />
          </a>

          <!-- Compartment 2: title / hub entry — compact 25–30% -->
          <div class="border-border border-t px-4 py-2.5 sm:px-5">
            <a href={safetyPath} class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-foreground font-serif text-lg font-black leading-tight sm:text-xl">Digital Security</h3>
                <p class="text-muted-foreground mt-0.5 truncate text-xs sm:text-[0.82rem]">Scams, privacy, passwords and safer accounts.</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#eadcf8] text-xl font-bold text-[#7131b5] transition group-hover:translate-x-1 dark:bg-[#49335e]" aria-hidden="true">→</span>
            </a>
          </div>

