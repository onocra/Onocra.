<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem(
        "backUrl",
        indexLayout.homePath ?? baseRoot
      );
    }

    /* ASK ONOCRA — IMAGE CONTROL */

    const imageButton = document.querySelector(
      "#onocra-image-button"
    ) as HTMLButtonElement | null;

    const imageInput = document.querySelector(
      "#onocra-image-input"
    ) as HTMLInputElement | null;

    const imageStatus = document.querySelector(
      "#onocra-image-status"
    ) as HTMLElement | null;

    const imageName = document.querySelector(
      "#onocra-image-name"
    ) as HTMLElement | null;

    const imageRemove = document.querySelector(
      "#onocra-image-remove"
    ) as HTMLButtonElement | null;

    imageButton?.addEventListener("click", () => {
      imageInput?.click();
    });

    imageInput?.addEventListener("change", () => {
      const file = imageInput.files?.[0];

      if (!file) return;

      if (imageName) {
        imageName.textContent = file.name;
      }

      imageStatus?.classList.remove("hidden");
      imageStatus?.classList.add("flex");
    });

    imageRemove?.addEventListener("click", () => {
      if (imageInput) {
        imageInput.value = "";
      }

      imageStatus?.classList.add("hidden");
      imageStatus?.classList.remove("flex");
    });

    /* ASK ONOCRA — MICROPHONE CONTROL */

    const micButton = document.querySelector(
      "#onocra-mic-button"
    ) as HTMLButtonElement | null;

    const questionInput = document.querySelector(
      "#onocra-question"
    ) as HTMLInputElement | null;

    const SpeechRecognition =
      (window as any).SpeechRecognition ||
      (window as any).webkitSpeechRecognition;

    if (micButton && questionInput) {
      if (SpeechRecognition) {
        const recognition = new SpeechRecognition();

        recognition.continuous = false;
        recognition.interimResults = false;
        recognition.lang =
          navigator.language || "en-US";

        micButton.addEventListener("click", () => {
          try {
            recognition.start();

            micButton.classList.add(
              "bg-[var(--onocra-sage)]"
            );

            micButton.setAttribute(
              "aria-label",
              "Listening"
            );
          } catch {
            /* Recognition may already be running. */
          }
        });

        recognition.onresult = (event: any) => {
          const transcript =
            event.results?.[0]?.[0]?.transcript ?? "";

          if (transcript) {
            questionInput.value = transcript;
            questionInput.focus();
          }
        };

        recognition.onend = () => {
          micButton.classList.remove(
            "bg-[var(--onocra-sage)]"
          );

          micButton.setAttribute(
            "aria-label",
            "Speak your question"
          );
        };
      } else {
        micButton.addEventListener("click", () => {
          questionInput.focus();
        });

        micButton.title =
          "Voice input is not supported by this browser";
      }
    }


    /* HOMEPAGE PROMO VIDEO — compact preview, expand on play, shrink on finish */
    const promoShell = document.querySelector(
      "[data-home-promo-shell]"
    ) as HTMLElement | null;

    const promoVideo = document.querySelector(
      "[data-home-promo-video]"
    ) as HTMLVideoElement | null;

    const promoLaunch = document.querySelector(
      "[data-home-promo-launch]"
    ) as HTMLButtonElement | null;

    const promoClose = document.querySelector(
      "[data-home-promo-close]"
    ) as HTMLButtonElement | null;

    const collapsePromo = (reset = false) => {
      if (!promoShell || !promoVideo) return;
      promoShell.classList.remove("is-expanded");
      document.documentElement.classList.remove("onocra-promo-open");
      promoVideo.controls = false;
      promoLaunch?.removeAttribute("hidden");
      if (reset) {
        promoVideo.pause();
        promoVideo.currentTime = 0;
      }
    };

    const expandPromo = async () => {
      if (!promoShell || !promoVideo) return;
      promoShell.classList.add("is-expanded");
      document.documentElement.classList.add("onocra-promo-open");
      promoVideo.controls = true;
      promoLaunch?.setAttribute("hidden", "");
      if (promoVideo.readyState === 0) promoVideo.load();
      try {
        await promoVideo.play();
      } catch {
        promoLaunch?.removeAttribute("hidden");
      }
    };

    promoLaunch?.addEventListener("click", expandPromo);
    promoClose?.addEventListener("click", () => collapsePromo(false));
    promoVideo?.addEventListener("ended", () => collapsePromo(true));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && promoShell?.classList.contains("is-expanded")) {
        collapsePromo(false);
      }
    });
  });
</script>

