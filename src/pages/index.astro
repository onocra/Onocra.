---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
const searchPath = getRelativeLocaleUrl(locale, "search");
const phonesPath = getRelativeLocaleUrl(locale, "phones");
const internetPath = getRelativeLocaleUrl(locale, "internet");
const computersPath = getRelativeLocaleUrl(locale, "computers");
const safetyPath = getRelativeLocaleUrl(locale, "safety");
---

<Layout
  title="ONOCRA — Practical Technology Help for Everyday Households"
  description="ONOCRA makes technology easier for ordinary householders with clear, practical answers, step-by-step fixes, plain-English explanations, useful comparisons and smarter buying guidance."
>
  <Header />


  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <!-- =========================================
         ONOCRA WELCOME HERO
    ========================================== -->
    <section class="border-border border-b pb-6 sm:pb-8">
      <div class="pt-3 sm:pt-4">
        <div class="overflow-hidden rounded-3xl">
          <img
            src="/homepage/pelicanhero.png"
            alt="ONOCRA welcomes ordinary householders to practical technology help, with Fix, Decode, Compare and Choose guidance for everyday tech questions."
            class="block h-auto w-full"
            width="2048"
            height="768"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <!--
          The hero artwork contains visual typography, but this real HTML gives
          people, assistive technology and search engines the same core message.
        -->
        <div class="mx-auto max-w-6xl px-4 py-5 text-center sm:py-6">
        <h1 class="text-foreground m-0 font-serif text-[1.35rem] font-black leading-[1.12] tracking-[-0.018em] sm:text-[1.65rem] lg:text-[1.9rem]">
          Practical technology help for ordinary householders
        </h1>
        <p class="text-muted-foreground dark:text-foreground/90 mx-auto mt-1.5 max-w-[66rem] text-center text-[0.84rem] leading-[1.45] sm:text-[0.9rem] lg:text-[0.95rem]">
          <span class="block">ONOCRA makes TechnoNavigation easy with clear, practical answers for everyday technology questions.</span>
          <span class="block">Fix problems, understand technology, compare options and choose with confidence — without the technical jargon.</span>
        </p>
      </div>
      </div>

      <!-- ASK ONOCRA -->
      <div id="ask-onocra" class="mt-2 sm:mt-3">
        <div class="mb-1.5 flex items-center justify-between gap-4">
          <p
            class="text-sm font-bold tracking-[0.14em] text-[#F4511E] uppercase sm:text-base"
          >
            Ask ONOCRA
          </p>

          <span class="text-muted-foreground hidden text-xs sm:inline">
            Type, speak or show me
          </span>
        </div>

        <form
          action={searchPath}
          method="get"
          class="border-border bg-background flex items-center gap-1 rounded-2xl border p-1.5 shadow-sm sm:gap-2"
        >
          <svg
            class="ml-2 h-5 w-5 shrink-0 text-[#F4511E] sm:ml-3"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>

          <input
            id="onocra-question"
            type="search"
            name="q"
            aria-label="Ask ONOCRA"
            placeholder="Tell me what's happening..."
            class="text-foreground min-w-0 flex-1 bg-transparent px-1.5 py-2.5 text-base outline-none sm:px-2"
          />

          <input
            id="onocra-image-input"
            type="file"
            accept="image/*"
            class="hidden"
          />

          <button
            id="onocra-image-button"
            type="button"
            title="Upload an image"
            aria-label="Upload an image"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-[#F4511E] transition hover:bg-[#F4511E]/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F4511E]"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14.5 4h-5L8 6H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-3z"></path>
              <circle cx="12" cy="13" r="3"></circle>
            </svg>
          </button>

          <button
            id="onocra-mic-button"
            type="button"
            title="Speak your question"
            aria-label="Speak your question"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-[#F4511E] transition hover:bg-[#F4511E]/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F4511E]"
          >
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="2" width="6" height="12" rx="3"></rect>
              <path d="M5 10a7 7 0 0 0 14 0"></path>
              <path d="M12 17v5"></path>
              <path d="M8 22h8"></path>
            </svg>
          </button>

          <button
            type="submit"
            class="shrink-0 rounded-xl bg-[#F4511E] px-4 py-2.5 font-bold text-white transition hover:bg-[#D84315] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#F4511E] sm:px-7"
          >
            Ask
            <span class="hidden sm:inline" aria-hidden="true"> →</span>
          </button>
        </form>

        <div
          id="onocra-image-status"
          class="mt-2 hidden items-center gap-2 rounded-xl bg-[var(--onocra-sage)] px-3 py-2 text-sm text-[var(--onocra-forest)]"
        >
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <path d="m21 15-5-5L5 21"></path>
          </svg>

          <span id="onocra-image-name" class="min-w-0 flex-1 truncate">
            Image selected
          </span>

          <button
            id="onocra-image-remove"
            type="button"
            aria-label="Remove selected image"
            class="shrink-0 font-bold"
          >
            ×
          </button>
        </div>

        <div class="mt-2.5 flex items-center gap-2 overflow-x-auto pb-1">
          <span class="shrink-0 text-sm font-bold text-[#F4511E]">
            Try:
          </span>

          <a
            href={`${searchPath}?q=Wi-Fi%20not%20working`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Wi-Fi not working
          </a>

          <a
            href={`${searchPath}?q=Best%20phone%20for%20parents`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Best phone for parents
          </a>

          <a
            href={`${searchPath}?q=Windows%20update`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Windows update
          </a>

          <a
            href={`${searchPath}?q=Is%20this%20a%20scam`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Is this a scam?
          </a>

          <a
            href={`${searchPath}?q=Set%20parental%20controls`}
            class="border-border bg-background shrink-0 rounded-full border px-3.5 py-1.5 text-sm transition hover:bg-[var(--onocra-sage)]"
          >
            Set parental controls
          </a>
        </div>
      </div>
    </section>

    <!-- =========================================
         EXPLORE TECHNOLOGY TOPICS — 3-COMPARTMENT CARDS
    ========================================== -->
    <section id="topics" class="border-border border-b py-2 sm:py-2.5">
      <div class="mb-3">
        <p class="text-accent text-[0.7rem] font-bold tracking-[0.18em] uppercase sm:text-xs">
          Start with what you need
        </p>
        <div class="mt-0.5 flex flex-wrap items-baseline gap-x-4 gap-y-0.5">
          <h2 class="text-foreground font-serif text-[1.55rem] font-black leading-tight tracking-[-0.025em] sm:text-[1.8rem] lg:text-[1.95rem]">
            Explore Technology Topics
          </h2>
          <p class="text-muted-foreground text-[0.78rem] font-medium sm:text-[0.86rem]">
            Choose a topic below to fix, understand, compare or choose.
          </p>
        </div>
      </div>

      <div class="grid gap-3 md:grid-cols-2 lg:gap-4">
        <article class="group border-border bg-background overflow-hidden rounded-[1.35rem] border shadow-[0_8px_28px_rgba(15,42,67,0.07)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(15,42,67,0.13)]">
          <!-- Compartment 1: visual — dominant 70–75% of the main card face -->
          <a href={phonesPath} aria-label="Explore Phones, Tablets &amp; Wearables" class="flex h-[235px] items-center justify-center overflow-hidden bg-[#eaf7fc] sm:h-[250px] lg:h-[265px] dark:bg-[#102b3a]">
            <img src="/homepage/phones.png" alt="Phones, tablets and wearable technology"
              class="h-full w-full scale-[1.28] object-contain drop-shadow-[0_12px_16px_rgba(15,42,67,0.14)] transition duration-300 group-hover:scale-[1.34]"
              loading="lazy" />
          </a>

          <!-- Compartment 2: title / hub entry — compact 25–30% -->
          <div class="border-border border-t px-4 py-2.5 sm:px-5">
            <a href={phonesPath} class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-foreground font-serif text-lg font-black leading-tight sm:text-xl">Phones, Tablets &amp; Wearables</h3>
                <p class="text-muted-foreground mt-0.5 truncate text-xs sm:text-[0.82rem]">Setup, problems, features and buying help.</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#d8f0fb] text-xl font-bold text-[#087EBA] transition group-hover:translate-x-1 dark:bg-[#163d50]" aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Compartment 3: direct ONOCRA journeys -->
          <nav class="border-border grid grid-cols-4 divide-x divide-border border-t" aria-label="Phones, Tablets &amp; Wearables help options">
            <a href={`${phonesPath}#fix`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#078fe3] transition hover:bg-[#078fe3]/10 sm:text-[0.7rem]" aria-label="Fix Phones, Tablets &amp; Wearables problems"><span aria-hidden="true">🔧</span><span>FIX</span></a>
            <a href={`${phonesPath}#decode`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#42a54d] transition hover:bg-[#42a54d]/10 sm:text-[0.7rem]" aria-label="Understand Phones, Tablets &amp; Wearables"><span aria-hidden="true">💡</span><span>DECODE</span></a>
            <a href={`${phonesPath}#compare`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#ef5b16] transition hover:bg-[#ef5b16]/10 sm:text-[0.7rem]" aria-label="Compare Phones, Tablets &amp; Wearables options"><span aria-hidden="true">⚖</span><span>COMPARE</span></a>
            <a href={`${phonesPath}#choose`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#7c22e8] transition hover:bg-[#7c22e8]/10 sm:text-[0.7rem]" aria-label="Choose Phones, Tablets &amp; Wearables products"><span aria-hidden="true">🛒</span><span>CHOOSE</span></a>
          </nav>
        </article>

        <article class="group border-border bg-background overflow-hidden rounded-[1.35rem] border shadow-[0_8px_28px_rgba(15,42,67,0.07)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(15,42,67,0.13)]">
          <!-- Compartment 1: visual — dominant 70–75% of the main card face -->
          <a href={internetPath} aria-label="Explore Home Internet &amp; Wi-Fi" class="flex h-[235px] items-center justify-center overflow-hidden bg-[#edf8ef] sm:h-[250px] lg:h-[265px] dark:bg-[#142f29]">
            <img src="/homepage/wifi.png" alt="Home internet and Wi-Fi"
              class="h-full w-full scale-[1.28] object-contain drop-shadow-[0_12px_16px_rgba(15,42,67,0.14)] transition duration-300 group-hover:scale-[1.34]"
              loading="lazy" />
          </a>

          <!-- Compartment 2: title / hub entry — compact 25–30% -->
          <div class="border-border border-t px-4 py-2.5 sm:px-5">
            <a href={internetPath} class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-foreground font-serif text-lg font-black leading-tight sm:text-xl">Home Internet &amp; Wi-Fi</h3>
                <p class="text-muted-foreground mt-0.5 truncate text-xs sm:text-[0.82rem]">Connections, routers, speed and coverage.</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#daf2df] text-xl font-bold text-[#18783a] transition group-hover:translate-x-1 dark:bg-[#1d4436]" aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Compartment 3: direct ONOCRA journeys -->
          <nav class="border-border grid grid-cols-4 divide-x divide-border border-t" aria-label="Home Internet &amp; Wi-Fi help options">
            <a href={`${internetPath}#fix`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#078fe3] transition hover:bg-[#078fe3]/10 sm:text-[0.7rem]" aria-label="Fix Home Internet &amp; Wi-Fi problems"><span aria-hidden="true">🔧</span><span>FIX</span></a>
            <a href={`${internetPath}#decode`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#42a54d] transition hover:bg-[#42a54d]/10 sm:text-[0.7rem]" aria-label="Understand Home Internet &amp; Wi-Fi"><span aria-hidden="true">💡</span><span>DECODE</span></a>
            <a href={`${internetPath}#compare`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#ef5b16] transition hover:bg-[#ef5b16]/10 sm:text-[0.7rem]" aria-label="Compare Home Internet &amp; Wi-Fi options"><span aria-hidden="true">⚖</span><span>COMPARE</span></a>
            <a href={`${internetPath}#choose`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#7c22e8] transition hover:bg-[#7c22e8]/10 sm:text-[0.7rem]" aria-label="Choose Home Internet &amp; Wi-Fi products"><span aria-hidden="true">🛒</span><span>CHOOSE</span></a>
          </nav>
        </article>

        <article class="group border-border bg-background overflow-hidden rounded-[1.35rem] border shadow-[0_8px_28px_rgba(15,42,67,0.07)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(15,42,67,0.13)]">
          <!-- Compartment 1: visual — dominant 70–75% of the main card face -->
          <a href={computersPath} aria-label="Explore Computers &amp; Laptops" class="flex h-[235px] items-center justify-center overflow-hidden bg-[#fff5df] sm:h-[250px] lg:h-[265px] dark:bg-[#382d1b]">
            <img src="/homepage/computers.png" alt="Computers and laptops"
              class="h-full w-full scale-[1.28] object-contain drop-shadow-[0_12px_16px_rgba(15,42,67,0.14)] transition duration-300 group-hover:scale-[1.34]"
              loading="lazy" />
          </a>

          <!-- Compartment 2: title / hub entry — compact 25–30% -->
          <div class="border-border border-t px-4 py-2.5 sm:px-5">
            <a href={computersPath} class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-foreground font-serif text-lg font-black leading-tight sm:text-xl">Computers &amp; Laptops</h3>
                <p class="text-muted-foreground mt-0.5 truncate text-xs sm:text-[0.82rem]">Windows, Mac, software and everyday fixes.</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#ffebc2] text-xl font-bold text-[#e66b00] transition group-hover:translate-x-1 dark:bg-[#503a1e]" aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Compartment 3: direct ONOCRA journeys -->
          <nav class="border-border grid grid-cols-4 divide-x divide-border border-t" aria-label="Computers &amp; Laptops help options">
            <a href={`${computersPath}#fix`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#078fe3] transition hover:bg-[#078fe3]/10 sm:text-[0.7rem]" aria-label="Fix Computers &amp; Laptops problems"><span aria-hidden="true">🔧</span><span>FIX</span></a>
            <a href={`${computersPath}#decode`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#42a54d] transition hover:bg-[#42a54d]/10 sm:text-[0.7rem]" aria-label="Understand Computers &amp; Laptops"><span aria-hidden="true">💡</span><span>DECODE</span></a>
            <a href={`${computersPath}#compare`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#ef5b16] transition hover:bg-[#ef5b16]/10 sm:text-[0.7rem]" aria-label="Compare Computers &amp; Laptops options"><span aria-hidden="true">⚖</span><span>COMPARE</span></a>
            <a href={`${computersPath}#choose`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#7c22e8] transition hover:bg-[#7c22e8]/10 sm:text-[0.7rem]" aria-label="Choose Computers &amp; Laptops products"><span aria-hidden="true">🛒</span><span>CHOOSE</span></a>
          </nav>
        </article>

        <article class="group border-border bg-background overflow-hidden rounded-[1.35rem] border shadow-[0_8px_28px_rgba(15,42,67,0.07)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(15,42,67,0.13)]">
          <!-- Compartment 1: visual — dominant 70–75% of the main card face -->
          <a href={safetyPath} aria-label="Explore Safety &amp; Security" class="flex h-[235px] items-center justify-center overflow-hidden bg-[#f5edfb] sm:h-[250px] lg:h-[265px] dark:bg-[#30243b]">
            <img src="/homepage/security.png" alt="Digital safety, scams and security"
              class="h-full w-full scale-[1.28] object-contain drop-shadow-[0_12px_16px_rgba(15,42,67,0.14)] transition duration-300 group-hover:scale-[1.34]"
              loading="lazy" />
          </a>

          <!-- Compartment 2: title / hub entry — compact 25–30% -->
          <div class="border-border border-t px-4 py-2.5 sm:px-5">
            <a href={safetyPath} class="flex items-center justify-between gap-3">
              <div class="min-w-0">
                <h3 class="text-foreground font-serif text-lg font-black leading-tight sm:text-xl">Safety &amp; Security</h3>
                <p class="text-muted-foreground mt-0.5 truncate text-xs sm:text-[0.82rem]">Scams, privacy, passwords and safer accounts.</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#eadcf8] text-xl font-bold text-[#7131b5] transition group-hover:translate-x-1 dark:bg-[#49335e]" aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Compartment 3: direct ONOCRA journeys -->
          <nav class="border-border grid grid-cols-4 divide-x divide-border border-t" aria-label="Safety &amp; Security help options">
            <a href={`${safetyPath}#fix`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#078fe3] transition hover:bg-[#078fe3]/10 sm:text-[0.7rem]" aria-label="Fix Safety &amp; Security problems"><span aria-hidden="true">🔧</span><span>FIX</span></a>
            <a href={`${safetyPath}#decode`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#42a54d] transition hover:bg-[#42a54d]/10 sm:text-[0.7rem]" aria-label="Understand Safety &amp; Security"><span aria-hidden="true">💡</span><span>DECODE</span></a>
            <a href={`${safetyPath}#compare`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#ef5b16] transition hover:bg-[#ef5b16]/10 sm:text-[0.7rem]" aria-label="Compare Safety &amp; Security options"><span aria-hidden="true">⚖</span><span>COMPARE</span></a>
            <a href={`${safetyPath}#choose`} class="flex min-h-11 items-center justify-center gap-1 px-1 text-[0.62rem] font-extrabold text-[#7c22e8] transition hover:bg-[#7c22e8]/10 sm:text-[0.7rem]" aria-label="Choose Safety &amp; Security products"><span aria-hidden="true">🛒</span><span>CHOOSE</span></a>
          </nav>
        </article>
      </div>
    </section>

    <div id="updates" class="scroll-mt-6"></div>

    <!-- DIGITAL PARENTING — blueprint-matched compact feature -->
    <section id="digital-parenting" class="onocra-parenting-section border-border border-b py-2 sm:py-2.5">
      <div class="overflow-hidden rounded-[1.8rem] border border-[#eadfd2] bg-[#fffaf3] shadow-[0_10px_32px_rgba(15,42,67,0.07)] dark:border-white/10 dark:bg-[#17262a]">
        <div class="onocra-parenting-card">
          <!-- LEFT -->
          <div class="onocra-parenting-copy flex min-w-0 flex-col justify-center px-6 py-4 sm:px-7 lg:px-8 lg:py-4">
            <p class="text-[0.72rem] font-extrabold tracking-[0.19em] text-[#13816e] uppercase sm:text-[0.78rem]">
              Digital Parenting
            </p>
            <div class="mt-2 h-[2px] w-12 rounded-full bg-[#f28c45]"></div>

            <h2 class="text-foreground mt-2.5 font-serif text-[1.65rem] font-black leading-[1.02] tracking-[-0.035em] sm:text-[1.85rem] lg:text-[2rem]">
              Helping families navigate<br />
              technology together
            </h2>

            <p class="text-muted-foreground dark:text-foreground/85 mt-2.5 max-w-[40rem] text-[0.78rem] leading-[1.38] sm:text-[0.84rem]">
              Practical help with screen time, first phones, parental controls, gaming,
              social media, online safety and AI.
            </p>

            <div class="mt-3 flex flex-wrap gap-1.5">
              <a href={`${searchPath}?q=screen%20time`} class="border-border text-foreground rounded-full border bg-[#edf8f2] px-2.5 py-1 text-[0.67rem] font-semibold dark:bg-[#1d3933]">
                ◷&nbsp; Screen time
              </a>
