---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const homePath = getRelativeLocaleUrl(locale, "");
const searchPath = getRelativeLocaleUrl(locale, "search");
const guidesPath = getRelativeLocaleUrl(locale, "guides");
const guidesStep2Path = getRelativeLocaleUrl(locale, "guides/step-2");
const guidesStep3Path = getRelativeLocaleUrl(locale, "guides/step-3");
const guidesStep4Path = getRelativeLocaleUrl(locale, "guides/step-4");

const quickComputers = `${guidesStep3Path}?zone=quick-help&area=computers`;
const quickLaptops = `${guidesStep3Path}?zone=quick-help&area=laptops`;
const readComputers = `${guidesStep3Path}?zone=read-learn&area=computers`;
const watchComputers = `${guidesStep3Path}?zone=watch-learn&area=computers`;
const buildSkills = `${guidesStep2Path}?zone=build-skills`;
const peerComputers = `${guidesStep3Path}?zone=peer-guidance&area=computers`;

const computerCategories = [
  {
    id: "windows-pc",
    title: "Windows PCs",
    note: "Windows desktop towers and standard desktop PCs.",
    icon: "windows",
  },
  {
    id: "mac-computers",
    title: "Mac Computers",
    note: "iMac, Mac mini, Mac Studio and other Apple desktops.",
    icon: "mac",
  },
  {
    id: "all-in-one-pc",
    title: "All-in-One PCs",
    note: "Desktop computers with the computer built into the display.",
    icon: "allinone",
  },
  {
    id: "mini-pc",
    title: "Mini PCs & Small Form",
    note: "Compact desktop computers and small-form systems.",
    icon: "mini",
  },
  {
    id: "gaming-pc",
    title: "Gaming PCs",
    note: "Desktop gaming and high-performance computers.",
    icon: "gaming",
  },
  {
    id: "computer-software",
    title: "Software & Applications",
    note: "Windows/macOS software, browsers, Office, drivers and apps.",
    icon: "software",
  },
];

const laptopCategories = [
  {
    id: "windows-laptop",
    title: "Windows Laptops",
    note: "Dell, HP, Lenovo, Acer, ASUS and other Windows laptops.",
    icon: "laptop",
  },
  {
    id: "macbook",
    title: "MacBooks",
    note: "MacBook Air, MacBook Pro and macOS.",
    icon: "mac",
  },
  {
    id: "chromebook",
    title: "Chromebooks",
    note: "ChromeOS laptops for home, school and work.",
    icon: "chrome",
  },
  {
    id: "gaming-laptop",
    title: "Gaming Laptops",
    note: "High-performance portable gaming computers.",
    icon: "gaming",
  },
  {
    id: "two-in-one",
    title: "2-in-1 & Convertibles",
    note: "Touchscreen, foldable and detachable laptop devices.",
    icon: "convertible",
  },
  {
    id: "laptop-software",
    title: "Software & Applications",
    note: "Apps, operating-system updates, drivers and laptop software.",
    icon: "software",
  },
];

const brands = [
  { name: "Apple", image: "/apple.png" },
  { name: "Dell", image: "/dell.png" },
  { name: "HP", image: "/hp.png" },
  { name: "Lenovo", image: "/lenovo.png" },
  { name: "ASUS", image: "/asus.png" },
  { name: "Acer", image: "/acer.png" },
];

const useCases = [
  {
    title: "Everyday Home",
    note: "Browsing, bills, email, video calls and household tasks.",
    query: "best computer laptop for everyday home use",
    icon: "home",
  },
  {
    title: "Study",
    note: "School, university, research, assignments and portability.",
    query: "best laptop for students",
    icon: "study",
  },
  {
    title: "Work & Business",
    note: "Office work, meetings, multitasking and reliability.",
    query: "best laptop computer for work business",
    icon: "work",
  },
  {
    title: "Creative Work",
    note: "Photo, video, design, music and content creation.",
    query: "best computer laptop for creative work",
    icon: "creative",
  },
  {
    title: "Gaming",
    note: "Graphics performance, cooling, display and upgrade needs.",
    query: "best gaming pc laptop",
    icon: "gaming",
  },
  {
    title: "Portable & Travel",
    note: "Battery life, weight, size and working away from home.",
    query: "best lightweight laptop battery travel",
    icon: "travel",
  },
];

const categoryHref = (area: "computers" | "laptops", category: string) =>
  `${guidesStep4Path}?zone=quick-help&area=${area}&category=${category}`;

const searchHref = (query: string) => `${searchPath}?q=${encodeURIComponent(query)}`;
---

<Layout
  title="Computers & Laptops | ONOCRA"
  description="Practical computer and laptop help for ordinary households: fixes, plain-English explanations, comparisons, buying guidance and safer everyday use."
>
  <Header />

  <main id="main-content" class="computer-hub" data-layout="computers-hub">
    <!-- ======================================================
         HERO
    ======================================================= -->
    <section class="hub-hero-shell">
      <div class="hub-hero-copy">
        <nav class="hub-breadcrumb" aria-label="Breadcrumb">
          <a href={homePath}>Home</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">Computers &amp; Laptops</span>
        </nav>

        <p class="hub-kicker">ONOCRA · COMPUTERS &amp; LAPTOPS</p>

        <h1>
          Practical computer help.<br />
          <span>Without the technical maze.</span>
        </h1>

        <p class="hub-lead">
          Fix everyday problems, understand what the settings mean, compare options
          clearly and choose the right computer or laptop for your household.
        </p>

        <div class="hub-country-row" aria-label="ONOCRA regional focus">
          <span>
            <img src="/internet/flag-us.png" alt="" />
            United States
          </span>
          <span>
            <img src="/internet/flag-uk.png" alt="" />
            United Kingdom
          </span>
          <span>
            <img src="/internet/flag-germany.png" alt="" />
            Germany
          </span>
        </div>

        <div class="hub-hero-actions">
          <a class="hub-primary-button" href={quickComputers}>
            Start Quick Help
            <b aria-hidden="true">→</b>
          </a>
          <a class="hub-secondary-button" href={`${guidesPath}`}>
            Open Diagnostics &amp; Guides
          </a>
        </div>
      </div>

      <div class="hub-hero-visual">
        <div class="hub-hero-image-wrap">
          <img
            src="/homepage/computers.png"
            alt="Computers and laptops for home, study, work and everyday use"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <div class="hub-hero-pelican">
          <img src="/guides/pelican-guide.png" alt="" loading="eager" />
          <div>
            <strong>Not sure where to begin?</strong>
            <span>Tell ONOCRA what is happening and start with the simplest route.</span>
          </div>
        </div>
      </div>

      <div class="hub-botanical" aria-hidden="true">
        <svg viewBox="0 0 1200 90" preserveAspectRatio="none">
          <path class="bot-stem" d="M0 60 C110 16 195 76 310 42 S515 18 625 48 S830 72 945 37 S1110 24 1200 52"/>
          <g class="bot-leaves">
            <path d="M88 46q-34-25-51 3 20 27 51-3Z"/>
            <path d="M210 38q10-35 38-24 2 29-38 24Z"/>
            <path d="M372 50q-35 1-33 29 30 6 33-29Z"/>
            <path d="M525 34q10-34 37-25 2 29-37 25Z"/>
            <path d="M710 48q-34-7-39 21 28 15 39-21Z"/>
            <path d="M858 34q12-32 38-19 0 29-38 19Z"/>
            <path d="M1035 47q-34-10-42 17 25 19 42-17Z"/>
          </g>
          <g class="bot-flowers">
            <circle cx="460" cy="42" r="5"/>
            <circle cx="940" cy="39" r="5"/>
          </g>
        </svg>
      </div>
    </section>

    <!-- ======================================================
         ASK ONOCRA
    ======================================================= -->
    <section class="hub-section hub-ask" aria-labelledby="computer-ask-title">
      <div class="section-heading section-heading--compact">
        <div>
          <p>Ask ONOCRA</p>
          <h2 id="computer-ask-title">What is your computer doing?</h2>
        </div>
        <span>Type the problem in ordinary words.</span>
      </div>

      <form action={searchPath} method="get" class="hub-search-form">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          type="search"
          name="q"
          aria-label="Ask ONOCRA about computers and laptops"
          placeholder="For example: my laptop is very slow after an update"
        />
        <button type="submit">Ask <span aria-hidden="true">→</span></button>
      </form>

      <div class="hub-search-chips" aria-label="Popular computer questions">
        <a href={searchHref("Windows computer running slow")}>Computer running slow</a>
        <a href={searchHref("Laptop battery draining quickly")}>Battery draining</a>
        <a href={searchHref("Laptop will not connect to Wi-Fi")}>Wi-Fi problem</a>
        <a href={searchHref("Printer not working with computer")}>Printer problem</a>
        <a href={searchHref("Windows update problem")}>Windows update</a>
      </div>
    </section>

    <!-- ======================================================
         FOUR ONOCRA ROUTES
    ======================================================= -->
    <section class="hub-section" aria-labelledby="routes-title">
      <div class="section-heading">
        <div>
          <p>Start with what you need</p>
          <h2 id="routes-title">Fix, Decode, Compare or Choose</h2>
        </div>
        <span>Use the same ONOCRA route language you see across the site.</span>
      </div>

      <div class="route-grid">
        <a class="route-card route-card--fix" href={quickComputers}>
          <span class="route-icon" aria-hidden="true">🔧</span>
          <div>
            <small>FIX</small>
            <h3>Solve a problem</h3>
            <p>Quick Help for crashes, updates, software, hardware, network and everyday faults.</p>
          </div>
          <b aria-hidden="true">→</b>
        </a>

        <a class="route-card route-card--decode" href={readComputers}>
          <span class="route-icon" aria-hidden="true">💡</span>
          <div>
            <small>DECODE</small>
            <h3>Understand it clearly</h3>
            <p>Plain-English help with Windows, macOS, processors, memory, storage, displays and software.</p>
          </div>
          <b aria-hidden="true">→</b>
        </a>

        <a class="route-card route-card--compare" href="#compare">
          <span class="route-icon" aria-hidden="true">⚖</span>
          <div>
            <small>COMPARE</small>
            <h3>Compare what matters</h3>
            <p>Desktop vs laptop, Windows vs Mac, everyday vs performance and other practical choices.</p>
          </div>
          <b aria-hidden="true">↓</b>
        </a>

        <a class="route-card route-card--choose" href="#choose">
          <span class="route-icon" aria-hidden="true">🛒</span>
          <div>
            <small>CHOOSE</small>
            <h3>Choose with confidence</h3>
            <p>Start from your household use, budget and priorities rather than specifications alone.</p>
          </div>
          <b aria-hidden="true">↓</b>
        </a>
      </div>
    </section>

    <!-- Advertisement -->
    <aside class="hub-ad" aria-label="Advertisement">
      <span>Advertisement</span>
    </aside>

    <!-- ======================================================
         QUICK HELP ENTRY — COMPUTERS VS LAPTOPS
    ======================================================= -->
    <section class="hub-section" id="fix" aria-labelledby="quick-help-title">
      <div class="section-heading">
        <div>
          <p>Diagnostics &amp; Guides</p>
          <h2 id="quick-help-title">Which type of computer needs help?</h2>
        </div>
        <span>Desktop computers and laptops use separate Quick Help paths.</span>
      </div>

      <div class="device-route-grid">
        <a class="device-route-card" href={quickComputers}>
          <div class="device-route-visual device-route-visual--desktop">
            <svg viewBox="0 0 120 90" aria-hidden="true">
              <rect x="17" y="12" width="86" height="53" rx="7"></rect>
              <path d="M48 78h24M60 65v13"></path>
            </svg>
          </div>
          <div class="device-route-copy">
            <small>DESKTOP PATH</small>
            <h3>Computers</h3>
            <p>Windows PCs, Macs, all-in-ones, mini PCs, gaming PCs and desktop software.</p>
            <span>Open Computer Quick Help <b aria-hidden="true">→</b></span>
          </div>
        </a>

        <a class="device-route-card" href={quickLaptops}>
          <div class="device-route-visual device-route-visual--laptop">
            <svg viewBox="0 0 120 90" aria-hidden="true">
              <rect x="25" y="12" width="70" height="48" rx="6"></rect>
              <path d="M14 69h92l-8 9H22l-8-9Z"></path>
            </svg>
          </div>
          <div class="device-route-copy">
            <small>PORTABLE PATH</small>
            <h3>Laptops</h3>
            <p>Windows laptops, MacBooks, Chromebooks, gaming laptops and 2-in-1 devices.</p>
            <span>Open Laptop Quick Help <b aria-hidden="true">→</b></span>
          </div>
        </a>
      </div>
    </section>

    <!-- ======================================================
         CATEGORY SHORTCUTS
    ======================================================= -->
    <section class="hub-section category-section" aria-labelledby="categories-title">
      <div class="section-heading">
        <div>
          <p>Go directly to the category</p>
          <h2 id="categories-title">Popular computer &amp; laptop help</h2>
        </div>
        <span>These shortcuts open the matching D&amp;G issue-selection screen.</span>
      </div>

      <div class="category-columns">
        <article class="category-family">
          <header>
            <div class="family-icon family-icon--desktop" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="12" rx="2"></rect>
                <path d="M8 21h8M12 16v5"></path>
              </svg>
            </div>
            <div>
              <small>COMPUTERS</small>
              <h3>Desktop categories</h3>
            </div>
          </header>

          <div class="category-card-grid">
            {computerCategories.map((item) => (
              <a href={categoryHref("computers", item.id)} class="category-card">
                <span class={`category-symbol category-symbol--${item.icon}`} aria-hidden="true"></span>
                <div>
                  <strong>{item.title}</strong>
                  <small>{item.note}</small>
                </div>
                <b aria-hidden="true">→</b>
              </a>
            ))}
          </div>
        </article>

        <article class="category-family">
          <header>
            <div class="family-icon family-icon--laptop" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="5" y="4" width="14" height="11" rx="2"></rect>
                <path d="M2.5 18h19l-1.5 2H4l-1.5-2Z"></path>
              </svg>
            </div>
            <div>
              <small>LAPTOPS</small>
              <h3>Portable categories</h3>
            </div>
          </header>

          <div class="category-card-grid">
            {laptopCategories.map((item) => (
              <a href={categoryHref("laptops", item.id)} class="category-card">
                <span class={`category-symbol category-symbol--${item.icon}`} aria-hidden="true"></span>
                <div>
                  <strong>{item.title}</strong>
                  <small>{item.note}</small>
                </div>
                <b aria-hidden="true">→</b>
              </a>
            ))}
          </div>
        </article>
      </div>
    </section>

    <!-- ======================================================
         LEARN / WATCH / SKILLS / PEER
    ======================================================= -->
    <section class="hub-section learning-section" id="decode" aria-labelledby="learn-title">
      <div class="learning-copy">
        <p class="hub-kicker">LEARN AT YOUR OWN PACE</p>
        <h2 id="learn-title">Not every computer question is a fault.</h2>
        <p>
          Sometimes you want to understand a setting, watch a demonstration, build a skill,
          or ask for guidance before you make a change.
        </p>
      </div>

      <div class="learning-links">
        <a href={readComputers}>
          <span aria-hidden="true">▤</span>
          <div>
            <small>READ &amp; LEARN</small>
            <strong>Plain-English computer learning</strong>
          </div>
          <b aria-hidden="true">→</b>
        </a>

        <a href={watchComputers}>
          <span aria-hidden="true">▶</span>
          <div>
            <small>WATCH &amp; LEARN</small>
            <strong>Visual demonstrations &amp; explainers</strong>
          </div>
          <b aria-hidden="true">→</b>
        </a>

        <a href={buildSkills}>
          <span aria-hidden="true">⌁</span>
          <div>
            <small>BUILD MY SKILLS</small>
            <strong>Structured learning &amp; certification</strong>
          </div>
          <b aria-hidden="true">→</b>
        </a>

        <a href={peerComputers}>
          <span aria-hidden="true">◎</span>
          <div>
            <small>PEER GUIDANCE</small>
            <strong>Discussion &amp; practical guidance</strong>
          </div>
          <b aria-hidden="true">→</b>
        </a>
      </div>
    </section>

    <!-- ======================================================
         COMPARE
    ======================================================= -->
    <section class="hub-section" id="compare" aria-labelledby="compare-title">
      <div class="section-heading">
        <div>
          <p>Compare clearly</p>
          <h2 id="compare-title">Start with the decision — not the spec sheet</h2>
        </div>
        <span>Use practical household questions to narrow the field.</span>
      </div>

      <div class="compare-strip">
        <a href={searchHref("desktop vs laptop which should I buy")}>
          <small>FORM FACTOR</small>
          <strong>Desktop vs Laptop</strong>
          <span>Space, portability, performance and upgradeability.</span>
        </a>
        <a href={searchHref("Windows vs Mac computer comparison")}>
          <small>PLATFORM</small>
          <strong>Windows vs Mac</strong>
          <span>Software, ecosystem, familiarity and support.</span>
        </a>
        <a href={searchHref("SSD vs HDD storage difference")}>
          <small>STORAGE</small>
          <strong>SSD vs HDD</strong>
          <span>Speed, capacity, durability and value.</span>
        </a>
        <a href={searchHref("8GB vs 16GB RAM which is enough")}>
          <small>MEMORY</small>
          <strong>8GB vs 16GB+</strong>
          <span>How much memory ordinary workloads really need.</span>
        </a>
      </div>
    </section>

    <!-- ======================================================
         CHOOSE
    ======================================================= -->
    <section class="hub-section choose-section" id="choose" aria-labelledby="choose-title">
      <div class="section-heading">
        <div>
          <p>Choose with confidence</p>
          <h2 id="choose-title">What will this computer actually be used for?</h2>
        </div>
        <span>Start from the household need, then move to budget and specifications.</span>
      </div>

      <div class="use-case-grid">
        {useCases.map((item) => (
          <a href={searchHref(item.query)} class="use-case-card">
            <span class={`use-case-icon use-case-icon--${item.icon}`} aria-hidden="true"></span>
            <div>
              <strong>{item.title}</strong>
              <small>{item.note}</small>
            </div>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>

    <!-- ======================================================
         SELECTED BRANDS
    ======================================================= -->
    <section class="hub-section brand-section" aria-labelledby="brands-title">
      <div class="brand-intro">
        <p class="hub-kicker">SELECTED BRANDS</p>
        <h2 id="brands-title">Focused coverage for ordinary households</h2>
        <p>
          ONOCRA keeps its core computer coverage deliberately focused, while ONOCRA Routes
          can point visitors toward trustworthy resources beyond the brands we cover directly.
        </p>
      </div>

      <div class="brand-grid" aria-label="Selected computer and laptop brands">
        {brands.map((brand) => (
          <a href={searchHref(`${brand.name} computers laptops`)} class="brand-card">
            <img src={brand.image} alt={brand.name} loading="lazy" />
            <span>{brand.name}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ======================================================
         FINAL CTA
    ======================================================= -->
    <section class="hub-final-cta">
      <img src="/guides/pelican-guide.png" alt="" loading="lazy" />
      <div>
        <p>ONOCRA DIAGNOSTICS &amp; GUIDES</p>
        <h2>Still not sure what the problem is?</h2>
        <span>Start with Quick Help. You can change your route later.</span>
      </div>
      <a href={quickComputers}>
        Start Quick Help
        <b aria-hidden="true">→</b>
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .computer-hub {
    --hub-forest: #17382e;
    --hub-forest-soft: #315b4d;
    --hub-gold: #c79532;
    --hub-gold-deep: #b56e13;
    --hub-amber: #e66b00;
    --hub-cream: #fbfaf4;
    --hub-warm: #fff6e6;
    --hub-sage: #edf5eb;
    --hub-line: #dde5df;
    --hub-muted: #6e7773;
    --route-fix: #078fe3;
    --route-decode: #42a54d;
    --route-compare: #ef5b16;
    --route-choose: #7c22e8;

    width: 100%;
    max-width: none;
    padding: 0 1px 2.6rem;
    color: var(--foreground);
  }

  .hub-hero-shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 55fr) minmax(0, 45fr);
    gap: 0;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 82% 12%, rgba(230, 107, 0, .11), transparent 24rem),
      linear-gradient(135deg, #fffdf7 0%, #fbf7ec 58%, #fff 100%);
  }

  .hub-hero-copy {
    position: relative;
    z-index: 2;
    padding: clamp(1.35rem, 2.5vw, 2.65rem) clamp(1rem, 2.3vw, 2.4rem) 3rem;
  }

  .hub-breadcrumb {
    display: flex;
    align-items: center;
    gap: .45rem;
    margin-bottom: 1rem;
    color: #7a827e;
    font-size: .65rem;
    font-weight: 700;
  }

  .hub-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .hub-breadcrumb a:hover {
    color: var(--hub-gold-deep);
  }

  .hub-kicker,
  .section-heading > div > p,
  .brand-intro > p {
    margin: 0;
    color: var(--hub-gold);
    font-size: .69rem;
    font-weight: 900;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .hub-hero-copy h1 {
    max-width: 720px;
    margin: .45rem 0 0;
    color: var(--hub-forest);
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 4.15rem);
    line-height: .98;
    font-weight: 900;
    letter-spacing: -.045em;
  }

  .hub-hero-copy h1 span {
    color: var(--hub-amber);
  }

  .hub-lead {
    max-width: 64ch;
    margin: 1rem 0 0;
    color: #68726e;
    font-size: clamp(.82rem, 1vw, 1rem);
    line-height: 1.55;
  }

  .hub-country-row {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    margin-top: 1rem;
  }

  .hub-country-row > span {
    display: inline-flex;
    align-items: center;
    gap: .38rem;
    min-height: 2rem;
    padding: .28rem .62rem;
    border: 1px solid #e2e6df;
    border-radius: 999px;
    background: rgba(255,255,255,.86);
    color: #53605b;
    font-size: .63rem;
    font-weight: 800;
  }

  .hub-country-row img {
    width: 18px;
    height: 12px;
    object-fit: cover;
    border-radius: 2px;
  }

  .hub-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin-top: 1.15rem;
  }

  .hub-primary-button,
  .hub-secondary-button {
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    text-decoration: none;
    font-size: .72rem;
    font-weight: 900;
    transition: transform .16s ease, box-shadow .16s ease;
  }

  .hub-primary-button {
    background: linear-gradient(145deg, #c8872c, #e66b00);
    color: white;
    box-shadow: 0 8px 20px rgba(181,110,19,.18);
  }

  .hub-secondary-button {
    border: 1px solid #decba4;
    background: rgba(255,255,255,.88);
    color: #73501f;
  }

  .hub-primary-button:hover,
  .hub-secondary-button:hover {
    transform: translateY(-1px);
  }

  .hub-hero-visual {
    position: relative;
    min-width: 0;
    min-height: 430px;
    padding: 1.1rem 1.2rem 3rem .4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hub-hero-image-wrap {
    position: relative;
    display: grid;
    min-height: 330px;
    place-items: center;
    overflow: hidden;
    border: 1px solid #eadfc8;
    border-radius: 1.8rem;
    background:
      radial-gradient(circle at 50% 45%, rgba(255,255,255,.95), rgba(255,238,201,.75) 58%, rgba(255,229,174,.35));
    box-shadow: 0 16px 42px rgba(113,77,26,.10);
  }

  .hub-hero-image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 390px;
    object-fit: contain;
    transform: scale(1.1);
    filter: drop-shadow(0 16px 22px rgba(70,55,30,.16));
  }

  .hub-hero-pelican {
    position: absolute;
    right: 2rem;
    bottom: 1rem;
    width: min(340px, calc(100% - 3rem));
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: .6rem;
    align-items: center;
    padding: .55rem .68rem;
    border: 1px solid #dce4dc;
    border-radius: 1rem;
    background: rgba(255,255,255,.95);
    box-shadow: 0 8px 26px rgba(29,60,47,.10);
  }

  .hub-hero-pelican img {
    width: 58px;
    height: 58px;
    object-fit: contain;
  }

  .hub-hero-pelican strong {
    display: block;
    color: var(--hub-forest);
    font-family: ui-serif, Georgia, serif;
    font-size: .72rem;
  }

  .hub-hero-pelican span {
    display: block;
    margin-top: .12rem;
    color: #7a8580;
    font-size: .53rem;
    line-height: 1.28;
  }

  .hub-botanical {
    position: absolute;
    inset: auto 0 -5px 0;
    height: 64px;
    opacity: .32;
    pointer-events: none;
  }

  .hub-botanical svg {
    width: 100%;
    height: 100%;
  }

  .bot-stem {
    fill: none;
    stroke: #84ad8b;
    stroke-width: 2.3;
    stroke-linecap: round;
  }

  .bot-leaves {
    fill: #8fbd8e;
  }

  .bot-flowers {
    fill: #f3e7be;
    stroke: #d1b56b;
    stroke-width: 1;
  }

  .hub-section {
    padding: .8rem .8rem .9rem;
    border-bottom: 1px solid var(--border);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
    margin-bottom: .65rem;
  }

  .section-heading--compact {
    align-items: center;
  }

  .section-heading h2,
  .brand-intro h2,
  .learning-copy h2,
  .hub-final-cta h2 {
    margin: .16rem 0 0;
    color: var(--hub-forest);
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
    font-weight: 900;
    letter-spacing: -.028em;
  }

  .section-heading h2 {
    font-size: clamp(1.4rem, 2vw, 2rem);
    line-height: 1.02;
  }

  .section-heading > span {
    max-width: 38rem;
    color: #7b8581;
    font-size: .68rem;
    line-height: 1.35;
    text-align: right;
  }

  .hub-ask {
    background:
      radial-gradient(circle at 90% 20%, rgba(199,149,50,.08), transparent 18rem),
      #fff;
  }

  .hub-search-form {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    gap: .55rem;
    align-items: center;
    min-height: 48px;
    padding: .28rem .35rem .28rem .8rem;
    border: 1px solid #dccba8;
    border-radius: 1rem;
    background: white;
    box-shadow: 0 5px 18px rgba(70,55,30,.05);
  }

  .hub-search-form svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--hub-gold);
    stroke-width: 2;
  }

  .hub-search-form input {
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--foreground);
    font: inherit;
    font-size: .75rem;
    outline: none;
  }

  .hub-search-form button {
    min-height: 38px;
    padding: 0 .9rem;
    border: 0;
    border-radius: .8rem;
    background: #d3a64a;
    color: #173a2f;
    font-size: .69rem;
    font-weight: 900;
    cursor: pointer;
  }

  .hub-search-chips {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    margin-top: .48rem;
  }

  .hub-search-chips a {
    padding: .3rem .55rem;
    border: 1px solid #e4e7e1;
    border-radius: 999px;
    background: #fafbf8;
    color: #6b746f;
    font-size: .56rem;
    font-weight: 750;
    text-decoration: none;
  }

  .route-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .35rem;
  }

  .route-card {
    --route: var(--hub-gold);
    position: relative;
    min-width: 0;
    min-height: 168px;
    padding: .78rem;
    border: 1px solid color-mix(in srgb, var(--route) 24%, #e4e8e3);
    border-radius: 1.15rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--route) 7%, white), white 38%);
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    gap: .58rem;
    align-items: start;
    color: #52605a;
    text-decoration: none;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  .route-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(40,60,50,.08);
  }

  .route-card--fix { --route: var(--route-fix); }
  .route-card--decode { --route: var(--route-decode); }
  .route-card--compare { --route: var(--route-compare); }
  .route-card--choose { --route: var(--route-choose); }

  .route-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 12px;
    background: color-mix(in srgb, var(--route) 13%, white);
    font-size: 1rem;
  }

  .route-card small {
    color: var(--route);
    font-size: .55rem;
    font-weight: 900;
    letter-spacing: .12em;
  }

  .route-card h3 {
    margin: .15rem 0 0;
    color: var(--route);
    font-family: ui-serif, Georgia, serif;
    font-size: .98rem;
    font-weight: 900;
    line-height: 1.05;
  }

  .route-card p {
    margin: .35rem 0 0;
    color: #79837e;
    font-size: .58rem;
    line-height: 1.42;
  }

  .route-card > b {
    color: var(--route);
    font-size: .9rem;
  }

  .hub-ad {
    margin: .35rem .8rem;
    min-height: 68px;
    border: 1px dashed #d7ddd7;
    border-radius: 1rem;
    background: var(--onocra-cream, #faf8f1);
    display: grid;
    place-items: center;
  }

  .hub-ad span {
    color: #929a96;
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .device-route-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .45rem;
  }

  .device-route-card {
    display: grid;
    grid-template-columns: 36% minmax(0, 1fr);
    min-height: 210px;
    overflow: hidden;
    border: 1px solid var(--hub-line);
    border-radius: 1.25rem;
    background: white;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(29,60,47,.05);
    transition: transform .18s ease;
  }

  .device-route-card:hover {
    transform: translateY(-2px);
  }

  .device-route-visual {
    display: grid;
    place-items: center;
    min-height: 210px;
  }

  .device-route-visual--desktop {
    background: linear-gradient(145deg, #fff3d7, #f6dfaa);
    color: #b56e13;
  }

  .device-route-visual--laptop {
    background: linear-gradient(145deg, #eef5ea, #d8e8d2);
    color: #39735b;
  }

  .device-route-visual svg {
    width: 64%;
    max-width: 140px;
    fill: none;
    stroke: currentColor;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .device-route-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: .9rem 1rem;
  }

  .device-route-copy > small {
    color: var(--hub-gold);
    font-size: .55rem;
    font-weight: 900;
    letter-spacing: .12em;
  }

  .device-route-copy h3 {
    margin: .15rem 0 0;
    color: var(--hub-forest);
    font-family: ui-serif, Georgia, serif;
    font-size: 1.25rem;
    font-weight: 900;
  }

  .device-route-copy p {
    margin: .35rem 0 0;
    color: #78827e;
    font-size: .62rem;
    line-height: 1.42;
  }

  .device-route-copy span {
    margin-top: .6rem;
    color: var(--hub-amber);
    font-size: .62rem;
    font-weight: 900;
  }

  .category-section {
    background: linear-gradient(180deg, #fbfcf8, #fff);
  }

  .category-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .45rem;
  }

  .category-family {
    overflow: hidden;
    border: 1px solid var(--hub-line);
    border-radius: 1.15rem;
    background: white;
  }

  .category-family > header {
    display: flex;
    gap: .55rem;
    align-items: center;
    padding: .65rem .7rem;
    border-bottom: 1px solid var(--hub-line);
    background: linear-gradient(90deg, #fff9ed, #fff);
  }

  .family-icon {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    place-items: center;
    border-radius: 13px;
  }

  .family-icon--desktop {
    background: #ffebc2;
    color: #d56f05;
  }

  .family-icon--laptop {
    background: #e5f0df;
    color: #3f7d5d;
  }

  .family-icon svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .category-family header small {
    color: var(--hub-gold);
    font-size: .5rem;
    font-weight: 900;
    letter-spacing: .12em;
  }

  .category-family header h3 {
    margin: .08rem 0 0;
    color: var(--hub-forest);
    font-family: ui-serif, Georgia, serif;
    font-size: .9rem;
    font-weight: 900;
  }

  .category-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .category-card {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    gap: .4rem;
    align-items: center;
    min-height: 84px;
    padding: .55rem;
    border-right: 1px solid #edf0ed;
    border-bottom: 1px solid #edf0ed;
    color: inherit;
    text-decoration: none;
    transition: background-color .16s ease;
  }

  .category-card:nth-child(2n) {
    border-right: 0;
  }

  .category-card:hover {
    background: #fffcf4;
  }

  .category-symbol {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 9px;
    background: #fff2d5;
    color: #bd7316;
  }

  .category-symbol::before {
    content: "●";
    font-size: .65rem;
  }

  .category-symbol--mac::before { content: "⌘"; font-size: .85rem; }
  .category-symbol--windows::before { content: "⊞"; font-size: .85rem; }
  .category-symbol--gaming::before { content: "◆"; }
  .category-symbol--software::before { content: "▦"; font-size: .8rem; }
  .category-symbol--laptop::before { content: "▱"; font-size: .9rem; }
  .category-symbol--chrome::before { content: "◉"; font-size: .8rem; }
  .category-symbol--convertible::before { content: "↻"; font-size: .8rem; }
  .category-symbol--mini::before { content: "▪"; }
  .category-symbol--allinone::before { content: "▣"; font-size: .8rem; }

  .category-card strong {
    display: block;
    color: #40544d;
    font-family: ui-serif, Georgia, serif;
    font-size: .68rem;
    line-height: 1.15;
  }

  .category-card small {
    display: block;
    margin-top: .12rem;
    color: #87918d;
    font-size: .49rem;
    line-height: 1.28;
  }

  .category-card > b {
    color: var(--hub-gold);
  }

  .learning-section {
    display: grid;
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.22fr);
    gap: .7rem;
    align-items: stretch;
    background:
      radial-gradient(circle at 10% 10%, rgba(122,178,128,.10), transparent 18rem),
      #f9fbf7;
  }

  .learning-copy {
    padding: .9rem;
    border: 1px solid #dfe8df;
    border-radius: 1.15rem;
    background: white;
  }

  .learning-copy h2 {
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1.03;
  }

  .learning-copy > p:last-child {
    margin: .55rem 0 0;
    color: #77827d;
    font-size: .67rem;
    line-height: 1.45;
  }

  .learning-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .35rem;
  }

  .learning-links a {
    display: grid;
    grid-template-columns: 38px minmax(0,1fr) auto;
    gap: .5rem;
    align-items: center;
    padding: .7rem;
    border: 1px solid #dfe8df;
    border-radius: 1rem;
    background: white;
    color: inherit;
    text-decoration: none;
  }

  .learning-links a > span {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 12px;
    background: #eef5eb;
    color: #3f755d;
    font-size: .9rem;
  }

  .learning-links small {
    color: var(--hub-gold);
    font-size: .5rem;
    font-weight: 900;
    letter-spacing: .08em;
  }

  .learning-links strong {
    display: block;
    margin-top: .08rem;
    color: #40534c;
    font-family: ui-serif, Georgia, serif;
    font-size: .68rem;
  }

  .learning-links b {
    color: var(--hub-gold);
  }

  .compare-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .35rem;
  }

  .compare-strip a {
    min-height: 132px;
    padding: .72rem;
    border: 1px solid #e4e8e3;
    border-radius: 1rem;
    background: linear-gradient(180deg, #fffaf0, #fff);
    color: inherit;
    text-decoration: none;
  }

  .compare-strip small {
    color: var(--route-compare);
    font-size: .5rem;
    font-weight: 900;
    letter-spacing: .1em;
  }

  .compare-strip strong {
    display: block;
    margin-top: .16rem;
    color: #5f4b35;
    font-family: ui-serif, Georgia, serif;
    font-size: .83rem;
  }

  .compare-strip span {
    display: block;
    margin-top: .3rem;
    color: #818985;
    font-size: .52rem;
    line-height: 1.38;
  }

  .choose-section {
    background: linear-gradient(180deg, #fbfcf8, #fff);
  }

  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .35rem;
  }

  .use-case-card {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) auto;
    gap: .5rem;
    align-items: center;
    min-height: 90px;
    padding: .65rem;
    border: 1px solid #e3e6e1;
    border-radius: 1rem;
    background: white;
    color: inherit;
    text-decoration: none;
  }

  .use-case-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 12px;
    background: #f1eaff;
    color: #7747c8;
  }

  .use-case-icon::before {
    content: "◆";
    font-size: .75rem;
  }

  .use-case-icon--home::before { content: "⌂"; font-size: 1rem; }
  .use-case-icon--study::before { content: "▤"; }
  .use-case-icon--work::before { content: "▣"; }
  .use-case-icon--creative::before { content: "✦"; }
  .use-case-icon--gaming::before { content: "◆"; }
  .use-case-icon--travel::before { content: "↗"; }

  .use-case-card strong {
    display: block;
    color: #4c405c;
    font-family: ui-serif, Georgia, serif;
    font-size: .7rem;
  }

  .use-case-card small {
    display: block;
    margin-top: .12rem;
    color: #88908d;
    font-size: .49rem;
    line-height: 1.3;
  }

  .use-case-card > b {
    color: var(--route-choose);
  }

  .brand-section {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: .8rem;
    align-items: center;
    background:
      radial-gradient(circle at 90% 20%, rgba(199,149,50,.07), transparent 18rem),
      #fff;
  }

  .brand-intro {
    padding: .4rem .2rem;
  }

  .brand-intro h2 {
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
  }

  .brand-intro > p:last-child {
    margin: .45rem 0 0;
    color: #7b8580;
    font-size: .63rem;
    line-height: 1.45;
  }

  .brand-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .32rem;
  }

  .brand-card {
    min-height: 76px;
    padding: .5rem;
    border: 1px solid #e3e6e1;
    border-radius: .9rem;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    color: #59645f;
    text-decoration: none;
    font-size: .58rem;
    font-weight: 800;
  }

  .brand-card img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .hub-final-cta {
    margin: .65rem .8rem 0;
    padding: .75rem .9rem;
    border: 1px solid #d6e2d8;
    border-radius: 1.1rem;
    background:
      linear-gradient(120deg, #eef7ee, #fff9ec);
    display: grid;
    grid-template-columns: 68px minmax(0, 1fr) auto;
    gap: .7rem;
    align-items: center;
  }

  .hub-final-cta img {
    width: 68px;
    height: 68px;
    object-fit: contain;
  }

  .hub-final-cta p {
    margin: 0;
    color: var(--hub-gold);
    font-size: .52rem;
    font-weight: 900;
    letter-spacing: .11em;
  }

  .hub-final-cta h2 {
    margin-top: .08rem;
    font-size: 1rem;
  }

  .hub-final-cta span {
    display: block;
    margin-top: .12rem;
    color: #78837e;
    font-size: .56rem;
  }

  .hub-final-cta > a {
    min-height: 40px;
    padding: 0 .8rem;
    border-radius: 999px;
    background: var(--hub-forest);
    color: white;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    text-decoration: none;
    font-size: .62rem;
    font-weight: 900;
  }

  :global(html[data-theme="dark"]) .computer-hub {
    --hub-forest: #edf7f1;
    --hub-muted: #b4bfba;
    --hub-line: rgba(255,255,255,.11);
  }

  :global(html[data-theme="dark"]) .hub-hero-shell {
    background:
      radial-gradient(circle at 82% 12%, rgba(230,107,0,.10), transparent 23rem),
      linear-gradient(135deg, #17231f, #211f18);
  }

  :global(html[data-theme="dark"]) .hub-hero-image-wrap,
  :global(html[data-theme="dark"]) .hub-hero-pelican,
  :global(html[data-theme="dark"]) .hub-search-form,
  :global(html[data-theme="dark"]) .device-route-card,
  :global(html[data-theme="dark"]) .category-family,
  :global(html[data-theme="dark"]) .learning-copy,
  :global(html[data-theme="dark"]) .learning-links a,
  :global(html[data-theme="dark"]) .compare-strip a,
  :global(html[data-theme="dark"]) .use-case-card,
  :global(html[data-theme="dark"]) .brand-card {
    background: #18241f;
    border-color: rgba(255,255,255,.10);
  }

  :global(html[data-theme="dark"]) .hub-lead,
  :global(html[data-theme="dark"]) .section-heading > span,
  :global(html[data-theme="dark"]) .route-card p,
  :global(html[data-theme="dark"]) .device-route-copy p,
