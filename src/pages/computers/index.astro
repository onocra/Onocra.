---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const searchPath = getRelativeLocaleUrl(locale, "search");

/**
 * Shared ONOCRA Diagnostics & Guides platform.
 * Computers hub is only an entry point.
 * Visitors begin at Step 1, then choose Computers or Laptops at Step 2.
 */
const dgPlatformPath = getRelativeLocaleUrl(locale, "guides");

const searchHref = (q: string) => `${searchPath}?q=${encodeURIComponent(q)}`;

const quickHelp = [
  { category: "computers", question: "Why is my Windows PC suddenly very slow?", answer: "Restart first, check free storage, Task Manager activity, pending Windows updates and recently installed software. Back up important files before making major changes or resetting Windows." },
  { category: "computers", question: "My computer keeps freezing or crashing. What should I check?", answer: "Note when the crash occurs, install official operating-system and driver updates, check storage space and disconnect recently added peripherals. Repeated blue screens or hardware errors may need qualified service." },
  { category: "computers", question: "My desktop has no internet connection", answer: "Check whether other devices can connect, inspect Ethernet or Wi-Fi status, restart the computer and router, and verify the correct network. Avoid changing advanced network settings until the basic checks are complete." },
  { category: "computers", question: "My printer is connected but will not print", answer: "Check power, paper, cable or Wi-Fi connection, the selected printer and the print queue. Restart the printer and computer, then use the printer maker’s current driver or support tool." },
  { category: "computers", question: "Should I upgrade RAM, storage or replace the computer?", answer: "Start with the actual bottleneck. More RAM helps heavy multitasking, an SSD can transform an older HDD-based PC, while a very old unsupported system may be better replaced than upgraded." },
  { category: "computers", question: "My PC will not turn on", answer: "Check the wall socket, power cable, power strip and any visible power indicators. Disconnect non-essential peripherals. If there is a burning smell, liquid damage or electrical damage, stop and seek qualified service." },
  { category: "computers", question: "How do I free storage without deleting something important?", answer: "Review Downloads, large videos, old installers and temporary files first. Back up personal files before deleting them, and avoid unfamiliar registry or 'cleaner' utilities." },
  { category: "computers", question: "Windows update is stuck or failed", answer: "Restart, confirm stable internet and enough free disk space, then retry through Windows Update. Record the error code before using repair options so you can search Microsoft’s current guidance." },
  { category: "computers", question: "How do I back up my computer properly?", answer: "Keep important files in at least two places, such as the computer plus an external drive or trusted cloud service. Verify that important folders are actually included and test that files can be opened." },

  { category: "laptops", question: "Why is my laptop battery draining so quickly?", answer: "Check battery usage, screen brightness, background apps and recent updates. Compare performance on battery versus plugged in. If the battery is swollen, stop using the laptop and seek qualified service." },
  { category: "laptops", question: "My laptop gets very hot and the fan is loud", answer: "Use it on a hard surface, clear external vents carefully, reduce heavy background work and check for updates. Persistent overheating, shutdowns or unusual smells deserve service." },
  { category: "laptops", question: "My laptop will not charge", answer: "Try a known-good compatible adapter and outlet, inspect the cable and charging port visually, and check for charging indicators. Do not force damaged connectors or use an unsafe third-party charger." },
  { category: "laptops", question: "My laptop will not connect to Wi-Fi", answer: "Confirm Wi-Fi is on and airplane mode is off, reconnect to the correct network, restart the laptop and router, and test another device before changing network settings." },
  { category: "laptops", question: "My keyboard or touchpad stopped working", answer: "Restart, test whether an external mouse or keyboard works, check accessibility and function-key settings, and install official device updates. Liquid damage requires professional inspection." },
  { category: "laptops", question: "Should I repair my laptop or replace it?", answer: "Compare the repair quote with the laptop’s age, battery condition, security-update support, performance and replacement cost. A recent, supported laptop may still be worth repairing." },
];

const deviceServiceGroups = [
  {
    title: "Fix",
    summary: "Solve a device problem",
    links: [
      { title: "Quick Help · Start D&G Platform", href: dgPlatformPath },
      { title: "Diagnostics · Step by Step", href: dgPlatformPath },
      { title: "Family & Digital Safety", href: "#family-computing" },
    ],
  },
  {
    title: "Decode",
    summary: "Understand your device",
    links: [
      { title: "Guides · Start D&G Platform", href: dgPlatformPath },
      { title: "Latest from ONOCRA", href: "#latest-computers" },
      { title: "Read & Learn · Start D&G Platform", href: dgPlatformPath },
    ],
  },
  {
    title: "Compare",
    summary: "Explore reviews and evidence",
    links: [
      { title: "Reviews & Comparisons", href: "#reviews" },
      { title: "Our Evaluation Approach", href: "#evaluation" },
    ],
  },
  {
    title: "Choose",
    summary: "Find devices and buying platforms",
    links: [
      { title: "Choose with Confidence", href: "#choose" },
      { title: "Stores & Buying Platforms", href: "#choose-stores" },
    ],
  },
];

const brands = [
  { name: "Apple", image: "/computers/apple.png" },
  { name: "Dell", image: "/computers/dell.png" },
  { name: "HP", image: "/computers/hp.png" },
  { name: "Lenovo", image: "/computers/lenovo.png" },
  { name: "ASUS", image: "/computers/asus.png" },
  { name: "Acer", image: "/computers/acer.png" },
];

const chooseRetailerRegions = [
  {
    code: "US",
    name: "United States",
    flagImage: "/internet/flag-us.png",
    stores: [
      { name: "Amazon", logo: "/phones/retailers/amazon.svg", url: "https://www.amazon.com/" },
      { name: "Best Buy", logo: "/phones/retailers/best-buy.svg", url: "https://www.bestbuy.com/" },
      { name: "Walmart", logo: "/phones/retailers/walmart.svg", url: "https://www.walmart.com/" },
      { name: "B&H Photo", logo: "/phones/retailers/b-and-h.svg", url: "https://www.bhphotovideo.com/" },
    ],
  },
  {
    code: "UK",
    name: "United Kingdom",
    flagImage: "/internet/flag-uk.png",
    stores: [
      { name: "Amazon UK", logo: "/phones/retailers/amazon.svg", url: "https://www.amazon.co.uk/" },
      { name: "Currys", logo: "/phones/retailers/currys.svg", url: "https://www.currys.co.uk/" },
      { name: "Argos", logo: "/phones/retailers/argos.svg", url: "https://www.argos.co.uk/" },
      { name: "John Lewis", logo: "/phones/retailers/john-lewis.svg", url: "https://www.johnlewis.com/" },
    ],
  },
  {
    code: "DE",
    name: "Germany",
    flagImage: "/internet/flag-germany.png",
    stores: [
      { name: "Amazon DE", logo: "/phones/retailers/amazon.svg", url: "https://www.amazon.de/" },
      { name: "MediaMarkt", logo: "/phones/retailers/mediamarkt.svg", url: "https://www.mediamarkt.de/" },
      { name: "Saturn", logo: "/phones/retailers/saturn.svg", url: "https://www.saturn.de/" },
      { name: "notebooksbilliger", logo: "/phones/retailers/notebooksbilliger.svg", url: "https://www.notebooksbilliger.de/" },
    ],
  },
];

const latestTopics = [
  { label: "Windows", title: "When is a slow PC worth upgrading instead of replacing?", description: "Start with storage, memory, support status and the actual bottleneck before buying a new machine." },
  { label: "Laptops", title: "How much RAM does an ordinary household really need?", description: "Match memory to browsing, office work, study, creative tools and heavier multitasking." },
  { label: "Mac", title: "Mac or Windows for home and family use?", description: "Compare software needs, familiarity, ecosystem, repair options, price and support." },
  { label: "Buying", title: "Laptop specifications that matter more than marketing labels", description: "Processor class, usable memory, storage, display, battery, support and total price matter more than badges." },
];

const familyTopics = [
  { title: "Set up a family or child account on a computer", description: "Use the operating system’s family-account tools where available, review permissions and avoid giving a child an unrestricted administrator account." },
  { title: "Prepare a school laptop safely", description: "Install required school software, use a strong account password, enable updates and backups, and review webcam, microphone and browser permissions." },
  { title: "Manage games and downloads on a shared PC", description: "Use separate accounts, review age ratings, set purchase controls and keep the operating system and security protections current." },
  { title: "Protect family files on a shared computer", description: "Keep separate user accounts, use backups and teach household members not to save passwords or sensitive documents in shared public folders." },
  { title: "Check webcam and microphone privacy", description: "Review which apps can access the camera and microphone, close unused apps and use physical privacy controls where provided." },
];

const guideTopics = [
  { title: "Speed up a slow Windows PC safely", description: "Check startup apps, free space, updates and demanding processes before changing advanced settings or installing third-party cleaners." },
  { title: "Move files to a new computer", description: "Back up first, use a trusted drive or cloud account, verify the transferred files and keep the old copy until everything is confirmed." },
  { title: "Fix common Wi-Fi problems on a laptop", description: "Test another device, reconnect to the correct network, restart the laptop and router, then use the maker’s current network guidance." },
  { title: "Connect a printer or peripheral", description: "Confirm compatibility, use the correct cable or wireless setup, then install current software from the manufacturer." },
  { title: "Create a reliable backup routine", description: "Keep important files in more than one place and verify that the backup can actually restore what you need." },
];

const routeGroups = [
  {
    title: "More Computer Brands",
    description: "Official manufacturer resources",
    brands: [
      { name: "Microsoft Surface", url: "https://www.microsoft.com/surface", note: "Surface computers, laptops and support" },
      { name: "MSI", url: "https://www.msi.com/", note: "Gaming, creator and business computers" },
      { name: "Razer", url: "https://www.razer.com/", note: "Gaming laptops and systems" },
      { name: "Framework", url: "https://frame.work/", note: "Repairable and modular laptops" },
    ],
  },
  {
    title: "Operating Systems & Support",
    description: "Official platform help",
    brands: [
      { name: "Microsoft Windows", url: "https://support.microsoft.com/windows", note: "Windows help and support" },
      { name: "Apple macOS", url: "https://support.apple.com/mac", note: "Mac help and support" },
      { name: "Google Chromebook", url: "https://support.google.com/chromebook/", note: "ChromeOS and Chromebook support" },
    ],
  },
];
---

<Layout
  title="Computers & Laptops | ONOCRA"
  description="Practical help, diagnostics, comparisons and buying guidance for computers and laptops used by ordinary households in the US, UK and Germany."
>
  <Header />

  <main id="main-content" class="computer-hub computer-phones-parity">
    <!-- =========================================================
         HERO — follows Phones hub composition
    ========================================================== -->
    <section class="computer-hero" aria-labelledby="computer-hero-title">
      <div class="hero-copy">
        <p class="eyebrow">ONOCRA DEVICE HUB</p>
        <h1 id="computer-hero-title">Computers &amp; Laptops</h1>

        <p class="brand-scope">
          <span>We focus on 6 trusted brands in</span>
          <span class="hero-market-flags" aria-label="United States, United Kingdom and Germany">
            <span class="hero-flag-item"><img src="/internet/flag-us.png" alt="United States flag" /><strong>US</strong></span>
            <span class="hero-flag-item"><img src="/internet/flag-uk.png" alt="United Kingdom flag" /><strong>UK</strong></span>
            <span class="hero-flag-item"><img src="/internet/flag-germany.png" alt="Germany flag" /><strong>Germany</strong></span>
          </span>
        </p>

        <p class="regional-focus">Regional help, comparisons &amp; buying advice.</p>

        <div class="brand-row" aria-label="Six computer brands covered by ONOCRA">
          {brands.map((brand) => (
            <span class="brand-logo-chip">
              <img src={brand.image} alt="" loading="eager" />
              <span>{brand.name}</span>
            </span>
          ))}
        </div>

        <div class="hero-marketing-row">
          <div>
            <span class="hero-feature-tag">FIX · UNDERSTAND · COMPARE · CHOOSE</span>
            <p class="hero-message">Clear computer guidance for the devices your household uses for home, study, work and entertainment.</p>
            <p class="hero-note">Start with the problem or decision — then move to the technical detail only when it helps.</p>
          </div>

          <a class="hero-guide-card" href={dgPlatformPath}>
            <img src="/guides/pelican-guide.png" alt="" />
            <span><strong>Need practical help?</strong><small>Open the shared ONOCRA Diagnostics &amp; Guides Platform</small></span>
            <b aria-hidden="true">→</b>
          </a>
        </div>

        <div class="hero-tagline">
          <p class="hero-tagline-kicker">Guided by ONOCRA</p>
          <p class="hero-tagline-main">Fix clearly. Compare sensibly. Choose with confidence.</p>
          <p class="hero-tagline-sub">Everyday household computing without unnecessary technical jargon.</p>
        </div>
      </div>

      <div class="hero-art">
        <img src="/computers/computerlaptophero.png" alt="Desktop computer and laptop presented in ONOCRA botanical styling" loading="eager" decoding="async" />
      </div>
    </section>

    <!-- =========================================================
         ASK ONOCRA
    ========================================================== -->
    <section class="ask-section" aria-labelledby="ask-heading">
      <div class="ask-heading">
        <p class="eyebrow">START HERE</p>
        <h2 id="ask-heading">How can ONOCRA help you today?</h2>
        <p>Describe the problem, product or question. We’ll help you find the clearest route.</p>
      </div>

      <div class="ask-tools-row">
        <form class="ask-box" action={searchPath} method="get" role="search">
          <div class="search-field">
            <span class="search-symbol" aria-hidden="true">⌕</span>
            <input name="q" type="search" placeholder="Ask about your computer or laptop..." aria-label="Ask ONOCRA" />
            <button class="search-button" type="submit">Search</button>
          </div>
        </form>

        <div class="try-row" aria-label="Try these searches">
          <span>Try:</span>
          {["Windows PC slow", "Laptop battery draining", "Computer not connecting to Wi-Fi", "Printer not working", "Mac or Windows?"].map((term) => (
            <a class="try-chip" href={searchHref(term)}>{term}</a>
          ))}
        </div>
      </div>

      <details class="video-browser">
        <summary><span aria-hidden="true">▶</span> Browse video solutions <small>Find a short tutorial for your question</small></summary>
        <div class="video-browser-body">
          <p>Browse common computer and laptop video topics. ONOCRA videos can replace external searches as the video library grows.</p>
          <div class="video-topic-row">
            {["Speed up Windows PC", "Laptop battery problem", "Connect printer to computer", "Move files to new computer", "Fix laptop Wi-Fi"].map((topic) => (
              <a href={`https://www.youtube.com/results?search_query=${encodeURIComponent(topic + " official tutorial")}`} target="_blank" rel="noopener noreferrer">▶ {topic} ↗</a>
            ))}
          </div>
          <p class="video-help-note">Need guided help? <a href={dgPlatformPath}>Start ONOCRA Interactive Diagnostics &amp; Guidance →</a></p>
        </div>
      </details>
    </section>

    <section class="mid-ad" aria-label="Advertisement"><span>ADVERTISEMENT</span></section>

    <!-- =========================================================
         TWO DEVICE CARDS — mirrors Phones / Tablets
    ========================================================== -->
    <section class="device-section" aria-labelledby="device-heading">
      <div class="device-heading">
        <p class="eyebrow">EXPLORE YOUR DEVICES</p>
        <h2 id="device-heading">Find help for your device</h2>
        <p>Choose Computers or Laptops, then explore the same ONOCRA services available across our device hubs.</p>
      </div>

      <div class="device-grid">
        <article class="device-card">
          <div class="device-image device-image--desktop">
            <img
              src="/computers/computers-findtechnology.png"
              alt="Explore computer technologies including desktop, mini and performance systems"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="device-copy">
            <h3>Computers</h3>
            <p class="device-description">Windows PCs, Macs, all-in-ones, mini PCs and gaming desktops</p>
            <ul class="device-questions">
              <li>Are you facing a problem with your computer?</li>
              <li>Do you want to understand desktop hardware or software?</li>
              <li>Would you like to compare different computer types?</li>
              <li>Are you deciding whether to upgrade, repair or buy?</li>
            </ul>

            <details class="device-dropdown">
              <summary><span class="service-label"><strong>EXPLORE</strong><small>Our Complimentary Services</small></span><span class="service-chevron" aria-hidden="true"></span></summary>
              <div class="device-menu">
                {deviceServiceGroups.map((group) => (
                  <details class="device-service-group">
                    <summary><span><strong>{group.title}</strong><small>{group.summary}</small></span><span class="service-plus">+</span></summary>
                    <nav>
                      {group.links.map((link) => <a href={link.href}>{link.title} <span>↗</span></a>)}
                      {group.title === "Fix" && <a href={dgPlatformPath}>Computer Quick Help · D&G Platform <span>↗</span></a>}
                    </nav>
                  </details>
                ))}
              </div>
            </details>
          </div>
        </article>

        <article class="device-card">
          <div class="device-image device-image--laptop">
            <img
              src="/computers/laptops-findtechnology.png"
              alt="Explore Windows laptops, MacBooks, Chromebooks, gaming laptops and convertible computers"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="device-copy">
            <h3>Laptops</h3>
            <p class="device-description">Windows laptops, MacBooks, Chromebooks, gaming laptops and 2-in-1s</p>
            <ul class="device-questions">
              <li>Is your laptop slow, hot, not charging or not connecting?</li>
              <li>Do you need help understanding laptop specifications?</li>
              <li>Would you like to compare laptop types or platforms?</li>
              <li>Are you choosing a laptop for home, study, work or gaming?</li>
            </ul>

            <details class="device-dropdown">
              <summary><span class="service-label"><strong>EXPLORE</strong><small>Our Complimentary Services</small></span><span class="service-chevron" aria-hidden="true"></span></summary>
              <div class="device-menu">
                {deviceServiceGroups.map((group) => (
                  <details class="device-service-group">
                    <summary><span><strong>{group.title}</strong><small>{group.summary}</small></span><span class="service-plus">+</span></summary>
                    <nav>
                      {group.links.map((link) => <a href={link.href}>{link.title} <span>↗</span></a>)}
                      {group.title === "Fix" && <a href={dgPlatformPath}>Laptop Quick Help · D&G Platform <span>↗</span></a>}
                    </nav>
                  </details>
                ))}
              </div>
            </details>
          </div>
        </article>
      </div>
    </section>

    <!-- =========================================================
         QUICK HELP
    ========================================================== -->
    <section class="popular-section" id="fix" aria-labelledby="quick-heading" data-quick-help={JSON.stringify(quickHelp)}>
      <div class="popular-header">
        <div>
          <p class="eyebrow">QUICK HELP · PRACTICAL ANSWERS</p>
          <h2 id="quick-heading">What can we help you with?</h2>
          <p>Everyday answers for household computers. Choose a category, then open a question.</p>
        </div>
        <div class="quick-header-aside">
          <span class="quick-fix-signature">FIX</span>
          <span class="quick-count">15 helpful topics</span>
        </div>
      </div>

      <div class="quick-layout">
        <nav class="quick-categories" aria-label="Quick Help categories">
          <button type="button" class="quick-tab is-active" data-category="computers" aria-pressed="true"><span>Computers</span><small>9 questions</small></button>
          <button type="button" class="quick-tab" data-category="laptops" aria-pressed="false"><span>Laptops</span><small>6 questions</small></button>
        </nav>

        <div class="quick-content">
          <div class="quick-topline"><h3 id="quick-category-heading">Computer questions</h3><span id="quick-results-count">9 questions</span></div>
          <div id="quick-questions">
            {(["computers", "laptops"] as const).map((category) => (
              <div class="quick-question-group" data-question-group={category} hidden={category !== "computers"}>
                {quickHelp.filter((item) => item.category === category).map((item) => (
                  <details class="quick-question">
                    <summary><span>{item.question}</span><span class="quick-plus">+</span></summary>
                    <div class="quick-answer"><p>{item.answer}</p><a href={searchHref(item.question)}>Explore this topic →</a></div>
                  </details>
                ))}
              </div>
            ))}
          </div>
          <p class="quick-note">Short guidance to get started. For model-specific instructions, check the manufacturer’s current support guidance before changing advanced settings.</p>
        </div>
      </div>
    </section>

    <!-- =========================================================
         GUIDES + FAMILY COMPUTING | LATEST
    ========================================================== -->
    <section class="editorial-section" id="decode" aria-label="Guides, family computing and latest ONOCRA topics">
      <div class="editorial-left-stack">
        <section class="guides-panel" aria-labelledby="guides-heading">
          <div class="guides-content-grid">
            <div class="guides-copy-column">
              <p class="eyebrow">FIX &amp; DECODE · STEP BY STEP</p>
              <h2 id="guides-heading">Diagnostics &amp; Guides</h2>
              <div class="guides-heading">
                <p>Open a practical guide, then use a video demonstration when seeing the steps is useful.</p>
                <a class="guides-view-all" href={dgPlatformPath}>Open ONOCRA Diagnostics &amp; Guides Platform →</a>
              </div>

              <div class="guide-questions">
                {guideTopics.map((guide) => (
                  <details class="guide-item">
                    <summary><span>{guide.title}</span><span>+</span></summary>
                    <div class="guide-detail">
                      <p>{guide.description}</p>
                      <div class="guide-actions">
                        <a href={dgPlatformPath}>Start Diagnostics &amp; Guides →</a>
                        <a href={searchHref(guide.title)}>Search related help →</a>
                        <a href={`https://www.youtube.com/results?search_query=${encodeURIComponent(guide.title + " official tutorial")}`} target="_blank" rel="noopener noreferrer">Find a video tutorial ↗</a>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </div>

            <div class="guides-art-column">
              <img
                  src="/computers/computers-D&G.png"
                  alt="ONOCRA pelican guiding computer and laptop diagnostics and step-by-step help"
                  loading="lazy"
                  decoding="async"
                />
            </div>
          </div>
        </section>

        <section class="family-panel" id="family-computing" aria-labelledby="family-heading">
          <div class="family-top">
            <div>
              <p class="eyebrow">DIGITAL PARENTING · FAMILY FIRST</p>
              <h2 id="family-heading">Safer family computing</h2>
              <p>Practical steps for shared PCs, school laptops, accounts, downloads, webcams and household privacy.</p>
            </div>
            <img
              src="/computers/computers-digitalparenting.png"
              alt="Digital parenting and safer family computing with computers and laptops"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="family-topics">
            {familyTopics.map((topic) => (
              <details class="guide-item">
                <summary><span>{topic.title}</span><span>+</span></summary>
                <div class="guide-detail"><p>{topic.description}</p><a href={searchHref(topic.title)}>Explore guidance →</a></div>
              </details>
            ))}
          </div>

          <div class="family-partner">
            <img src="/seed%20and%20sapling.png" alt="Seed & Sapling" loading="lazy" />
            <span>In collaboration with <strong>Seed &amp; Sapling</strong></span>
          </div>
        </section>
      </div>

      <aside class="editorial-latest" id="latest-computers" aria-labelledby="latest-heading">
        <p class="eyebrow">READ · LEARN · DISCOVER</p>
        <h2 id="latest-heading">Latest from ONOCRA</h2>
        <p class="latest-intro">Independent perspective on computers, laptops and smarter household decisions.</p>

        <article class="featured-article">
          <div class="featured-visual"><img src="/homepage/computers.png" alt="Computers and laptops" loading="lazy" /></div>
          <div class="featured-copy">
            <span>FEATURED · BUY SMARTER</span>
            <h3>Do you really need a new computer — or just the right upgrade?</h3>
            <p>Start with support status, storage, memory, battery condition and the work you actually do before replacing a usable machine.</p>
            <a href={searchHref("upgrade computer or buy new computer")}>Explore this topic →</a>
          </div>
        </article>

        <div class="latest-topic-list">
          {latestTopics.map((topic) => (
            <details class="latest-topic">
              <summary><span><small>{topic.label}</small>{topic.title}</span><span>⌄</span></summary>
              <div><p>{topic.description}</p><a href={searchHref(topic.title)}>Explore topic →</a></div>
            </details>
          ))}
        </div>
      </aside>
    </section>

    <section class="mid-ad" aria-label="Advertisement"><span>ADVERTISEMENT</span></section>

    <!-- =========================================================
         REVIEWS & COMPARISONS — matches Phones position
    ========================================================== -->
    <section class="reviews-section" id="reviews" aria-labelledby="reviews-heading">
      <header class="reviews-heading">
        <p class="eyebrow">COMPARE WITH CONFIDENCE</p>
        <h2 id="reviews-heading">Reviews &amp; Comparisons</h2>
