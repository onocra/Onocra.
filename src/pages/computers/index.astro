<script>
  const root = document.querySelector<HTMLElement>("[data-quick-help]");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-category]"));
    const groups = Array.from(root.querySelectorAll<HTMLElement>("[data-question-group]"));
    const heading = root.querySelector<HTMLElement>("#quick-category-heading");
    const count = root.querySelector<HTMLElement>("#quick-results-count");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const category = tab.dataset.category || "computers";
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
        groups.forEach((group) => {
          group.hidden = group.dataset.questionGroup !== category;
        });
        if (heading) heading.textContent = category === "laptops" ? "Laptop questions" : "Computer questions";
        if (count) count.textContent = category === "laptops" ? "6 questions" : "9 questions";
      });
    });
  }

  const computersFeedback = document.getElementById("computers-feedback");
  computersFeedback?.addEventListener("submit", (event) => {
    event.preventDefault();
    const status = document.getElementById("computers-feedback-status");
    if (status) {
      status.textContent =
        "Thanks for taking the time. Online submission is not connected yet; your answers have not been sent.";
    }
  });

  document.getElementById("computers-loop-subscribe")?.addEventListener("click", () => {
    const status = document.getElementById("computers-loop-status");
    if (status) {
      status.textContent =
        "Newsletter signup is coming soon. Your email address has not been sent or stored.";
    }
  });

</script>

