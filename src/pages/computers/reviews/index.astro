---
import FlowShell from "@/components/Reviews/FlowShell.astro";
---
<FlowShell
  step={1}
  wide
  title="Explore or Choose Computers & Laptops | ONOCRA Reviews"
  heading="What would you like to do?"
  lead="Choose the path that suits you."
>
  <p class="guide-intro"><span class="guide-name">ONOCRA, your pelican guide</span>“I'll help you explore the differences or find what fits. Either way, your priorities will help me focus on what matters to you.”</p>

  <fieldset class="route-choices" aria-label="Choose your route">
    <legend class="sr-only">Choose one journey</legend>

    <section class="route-card route-card--explore" id="explore-card" aria-label="Explore and compare">
      <img src="/computers/computers-reviewscomparisons.png" alt="ONOCRA pelican comparing computers and laptops using Generational Leap, Value Matrix and ONOCRA Verdict" width="661" height="318" loading="eager" />
      <div class="route-body">
        <strong>Explore &amp; Compare</strong>
        <ul class="explore-points">
          <li>Exploring new computer and laptop technology</li>
          <li>Exploring comparisons among generations</li>
          <li>Comparing models within and across brands</li>
        </ul>
      </div>
      <div class="route-actions">
        <label class="journey-option" for="journey-explore">
          <input id="journey-explore" type="radio" name="journey-choice" value="explore" />
          <span>Explore &amp; Compare</span>
        </label>
      </div>
    </section>

    <section class="route-card route-card--buy" aria-labelledby="buyer-heading">
      <img src="/computers/computers-choose.png" alt="ONOCRA pelican helping a household choose a computer or laptop" width="660" height="318" loading="eager" />
      <div class="route-body">
        <strong id="buyer-heading">Help Me Choose</strong>
        <span>Find the right computer or laptop for your needs and budget.</span>
      </div>
      <fieldset class="route-actions buying-options">
        <legend>What are you planning to do?</legend>
        <label class="journey-option" for="journey-new">
          <input id="journey-new" type="radio" name="journey-choice" value="new" />
          <span>Buy a New Computer or Laptop</span>
        </label>
        <label class="journey-option" for="journey-upgrade">
          <input id="journey-upgrade" type="radio" name="journey-choice" value="upgrade" />
          <span>Upgrade — Replace My Current Computer or Laptop</span>
        </label>
      </fieldset>
    </section>
  </fieldset>

  <p class="route-hint" id="route-hint" role="status" aria-live="polite">You can change your choice later.</p>

  <section class="evaluation-box">
    <strong>How ONOCRA evaluates computers &amp; laptops</strong>
    <p>ONOCRA reviews manufacturer information and published third-party research; we do not conduct laboratory tests.</p>
    <p>Specifications, regional configurations, prices and independent findings remain separate from ONOCRA's editorial interpretation.</p>
    <p>Missing or unverified evidence is shown as such — not estimated.</p>
    <details>
      <summary>About our methodology</summary>
      <p>Generational Leap explains what changed technically. Value Matrix considers whether verified improvement is worth the additional cost. Personal priorities shape relevance, while ONOCRA's independent product evaluation remains separate.</p>
    </details>
  </section>

  <div slot="nav"><a class="btn" id="route-continue" href="#" aria-disabled="true">Continue →</a></div>
</FlowShell>

<script>
  import { readState, stepUrl } from "@/lib/computerReviewFlow";

  type Selection = "explore" | "new" | "upgrade";
  const choices = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="journey-choice"]'));
  const next = document.querySelector<HTMLAnchorElement>("#route-continue");
  const hint = document.querySelector<HTMLElement>("#route-hint");
  const exploreCard = document.querySelector<HTMLElement>("#explore-card");
  const initial = readState(window.location.search);

  const previouslySelected: Selection | null = initial.mode === "match"
    ? (initial.purchase === "upgrade" ? "upgrade" : initial.purchase === "new" ? "new" : null)
    : (["brands", "generations", "value"].includes(initial.mode) ? "explore" : null);

  choices.forEach(choice => { choice.checked = choice.value === previouslySelected; });

  function update(): void {
    const selection = choices.find(choice => choice.checked)?.value as Selection | undefined;

    document.querySelectorAll<HTMLElement>(".route-card").forEach(card => {
      const active = card.classList.contains("route-card--explore")
        ? selection === "explore"
        : selection === "new" || selection === "upgrade";
      card.classList.toggle("is-selected", active);
    });

    if (!next) return;
    next.setAttribute("aria-disabled", String(!selection));

    if (!selection) {
      next.href = "#";
      if (hint) hint.textContent = "Choose one of the three options to continue.";
      return;
    }

    const isBuyer = selection !== "explore";
    const current = readState(window.location.search);
    next.href = stepUrl("who", {
      ...current,
      mode: isBuyer ? "match" : "brands",
      intent: isBuyer ? "buying" : "researching",
      purchase: isBuyer ? selection as "new" | "upgrade" : "",
      who: "",
      explorer: "",
      purpose: "",
      prio: [],
      model: "",
      compare: [],
    });
    if (hint) hint.textContent = "You can change your choice later.";
  }

  choices.forEach(choice => choice.addEventListener("change", update));
  exploreCard?.addEventListener("click", event => {
    if ((event.target as HTMLElement).closest("a,button,input,label")) return;
    const explore = choices.find(choice => choice.value === "explore");
    if (explore) { explore.checked = true; update(); }
  });
  next?.addEventListener("click", event => {
    if (next.getAttribute("aria-disabled") === "true") event.preventDefault();
  });
  window.addEventListener("pageshow", update);
  update();
</script>

<style>
  .guide-intro { background:#edf3e9;border:1px solid #cadbca;border-radius:16px;padding:12px 16px;line-height:1.55;margin:14px 0 16px; }
  .guide-name {font-weight:750;color:#245039;display:block;margin-bottom:3px;}
  .route-choices {border:0;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:stretch;}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
  .route-card{position:relative;display:flex;flex-direction:column;min-width:0;background:#fffdf7;border:2px solid #bfd2c1;border-radius:20px;padding:10px;box-sizing:border-box;overflow:hidden;}
  .route-card.is-selected{border-color:#2f8a52;background:#f1f7ed;box-shadow:0 0 0 2px #bfe3c6;}
  .route-card img{width:100%;aspect-ratio:2.08;object-fit:cover;border-radius:12px;display:block;}
  .route-body{display:flex;flex-direction:column;gap:6px;padding:12px 10px 8px;line-height:1.42;}
  .route-body strong{font:700 clamp(1.2rem,2.5vw,1.7rem)/1.2 Georgia,serif;color:#1d4a2f;}
  .route-body span{font-size:.94rem;color:#3f5748;}
  .explore-points{list-style:disc;display:grid;gap:9px;padding:4px 0 0 21px;margin:0;color:#3b5b45;font-size:.91rem;line-height:1.38;}
  .explore-points li::marker{color:#3e9564;}
  .route-actions{margin-top:auto;padding:9px 5px 4px;min-width:0;}
  .buying-options{border:0;padding-top:10px;display:flex;flex-direction:column;gap:8px;}
  .buying-options legend{color:#365a43;font-size:.91rem;font-weight:740;margin:0 0 4px;padding:0 3px;}
  .journey-option{display:flex;align-items:center;gap:11px;min-height:48px;border:1px solid #c5d9c9;border-radius:12px;padding:10px 12px;background:#fffef9;cursor:pointer;font-size:.9rem;font-weight:650;line-height:1.35;color:#254b35;}
  .journey-option:has(input:checked){background:#e4f3e7;border-color:#378552;box-shadow:0 0 0 1px #8abb9a;}
  .journey-option input{flex:0 0 20px;width:20px;height:20px;accent-color:#2f8a52;cursor:pointer;}
  .route-hint{text-align:center;color:#536a59;font-size:.88rem;margin:12px 0 0;}
  #route-continue[aria-disabled="true"]{opacity:.48;cursor:not-allowed;}
  .evaluation-box{margin-top:14px;padding:14px 16px;border:1px solid #c9daca;border-radius:16px;background:linear-gradient(145deg,#f5f8ef,#fffaf0);color:#385447;}
  .evaluation-box>strong{font:700 1rem Georgia,serif;color:#245039;}
  .evaluation-box p{margin:5px 0;font-size:.84rem;line-height:1.5;}
  .evaluation-box details{margin-top:7px;border-top:1px solid #d9e5d9;padding-top:7px;}
  .evaluation-box summary{cursor:pointer;font-weight:750;color:#2e644b;}
  @media(max-width:640px){.route-choices{grid-template-columns:1fr;gap:12px}.route-card img{max-height:230px}.explore-points{gap:6px}}
</style>
