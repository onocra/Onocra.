          class="popular-card popular-fix"
          href="/search/?q=Wi-Fi%20works%20in%20one%20room%20but%20not%20another"
        >

          <div
            class="popular-icon"
            aria-hidden="true"
          >
            )))
          </div>

          <div class="popular-card-copy">

            <span class="journey-badge">
              FIX
            </span>

            <h3>
              Wi-Fi works in one room but not another
            </h3>

            <p>
              Understand dead zones, weak signals
              and simple ways to improve coverage.
            </p>

          </div>

          <span
            class="card-arrow"
            aria-hidden="true"
