  {title:'Fix',summary:'Solve a connection problem',links:[{title:'Quick Help',href:'#quick-help'},{title:'Diagnostics & Guides',href:'#guides-heading'}]},
  {title:'Decode',summary:'Understand broadband and Wi-Fi',links:[{title:'Wi-Fi 7 explained',href:'#wifi7'},{title:'Guides and learning',href:'#guides-heading'}]},
  {title:'Compare',summary:'Evaluate real differences',links:[{title:'Reviews & Comparisons',href:'#reviews'},{title:'Evaluation approach',href:'#onocra-evaluation'}]},
  {title:'Choose',summary:'Select better connectivity',links:[{title:'Choosing equipment and service',href:'#choose'},{title:'Official manufacturer resources',href:'#onocra-route'}]},
