<Layout>
  <InternetHeader />
  <main id="main-content" class="phones-hub internet-hub">
    <!-- BP43 — local German-language demonstration. No language route, API or machine-translation service. -->
    <div class="net-lang-toolbar" aria-label="Language preview for the Internet and Wi-Fi hub">
      <div class="net-lang-toolbar-copy">
        <span class="net-lang-kicker">LANGUAGE EXPERIENCE · CONCEPT PREVIEW</span>
        <strong>Explore ONOCRA in English or German</strong>
      </div>
      <div class="net-language-options" role="group" aria-label="Switch language preview">
        <button type="button" class="is-current" data-net-language="en" aria-pressed="true" lang="en">EN <span>English</span></button>
        <button type="button" data-net-language="de" aria-pressed="false" lang="de">DE <span>Deutsch</span></button>
      </div>
    </div>

    <!-- BP47 — refined opening section: clear title foliage, matched blue hero,
         image with boxed manufacturers, local flag assets, bottom-note artwork. -->
