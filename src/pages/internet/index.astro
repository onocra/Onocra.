    color: #a7b0ba;

  }


  :global(html[data-theme="dark"])
  .view-all {

    border-color: #46515e;

    background: #202833;

    color: #62d2ad;

  }


  :global(html[data-theme="dark"])
  .popular-card h3 {

    color: #17334a;

  }


  :global(html[data-theme="dark"])
