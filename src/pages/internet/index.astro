---
import Layout from "@/layouts/Layout.astro";
import InternetHeader from "@/components/Internet/Header.astro";
import InternetFooter from "@/components/Internet/Footer.astro";

/** ONOCRA BP45 — Phones BP layout parity pass on BP44 Wi-Fi hub, preserving the EN/DE preview. */
const asset = (filename: string) => `/internet/${filename}`;

const quickHelp = [
  {category: 'internet', question: 'Internet connection is down. What should I check first?', answer: 'Check the modem or optical network terminal lights and whether other devices also lost access. If there is an outage, check your ISP status using mobile data. Restart equipment only after noting any error indicators.'},
  {category: 'internet', question: 'Is the problem my internet provider or my Wi-Fi?', answer: 'Test more than one device. If possible, connect a laptop directly by Ethernet to the router. Working Ethernet with failing wireless often points to Wi-Fi; both failing may indicate the modem, cable or provider.'},
  {category: 'internet', question: 'Should I choose fiber, cable or 5G home internet?', answer: 'Compare address-level availability, upload and download speed, typical latency, reliability, data caps, installation fees and total contract cost. Wireless performance depends on local signal and congestion.'},
  {category: 'internet', question: 'Why is my internet slower than my plan?', answer: 'Test near the router and, where possible, by Ethernet. Compare against the plan’s advertised typical speed; check time-of-day congestion and whether older devices or Wi-Fi links are the bottleneck.'},
  {category: 'internet', question: 'How do I read the modem indicator lights?', answer: 'Power, online, upstream and downstream patterns vary by model. Use the official guide for your modem before deciding whether a blinking light means startup, synchronization or a fault.'},
  {category: 'internet', question: 'How can I choose a home internet plan without overpaying?', answer: 'Compare regular price after introductory discounts, upload rate, hardware rental, data allowance, contract length, cancellation costs and service availability at your address.'},
  {category: 'internet', question: 'Can I use my own router with my ISP?', answer: 'Check whether your ISP supports a separate router, bridge mode or approved modem/ONT equipment. Keep provider-specific authentication and VoIP requirements in mind; avoid untested configuration changes.'},
  {category: 'internet', question: 'Why does video calling stutter even with high download speed?', answer: 'Video calls depend on upload capacity, latency, jitter and packet loss, not download speed alone. Try Ethernet, improve coverage, stop simultaneous uploads and compare performance at different times.'},
  {category: 'wifi', question: 'My Wi-Fi signal is weak upstairs. What works?', answer: 'Move the router away from thick walls and metal objects, use a central elevated position, and consider wired access points or mesh nodes with good backhaul. Test real coverage before buying extenders.'},
  {category: 'wifi', question: 'What is the difference between Wi-Fi 6, 6E and Wi-Fi 7?', answer: 'These are different generations of local wireless networking. Available spectrum, device compatibility, region rules and real-world conditions determine any benefit; Wi-Fi 7 does not upgrade your ISP speed.'},
  {category: 'wifi', question: 'Should I use a mesh system or Wi-Fi extender?', answer: 'Mesh can improve coverage and roaming; a simple extender can help one weak spot but may reduce performance. Wired access points are often more reliable when Ethernet is available.'},
  {category: 'wifi', question: 'How do I secure my home Wi-Fi network?', answer: 'Use WPA3-Personal if supported or WPA2-AES, a strong unique Wi-Fi password, router admin credentials, current firmware and a guest network where suitable. Disable insecure legacy modes.'},
  {category: 'wifi', question: 'Some devices connect to Wi-Fi but have no internet. Why?', answer: 'Check whether the problem affects all devices. Inspect DNS settings, parental schedules, device isolation and router status. Forget and reconnect the network only if necessary.'},
  {category: 'wifi', question: 'How do I set separate guest access for visitors?', answer: 'Enable the router’s guest SSID, choose a separate password and turn on isolation from private devices if available. Options vary by brand and router model.'},
  {category: 'wifi', question: 'Can I limit my child’s internet access at bedtime?', answer: 'Many routers and mesh apps offer profile-based schedules and device pausing. Combine these with device-level parental controls; network filters cannot block every app or bypass method.'},
  {category: 'wifi', question: 'Where should I put a router and mesh nodes?', answer: 'Place your main router near the connection point but in open air, not inside a cabinet. Position mesh nodes where they still receive a good signal, ideally with Ethernet backhaul.'},
];

