    color: #526269;

  }


  :global(html[data-theme="dark"])
  .journey-card {

    border-color: #3d4956;

    background: #202833;

  }


  :global(html[data-theme="dark"])
  .brands-panel,

  :global(html[data-theme="dark"])
  .latest-panel {

    border-color: #3d4956;

    background: #202833;

  }


  :global(html[data-theme="dark"])
  .brand-card {

    border-color: #d7dde2;

    background: #f8fafb;

  }


  :global(html[data-theme="dark"])
  .brand-card span {

    color: #34414a;

  }


  :global(html[data-theme="dark"])
  .route-box {

    background: #293b36;

  }


  :global(html[data-theme="dark"])
  .route-copy p {

    color: #bdc8c4;

