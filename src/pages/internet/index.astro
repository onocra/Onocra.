const internetGuides = [
  {title:'Diagnose a complete home internet outage',description:'Identify the modem/ONT and router, record warning lights, check local provider outages, then follow the manufacturer and ISP restart sequence. Avoid factory reset until you have the correct setup credentials.',query:'official modem ONT internet outage troubleshooting'},
  {title:'Test broadband speed and latency correctly',description:'Run tests with a capable Ethernet-connected device when possible, then compare with a Wi-Fi test. Record download, upload, latency and time of day for fair comparisons.',query:'official broadband speed test ethernet guidance'},
  {title:'Improve an upstairs or distant room signal',description:'Use a simple coverage map, central router placement, and wired backhaul or well-placed mesh nodes; check interference and building materials before adding equipment.',query:'Wi Fi mesh placement official support'},
  {title:'Configure a guest network safely',description:'Create a separate guest SSID and password where supported, keep the admin password private and use guest isolation if available.',query:'router guest network official setup'},
  {title:'Update router firmware without losing settings',description:'Check the exact hardware version, export settings if supported, use official manufacturer downloads, and keep power stable during installation.',query:'update router firmware official support'},
  {title:'Set family Wi-Fi schedules and restrictions',description:'Configure profiles, age-aware filtering and schedules using supported router controls. Combine them with device-level protections because network restrictions are not absolute.',query:'mesh router parental control schedules official setup'},
];
const parentingTopics = [
  {title:'Pause Wi-Fi during bedtime or homework', description:'If your router supports device groups, create a child profile and a predictable bedtime or study schedule. Explain any exceptions for homework and emergency use.'},
  {title:'Block age-inappropriate websites', description:'Use router-based content filters or trusted DNS filtering, supported child profiles and browser/device controls. Check the limitations—some apps and mobile data can bypass network filters.'},
  {title:'Apply safe-search settings', description:'Turn on supported safe-search and video restrictions where relevant, and discuss how to report unsuitable material. No filter blocks everything.'},
  {title:'Create separate guest and child network access', description:'Where your router supports it, use segregated guest access and isolate unfamiliar devices from private home computers.'},
  {title:'Recognize connected devices', description:'Review the router app’s device list and rename known household devices; investigate unknown connections and change credentials when necessary.'},
  {title:'Help teens build healthy online habits', description:'Agree together on screen-time expectations, privacy, online friendships and gaming; explain why technical controls supplement—not replace—conversation.'},
];
