---
import Layout from "@/layouts/Layout.astro";
import InternetHeader from "@/components/Internet/Header.astro";
import InternetFooter from "@/components/Internet/footer.astro";
---

<Layout
  title="Home Internet & Wi-Fi | ONOCRA"
  description="Clear help, practical advice and confident decisions for home internet, Wi-Fi, routers, mesh systems and connected devices."
>
  <InternetHeader />

  <main id="main-content" class="internet-hub">

    <!-- ========================================
         ADVERTISEMENT SPACE 1
    ========================================= -->

    <section class="top-ad" aria-label="Advertisement">
      <span>ADVERTISEMENT</span>
    </section>


    <!-- ========================================
         HERO
    ========================================= -->

    <section class="internet-hero">

      <div class="hero-copy">

        <p class="eyebrow">
          ONOCRA HOME CONNECTIVITY HUB
        </p>

        <h1>
          Home Internet<br />
          &amp; Wi-Fi
        </h1>

        <p class="hero-subtitle">
          Wi-Fi · Routers · Broadband · Coverage
        </p>

        <div class="topic-row" aria-label="Home internet topics">
          <span>Wi-Fi</span>
          <span>Routers</span>
          <span>Mesh</span>
          <span>Broadband</span>
          <span>Coverage</span>
          <span>Speed</span>
        </div>

        <p class="hero-message">
          Fix connection problems, improve coverage
          and understand the technology keeping your
          home connected.
        </p>

      </div>

      <div class="hero-art" aria-hidden="true">
        <img
          src="/internetwifi.png"
          alt=""
          class="hero-image"
        />
      </div>

    </section>


    <!-- ========================================
         EXPLORE YOUR CONNECTION
    ========================================= -->

    <section
      class="connection-section"
      aria-labelledby="connection-heading"
    >

      <h2 id="connection-heading">
        Explore your connection
      </h2>

      <div class="connection-grid">

        <a
          class="connection-card wifi-card"
          href="/internet/wifi/"
        >
          <div class="connection-icon" aria-hidden="true">
            )))
          </div>

          <div class="connection-copy">
            <h3>Wi-Fi &amp; Coverage</h3>

            <p>
              Dead zones, weak signals,
              disconnects and better coverage.
            </p>

            <span>Explore Wi-Fi →</span>
          </div>
        </a>


        <a
          class="connection-card router-card"
          href="/internet/routers/"
        >
          <div
            class="connection-icon router-symbol"
            aria-hidden="true"
          >
            ▰
          </div>

          <div class="connection-copy">
            <h3>Routers &amp; Mesh</h3>

            <p>
              Routers, mesh systems,
              extenders and home networking.
            </p>

            <span>Explore Routers →</span>
          </div>
        </a>


        <a
          class="connection-card broadband-card"
          href="/internet/connections/"
        >
          <div class="connection-icon" aria-hidden="true">
            ⇄
          </div>

          <div class="connection-copy">
            <h3>Internet Connections</h3>

            <p>
              Fiber, cable, DSL,
              mobile and satellite internet.
            </p>

            <span>Explore Connections →</span>
          </div>
        </a>


        <a
          class="connection-card devices-card"
          href="/internet/devices/"
        >
          <div class="connection-icon" aria-hidden="true">
            ⌂
          </div>

          <div class="connection-copy">
            <h3>Connected Devices</h3>

            <p>
              Phones, TVs, computers
              and smart-home connectivity.
            </p>

            <span>Explore Devices →</span>
          </div>
        </a>

      </div>

    </section>


    <!-- ========================================
         ASK ONOCRA
    ========================================= -->

    <section
      class="ask-section"
      aria-labelledby="ask-heading"
    >

      <div class="ask-heading">

        <p class="eyebrow">
          START HERE
        </p>

        <h2 id="ask-heading">
          How can ONOCRA help you today?
        </h2>

        <p>
          Tell us what is happening with your
          internet or Wi-Fi and we’ll help you
          find the clearest route.
        </p>

      </div>


      <form
        class="ask-box"
        action="/search/"
        method="get"
        role="search"
      >

        <div class="search-field">

          <span class="search-symbol" aria-hidden="true">
            ⌕
          </span>

          <input
            id="internet-search"
            name="q"
            type="search"
            placeholder="e.g. Why is my Wi-Fi slow upstairs?"
            aria-label="Ask ONOCRA about home internet and Wi-Fi"
          />

          <button
            class="icon-button"
            id="internet-mic"
            type="button"
            aria-label="Use microphone"
            title="Use microphone"
          >
            ♫
          </button>

          <label
            class="icon-button"
            for="internet-image"
            aria-label="Choose an image"
            title="Choose an image"
          >
            ▣
          </label>

          <input
            id="internet-image"
            class="visually-hidden"
            type="file"
            accept="image/*"
          />

          <button
            class="search-button"
            type="submit"
          >
            Search
          </button>

        </div>

        <p
          id="internet-image-name"
          class="image-name"
          aria-live="polite"
        ></p>

      </form>

    </section>


    <!-- ========================================
         POPULAR HOME INTERNET HELP
    ========================================= -->

    <section
      class="popular-section"
      aria-labelledby="popular-heading"
    >

      <div class="popular-heading-row">

        <div class="popular-title-block">

          <p class="eyebrow">
            POPULAR AT ONOCRA
          </p>

          <h2
            id="popular-heading"
            class="editorial-title"
          >
            Popular Home Internet &amp; Wi-Fi Help
          </h2>

          <p class="popular-intro">
            Quick answers to the problems
            households run into most.
          </p>

        </div>

        <a
          class="view-all"
          href="/search/?q=Home%20Internet%20Wi-Fi"
        >
          View all
          <span aria-hidden="true">→</span>
        </a>

      </div>


      <div class="popular-grid">

        <a
          class="popular-card popular-fix"
          href="/search/?q=Why%20is%20my%20Wi-Fi%20so%20slow"
        >
          <span class="card-number">1</span>
          <div class="journey-icon" aria-label="Fix" title="Fix">🛠</div>

          <h3>Why is my Wi-Fi so slow?</h3>

          <p>
            Find the most common causes
            and what to check first.
          </p>

          <span class="card-arrow" aria-hidden="true">→</span>
        </a>


        <a
          class="popular-card popular-fix"
          href="/search/?q=Wi-Fi%20works%20in%20one%20room%20but%20not%20another"
        >
          <span class="card-number">2</span>
          <div class="journey-icon" aria-label="Fix" title="Fix">🛠</div>

          <h3>
            Wi-Fi works in one room but not another
          </h3>

          <p>
            Fix dead zones, weak signals
            and improve coverage.
          </p>

          <span class="card-arrow" aria-hidden="true">→</span>
        </a>


        <a
          class="popular-card popular-decode"
          href="/search/?q=What%20internet%20speed%20do%20I%20actually%20need"
        >
          <span class="card-number">3</span>
          <div class="journey-icon" aria-label="Decode" title="Decode">💡</div>

          <h3>
            What internet speed do I actually need?
          </h3>

          <p>
            Understand Mbps and choose
            a speed that fits your home.
          </p>

          <span class="card-arrow" aria-hidden="true">→</span>
        </a>


        <a
          class="popular-card popular-compare"
          href="/search/?q=Mesh%20Wi-Fi%20vs%20Wi-Fi%20extender"
        >
          <span class="card-number">4</span>
          <div class="journey-icon" aria-label="Compare" title="Compare">⚖</div>

          <h3>
            Mesh Wi-Fi vs Wi-Fi extender?
          </h3>

          <p>
            Compare two common ways
            to improve Wi-Fi around a larger home.
          </p>

          <span class="card-arrow" aria-hidden="true">→</span>
        </a>


        <a
          class="popular-card popular-safety"
          href="/search/?q=Is%20someone%20using%20or%20hacking%20my%20Wi-Fi"
        >
          <span class="card-number">5</span>
          <div class="journey-icon" aria-label="Digital Safety" title="Digital Safety">🛡</div>

          <h3>
            Is someone using or hacking my Wi-Fi?
          </h3>

          <p>
            Learn the warning signs and
            first steps for securing your network.
          </p>

          <span class="card-arrow" aria-hidden="true">→</span>
        </a>


        <a
          class="popular-card popular-fix"
          href="/search/?q=Connected%20to%20Wi-Fi%20but%20no%20internet"
        >
          <span class="card-number">6</span>
          <div class="journey-icon" aria-label="Fix" title="Fix">🛠</div>

          <h3>
            Connected to Wi-Fi but no internet?
          </h3>

          <p>
            Find the common causes
            and how to fix connection problems.
          </p>

          <span class="card-arrow" aria-hidden="true">→</span>
        </a>


        <a
          class="popular-card popular-parenting"
          href="/search/?q=How%20can%20I%20manage%20my%20child%27s%20internet%20access"
        >
          <span class="card-number">7</span>
          <div class="journey-icon" aria-label="Digital Parenting" title="Digital Parenting">👨‍👧</div>

          <h3>
            How can I manage my child’s internet access?
          </h3>

          <p>
            Explore screen-time controls,
            schedules and safer family settings.
          </p>

          <span class="card-arrow" aria-hidden="true">→</span>
        </a>


        <a
          class="popular-card popular-choose"
          href="/search/?q=Do%20I%20need%20a%20new%20router%20or%20mesh%20system"
        >
          <span class="card-number">8</span>
          <div class="journey-icon" aria-label="Choose" title="Choose">🛒</div>

          <h3>
            Do I need a new router or mesh system?
          </h3>

          <p>
            Work out whether better equipment
            would really improve your home network.
          </p>

          <span class="card-arrow" aria-hidden="true">→</span>
        </a>

      </div>

    </section>


      <!-- ========================================
         EXPLORE ONOCRA
    ========================================= -->

    <section
      class="journeys-section"
      aria-labelledby="journeys-heading"
    >

      <div class="journeys-heading">

        <p class="eyebrow">
          EXPLORE ONOCRA
        </p>

        <h2
          id="journeys-heading"
          class="editorial-title"
        >
          For Home Internet &amp; Wi-Fi
        </h2>

        <p>
          Follow the route that matches your question —
          fix a problem, understand your connection,
          compare your options or choose what is right
          for your home.
        </p>

      </div>


      <div class="journeys-grid">

        <a class="journey-card" href="/internet/fix/" aria-label="Go to Fix">
          <img
            src="/internet/internetfix.png"
            alt="ONOCRA Fix for home internet and Wi-Fi"
          />
        </a>

        <a class="journey-card" href="/internet/decode/" aria-label="Go to Decode">
          <img
            src="/internet/internetdecode.png"
            alt="ONOCRA Decode for home internet and Wi-Fi"
          />
        </a>

        <a class="journey-card" href="/internet/compare/" aria-label="Go to Compare">
          <img
            src="/internet/internetcompare.png"
            alt="ONOCRA Compare for home internet and Wi-Fi"
          />
        </a>

        <a class="journey-card" href="/internet/choose/" aria-label="Go to Choose">
          <img
            src="/internet/internetchoose.png"
            alt="ONOCRA Choose for home internet and Wi-Fi"
          />
        </a>

        <a class="journey-card" href="/internet/safety/" aria-label="Go to Digital Safety">
          <img
            src="/internet/internetdigitalsafety.png"
            alt="ONOCRA Digital Safety for home internet and Wi-Fi"
          />
        </a>

        <a class="journey-card" href="/internet/reviews/" aria-label="Go to Reviews">
          <img
            src="/internet/internetreviews.png"
            alt="ONOCRA home internet and Wi-Fi reviews"
          />
        </a>

        <a class="journey-card" href="/internet/parenting/" aria-label="Go to Digital Parenting">
          <img
            src="/internet/internetdigitalparenting.png"
            alt="ONOCRA Digital Parenting for home internet and Wi-Fi"
          />
        </a>

        <a class="journey-card" href="/internet/guides/" aria-label="Go to Guides and Resources">
          <img
            src="/internet/internetguides.png"
            alt="ONOCRA home internet guides and resources"
          />
        </a>

      </div>

    </section>


    <!-- ========================================
         ADVERTISEMENT SPACE 2
    ========================================= -->

    <section class="mid-ad" aria-label="Advertisement">
      <span>ADVERTISEMENT</span>
    </section>


    <!-- ========================================
         BRANDS + LATEST
    ========================================= -->

    <section class="discovery-grid">

      <!-- ======================================
           LEFT: BRANDS + ONOCRA ROUTE
      ======================================= -->

      <section
        class="brands-panel"
        aria-labelledby="brands-heading"
      >

        <div class="compact-heading">

          <div class="heading-icon heading-icon-green" aria-hidden="true">
            ▥
          </div>

          <div>
            <h2 id="brands-heading">
              Explore ONOCRA by brand
            </h2>

            <p>
              Choose a brand to get support,
              troubleshooting, comparisons and buying advice.
            </p>
          </div>

        </div>


        <div class="brands-grid">

          <a
            class="brand-card"
            href="/internet/brands/tp-link/"
            aria-label="Explore TP-Link"
          >
            <img src="/internet/tplink.png" alt="TP-Link" />
            <span>TP-Link</span>
          </a>

          <a
            class="brand-card"
            href="/internet/brands/netgear/"
            aria-label="Explore NETGEAR"
          >
            <img src="/internet/netgear.png" alt="NETGEAR" />
            <span>NETGEAR</span>
          </a>

          <a
            class="brand-card"
            href="/internet/brands/eero/"
            aria-label="Explore eero"
          >
            <img src="/internet/eero.png" alt="eero" />
            <span>eero</span>
          </a>

          <a
            class="brand-card"
            href="/internet/brands/asus/"
            aria-label="Explore ASUS"
          >
            <img src="/internet/asus.png" alt="ASUS" />
            <span>ASUS</span>
          </a>

          <a
            class="brand-card"
            href="/internet/brands/google-nest/"
            aria-label="Explore Google Nest WiFi"
          >
            <img src="/internet/nest.png" alt="Google Nest WiFi" />
            <span>Google Nest</span>
          </a>

          <a
            class="brand-card"
            href="/internet/brands/linksys/"
            aria-label="Explore Linksys"
          >
            <img src="/internet/linksys.png" alt="Linksys" />
            <span>Linksys</span>
          </a>

          <a
            class="brand-card"
            href="/internet/brands/fritz/"
            aria-label="Explore FRITZ!"
          >
            <img src="/internet/fritz.png" alt="FRITZ!" />
            <span>FRITZ!</span>
          </a>

          <a
            class="brand-card"
            href="/internet/brands/d-link/"
            aria-label="Explore D-Link"
          >
            <img src="/internet/dlink.png" alt="D-Link" />
            <span>D-Link</span>
          </a>

        </div>


        <!-- ONOCRA ROUTE -->

        <div class="route-box">

          <div class="route-symbol" aria-hidden="true">
            🧭
          </div>

          <div class="route-copy">

            <h3>
              Don’t find what you’re looking for?
            </h3>

            <p>
              Explore the ONOCRA Route for more brands,
              technologies and trusted external resources.
            </p>

          </div>

          <a
            class="route-button"
            href="/search/?q=Home%20Internet%20Wi-Fi"
          >
            Browse ONOCRA Route
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </section>


      <!-- ======================================
           RIGHT: LATEST FROM ONOCRA
      ======================================= -->

      <section
        class="latest-panel"
        aria-labelledby="latest-heading"
      >

        <div class="latest-heading-row">

          <div class="compact-heading">

            <div class="heading-icon heading-icon-blue" aria-hidden="true">
              ▤
            </div>

            <div>
              <h2 id="latest-heading">
                Latest from ONOCRA
              </h2>

              <p>
                Fresh help, guides,
                comparisons and reviews.
              </p>
            </div>

          </div>

          <a
            class="latest-view-all"
            href="/search/?q=Home%20Internet%20Wi-Fi"
          >
            View all →
          </a>

        </div>


        <div class="latest-placeholder">

          <span
            class="latest-star"
            aria-hidden="true"
          >
            ✦
          </span>

          <h3>
            Latest stories coming here
          </h3>

          <p>
            This space is reserved for ONOCRA’s newest
            internet, Wi-Fi and networking articles.
          </p>

        </div>

      </section>

    </section>


    <!-- ========================================
         ADVERTISEMENT SPACE 3
    ========================================= -->

    <section class="bottom-ad" aria-label="Advertisement">
      <span>ADVERTISEMENT</span>
    </section>

  </main>


  <!-- ========================================
       INTERNET FOOTER
  ========================================= -->

  <InternetFooter />


</Layout>



<script>

  const micButton =
    document.querySelector(
      "#internet-mic"
    );

  const searchInput =
    document.querySelector(
      "#internet-search"
    );

  const imageInput =
    document.querySelector(
      "#internet-image"
    );

  const imageName =
    document.querySelector(
      "#internet-image-name"
    );


  interface SpeechRecognitionResultEventLike {
    results: {
      [index: number]: {
        [index: number]: {
          transcript: string;
        };
      };
    };
  }


  interface SpeechRecognitionLike {
    lang: string;
    interimResults: boolean;
    maxAlternatives: number;
    start: () => void;

    onresult:
      | ((
          event:
            SpeechRecognitionResultEventLike
        ) => void)
      | null;
  }


  interface SpeechRecognitionConstructor {
    new (): SpeechRecognitionLike;
  }


  interface SpeechRecognitionWindow
    extends Window {

    SpeechRecognition?:
      SpeechRecognitionConstructor;

    webkitSpeechRecognition?:
      SpeechRecognitionConstructor;
  }


  if (
    micButton instanceof
      HTMLButtonElement &&
    searchInput instanceof
      HTMLInputElement
  ) {

    micButton.addEventListener(
      "click",
      () => {

        const speechWindow =
          window as
            SpeechRecognitionWindow;

        const Recognition =
          speechWindow.SpeechRecognition ??
          speechWindow.webkitSpeechRecognition;


        if (!Recognition) {

          searchInput.placeholder =
            "Voice input is not supported by this browser.";

          return;
        }


        const recognition =
          new Recognition();


        recognition.lang =
          "en-US";

        recognition.interimResults =
          false;

        recognition.maxAlternatives =
          1;


        recognition.onresult =
          event => {

            const transcript =
              event.results[0][0].transcript;

            searchInput.value =
              transcript;

            searchInput.focus();
          };


        recognition.start();

      }
    );

  }


  if (
    imageInput instanceof
      HTMLInputElement &&
    imageName instanceof
      HTMLElement
  ) {

    imageInput.addEventListener(
      "change",
      () => {

        const file =
          imageInput.files?.[0];

        imageName.textContent =
          file
            ? `Selected image: ${file.name}`
            : "";

      }
    );

  }

</script>


<style>

  /* ==========================================
     HUB
  =========================================== */

  .internet-hub {

  --hub-forest: #073d32;
  --hub-green: #14624d;
  --hub-orange: #f56622;
  --hub-blue: #1269b0;
  --hub-ink: #17334a;
  --hub-cream: #f8eedc;
  --hub-sage: #e6efe5;

  width: min(100% - 32px, 1240px);

  margin: 0 auto;

  padding: 20px 0 20px;

  color: var(--hub-ink);

}


  .eyebrow {

    margin: 0 0 9px;

    color: var(--hub-orange);

    font-size: 12px;

    font-weight: 800;

    letter-spacing: 0.16em;

  }


  .editorial-title {

    margin: 0;

    font-family:
      "Cooper Black",
      "Bookman Old Style",
      Georgia,
      serif;

    font-size:
      clamp(35px, 4.1vw, 56px);

    font-weight: 900;

    line-height: 0.98;

    letter-spacing: -0.045em;

    color: var(--hub-forest);

    text-wrap: balance;

  }


  /* ==========================================
     ADVERTISEMENTS
  =========================================== */

  .top-ad,
  .mid-ad,
  .bottom-ad {

    min-height: 104px;

    border:
      1px dashed #c9c1b4;

    border-radius: 18px;

    background:
      radial-gradient(
        circle at 15% 30%,
        rgba(18, 105, 176, 0.06),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #fbf3e6,
        #f7eddd
      );

    display: flex;

    align-items: center;

    justify-content: center;

  }


  .top-ad {
    margin-bottom: 24px;
  }


  .mid-ad {
    margin: 54px 0 26px;
  }


  .bottom-ad {
    margin-top: 18px;
  }


  .top-ad span,
  .mid-ad span,
  .bottom-ad span {

    color: #7c817f;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.18em;

  }


  /* ==========================================
     HERO
  =========================================== */

  .internet-hero {

    min-height: 410px;

    padding: 42px 48px;

    border:
      1px solid
      rgba(7, 61, 50, 0.12);

    border-radius: 28px;

    background:
      radial-gradient(
        circle at 86% 20%,
        rgba(18, 105, 176, 0.13),
        transparent 31%
      ),
      radial-gradient(
        circle at 10% 90%,
        rgba(20, 98, 77, 0.08),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #fffaf1 0%,
        #edf6f1 100%
      );

    display: grid;

    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(360px, 0.95fr);

    align-items: center;

    gap: 30px;

    overflow: hidden;

  }


  .hero-copy h1 {

    max-width: 660px;

    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(46px, 5vw, 72px);

    line-height: 0.98;

    letter-spacing: -0.045em;

    color: var(--hub-forest);

  }


  .hero-subtitle {

    margin: 17px 0 18px;

    color: var(--hub-green);

    font-size: 17px;

    font-weight: 700;

  }


  .topic-row {

    max-width: 620px;

    margin-bottom: 20px;

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

  }


  .topic-row span {

    padding: 6px 10px;

    border:
      1px solid
      rgba(7, 61, 50, 0.13);

    border-radius: 999px;

    background:
      rgba(255, 255, 255, 0.72);

    color: #4c5c5b;

    font-size: 11px;

    font-weight: 700;

  }


  .hero-message {

    max-width: 590px;

    margin: 0;

    color: #455e66;

    font-size: 17px;

    line-height: 1.55;

  }


  .hero-art {

    min-width: 0;

    display: flex;

    align-items: center;

    justify-content: center;

  }


  .hero-image {

    display: block;

    width: 100%;

    max-width: 520px;

    height: auto;

    object-fit: contain;

    filter:
      drop-shadow(
        0 14px 24px
        rgba(23, 51, 74, 0.10)
