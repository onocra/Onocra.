---
import Layout from "@/layouts/Layout.astro";
import InternetHeader from "@/components/Internet/Header.astro";
---

<Layout
  title="Home Internet & Wi-Fi | ONOCRA"
  description="Clear help, practical advice and confident decisions for home internet, Wi-Fi, routers, mesh systems and connected devices."
>

  <!-- ========================================
       HOME INTERNET & WI-FI HEADER
  ========================================= -->

  <InternetHeader />


  <!-- ========================================
       HOME INTERNET & WI-FI HUB
  ========================================= -->

  <main
    id="main-content"
    class="internet-hub"
  >


    <!-- ========================================
         ADVERTISEMENT SPACE 1
    ========================================= -->

    <section
      class="top-ad"
      aria-label="Advertisement"
    >
      <span>ADVERTISEMENT</span>
    </section>


    <!-- ========================================
         HERO
    ========================================= -->

    <section class="internet-hero">

      <div class="hero-copy">

        <p class="eyebrow">
          ONOCRA HOME CONNECTIVITY HUB
        </p>

        <h1>
          Home Internet<br />
          &amp; Wi-Fi
        </h1>

        <p class="hero-subtitle">
          Wi-Fi · Routers · Broadband · Coverage
        </p>

        <div
          class="topic-row"
          aria-label="Home internet topics"
        >
          <span>Wi-Fi</span>
          <span>Routers</span>
          <span>Mesh</span>
          <span>Broadband</span>
          <span>Coverage</span>
          <span>Speed</span>
        </div>

        <p class="hero-message">
          Fix connection problems, improve coverage
          and understand the technology keeping your
          home connected.
        </p>

      </div>


      <!--
        Artwork will be added in the next visual step.
        Keeping a designed placeholder prevents broken
        image links while we establish the page shell.
      -->

      <div
        class="hero-art"
        aria-hidden="true"
      >

        <div class="hero-placeholder">

          <div class="wifi-symbol">
            ◉
          </div>

          <strong>
            Home Internet &amp; Wi-Fi
          </strong>

          <span>
            ONOCRA
          </span>

        </div>

      </div>

    </section>


    <!-- ========================================
         EXPLORE YOUR CONNECTION
    ========================================= -->

    <section
      class="connection-section"
      aria-labelledby="connection-heading"
    >

      <h2 id="connection-heading">
        Explore your connection
      </h2>


      <div class="connection-grid">


        <!-- WI-FI -->

        <a
          class="connection-card wifi-card"
          href="/internet/wifi/"
        >

          <div
            class="connection-icon"
            aria-hidden="true"
          >
            ))) 
          </div>

          <div class="connection-copy">

            <h3>
              Wi-Fi &amp; Coverage
            </h3>

            <p>
              Dead zones, weak signals,
              disconnects and better coverage.
            </p>

            <span>
              Explore Wi-Fi →
            </span>

          </div>

        </a>


        <!-- ROUTERS -->

        <a
          class="connection-card router-card"
          href="/internet/routers/"
        >

          <div
            class="connection-icon router-symbol"
            aria-hidden="true"
          >
            ▰
          </div>

          <div class="connection-copy">

            <h3>
              Routers &amp; Mesh
            </h3>

            <p>
              Routers, mesh systems,
              extenders and home networking.
            </p>

            <span>
              Explore Routers →
            </span>

          </div>

        </a>


        <!-- INTERNET CONNECTION -->

        <a
          class="connection-card broadband-card"
          href="/internet/connections/"
        >

          <div
            class="connection-icon"
            aria-hidden="true"
          >
            ⇄
          </div>

          <div class="connection-copy">

            <h3>
              Internet Connections
            </h3>

            <p>
              Fiber, cable, DSL,
              mobile and satellite internet.
            </p>

            <span>
              Explore Connections →
            </span>

          </div>

        </a>


        <!-- CONNECTED DEVICES -->

        <a
          class="connection-card devices-card"
          href="/internet/devices/"
        >

          <div
            class="connection-icon"
            aria-hidden="true"
          >
            ⌂
          </div>

          <div class="connection-copy">

            <h3>
              Connected Devices
            </h3>

            <p>
              Phones, TVs, computers
              and smart-home connectivity.
            </p>

            <span>
              Explore Devices →
            </span>

          </div>

        </a>

      </div>

    </section>


    <!-- ========================================
         ASK ONOCRA
    ========================================= -->

    <section
      class="ask-section"
      aria-labelledby="ask-heading"
    >

      <div class="ask-heading">

        <p class="eyebrow">
          START HERE
        </p>

        <h2 id="ask-heading">
          How can ONOCRA help you today?
        </h2>

        <p>
          Tell us what is happening with your
          internet or Wi-Fi and we’ll help you
          find the clearest route.
        </p>

      </div>


      <form
        class="ask-box"
        action="/search/"
        method="get"
        role="search"
      >

        <div class="search-field">

          <span
            class="search-symbol"
            aria-hidden="true"
          >
            ⌕
          </span>

          <input
            id="internet-search"
            name="q"
            type="search"
            placeholder="e.g. Why is my Wi-Fi slow upstairs?"
            aria-label="Ask ONOCRA about home internet and Wi-Fi"
          />


          <!-- MICROPHONE -->

          <button
            class="icon-button"
            id="internet-mic"
            type="button"
            aria-label="Use microphone"
            title="Use microphone"
          >
            ♫
          </button>


          <!-- IMAGE -->

          <label
            class="icon-button"
            for="internet-image"
            aria-label="Choose an image"
            title="Choose an image"
          >
            ▣
          </label>

          <input
            id="internet-image"
            class="visually-hidden"
            type="file"
            accept="image/*"
          />


          <!-- SEARCH -->

          <button
            class="search-button"
            type="submit"
          >
            Search
          </button>

        </div>


        <p
          id="internet-image-name"
          class="image-name"
          aria-live="polite"
        ></p>

      </form>

    </section>


    <!-- ========================================
         NEXT CONTENT PLACEHOLDER
    ========================================= -->

    <section class="next-section">

      <p class="eyebrow">
        NEXT
      </p>

      <h2>
        Popular Home Internet &amp; Wi-Fi help
      </h2>

      <p>
        The Popular at ONOCRA questions and the
        full FIX · DECODE · COMPARE · CHOOSE
        navigation will be added here next.
      </p>

    </section>

  </main>

</Layout>


<script>

  /* ==========================================
     MICROPHONE
  =========================================== */

  const micButton =
    document.querySelector(
      "#internet-mic"
    );

  const searchInput =
    document.querySelector(
      "#internet-search"
    );

  const imageInput =
    document.querySelector(
      "#internet-image"
    );

  const imageName =
    document.querySelector(
      "#internet-image-name"
    );


  interface SpeechRecognitionResultEventLike {
    results: {
      [index: number]: {
        [index: number]: {
          transcript: string;
        };
      };
    };
  }


  interface SpeechRecognitionLike {
    lang: string;

    interimResults: boolean;

    maxAlternatives: number;

    start: () => void;

    onresult:
      | ((
          event:
            SpeechRecognitionResultEventLike
        ) => void)
      | null;
  }


  interface SpeechRecognitionConstructor {
    new (): SpeechRecognitionLike;
  }


  interface SpeechRecognitionWindow
    extends Window {

    SpeechRecognition?:
      SpeechRecognitionConstructor;

    webkitSpeechRecognition?:
      SpeechRecognitionConstructor;
  }


  if (
    micButton instanceof
      HTMLButtonElement &&
    searchInput instanceof
      HTMLInputElement
  ) {

    micButton.addEventListener(
      "click",
      () => {

        const speechWindow =
          window as
            SpeechRecognitionWindow;

        const Recognition =
          speechWindow.SpeechRecognition ??
          speechWindow
            .webkitSpeechRecognition;


        if (!Recognition) {

          searchInput.placeholder =
            "Voice input is not supported by this browser.";

          return;
        }


        const recognition =
          new Recognition();


        recognition.lang =
          "en-US";

        recognition.interimResults =
          false;

        recognition.maxAlternatives =
          1;


        recognition.onresult =
          event => {

            const transcript =
              event
                .results[0][0]
                .transcript;

            searchInput.value =
              transcript;

            searchInput.focus();
          };


        recognition.start();

      }
    );

  }


  /* ==========================================
     IMAGE SELECTION
  =========================================== */

  if (
    imageInput instanceof
      HTMLInputElement &&
    imageName instanceof
      HTMLElement
  ) {

    imageInput.addEventListener(
      "change",
      () => {

        const file =
          imageInput.files?.[0];

        imageName.textContent =
          file
            ? `Selected image: ${file.name}`
            : "";

      }
    );

  }

</script>


<style>

  /* ==========================================
     HUB
  =========================================== */

  .internet-hub {

    --hub-forest: #073d32;
    --hub-green: #14624d;
    --hub-orange: #f56622;
    --hub-blue: #1269b0;
    --hub-ink: #17334a;
    --hub-cream: #f8eedc;
    --hub-sage: #e6efe5;

    width:
      min(100% - 32px, 1240px);

    margin:
      0 auto;

    padding:
      20px 0 72px;

    color:
      var(--hub-ink);

  }


  /* ==========================================
     ADVERTISEMENT
  =========================================== */

  .top-ad {

    min-height: 104px;

    margin-bottom: 24px;

    border:
      1px dashed
      #c9c1b4;

    border-radius: 18px;

    background:
      radial-gradient(
        circle at 15% 30%,
        rgba(18, 105, 176, 0.06),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #fbf3e6,
        #f7eddd
      );

    display: flex;

    align-items: center;

    justify-content: center;

  }


  .top-ad span {

    color: #7c817f;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.18em;

  }


  /* ==========================================
     HERO
  =========================================== */

  .internet-hero {

    min-height: 410px;

    padding:
      42px 48px;

    border:
      1px solid
      rgba(7, 61, 50, 0.12);

    border-radius: 28px;

    background:
      radial-gradient(
        circle at 86% 20%,
        rgba(18, 105, 176, 0.13),
        transparent 31%
      ),
      radial-gradient(
        circle at 10% 90%,
        rgba(20, 98, 77, 0.08),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #fffaf1 0%,
        #edf6f1 100%
      );

    display: grid;

    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(360px, 0.95fr);

    align-items: center;

    gap: 30px;

    overflow: hidden;

  }


  .eyebrow {

    margin:
      0 0 9px;

    color:
      var(--hub-orange);

    font-size: 12px;

    font-weight: 800;

    letter-spacing: 0.16em;

  }


  .hero-copy h1 {

    max-width: 660px;

    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(46px, 5vw, 72px);

    line-height: 0.98;

    letter-spacing: -0.045em;

    color:
      var(--hub-forest);

  }


  .hero-subtitle {

    margin:
      17px 0 18px;

    color:
      var(--hub-green);

    font-size: 17px;

    font-weight: 700;

  }


  .topic-row {

    max-width: 620px;

    margin-bottom: 20px;

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

  }


  .topic-row span {

    padding:
      6px 10px;

    border:
      1px solid
      rgba(7, 61, 50, 0.13);

    border-radius: 999px;

    background:
      rgba(255, 255, 255, 0.72);

    color: #4c5c5b;

    font-size: 11px;

    font-weight: 700;

  }


  .hero-message {

    max-width: 590px;

    margin: 0;

    color: #455e66;

    font-size: 17px;

    line-height: 1.55;

  }


  /* ==========================================
     HERO PLACEHOLDER
  =========================================== */

  .hero-art {

    min-width: 0;

    display: flex;

    align-items: center;

    justify-content: center;

  }


  .hero-placeholder {

    width: 100%;

    max-width: 430px;

    min-height: 280px;

    padding: 30px;

    border:
      1px solid
      rgba(18, 105, 176, 0.14);

    border-radius: 28px;

    background:
      radial-gradient(
        circle at 50% 35%,
        rgba(18, 105, 176, 0.16),
        transparent 40%
      ),
      rgba(255, 255, 255, 0.5);

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

  }


  .wifi-symbol {

    width: 92px;

    height: 92px;

    margin-bottom: 20px;

    border-radius: 50%;

    background:
      #e7f1f7;

    color:
      var(--hub-blue);

    display: grid;

    place-items: center;

    font-size: 42px;

    font-weight: 900;

  }


  .hero-placeholder strong {

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color:
      var(--hub-forest);

    font-size: 28px;

  }


  .hero-placeholder span {

    margin-top: 7px;

    color:
      var(--hub-orange);

    font-size: 11px;

    font-weight: 900;

    letter-spacing: 0.18em;

  }


  /* ==========================================
     CONNECTION CATEGORIES
  =========================================== */

  .connection-section {

    padding:
      48px 0 44px;

  }


  .connection-section > h2 {

    margin:
      0 0 20px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color:
      var(--hub-forest);

    font-size: 31px;

    line-height: 1.1;

  }


  .connection-grid {

    display: grid;

    grid-template-columns:
      repeat(
        4,
        minmax(0, 1fr)
      );

    gap: 16px;

  }


  .connection-card {

    min-width: 0;

    min-height: 270px;

    padding:
      24px 18px 20px;

    border:
      1px solid
      rgba(7, 61, 50, 0.11);

    border-radius: 22px;

    color:
      var(--hub-ink);

    text-decoration: none;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;

  }


  .connection-card:hover {

    transform:
      translateY(-3px);

    box-shadow:
      0 14px 32px
      rgba(23, 51, 74, 0.1);

  }


  .wifi-card {
    background: #e7f1f7;
  }


  .router-card {
    background: #e6efe5;
  }


  .broadband-card {
    background: #fbe8da;
  }


  .devices-card {
    background: #eee9f5;
  }


  .connection-icon {

    height: 110px;

    display: flex;

    align-items: center;

    justify-content: center;

    color:
      var(--hub-blue);

    font-family:
      Arial,
      sans-serif;

    font-size: 54px;

    font-weight: 800;

    letter-spacing: -0.12em;

  }


  .router-symbol {

    color:
      var(--hub-green);

    letter-spacing: 0;

  }


  .connection-copy {

    margin-top: auto;

  }


  .connection-copy h3 {

    margin:
      12px 0 6px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color:
      var(--hub-forest);

    font-size: 23px;

  }


  .connection-copy p {

    min-height: 42px;

    margin:
      0 0 12px;

    color: #53666a;

    font-size: 12px;

    line-height: 1.45;

  }


  .connection-copy span {

    color:
      var(--hub-green);

    font-size: 12px;

    font-weight: 800;

  }


  /* ==========================================
     ASK ONOCRA
  =========================================== */

  .ask-section {

    padding:
      34px 38px 38px;

    border:
      1px solid
      rgba(7, 61, 50, 0.12);

    border-radius: 26px;

    background:
      radial-gradient(
        circle at 90% 10%,
        rgba(20, 98, 77, 0.09),
        transparent 27%
      ),
      #fffaf2;

  }


  .ask-heading {

    text-align: center;

  }


  .ask-heading h2 {

    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color:
      var(--hub-forest);

    font-size:
      clamp(30px, 3vw, 43px);

    line-height: 1.1;

  }


  .ask-heading > p:last-child {

    max-width: 650px;

    margin:
      10px auto 24px;

    color: #617075;

    font-size: 15px;

    line-height: 1.55;

  }


  .ask-box {

    max-width: 920px;

    margin:
      0 auto;

  }


  .search-field {

    min-height: 62px;

    padding:
      7px 8px
      7px 17px;

    border:
      1px solid
      rgba(7, 61, 50, 0.22);

    border-radius: 18px;

    background: #ffffff;

    display: flex;

    align-items: center;

    gap: 8px;

    box-shadow:
      0 8px 26px
      rgba(23, 51, 74, 0.07);

  }


  .search-symbol {

    flex: 0 0 auto;

    color: #73817f;

    font-size: 25px;

  }


  .search-field
  input[type="search"] {

    min-width: 0;

    flex: 1;

    border: 0;

    outline: 0;

    background:
      transparent;

    color:
      var(--hub-ink);

    font: inherit;

    font-size: 15px;

  }


  .search-field
  input[type="search"]::placeholder {

    color: #8a9696;

  }


  .icon-button {

    width: 39px;

    height: 39px;

    flex:
      0 0 39px;

    padding: 0;

    border: 0;

    border-radius: 10px;

    background:
      transparent;

    color:
      var(--hub-green);

    font-size: 20px;

    cursor: pointer;

    display: grid;

    place-items: center;

  }


  .icon-button:hover {

    background:
      var(--hub-sage);

  }


  .search-button {

    height: 46px;

    padding:
      0 25px;

    border: 0;

    border-radius: 12px;

    background:
      var(--hub-green);

    color: #ffffff;

    font-size: 14px;

    font-weight: 800;

    cursor: pointer;

  }


  .search-button:hover {

    background:
      var(--hub-forest);

  }


  .image-name {

    min-height: 18px;

    margin:
      7px 5px 0;

    color: #617075;

    font-size: 12px;

  }


  .visually-hidden {

    position:
      absolute !important;

    width:
      1px !important;

    height:
      1px !important;

    padding:
      0 !important;

    margin:
      -1px !important;

    overflow:
      hidden !important;

    clip:
      rect(
        0,
        0,
        0,
        0
      ) !important;

    white-space:
      nowrap !important;

    border:
      0 !important;

  }


  /* ==========================================
     NEXT PLACEHOLDER
  =========================================== */

  .next-section {

    margin-top: 42px;

    padding:
      42px;

    border:
      1px dashed
      rgba(7, 61, 50, 0.18);

    border-radius: 24px;

    background:
      #fffdf8;

    text-align: center;

  }


  .next-section h2 {

    margin:
      0 0 10px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color:
      var(--hub-forest);

    font-size:
      clamp(
        28px,
        3vw,
        40px
      );

  }


  .next-section > p:last-child {

    max-width: 620px;

    margin:
      0 auto;

    color: #687779;

    font-size: 14px;

    line-height: 1.55;

  }


  /* ==========================================
     DARK THEME
  =========================================== */

  :global(
    html[data-theme="dark"]
  )
  .internet-hub {

    --hub-forest: #f4f1e9;
    --hub-green: #62d2ad;
    --hub-ink: #e8edf1;

    color:
      #e8edf1;

  }


  :global(
    html[data-theme="dark"]
  )
  .top-ad {

    border-color:
      #46515e;

    background:
      #202833;

  }


  :global(
    html[data-theme="dark"]
  )
  .internet-hero {

    border-color:
      #3a4653;

    background:
      radial-gradient(
        circle at 85% 18%,
        rgba(18, 105, 176, 0.15),
        transparent 30%
      ),
      #202833;

  }


  :global(
    html[data-theme="dark"]
  )
  .hero-message,

  :global(
    html[data-theme="dark"]
  )
  .ask-heading > p:last-child,

  :global(
    html[data-theme="dark"]
  )
  .next-section > p:last-child {

    color:
      #b9c1c9;

  }


  :global(
    html[data-theme="dark"]
  )
  .topic-row span {

    border-color:
      #4a5562;

    background:
      #d8dde1;

    color:
      #34414a;

  }


  :global(
    html[data-theme="dark"]
  )
  .hero-placeholder {

    border-color:
      #46515e;

    background:
      #252f3b;

  }


  :global(
    html[data-theme="dark"]
  )
  .connection-card {

    border-color:
      #4a5562;

  }


  :global(
    html[data-theme="dark"]
  )
  .connection-copy h3 {

    color:
      #17334a;

  }


  :global(
    html[data-theme="dark"]
  )
  .connection-copy p {

    color:
      #526269;

  }


  :global(
    html[data-theme="dark"]
  )
  .connection-copy span {

    color:
      #14624d;

  }


  :global(
    html[data-theme="dark"]
  )
  .ask-section,

  :global(
    html[data-theme="dark"]
  )
  .next-section {

    border-color:
      #3c4855;

    background:
      #202833;

  }


  :global(
    html[data-theme="dark"]
  )
  .search-field {

    border-color:
      #4a5562;

    background:
      #2a3441;

    box-shadow:
      none;

  }


  :global(
    html[data-theme="dark"]
  )
  .search-field
  input[type="search"] {

    color:
      #f3f5f7;

  }


  :global(
    html[data-theme="dark"]
  )
  .search-field
  input[type="search"]::placeholder {

    color:
      #a7b0ba;

  }


  /* ==========================================
     TABLET
  =========================================== */

  @media (max-width: 1050px) {

    .internet-hero {

