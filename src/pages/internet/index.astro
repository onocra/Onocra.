  /* ==========================================
     CONNECTION CATEGORIES
  =========================================== */

  .connection-section {

    padding: 48px 0 44px;

  }


  .connection-section > h2 {

    margin: 0 0 20px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color: var(--hub-forest);

    font-size: 31px;

    line-height: 1.1;

  }


  .connection-grid {

    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 16px;

  }


  .connection-card {

    min-width: 0;

    min-height: 270px;

    padding: 24px 18px 20px;

    border:
      1px solid
      rgba(7, 61, 50, 0.11);

    border-radius: 22px;

    color: var(--hub-ink);

    text-decoration: none;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;

  }


  .connection-card:hover {

    transform: translateY(-3px);

    box-shadow:
      0 14px 32px
      rgba(23, 51, 74, 0.1);

  }


  .wifi-card {
    background: #e7f1f7;
  }


  .router-card {
    background: #e6efe5;
  }


  .broadband-card {
    background: #fbe8da;
  }


  .devices-card {
    background: #eee9f5;
  }


  .connection-icon {

    height: 110px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: var(--hub-blue);

    font-family: Arial, sans-serif;

    font-size: 54px;

    font-weight: 800;

    letter-spacing: -0.12em;

  }


  .router-symbol {

    color: var(--hub-green);

    letter-spacing: 0;

  }


  .connection-copy {

    margin-top: auto;

  }


  .connection-copy h3 {

    margin: 12px 0 6px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color: var(--hub-forest);

    font-size: 23px;

  }


  .connection-copy p {

    min-height: 42px;

    margin: 0 0 12px;

    color: #53666a;

    font-size: 12px;

    line-height: 1.45;

  }


  .connection-copy span {

    color: var(--hub-green);

    font-size: 12px;

    font-weight: 800;

  }


  /* ==========================================
     ASK ONOCRA
  =========================================== */

  .ask-section {

    padding: 34px 38px 38px;

    border:
      1px solid
      rgba(7, 61, 50, 0.12);

    border-radius: 26px;

    background:
      radial-gradient(
        circle at 90% 10%,
        rgba(20, 98, 77, 0.09),
        transparent 27%
      ),
      #fffaf2;

  }


  .ask-heading {

    text-align: center;

  }


  .ask-heading h2 {

    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color: var(--hub-forest);

    font-size:
      clamp(30px, 3vw, 43px);

    line-height: 1.1;

  }


  .ask-heading > p:last-child {

    max-width: 650px;

    margin: 10px auto 24px;

    color: #617075;

    font-size: 15px;

    line-height: 1.55;

  }


  .ask-box {

    max-width: 920px;

    margin: 0 auto;

  }


  .search-field {

    min-height: 62px;

    padding: 7px 8px 7px 17px;

    border:
      1px solid
      rgba(7, 61, 50, 0.22);

    border-radius: 18px;

    background: #ffffff;

    display: flex;

    align-items: center;

    gap: 8px;

    box-shadow:
      0 8px 26px
      rgba(23, 51, 74, 0.07);

  }


  .search-symbol {

    flex: 0 0 auto;

    color: #73817f;

    font-size: 25px;

  }


  .search-field input[type="search"] {

    min-width: 0;

    flex: 1;

    border: 0;

    outline: 0;

    background: transparent;

    color: var(--hub-ink);

    font: inherit;

    font-size: 15px;

  }


  .search-field input[type="search"]::placeholder {

    color: #8a9696;

  }


  .icon-button {

    width: 39px;

    height: 39px;

    flex: 0 0 39px;

    padding: 0;

    border: 0;

    border-radius: 10px;

    background: transparent;

    color: var(--hub-green);

    font-size: 20px;

    cursor: pointer;

    display: grid;

    place-items: center;

  }


  .icon-button:hover {

    background: var(--hub-sage);

  }


  .search-button {

    height: 46px;

    padding: 0 25px;

    border: 0;

    border-radius: 12px;

    background: var(--hub-green);

    color: #ffffff;

    font-size: 14px;

    font-weight: 800;

    cursor: pointer;

  }


  .search-button:hover {

    background: var(--hub-forest);

  }


  .image-name {

    min-height: 18px;

    margin: 7px 5px 0;

    color: #617075;

    font-size: 12px;

  }


  .visually-hidden {

    position: absolute !important;

    width: 1px !important;

    height: 1px !important;

    padding: 0 !important;

    margin: -1px !important;

    overflow: hidden !important;

    clip: rect(0, 0, 0, 0) !important;

    white-space: nowrap !important;

    border: 0 !important;

  }


  /* ==========================================
     POPULAR HELP
  =========================================== */

  .popular-section {

    padding: 50px 0 8px;

  }


  .popular-heading-row {

    margin-bottom: 22px;

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 28px;

  }


  .popular-title-block {

    min-width: 0;

  }


  .popular-intro {

    margin: 12px 0 0;

    color: #687779;

    font-size: 14px;

    line-height: 1.5;

  }


  .view-all {

    flex: 0 0 auto;

    margin-bottom: 5px;

    padding: 11px 17px;

    border:
      1px solid
      rgba(20, 98, 77, 0.2);

    border-radius: 999px;

    background: #f6fbf7;

    color: var(--hub-green);

    font-size: 12px;

    font-weight: 900;

    text-decoration: none;

    display: inline-flex;

    align-items: center;

    gap: 8px;

    box-shadow:
      0 6px 16px
      rgba(20, 98, 77, 0.05);

    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background-color 0.18s ease;

  }


  .view-all:hover {

    transform: translateY(-2px);

    background: var(--hub-sage);

    box-shadow:
      0 9px 22px
      rgba(20, 98, 77, 0.1);

  }


  .popular-grid {

    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 14px;

  }


  .popular-card {

    --card-accent: #1269b0;

    position: relative;

    min-width: 0;

    height: 215px;

    padding: 17px 17px 16px;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--card-accent) 17%,
        transparent
      );

    border-radius: 23px;

    color: var(--hub-ink);

    text-decoration: none;

    display: grid;

    grid-template-columns:
      46px minmax(0, 1fr);

    grid-template-rows:
      46px auto 1fr;

    column-gap: 12px;

    overflow: hidden;

    isolation: isolate;

    box-shadow:
      0 5px 15px
      rgba(23, 51, 74, 0.035);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;

  }


  .popular-card::before {

    content: "";

    position: absolute;

    z-index: -1;

    width: 150px;

    height: 150px;

    right: -55px;

    top: -65px;

    border-radius: 50%;

    background:
      color-mix(
        in srgb,
        var(--card-accent) 7%,
        transparent
      );

  }


  .popular-card:hover {

    transform:
      translateY(-4px)
      scale(1.01);

    box-shadow:
      0 15px 30px
      rgba(23, 51, 74, 0.10);

  }


  .popular-fix {

    --card-accent: #1688d4;

    background:
      linear-gradient(
        145deg,
        #eef8ff,
        #e5f3fc
      );

  }


  .popular-decode {

    --card-accent: #35a75f;

    background:
      linear-gradient(
        145deg,
        #f0faef,
        #e7f5e8
      );

  }


  .popular-compare {

    --card-accent: #e96316;

    background:
      linear-gradient(
        145deg,
        #fff6ec,
        #fcebdc
      );

  }


  .popular-choose {

    --card-accent: #8444b5;

    background:
      linear-gradient(
        145deg,
        #f7f0fc,
        #eee5f7
      );

  }


  .popular-safety {

    --card-accent: #07977f;

    background:
      linear-gradient(
        145deg,
        #effbf7,
        #e3f4ef
      );

  }


  .popular-parenting {

    --card-accent: #ca4964;

    background:
      linear-gradient(
        145deg,
        #fff2f4,
        #f8e6e9
      );

  }


  .card-number {

    position: absolute;

    left: 14px;

    top: 14px;

    width: 31px;

    height: 31px;

    border-radius: 999px;

    background: var(--card-accent);

    color: #ffffff;

    font-family: Arial, sans-serif;

    font-size: 13px;

    font-weight: 900;

    display: grid;

    place-items: center;

  }


  .journey-icon {

    grid-column: 1;

    grid-row: 1;

    width: 46px;

    height: 46px;

    margin-left: 34px;

    border-radius: 50%;

    background:
      rgba(255, 255, 255, 0.78);

    display: grid;

    place-items: center;

    font-size: 22px;

    line-height: 1;

    box-shadow:
      0 5px 14px
      rgba(23, 51, 74, 0.06);

  }


  .popular-card h3 {

    grid-column: 1 / -1;

    grid-row: 2;

    margin: 13px 30px 6px 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color: #12363a;

    font-size:
      clamp(17px, 1.55vw, 21px);

    line-height: 1.12;

    letter-spacing: -0.025em;

  }


  .popular-card p {

    grid-column: 1 / -1;

    grid-row: 3;

    margin: 0;

    padding-right: 30px;

    color: #5b6f75;

    font-size: 11.5px;

    line-height: 1.4;

  }


  .card-arrow {

    position: absolute;

    right: 14px;

    bottom: 14px;

    width: 31px;

    height: 31px;

    border-radius: 50%;

    background:
      rgba(255, 255, 255, 0.86);

    color: var(--card-accent);

    font-size: 19px;

    font-weight: 900;

    display: grid;

    place-items: center;

  }


  /* ==========================================
     EXPLORE ONOCRA JOURNEYS
  =========================================== */

  .journeys-section {

    padding: 68px 0 20px;

  }


  .journeys-heading {

    max-width: 940px;

    margin-bottom: 28px;

  }


  .journeys-heading > p:last-child {

    max-width: 760px;

    margin: 13px 0 0;

    color: #687779;

    font-size: 15px;

    line-height: 1.55;

  }


  .journeys-grid {

    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 16px;

  }


  .journey-card {

    position: relative;

    min-width: 0;

    min-height: 210px;

    border:
      1px solid
      rgba(7, 61, 50, 0.10);

    border-radius: 22px;

    background:
      linear-gradient(
        145deg,
        #fffdf8,
        #f8f3e9
      );

    overflow: hidden;

    text-decoration: none;

    display: flex;

    align-items: center;

    justify-content: center;

    box-shadow:
      0 7px 18px
      rgba(23, 51, 74, 0.055);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;

  }


  .journey-card:hover {

    transform: translateY(-5px);

    border-color:
      rgba(20, 98, 77, 0.25);

    box-shadow:
      0 17px 34px
      rgba(23, 51, 74, 0.12);

  }


  .journey-card img {

    display: block;

    width: 100%;

    height: auto;

    max-height: 245px;

    object-fit: contain;

    transition:
      transform 0.22s ease;

  }


  .journey-card:hover img {

    transform: scale(1.025);

  }


  /* ==========================================
     BRANDS + LATEST
  =========================================== */

  .discovery-grid {

    display: grid;

    grid-template-columns:
      minmax(0, 1.08fr)
      minmax(0, 0.92fr);

    gap: 14px;

    align-items: stretch;

  }


  .brands-panel,
  .latest-panel {

    min-width: 0;

    padding: 16px;

    border:
      1px solid
      rgba(7, 61, 50, 0.10);

    border-radius: 20px;

    background:
      rgba(255, 253, 248, 0.72);

    box-shadow:
      0 5px 16px
      rgba(23, 51, 74, 0.035);

  }


  .compact-heading {

    min-width: 0;

    display: flex;

    align-items: flex-start;

    gap: 10px;

  }


  .heading-icon {

    width: 34px;

    height: 34px;

    flex: 0 0 34px;

    border-radius: 9px;

    display: grid;

    place-items: center;

    font-size: 18px;

    font-weight: 900;

  }


  .heading-icon-green {

    background: #e5f1e8;

    color: var(--hub-green);

  }


  .heading-icon-blue {

    background: #e6f2fb;

    color: var(--hub-blue);

  }


  .compact-heading h2 {

    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color: var(--hub-forest);

    font-size:
      clamp(22px, 2.2vw, 31px);

    line-height: 1.05;

    letter-spacing: -0.025em;

  }


  .compact-heading p {

    margin: 4px 0 0;

    color: #687779;

    font-size: 10.5px;

    line-height: 1.4;

  }


  /* ==========================================
     COMPACT BRAND GRID
  =========================================== */

  .brands-grid {

    margin-top: 13px;

    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 7px;

  }


  .brand-card {

    min-width: 0;

    height: 92px;

    padding: 8px 7px 7px;

    border:
      1px solid
      rgba(7, 61, 50, 0.09);

    border-radius: 11px;

    background: #ffffff;

    color: var(--hub-ink);

    text-decoration: none;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: 5px;

    overflow: hidden;

    box-shadow:
      0 3px 8px
      rgba(23, 51, 74, 0.04);

    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;

  }


  .brand-card:hover {

    transform: translateY(-2px);

    box-shadow:
      0 8px 16px
      rgba(23, 51, 74, 0.09);

  }


  .brand-card img {

    display: block;

    width: 100%;

    max-width: 86px;

    height: 49px;

    object-fit: contain;

    object-position: center;

  }


  .brand-card span {

    max-width: 100%;

    color: #42565c;

    font-size: 9.5px;

    font-weight: 700;

    line-height: 1;

    text-align: center;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;

  }


  /* ==========================================
     ONOCRA ROUTE
  =========================================== */

  .route-box {

    margin-top: 9px;

    min-height: 78px;

    padding: 10px 12px;

    border-radius: 14px;

    background:
      linear-gradient(
        135deg,
        #e8f2e8,
        #e4efe9
      );

    display: grid;

    grid-template-columns:
      54px minmax(0, 1fr) auto;

    align-items: center;

    gap: 11px;

  }


  .route-symbol {

    width: 50px;

    height: 50px;

    display: grid;

    place-items: center;

    font-size: 30px;

  }


  .route-copy {

    min-width: 0;

  }


  .route-copy h3 {

    margin: 0 0 3px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color: var(--hub-forest);

    font-size: 17px;

    line-height: 1.05;

  }


  .route-copy p {

    margin: 0;

    color: #607275;

    font-size: 9.5px;

    line-height: 1.35;

  }


  .route-button {

    min-height: 40px;

    padding: 0 13px;

    border-radius: 9px;

    background: var(--hub-green);

    color: #ffffff;

    font-size: 10px;

    font-weight: 900;

    text-decoration: none;

    white-space: nowrap;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    box-shadow:
      0 5px 12px
      rgba(20, 98, 77, 0.14);

  }


  .route-button:hover {

    background: var(--hub-forest);

  }


  /* ==========================================
     LATEST FROM ONOCRA
  =========================================== */

  .latest-panel {

    display: flex;

    flex-direction: column;

  }


  .latest-heading-row {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 12px;

  }


  .latest-view-all {

    flex: 0 0 auto;

    margin-top: 5px;

    color: var(--hub-blue);

    font-size: 10px;

    font-weight: 900;

    text-decoration: none;

    white-space: nowrap;

  }


  .latest-placeholder {

    flex: 1;

    min-height: 275px;

    margin-top: 13px;

    padding: 24px;

    border:
      1px solid
      rgba(18, 105, 176, 0.10);

    border-radius: 14px;

    background:
      radial-gradient(
        circle at 50% 35%,
        rgba(18, 105, 176, 0.06),
        transparent 30%
      ),
      linear-gradient(
        145deg,
        #f4fbff,
        #eef8fc
      );

    text-align: center;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

  }


  .latest-star {

    margin-bottom: 13px;

    color: var(--hub-blue);

    font-size: 25px;

  }


  .latest-placeholder h3 {

    margin: 0 0 7px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color: #17334a;

    font-size: 21px;

    line-height: 1.1;

  }


  .latest-placeholder p {

    max-width: 320px;

    margin: 0;

    color: #687779;

    font-size: 11px;

    line-height: 1.45;

  }


  /* ==========================================
     DARK THEME
  =========================================== */

  :global(html[data-theme="dark"])
  .internet-hub {

    --hub-forest: #f4f1e9;
    --hub-green: #62d2ad;
    --hub-ink: #e8edf1;

    color: #e8edf1;

  }


  :global(html[data-theme="dark"])
  .top-ad,

  :global(html[data-theme="dark"])
  .mid-ad,

  :global(html[data-theme="dark"])
  .bottom-ad {

    border-color: #46515e;

    background: #202833;

  }


  :global(html[data-theme="dark"])
  .internet-hero {

    border-color: #3a4653;

    background:
      radial-gradient(
        circle at 85% 18%,
