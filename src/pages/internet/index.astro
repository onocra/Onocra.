  }


  /* ==========================================
     CONNECTION CATEGORIES
  =========================================== */

  .connection-section {

    padding:
      48px 0 44px;

  }


  .connection-section > h2 {

    margin:
      0 0 20px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    color:
      var(--hub-forest);

    font-size: 31px;

    line-height: 1.1;

  }


  .connection-grid {

    display: grid;

    grid-template-columns:
