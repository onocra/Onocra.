  const englishCaveat = caveat ? caveat.textContent : '';
  const germanCaveat = deCopy[trim(englishCaveat || '')] || '';
  function setLang(lang) {
    const german = lang === 'de';
    allText.forEach(({node,en,key}) => {
      const match = en.match(/^(\s*)([\s\S]*?)(\s*)$/);
      node.nodeValue = german && match ? match[1] + deCopy[key] + match[3] : en;
    });
    attrNodes.forEach(([selector,att,en,de]) => {const el=document.querySelector(selector);if(el)el.setAttribute(att,german?de:en);});
    // Quick Help headings are also overwritten by the pre-existing tab click handler.
    const active = document.querySelector('.quick-tab.is-active');
    const tabName = active && active.dataset.category === 'wifi' ? 'wifi' : 'internet';
    const quickHeading = document.getElementById('quick-category-heading');
    const quickCount = document.getElementById('quick-results-count');
    if (quickHeading) quickHeading.textContent = german ? (tabName==='wifi'?'Fragen zum WLAN':'Fragen zum Internetanschluss') : (tabName==='wifi'?'Wi-Fi questions':'Internet questions');
    if (quickCount) quickCount.textContent = german ? '8 Fragen' : '8 questions';
    if (caveat) caveat.textContent = german ? germanCaveat : englishCaveat;
    choices.forEach(btn => {const selected=btn.dataset.netLanguage===lang;btn.classList.toggle('is-current',selected);btn.setAttribute('aria-pressed',String(selected));});
    document.documentElement.dataset.internetPreviewLang = lang;
    if (scope) scope.lang = lang;
    ['.ph-hub-header','.ph-sidebar'].forEach(selector => {const element=document.querySelector(selector);if(element)element.lang=lang;});
    // Other pages, linked guides and search remain English; this is a demo only.
  }
  document.querySelectorAll('.reviews-bp10 .bp10-journey-card[href^="/internet/reviews/"]').forEach(link=>{
    link.addEventListener('click',()=>{
      const url = new URL(link.href, location.origin);
      if (document.documentElement.dataset.internetPreviewLang==='de') url.searchParams.set('lang','de');
      else url.searchParams.delete('lang');
      link.href = url.pathname + url.search;
    });
  });
  // Display a typographic fallback until the artwork is actually uploaded.
  document.querySelectorAll('[data-net53-art]').forEach(wrapper=>{
    const img = wrapper.querySelector('img');
    if (!img) return;
    const show = () => { if (img.naturalWidth > 0) wrapper.classList.add('is-ready'); };
    img.addEventListener('load',show);
    img.addEventListener('error',()=>wrapper.classList.remove('is-ready'));
    if (img.complete) show();
  });
  choices.forEach(btn=>btn.addEventListener('click',()=>setLang(btn.dataset.netLanguage==='de'?'de':'en')));
  document.querySelectorAll('.quick-tab').forEach(tab=>tab.addEventListener('click',()=>{
    if(document.documentElement.dataset.internetPreviewLang==='de'){
      const heading=document.getElementById('quick-category-heading');
      const count=document.getElementById('quick-results-count');
      if(heading)heading.textContent=tab.dataset.category==='wifi'?'Fragen zum WLAN':'Fragen zum Internetanschluss';
      if(count)count.textContent='8 Fragen';
    }
  }));
  setLang(new URLSearchParams(window.location.search).get('lang') === 'de' ? 'de' : 'en');
})();
</script>

