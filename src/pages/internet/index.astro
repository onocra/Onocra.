  const roots = [document.querySelector('.internet-hub'), document.querySelector('.ph-hub-header'), document.querySelector('.ph-sidebar')].filter(Boolean);
  const allText = [];
  const trim = value => value.trim();
  roots.forEach(root => {
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    while (walker.nextNode()) {
      const node = walker.currentNode;
      if (!node.parentElement || node.parentElement.closest('script,style,svg,noscript,textarea')) continue;
      const en = node.nodeValue || '';
      const key = trim(en);
      if (key && Object.prototype.hasOwnProperty.call(deCopy,key)) allText.push({node,en,key});
    }
  });
  const attrNodes = [
    ['#phones-search','placeholder','Ask about internet or Wi-Fi...','Frage zu Internet oder WLAN eingeben ...'],
    ['#phones-loop-email','placeholder','Your email address','Ihre E-Mail-Adresse'],
    ['#phones-feedback-comment','placeholder','Which question should ONOCRA cover next?','Welches Thema soll ONOCRA als Nächstes behandeln?']
  ];
