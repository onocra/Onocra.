  {title:'Decode',summary:'Understand broadband and Wi-Fi',links:[{title:'Wi-Fi 7 explained',href:'#wifi7'},{title:'Guides and learning',href:'#guides-heading'}]},
  {title:'Compare',summary:'Evaluate real differences',links:[{title:'Reviews & Comparisons',href:'#reviews'},{title:'Evaluation approach',href:'#onocra-evaluation'}]},
