            class="popular-icon"
            aria-hidden="true"
          >
            🛒
          </div>

          <div class="popular-card-copy">

            <span class="journey-badge">
              CHOOSE
            </span>

            <h3>
              Do I need a new router or mesh system?
            </h3>

            <p>
              Work out whether better equipment
              would really improve your home network.
            </p>

          </div>

          <span
            class="card-arrow"
            aria-hidden="true"
          >
            →
          </span>

        </a>


        <!-- FIX: NO INTERNET -->

        <a
          class="popular-card popular-fix"
          href="/search/?q=Connected%20to%20Wi-Fi%20but%20no%20internet"
        >

          <div
            class="popular-icon"
            aria-hidden="true"
          >
            !
          </div>

          <div class="popular-card-copy">

            <span class="journey-badge">
              FIX
            </span>

            <h3>
              Connected to Wi-Fi but no internet
            </h3>

            <p>
              See whether the problem is your
              device, router, connection or provider.
            </p>

          </div>

          <span
            class="card-arrow"
            aria-hidden="true"
          >
            →
          </span>

        </a>


        <!-- DIGITAL SAFETY -->

        <a
          class="popular-card popular-safety"
          href="/search/?q=How%20do%20I%20know%20if%20someone%20is%20using%20or%20hacking%20my%20Wi-Fi"
        >

          <div
            class="popular-icon"
            aria-hidden="true"
          >
            🛡
          </div>

          <div class="popular-card-copy">

            <span class="journey-badge">
              DIGITAL SAFETY
            </span>

            <h3>
              Is someone using or hacking my Wi-Fi?
            </h3>

            <p>
              Learn the warning signs and the
              first steps for securing your home network.
            </p>

          </div>

          <span
            class="card-arrow"
            aria-hidden="true"
          >
            →
          </span>

        </a>


        <!-- DIGITAL PARENTING -->

        <a
          class="popular-card popular-parenting"
          href="/search/?q=How%20can%20I%20control%20my%20child%27s%20internet%20access%20and%20screen%20time"
        >

          <div
            class="popular-icon"
            aria-hidden="true"
          >
            ♡
          </div>

          <div class="popular-card-copy">

            <span class="journey-badge">
              DIGITAL PARENTING
            </span>

            <h3>
              How can I manage my child’s internet access?
            </h3>

            <p>
              Explore screen-time controls, schedules
              and safer family internet settings.
            </p>

          </div>

          <span
            class="card-arrow"
            aria-hidden="true"
          >
            →
          </span>

        </a>

      </div>

    </section>

  </main>

</Layout>


<script>

  /* ==========================================
     MICROPHONE
  =========================================== */

  const micButton =
    document.querySelector(
      "#internet-mic"
    );

  const searchInput =
    document.querySelector(
      "#internet-search"
    );

  const imageInput =
    document.querySelector(
      "#internet-image"
    );

  const imageName =
    document.querySelector(
      "#internet-image-name"
    );


  interface SpeechRecognitionResultEventLike {
    results: {
      [index: number]: {
        [index: number]: {
          transcript: string;
        };
      };
    };
  }


  interface SpeechRecognitionLike {
    lang: string;

    interimResults: boolean;

    maxAlternatives: number;

    start: () => void;

    onresult:
      | ((
          event:
            SpeechRecognitionResultEventLike
        ) => void)
      | null;
  }


  interface SpeechRecognitionConstructor {
    new (): SpeechRecognitionLike;
  }


  interface SpeechRecognitionWindow
    extends Window {

    SpeechRecognition?:
      SpeechRecognitionConstructor;

    webkitSpeechRecognition?:
      SpeechRecognitionConstructor;
  }


  if (
    micButton instanceof
      HTMLButtonElement &&
    searchInput instanceof
      HTMLInputElement
  ) {

    micButton.addEventListener(
      "click",
      () => {

        const speechWindow =
          window as
            SpeechRecognitionWindow;

        const Recognition =
          speechWindow.SpeechRecognition ??
          speechWindow
            .webkitSpeechRecognition;


        if (!Recognition) {

          searchInput.placeholder =
            "Voice input is not supported by this browser.";

          return;
        }


        const recognition =
          new Recognition();


        recognition.lang =
          "en-US";

        recognition.interimResults =
          false;

        recognition.maxAlternatives =
          1;


        recognition.onresult =
          event => {

            const transcript =
              event
                .results[0][0]
                .transcript;

            searchInput.value =
              transcript;

            searchInput.focus();
          };


        recognition.start();

      }
    );

  }


  /* ==========================================
     IMAGE SELECTION
  =========================================== */

  if (
    imageInput instanceof
      HTMLInputElement &&
    imageName instanceof
      HTMLElement
  ) {

    imageInput.addEventListener(
      "change",
      () => {

        const file =
          imageInput.files?.[0];

        imageName.textContent =
          file
            ? `Selected image: ${file.name}`
            : "";

      }
    );

  }

</script>


<style>

  /* ==========================================
     HUB
  =========================================== */

  .internet-hub {

    --hub-forest: #073d32;
    --hub-green: #14624d;
    --hub-orange: #f56622;
    --hub-blue: #1269b0;
    --hub-ink: #17334a;
    --hub-cream: #f8eedc;
    --hub-sage: #e6efe5;

    width:
      min(100% - 32px, 1240px);

    margin:
      0 auto;

    padding:
      20px 0 72px;

    color:
      var(--hub-ink);

  }


  /* ==========================================
     ADVERTISEMENT
  =========================================== */

  .top-ad {

    min-height: 104px;

    margin-bottom: 24px;

    border:
      1px dashed
      #c9c1b4;

    border-radius: 18px;

    background:
      radial-gradient(
        circle at 15% 30%,
        rgba(18, 105, 176, 0.06),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #fbf3e6,
        #f7eddd
      );

    display: flex;

    align-items: center;

    justify-content: center;

  }


  .top-ad span {

    color: #7c817f;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.18em;

  }


  /* ==========================================
     HERO
  =========================================== */

  .internet-hero {

    min-height: 410px;

    padding:
      42px 48px;

    border:
      1px solid
      rgba(7, 61, 50, 0.12);

    border-radius: 28px;

    background:
      radial-gradient(
        circle at 86% 20%,
        rgba(18, 105, 176, 0.13),
        transparent 31%
      ),
      radial-gradient(
        circle at 10% 90%,
        rgba(20, 98, 77, 0.08),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #fffaf1 0%,
        #edf6f1 100%
      );

    display: grid;

    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(360px, 0.95fr);

    align-items: center;

    gap: 30px;

    overflow: hidden;

  }


  .eyebrow {

    margin:
      0 0 9px;

    color:
      var(--hub-orange);

    font-size: 12px;

    font-weight: 800;

    letter-spacing: 0.16em;

  }


  .hero-copy h1 {

    max-width: 660px;

    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(46px, 5vw, 72px);

    line-height: 0.98;

    letter-spacing: -0.045em;

    color:
      var(--hub-forest);

  }


  .hero-subtitle {

    margin:
      17px 0 18px;

    color:
      var(--hub-green);

    font-size: 17px;

    font-weight: 700;

  }


  .topic-row {

    max-width: 620px;

    margin-bottom: 20px;

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

  }


  .topic-row span {

    padding:
      6px 10px;

    border:
      1px solid
      rgba(7, 61, 50, 0.13);

    border-radius: 999px;

    background:
      rgba(255, 255, 255, 0.72);

    color: #4c5c5b;

    font-size: 11px;

    font-weight: 700;

  }


  .hero-message {

    max-width: 590px;

    margin: 0;

    color: #455e66;

    font-size: 17px;

    line-height: 1.55;

  }


  /* ==========================================
     HERO ARTWORK
  =========================================== */

  .hero-art {

    min-width: 0;

    display: flex;

    align-items: center;

    justify-content: center;

  }


  .hero-image {

    display: block;

    width: 100%;

    max-width: 520px;

    height: auto;

    object-fit: contain;

    filter:
      drop-shadow(
        0 14px 24px
