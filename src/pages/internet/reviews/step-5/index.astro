          <p id="net76-generation-foot" class="net76-note"></p>
        </div>
      </details>
      <details class="net76-details" open>
        <summary><span class="net76-num">04</span><span data-en="Value & trade-off matrix" data-de="Nutzen- und Abwägungsmatrix">Value &amp; trade-off matrix</span><span class="net76-disclosure" aria-hidden="true">⌄</span></summary>
        <div class="net76-details-body">
