      <div class="net76-actions">
        <a id="net76-back" class="net76-back" href="/internet/reviews/step-4/" data-en="← Back to Step 4" data-de="← Zurück zu Schritt 4">← Back to Step 4</a>
        <div class="net76-actions-right">
          <button type="button" id="net76-copy" class="net76-secondary" data-en="Copy summary" data-de="Fazit kopieren">Copy summary</button>
          <button type="button" id="net76-print" class="net76-secondary" data-en="Print / save PDF" data-de="Drucken / PDF speichern">Print / save PDF</button>
          <a id="net76-restart" class="net76-primary" href="/internet/reviews/" data-en="Start a new comparison ↗" data-de="Neuen Vergleich starten ↗">Start a new comparison ↗</a>
        </div>
      </div>
      <p id="net76-copy-status" class="net76-copy-status" role="status" aria-live="polite"></p>
    </section>
  </main>
  <InternetFooter />
</Layout>

<script is:inline>
(() => {
  const params = new URLSearchParams(location.search);
  const lang = params.get('lang') === 'de' ? 'de' : 'en';
  const l = (en,de) => lang === 'de' ? de : en;
  const category = params.get('category') === 'wifi' ? 'wifi' : 'internet';
  const route = params.get('route') === 'choose' ? 'choose' : 'explore';
  const region = ['US','UK','DE'].includes(params.get('region')) ? params.get('region') : '';
  const home = ['flat','single','multi','other','unknown'].includes(params.get('home')) ? params.get('home') : '';
  const devices = ['few','some','many','unknown'].includes(params.get('devices')) ? params.get('devices') : '';
  const goals = category==='wifi' ? ['coverage','mesh','router','standards','safety','generations'] : ['types','providers','speed','reliability','upgrade','generations'];
  const goal=goals.includes(params.get('goal'))?params.get('goal'):'';
  const evidenceOptions=category==='wifi' ? ['coverage','stability','performance','security','cost','generations','balanced'] : ['speed','latency','reliability','cost','generations','availability','balanced'];
  const evidence=(params.get('evidence')||'').split(',').filter((x,i,a)=>evidenceOptions.includes(x)&&a.indexOf(x)===i).slice(0,3);
  const constraintOptions=category==='wifi' ? ['budget','no-wiring','router','walls','older-devices','family'] : ['budget','no-wiring','flexible','upload','gaming','family'];
  const constraints=(params.get('constraints')||'').split(',').filter((x,i,a)=>constraintOptions.includes(x)&&a.indexOf(x)===i);
  const technology = category==='wifi' ? ['wifi-older','wifi-5','wifi-6','wifi-6e','wifi-7','mesh','unknown'] : ['fibre','cable','dsl','fixed-wireless','satellite','none','unknown'];
  const tech=technology.includes(params.get('tech'))?params.get('tech'):'';
  const tr = obj => obj[lang==='de'?1:0];
  const goalLabels=category==='wifi'?{
    coverage:['Coverage','Abdeckung'],mesh:['Mesh systems','Mesh-Systeme'],router:['Router upgrades','Router-Upgrades'],standards:['Wi-Fi generations','WLAN-Generationen'],safety:['Home network safety','Heimnetz-Sicherheit'],generations:['Generational improvement','Generationswechsel']
  }:{types:['Connection types','Anschlussarten'],providers:['Compare providers','Anbieter vergleichen'],speed:['Suitable speed','Passende Geschwindigkeit'],reliability:['Reliability','Zuverlässigkeit'],upgrade:['Switch or upgrade','Wechsel / Upgrade'],generations:['Generational improvements','Technologiegenerationen']};
  const evidenceLabels={speed:['Speed','Tempo'],latency:['Latency','Latenz'],reliability:['Reliability','Zuverlässigkeit'],cost:['Cost','Kosten'],generations:['Generational changes','Generationen'],availability:['Availability','Verfügbarkeit'],coverage:['Coverage','Abdeckung'],stability:['Stability','Stabilität'],performance:['Performance','Leistung'],security:['Security','Sicherheit'],balanced:['Balanced overview','Ausgewogener Überblick']};
  const homeLabels={flat:['Apartment','Wohnung'],single:['Single-floor home','Haus mit einer Etage'],multi:['Multi-floor home','Mehrgeschossiges Haus'],other:['Other home type','Andere Wohnform'],unknown:['Not sure','Nicht sicher']};
  const deviceLabels={few:['1–5 devices','1–5 Geräte'],some:['6–15 devices','6–15 Geräte'],many:['16+ devices','16+ Geräte'],unknown:['Device count not sure','Gerätezahl unklar']};
  const constraintLabels={budget:['keep costs modest','Kosten begrenzen'],'no-wiring':['avoid new wiring','neue Verkabelung vermeiden'],flexible:['flexible contract','flexibler Vertrag'],upload:['large uploads','große Uploads'],gaming:['low-lag gaming','Online-Gaming'],family:['family protection','Familienschutz'],router:['keep existing router','vorhandenen Router behalten'],walls:['thick walls / multiple floors','starke Wände / mehrere Etagen'],'older-devices':['older client devices','ältere Endgeräte']};
  const catalogMarker = true;
  const internet = {
    fibre: {name:['Full fibre / FTTP','Glasfaser / FTTP'], tag:['Wired','Kabelgebunden'],
      how:['Fibre-optic connection to the premises.','Glasfaseranschluss bis zum Gebäude.'],
      strength:['Can support strong upload capacity and stable fixed connectivity when properly provisioned.','Kann bei entsprechender Versorgung hohe Upload-Kapazität und stabile Festnetzverbindungen bieten.'],
      limits:['New installation may need permission, access or building work.','Neuinstallation kann Genehmigung, Zugang oder Bauarbeiten erfordern.'],
      generation:['FTTP is an access method, not a single speed tier. Compare network generation and purchased plan.','FTTP ist eine Anschlussart, keine Geschwindigkeitsstufe. Technikgeneration und Tarif getrennt vergleichen.'],
      verify:['Premises availability, upload guarantee, installation costs, contract and router.','Verfügbarkeit vor Ort, Upload, Installation, Vertrag und Router prüfen.']},
    cable: {name:['Cable broadband / coax','Kabelinternet / Koax'],tag:['Wired','Kabelgebunden'],
      how:['Broadband delivered over a coaxial cable network, often with fibre upstream.','Internet über Koaxialkabel, häufig mit Glasfaser im vorgelagerten Netz.'],
      strength:['Uses existing cable infrastructure and may offer high downstream capacity.','Nutzt vorhandene Kabelinfrastruktur und kann hohe Download-Kapazität bieten.'],
      limits:['Upload capacity and peak-time experience depend on the network and service tier.','Upload und Stoßzeiten hängen von Netz und gebuchtem Tarif ab.'],
      generation:['DOCSIS version and upstream network design matter; not every cable plan is equivalent.','DOCSIS-Version und Netzarchitektur sind wichtig; Kabeltarife sind nicht gleichwertig.'],
      verify:['Downstream/upstream figures, any congestion disclosures, installation and terms.','Down-/Upload-Angaben, mögliche Auslastung, Installation und Vertragsbedingungen prüfen.']},
    dsl: {name:['DSL / copper broadband','DSL / Kupferinternet'],tag:['Wired','Kabelgebunden'],
      how:['Broadband over telephone copper pairs; some services use fibre partway.','Breitband über Telefonkupferadern; bei manchen Varianten reicht Glasfaser bis zur Verteilung.'],
      strength:['May be usable where newer access networks are not available.','Kann dort nutzbar sein, wo modernere Netze fehlen.'],
      limits:['Performance depends on line length, copper condition and DSL variant.','Leistung hängt von Leitungslänge, Kupferqualität und DSL-Variante ab.'],
      generation:['ADSL and VDSL are different; fibre-to-cabinet is not full fibre to the premises.','ADSL und VDSL unterscheiden sich; Glasfaser bis zum Verteiler ist keine FTTP-Leitung.'],
      verify:['Address-specific line estimate, actual upload, stability and upgrade path.','Leitungsprognose für die Adresse, Upload, Stabilität und Upgrade-Pfad prüfen.']},
    'fixed-wireless': {name:['4G / 5G fixed wireless','4G / 5G Festnetzersatz'],tag:['Wireless access','Funkanschluss'],
      how:['Home router connects to a cellular network.','Heimrouter verbindet sich über Mobilfunk.'],
      strength:['May avoid digging or laying a new fixed line.','Kann Verlegung einer neuen Festnetzleitung vermeiden.'],
      limits:['Signal, tower load, data policy and indoor placement can change performance.','Signal, Auslastung, Datentarif und Router-Standort beeinflussen die Leistung.'],
      generation:['5G capability does not guarantee 5G signal or a particular measured speed.','5G-Fähigkeit garantiert weder 5G-Empfang noch bestimmte Geschwindigkeiten.'],
      verify:['Indoor coverage, upload/latency, data limits, trial terms and antenna options.','Empfang innen, Upload/Latenz, Datenlimits, Testfrist und Antenne prüfen.']},
    satellite: {name:['Satellite internet','Satelliteninternet'],tag:['Space link','Satellitenanbindung'],
      how:['Terminal communicates through satellites; orbit and operator differ.','Endgerät funkt über Satelliten; Orbit und Anbieter unterscheiden sich.'],
      strength:['Can be an option where terrestrial service is limited.','Kann eine Option ohne gute terrestrische Versorgung sein.'],
      limits:['Clear sky view, equipment, weather and service design all matter.','Freie Sicht, Hardware, Wetter und Netzarchitektur spielen eine Rolle.'],
      generation:['LEO and geostationary services differ greatly, especially in delay; avoid treating them as equivalent.','LEO- und geostationäre Systeme unterscheiden sich deutlich, besonders bei der Latenz.'],
      verify:['Terminal cost, obstruction, expected latency, fair-use terms and total monthly cost.','Endgerätepreis, Hindernisse, Latenz, Nutzungsbedingungen und Gesamtkosten prüfen.']}
  };
  const wifi = {
    'wifi-older': {name:['Wi-Fi 4 / older','Wi-Fi 4 / älter'],tag:['Generation','Generation'],
      how:['Earlier Wi-Fi standards and device capabilities.','Frühere WLAN-Standards und Gerätefähigkeiten.'],
      strength:['Existing equipment may remain adequate for simple tasks and modest device counts.','Vorhandene Geräte können für einfache Nutzung genügen.'],
      limits:['Older radio features and vendor support may restrict reliability, security and capacity.','Ältere Funktechnik und Support können Stabilität, Sicherheit und Kapazität begrenzen.'],
      generation:['Compare actual router age, support status and devices before upgrading.','Routeralter, Support und vorhandene Geräte vor dem Upgrade prüfen.'],
      verify:['Security updates, WPA settings, coverage, client compatibility and usable speeds.','Sicherheitsupdates, WPA, Abdeckung, Gerätekompatibilität und Leistung prüfen.']},
    'wifi-5': {name:['Wi-Fi 5','Wi-Fi 5'],tag:['Generation','Generation'],
      how:['802.11ac generation, typically using 5 GHz for its principal improvements.','Generation 802.11ac; zentrale Verbesserungen meist im 5-GHz-Band.'],
      strength:['Capable for many ordinary home uses with well-placed and supported equipment.','Kann mit gut platzierten, gepflegten Geräten für viele Haushalte genügen.'],
      limits:['Crowded rooms and many clients may benefit from newer scheduling features.','Bei vielen Geräten oder hoher Auslastung können neuere Funktionen helfen.'],
      generation:['Wi-Fi 6 adds technologies designed to improve efficiency, especially with many clients.','Wi-Fi 6 ergänzt Funktionen für effizientere Nutzung, besonders bei vielen Endgeräten.'],
      verify:['Router security support, client devices, channels, placement and broadband bottleneck.','Router-Support, Endgeräte, Kanäle, Standort und Internetanschluss prüfen.']},
    'wifi-6': {name:['Wi-Fi 6','Wi-Fi 6'],tag:['Generation','Generation'],
      how:['802.11ax generation with efficiency features such as OFDMA.','Generation 802.11ax mit Effizienzfunktionen wie OFDMA.'],
      strength:['Designed to handle more simultaneous client activity efficiently.','Für effizientere gleichzeitige Nutzung vieler Geräte ausgelegt.'],
      limits:['Actual improvement requires compatible devices and good wireless conditions.','Tatsächliche Vorteile brauchen kompatible Geräte und gute Funkbedingungen.'],
      generation:['Wi-Fi 6E extends suitable Wi-Fi 6 capability into 6 GHz where locally permitted.','Wi-Fi 6E ergänzt 6 GHz, soweit regional erlaubt und von Geräten unterstützt.'],
      verify:['Certified model features, compatibility, security updates and backhaul.','Zertifizierte Funktionen, Kompatibilität, Updates und Backhaul prüfen.']},
    'wifi-6e': {name:['Wi-Fi 6E','Wi-Fi 6E'],tag:['6 GHz variant','6-GHz-Variante'],
      how:['Wi-Fi 6 technology with 6 GHz access in supported countries and devices.','Wi-Fi-6-Technik mit 6-GHz-Nutzung bei regionaler und technischer Unterstützung.'],
      strength:['More spectrum may reduce congestion near compatible clients.','Zusätzliche Frequenzen können nahe kompatiblen Geräten Auslastung mindern.'],
      limits:['6 GHz range through walls may be more limited; availability rules vary by country.','6 GHz kann durch Wände begrenzter reichen; Landesregeln unterscheiden sich.'],
      generation:['6E is not the same as Wi-Fi 7; Wi-Fi 7 can add features such as MLO on compatible devices.','6E ist nicht Wi-Fi 7; Wi-Fi 7 kann z. B. MLO bei kompatiblen Geräten bieten.'],
      verify:['Local 6-GHz rules, supported client bands, layout and equipment firmware.','Regionale 6-GHz-Regeln, Endgerätebänder, Grundriss und Firmware prüfen.']},
    'wifi-7': {name:['Wi-Fi 7','Wi-Fi 7'],tag:['Newer generation','Neuere Generation'],
      how:['802.11be generation, with features including Multi-Link Operation on suitable gear.','Generation 802.11be mit Funktionen wie Multi-Link Operation bei geeigneter Hardware.'],
      strength:['Offers new capacity and latency-management capabilities in capable networks.','Bietet neue Möglichkeiten für Kapazität und Verzögerungsmanagement.'],
      limits:['Price, certification features, client support and region-specific spectrum matter.','Preis, Zertifizierung, Endgeräte und regionale Frequenzfreigabe sind entscheidend.'],
      generation:['Benefits over 6/6E are conditional, not automatic for every household.','Vorteile gegenüber 6/6E hängen vom Einsatz ab und sind nicht automatisch.'],
      verify:['Actual MLO support, 6-GHz rules, supported clients, updates and tested performance.','MLO-Unterstützung, 6-GHz-Regeln, Endgeräte, Updates und Tests prüfen.']},
    mesh: {name:['Mesh Wi-Fi setup','Mesh-WLAN-Aufbau'],tag:['Topology, not generation','Architektur, keine Generation'],
      how:['Multiple coordinated access points provide coverage around a home.','Mehrere koordinierte WLAN-Zugangspunkte versorgen das Zuhause.'],
      strength:['Can improve practical reach when one router cannot cover multiple rooms or floors.','Kann die Reichweite verbessern, wenn ein Router nicht alle Räume/Etagen erreicht.'],
      limits:['Wireless backhaul and poor node placement can reduce useful throughput.','Funk-Backhaul und schlechte Platzierung können die Leistung mindern.'],
      generation:['A mesh system may use Wi-Fi 5, 6, 6E or 7; architecture and radio generation are separate.','Mesh kann Wi-Fi 5, 6, 6E oder 7 nutzen; Aufbau und Funkgeneration getrennt bewerten.'],
      verify:['Node count and placement, wired backhaul, interoperability, updates and household layout.','Anzahl/Standort, Kabel-Backhaul, Zusammenspiel, Updates und Grundriss prüfen.']}
  };

  const catalog=category==='wifi'?wifi:internet;
  const keys=Object.keys(catalog);
  const selected=(params.get('compare')||'').split(',').filter((x,i,a)=>keys.includes(x)&&a.indexOf(x)===i).slice(0,3);
  // Never silently claim a default shortlist is a user's choice.
  const primary = selected.includes(params.get('primary')) ? params.get('primary') : selected[0] || '';
  const complete = !!(region&&goal&&evidence.length&&selected.length>=2);
  const viewSelected=selected.length?selected:(category==='wifi'?['wifi-6','wifi-7']:['fibre','cable']);
  const mainId=primary||viewSelected[0];
  const entry=(id)=>catalog[id];
  const name=(id)=>tr(entry(id).name);
  const field=(id,key)=>tr(entry(id)[key]);
  const text=(id,s)=>{document.getElementById(id).textContent=s;};
  const urlBase = new URLSearchParams({lang,category,route});
  const upTo2=new URLSearchParams(urlBase);
  for (const k of ['region','home','homeDetails','devices','goal']) {if(params.get(k))upTo2.set(k,params.get(k).slice(0,160));}
  const upTo3=new URLSearchParams(upTo2);
  for(const k of ['tech','evidence','constraints','note'])if(params.get(k))upTo3.set(k,params.get(k).slice(0,180));
  const upTo4=new URLSearchParams(upTo3);
  if(selected.length){upTo4.set('compare',selected.join(','));upTo4.set('primary',mainId);}
  document.getElementById('net76-hub').href='/internet/?lang='+lang;
  document.getElementById('net76-reviews').href='/internet/?lang='+lang+'#reviews';
  document.getElementById('net76-one').href='/internet/reviews/?'+urlBase;
  document.getElementById('net76-two').href='/internet/reviews/step-2/?'+upTo2;
  document.getElementById('net76-three').href='/internet/reviews/step-3/?'+upTo3;
  for(const id of ['net76-four','net76-back','net76-change','net76-correct'])document.getElementById(id).href='/internet/reviews/step-4/?'+upTo4;
  document.getElementById('net76-restart').href='/internet/reviews/?'+new URLSearchParams({lang});
  document.querySelector('.net76-main').lang=lang;
  document.querySelectorAll('.net76-main [data-en][data-de]').forEach(el=>{el.textContent=el.getAttribute('data-'+lang);});
  document.getElementById('net76-warning').hidden=complete;
  text('net76-category',category==='wifi'?l('Wi-Fi & Mesh','WLAN & Mesh'):l('Home Internet','Home-Internet'));
  text('net76-route',route==='choose'?l('Help Me Choose','Bei der Auswahl helfen'):l('Explore & Compare','Entdecken & Vergleichen'));
  const regionNames={US:['United States','USA'],UK:['United Kingdom','Großbritannien'],DE:['Germany','Deutschland']};
  text('net76-country',region?tr(regionNames[region]):l('Country not supplied','Land nicht angegeben'));
  text('net76-goal',goal?tr(goalLabels[goal]):l('Goal not supplied','Ziel nicht angegeben'));
  text('net76-evidence',evidence.length?evidence.map(k=>tr(evidenceLabels[k])).join(' · '):l('Evidence not supplied','Kriterien fehlen'));
  document.getElementById('net76-art').src=category==='wifi'?'/internet/wifi-mesh.png':'/internet/home-internet.png';
  const focus=evidence.length?tr(evidenceLabels[evidence[0]]):l('real-world suitability','praktischer Eignung');
  const goalName=goal?tr(goalLabels[goal]):l('your main goal','Ihrem Hauptziel');
  const primaryName=name(mainId);
  text('net76-verdict-head',route==='choose'?l(`Consider ${primaryName} — after verifying your local needs`,`Prüfen Sie ${primaryName} — nach Abgleich mit Ihren Bedürfnissen`):l(`${primaryName}: a useful comparison starting point`,`${primaryName}: ein sinnvoller Vergleichsausgangspunkt`));
  text('net76-verdict-lead',route==='choose'
    ? l(`For ${goalName.toLowerCase()}, ${primaryName} may be worth considering. It is not a verified best buy: check ${focus.toLowerCase()} and the alternative options before deciding.`,
        `Für ${goalName.toLowerCase()} könnte ${primaryName} interessant sein. Dies ist kein bestätigter Testsieger: Prüfen Sie ${focus.toLowerCase()} und die Alternativen.`)
    : l(`Your ${primaryName} reference highlights how technology choices involve trade-offs. Use the comparison below to understand ${focus.toLowerCase()} without assuming newer always means better.`,
        `Ihre Referenz ${primaryName} zeigt die Zielkonflikte der Technik. Vergleichen Sie ${focus.toLowerCase()}, ohne anzunehmen, dass neuer stets besser ist.`));
  text('net76-strength',field(mainId,'strength'));
  text('net76-limit',field(mainId,'limits'));
  const shortlist=document.getElementById('net76-shortlist');
  viewSelected.forEach((id,i)=>{const li=document.createElement('li');const num=document.createElement('span');num.className='net76-short-num';num.textContent=String(i+1);const box=document.createElement('div');const strong=document.createElement('strong');strong.textContent=name(id)+(id===mainId?l(' · Primary reference',' · Hauptreferenz'):'');const desc=document.createElement('p');desc.textContent=field(id,'how');box.append(strong,desc);li.append(num,box);shortlist.append(li);});
  const homePart=home?tr(homeLabels[home]):l('Home type not supplied','Wohnform fehlt');
  const devicesPart=devices?tr(deviceLabels[devices]):l('Devices not supplied','Gerätezahl fehlt');
  const extra=home==='other'&&params.get('homeDetails')?` · ${params.get('homeDetails').slice(0,160)}`:'';
  const condition=constraints.map(k=>tr(constraintLabels[k])).join(', ');
  const context=[homePart+extra,devicesPart,goalName,evidence.length?evidence.map(k=>tr(evidenceLabels[k])).join(' → '):'',condition].filter(Boolean);
  text('net76-context',context.join(' · '));
  const findings=[
    l('Your first option is a reference you selected, not an ONOCRA-ranked winner.','Ihre erste Option ist Ihre eigene Referenz, kein ONOCRA-Testsieger.'),
    l(`Your aim is ${goalName.toLowerCase()}; assess this separately from headline marketing claims.`,`Ihr Ziel ist ${goalName.toLowerCase()}; trennen Sie es von Werbeversprechen.`),
    l(`Top evidence priority: ${focus}. Look for a current, attributable source.`,`Wichtigstes Kriterium: ${focus}. Achten Sie auf aktuelle, nachvollziehbare Quellen.`),
    field(mainId,'strength'),
    field(mainId,'limits'),
    field(mainId,'generation'),
    l(`Compare the alternative${viewSelected.length>2?'s':''} (${viewSelected.filter(x=>x!==mainId).map(name).join(', ')||l('not selected','nicht ausgewählt')}) against the same practical criteria.`,
      `Vergleichen Sie die Alternative(n) (${viewSelected.filter(x=>x!==mainId).map(name).join(', ')||'nicht gewählt'}) nach denselben Kriterien.`),
    category==='wifi'
      ?l('Home Wi-Fi coverage is not the same as your incoming internet speed; test the right bottleneck first.','Heim-WLAN-Abdeckung ist nicht identisch mit der Geschwindigkeit des Internetanschlusses; prüfen Sie den Engpass.')
      :l('Availability and achievable performance vary by exact address, network and purchased plan.','Verfügbarkeit und tatsächliche Leistung hängen von Adresse, Netz und Tarif ab.'),
    condition?l(`Respect your practical constraints: ${condition}.`,`Beachten Sie Ihre Einschränkungen: ${condition}.`):l('Consider installation, compatibility, support and the total cost before committing.','Prüfen Sie Installation, Kompatibilität, Support und Gesamtkosten.'),
    l('Request or consult current published evidence for the exact model or service, not its category alone.','Prüfen Sie aktuelle Quellen zum genauen Produkt oder Tarif, nicht nur zur Kategorie.')
  ];
  const findingEl=document.getElementById('net76-findings');
  findings.forEach((line,i)=>{const li=document.createElement('li');const num=document.createElement('span');num.textContent=String(i+1).padStart(2,'0');const p=document.createElement('p');p.textContent=line;li.append(num,p);findingEl.append(li);});
  text('net76-generation-intro',category==='wifi'
    ?l('Wi-Fi 4, 5, 6, 6E and 7 refer to radio generations or variants; mesh describes a topology. Improvements depend on client capability, placement, backhaul, frequency rules and load.',
       'Wi-Fi 4, 5, 6, 6E und 7 bezeichnen Funkgenerationen bzw. Varianten; Mesh ist eine Architektur. Verbesserungen hängen von Endgeräten, Aufstellung, Backhaul, Frequenzrecht und Auslastung ab.')
    :l('Fibre, cable, DSL, cellular and satellite are different access methods, not steps on a single generation ladder. Compare actual implementations and service tiers, not labels alone.',
       'Glasfaser, Kabel, DSL, Mobilfunk und Satellit sind unterschiedliche Zugangsarten, keine einheitliche Generationsleiter. Vergleichen Sie konkrete Technik und Tarife.'));
  const genList=document.getElementById('net76-generation-list');
  viewSelected.forEach(id=>{const a=document.createElement('article');const title=document.createElement('strong');title.textContent=name(id);const p=document.createElement('p');p.textContent=field(id,'generation');a.append(title,p);genList.append(a);});
  text('net76-generation-foot',category==='wifi'
    ?l('6 GHz and Wi-Fi 7 features must be supported by your country, router and clients. Mesh may use several generations and does not automatically solve poor backhaul.',
       '6 GHz und Wi-Fi-7-Funktionen müssen im Land und von Router/Endgeräten unterstützt werden. Mesh kann verschiedene Generationen nutzen und behebt schlechten Backhaul nicht automatisch.')
    :l('A fibre package is not automatically faster than every cable service, and a 5G label is not evidence of performance at your address.',
       'Ein Glasfasertarif ist nicht automatisch schneller als jedes Kabelangebot; „5G“ beweist keine Leistung an Ihrer Adresse.'));
  const matrix=document.getElementById('net76-matrix');
  const headRow=document.createElement('tr');
  [l('Comparison factor','Vergleichskriterium'),...viewSelected.map((id,i)=>`${id===mainId?l('Primary · ','Hauptoption · '):''}${name(id)}`)].forEach(t=>{const th=document.createElement('th');th.scope='col';th.textContent=t;headRow.append(th);});matrix.tHead.append(headRow);
  const matrixRows=[['how',l('What it is','Einordnung')],['strength',l('Potential value','Möglicher Nutzen')],['limits',l('Trade-off / risk','Kompromiss / Risiko')],['verify',l('Before deciding','Vor der Entscheidung')]];
  matrixRows.forEach(([key,label])=>{const row=document.createElement('tr');const th=document.createElement('th');th.scope='row';th.textContent=label;row.append(th);viewSelected.forEach(id=>{const td=document.createElement('td');td.textContent=field(id,key);row.append(td);});matrix.tBodies[0].append(row);});
  text('net76-standards',category==='wifi'
    ?l('Confirm Wi-Fi certification, supported bands, firmware/security and actual client support; certification is not a home performance test.','WLAN-Zertifizierung, Frequenzbänder, Firmware/Sicherheit und Endgeräte prüfen; eine Zertifizierung ist kein Leistungstest im Haushalt.')
    :l('Check the published access technology, technical standard and provider claims. The standard itself does not establish your address-specific result.','Verwendete Anschlusstechnik, Standard und Anbieteraussagen prüfen. Ein Standard beweist keine Leistung an Ihrer Adresse.'));
  const checkers={
    US:['FCC National Broadband Map','FCC-Breitbandkarte','https://broadbandmap.fcc.gov/home'],
    UK:['Ofcom broadband availability checker','Ofcom-Breitbandprüfung','https://checker.ofcom.org.uk/en-gb/'],
    DE:['Bundesnetzagentur Broadband Atlas','Breitbandatlas der Bundesnetzagentur','https://www.bundesnetzagentur.de/GIGA/DE/Breitbandatlas/Vollbild/start.html']
  };
  const source=checkers[region];const official=document.getElementById('net76-authority');
  if(source){official.textContent=tr(source)+' ↗'; official.href=source[2];}
  else{official.hidden=true;}
  text('net76-authority-desc',category==='wifi'
    ?l('Country broadband checkers assess incoming availability, not indoor wireless coverage. Confirm Wi-Fi performance separately.',
       'Behördliche Breitbandkarten prüfen Anschlussverfügbarkeit, nicht die WLAN-Abdeckung im Gebäude. WLAN separat prüfen.')
    :l('Check local broadband coverage, then seek a direct address-specific service quotation and contractual terms.',
       'Lokale Breitbandversorgung prüfen; danach direkt ein adressbezogenes Angebot samt Vertragsbedingungen anfordern.'));
  const steps=category==='wifi'?[
    l('Map weak-signal rooms and floors; note router position and building materials.','Räume und Etagen mit schlechtem Empfang notieren; Routerstandort und Baumaterial beachten.'),
    l('Check your current router firmware, security settings and client compatibility.','Router-Firmware, Sicherheitseinstellungen und Kompatibilität prüfen.'),
    l('Test inside the home at useful times, separating broadband faults from Wi-Fi problems.','Zu relevanten Tageszeiten im Haus prüfen, ob Internetanschluss oder WLAN das Problem ist.'),
    l('Compare exact equipment and mesh backhaul plans with independently published tests.','Konkrete Geräte und Mesh-Backhaul anhand unabhängiger Tests vergleichen.'),
    l('Verify current local price, return policy, updates and support before purchasing.','Preis, Rückgabe, Updates und Support vor dem Kauf prüfen.')
  ]:[
    l('Check service availability for your address with the official source and actual providers.','Verfügbarkeit für die Adresse bei offizieller Stelle und Anbietern prüfen.'),
    l('Obtain current plans with download and upload information, fees and contract length.','Aktuelle Tarife mit Down-/Upload, Gebühren und Laufzeit einholen.'),
    l('Check installation feasibility, line access and equipment requirements.','Installierbarkeit, Hausanschluss und Geräteanforderungen prüfen.'),
    l('Seek independent, dated service evidence; distinguish advertised from measured speeds.','Datierte unabhängige Quellen prüfen; beworbene und gemessene Geschwindigkeiten unterscheiden.'),
    l('Compare total cost, cancellation terms, reliability and support before committing.','Gesamtkosten, Kündigung, Zuverlässigkeit und Support vergleichen.')
  ];
  const stepsEl=document.getElementById('net76-next-steps');steps.forEach(t=>{const li=document.createElement('li');li.textContent=t;stepsEl.append(li);});
  const summaryLines=()=>[
    l('ONOCRA — Home Internet & Wi-Fi | Step 5 verdict','ONOCRA — Home-Internet & WLAN | Schritt 5 Fazit'),
    `${l('Country','Land')}: ${region?tr(regionNames[region]):'—'}`,
    `${l('Route','Weg')}: ${route==='choose'?l('Help Me Choose','Bei der Auswahl helfen'):l('Explore & Compare','Entdecken & Vergleichen')}`,
    `${l('Goal','Ziel')}: ${goalName}`,
    `${l('Primary reference (visitor-selected)','Hauptreferenz (vom Besucher gewählt)')}: ${primaryName}`,
    `${l('Compared','Verglichen')}: ${viewSelected.map(name).join(', ')}`,
    `${l('Evidence priorities','Kriterien')}: ${evidence.map(k=>tr(evidenceLabels[k])).join(', ')||'—'}`,
    '', l('Conditional observations','Bedingte Beobachtungen'),...findings.map((t,i)=>`${i+1}. ${t}`),
    '', l('Evidence to verify','Zu überprüfende Angaben'),...steps.map((t,i)=>`${i+1}. ${t}`),
    '', l('No current prices, tested speeds, confirmed coverage, numeric scores or ONOCRA laboratory tests are claimed.','Keine aktuellen Preise, gemessenen Geschwindigkeiten, bestätigte Abdeckung, Noten oder eigenen Labortests behauptet.')
  ].join('\n');
  const status=document.getElementById('net76-copy-status');
  document.getElementById('net76-copy').addEventListener('click',async()=>{
    const data=summaryLines();let success=false;
    try{if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(data);success=true;}}
    catch(e){}
    if(!success){const input=document.createElement('textarea');input.value=data;input.style.position='fixed';input.style.left='-10000px';document.body.append(input);input.select();try{success=document.execCommand('copy');}catch(e){}input.remove();}
    status.textContent=success?l('Summary copied to clipboard.','Fazit in die Zwischenablage kopiert.'):l('Copy is unavailable here. Use Print / save PDF instead.','Kopieren nicht möglich. Verwenden Sie Drucken / PDF speichern.');
  });
  document.getElementById('net76-print').addEventListener('click',()=>window.print());
})();
</script>

