---
import Layout from "@/layouts/Layout.astro";
import InternetHeader from "@/components/Internet/Header.astro";
import InternetFooter from "@/components/Internet/Footer.astro";
---
<Layout>
  <InternetHeader />
  <main id="main-content" class="net63-journey-main">
    <nav class="net63-crumbs" aria-label="Breadcrumb">
      <a href="/internet/" data-en="Home Internet &amp; Wi-Fi" data-de="Home-Internet &amp; WLAN">Home Internet &amp; Wi-Fi</a>
      <span aria-hidden="true">›</span>
      <a href="/internet/#reviews" data-en="Reviews &amp; Comparisons" data-de="Tests &amp; Vergleiche">Reviews &amp; Comparisons</a>
      <span aria-hidden="true">›</span>
      <strong data-en="Step 1" data-de="Schritt 1">Step 1</strong>
    </nav>

    <div class="net63-progress">
      <span class="net63-progress-active" data-en="01 · Route" data-de="01 · Weg">01 · Route</span>
      <span data-en="02 · Needs" data-de="02 · Bedarf">02 · Needs</span>
      <span data-en="03 · Evidence" data-de="03 · Quellen">03 · Evidence</span>
      <span data-en="04 · Compare" data-de="04 · Vergleichen">04 · Compare</span>
      <span data-en="05 · Verdict" data-de="05 · Fazit">05 · Verdict</span>
    </div>

    <section class="net63-step" aria-labelledby="net63-step-heading">
      <div class="net63-top-watermark" aria-hidden="true">
        <span class="net63-mesh-line net63-mesh-line-a"></span>
        <span class="net63-mesh-line net63-mesh-line-b"></span>
        <span class="net63-mesh-line net63-mesh-line-c"></span>
        <span class="net63-mesh-node net63-mesh-node-a"></span>
        <span class="net63-mesh-node net63-mesh-node-b"></span>
        <span class="net63-mesh-node net63-mesh-node-c"></span>
        <span class="net63-mesh-node net63-mesh-node-d"></span>
        <span class="net63-wifi-mark net63-wifi-mark-a"></span>
        <span class="net63-wifi-mark net63-wifi-mark-b"></span>
        <span class="net63-wifi-mark net63-wifi-mark-c"></span>
        <span class="net63-wifi-dot"></span>
      </div>
      <div class="net63-step-heading">
        <div>
          <p
            class="net63-kicker"
            data-en="ONOCRA · REVIEWS &amp; COMPARISONS"
            data-de="ONOCRA · TESTS &amp; VERGLEICHE"
          >
            ONOCRA · REVIEWS &amp; COMPARISONS
          </p>
          <h1
            id="net63-step-heading"
            data-en="Step 1 — Choose your route"
            data-de="Schritt 1 — Wählen Sie Ihren Weg"
          >
            Step 1 — Choose your route
          </h1>
          <p
            class="net63-sub"
            data-en="Start by deciding how ONOCRA should help you explore your connection."
            data-de="Wählen Sie zuerst, wie ONOCRA Ihnen bei Ihrem Anschluss helfen soll."
          >
            Start by deciding how ONOCRA should help you explore your connection.
          </p>
        </div>

        <img src="/internet/step1-pelican.png" alt="" loading="lazy" />
      </div>

      <div class="net63-category" role="group" aria-label="Connectivity category">
        <span data-en="Your category:" data-de="Ihre Kategorie:">Your category:</span>
        <button
          class="net63-category-btn"
          type="button"
          data-topic="internet"
          aria-pressed="true"
          data-en="Home Internet"
          data-de="Home-Internet"
        >
          Home Internet
        </button>
        <button
          class="net63-category-btn"
          type="button"
          data-topic="wifi"
          aria-pressed="false"
          data-en="Wi-Fi &amp; Mesh"
          data-de="WLAN &amp; Mesh"
        >
          Wi-Fi &amp; Mesh
        </button>
      </div>

      <div class="net63-routes">
        <button type="button" class="net63-route" data-route="explore" aria-pressed="false">
          <img src="/internet/internetcompare.png" alt="" loading="lazy" />
          <span>
            <strong data-en="Explore &amp; Compare" data-de="Entdecken &amp; Vergleichen">Explore &amp; Compare</strong>
            <small
              data-en="Understand connection technology, generations and meaningful differences."
              data-de="Technologien, Generationen und wichtige Unterschiede verstehen."
            >
              Understand connection technology, generations and meaningful differences.
            </small>
            <b data-en="Select this route →" data-de="Diesen Weg wählen →">Select this route →</b>
          </span>
        </button>

        <button type="button" class="net63-route" data-route="choose" aria-pressed="false">
          <img src="/internet/internetchoose.png" alt="" loading="lazy" />
          <span>
            <strong data-en="Help Me Choose" data-de="Bei der Auswahl helfen">Help Me Choose</strong>
            <small
              data-en="Focus on your home, budget, needs and practical buying trade-offs."
              data-de="Wohnung, Budget, Bedarf und Kaufentscheidungen berücksichtigen."
            >
              Focus on your home, budget, needs and practical buying trade-offs.
            </small>
            <b data-en="Select this route →" data-de="Diesen Weg wählen →">Select this route →</b>
          </span>
        </button>
      </div>

      <div class="net63-next" id="net63-next" role="status" aria-live="polite" hidden>
        <div class="net63-next-copy">
          <strong data-en="Route selected" data-de="Weg ausgewählt">Route selected</strong>
          <p
            data-en="Continue to Step 2 to describe your household needs and the kind of help you want."
            data-de="Gehen Sie weiter zu Schritt 2 und beschreiben Sie Ihren Haushalt und die gewünschte Hilfe."
          >
            Continue to Step 2 to describe your household needs and the kind of help you want.
          </p>
        </div>

        <div class="net63-next-actions">
          <a
            id="net63-step2-link"
            class="net63-primary-link"
            href="/internet/reviews/step-2/"
            data-en="Continue to Step 2 →"
            data-de="Weiter zu Schritt 2 →"
          >
            Continue to Step 2 →
          </a>
          <a
            id="net63-back-link"
            class="net63-secondary-link"
            href="/internet/#reviews"
            data-en="Back to Reviews &amp; Comparisons"
            data-de="Zurück zu Tests &amp; Vergleichen"
          >
            Back to Reviews &amp; Comparisons
          </a>
        </div>
      </div>

      <p
        class="net63-note"
        data-en="ONOCRA reviews published manufacturer information and attributed third-party research. We do not conduct laboratory tests. You can change your route later."
        data-de="ONOCRA prüft veröffentlichte Herstellerangaben und gekennzeichnete unabhängige Recherchen. Wir führen keine Labortests durch. Sie können Ihren Weg später ändern."
      >
        ONOCRA reviews published manufacturer information and attributed third-party research. We do not conduct laboratory tests. You can change your route later.
      </p>
    </section>
  </main>
  <InternetFooter />
</Layout>

<script is:inline>
(() => {
  const qp = new URLSearchParams(location.search);
  const lang = qp.get("lang") === "de" ? "de" : "en";
  let topic = qp.get("category") === "wifi" ? "wifi" : "internet";
  let selectedRoute = qp.get("route") === "choose" ? "choose" : (qp.get("route") === "explore" ? "explore" : "");

  document.querySelectorAll("[data-en][data-de]").forEach((el) => {
    el.textContent = el.getAttribute(`data-${lang}`);
  });

  const categoryBtns = document.querySelectorAll(".net63-category-btn");
  const routeBtns = document.querySelectorAll(".net63-route");
  const nextBox = document.getElementById("net63-next");
  const step2Link = document.getElementById("net63-step2-link");
  const backLink = document.getElementById("net63-back-link");
  const crumbs = document.querySelectorAll(".net63-crumbs a");

  const syncQuery = () => {
    const url = new URL(location.href);
    url.searchParams.set("lang", lang);
    url.searchParams.set("category", topic);
    if (selectedRoute) {
      url.searchParams.set("route", selectedRoute);
    } else {
      url.searchParams.delete("route");
    }
    history.replaceState(null, "", url.pathname + url.search);

    const qs = new URLSearchParams();
    qs.set("lang", lang);
    qs.set("category", topic);
    if (selectedRoute) qs.set("route", selectedRoute);

    if (step2Link) step2Link.href = `/internet/reviews/step-2/?${qs.toString()}`;
    if (backLink) backLink.href = `/internet/?lang=${lang}#reviews`;
    if (crumbs[0]) crumbs[0].href = `/internet/?lang=${lang}`;
    if (crumbs[1]) crumbs[1].href = `/internet/?lang=${lang}#reviews`;
  };

  const updateTopic = (value) => {
    topic = value;
    categoryBtns.forEach((btn) => {
      const active = btn.dataset.topic === value;
      btn.setAttribute("aria-pressed", String(active));
      btn.classList.toggle("is-active", active);
    });
    syncQuery();
  };

  const updateRoute = (value, shouldScroll = false) => {
    selectedRoute = value;
    routeBtns.forEach((btn) => {
      const active = btn.dataset.route === value;
      btn.setAttribute("aria-pressed", String(active));
      btn.classList.toggle("is-active", active);
    });
    nextBox.hidden = false;
    syncQuery();
    if (shouldScroll) nextBox.scrollIntoView({ block: "nearest", behavior: "smooth" });
  };

  categoryBtns.forEach((btn) => btn.addEventListener("click", () => updateTopic(btn.dataset.topic)));
  routeBtns.forEach((btn) => btn.addEventListener("click", () => updateRoute(btn.dataset.route, true)));

  updateTopic(topic);
  if (selectedRoute) updateRoute(selectedRoute);
  else syncQuery();

  document.querySelector("main").lang = lang;
})();
</script>

<style is:global>
.net63-journey-main {
  max-width: 1280px;
  margin: 0 auto;
  padding: 10px clamp(16px, 4vw, 42px) 42px;
  background: #fffdf6;
  color: #214236;
}
.net63-crumbs {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  font: 650 12px/1.5 var(--font-manrope), Arial, sans-serif;
  margin: 0 0 10px;
}
.net63-crumbs a { color: #216e52; text-decoration: none; }
.net63-crumbs strong { color: #7c695a; }

.net63-progress {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 4px;
  padding: 5px;
  background: #e4ece2;
  border-radius: 12px;
  margin-bottom: 10px;
}
.net63-progress span {
  padding: 10px 4px;
  text-align: center;
  font: 750 11px/1.2 var(--font-manrope), Arial, sans-serif;
  border-radius: 8px;
  color: #6b8171;
}
.net63-progress .net63-progress-active { background: #194d39; color: #fff; }

.net63-step {
  position: relative;
  overflow: hidden;
  background: #f9fff6;
  border: 1px solid #b9d9be;
  border-radius: 19px;
  padding: clamp(14px, 2.4vw, 26px);
  box-shadow: 0 5px 19px rgba(12, 68, 39, 0.06);
}
.net63-top-watermark {
  position: absolute;
  left: 18px;
  right: 18px;
  top: 14px;
  height: 210px;
  pointer-events: none;
  overflow: hidden;
  opacity: 0.74;
  background:
    radial-gradient(circle at 18% 30%, rgba(126, 192, 180, 0.10), transparent 20%),
    radial-gradient(circle at 78% 22%, rgba(125, 192, 221, 0.10), transparent 18%);
}
.net63-mesh-line {
  position: absolute;
  height: 2px;
  background: linear-gradient(90deg, rgba(101, 176, 166, 0), rgba(86, 162, 153, 0.38), rgba(101, 176, 166, 0));
  transform-origin: left center;
}
.net63-mesh-line-a { left: 22px; top: 28px; width: 42%; transform: rotate(3deg); }
.net63-mesh-line-b { left: 18%; top: 96px; width: 38%; transform: rotate(-9deg); }
.net63-mesh-line-c { left: 34%; top: 42px; width: 28%; transform: rotate(14deg); }
.net63-mesh-node {
  position: absolute;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(79, 154, 145, 0.34);
  box-shadow: 0 0 0 6px rgba(91, 170, 160, 0.10);
}
.net63-mesh-node-a { left: 60px; top: 24px; }
.net63-mesh-node-b { left: 28%; top: 34px; }
.net63-mesh-node-c { left: 23%; top: 93px; }
.net63-mesh-node-d { left: 49%; top: 62px; }
.net63-wifi-mark {
  position: absolute;
  right: 4%;
  border: 3px solid rgba(71, 149, 185, 0.24);
  border-bottom: 0;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 240px 240px 0 0;
}
.net63-wifi-mark-a { width: 220px; height: 110px; top: 4px; }
.net63-wifi-mark-b { width: 160px; height: 80px; top: 22px; right: 6.3%; }
.net63-wifi-mark-c { width: 104px; height: 52px; top: 40px; right: 8.7%; }
.net63-wifi-dot {
  position: absolute;
  right: 13.3%;
  top: 98px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: rgba(71, 149, 185, 0.28);
}
.net63-step-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220px;
  align-items: center;
  gap: 18px;
  margin-bottom: 4px;
}
.net63-step-heading img {
  width: 220px;
  height: 160px;
  object-fit: contain;
}
.net63-kicker {
  font: 800 11px/1.35 var(--font-manrope), Arial, sans-serif;
  color: #b26248;
  letter-spacing: 0.13em;
  margin: 0 0 5px;
}
.net63-step h1 {
  font: 700 clamp(30px, 3.5vw, 45px) / 1.1 Georgia, serif;
  color: #163c2f;
  margin: 0 0 8px;
}
.net63-sub {
  font: 400 15px/1.5 var(--font-manrope), Arial, sans-serif;
  color: #526a5a;
  margin: 0;
}
.net63-category {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 9px;
  padding: 10px 0 14px;
  margin: 0 0 13px;
  border-bottom: 1px solid #d8e4d9;
  font: 700 12px var(--font-manrope), Arial, sans-serif;
}
.net63-category > span { margin-right: 6px; }
.net63-category-btn {
  border: 1px solid #a6c7ae;
  background: #fffdf6;
  border-radius: 11px;
  padding: 11px 18px;
  color: #24533c;
  font: 750 12px var(--font-manrope), Arial, sans-serif;
  cursor: pointer;
}
.net63-category-btn.is-active {
  background: #174d37;
  color: #fff;
  border-color: #174d37;
}
.net63-routes {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 13px;
}
.net63-route {
  display: grid;
  grid-template-columns: 42% 58%;
  text-align: left;
  gap: 10px;
  align-items: center;
  min-width: 0;
  cursor: pointer;
  background: #fffdf5;
  border: 2px solid #cadccc;
  border-radius: 15px;
  padding: 15px;
  color: #23503d;
  transition: border-color 0.18s, background 0.18s;
}
.net63-route:hover,
.net63-route:focus-visible,
.net63-route.is-active {
  background: #eef8eb;
  border-color: #388657;
}
.net63-route img {
  width: 100%;
  height: 150px;
  object-fit: contain;
  min-width: 0;
}
.net63-route span {
  display: grid;
  gap: 7px;
  min-width: 0;
}
.net63-route strong {
  font: 700 clamp(18px, 2vw, 25px) Georgia, serif;
  color: #153f2e;
}
.net63-route small {
  font: 400 12px/1.55 var(--font-manrope), Arial, sans-serif;
  color: #62776b;
}
.net63-route b {
  font: 750 12px/1.4 var(--font-manrope), Arial, sans-serif;
  color: #1b7651;
}
.net63-next {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: #edf6e9;
  border: 1px solid #b4d9b8;
  border-radius: 13px;
  margin: 14px 0 0;
  padding: 14px 16px;
}
.net63-next[hidden] { display: none !important; }
.net63-next-copy strong {
  display: block;
  font: 700 20px Georgia, serif;
  color: #204c3b;
  margin-bottom: 4px;
}
.net63-next-copy p {
  font: 13px/1.5 var(--font-manrope), Arial, sans-serif;
  color: #52685b;
  margin: 0;
}
.net63-next-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: flex-end;
}
.net63-primary-link,
.net63-secondary-link {
  text-decoration: none;
  white-space: nowrap;
  border-radius: 999px;
  font: 750 13px var(--font-manrope), Arial, sans-serif;
  padding: 12px 16px;
}
.net63-primary-link {
  background: #1f6d4e;
  color: #fffdf6;
}
.net63-secondary-link {
  background: #fffdf6;
  border: 1px solid #b4d9b8;
  color: #226b4e;
}
.net63-note {
  font: 12px/1.5 var(--font-manrope), Arial, sans-serif;
  color: #61736a;
  margin: 14px 0 0;
}
@media (max-width: 760px) {
  .net63-top-watermark {
    left: 10px;
    right: 10px;
    top: 10px;
    height: 150px;
    opacity: 0.56;
  }
  .net63-mesh-line-b, .net63-mesh-line-c, .net63-mesh-node-d { display: none; }
  .net63-wifi-mark-a { width: 138px; height: 68px; right: 1%; }
  .net63-wifi-mark-b { width: 100px; height: 50px; top: 20px; right: 4.4%; }
  .net63-wifi-mark-c { width: 64px; height: 32px; top: 33px; right: 7.8%; }
  .net63-wifi-dot { top: 68px; right: 12%; width: 10px; height: 10px; }
  .net63-step-heading {
    grid-template-columns: 1fr 115px;
    gap: 8px;
  }
  .net63-step-heading img {
    width: 115px;
    height: 100px;
  }
  .net63-routes { grid-template-columns: 1fr; }
  .net63-next {
    flex-direction: column;
    align-items: flex-start;
  }
  .net63-next-actions { justify-content: flex-start; }
  .net63-journey-main { padding: 8px 10px 26px; }
  .net63-progress span { font-size: 9px; }
  .net63-route img { height: 120px; }
}
@media (max-width: 420px) {
  .net63-step-heading { grid-template-columns: 1fr; }
  .net63-step-heading img { display: none; }
  .net63-progress span { padding: 7px 2px; font-size: 8px; }
}
html:is(.dark, [data-theme="dark"]) .net63-journey-main {
  background: #182c24;
  color: #e8f4ea;
}
html:is(.dark, [data-theme="dark"]) .net63-step {
  background: #243b2c;
  border-color: #527957;
}
html:is(.dark, [data-theme="dark"]) .net63-step h1,
html:is(.dark, [data-theme="dark"]) .net63-route strong {
  color: #f2f7e9;
}
html:is(.dark, [data-theme="dark"]) .net63-route {
  background: #294231;
  color: #e8f4e8;
  border-color: #54775d;
}
html:is(.dark, [data-theme="dark"]) .net63-route small,
html:is(.dark, [data-theme="dark"]) .net63-sub,
html:is(.dark, [data-theme="dark"]) .net63-note,
html:is(.dark, [data-theme="dark"]) .net63-next-copy p {
  color: #cbdacd;
}
html:is(.dark, [data-theme="dark"]) .net63-category-btn {
  background: #2b4a38;
  color: #edf5e6;
}
html:is(.dark, [data-theme="dark"]) .net63-category-btn.is-active {
  background: #e8ba73;
  color: #234330;
}
html:is(.dark, [data-theme="dark"]) .net63-next {
  background: #294231;
  border-color: #54775d;
}
html:is(.dark, [data-theme="dark"]) .net63-primary-link {
  background: #e8ba73;
  color: #234330;
}
html:is(.dark, [data-theme="dark"]) .net63-secondary-link {
  background: transparent;
  border-color: #6d8d75;
  color: #e8f4ea;
}
html:is(.dark, [data-theme="dark"]) .net63-top-watermark { opacity: 0.52; }
html:is(.dark, [data-theme="dark"]) .net63-mesh-line {
  background: linear-gradient(90deg, rgba(98, 191, 174, 0), rgba(98, 191, 174, 0.42), rgba(98, 191, 174, 0));
}
html:is(.dark, [data-theme="dark"]) .net63-mesh-node {
  background: rgba(115, 205, 194, 0.34);
  box-shadow: 0 0 0 6px rgba(115, 205, 194, 0.11);
}
html:is(.dark, [data-theme="dark"]) .net63-wifi-mark {
  border-top-color: rgba(112, 188, 220, 0.30);
}
html:is(.dark, [data-theme="dark"]) .net63-wifi-dot {
  background: rgba(112, 188, 220, 0.28);
}

/* BP067: footer correction for the Internet comparison Step 1 only.
   Do not edit the shared Internet/Footer.astro component. */
html:has(.net63-journey-main) footer.onocra-brand-footer {
  min-height: 0 !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .phones-footer-inner {
  min-height: 62px !important;
  padding: 4px 12px !important;
  column-gap: 10px !important;
  row-gap: 5px !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .footer-identity {
  gap: 8px !important;
  min-width: 0 !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .footer-signature {
  width: 48px !important;
  height: 48px !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .footer-values {
  font-size: 11px !important;
  line-height: 1.2 !important;
  white-space: nowrap !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .footer-links {
  gap: 5px 11px !important;
  min-width: 0 !important;
  padding: 0 !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .footer-links a {
  font-size: 13px !important;
  line-height: 1.25 !important;
  white-space: nowrap !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .footer-socials {
  gap: 5px !important;
  padding: 0 !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .social-link {
  min-width: 20px !important;
  flex-basis: 20px !important;
  width: 20px !important;
  height: 24px !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .social-link svg {
  width: 15px !important;
  height: 15px !important;
}
html:has(.net63-journey-main) footer.onocra-brand-footer .social-x,
html:has(.net63-journey-main) footer.onocra-brand-footer .social-tiktok {
  font-size: 17px !important;
