---
/**
 * ONOCRA · Home Internet & Wi-Fi · Step 3 — Evidence · BP074
 * Target: src/pages/internet/reviews/step-3/index.astro
 * Receives Step 1: lang, category, route; Step 2: region, home, homeDetails, devices, goal.
 * Returns ALL these on Back, and forwards on Continue with:
 * tech, evidence (priority order, comma-separated), constraints (comma-separated), note.
 * User preferences are not measured test results or published evidence.
 */
import Layout from "@/layouts/Layout.astro";
import InternetHeader from "@/components/Internet/Header.astro";
import InternetFooter from "@/components/Internet/Footer.astro";
---
<Layout title="Step 3 — Evidence | Home Internet &amp; Wi-Fi | ONOCRA">
  <InternetHeader />
  <main id="main-content" class="net74-main">
    <nav class="net74-crumbs" aria-label="Breadcrumb">
      <a id="net74-hub-link" href="/internet/">Home Internet &amp; Wi-Fi</a>
      <span aria-hidden="true">›</span>
      <a id="net74-reviews-link" href="/internet/#reviews" data-en="Reviews &amp; Comparisons" data-de="Tests &amp; Vergleiche">Reviews &amp; Comparisons</a>
      <span aria-hidden="true">›</span>
      <strong data-en="Step 3" data-de="Schritt 3">Step 3</strong>
    </nav>

    <div class="net74-progress" aria-label="Review journey progress">
      <a id="net74-progress-one" class="net74-progress-done" href="/internet/reviews/" data-en="01 · Route ✓" data-de="01 · Weg ✓">01 · Route ✓</a>
      <a id="net74-progress-two" class="net74-progress-done" href="/internet/reviews/step-2/" data-en="02 · Needs ✓" data-de="02 · Bedarf ✓">02 · Needs ✓</a>
      <span class="net74-progress-current" aria-current="step" data-en="03 · Evidence" data-de="03 · Quellen">03 · Evidence</span>
      <span data-en="04 · Compare" data-de="04 · Vergleich">04 · Compare</span>
      <span data-en="05 · Verdict" data-de="05 · Fazit">05 · Verdict</span>
    </div>

    <section class="net74-panel" aria-labelledby="net74-heading">
      <div class="net74-watermark" aria-hidden="true">
        <span class="net74-watermark-arc net74-arc-1"></span><span class="net74-watermark-arc net74-arc-2"></span>
        <span class="net74-watermark-arc net74-arc-3"></span><span class="net74-watermark-dot"></span>
        <span class="net74-watermark-node net74-node-1"></span><span class="net74-watermark-node net74-node-2"></span>
        <span class="net74-watermark-node net74-node-3"></span>
      </div>
      <header class="net74-header">
        <div class="net74-header-copy">
          <p class="net74-kicker" data-en="ONOCRA · REVIEWS &amp; COMPARISONS" data-de="ONOCRA · TESTS &amp; VERGLEICHE">ONOCRA · REVIEWS &amp; COMPARISONS</p>
          <h1 id="net74-heading" data-en="Step 3 — Choose the evidence that matters" data-de="Schritt 3 — Wählen Sie die wichtigsten Kriterien">Step 3 — Choose the evidence that matters</h1>
          <p class="net74-intro" data-en="Tell us what to examine. Your choices shape the comparison, not ONOCRA’s independent assessment." data-de="Sagen Sie uns, was wichtig ist. Ihre Auswahl beeinflusst den Vergleich, nicht ONOCRAs unabhängige Bewertung.">Tell us what to examine. Your choices shape the comparison, not ONOCRA’s independent assessment.</p>
          <div class="net74-context" aria-label="Your journey">
            <span id="net74-category-badge">Home Internet</span>
            <span id="net74-route-badge">Explore &amp; Compare</span>
            <a id="net74-change-route" href="/internet/reviews/" data-en="Change route ↗" data-de="Weg ändern ↗">Change route ↗</a>
          </div>
          <div class="net74-step2-summary" aria-label="Your needs from Step 2">
            <span id="net74-region-summary">Country</span>
            <span id="net74-goal-summary" class="net74-summary-goal">Your goal</span>
          </div>
        </div>
        <div class="net74-header-art" aria-hidden="true">
          <img id="net74-category-art" src="/internet/home-internet.png" alt="" loading="lazy" />
        </div>
      </header>

      <div class="net74-intent-line">
        <span class="net74-intent-symbol" aria-hidden="true">✦</span>
        <p id="net74-intent-explore" data-en="Explore &amp; Compare: put technology differences, generations and the reliability of published research first." data-de="Entdecken &amp; Vergleichen: Technikunterschiede, Generationen und die Qualität veröffentlichter Quellen stehen im Mittelpunkt.">Explore &amp; Compare: put technology differences, generations and the reliability of published research first.</p>
        <p id="net74-intent-choose" hidden data-en="Help Me Choose: focus on suitability, realistic trade-offs and evidence to check before buying or switching." data-de="Bei der Auswahl helfen: Wir betrachten Eignung, realistische Kompromisse und wichtige Prüfungen vor Kauf oder Wechsel.">Help Me Choose: focus on suitability, realistic trade-offs and evidence to check before buying or switching.</p>
      </div>

      <div id="net74-missing-context" class="net74-warning" hidden role="alert">
        <span data-en="To continue, first select a country and main goal on Step 2." data-de="Bitte wählen Sie zuerst in Schritt 2 ein Land und ein Hauptziel.">To continue, first select a country and main goal on Step 2.</span>
        <a id="net74-correct-step-two" href="/internet/reviews/step-2/" data-en="Open Step 2 →" data-de="Schritt 2 öffnen →">Open Step 2 →</a>
      </div>

      <form id="net74-form" novalidate>
        <div class="net74-form-grid">
          <div class="net74-form-row net74-row-first">
            <fieldset class="net74-block" id="net74-tech-group">
              <legend><span class="net74-question-num">01</span> <span id="net74-tech-title" data-en="What technology do you have now?" data-de="Welche Technik nutzen Sie derzeit?">What technology do you have now?</span></legend>
              <p class="net74-field-help" data-en="Optional — a starting point, not a technical test. Not sure is perfectly fine." data-de="Optional — nur ein Ausgangspunkt, kein technischer Test. 'Nicht sicher' ist völlig in Ordnung.">Optional — a starting point, not a technical test. Not sure is perfectly fine.</p>
              <div id="net74-internet-tech" class="net74-tech-options" role="group" aria-label="Current home internet technology">
                <button type="button" class="net74-choice" data-tech="fibre" aria-pressed="false" data-en="Fibre / FTTP" data-de="Glasfaser / FTTP">Fibre / FTTP</button>
                <button type="button" class="net74-choice" data-tech="cable" aria-pressed="false" data-en="Cable / coax" data-de="Kabel / Koaxial">Cable / coax</button>
                <button type="button" class="net74-choice" data-tech="dsl" aria-pressed="false" data-en="DSL / copper" data-de="DSL / Kupfer">DSL / copper</button>
                <button type="button" class="net74-choice" data-tech="fixed-wireless" aria-pressed="false" data-en="4G / 5G home internet" data-de="4G / 5G Heim-Internet">4G / 5G home internet</button>
                <button type="button" class="net74-choice" data-tech="satellite" aria-pressed="false" data-en="Satellite" data-de="Satellit">Satellite</button>
                <button type="button" class="net74-choice" data-tech="none" aria-pressed="false" data-en="No connection yet" data-de="Noch kein Anschluss">No connection yet</button>
                <button type="button" class="net74-choice" data-tech="unknown" aria-pressed="false" data-en="Not sure" data-de="Nicht sicher">Not sure</button>
              </div>
              <div id="net74-wifi-tech" class="net74-tech-options" role="group" aria-label="Current Wi-Fi generation" hidden>
                <button type="button" class="net74-choice" data-tech="wifi-older" aria-pressed="false" data-en="Wi-Fi 4 or older" data-de="Wi-Fi 4 oder älter">Wi-Fi 4 or older</button>
                <button type="button" class="net74-choice" data-tech="wifi-5" aria-pressed="false" data-en="Wi-Fi 5" data-de="Wi-Fi 5">Wi-Fi 5</button>
                <button type="button" class="net74-choice" data-tech="wifi-6" aria-pressed="false" data-en="Wi-Fi 6" data-de="Wi-Fi 6">Wi-Fi 6</button>
                <button type="button" class="net74-choice" data-tech="wifi-6e" aria-pressed="false" data-en="Wi-Fi 6E" data-de="Wi-Fi 6E">Wi-Fi 6E</button>
                <button type="button" class="net74-choice" data-tech="wifi-7" aria-pressed="false" data-en="Wi-Fi 7" data-de="Wi-Fi 7">Wi-Fi 7</button>
                <button type="button" class="net74-choice" data-tech="mesh" aria-pressed="false" data-en="Mesh system (generation unknown)" data-de="Mesh-System (Generation unklar)">Mesh system (generation unknown)</button>
                <button type="button" class="net74-choice" data-tech="unknown" aria-pressed="false" data-en="Not sure" data-de="Nicht sicher">Not sure</button>
              </div>
            </fieldset>
            <span class="net74-step-arrow" aria-hidden="true">➜</span>
            <fieldset class="net74-block" id="net74-evidence-group">
              <legend><span class="net74-question-num">02</span> <span data-en="What should the comparison examine?" data-de="Was soll der Vergleich untersuchen?">What should the comparison examine?</span> <span class="net74-required" data-en="Choose 1–3" data-de="1–3 wählen">Choose 1–3</span></legend>
              <p class="net74-field-help" data-en="Tap up to three in priority order. Your first choice carries the most weight in personalised matching." data-de="Wählen Sie bis zu drei in der Reihenfolge ihrer Wichtigkeit. Die erste Auswahl zählt bei persönlichen Vergleichen am meisten.">Tap up to three in priority order. Your first choice carries the most weight in personalised matching.</p>
              <div id="net74-internet-priorities" class="net74-priorities" role="group" aria-label="Home Internet evidence priorities">
                <button type="button" class="net74-priority" data-evidence="speed" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Real-world speed &amp; consistency" data-de="Tatsächliche Geschwindigkeit &amp; Konstanz">Real-world speed &amp; consistency</span></button>
                <button type="button" class="net74-priority" data-evidence="latency" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Latency &amp; responsiveness" data-de="Latenz &amp; Reaktionszeit">Latency &amp; responsiveness</span></button>
                <button type="button" class="net74-priority" data-evidence="reliability" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Reliability, support &amp; outages" data-de="Zuverlässigkeit, Support &amp; Ausfälle">Reliability, support &amp; outages</span></button>
                <button type="button" class="net74-priority" data-evidence="cost" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Total contract cost &amp; terms" data-de="Gesamtkosten &amp; Vertragsbedingungen">Total contract cost &amp; terms</span></button>
                <button type="button" class="net74-priority" data-evidence="generations" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Technology generations &amp; upgrades" data-de="Technikgenerationen &amp; Fortschritte">Technology generations &amp; upgrades</span></button>
                <button type="button" class="net74-priority" data-evidence="availability" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Regional availability &amp; installation" data-de="Regionale Verfügbarkeit &amp; Installation">Regional availability &amp; installation</span></button>
              </div>
              <div id="net74-wifi-priorities" class="net74-priorities" role="group" aria-label="Wi-Fi evidence priorities" hidden>
                <button type="button" class="net74-priority" data-evidence="coverage" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Room-to-room coverage &amp; walls" data-de="Abdeckung über Räume &amp; Wände">Room-to-room coverage &amp; walls</span></button>
                <button type="button" class="net74-priority" data-evidence="stability" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Stability with many devices" data-de="Stabilität bei vielen Geräten">Stability with many devices</span></button>
                <button type="button" class="net74-priority" data-evidence="performance" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Tested speed &amp; latency" data-de="Getestete Geschwindigkeit &amp; Latenz">Tested speed &amp; latency</span></button>
                <button type="button" class="net74-priority" data-evidence="security" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Security &amp; software support" data-de="Sicherheit &amp; Software-Support">Security &amp; software support</span></button>
                <button type="button" class="net74-priority" data-evidence="cost" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Equipment price &amp; setup value" data-de="Gerätepreis &amp; Installationsnutzen">Equipment price &amp; setup value</span></button>
                <button type="button" class="net74-priority" data-evidence="generations" aria-pressed="false"><span class="net74-rank" aria-hidden="true">+</span><span data-en="Wi-Fi generations &amp; compatibility" data-de="WLAN-Generationen &amp; Kompatibilität">Wi-Fi generations &amp; compatibility</span></button>
              </div>
              <button type="button" class="net74-choice net74-balanced" data-balanced="balanced" aria-pressed="false" data-en="Balanced overview / I'm not sure" data-de="Ausgewogener Überblick / nicht sicher">Balanced overview / I'm not sure</button>
              <p class="net74-priority-counter" id="net74-counter" aria-live="polite">0 of 3 selected</p>
            </fieldset>
          </div>
          <div class="net74-turn" aria-hidden="true"><span data-en="↙ Next: constraints and additional context" data-de="↙ Weiter: Einschränkungen und weitere Angaben">↙ Next: constraints and additional context</span></div>
          <div class="net74-form-row net74-row-second">
            <fieldset class="net74-block">
              <legend><span class="net74-question-num">03</span> <span data-en="Anything we should take into account?" data-de="Was sollten wir berücksichtigen?">Anything we should take into account?</span></legend>
              <p class="net74-field-help" data-en="Optional — choose all that apply. This does not automatically disqualify any technology." data-de="Optional — Mehrfachauswahl möglich. Dadurch wird keine Technologie automatisch ausgeschlossen.">Optional — choose all that apply. This does not automatically disqualify any technology.</p>
              <div id="net74-internet-constraints" class="net74-constraints" role="group" aria-label="Home Internet constraints">
                <button type="button" class="net74-choice net74-constraint" data-constraint="budget" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Keep costs modest" data-de="Kosten niedrig halten">Keep costs modest</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="no-wiring" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Avoid new cabling" data-de="Neue Kabel vermeiden">Avoid new cabling</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="flexible" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Prefer flexible contract" data-de="Flexibler Vertrag wichtig">Prefer flexible contract</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="upload" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Video calls / large uploads" data-de="Videokonferenzen / große Uploads">Video calls / large uploads</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="gaming" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Online games / low lag" data-de="Online-Gaming / niedrige Latenz">Online games / low lag</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="family" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Family controls &amp; safety" data-de="Familienschutz &amp; Sicherheit">Family controls &amp; safety</span></button>
              </div>
              <div id="net74-wifi-constraints" class="net74-constraints" role="group" aria-label="Wi-Fi constraints" hidden>
                <button type="button" class="net74-choice net74-constraint" data-constraint="budget" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Keep costs modest" data-de="Kosten niedrig halten">Keep costs modest</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="no-wiring" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Avoid drilling or cabling" data-de="Bohren oder Kabel vermeiden">Avoid drilling or cabling</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="router" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Keep existing router" data-de="Vorhandenen Router behalten">Keep existing router</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="walls" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Thick walls / multiple floors" data-de="Dicke Wände / mehrere Etagen">Thick walls / multiple floors</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="older-devices" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Older device compatibility" data-de="Kompatibilität mit älteren Geräten">Older device compatibility</span></button>
                <button type="button" class="net74-choice net74-constraint" data-constraint="family" aria-pressed="false"><span class="net74-check" aria-hidden="true"></span><span data-en="Guest / child protection" data-de="Gastnetz / Kinderschutz">Guest / child protection</span></button>
              </div>
            </fieldset>
            <span class="net74-step-arrow" aria-hidden="true">➜</span>
            <fieldset class="net74-block">
              <legend><span class="net74-question-num">04</span> <span data-en="Any particular service or equipment?" data-de="Bestimmter Anbieter oder bestimmtes Gerät?">Any particular service or equipment?</span></legend>
              <p class="net74-field-help" id="net74-specific-help" data-en="Optional — name a provider, service or router model you want to understand." data-de="Optional — nennen Sie einen Anbieter, Dienst oder Router, den Sie prüfen möchten.">Optional — name a provider, service or router model you want to understand.</p>
              <label class="net74-note-label" for="net74-note" data-en="Short description (optional)" data-de="Kurze Beschreibung (optional)">Short description (optional)</label>
              <textarea class="net74-note" id="net74-note" rows="3" maxlength="180" placeholder="e.g. compare fibre with 5G home broadband"></textarea>
              <p class="net74-privacy" data-en="No street address, password, Wi-Fi key or account number, please." data-de="Bitte keine Adresse, Passwörter, WLAN-Schlüssel oder Kundennummer angeben.">No street address, password, Wi-Fi key or account number, please.</p>
              <div class="net74-evidence-note">
                <span aria-hidden="true">◎</span>
                <div>
                  <strong data-en="Important distinction" data-de="Wichtige Unterscheidung">Important distinction</strong>
                  <p data-en="Your description is background for a future comparison — not verified test evidence." data-de="Ihre Beschreibung ist Hintergrund für einen späteren Vergleich — kein bestätigtes Testergebnis.">Your description is background for a future comparison — not verified test evidence.</p>
                </div>
              </div>
            </fieldset>
          </div>
        </div>
        <div class="net74-bottom">
          <div class="net74-consent-note">
            <strong data-en="How ONOCRA assesses evidence" data-de="Wie ONOCRA Quellen bewertet">How ONOCRA assesses evidence</strong>
            <p data-en="We distinguish official specifications and standards, published independent measurements, and dated regional availability or prices. Unknown evidence stays unknown; ONOCRA does not run laboratory tests." data-de="Wir unterscheiden offizielle Angaben und Standards, veröffentlichte unabhängige Messungen sowie datierte regionale Verfügbarkeit und Preise. Fehlende Belege bleiben offen; ONOCRA führt keine Labortests durch.">We distinguish official specifications and standards, published independent measurements, and dated regional availability or prices. Unknown evidence stays unknown; ONOCRA does not run laboratory tests.</p>
          </div>
          <p id="net74-error" class="net74-error" role="alert" aria-live="polite" hidden data-en="Select at least one evidence priority, or choose Balanced overview." data-de="Wählen Sie mindestens ein Vergleichskriterium oder den ausgewogenen Überblick.">Select at least one evidence priority, or choose Balanced overview.</p>
          <div class="net74-actions">
            <a id="net74-back" class="net74-back" href="/internet/reviews/step-2/" data-en="← Back to Step 2" data-de="← Zurück zu Schritt 2">← Back to Step 2</a>
            <button class="net74-next" type="submit" data-en="Continue to Step 4 →" data-de="Weiter zu Schritt 4 →">Continue to Step 4 →</button>
          </div>
          <p class="net74-under-construction" data-en="Step 4 — Compare is the next stage. Your Step 1–3 choices will be carried forward, but Step 4 must be installed before the link works." data-de="Schritt 4 — Vergleichen folgt als Nächstes. Ihre Auswahl aus Schritt 1–3 wird übernommen; Schritt 4 muss dafür noch erstellt werden.">Step 4 — Compare is the next stage. Your Step 1–3 choices will be carried forward, but Step 4 must be installed before the link works.</p>
        </div>
      </form>
    </section>
  </main>
  <InternetFooter />
</Layout>

<script is:inline>
(() => {
  const query = new URLSearchParams(location.search);
  const lang = query.get("lang") === "de" ? "de" : "en";
  const category = query.get("category") === "wifi" ? "wifi" : "internet";
  const route = query.get("route") === "choose" ? "choose" : "explore";
  const selectedTech = category === "wifi"
    ? ["wifi-older","wifi-5","wifi-6","wifi-6e","wifi-7","mesh","unknown"]
    : ["fibre","cable","dsl","fixed-wireless","satellite","none","unknown"];
  const allowedEvidence = category === "wifi"
    ? ["coverage","stability","performance","security","cost","generations","balanced"]
    : ["speed","latency","reliability","cost","generations","availability","balanced"];
  const allowedConstraints = category === "wifi"
    ? ["budget","no-wiring","router","walls","older-devices","family"]
    : ["budget","no-wiring","flexible","upload","gaming","family"];
  const region = ["US","UK","DE"].includes(query.get("region")) ? query.get("region") : "";
  const goalAllowed = category === "wifi"
    ? ["coverage","mesh","router","standards","safety"]
    : ["types","providers","speed","reliability","upgrade","generations"];
  const goal = goalAllowed.includes(query.get("goal")) ? query.get("goal") : "";
  const home = ["flat","single","multi","other","unknown"].includes(query.get("home")) ? query.get("home") : "";
  const devices = ["few","some","many","unknown"].includes(query.get("devices")) ? query.get("devices") : "";
  const homeDetails = home === "other" ? (query.get("homeDetails") || "").slice(0,160) : "";
  const previous = new URLSearchParams({ lang, category, route });
  if (region) previous.set("region",region);
  if (home) previous.set("home",home);
  if (devices) previous.set("devices",devices);
  if (goal) previous.set("goal",goal);
  if (homeDetails) previous.set("homeDetails",homeDetails);
  const stepTwoUrl = "/internet/reviews/step-2/?" + previous.toString();
  const stepOneUrl = "/internet/reviews/?" + new URLSearchParams({ lang, category, route }).toString();
  for (const id of ["net74-back","net74-progress-two","net74-correct-step-two"]) {
    document.getElementById(id).href = stepTwoUrl;
  }
  for (const id of ["net74-progress-one","net74-change-route"]) {
    document.getElementById(id).href = stepOneUrl;
  }
  document.getElementById("net74-hub-link").href = "/internet/?lang=" + lang;
  document.getElementById("net74-reviews-link").href = "/internet/?lang=" + lang + "#reviews";
  document.querySelector(".net74-main").lang = lang;
  document.querySelectorAll("[data-en][data-de]").forEach((element) => {
    element.textContent = element.getAttribute("data-" + lang);
  });

  document.getElementById("net74-category-badge").textContent = category === "wifi"
    ? (lang === "de" ? "WLAN & Mesh" : "Wi-Fi & Mesh")
    : (lang === "de" ? "Home-Internet" : "Home Internet");
  document.getElementById("net74-route-badge").textContent = route === "choose"
    ? (lang === "de" ? "Bei der Auswahl helfen" : "Help Me Choose")
    : (lang === "de" ? "Entdecken & Vergleichen" : "Explore & Compare");
  document.getElementById("net74-category-art").src = category === "wifi"
    ? "/internet/wifi-mesh.png" : "/internet/home-internet.png";
  document.getElementById("net74-intent-choose").hidden = route !== "choose";
  document.getElementById("net74-intent-explore").hidden = route !== "explore";
  document.getElementById("net74-internet-tech").hidden = category === "wifi";
  document.getElementById("net74-wifi-tech").hidden = category !== "wifi";
  document.getElementById("net74-internet-priorities").hidden = category === "wifi";
  document.getElementById("net74-wifi-priorities").hidden = category !== "wifi";
  document.getElementById("net74-internet-constraints").hidden = category === "wifi";
  document.getElementById("net74-wifi-constraints").hidden = category !== "wifi";
  document.getElementById("net74-tech-title").textContent = category === "wifi"
    ? (lang === "de" ? "Welche WLAN-Technik haben Sie jetzt?" : "What Wi-Fi technology do you have now?")
    : (lang === "de" ? "Welche Internet-Technik haben Sie jetzt?" : "What connection technology do you have now?");
  document.getElementById("net74-specific-help").textContent = category === "wifi"
    ? (lang === "de" ? "Optional — nennen Sie Router, Mesh-Modell oder einen Standard." : "Optional — name a router, mesh model or Wi-Fi standard you want to explore.")
    : (lang === "de" ? "Optional — nennen Sie einen Anbieter, Tarif oder Verbindungstyp." : "Optional — name a provider, service plan or connection type to explore.");
  document.getElementById("net74-note").placeholder = category === "wifi"
    ? (lang === "de" ? "z. B. Router und Mesh für ein zweistöckiges Haus" : "e.g. compare a router and mesh for a two-floor home")
    : (lang === "de" ? "z. B. Glasfaser mit 5G-Heim-Internet vergleichen" : "e.g. compare fibre with 5G home internet");
  const countryLabels = { US: lang === "de" ? "USA" : "United States", UK: lang === "de" ? "Großbritannien" : "United Kingdom", DE: lang === "de" ? "Deutschland" : "Germany" };
  document.getElementById("net74-region-summary").textContent = region
    ? countryLabels[region] : (lang === "de" ? "Land fehlt" : "Country not selected");
  const internetGoals = {
    types:["Understand connection types","Anschlussarten verstehen"],
    providers:["Compare providers","Anbieter vergleichen"],
    speed:["Choose suitable speed","Passende Geschwindigkeit"],
    reliability:["Connection reliability","Zuverlässigkeit"],
    upgrade:["Switch or upgrade","Wechsel oder Upgrade"],
    generations:["Generational improvements","Technologiegenerationen"]
  };
  const wifiGoals = {
    coverage:["Wi-Fi coverage","WLAN-Abdeckung"],
    mesh:["Mesh systems","Mesh-Systeme"],
    router:["Router upgrade","Router-Upgrade"],
    standards:["Wi-Fi generations","WLAN-Generationen"],
    safety:["Family network safety","Heimnetz-Sicherheit"]
  };
  const goalText = (category === "wifi" ? wifiGoals : internetGoals)[goal];
  document.getElementById("net74-goal-summary").textContent = goalText
    ? goalText[lang === "de" ? 1 : 0] : (lang === "de" ? "Ziel fehlt" : "Goal not selected");
  document.getElementById("net74-missing-context").hidden = !!(region && goal);

  let tech = selectedTech.includes(query.get("tech")) ? query.get("tech") : "";
  let evidence = (query.get("evidence") || "").split(",")
    .filter((value,index,array) => allowedEvidence.includes(value) && array.indexOf(value) === index).slice(0,3);
  if (evidence.includes("balanced")) evidence = ["balanced"];
  let constraints = (query.get("constraints") || "").split(",")
    .filter((value,index,array) => allowedConstraints.includes(value) && array.indexOf(value) === index);
  const note = document.getElementById("net74-note");
  note.value = (query.get("note") || "").slice(0,180);
  const activeSelector = category === "wifi" ? "#net74-wifi-priorities" : "#net74-internet-priorities";
  const currentPriorities = [...document.querySelectorAll(activeSelector + " [data-evidence]")];
  const balancedButton = document.querySelector("[data-balanced]");
  const error = document.getElementById("net74-error");
  const paint = () => {
    document.querySelectorAll("[data-tech]").forEach((button) => {
      const yes = !button.closest("[hidden]") && button.dataset.tech === tech;
      button.classList.toggle("is-selected", yes);
      button.setAttribute("aria-pressed", String(yes));
    });
    currentPriorities.forEach((button) => {
      const index = evidence.indexOf(button.dataset.evidence);
      const selected = index >= 0;
      button.classList.toggle("is-selected", selected);
      button.setAttribute("aria-pressed", String(selected));
      button.querySelector(".net74-rank").textContent = selected ? String(index + 1) : "+";
    });
    const balanced = evidence.includes("balanced");
    balancedButton.classList.toggle("is-selected", balanced);
    balancedButton.setAttribute("aria-pressed", String(balanced));
    document.querySelectorAll("[data-constraint]").forEach((button) => {
      const yes = !button.closest("[hidden]") && constraints.includes(button.dataset.constraint);
      button.classList.toggle("is-selected", yes);
      button.setAttribute("aria-pressed", String(yes));
      button.querySelector(".net74-check").textContent = yes ? "✓" : "";
    });
    const count = evidence.includes("balanced") ? 1 : evidence.length;
    document.getElementById("net74-counter").textContent = lang === "de"
      ? (balanced ? "Ausgewogener Überblick gewählt" : `${count} von 3 Kriterien ausgewählt`)
      : (balanced ? "Balanced overview selected" : `${count} of 3 selected`);
    if (evidence.length) {
      error.hidden = true;
      document.getElementById("net74-evidence-group").classList.remove("net74-invalid");
    }
  };
  document.querySelectorAll("[data-tech]").forEach((button) => {
    button.addEventListener("click", () => { tech = button.dataset.tech === tech ? "" : button.dataset.tech; paint(); });
  });
  currentPriorities.forEach((button) => {
    button.addEventListener("click", () => {
      const value = button.dataset.evidence;
      if (evidence.includes(value)) evidence = evidence.filter((entry) => entry !== value);
      else if (evidence.length < 3 || evidence.includes("balanced")) {
        if (evidence.includes("balanced")) evidence = [];
        evidence.push(value);
      } else {
        document.getElementById("net74-counter").textContent = lang === "de"
          ? "Maximal 3: Wählen Sie eine Auswahl ab, um eine andere hinzuzufügen."
          : "Maximum 3: deselect one to add another.";
        return;
      }
      paint();
    });
  });
  balancedButton.addEventListener("click", () => { evidence = evidence.includes("balanced") ? [] : ["balanced"]; paint(); });
  document.querySelectorAll("[data-constraint]").forEach((button) => {
    button.addEventListener("click", () => {
      const value = button.dataset.constraint;
      constraints = constraints.includes(value) ? constraints.filter((entry) => entry !== value) : [...constraints,value];
      paint();
    });
  });
  paint();
  document.getElementById("net74-form").addEventListener("submit", (event) => {
    event.preventDefault();
    if (!region || !goal) {
      document.getElementById("net74-missing-context").hidden = false;
      document.getElementById("net74-missing-context").scrollIntoView({behavior:"smooth",block:"center"});
      return;
    }
    if (!evidence.length) {
      error.hidden = false;
      document.getElementById("net74-evidence-group").classList.add("net74-invalid");
      document.getElementById("net74-evidence-group").scrollIntoView({behavior:"smooth",block:"center"});
      return;
    }
    const forward = new URLSearchParams(previous);
    if (tech) forward.set("tech",tech);
    forward.set("evidence",evidence.join(","));
    if (constraints.length) forward.set("constraints",constraints.join(","));
    if (note.value.trim()) forward.set("note",note.value.trim().slice(0,180));
    location.assign("/internet/reviews/step-4/?" + forward.toString());
  });
})();
</script>

