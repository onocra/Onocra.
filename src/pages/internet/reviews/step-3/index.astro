---
/**
 * ONOCRA BP078 — Home Internet & Wi-Fi / Step 3 — Needs and priorities.
 * Install: src/pages/internet/reviews/step-3/index.astro
 * Accepts BP077 Step 2 parameters, maintains them on Back and Continue.
 * Exports compatible legacy keys (home, devices, goal, tech, evidence, constraints, note)
 * AND expanded intent keys (category=both, internetTech, wifiTech, priorities,
 * purchaseScope, equipment, budget, planStatus, securityNeeds, etc).
 * IMPORTANT: existing BP075/BP076 Step 4/5 do not handle category=both or all
 * expanded intent fields. They require integration before a complete buyer journey.
 */
import Layout from "@/layouts/Layout.astro";
import InternetHeader from "@/components/Internet/Header.astro";
import InternetFooter from "@/components/Internet/Footer.astro";
---
<Layout title="Step 3 — What matters to you | Home Internet & Wi-Fi | ONOCRA">
  <InternetHeader />
  <main class="ocn-main" id="main-content">
    <nav class="ocn-crumbs"><a id="ocn-hub" href="/internet/">Home Internet &amp; Wi-Fi</a><span>›</span><a id="ocn-reviews" href="/internet/#reviews">Reviews &amp; Comparisons</a><span>›</span><strong>Step 3</strong></nav>
    <nav class="ocn-progress" aria-label="Journey progress"><a id="ocn-step1" href="/internet/reviews/">01 · Route ✓</a><a id="ocn-step2" href="/internet/reviews/step-2/">02 · Profile ✓</a><span aria-current="step">03 · Priorities</span><span>04 · Compare</span><span>05 · Verdict</span></nav>
    <section class="ocn-panel">
      <header class="ocn-hero">
        <div>
          <p class="ocn-eyebrow" data-en="ONOCRA · PERSONALISED REVIEW JOURNEY" data-de="ONOCRA · INDIVIDUELLE KAUF- UND TECHNIKBERATUNG">ONOCRA · PERSONALISED REVIEW JOURNEY</p>
          <h1 data-en="Step 3 — What matters most to you?" data-de="Schritt 3 — Was ist Ihnen am wichtigsten?">Step 3 — What matters most to you?</h1>
          <p class="ocn-lead" data-en="A connected home is more than a broadband plan or a router. Tell us what yours needs to do." data-de="Ein vernetztes Zuhause ist mehr als ein Internetvertrag oder Router. Sagen Sie uns, worauf es ankommt.">A connected home is more than a broadband plan or a router. Tell us what yours needs to do.</p>
          <div class="ocn-pills"><span id="ocn-category">Internet + Wi-Fi</span><span id="ocn-route">Help Me Choose</span><span id="ocn-country">Country</span><span id="ocn-persona">Profile</span></div>
        </div><img src="/internet/step1-pelican.png" alt="" loading="lazy" />
      </header>
      <div class="ocn-guide"><span class="ocn-guide-symbol">✦</span><p><strong data-en="Your pelican guide" data-de="Ihr Pelikan-Begleiter">Your pelican guide</strong><span data-en="Choose up to five priorities in order. Your first tap is the most important for personal matching; safety and child-suitability remain essential, independently of scores." data-de="Wählen Sie bis zu fünf Prioritäten der Reihe nach. Die erste zählt am meisten. Sicherheit und Kindereignung bleiben grundlegende Voraussetzungen.">Choose up to five priorities in order. Your first tap is the most important for personal matching; safety and child-suitability remain essential, independently of scores.</span></p></div>
      <form id="ocn-form" novalidate>
        <div class="ocn-two">
          <fieldset class="ocn-field" id="ocn-home-block">
            <legend><span class="ocn-number">01</span><span data-en="Which home are we helping?" data-de="Welche Wohnform betrifft es?">Which home are we helping?</span></legend>
            <p class="ocn-help" data-en="Optional, to understand building layout and signal coverage." data-de="Optional, um Größe und WLAN-Abdeckung besser einzuordnen.">Optional, to understand building layout and signal coverage.</p>
            <div class="ocn-options" id="ocn-home">
              <button type="button" data-field="home" data-value="flat" aria-pressed="false" data-en="🏢 Apartment / flat" data-de="🏢 Wohnung">🏢 Apartment / flat</button>
              <button type="button" data-field="home" data-value="single" aria-pressed="false" data-en="🏠 Single-floor house" data-de="🏠 Einstöckiges Haus">🏠 Single-floor house</button>
              <button type="button" data-field="home" data-value="multi" aria-pressed="false" data-en="🏡 Multi-floor house" data-de="🏡 Mehrstöckiges Haus">🏡 Multi-floor house</button>
              <button type="button" data-field="home" data-value="other" aria-pressed="false" data-en="✏️ Other home" data-de="✏️ Andere Wohnform">✏️ Other home</button>
              <button type="button" data-field="home" data-value="unknown" aria-pressed="false" data-en="Not sure" data-de="Nicht sicher">Not sure</button>
            </div>
            <label id="ocn-home-detail-label" class="ocn-detail" for="ocn-home-details" hidden><span data-en="Describe your home (no address)" data-de="Beschreiben Sie Ihr Zuhause (ohne Adresse)">Describe your home (no address)</span><input id="ocn-home-details" maxlength="160" /></label>
          </fieldset>
          <fieldset class="ocn-field">
            <legend><span class="ocn-number">02</span><span data-en="How many devices connect?" data-de="Wie viele Geräte sind verbunden?">How many devices connect?</span></legend>
            <p class="ocn-help" data-en="Phones, televisions, computers, consoles and smart devices." data-de="Smartphones, Fernseher, PCs, Konsolen und Smart-Home-Geräte.">Phones, televisions, computers, consoles and smart devices.</p>
            <div class="ocn-options" id="ocn-devices">
              <button type="button" data-field="devices" data-value="few" aria-pressed="false" data-en="1–5 devices" data-de="1–5 Geräte">1–5 devices</button>
              <button type="button" data-field="devices" data-value="some" aria-pressed="false" data-en="6–15 devices" data-de="6–15 Geräte">6–15 devices</button>
              <button type="button" data-field="devices" data-value="many" aria-pressed="false" data-en="16+ devices" data-de="16+ Geräte">16+ devices</button>
              <button type="button" data-field="devices" data-value="unknown" aria-pressed="false" data-en="Not sure" data-de="Nicht sicher">Not sure</button>
            </div>
          </fieldset>
        </div>
        <fieldset class="ocn-field">
          <legend><span class="ocn-number">03</span><span data-en="What technology do you have now?" data-de="Welche Technik verwenden Sie heute?">What technology do you have now?</span></legend>
          <p class="ocn-help" data-en="Optional — it is fine not to know. For combined guidance, you can describe the connection and Wi-Fi separately." data-de="Optional — Sie müssen es nicht wissen. Für eine gemeinsame Beratung können Sie Anschluss und WLAN separat angeben.">Optional — it is fine not to know. For combined guidance, you can describe the connection and Wi-Fi separately.</p>
          <div class="ocn-two" id="ocn-technology">
            <div id="ocn-net-tech"><h3 data-en="Internet access" data-de="Internetanschluss">Internet access</h3><div class="ocn-options">
              <button type="button" data-field="internetTech" data-value="fibre" aria-pressed="false" data-en="Fibre / FTTP" data-de="Glasfaser / FTTP">Fibre / FTTP</button>
              <button type="button" data-field="internetTech" data-value="cable" aria-pressed="false" data-en="Cable / coax" data-de="Kabel / Koax">Cable / coax</button>
              <button type="button" data-field="internetTech" data-value="dsl" aria-pressed="false" data-en="DSL" data-de="DSL">DSL</button>
              <button type="button" data-field="internetTech" data-value="fixed-wireless" aria-pressed="false" data-en="4G / 5G fixed wireless" data-de="4G / 5G Funkinternet">4G / 5G fixed wireless</button>
              <button type="button" data-field="internetTech" data-value="satellite" aria-pressed="false" data-en="Satellite" data-de="Satellit">Satellite</button>
              <button type="button" data-field="internetTech" data-value="none" aria-pressed="false" data-en="Not installed yet" data-de="Noch nicht vorhanden">Not installed yet</button>
              <button type="button" data-field="internetTech" data-value="unknown" aria-pressed="false" data-en="Not sure" data-de="Nicht sicher">Not sure</button>
            </div></div>
            <div id="ocn-wifi-tech"><h3 data-en="Home Wi-Fi" data-de="WLAN zu Hause">Home Wi-Fi</h3><div class="ocn-options">
              <button type="button" data-field="wifiTech" data-value="wifi-older" aria-pressed="false" data-en="Wi-Fi 4 or older" data-de="Wi-Fi 4 oder älter">Wi-Fi 4 or older</button>
              <button type="button" data-field="wifiTech" data-value="wifi-5" aria-pressed="false">Wi-Fi 5</button>
              <button type="button" data-field="wifiTech" data-value="wifi-6" aria-pressed="false">Wi-Fi 6</button>
              <button type="button" data-field="wifiTech" data-value="wifi-6e" aria-pressed="false">Wi-Fi 6E</button>
              <button type="button" data-field="wifiTech" data-value="wifi-7" aria-pressed="false">Wi-Fi 7</button>
              <button type="button" data-field="wifiTech" data-value="mesh" aria-pressed="false" data-en="Mesh, generation unknown" data-de="Mesh, Generation unbekannt">Mesh, generation unknown</button>
              <button type="button" data-field="wifiTech" data-value="unknown" aria-pressed="false" data-en="Not sure" data-de="Nicht sicher">Not sure</button>
            </div></div>
          </div>
        </fieldset>
        <fieldset class="ocn-field" id="ocn-goal-group">
          <legend><span class="ocn-number">04</span><span id="ocn-goal-label">What's your main goal?</span><small data-en="Choose one" data-de="Eine Option">Choose one</small></legend>
          <p class="ocn-help" id="ocn-goal-hint"></p>
          <div class="ocn-goal-grid" id="ocn-goals"></div>
        </fieldset>
        <fieldset class="ocn-field" id="ocn-priority-group">
          <legend><span class="ocn-number">05</span><span data-en="What matters most?" data-de="Was ist Ihnen am wichtigsten?">What matters most?</span><small data-en="Rank 1–5" data-de="1–5 priorisieren">Rank 1–5</small></legend>
          <p class="ocn-help" data-en="Tap one to five priorities in importance order. Tap again to remove. Do not select five unless all five matter to you." data-de="Wählen Sie ein bis fünf Prioritäten in Reihenfolge. Erneut tippen zum Entfernen. Fünf sind nicht verpflichtend.">Tap one to five priorities in importance order. Tap again to remove. Do not select five unless all five matter to you.</p>
          <p class="ocn-family-hint" id="ocn-family-hint" hidden></p>
          <div id="ocn-priority-grid" class="ocn-priorities"></div>
          <p id="ocn-priority-count" class="ocn-count" aria-live="polite"></p>
        </fieldset>
        <div id="ocn-buyer-panel" class="ocn-buyer" hidden>
          <div class="ocn-buyer-head"><span class="ocn-number">06</span><div><h2 data-en="Your buying or switching plan" data-de="Ihr Kauf- oder Wechselplan">Your buying or switching plan</h2><p data-en="So the next step can compare the right things—not just technology names." data-de="Damit die nächsten Schritte das Richtige vergleichen, nicht nur technische Bezeichnungen.">So the next step can compare the right things—not just technology names.</p></div></div>
          <div class="ocn-two">
            <fieldset class="ocn-field"><legend data-en="What might you buy or change?" data-de="Was möchten Sie kaufen oder ändern?">What might you buy or change?</legend>
              <div class="ocn-options">
                <button type="button" data-field="purchaseScope" data-value="provider" aria-pressed="false" data-en="Internet plan / provider" data-de="Tarif / Anbieter">Internet plan / provider</button>
                <button type="button" data-field="purchaseScope" data-value="equipment" aria-pressed="false" data-en="Router / Wi-Fi equipment" data-de="Router / WLAN-Geräte">Router / Wi-Fi equipment</button>
                <button type="button" data-field="purchaseScope" data-value="both" aria-pressed="false" data-en="Both service + equipment" data-de="Anschluss und Geräte">Both service + equipment</button>
                <button type="button" data-field="purchaseScope" data-value="undecided" aria-pressed="false" data-en="Not sure yet" data-de="Noch nicht sicher">Not sure yet</button>
              </div>
            </fieldset>
            <fieldset class="ocn-field"><legend data-en="What is your current situation?" data-de="Wie ist Ihre aktuelle Situation?">What is your current situation?</legend>
              <div class="ocn-options">
                <button type="button" data-field="planStatus" data-value="new" aria-pressed="false" data-en="New connection / moving" data-de="Neuer Anschluss / Umzug">New connection / moving</button>
                <button type="button" data-field="planStatus" data-value="switch" aria-pressed="false" data-en="Switching provider" data-de="Anbieterwechsel">Switching provider</button>
                <button type="button" data-field="planStatus" data-value="upgrade" aria-pressed="false" data-en="Upgrading existing setup" data-de="Bestehendes Netz verbessern">Upgrading existing setup</button>
                <button type="button" data-field="planStatus" data-value="research" aria-pressed="false" data-en="Planning for later" data-de="Für später planen">Planning for later</button>
              </div>
            </fieldset>
          </div>
          <fieldset class="ocn-field" id="ocn-equipment-group"><legend data-en="Which equipment do you want to consider?" data-de="Welche Geräte kommen infrage?">Which equipment do you want to consider?</legend><div class="ocn-chips">
            <button type="button" data-multi="equipment" data-value="router" aria-pressed="false" data-en="Router" data-de="Router">Router</button>
            <button type="button" data-multi="equipment" data-value="modem" aria-pressed="false" data-en="Modem / gateway" data-de="Modem / Gateway">Modem / gateway</button>
            <button type="button" data-multi="equipment" data-value="mesh" aria-pressed="false">Mesh Wi-Fi</button>
            <button type="button" data-multi="equipment" data-value="extender" aria-pressed="false" data-en="Access point / extender" data-de="Access Point / Repeater">Access point / extender</button>
            <button type="button" data-multi="equipment" data-value="security" aria-pressed="false" data-en="Security / parental features" data-de="Sicherheit / Kindersicherung">Security / parental features</button>
          </div></fieldset>
          <div class="ocn-two ocn-budgets">
            <div class="ocn-budget"><label for="ocn-budget" data-en="Optional equipment budget (one-time)" data-de="Optionales Gerätebudget (einmalig)">Optional equipment budget (one-time)</label><div><span class="ocn-currency">$</span><input id="ocn-budget" inputmode="numeric" type="number" min="0" max="100000" step="1" placeholder="e.g. 250" /></div></div>
            <div class="ocn-budget"><label for="ocn-monthly" data-en="Optional broadband budget (per month)" data-de="Optionales Anschlussbudget (pro Monat)">Optional broadband budget (per month)</label><div><span class="ocn-currency">$</span><input id="ocn-monthly" inputmode="numeric" type="number" min="0" max="100000" step="1" placeholder="e.g. 50" /></div></div>
          </div>
          <fieldset class="ocn-field"><legend data-en="Contract preference" data-de="Vertragswunsch">Contract preference</legend><div class="ocn-options">
            <button type="button" data-field="contractPreference" data-value="flexible" aria-pressed="false" data-en="Monthly / flexible" data-de="Monatlich / flexibel">Monthly / flexible</button>
            <button type="button" data-field="contractPreference" data-value="fixed" aria-pressed="false" data-en="Fixed term acceptable" data-de="Laufzeit ist in Ordnung">Fixed term acceptable</button>
            <button type="button" data-field="contractPreference" data-value="undecided" aria-pressed="false" data-en="No preference yet" data-de="Noch keine Präferenz">No preference yet</button>
          </div></fieldset>
          <p class="ocn-help" data-en="Budgets are your limits, not verified offers. Provider availability and price require location-specific checks at the comparison stage." data-de="Budgets sind Ihre Grenzen, keine bestätigten Angebote. Anbieter und Preise müssen später vor Ort geprüft werden.">Budgets are your limits, not verified offers. Provider availability and price require location-specific checks at the comparison stage.</p>
        </div>
        <fieldset class="ocn-field">
          <legend><span class="ocn-number" id="ocn-last-num">07</span><span data-en="Practical constraints and safeguards" data-de="Praktische Anforderungen und Schutz">Practical constraints and safeguards</span><small data-en="Optional" data-de="Optional">Optional</small></legend>
          <div class="ocn-chips" id="ocn-constraints">
            <button type="button" data-multi="needs" data-value="budget" aria-pressed="false" data-en="Keep costs down" data-de="Kosten niedrig halten">Keep costs down</button>
            <button type="button" data-multi="needs" data-value="no-wiring" aria-pressed="false" data-en="Avoid new wiring" data-de="Keine neuen Leitungen">Avoid new wiring</button>
            <button type="button" data-multi="needs" data-value="walls" aria-pressed="false" data-en="Walls / several floors" data-de="Wände / mehrere Etagen">Walls / several floors</button>
            <button type="button" data-multi="needs" data-value="older-devices" aria-pressed="false" data-en="Older device compatibility" data-de="Ältere Geräte unterstützen">Older device compatibility</button>
            <button type="button" data-multi="needs" data-value="flexible" aria-pressed="false" data-en="Flexible contracts" data-de="Flexible Verträge">Flexible contracts</button>
            <button type="button" data-multi="needs" data-value="upload" aria-pressed="false" data-en="Video calls / upload" data-de="Videoanrufe / Upload">Video calls / upload</button>
            <button type="button" data-multi="needs" data-value="gaming" aria-pressed="false" data-en="Gaming / latency" data-de="Gaming / Latenz">Gaming / latency</button>
            <button type="button" data-multi="needs" data-value="family" aria-pressed="false" data-en="Family / child protection" data-de="Familie / Kinderschutz">Family / child protection</button>
          </div>
          <label class="ocn-note" for="ocn-note"><span data-en="Anything else? (Optional; no names or address)" data-de="Noch etwas? (Optional; keine Namen oder Adresse)">Anything else? (Optional; no names or address)</span><textarea id="ocn-note" maxlength="180" rows="2" placeholder="e.g. unreliable upstairs Wi-Fi; cannot drill walls"></textarea></label>
        </fieldset>
        <div class="ocn-next-preview" id="ocn-next-preview"><strong data-en="What happens after this?" data-de="Wie geht es weiter?">What happens after this?</strong><p id="ocn-next-copy"></p></div>
        <p class="ocn-error" id="ocn-error" hidden role="alert"></p>
        <p class="ocn-combined-warning" id="ocn-combined-warning" hidden role="status"></p>
        <div class="ocn-actions"><a id="ocn-back" href="/internet/reviews/step-2/" data-en="← Back to profile" data-de="← Zurück zum Profil">← Back to profile</a><button type="submit" data-en="Continue to Step 4 →" data-de="Weiter zu Schritt 4 →">Continue to Step 4 →</button></div>
        <p class="ocn-fine" data-en="ONOCRA analyses published information; no lab measurements, specific provider availability, product prices or provider rankings are produced by these questions. Exact local availability requires verified location-based evidence later." data-de="ONOCRA wertet veröffentlichte Informationen aus. Diese Fragen liefern keine Labormessungen, aktuellen Anbieterangebote, Preise oder Rankings. Lokale Verfügbarkeit muss später überprüft werden.">ONOCRA analyses published information; no lab measurements, specific provider availability, product prices or provider rankings are produced by these questions. Exact local availability requires verified location-based evidence later.</p>
      </form>
    </section>
  </main><InternetFooter />
</Layout>
<script is:inline>
(() => {
  const $=(s)=>document.querySelector(s), all=(s)=>Array.from(document.querySelectorAll(s));
  const q=new URLSearchParams(location.search),lang=q.get('lang')==='de'?'de':'en',tr=(en,de)=>lang==='de'?de:en;
  const list=(key,allowed,max=20)=>(q.get(key)||'').split(',').filter((x,i,a)=>allowed.includes(x)&&a.indexOf(x)===i).slice(0,max);
  const category=['internet','wifi','both'].includes(q.get('category'))?q.get('category'):'internet';
  const route=q.get('route')==='choose'?'choose':'explore';
  const region=['US','UK','DE'].includes(q.get('region'))?q.get('region'):'';
  const legacyGoalOptions={internet:['types','providers','speed','reliability','upgrade','generations'],wifi:['coverage','mesh','router','standards','safety','generations']};
  const internetTechOptions=['fibre','cable','dsl','fixed-wireless','satellite','none','unknown'];
  const wifiTechOptions=['wifi-older','wifi-5','wifi-6','wifi-6e','wifi-7','mesh','unknown'];
  const state={home:['flat','single','multi','other','unknown'].includes(q.get('home'))?q.get('home'):'',devices:['few','some','many','unknown'].includes(q.get('devices'))?q.get('devices'):'',internetTech:internetTechOptions.includes(q.get('internetTech')||q.get('tech'))?(q.get('internetTech')||q.get('tech')):'',wifiTech:wifiTechOptions.includes(q.get('wifiTech')||q.get('tech'))?(q.get('wifiTech')||q.get('tech')):'',goal:q.get('goal')||'',priorities:list('priorities',['reliability','coverage','speed','security','parenting','cost','generations','performance','contracts','compatibility','setup','support'],5),purchaseScope:['provider','equipment','both','undecided'].includes(q.get('purchaseScope'))?q.get('purchaseScope'):'',planStatus:['new','switch','upgrade','research'].includes(q.get('planStatus'))?q.get('planStatus'):'',contractPreference:['flexible','fixed','undecided'].includes(q.get('contractPreference'))?q.get('contractPreference'):'',equipment:list('equipment',['router','modem','mesh','extender','security']),needs:list('needs',['budget','no-wiring','walls','older-devices','flexible','upload','gaming','family'])};
  const base=new URLSearchParams();
  for(const key of ['lang','category','route','region','persona','intent','audience','safety']){if(q.has(key))base.set(key,q.get(key).slice(0,150));}
  base.set('lang',lang);base.set('category',category);base.set('route',route);if(region)base.set('region',region);
  const priorityMeta={
    reliability:['🛡️','Reliable connection','Zuverlässige Verbindung'],coverage:['📶','Coverage throughout the home','WLAN überall im Zuhause'],speed:['⚡','Speed & responsiveness','Geschwindigkeit & Reaktion'],security:['🔐','Network security & privacy','Netzwerksicherheit & Datenschutz'],parenting:['👨‍👩‍👧','Parental controls & safer use','Kindersicherung & sichere Nutzung'],cost:['💰','Costs & lasting value','Kosten & langfristiger Wert'],generations:['🔄','Generational improvements','Neue Technikgenerationen'],performance:['🎮','Gaming, calls & streaming','Gaming, Anrufe & Streaming'],contracts:['📑','Provider terms & availability','Verträge & Verfügbarkeit'],compatibility:['🔌','Equipment compatibility','Gerätekompatibilität'],setup:['🛠️','Ease of setup & support','Einfache Einrichtung & Hilfe'],support:['🤝','Customer support & accessibility','Kundenhilfe & Barrierefreiheit']
  };
  const goalMeta={internet:[['types','Understand fibre, cable, DSL, 5G and satellite','Glasfaser, Kabel, DSL, 5G und Satellit verstehen'],['providers','Compare providers and contract types','Anbieter und Verträge vergleichen'],['speed','Find an appropriate broadband speed','Passende Internetgeschwindigkeit finden'],['reliability','Improve connection reliability','Verbindung zuverlässiger machen'],['upgrade','Switch or upgrade broadband service','Anbieter wechseln oder Anschluss verbessern'],['generations','Explore broadband generations','Breitbandgenerationen verstehen']],wifi:[['coverage','Improve weak Wi-Fi or dead zones','Schwaches WLAN oder Funklöcher beheben'],['mesh','Compare mesh and extended coverage','Mesh-Systeme und bessere Abdeckung vergleichen'],['router','Choose or upgrade a router','Router auswählen oder ersetzen'],['standards','Compare Wi-Fi 5, 6, 6E and 7','Wi-Fi 5, 6, 6E und 7 vergleichen'],['safety','Improve network and family safety','Netzwerk- und Familiensicherheit erhöhen'],['generations','Understand Wi-Fi generations','WLAN-Generationen verstehen']],both:[['both-plan','Choose an internet plan and matching Wi-Fi equipment','Anschluss und passende WLAN-Geräte auswählen'],['both-upgrade','Improve internet speed and home coverage together','Internetzugang und WLAN-Abdeckung verbessern'],['both-safety','Set up a safe family home network','Sicheres Familiennetz einrichten'],['both-compare','Understand the entire home-network chain','Die gesamte Heimnetztechnik verstehen']]};
  $('.ocn-main').lang=lang;
  all('[data-en][data-de]').forEach(el=>el.textContent=el.dataset[lang]);
  $('#ocn-hub').href='/internet/?lang='+lang;$('#ocn-reviews').href='/internet/?lang='+lang+'#reviews';
  $('#ocn-step1').href='/internet/reviews/?'+new URLSearchParams({lang,route,category});
  $('#ocn-step2').href='/internet/reviews/step-2/?'+base;$('#ocn-back').href=$('#ocn-step2').href;
  const names={internet:tr('Home Internet','Internetanschluss'),wifi:tr('Wi-Fi & Mesh','WLAN & Mesh'),both:tr('Internet + Wi-Fi','Internet + WLAN')};
  $('#ocn-category').textContent=names[category];$('#ocn-route').textContent=route==='choose'?tr('Help Me Choose','Bei der Auswahl helfen'):tr('Explore & Compare','Entdecken & Vergleichen');
  $('#ocn-country').textContent=({US:'🇺🇸 US',UK:'🇬🇧 UK',DE:'🇩🇪 Germany'})[region]||tr('Select country in Step 2','Land in Schritt 2 wählen');
  const personaNames={household:['Household','Haushalt'],parent:['Parent / guardian','Eltern / Aufsicht'],remote:['Work / study','Arbeit / Studium'],caregiver:['Caregiver','Betreuende'],enthusiast:['Tech enthusiast','Technikfan'],professional:['Professional','Fachkraft']};
  if(personaNames[q.get('persona')])$('#ocn-persona').textContent=personaNames[q.get('persona')][lang==='de'?1:0];else $('#ocn-persona').hidden=true;
  $('#ocn-net-tech').hidden=category==='wifi';$('#ocn-wifi-tech').hidden=category==='internet';
  $('#ocn-buyer-panel').hidden=route!=='choose';$('#ocn-last-num').textContent=route==='choose'?'07':'06';
  const intent=q.get('intent')||'';
  if(route==='choose'&&!state.purchaseScope){state.purchaseScope=intent==='provider'?'provider':intent==='equipment'?'equipment':intent==='bundle'?'both':'undecided';}
  all('.ocn-currency').forEach(el=>el.textContent=region==='UK'?'£':region==='DE'?'€':'$');
  $('#ocn-home-details').value=(q.get('homeDetails')||'').slice(0,160);
  $('#ocn-budget').value=(q.get('budget')||'').slice(0,6);
  $('#ocn-monthly').value=(q.get('monthlyBudget')||'').slice(0,6);
  $('#ocn-note').value=(q.get('note')||'').slice(0,180);
  const hasFamilyPriority=(q.get('safety')||'').split(',').some(x=>['parental','screen','privacy','scams'].includes(x))||['children','teens'].includes(q.get('audience'));
  $('#ocn-family-hint').hidden=!hasFamilyPriority;
  if(hasFamilyPriority)$('#ocn-family-hint').textContent=tr('Your Step 2 profile includes family safety. Consider the security and parental-control tiles; they are not automatically ranked for you.','Ihr Profil nennt Familiensicherheit. Prüfen Sie Sicherheit und Kindersicherung — die Rangfolge legen weiterhin Sie fest.');
  const goalOptions=goalMeta[category];
  if(!goalOptions.some(row=>row[0]===state.goal))state.goal='';
  $('#ocn-goal-label').textContent=route==='choose'?tr('What decision do you need to make?','Welche Entscheidung möchten Sie treffen?'):tr('What would you like to understand or improve?','Was möchten Sie verstehen oder verbessern?');
  $('#ocn-goal-hint').textContent=route==='choose'?tr('We will first compare suitability and clarify the evidence still needed before purchase.','Zuerst prüfen wir Eignung und welche Nachweise vor dem Kauf noch nötig sind.'):tr('Explore technologies and the improvements they can actually offer.','Erkunden Sie die Technik und ihre tatsächlichen Verbesserungen.');
  const makeBtn=(id,txt)=>{const b=document.createElement('button');b.type='button';b.dataset.goal=id;b.setAttribute('aria-pressed','false');b.innerHTML='<span class="ocn-goal-dot" aria-hidden="true">↗</span><strong></strong>';b.querySelector('strong').textContent=txt;return b;};
  goalOptions.forEach(([id,en,de])=>$('#ocn-goals').append(makeBtn(id,tr(en,de))));
  Object.entries(priorityMeta).forEach(([id,[emoji,en,de]])=>{const b=document.createElement('button');b.type='button';b.className='ocn-priority';b.dataset.priority=id;b.setAttribute('aria-pressed','false');b.innerHTML='<span class="ocn-em"></span><strong></strong><span class="ocn-rank">+</span>';b.querySelector('.ocn-em').textContent=emoji;b.querySelector('strong').textContent=tr(en,de);$('#ocn-priority-grid').append(b);});
  const render=()=>{
    all('[data-field][data-value]').forEach(b=>{const on=state[b.dataset.field]===b.dataset.value;b.classList.toggle('chosen',on);b.setAttribute('aria-pressed',String(on));});
    all('[data-multi][data-value]').forEach(b=>{const on=state[b.dataset.multi].includes(b.dataset.value);b.classList.toggle('chosen',on);b.setAttribute('aria-pressed',String(on));});
    all('[data-goal]').forEach(b=>{const on=state.goal===b.dataset.goal;b.classList.toggle('chosen',on);b.setAttribute('aria-pressed',String(on));});
    all('[data-priority]').forEach(b=>{const index=state.priorities.indexOf(b.dataset.priority);b.classList.toggle('chosen',index>=0);b.setAttribute('aria-pressed',String(index>=0));b.querySelector('.ocn-rank').textContent=index>=0?String(index+1):'+';});
    $('#ocn-home-detail-label').hidden=state.home!=='other';
    $('#ocn-priority-count').textContent=tr(`${state.priorities.length} of 5 selected · in priority order`,`${state.priorities.length} von 5 gewählt · nach Wichtigkeit`);
    const help=category==='both'?tr('The next comparison must consider service quality, equipment compatibility, home coverage and total cost together.','Der nächste Vergleich muss Anschluss, Gerätekompatibilität, Abdeckung und Gesamtkosten gemeinsam betrachten.'):route==='choose'?tr('The next comparison should help narrow a shortlist, but any real provider or equipment quote still needs published, dated evidence.','Der nächste Vergleich soll die Auswahl eingrenzen. Reale Anbieterangebote brauchen datierte, nachprüfbare Quellen.'):tr('Next we can examine published technology evidence and generational trade-offs.','Als Nächstes können wir veröffentlichte Informationen und Unterschiede der Technikgenerationen prüfen.');
    $('#ocn-next-copy').textContent=help;
  };
  all('[data-field][data-value]').forEach(b=>b.addEventListener('click',()=>{state[b.dataset.field]=b.dataset.value;render();}));
  all('[data-multi][data-value]').forEach(b=>b.addEventListener('click',()=>{const arr=state[b.dataset.multi],id=b.dataset.value;state[b.dataset.multi]=arr.includes(id)?arr.filter(x=>x!==id):[...arr,id];render();}));
  all('[data-goal]').forEach(b=>b.addEventListener('click',()=>{state.goal=b.dataset.goal;render();$('#ocn-error').hidden=true;}));
  all('[data-priority]').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.priority,i=state.priorities.indexOf(id);if(i>=0){state.priorities.splice(i,1);}else if(state.priorities.length<5){state.priorities.push(id);}else{$('#ocn-error').hidden=false;$('#ocn-error').textContent=tr('Choose at most five priorities. Remove one to choose another.','Bitte maximal fünf Prioritäten auswählen. Entfernen Sie eine, um eine andere zu wählen.');return;}render();$('#ocn-error').hidden=true;}));
  const legacyEvidenceMap={internet:{reliability:'reliability',coverage:'reliability',speed:'speed',security:'reliability',parenting:'reliability',cost:'cost',generations:'generations',performance:'latency',contracts:'availability',compatibility:'balanced',setup:'balanced',support:'reliability'},wifi:{reliability:'stability',coverage:'coverage',speed:'performance',security:'security',parenting:'security',cost:'cost',generations:'generations',performance:'performance',contracts:'cost',compatibility:'balanced',setup:'balanced',support:'stability'}};
  const legacyConstraintsMap={internet:{budget:'budget','no-wiring':'no-wiring',walls:'no-wiring','older-devices':'family',flexible:'flexible',upload:'upload',gaming:'gaming',family:'family'},wifi:{budget:'budget','no-wiring':'no-wiring',walls:'walls','older-devices':'older-devices',flexible:'budget',upload:'router',gaming:'router',family:'family'}};
  $('#ocn-form').addEventListener('submit',ev=>{
    ev.preventDefault();
    if(!region||!q.get('persona')||!q.get('intent')){$('#ocn-error').hidden=false;$('#ocn-error').textContent=tr('Please complete the country, profile and purpose on Step 2.','Bitte ergänzen Sie Land, Profil und Ziel in Schritt 2.');$('#ocn-back').scrollIntoView({behavior:'smooth',block:'center'});return;}
    if(!state.goal||state.priorities.length===0){$('#ocn-error').hidden=false;$('#ocn-error').textContent=tr('Select a main goal and at least one priority.','Bitte wählen Sie ein Hauptziel und mindestens eine Priorität.');(!state.goal?$('#ocn-goal-group'):$('#ocn-priority-group')).scrollIntoView({behavior:'smooth',block:'center'});return;}
    const next=new URLSearchParams(base);
    if(state.home)next.set('home',state.home);
    if(state.home==='other'&&$('#ocn-home-details').value.trim())next.set('homeDetails',$('#ocn-home-details').value.trim().slice(0,160));
    if(state.devices)next.set('devices',state.devices);
    if(state.internetTech)next.set('internetTech',state.internetTech);
    if(state.wifiTech)next.set('wifiTech',state.wifiTech);
    if(state.internetTech&&category==='internet')next.set('tech',state.internetTech);
    if(state.wifiTech&&category==='wifi')next.set('tech',state.wifiTech);
    next.set('userGoal',state.goal);
    // Conventional goal field for BP075/BP076. Both remains 'both' in category;
    // legacy Step 4/5 MUST be updated for meaningful joint recommendations.
    const legacyGoal=category==='both'?(state.goal==='both-compare'?'generations':state.goal==='both-safety'?'reliability':'upgrade'):state.goal;
    if(legacyGoalOptions[category==='wifi'?'wifi':'internet'].includes(legacyGoal))next.set('goal',legacyGoal);
    next.set('priorities',state.priorities.join(','));
    const mappingCategory=category==='wifi'?'wifi':'internet';
    const evidence=[];for(const p of state.priorities){const x=legacyEvidenceMap[mappingCategory][p];if(x&&!evidence.includes(x))evidence.push(x);}
    next.set('evidence',evidence.slice(0,3).join(','));
    if(state.needs.length)next.set('needs',state.needs.join(','));
    const constraints=[];for(const x of state.needs){const m=legacyConstraintsMap[mappingCategory][x];if(m&&!constraints.includes(m))constraints.push(m);}if(constraints.length)next.set('constraints',constraints.join(','));
    if(route==='choose'){
      if(state.purchaseScope)next.set('purchaseScope',state.purchaseScope);
      if(state.planStatus)next.set('planStatus',state.planStatus);
      if(state.equipment.length)next.set('equipment',state.equipment.join(','));
      if(state.contractPreference)next.set('contractPreference',state.contractPreference);
      const budget=$('#ocn-budget').value.trim();if(budget&&Number.isFinite(Number(budget))&&Number(budget)>=0&&Number(budget)<=100000)next.set('budget',String(Math.round(Number(budget))));
    }
    const monthly=$('#ocn-monthly').value.trim();if(monthly&&Number.isFinite(Number(monthly))&&Number(monthly)>=0&&Number(monthly)<=100000)next.set('monthlyBudget',String(Math.round(Number(monthly))));
    const note=$('#ocn-note').value.trim();if(note)next.set('note',note.slice(0,180));
    if(category==='both'){
      $('#ocn-combined-warning').hidden=false;
      $('#ocn-combined-warning').textContent=tr('Combined Internet + Wi-Fi comparison needs the Step 4 integration update. This Step 3 is ready, but continuing now would incorrectly show an Internet-only comparison. Please review Steps 2–3 first.','Für den gemeinsamen Internet- und WLAN-Vergleich muss Schritt 4 angepasst werden. Die aktuelle Version würde nur den Internetanschluss vergleichen. Bitte prüfen Sie zunächst Schritte 2 und 3.');
      $('#ocn-combined-warning').scrollIntoView({behavior:'smooth',block:'center'});
      return;
    }
    location.assign('/internet/reviews/step-4/?'+next.toString());
  });
  render();
})();
</script>
