---
/**
 * ONOCRA BP077 — Home Internet & Wi-Fi / Step 2 — Visitor profile.
 * Install: src/pages/internet/reviews/step-2/index.astro
 * Existing shared components, no new packages required.
 * Step 1 may send category=internet|wifi and route=explore|choose.
 * Step 2 ALSO allows category=both without requiring a Step 1 rewrite.
 * Privacy: no address requested. The state is passed in the query string;
 * do not place sensitive personal information in the optional fields.
 */
import Layout from "@/layouts/Layout.astro";
import InternetHeader from "@/components/Internet/Header.astro";
import InternetFooter from "@/components/Internet/Footer.astro";
---
<Layout title="Step 2 — Your profile | Home Internet & Wi-Fi | ONOCRA">
  <InternetHeader />
  <main class="ocp-main" id="main-content">
    <nav class="ocp-crumbs" aria-label="Breadcrumb"><a id="ocp-home" href="/internet/">Home Internet &amp; Wi-Fi</a><span>›</span><a id="ocp-reviews" href="/internet/#reviews">Reviews &amp; Comparisons</a><span>›</span><strong id="ocp-step-label">Step 2</strong></nav>
    <nav class="ocp-progress" aria-label="Progress through the review journey"><a id="ocp-first" href="/internet/reviews/">01 · Route ✓</a><span aria-current="step">02 · Profile</span><span>03 · Priorities</span><span>04 · Compare</span><span>05 · Verdict</span></nav>
    <section class="ocp-panel">
      <header class="ocp-head">
        <div>
          <p class="ocp-eyebrow" data-en="ONOCRA · REVIEWS & COMPARISONS" data-de="ONOCRA · TESTS & VERGLEICHE">ONOCRA · REVIEWS &amp; COMPARISONS</p>
          <h1 data-en="Step 2 — Tell us who we are helping" data-de="Schritt 2 — Für wen suchen Sie Hilfe?">Step 2 — Tell us who we are helping</h1>
          <p class="ocp-lead" data-en="Like choosing a phone for someone you care about, the right home connection depends on who uses it and why." data-de="Wie beim Kauf eines passenden Smartphones kommt es auch beim Heimnetz darauf an, wer es wofür nutzt.">Like choosing a phone for someone you care about, the right home connection depends on who uses it and why.</p>
          <div class="ocp-pills"><span id="ocp-route-pill">Help Me Choose</span><span id="ocp-region-pill">US · UK · Germany</span><a id="ocp-change" href="/internet/reviews/">Change route ↗</a></div>
        </div>
        <img src="/internet/step1-pelican.png" class="ocp-hero-pelican" alt="" loading="lazy" />
      </header>
      <div class="ocp-guide"><span class="ocp-star">✦</span><p><strong data-en="Your pelican guide" data-de="Ihr Pelikan-Begleiter">Your pelican guide</strong><span data-en="I'll adjust the next questions for an explorer, a household buyer, or a family seeking safer technology. No account or personal address is needed." data-de="Ich passe die nächsten Fragen an Wissbegierige, Kaufinteressierte und Familien an. Ein Konto oder eine Privatadresse ist nicht nötig.">I'll adjust the next questions for an explorer, a household buyer, or a family seeking safer technology. No account or personal address is needed.</span></p></div>
      <form id="ocp-form" novalidate>
        <fieldset class="ocp-group" id="ocp-category-group">
          <legend><span class="ocp-num">01</span><span data-en="What would you like help with?" data-de="Wobei können wir helfen?">What would you like help with?</span><small data-en="Choose one" data-de="Eine Option">Choose one</small></legend>
          <div class="ocp-three" id="ocp-category-options">
            <button type="button" class="ocp-tile ocp-topic" data-field="category" data-value="internet" aria-pressed="false"><span class="ocp-emoji">🌐</span><strong data-en="Home Internet" data-de="Internetanschluss">Home Internet</strong><small data-en="Providers, service plans, broadband & speed" data-de="Anbieter, Tarife, Breitband & Tempo">Providers, service plans, broadband &amp; speed</small></button>
            <button type="button" class="ocp-tile ocp-topic" data-field="category" data-value="wifi" aria-pressed="false"><span class="ocp-emoji">📶</span><strong data-en="Wi-Fi & Mesh" data-de="WLAN & Mesh">Wi-Fi &amp; Mesh</strong><small data-en="Routers, equipment, coverage & networks" data-de="Router, Geräte, Abdeckung & Netzwerke">Routers, equipment, coverage &amp; networks</small></button>
            <button type="button" class="ocp-tile ocp-topic" data-field="category" data-value="both" aria-pressed="false"><span class="ocp-emoji">🏠</span><strong data-en="Internet + Wi-Fi together" data-de="Internet + WLAN zusammen">Internet + Wi-Fi together</strong><small data-en="Choose a service and the equipment that works with it" data-de="Anschluss und passende Geräte gemeinsam wählen">Choose a service and the equipment that works with it</small></button>
          </div>
        </fieldset>
        <fieldset class="ocp-group" id="ocp-region-group">
          <legend><span class="ocp-num">02</span><span data-en="Which country is this for?" data-de="Für welches Land ist die Beratung?">Which country is this for?</span><small data-en="Required" data-de="Erforderlich">Required</small></legend>
          <div class="ocp-three ocp-regions">
            <button type="button" class="ocp-tile" data-field="region" data-value="US" aria-pressed="false"><span class="ocp-emoji">🇺🇸</span><strong data-en="United States" data-de="USA">United States</strong></button>
            <button type="button" class="ocp-tile" data-field="region" data-value="UK" aria-pressed="false"><span class="ocp-emoji">🇬🇧</span><strong data-en="United Kingdom" data-de="Großbritannien">United Kingdom</strong></button>
            <button type="button" class="ocp-tile" data-field="region" data-value="DE" aria-pressed="false"><span class="ocp-emoji">🇩🇪</span><strong data-en="Germany" data-de="Deutschland">Germany</strong></button>
          </div>
          <p class="ocp-help" data-en="Current editorial and buying coverage is focused on residents of the US, UK and Germany; live local provider availability is not checked here." data-de="Unsere redaktionelle Kaufberatung richtet sich derzeit an Menschen in den USA, Großbritannien und Deutschland. Die lokale Verfügbarkeit wird hier nicht live geprüft.">Current editorial and buying coverage is focused on residents of the US, UK and Germany; live local provider availability is not checked here.</p>
        </fieldset>
        <fieldset class="ocp-group" id="ocp-persona-group">
          <legend><span class="ocp-num">03</span><span id="ocp-persona-title">Which description best fits you?</span><small data-en="Choose one" data-de="Eine Option">Choose one</small></legend>
          <p class="ocp-help" id="ocp-persona-help"></p>
          <div class="ocp-card-grid" id="ocp-persona-options">
            <button type="button" class="ocp-tile ocp-persona" data-value="household" data-route="choose" aria-pressed="false"><span class="ocp-emoji">🏡</span><strong data-en="Household decision-maker" data-de="Für den Haushalt verantwortlich">Household decision-maker</strong><small data-en="I decide what works and what to spend" data-de="Ich entscheide, was sinnvoll und bezahlbar ist">I decide what works and what to spend</small></button>
            <button type="button" class="ocp-tile ocp-persona" data-value="parent" data-route="both" aria-pressed="false"><span class="ocp-emoji">👨‍👩‍👧</span><strong data-en="Parent or guardian" data-de="Elternteil oder Aufsichtsperson">Parent or guardian</strong><small data-en="Family needs, safe browsing and supervision" data-de="Familie, sichere Nutzung und Aufsicht">Family needs, safe browsing and supervision</small></button>
            <button type="button" class="ocp-tile ocp-persona" data-value="remote" data-route="choose" aria-pressed="false"><span class="ocp-emoji">💻</span><strong data-en="Working or studying from home" data-de="Homeoffice oder Lernen">Working or studying from home</strong><small data-en="Reliable video calls, learning and work" data-de="Zuverlässige Videoanrufe und Arbeit">Reliable video calls, learning and work</small></button>
            <button type="button" class="ocp-tile ocp-persona" data-value="caregiver" data-route="both" aria-pressed="false"><span class="ocp-emoji">🤝</span><strong data-en="Supporting someone else" data-de="Ich helfe einer anderen Person">Supporting someone else</strong><small data-en="Make technology comfortable and accessible" data-de="Technik verständlich und zugänglich machen">Make technology comfortable and accessible</small></button>
            <button type="button" class="ocp-tile ocp-persona" data-value="enthusiast" data-route="explore" aria-pressed="false"><span class="ocp-emoji">🔎</span><strong data-en="Technology enthusiast or student" data-de="Technikfan oder Studierende">Technology enthusiast or student</strong><small data-en="Explore generations, standards and differences" data-de="Generationen, Standards und Unterschiede">Explore generations, standards and differences</small></button>
            <button type="button" class="ocp-tile ocp-persona" data-value="professional" data-route="explore" aria-pressed="false"><span class="ocp-emoji">📚</span><strong data-en="Professional, creator or researcher" data-de="Fachkraft, Kreative oder Forschung">Professional, creator or researcher</strong><small data-en="Understand published technical evidence" data-de="Veröffentlichte technische Belege prüfen">Understand published technical evidence</small></button>
          </div>
        </fieldset>
        <fieldset class="ocp-group" id="ocp-intent-group">
          <legend><span class="ocp-num">04</span><span id="ocp-intent-title">What would you like to achieve?</span><small data-en="Choose one" data-de="Eine Option">Choose one</small></legend>
          <div class="ocp-intent-grid" id="ocp-intent-options">
            <button type="button" class="ocp-tile ocp-intent" data-value="learn" data-route="explore" aria-pressed="false"><span class="ocp-icon">01</span><strong data-en="Understand the technology" data-de="Technik verstehen">Understand the technology</strong><small data-en="How connections and Wi-Fi work" data-de="Wie Anschlüsse und WLAN funktionieren">How connections and Wi-Fi work</small></button>
            <button type="button" class="ocp-tile ocp-intent" data-value="compare-tech" data-route="explore" aria-pressed="false"><span class="ocp-icon">02</span><strong data-en="Compare technologies and generations" data-de="Techniken und Generationen vergleichen">Compare technologies and generations</strong><small data-en="Real improvements and trade-offs" data-de="Fortschritte und Nachteile">Real improvements and trade-offs</small></button>
            <button type="button" class="ocp-tile ocp-intent" data-value="diagnose" data-route="both" aria-pressed="false"><span class="ocp-icon">03</span><strong data-en="Diagnose a problem" data-de="Ein Problem untersuchen">Diagnose a problem</strong><small data-en="Unreliable connection, dead zones or safety" data-de="Ausfälle, Funklöcher oder Sicherheit">Unreliable connection, dead zones or safety</small></button>
            <button type="button" class="ocp-tile ocp-intent" data-value="provider" data-route="choose" aria-pressed="false"><span class="ocp-icon">04</span><strong data-en="Find or switch an internet provider" data-de="Internetanbieter finden oder wechseln">Find or switch an internet provider</strong><small data-en="Service type, terms, price and suitability" data-de="Anschlussart, Vertrag, Preis und Eignung">Service type, terms, price and suitability</small></button>
            <button type="button" class="ocp-tile ocp-intent" data-value="equipment" data-route="choose" aria-pressed="false"><span class="ocp-icon">05</span><strong data-en="Choose equipment" data-de="Geräte auswählen">Choose equipment</strong><small data-en="Router, modem, mesh or network protection" data-de="Router, Modem, Mesh oder Netzwerkschutz">Router, modem, mesh or network protection</small></button>
            <button type="button" class="ocp-tile ocp-intent" data-value="bundle" data-route="choose" aria-pressed="false"><span class="ocp-icon">06</span><strong data-en="Choose provider + equipment together" data-de="Anbieter + Geräte zusammen auswählen">Choose provider + equipment together</strong><small data-en="Plan the whole connected home" data-de="Das gesamte Heimnetz planen">Plan the whole connected home</small></button>
          </div>
        </fieldset>
        <fieldset class="ocp-group" id="ocp-audience-group">
          <legend><span class="ocp-num">05</span><span data-en="Who will use the connection?" data-de="Wer wird den Anschluss nutzen?">Who will use the connection?</span><small data-en="Optional" data-de="Optional">Optional</small></legend>
          <div class="ocp-chips" id="ocp-audience-options">
            <button type="button" data-field="audience" data-value="self" aria-pressed="false" data-en="Just me" data-de="Nur ich">Just me</button>
            <button type="button" data-field="audience" data-value="family" aria-pressed="false" data-en="Family / shared household" data-de="Familie / gemeinsamer Haushalt">Family / shared household</button>
            <button type="button" data-field="audience" data-value="children" aria-pressed="false" data-en="Children under 13" data-de="Kinder unter 13">Children under 13</button>
            <button type="button" data-field="audience" data-value="teens" aria-pressed="false" data-en="Teenagers 13–17" data-de="Jugendliche 13–17">Teenagers 13–17</button>
            <button type="button" data-field="audience" data-value="older" aria-pressed="false" data-en="Older family members" data-de="Ältere Familienmitglieder">Older family members</button>
          </div>
        </fieldset>
        <fieldset class="ocp-group" id="ocp-safety-group">
          <legend><span class="ocp-num">06</span><span data-en="Any digital safety or parenting priorities?" data-de="Prioritäten bei Sicherheit oder digitaler Erziehung?">Any digital safety or parenting priorities?</span><small data-en="Select any" data-de="Mehrfachauswahl">Select any</small></legend>
          <div class="ocp-chips" id="ocp-safety-options">
            <button type="button" data-multi="safety" data-value="privacy" aria-pressed="false" data-en="🔐 Privacy & secure network" data-de="🔐 Datenschutz & sicheres Netz">🔐 Privacy &amp; secure network</button>
            <button type="button" data-multi="safety" data-value="scams" aria-pressed="false" data-en="🛡️ Scam and phishing protection" data-de="🛡️ Betrugs- und Phishing-Schutz">🛡️ Scam and phishing protection</button>
            <button type="button" data-multi="safety" data-value="parental" aria-pressed="false" data-en="👨‍👩‍👧 Parental controls" data-de="👨‍👩‍👧 Kindersicherung">👨‍👩‍👧 Parental controls</button>
            <button type="button" data-multi="safety" data-value="screen" aria-pressed="false" data-en="⏳ Screen time & healthy habits" data-de="⏳ Bildschirmzeit & gute Gewohnheiten">⏳ Screen time &amp; healthy habits</button>
            <button type="button" data-multi="safety" data-value="access" aria-pressed="false" data-en="💚 Accessibility & simplicity" data-de="💚 Barrierefreiheit & Einfachheit">💚 Accessibility &amp; simplicity</button>
          </div>
          <p class="ocp-help" data-en="Safety and child suitability are essential checks, not trade-offs that can be cancelled by a low price." data-de="Sicherheit und Eignung für Kinder bleiben wichtige Voraussetzungen, auch wenn ein Angebot günstig ist.">Safety and child suitability are essential checks, not trade-offs that can be cancelled by a low price.</p>
        </fieldset>
        <p class="ocp-error" id="ocp-error" hidden role="alert"></p>
        <div class="ocp-actions"><a id="ocp-back" href="/internet/reviews/" data-en="← Back to Step 1" data-de="← Zurück zu Schritt 1">← Back to Step 1</a><button type="submit" data-en="Continue to Step 3 →" data-de="Weiter zu Schritt 3 →">Continue to Step 3 →</button></div>
        <p class="ocp-fine" data-en="Your preferences personalise the pathway, not ONOCRA's independent editorial findings. No local provider availability, deal or performance claim is implied." data-de="Ihre Angaben personalisieren den Weg, nicht die unabhängige redaktionelle Bewertung. Lokale Verfügbarkeit, Angebote oder Leistungswerte werden nicht behauptet.">Your preferences personalise the pathway, not ONOCRA's independent editorial findings. No local provider availability, deal or performance claim is implied.</p>
      </form>
    </section>
  </main>
  <InternetFooter />
</Layout>

<script is:inline>
(() => {
  const $ = (s) => document.querySelector(s);
  const params = new URLSearchParams(location.search);
  const lang = params.get('lang') === 'de' ? 'de' : 'en';
  const tr = (en, de) => lang === 'de' ? de : en;
  const allowed = {
    category: ['internet','wifi','both'], region: ['US','UK','DE'],
    persona: ['household','parent','remote','caregiver','enthusiast','professional'],
    intent: ['learn','compare-tech','diagnose','provider','equipment','bundle'],
    audience: ['self','family','children','teens','older']
  };
  const state = {
    category: allowed.category.includes(params.get('category')) ? params.get('category') : 'internet',
    region: allowed.region.includes(params.get('region')) ? params.get('region') : '',
    persona: allowed.persona.includes(params.get('persona')) ? params.get('persona') : '',
    intent: allowed.intent.includes(params.get('intent')) ? params.get('intent') : '',
    audience: allowed.audience.includes(params.get('audience')) ? params.get('audience') : '',
    route: params.get('route') === 'choose' ? 'choose' : 'explore',
    safety: (params.get('safety') || '').split(',').filter((x, i, a) => ['privacy','scams','parental','screen','access'].includes(x) && a.indexOf(x)===i)
  };
  $('.ocp-main').lang=lang;
  document.querySelectorAll('[data-en][data-de]').forEach(el => {el.textContent=el.dataset[lang];});
  const step1 = () => '/internet/reviews/?' + new URLSearchParams({lang,route:state.route,category:state.category});
  $('#ocp-home').href = '/internet/?lang='+lang;
  $('#ocp-reviews').href='/internet/?lang='+lang+'#reviews';
  $('#ocp-first').href=step1();
  $('#ocp-back').href=step1();
  $('#ocp-change').href=step1();
  $('#ocp-route-pill').textContent=state.route==='choose'?tr('Help Me Choose','Bei der Auswahl helfen'):tr('Explore & Compare','Entdecken & Vergleichen');
  const render=() => {
    document.querySelectorAll('[data-field][data-value]').forEach(btn => {
      const on=state[btn.dataset.field]===btn.dataset.value;
      btn.classList.toggle('chosen',on);btn.setAttribute('aria-pressed',String(on));
    });
    document.querySelectorAll('.ocp-persona').forEach(btn=>{
      btn.hidden=!(btn.dataset.route===state.route || btn.dataset.route==='both');
      const on=state.persona===btn.dataset.value;btn.classList.toggle('chosen',on);btn.setAttribute('aria-pressed',String(on));
    });
    document.querySelectorAll('.ocp-intent').forEach(btn=>{
      btn.hidden=!(btn.dataset.route===state.route || btn.dataset.route==='both');
      const on=state.intent===btn.dataset.value;btn.classList.toggle('chosen',on);btn.setAttribute('aria-pressed',String(on));
    });
    document.querySelectorAll('[data-multi="safety"]').forEach(btn=>{
      const on=state.safety.includes(btn.dataset.value);btn.classList.toggle('chosen',on);btn.setAttribute('aria-pressed',String(on));
    });
    $('#ocp-persona-title').textContent=state.route==='choose'?tr('Who are you buying or choosing for?','Für wen wählen oder kaufen Sie?'):tr('What kind of explorer are you?','Wie möchten Sie das Thema erkunden?');
    $('#ocp-persona-help').textContent=state.route==='choose'?tr('Choose the perspective ONOCRA should use when evaluating practical suitability.','Wählen Sie, aus welcher Perspektive ONOCRA die Eignung prüfen soll.'):tr('A curious parent or caregiver is as welcome as a technical specialist.','Neugierige Eltern oder Betreuende sind ebenso willkommen wie Fachleute.');
    $('#ocp-intent-title').textContent=state.route==='choose'?tr('What are you looking to choose or improve?','Was möchten Sie auswählen oder verbessern?'):tr('What would you like to explore?','Was möchten Sie genauer erkunden?');
    $('#ocp-region-pill').textContent=({'US':'🇺🇸 US','UK':'🇬🇧 UK','DE':'🇩🇪 Germany'})[state.region]||tr('US · UK · Germany','USA · GB · Deutschland');
    $('#ocp-first').href=step1(); $('#ocp-back').href=step1();$('#ocp-change').href=step1();
  };
  if (state.route==='choose' && ['enthusiast','professional'].includes(state.persona)) state.persona='';
  if (state.route==='explore' && ['household','remote'].includes(state.persona)) state.persona='';
  if (state.route==='choose' && ['learn','compare-tech'].includes(state.intent)) state.intent='';
  if (state.route==='explore' && ['provider','equipment','bundle'].includes(state.intent)) state.intent='';
  document.querySelectorAll('[data-field][data-value]').forEach(btn=>btn.addEventListener('click',()=>{
    state[btn.dataset.field]=btn.dataset.value;render();$('#ocp-error').hidden=true;
  }));
  document.querySelectorAll('.ocp-persona').forEach(btn=>btn.addEventListener('click',()=>{state.persona=btn.dataset.value;render();}));
  document.querySelectorAll('.ocp-intent').forEach(btn=>btn.addEventListener('click',()=>{state.intent=btn.dataset.value;render();}));
  document.querySelectorAll('[data-multi="safety"]').forEach(btn=>btn.addEventListener('click',()=>{
    state.safety=state.safety.includes(btn.dataset.value)?state.safety.filter(x=>x!==btn.dataset.value):[...state.safety,btn.dataset.value];render();
  }));
  $('#ocp-form').addEventListener('submit',(event)=>{
    event.preventDefault();
    const missing=!state.region?'region':!state.persona?'persona':!state.intent?'intent':'';
    if(missing){$('#ocp-error').hidden=false;$('#ocp-error').textContent=tr('Please choose a country, a profile and a main purpose.','Bitte wählen Sie Land, Profil und Hauptziel.');$('#ocp-'+missing+'-group').scrollIntoView({behavior:'smooth',block:'center'});return;}
    const next=new URLSearchParams({lang,category:state.category,route:state.route,region:state.region,persona:state.persona,intent:state.intent});
    if(state.audience)next.set('audience',state.audience);
    if(state.safety.length)next.set('safety',state.safety.join(','));
    location.assign('/internet/reviews/step-3/?'+next.toString());
  });
  render();
})();
</script>

<style is:global>
.ocp-main{max-width:1250px;margin:auto;padding:13px clamp(12px,3vw,40px) 34px;color:#214b3a;background:#fffdf8;font-family:var(--font-manrope),Arial,sans-serif}
.ocp-crumbs{display:flex;gap:10px;flex-wrap:wrap;align-items:center;font-size:12px;margin-bottom:12px;color:#84928a}.ocp-crumbs a{color:#39715b;text-decoration:none}.ocp-progress{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;background:#e9f1e9;border-radius:12px;padding:5px;margin-bottom:12px}.ocp-progress>*{padding:9px 5px;text-align:center;font-size:11px;font-weight:750;text-decoration:none;color:#5a7764}.ocp-progress>a{background:#d8e9db;border-radius:8px}.ocp-progress>[aria-current]{background:#265b43;border-radius:8px;color:white}
.ocp-panel{border:1px solid #c5dccc;border-radius:21px;padding:clamp(16px,2.7vw,33px);background:linear-gradient(140deg,#fcfff8,#fffdf8 50%,#f6faf3);box-shadow:0 8px 25px #194a3010}
.ocp-head{display:grid;grid-template-columns:minmax(0,1fr) 154px;align-items:center;gap:16px}.ocp-eyebrow{text-transform:uppercase;letter-spacing:2px;color:#b36e34;font-size:11px;font-weight:800}.ocp-head h1{font-family:Georgia,serif;font-size:clamp(28px,3.2vw,45px);font-weight:500;line-height:1.15;color:#1b4c38;margin:8px 0}.ocp-lead{font-size:14px;color:#65736b;line-height:1.75;max-width:770px}.ocp-hero-pelican{width:154px;height:137px;object-fit:contain;justify-self:end}.ocp-pills{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:12px}.ocp-pills span{background:#e8f2e8;padding:7px 11px;border-radius:99px;color:#34684d;font-size:11px;font-weight:800}.ocp-pills a{color:#a3682e;font-size:12px;font-weight:700;text-decoration:none}.ocp-guide{display:flex;align-items:start;gap:13px;background:#eaf4ed;border:1px solid #d1e4d3;padding:13px 16px;border-radius:16px;margin:22px 0}.ocp-guide p{margin:0;display:grid;gap:3px;font-size:13px;line-height:1.55;color:#476451}.ocp-guide strong{color:#27583e;font-family:Georgia,serif;font-size:17px}.ocp-star{color:#d78d49;font-size:25px}
