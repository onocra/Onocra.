---
/**
 * ONOCRA — Home Internet & Wi-Fi
 * Step 2 — Visitor profile
 *
 * Step 1 may send:
 * category=internet|wifi|both
 * route=explore|choose
 *
 * Step 2 supports:
 * - compact category + region selection
 * - visitor role profiling
 * - first-time / upgrade / other intent
 * - REQUIRED multi-select household composition
 * - safety / parenting priorities
 * - subtle digital-home watermark artwork
 *
 * Privacy:
 * No address is requested.
 * Avoid sensitive personal information in free-text fields.
 */

import Layout from "@/layouts/Layout.astro";
import InternetHeader from "@/components/Internet/Header.astro";
import InternetFooter from "@/components/Internet/Footer.astro";
---

<Layout title="Step 2 — Your profile | Home Internet & Wi-Fi | ONOCRA">
  <InternetHeader />

  <main class="ocp-main" id="main-content">
    <nav class="ocp-crumbs" aria-label="Breadcrumb">
      <a id="ocp-home" href="/internet/">Home Internet &amp; Wi-Fi</a>
      <span>›</span>
      <a id="ocp-reviews" href="/internet/#reviews">Reviews &amp; Comparisons</a>
      <span>›</span>
      <strong>Step 2</strong>
    </nav>

    <nav class="ocp-progress" aria-label="Progress through the review journey">
      <a id="ocp-first" href="/internet/reviews/">01 · Route ✓</a>
      <span aria-current="step">02 · Profile</span>
      <span>03 · Priorities</span>
      <span>04 · Compare</span>
      <span>05 · Verdict</span>
    </nav>

    <section class="ocp-panel">
      <!-- subtle technology watermark -->
      <div class="ocp-watermark" aria-hidden="true">
        <svg viewBox="0 0 1000 560" role="presentation">
          <g class="wm-lines">
            <path d="M90 180 C180 80 310 80 395 180" />
            <path d="M125 215 C190 145 290 145 355 215" />
            <path d="M165 250 C210 205 270 205 315 250" />
            <circle cx="240" cy="285" r="13" />

            <circle cx="705" cy="115" r="42" />
            <circle cx="855" cy="215" r="34" />
            <circle cx="680" cy="355" r="31" />
            <circle cx="870" cy="425" r="39" />

            <path d="M740 130 L825 195" />
            <path d="M825 240 L710 335" />
            <path d="M715 370 L835 415" />
            <path d="M705 155 L690 320" />

            <rect x="440" y="110" width="125" height="82" rx="10" />
            <path d="M420 212 H585" />
            <path d="M468 212 L455 237 H550 L537 212" />

            <rect x="450" y="340" width="68" height="110" rx="12" />
            <circle cx="484" cy="430" r="4" />

            <path d="M585 335
                     C585 300 615 276 648 276
                     C681 276 710 300 710 335
                     V376
                     C710 416 681 445 648 459
                     C615 445 585 416 585 376 Z" />
            <path d="M625 359 L643 377 L678 337" />
          </g>
        </svg>
      </div>

      <div class="ocp-content">
        <header class="ocp-head">
          <div>
            <p
              class="ocp-eyebrow"
              data-en="ONOCRA · REVIEWS & COMPARISONS"
              data-de="ONOCRA · TESTS & VERGLEICHE"
            >
              ONOCRA · REVIEWS &amp; COMPARISONS
            </p>

            <h1
              data-en="Step 2 — Tell us who we are helping"
              data-de="Schritt 2 — Für wen suchen Sie Hilfe?"
            >
              Step 2 — Tell us who we are helping
            </h1>

            <p
              class="ocp-lead"
              data-en="A good connection is not only about speed. Tell us a little about the household, purpose and people who will use it."
              data-de="Ein guter Anschluss hängt nicht nur von der Geschwindigkeit ab. Erzählen Sie uns kurz etwas über Haushalt, Zweck und Nutzer."
            >
              A good connection is not only about speed. Tell us a little
              about the household, purpose and people who will use it.
            </p>

            <div class="ocp-pills">
              <span id="ocp-route-pill">Help Me Choose</span>
              <span id="ocp-region-pill">US · UK · Germany</span>
              <a id="ocp-change" href="/internet/reviews/">Change route ↗</a>
            </div>
          </div>

          <img
            src="/internet/step1-pelican.png"
            class="ocp-hero-pelican"
            alt=""
            loading="lazy"
          />
        </header>

        <div class="ocp-guide">
          <span class="ocp-star">✦</span>
          <p>
            <strong
              data-en="Your pelican guide"
              data-de="Ihr Pelikan-Begleiter"
            >
              Your pelican guide
            </strong>

            <span
              data-en="These answers help ONOCRA distinguish a first connection from an upgrade, and an individual user from a family with children, teenagers or older adults. No account or home address is needed."
              data-de="Ihre Antworten helfen ONOCRA dabei, einen neuen Anschluss von einem Upgrade und Einzelnutzer von Familien mit Kindern, Jugendlichen oder älteren Menschen zu unterscheiden. Ein Konto oder eine Privatadresse ist nicht nötig."
            >
              These answers help ONOCRA distinguish a first connection from
              an upgrade, and an individual user from a family with children,
              teenagers or older adults. No account or home address is needed.
            </span>
          </p>
        </div>

        <form id="ocp-form" novalidate>
          <!-- Q1 -->
          <fieldset class="ocp-group" id="ocp-category-group">
            <legend>
              <span class="ocp-num">01</span>
              <span
                data-en="What would you like help with?"
                data-de="Wobei können wir helfen?"
              >
                What would you like help with?
              </span>
              <small data-en="Choose one" data-de="Eine Option">
                Choose one
              </small>
            </legend>

            <div class="ocp-three ocp-topic-grid">
              <button
                type="button"
                class="ocp-tile ocp-topic"
                data-field="category"
                data-value="internet"
                aria-pressed="false"
              >
                <span class="ocp-topic-top">
                  <span class="ocp-emoji">🌐</span>
                  <strong
                    data-en="Home Internet"
                    data-de="Internetanschluss"
                  >
                    Home Internet
                  </strong>
                </span>
                <small
                  data-en="Providers, plans, broadband & speed"
                  data-de="Anbieter, Tarife, Breitband & Tempo"
                >
                  Providers, plans, broadband &amp; speed
                </small>
              </button>

              <button
                type="button"
                class="ocp-tile ocp-topic"
                data-field="category"
                data-value="wifi"
                aria-pressed="false"
              >
                <span class="ocp-topic-top">
                  <span class="ocp-emoji">📶</span>
                  <strong data-en="Home Wi-Fi" data-de="WLAN & Mesh">
                    Home Wi-Fi
                  </strong>
                </span>
                <small
                  data-en="Routers, mesh, equipment & coverage"
                  data-de="Router, Mesh, Geräte & Abdeckung"
                >
                  Routers, mesh, equipment &amp; coverage
                </small>
              </button>

              <button
                type="button"
                class="ocp-tile ocp-topic"
                data-field="category"
                data-value="both"
                aria-pressed="false"
              >
                <span class="ocp-topic-top">
                  <span class="ocp-emoji">🏠</span>
                  <strong
                    data-en="Internet + Wi-Fi"
                    data-de="Internet + WLAN"
                  >
                    Internet + Wi-Fi
                  </strong>
                </span>
                <small
                  data-en="Choose the service and equipment together"
                  data-de="Anschluss und passende Geräte gemeinsam wählen"
                >
                  Choose the service and equipment together
                </small>
              </button>
            </div>
          </fieldset>

          <!-- Q2 -->
          <fieldset class="ocp-group" id="ocp-region-group">
            <legend>
              <span class="ocp-num">02</span>
              <span
                data-en="Which country is this for?"
                data-de="Für welches Land ist die Beratung?"
              >
                Which country is this for?
              </span>
              <small data-en="Required" data-de="Erforderlich">
                Required
              </small>
            </legend>

            <div class="ocp-three ocp-regions">
              <button
                type="button"
                class="ocp-tile ocp-region-tile"
                data-field="region"
                data-value="US"
                aria-pressed="false"
              >
                <img
                  src="/flags/us.svg"
                  alt=""
                  class="ocp-flag"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"
                />
                <span class="ocp-flag-fallback" hidden>🇺🇸</span>
                <strong data-en="United States" data-de="USA">
                  United States
                </strong>
              </button>

              <button
                type="button"
                class="ocp-tile ocp-region-tile"
                data-field="region"
                data-value="UK"
                aria-pressed="false"
              >
                <img
                  src="/flags/uk.svg"
                  alt=""
                  class="ocp-flag"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"
                />
                <span class="ocp-flag-fallback" hidden>🇬🇧</span>
                <strong data-en="United Kingdom" data-de="Großbritannien">
                  United Kingdom
                </strong>
              </button>

              <button
                type="button"
                class="ocp-tile ocp-region-tile"
                data-field="region"
                data-value="DE"
                aria-pressed="false"
              >
                <img
                  src="/flags/de.svg"
                  alt=""
                  class="ocp-flag"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"
                />
                <span class="ocp-flag-fallback" hidden>🇩🇪</span>
                <strong data-en="Germany" data-de="Deutschland">
                  Germany
                </strong>
              </button>
            </div>

            <p
              class="ocp-help"
              data-en="Current editorial and buying coverage focuses on the US, UK and Germany. Live local provider availability is not checked here."
              data-de="Unsere redaktionelle Kaufberatung konzentriert sich derzeit auf die USA, Großbritannien und Deutschland. Die lokale Verfügbarkeit wird hier nicht live geprüft."
            >
              Current editorial and buying coverage focuses on the US, UK and
              Germany. Live local provider availability is not checked here.
            </p>
          </fieldset>

          <!-- Q3 -->
          <fieldset class="ocp-group" id="ocp-persona-group">
            <legend>
              <span class="ocp-num">03</span>
              <span
                data-en="Who are you buying or choosing for?"
                data-de="Für wen wählen oder kaufen Sie?"
              >
                Who are you buying or choosing for?
              </span>
              <small data-en="Choose one" data-de="Eine Option">
                Choose one
              </small>
            </legend>

            <div class="ocp-radio-list" id="ocp-persona-options">
              <button
                type="button"
                class="ocp-radio-row ocp-persona"
                data-value="household"
                aria-pressed="false"
              >
                <span class="ocp-radio"></span>
                <span>
                  <strong
                    data-en="I am a householder and a decision maker"
                    data-de="Ich bin Haushaltsmitglied und treffe die Entscheidung"
                  >
                    I am a householder and a decision maker
                  </strong>
                </span>
              </button>

              <button
                type="button"
                class="ocp-radio-row ocp-persona"
                data-value="parent"
                aria-pressed="false"
              >
                <span class="ocp-radio"></span>
                <span>
                  <strong
                    data-en="I am a decision maker and also a parent or guardian of a child or children under 18"
                    data-de="Ich treffe die Entscheidung und bin zugleich Elternteil oder Aufsichtsperson für ein Kind oder Kinder unter 18"
                  >
                    I am a decision maker and also a parent or guardian of a
                    child or children under 18
                  </strong>
                </span>
              </button>

              <button
                type="button"
                class="ocp-radio-row ocp-persona"
                data-value="student"
                aria-pressed="false"
              >
                <span class="ocp-radio"></span>
                <span>
                  <strong
                    data-en="I am a student and need it for my studies"
                    data-de="Ich studiere und benötige den Anschluss für mein Studium"
                  >
                    I am a student and need it for my studies
                  </strong>
                </span>
              </button>

              <button
                type="button"
                class="ocp-radio-row ocp-persona"
                data-value="remote"
                aria-pressed="false"
              >
                <span class="ocp-radio"></span>
                <span>
                  <strong
                    data-en="I am a worker or businessperson and need it for remote work from home"
                    data-de="Ich arbeite oder führe ein Unternehmen und benötige den Anschluss für die Arbeit von zu Hause"
                  >
                    I am a worker or businessperson and need it for remote work
                    from home
                  </strong>
                </span>
              </button>

              <button
                type="button"
                class="ocp-radio-row ocp-persona"
                data-value="other"
                aria-pressed="false"
              >
                <span class="ocp-radio"></span>
                <span>
                  <strong data-en="Other — please specify" data-de="Andere — bitte angeben">
                    Other — please specify
                  </strong>
                  <small
                    data-en="For example, helping another person or a purpose not listed above."
                    data-de="Zum Beispiel Unterstützung einer anderen Person oder ein oben nicht genannter Zweck."
                  >
                    For example, helping another person or a purpose not listed
                    above.
                  </small>
                </span>
              </button>
            </div>

            <div class="ocp-other-field" id="ocp-persona-other-wrap" hidden>
              <label for="ocp-persona-other">
                <span data-en="Please tell us briefly" data-de="Bitte kurz beschreiben">
                  Please tell us briefly
                </span>
              </label>
              <input
                id="ocp-persona-other"
                type="text"
                maxlength="120"
                autocomplete="off"
                placeholder="e.g. helping my parents choose a connection"
              />
            </div>
          </fieldset>

          <!-- Q4 -->
          <fieldset class="ocp-group" id="ocp-intent-group">
            <legend>
              <span class="ocp-num">04</span>
              <span
                data-en="What are you looking to choose?"
                data-de="Was möchten Sie auswählen?"
              >
                What are you looking to choose?
              </span>
              <small data-en="Choose one" data-de="Eine Option">
                Choose one
              </small>
            </legend>

            <div class="ocp-radio-list" id="ocp-intent-options">
              <button
                type="button"
                class="ocp-radio-row ocp-intent"
                data-value="first-time"
                aria-pressed="false"
              >
                <span class="ocp-radio"></span>
                <span>
                  <strong
                    data-en="Internet, Wi-Fi or both for the first time"
                    data-de="Internet, WLAN oder beides zum ersten Mal"
                  >
                    Internet, Wi-Fi or both for the first time
                  </strong>
                </span>
              </button>

              <button
                type="button"
                class="ocp-radio-row ocp-intent"
                data-value="upgrade"
                aria-pressed="false"
              >
                <span class="ocp-radio"></span>
                <span>
                  <strong
                    data-en="Upgrading an existing system"
                    data-de="Ein bestehendes System verbessern"
                  >
                    Upgrading an existing system
                  </strong>
                </span>
              </button>

              <button
                type="button"
                class="ocp-radio-row ocp-intent"
                data-value="other"
                aria-pressed="false"
              >
                <span class="ocp-radio"></span>
                <span>
                  <strong
                    data-en="Another purpose — please specify"
                    data-de="Ein anderer Zweck — bitte angeben"
                  >
                    Another purpose — please specify
                  </strong>
                </span>
              </button>
            </div>

            <div class="ocp-other-field" id="ocp-intent-other-wrap" hidden>
              <label for="ocp-intent-other">
                <span data-en="What are you trying to do?" data-de="Was möchten Sie erreichen?">
                  What are you trying to do?
                </span>
              </label>
              <input
                id="ocp-intent-other"
                type="text"
                maxlength="120"
                autocomplete="off"
                placeholder="Briefly describe your purpose"
              />
            </div>
          </fieldset>

          <!-- Q5 -->
          <fieldset class="ocp-group" id="ocp-audience-group">
            <legend>
              <span class="ocp-num">05</span>
              <span
                data-en="Who will mainly use the connection?"
                data-de="Wer wird den Anschluss hauptsächlich nutzen?"
              >
                Who will mainly use the connection?
              </span>
              <small data-en="Required · select all that apply" data-de="Erforderlich · Mehrfachauswahl">
                Required · select all that apply
              </small>
            </legend>

            <p
              class="ocp-help ocp-help-tight"
              data-en="Households can include more than one group. Select every group that applies so the later verdict can account for safety, parental controls, accessibility and shared use."
              data-de="Ein Haushalt kann mehrere Gruppen umfassen. Wählen Sie alle zutreffenden Gruppen, damit die spätere Bewertung Sicherheit, Kindersicherung, Barrierefreiheit und gemeinsame Nutzung berücksichtigen kann."
            >
              Households can include more than one group. Select every group
              that applies so the later verdict can account for safety,
              parental controls, accessibility and shared use.
            </p>

            <div class="ocp-check-list" id="ocp-audience-options">
              <button
                type="button"
                class="ocp-check-row"
                data-multi="audience"
                data-value="self"
                aria-pressed="false"
              >
                <span class="ocp-check"></span>
                <strong
                  data-en="Only me — I am an adult aged 26+ and the household decision maker"
                  data-de="Nur ich — ich bin 26+ und treffe die Entscheidung im Haushalt"
                >
                  Only me — I am an adult aged 26+ and the household decision
                  maker
                </strong>
              </button>

              <button
                type="button"
                class="ocp-check-row"
                data-multi="audience"
                data-value="adults"
                aria-pressed="false"
              >
                <span class="ocp-check"></span>
                <strong
                  data-en="Family / shared household — adults only"
                  data-de="Familie / gemeinsamer Haushalt — nur Erwachsene"
                >
                  Family / shared household — adults only
                </strong>
              </button>

              <button
                type="button"
                class="ocp-check-row"
                data-multi="audience"
                data-value="children"
                aria-pressed="false"
              >
                <span class="ocp-check"></span>
                <strong
                  data-en="Family / shared household — includes children under 13"
                  data-de="Familie / gemeinsamer Haushalt — mit Kindern unter 13"
                >
                  Family / shared household — includes children under 13
                </strong>
              </button>

              <button
                type="button"
                class="ocp-check-row"
                data-multi="audience"
                data-value="teens"
                aria-pressed="false"
              >
                <span class="ocp-check"></span>
                <strong
                  data-en="Family / shared household — includes teenagers aged 13–17"
                  data-de="Familie / gemeinsamer Haushalt — mit Jugendlichen von 13–17"
                >
                  Family / shared household — includes teenagers aged 13–17
                </strong>
              </button>

              <button
                type="button"
                class="ocp-check-row"
                data-multi="audience"
                data-value="older"
                aria-pressed="false"
              >
                <span class="ocp-check"></span>
                <strong
                  data-en="Family / shared household — includes older adults"
                  data-de="Familie / gemeinsamer Haushalt — mit älteren Erwachsenen"
                >
                  Family / shared household — includes older adults
                </strong>
              </button>
            </div>
          </fieldset>

          <!-- Q6 -->
          <fieldset class="ocp-group" id="ocp-safety-group">
            <legend>
              <span class="ocp-num">06</span>
              <span
                data-en="Any digital safety or parenting priorities?"
                data-de="Prioritäten bei Sicherheit oder digitaler Erziehung?"
              >
                Any digital safety or parenting priorities?
              </span>
              <small data-en="Select any" data-de="Mehrfachauswahl">
                Select any
              </small>
            </legend>

            <div class="ocp-chips" id="ocp-safety-options">
              <button
                type="button"
                data-multi="safety"
                data-value="privacy"
                aria-pressed="false"
                data-en="🔐 Privacy & secure network"
                data-de="🔐 Datenschutz & sicheres Netz"
              >
                🔐 Privacy &amp; secure network
              </button>

              <button
                type="button"
                data-multi="safety"
                data-value="scams"
                aria-pressed="false"
                data-en="🛡️ Scam & phishing protection"
                data-de="🛡️ Betrugs- & Phishing-Schutz"
              >
                🛡️ Scam &amp; phishing protection
              </button>

              <button
                type="button"
                data-multi="safety"
                data-value="parental"
                aria-pressed="false"
                data-en="👨‍👩‍👧 Parental controls"
                data-de="👨‍👩‍👧 Kindersicherung"
              >
                👨‍👩‍👧 Parental controls
              </button>

              <button
                type="button"
                data-multi="safety"
                data-value="screen"
                aria-pressed="false"
                data-en="⏳ Screen time & healthy habits"
                data-de="⏳ Bildschirmzeit & gute Gewohnheiten"
              >
                ⏳ Screen time &amp; healthy habits
              </button>

              <button
                type="button"
                data-multi="safety"
                data-value="access"
                aria-pressed="false"
                data-en="💚 Accessibility & simplicity"
                data-de="💚 Barrierefreiheit & Einfachheit"
              >
                💚 Accessibility &amp; simplicity
              </button>
            </div>

            <p
              class="ocp-help"
              data-en="Safety and child suitability are essential checks, not trade-offs that can be cancelled by a low price."
              data-de="Sicherheit und Eignung für Kinder bleiben wichtige Voraussetzungen, auch wenn ein Angebot günstig ist."
            >
              Safety and child suitability are essential checks, not trade-offs
              that can be cancelled by a low price.
            </p>
          </fieldset>

          <p class="ocp-error" id="ocp-error" hidden role="alert"></p>

          <div class="ocp-actions">
            <a
              id="ocp-back"
              href="/internet/reviews/"
              data-en="← Back to Step 1"
              data-de="← Zurück zu Schritt 1"
            >
              ← Back to Step 1
            </a>

            <button
              type="submit"
              data-en="Continue to Step 3 →"
              data-de="Weiter zu Schritt 3 →"
            >
              Continue to Step 3 →
            </button>
          </div>

          <p
            class="ocp-fine"
            data-en="Your answers personalise the pathway and suitability assessment; they do not change ONOCRA's independent editorial findings. No local provider availability, deal or performance claim is implied."
            data-de="Ihre Angaben personalisieren den Weg und die Eignungsbewertung; sie verändern nicht die unabhängigen redaktionellen Ergebnisse von ONOCRA. Lokale Verfügbarkeit, Angebote oder Leistungswerte werden nicht behauptet."
          >
            Your answers personalise the pathway and suitability assessment;
            they do not change ONOCRA's independent editorial findings. No
            local provider availability, deal or performance claim is implied.
          </p>
        </form>
      </div>
    </section>
  </main>

  <InternetFooter />
</Layout>

<script is:inline>
  (() => {
    const $ = (selector) => document.querySelector(selector);
    const params = new URLSearchParams(location.search);

    const lang = params.get("lang") === "de" ? "de" : "en";
    const tr = (en, de) => (lang === "de" ? de : en);

    const allowed = {
      category: ["internet", "wifi", "both"],
      region: ["US", "UK", "DE"],
      persona: ["household", "parent", "student", "remote", "other"],
      intent: ["first-time", "upgrade", "other"],
      audience: ["self", "adults", "children", "teens", "older"],
      safety: ["privacy", "scams", "parental", "screen", "access"],
    };

    const uniqueAllowed = (value, allowedValues) =>
      (value || "")
        .split(",")
        .filter(
          (x, index, arr) =>
            allowedValues.includes(x) && arr.indexOf(x) === index
        );

    const state = {
      category: allowed.category.includes(params.get("category"))
        ? params.get("category")
        : "internet",

      region: allowed.region.includes(params.get("region"))
        ? params.get("region")
        : "",

      persona: allowed.persona.includes(params.get("persona"))
        ? params.get("persona")
        : "",

      personaOther: (params.get("personaOther") || "").slice(0, 120),

      intent: allowed.intent.includes(params.get("intent"))
        ? params.get("intent")
        : "",

      intentOther: (params.get("intentOther") || "").slice(0, 120),

      audience: uniqueAllowed(params.get("audience"), allowed.audience),

      route: params.get("route") === "choose" ? "choose" : "explore",

      safety: uniqueAllowed(params.get("safety"), allowed.safety),
    };

    $(".ocp-main").lang = lang;

    document.querySelectorAll("[data-en][data-de]").forEach((el) => {
      el.textContent = el.dataset[lang];
    });

    const step1 = () =>
      "/internet/reviews/?" +
      new URLSearchParams({
        lang,
        route: state.route,
        category: state.category,
      });

    $("#ocp-home").href = "/internet/?lang=" + lang;
    $("#ocp-reviews").href = "/internet/?lang=" + lang + "#reviews";
    $("#ocp-first").href = step1();
    $("#ocp-back").href = step1();
    $("#ocp-change").href = step1();

    $("#ocp-persona-other").value = state.personaOther;
    $("#ocp-intent-other").value = state.intentOther;

    const render = () => {
      document.querySelectorAll("[data-field][data-value]").forEach((btn) => {
        const on = state[btn.dataset.field] === btn.dataset.value;
        btn.classList.toggle("chosen", on);
        btn.setAttribute("aria-pressed", String(on));
      });

      document.querySelectorAll(".ocp-persona").forEach((btn) => {
        const on = state.persona === btn.dataset.value;
        btn.classList.toggle("chosen", on);
        btn.setAttribute("aria-pressed", String(on));
      });

      document.querySelectorAll(".ocp-intent").forEach((btn) => {
        const on = state.intent === btn.dataset.value;
        btn.classList.toggle("chosen", on);
        btn.setAttribute("aria-pressed", String(on));
      });

      document.querySelectorAll('[data-multi="audience"]').forEach((btn) => {
        const on = state.audience.includes(btn.dataset.value);
        btn.classList.toggle("chosen", on);
        btn.setAttribute("aria-pressed", String(on));
      });

      document.querySelectorAll('[data-multi="safety"]').forEach((btn) => {
        const on = state.safety.includes(btn.dataset.value);
        btn.classList.toggle("chosen", on);
        btn.setAttribute("aria-pressed", String(on));
      });

      $("#ocp-persona-other-wrap").hidden = state.persona !== "other";
      $("#ocp-intent-other-wrap").hidden = state.intent !== "other";

      $("#ocp-route-pill").textContent =
        state.route === "choose"
          ? tr("Help Me Choose", "Bei der Auswahl helfen")
          : tr("Explore & Compare", "Entdecken & Vergleichen");

      $("#ocp-region-pill").textContent =
        {
          US: "🇺🇸 US",
          UK: "🇬🇧 UK",
          DE: "🇩🇪 Germany",
        }[state.region] ||
        tr("US · UK · Germany", "USA · GB · Deutschland");

      $("#ocp-first").href = step1();
      $("#ocp-back").href = step1();
      $("#ocp-change").href = step1();
    };

    document
      .querySelectorAll("[data-field][data-value]")
      .forEach((btn) =>
        btn.addEventListener("click", () => {
          state[btn.dataset.field] = btn.dataset.value;
          $("#ocp-error").hidden = true;
          render();
        })
      );

    document.querySelectorAll(".ocp-persona").forEach((btn) =>
      btn.addEventListener("click", () => {
        state.persona = btn.dataset.value;

        if (state.persona !== "other") {
          state.personaOther = "";
          $("#ocp-persona-other").value = "";
        }

        $("#ocp-error").hidden = true;
        render();

        if (state.persona === "other") {
          requestAnimationFrame(() => $("#ocp-persona-other").focus());
        }
      })
    );

    document.querySelectorAll(".ocp-intent").forEach((btn) =>
      btn.addEventListener("click", () => {
        state.intent = btn.dataset.value;

        if (state.intent !== "other") {
          state.intentOther = "";
          $("#ocp-intent-other").value = "";
        }

        $("#ocp-error").hidden = true;
        render();

        if (state.intent === "other") {
          requestAnimationFrame(() => $("#ocp-intent-other").focus());
        }
      })
    );

    document.querySelectorAll('[data-multi="audience"]').forEach((btn) =>
      btn.addEventListener("click", () => {
        const value = btn.dataset.value;

        state.audience = state.audience.includes(value)
          ? state.audience.filter((x) => x !== value)
          : [...state.audience, value];

        /*
         * "Only me" conflicts with shared-household groups.
         * Selecting self clears shared groups.
         * Selecting a shared group clears self.
         */
        if (value === "self" && state.audience.includes("self")) {
          state.audience = ["self"];
        } else if (value !== "self" && state.audience.includes(value)) {
          state.audience = state.audience.filter((x) => x !== "self");
        }

        $("#ocp-error").hidden = true;
        render();
      })
    );

    document.querySelectorAll('[data-multi="safety"]').forEach((btn) =>
      btn.addEventListener("click", () => {
        const value = btn.dataset.value;

        state.safety = state.safety.includes(value)
          ? state.safety.filter((x) => x !== value)
          : [...state.safety, value];

        render();
      })
    );

    $("#ocp-persona-other").addEventListener("input", (event) => {
      state.personaOther = event.target.value.trimStart().slice(0, 120);
      $("#ocp-error").hidden = true;
    });

    $("#ocp-intent-other").addEventListener("input", (event) => {
      state.intentOther = event.target.value.trimStart().slice(0, 120);
      $("#ocp-error").hidden = true;
    });

    $("#ocp-form").addEventListener("submit", (event) => {
      event.preventDefault();

      let missing = "";

      if (!state.region) missing = "region";
      else if (!state.persona) missing = "persona";
      else if (state.persona === "other" && !state.personaOther.trim())
        missing = "persona";
      else if (!state.intent) missing = "intent";
      else if (state.intent === "other" && !state.intentOther.trim())
        missing = "intent";
      else if (!state.audience.length) missing = "audience";

      if (missing) {
        $("#ocp-error").hidden = false;

        $("#ocp-error").textContent = tr(
          "Please complete the required profile questions, including at least one main user group.",
          "Bitte beantworten Sie die erforderlichen Profilfragen und wählen Sie mindestens eine Hauptnutzergruppe."
        );

        $("#ocp-" + missing + "-group").scrollIntoView({
          behavior: "smooth",
          block: "center",
        });

        return;
      }

      const next = new URLSearchParams({
        lang,
        category: state.category,
        route: state.route,
        region: state.region,
        persona: state.persona,
        intent: state.intent,
        audience: state.audience.join(","),
      });

      if (state.persona === "other" && state.personaOther.trim()) {
        next.set("personaOther", state.personaOther.trim());
      }

      if (state.intent === "other" && state.intentOther.trim()) {
        next.set("intentOther", state.intentOther.trim());
      }

      if (state.safety.length) {
        next.set("safety", state.safety.join(","));
      }

      location.assign(
        "/internet/reviews/step-3/?" + next.toString()
      );
    });

    render();
  })();
</script>

