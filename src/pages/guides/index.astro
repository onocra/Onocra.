---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const step2Path = getRelativeLocaleUrl(locale, "guides/step-2");
---

<Layout
  title="Interactive Diagnostics & Guidance | ONOCRA"
  description="Start with what you need today: quick help, reading, video learning, skills and certification, or peer guidance. ONOCRA guides you step by step."
>
  <Header />

  <main
    id="main-content"
    class="dg-step-page"
    data-step2-path={step2Path}
  >
    <section class="dg-shell" aria-labelledby="dg-title">
      <header class="dg-hero">
        <div>
          <p class="dg-eyebrow">Interactive D&amp;G Platform</p>
          <h1 id="dg-title">What do you want to do today?</h1>
          <p class="dg-subtitle">
            Choose your main purpose. We’ll narrow it down step by step and take you to the
            most relevant ONOCRA help, knowledge, learning or guidance.
          </p>

          <div class="dg-values" aria-label="ONOCRA guidance principles">
            <span>Simple</span>
            <i aria-hidden="true"></i>
            <span>Personalised</span>
            <i aria-hidden="true"></i>
            <span>Step by Step</span>
            <i aria-hidden="true"></i>
            <span>For Ordinary Householders</span>
          </div>
        </div>

        <aside class="dg-guide" aria-label="ONOCRA guide note">
          <div class="dg-guide-mark" aria-hidden="true">
            <svg viewBox="0 0 120 120" focusable="false">
              <path d="M18 73c6-23 22-38 45-40 13-1 24 5 34 18-11-1-20 3-27 13-8 11-20 19-38 22-10-1-16-6-14-13Z" fill="#d9edf5"/>
              <path d="M65 37c17-13 31-14 40-7-12 6-21 13-30 24" fill="#f4a22a"/>
              <circle cx="67" cy="44" r="3.2" fill="#153f4f"/>
              <path d="M18 78c-8 2-14 7-18 13 11 2 21 0 30-5" fill="#76a7c6"/>
            </svg>
          </div>
          <div class="dg-guide-copy">
            <strong class="dg-guide-title">Diagnostics &amp; Guides</strong>
            <p>
              I’ll guide you to the right section based on your needs. You can change your choice at any time.
            </p>
          </div>
        </aside>
      </header>

      <nav class="dg-progress" aria-label="Diagnostics and Guidance progress">
        <div class="dg-step is-active" aria-current="step">
          <span class="dg-step-number">1</span>
          <span><strong>Main purpose</strong><small>Choose what you want to do</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>
        <div class="dg-step">
          <span class="dg-step-number">2</span>
          <span><strong>Choose your area</strong><small>Relevant to your purpose</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>
        <div class="dg-step">
          <span class="dg-step-number">3</span>
          <span><strong>Choose a category</strong><small>More specific</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>
        <div class="dg-step">
          <span class="dg-step-number">4</span>
          <span><strong>Refine your need</strong><small>Exact topic or issue</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>
        <div class="dg-step">
          <span class="dg-step-number">5</span>
          <span><strong>Your ONOCRA platform</strong><small>Exact interaction you need</small></span>
        </div>
      </nav>

      <form class="dg-form" id="dg-step-one-form">
        <fieldset>
          <legend class="sr-only">Choose what you want to do today</legend>

          <div class="dg-card-grid">
            <label class="dg-card dg-card--blue">
              <input type="radio" name="dg-zone" value="quick-help" />
              <span class="dg-card-radio" aria-hidden="true"></span>

              <span class="dg-card-visual">
                <span class="dg-icon-badge">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.7 6.3a4.7 4.7 0 0 0-5.8 5.8L3 18l3 3 5.9-5.9a4.7 4.7 0 0 0 5.8-5.8l-3 3-3-3 3-3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="dg-scene dg-scene--phone" aria-hidden="true">
                  <span class="scene-device phone"><i></i><b></b></span>
                  <span class="scene-orb"></span>
                </span>
              </span>

              <span class="dg-card-copy">
                <span class="dg-card-title">Fix a Problem</span>
                <span class="dg-card-tag">(Quick Help)</span>
                <span class="dg-card-desc">Get quick, step-by-step help to solve an issue with your device, internet, account or app.</span>
                <span class="dg-card-points">
                  <span>Common problems and fixes</span>
                  <span>Troubleshooting guidance</span>
                  <span>Quick and practical steps</span>
                </span>
              </span>
            </label>

            <label class="dg-card dg-card--green">
              <input type="radio" name="dg-zone" value="read-learn" />
              <span class="dg-card-radio" aria-hidden="true"></span>

              <span class="dg-card-visual">
                <span class="dg-icon-badge">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22V5.5ZM20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22V5.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="dg-scene dg-scene--read" aria-hidden="true">
                  <span class="scene-book"><i></i><i></i></span>
                  <span class="scene-orb"></span>
                </span>
              </span>

              <span class="dg-card-copy">
                <span class="dg-card-title">Read and Learn</span>
                <span class="dg-card-tag">(Knowledge Hub)</span>
                <span class="dg-card-desc">Learn through easy guides, articles and explainers that make everyday technology clearer.</span>
                <span class="dg-card-points">
                  <span>Easy-to-follow articles</span>
                  <span>Step-by-step guides</span>
                  <span>Plain-language explanations</span>
                </span>
              </span>
            </label>

            <label class="dg-card dg-card--red">
              <input type="radio" name="dg-zone" value="watch-learn" />
              <span class="dg-card-radio" aria-hidden="true"></span>

              <span class="dg-card-visual">
                <span class="dg-icon-badge">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.7"/>
                    <path d="m10 9 5 3-5 3V9Z" fill="currentColor"/>
                  </svg>
                </span>
                <span class="dg-scene dg-scene--video" aria-hidden="true">
                  <span class="scene-screen"><i></i></span>
                  <span class="scene-play"></span>
                </span>
              </span>

              <span class="dg-card-copy">
                <span class="dg-card-title">Watch and Learn</span>
                <span class="dg-card-tag">(Video Learning)</span>
                <span class="dg-card-desc">Watch short explainers, demonstrations and expert-led visual guidance.</span>
                <span class="dg-card-points">
                  <span>Short explainer videos</span>
                  <span>Demos and tutorials</span>
                  <span>Topic and skill playlists</span>
                </span>
              </span>
            </label>

            <label class="dg-card dg-card--gold">
              <input type="radio" name="dg-zone" value="build-skills" />
              <span class="dg-card-radio" aria-hidden="true"></span>

              <span class="dg-card-visual">
                <span class="dg-icon-badge">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m2 8 10-5 10 5-10 5L2 8Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                    <path d="M6 10.5V16c3.5 2.7 8.5 2.7 12 0v-5.5M22 8v6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  </svg>
                </span>
                <span class="dg-scene dg-scene--skills" aria-hidden="true">
                  <span class="scene-cap"><i></i><b></b></span>
                  <span class="scene-orb"></span>
                </span>
              </span>

              <span class="dg-card-copy">
                <span class="dg-card-title">Build My Skills</span>
                <span class="dg-card-tag">(Certification)</span>
                <span class="dg-card-desc">Take structured learning from basics to advanced skills, with professional certification pathways where relevant.</span>
                <span class="dg-card-points">
                  <span>Basic to advanced learning</span>
                  <span>Practical skills development</span>
                  <span>Certification pathways</span>
                </span>
              </span>
            </label>

            <label class="dg-card dg-card--purple">
              <input type="radio" name="dg-zone" value="peer-guidance" />
              <span class="dg-card-radio" aria-hidden="true"></span>

              <span class="dg-card-visual">
                <span class="dg-icon-badge">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.7"/>
                    <circle cx="17" cy="9" r="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M2.5 20c.8-4 3-6 5.5-6s4.8 2 5.5 6M13.3 19c.6-3 2.1-4.7 4.2-4.7 2 0 3.7 1.7 4 4.7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  </svg>
                </span>
                <span class="dg-scene dg-scene--peers" aria-hidden="true">
                  <span class="scene-people"><i></i><i></i><i></i></span>
                  <span class="scene-orb"></span>
                </span>
              </span>

              <span class="dg-card-copy">
                <span class="dg-card-title">Peer Guidance</span>
                <span class="dg-card-tag">(Discuss &amp; Get Advice)</span>
                <span class="dg-card-desc">Ask questions, share experience and get practical guidance from the ONOCRA community and experts.</span>
                <span class="dg-card-points">
                  <span>Ask a question</span>
                  <span>Learn from community experience</span>
                  <span>Join focused discussions</span>
                </span>
              </span>
            </label>
          </div>
        </fieldset>

        <div class="dg-footer-row">
          <div class="dg-unsure">
            <span class="dg-bulb" aria-hidden="true">?</span>
            <p>
              <strong>Not sure yet?</strong>
              Choose the option that feels closest to what you want to do. Step 2 will narrow it down.
            </p>
          </div>

          <button type="submit" class="dg-continue" disabled>
            Continue to Step 2
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <p class="dg-selection-status" id="dg-selection-status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#dg-step-one-form");
  const page = document.querySelector<HTMLElement>("[data-step2-path]");
  const continueButton = form?.querySelector<HTMLButtonElement>(".dg-continue") ?? null;
  const status = document.querySelector<HTMLElement>("#dg-selection-status");
  const radios =
    form?.querySelectorAll<HTMLInputElement>('input[name="dg-zone"]') ??
    document.querySelectorAll<HTMLInputElement>('input[name="dg-zone"]');

  const labels: Record<string, string> = {
    "quick-help": "Fix a Problem",
    "read-learn": "Read and Learn",
    "watch-learn": "Watch and Learn",
    "build-skills": "Build My Skills",
    "peer-guidance": "Peer Guidance",
  };

  let selectedZone = "";

  radios.forEach((radio) => {
    radio.addEventListener("change", () => {
      selectedZone = radio.value;

      if (continueButton) {
        continueButton.disabled = false;
      }

      document.querySelectorAll<HTMLElement>(".dg-card").forEach((card) => {
        card.classList.remove("is-selected");
      });

      radio.closest<HTMLElement>(".dg-card")?.classList.add("is-selected");

      if (status) {
        status.textContent = `${labels[selectedZone] ?? "Option"} selected. Continue to Step 2.`;
      }
    });
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (!selectedZone || !page) {
      return;
    }

    try {
      sessionStorage.setItem("onocra-dg-zone", selectedZone);
    } catch {
      // Continue even if session storage is unavailable.
    }

    const step2Path =
      page.getAttribute("data-step2-path") || "/guides/step-2/";

    const target = new URL(step2Path, window.location.origin);
    target.searchParams.set("zone", selectedZone);

    window.location.href = target.toString();
  });
</script>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 90% 9%, rgba(163, 207, 168, 0.13), transparent 25rem),
      linear-gradient(180deg, #fffef9 0%, #fbfaf5 100%);
  }

  .dg-step-page {
    --dg-forest: #0d584b;
    --dg-forest-2: #164d43;
    --dg-ink: #173d48;
    --dg-muted: #5f7180;
    --dg-line: #d9e4dc;
    --dg-orange: #f47a17;
    --dg-cream: #fffdf6;
    padding: clamp(1rem, 2.2vw, 2rem);
  }

  .dg-shell {
    width: min(1540px, 100%);
    margin: 0 auto;
  }

  .dg-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 1.05rem;
  }

  .dg-eyebrow {
    margin: 0 0 .3rem;
    color: var(--dg-orange);
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .dg-hero h1 {
    margin: 0;
    color: var(--dg-forest-2);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.25rem, 4.4vw, 4.5rem);
    line-height: .98;
    letter-spacing: -.035em;
  }

  .dg-subtitle {
    max-width: 950px;
    margin: .8rem 0 0;
    color: #556b79;
    font-size: clamp(.85rem, 1.15vw, 1.02rem);
    line-height: 1.58;
  }

  .dg-values {
    display: inline-flex;
    flex-wrap: wrap;
    gap: .55rem .8rem;
    align-items: center;
    margin-top: 1rem;
    padding: .55rem 1rem;
    border: 1px solid #d5e5d7;
    border-radius: 999px;
    background: #f2f8ef;
    color: #244f47;
    font-size: .83rem;
    font-weight: 700;
  }

  .dg-values i {
    width: .3rem;
    height: .3rem;
    border-radius: 50%;
    background: #3c7e6d;
  }

  .dg-guide {
    display: flex;
    gap: .75rem;
    align-items: center;
    padding: .9rem 1rem;
    border: 1px solid #cadccf;
    border-radius: 1.15rem;
    background: linear-gradient(135deg, #f9fcf7, #eef7ef);
    box-shadow: 0 12px 30px rgba(30, 73, 63, .07);
  }

  .dg-guide-mark {
    flex: 0 0 70px;
  }

  .dg-guide p {
    margin: 0;
    color: #274f4a;
    font-size: .72rem;
    line-height: 1.45;
  }

  .dg-progress {
    display: grid;
    grid-template-columns: 1fr 28px 1fr 28px 1fr 28px 1fr 28px 1fr;
    align-items: center;
    margin: 0 0 1.25rem;
  }

  .dg-step {
    min-height: 68px;
    display: flex;
    gap: .7rem;
    align-items: center;
    padding: .56rem .68rem;
    border: 1px solid #e2e7e3;
    border-radius: 1.05rem;
    background: rgba(255,255,255,.74);
    color: #8a959c;
  }

  .dg-step.is-active {
    border-color: #c7ddca;
    background: #edf7eb;
    color: #214f47;
  }

  .dg-step-number {
    display: grid;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 50%;
    background: #aab2b5;
    color: #fff;
    font-family: Georgia, serif;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .dg-step.is-active .dg-step-number {
    background: var(--dg-forest);
  }

  .dg-step strong,
  .dg-step small {
    display: block;
  }

  .dg-step strong {
    font-family: Georgia, serif;
    font-size: .84rem;
  }

  .dg-step small {
    margin-top: .12rem;
    font-size: .6rem;
    line-height: 1.25;
  }

  .dg-connector {
    height: 2px;
    background: #c8d0cd;
  }

  .dg-form {
    padding: clamp(1rem, 1.5vw, 1.45rem);
    border: 1px solid #e1dfd4;
    border-radius: 1.4rem;
    background: rgba(255,253,247,.9);
    box-shadow: 0 16px 38px rgba(45, 73, 65, .06);
  }

  .dg-form fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .dg-card-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: .75rem;
  }

  .dg-card {
    --card-accent: #168de2;
    --card-tint: #eef7fd;
    position: relative;
    display: flex;
    min-height: 308px;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 1.15rem;
    background: linear-gradient(180deg, rgba(255,255,255,.96), var(--card-tint));
    box-shadow: 0 10px 26px rgba(21, 66, 75, .07);
    cursor: pointer;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .dg-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 34px rgba(21, 66, 75, .11);
  }

  .dg-card:focus-within {
    outline: 3px solid rgba(14, 88, 75, .2);
    outline-offset: 3px;
  }

  .dg-card.is-selected {
    border-color: var(--card-accent);
    box-shadow: 0 18px 38px rgba(21, 66, 75, .14);
  }

  .dg-card--green { --card-accent: #159150; --card-tint: #eef8ef; }
  .dg-card--red { --card-accent: #e93232; --card-tint: #fdf1ef; }
  .dg-card--gold { --card-accent: #d99a13; --card-tint: #fff8e7; }
  .dg-card--purple { --card-accent: #6944bd; --card-tint: #f5f0fd; }

  .dg-card input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .dg-card-radio {
    position: absolute;
    z-index: 4;
    top: .85rem;
    right: .85rem;
    width: 1.55rem;
    height: 1.55rem;
    border: 2px solid #8fa7b3;
    border-radius: 50%;
    background: #fff;
  }

  .dg-card.is-selected .dg-card-radio {
    border-color: var(--card-accent);
    box-shadow: inset 0 0 0 5px #fff;
    background: var(--card-accent);
  }

  .dg-card-visual {
    position: relative;
    display: block;
    height: 112px;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 30%, rgba(255,255,255,.8), transparent 38%),
      linear-gradient(135deg, var(--card-tint), #fff);
  }

  .dg-icon-badge {
    position: absolute;
    z-index: 3;
    left: .8rem;
    bottom: -.02rem;
    display: grid;
    width: 3.35rem;
    height: 3.35rem;
    place-items: center;
    border: 4px solid #fff;
    border-radius: 50%;
    background: var(--card-accent);
    color: #fff;
    box-shadow: 0 5px 12px rgba(0,0,0,.12);
  }

  .dg-icon-badge svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .dg-scene {
    position: absolute;
    inset: 0;
  }

  .scene-orb {
    position: absolute;
    right: -1.2rem;
    top: -1.4rem;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--card-accent) 13%, transparent);
  }

  .scene-device.phone {
    position: absolute;
    left: 50%;
    top: 18px;
    width: 68px;
    height: 112px;
    transform: translateX(-50%) rotate(-4deg);
    border: 5px solid #163f53;
    border-radius: 15px;
    background: linear-gradient(145deg, #55bdea, #2d5aaf 45%, #8fcf9e);
    box-shadow: 0 10px 22px rgba(26, 70, 91, .18);
  }

  .scene-device.phone i,
  .scene-device.phone b {
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,.9);
  }

  .scene-device.phone i { width: 14px; height: 14px; left: 12px; top: 26px; box-shadow: 22px 0 0 rgba(255,255,255,.88), 0 24px 0 rgba(255,255,255,.75), 22px 24px 0 rgba(255,255,255,.8); }
  .scene-device.phone b { width: 18px; height: 4px; left: 20px; top: 7px; border-radius: 999px; }

  .scene-book {
    position: absolute;
    left: 50%;
    top: 44px;
    width: 108px;
    height: 68px;
    transform: translateX(-50%);
    border-radius: 8px 8px 14px 14px;
    background: #fff;
    box-shadow: 0 12px 24px rgba(27, 80, 58, .15);
  }

  .scene-book i {
    position: absolute;
    top: 8px;
    width: 45%;
    height: 54px;
    border: 2px solid #61a977;
    background: repeating-linear-gradient(180deg, #fff 0 8px, #d9eedf 8px 10px);
  }

  .scene-book i:first-child { left: 5px; transform: skewY(3deg); }
  .scene-book i:last-child { right: 5px; transform: skewY(-3deg); }

  .scene-screen {
    position: absolute;
    left: 50%;
    top: 30px;
    width: 132px;
    height: 82px;
    transform: translateX(-50%);
    border: 6px solid #243e55;
    border-radius: 9px;
    background: linear-gradient(145deg, #f35a5a, #d73863 47%, #6e4aba);
    box-shadow: 0 12px 24px rgba(61, 42, 76, .18);
  }

  .scene-screen i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform: translate(-40%, -50%);
    border-top: 14px solid transparent;
    border-bottom: 14px solid transparent;
    border-left: 22px solid #fff;
  }

  .scene-play {
    position: absolute;
    left: calc(50% - 20px);
    top: 113px;
    width: 40px;
    height: 5px;
    border-radius: 999px;
    background: #233d51;
  }

  .scene-cap {
    position: absolute;
    left: 50%;
    top: 48px;
    width: 118px;
    height: 48px;
    transform: translateX(-50%);
  }

  .scene-cap::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0;
    width: 106px;
    height: 54px;
    transform: rotate(-2deg) skewX(-18deg);
