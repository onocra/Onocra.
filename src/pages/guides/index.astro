---
/**
 * ONOCRA · Knowledge Base › Smartphones › Guides
 * Path: src/pages/guides/index.astro
 *
 * Edit the `sections` array below to add, remove or re-tag guides.
 * Assets expected in /public:
 *   /images/brand/onocra-icon-64.webp        (green "O." tile, small marks)
 *   /images/brand/onocra-pelican-256.webp    (pelican signature)
 *   /downloads/guides/...                    (your files; items with `soon: true` have no file yet,
 *                                             remove that flag once the file is in the folder)
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'en';
const url = (path: string) => getRelativeLocaleUrl(locale, path);

type Action = { label: string; href: string; download?: boolean; external?: boolean };
type Item = {
  format: 'HTML' | 'DOCX' | 'PDF';
  title: string;
  note?: string;
  tags?: string[];
  actions: Action[];
  preview?: boolean;
  /** No file uploaded yet: shows "Coming soon" instead of a download link */
  soon?: boolean;
};
type Section = { id: string; icon: string; title: string; items: Item[] };

const sections: Section[] = [
  {
    id: 'core',
    icon: '📊',
    title: 'Core Reference Toolkits',
    items: [
      {
        format: 'HTML',
        title: 'Smartphone Troubleshooting Master Matrix',
        note: '(Interactive v1.2)',
        preview: true,
        soon: true,
        actions: [
          { label: 'Download HTML Source', href: '/downloads/guides/smartphone-troubleshooting-matrix-v1.2.html', download: true },
          { label: 'Launch Web View', href: url('guides/smartphone-matrix') },
        ],
      },
      {
        format: 'DOCX',
        title: 'Smartphone Troubleshooting Master Matrix',
        note: '(Printable Grid)',
        soon: true,
        actions: [
          { label: 'Download DOCX (Matrix)', href: '/downloads/guides/Smartphone_Troubleshooting_Master_Matrix.docx', download: true },
        ],
      },
    ],
  },
  {
    id: 'platform',
    icon: '⚙️',
    title: 'Platform-Specific Operations (iOS & Android)',
    items: [
      {
        format: 'PDF',
        title: 'Device Migration & Secure Cross-Platform Data Transfer',
        tags: ['iOS to Android', 'Contacts', 'Photos'],
        actions: [{ label: 'Download PDF', href: '/downloads/guides/Device_Migration_and_Secure_Data_Transfer.pdf', download: true }],
      },
      {
        format: 'PDF',
        title: 'Battery Optimization, Background Refreshes & Lifespan',
        tags: ['Universal', 'Power Management'],
        soon: true,
        actions: [{ label: 'Download PDF', href: '/downloads/guides/battery-optimization.pdf', download: true }],
      },
      {
        format: 'PDF',
        title: 'Performance Recovery: Cache Partition Flushing & Factory Resets',
        tags: ['Android', 'System Recovery'],
        actions: [{ label: 'Download PDF', href: '/downloads/guides/Performance_Recovery_and_Cache_Management.pdf', download: true }],
      },
    ],
  },
  {
    id: 'regional',
    icon: '⚖️',
    title: 'Regional Compliance, Security, & Repair Laws',
    items: [
      {
        format: 'DOCX',
        title: 'IMEI Asset Registry & Post-Theft Lock Protocols',
        tags: ['US/EU/UK', 'Anti-Theft'],
        actions: [{ label: 'Download DOCX', href: '/downloads/guides/IMEI_Registry_and_Anti_Theft_Protocols.docx', download: true }],
      },
      {
        format: 'PDF',
        title: 'Right-to-Repair Component Serialization & Software Calibration',
        tags: ['EU/US', 'Hardware Calibration'],
        actions: [{ label: 'Download PDF', href: '/downloads/guides/Right_to_Repair_and_Parts_Serialization_Guide.pdf', download: true }],
      },
      {
        format: 'PDF',
        title: 'Carrier Restrictions: SIM Lock Policies & Tenure Contracts',
        tags: ['US/UK/EU', 'SIM Lock', 'Legal'],
        actions: [{ label: 'Download PDF', href: '/downloads/guides/Regional_Carrier_Unlock_and_SIM_Regulations.pdf', download: true }],
      },
    ],
  },
];

const formats = ['All', 'HTML', 'DOCX', 'PDF'];
const total = sections.reduce((n, s) => n + s.items.length, 0);

// One lowercase string per item powers the search box.
const searchText = (s: Section, i: Item) =>
  [i.format, i.title, i.note, ...(i.tags ?? []), s.title].join(' ').toLowerCase();
---

<Layout
  title="Smartphone Guides | ONOCRA Knowledge Base"
  description="The official master matrix index for smartphone troubleshooting, regional compliance, security and hardware protocols."
>
  <Header />

  <main class="guides" id="guides">
    <!-- Breadcrumb -->
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href={url('')}>
            <img src="/images/brand/onocra-icon-64.webp" width="28" height="28" alt="" decoding="async" />
            <span>Knowledge Base</span>
          </a>
        </li>
        <li aria-hidden="true" class="sep">›</li>
        <li><a href={url('phones')}><span aria-hidden="true">📱</span> Smartphones</a></li>
        <li aria-hidden="true" class="sep">›</li>
        <li aria-current="page"><span aria-hidden="true">📄</span> Guides</li>
      </ol>
    </nav>

    <h1 class="sr-only">Smartphone Guides</h1>

    <!-- Intro banner with pelican signature -->
    <section class="intro" aria-label="About this index">
      <p>The official master matrix index for troubleshooting, regional compliance, security, and hardware protocols.</p>
      <img
        class="intro-mark"
        src="/images/brand/onocra-pelican-256.webp"
        width="72"
        height="72"
        alt="ONOCRA pelican emblem"
        loading="lazy"
        decoding="async"
      />
    </section>

    <!-- Search + format filter -->
    <div class="tools" role="search">
      <label class="search">
        <span class="sr-only">Search guidelines, file formats, or platform</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input id="guide-search" type="search" placeholder="Search guidelines, file formats, or platform (e.g., IMEI)…" autocomplete="off" />
      </label>
      <div class="chips" role="group" aria-label="Filter by file format">
        {formats.map((f, i) => (
          <button type="button" class="chip" data-format={f} aria-pressed={i === 0 ? 'true' : 'false'}>{f}</button>
        ))}
      </div>
      <p class="status" id="guide-status" role="status" aria-live="polite">{total} guides</p>
    </div>

    <!-- Sections -->
    {sections.map((s) => (
      <section class="group" data-group aria-labelledby={`h-${s.id}`}>
        <h2 id={`h-${s.id}`} class="group-bar"><span aria-hidden="true">{s.icon}</span> {s.title}</h2>
        <ul class="rows">
          {s.items.map((i) => (
            <li class="row" data-item data-format={i.format} data-search={searchText(s, i)} data-soon={i.soon ? '' : undefined}>
              <span class={`fmt fmt-${i.format.toLowerCase()}`} title={`${i.format} file`}>{i.format}</span>

              <div class="main">
                <p class="title">
                  {i.title}
                  {i.note && <span class="note">{i.note}</span>}
                </p>

                {i.preview && (
                  <div class="previews" aria-hidden="true">
                    <div class="mini"><i></i><b></b><b></b><b></b><b></b></div>
                    <div class="mini alt"><i></i><b></b><b></b><b></b><b></b></div>
                  </div>
                )}
              </div>

              {i.tags && (
                <ul class="tags" aria-label="Topics">
                  {i.tags.map((t) => <li>{t}</li>)}
                </ul>
              )}

              <div class="actions">
                {i.soon ? (
                  <span class="soon">Coming soon</span>
                ) : (
                  i.actions.map((a) => (
                    <a
                      href={a.href}
                      download={a.download ? '' : undefined}
                      target={a.external ? '_blank' : undefined}
                      rel={a.external ? 'noopener noreferrer' : undefined}
                    >{a.label}</a>
                  ))
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="empty" id="guide-empty" hidden>No guides match that search. Try a platform (iOS, Android), a format (PDF, DOCX), or a topic such as IMEI.</p>

    <!-- Signature footer -->
    <aside class="signoff">
      <img src="/images/brand/onocra-pelican-96.webp" width="48" height="48" alt="" loading="lazy" decoding="async" />
      <p>
        Guides are written for householders in the US and EU. Regional rules differ, so check the
        <em>Regional Compliance</em> notes before acting on carrier, repair or theft procedures.
      </p>
    </aside>
  </main>

  <Footer />
</Layout>

<style>
  /* ---------- Tokens (fall back gracefully if brand vars are absent) ---------- */
  .guides {
    --g-card: #ffffff;
    --g-text: #12261c;
    --g-muted: #4b5f54;
    --g-line: #d5e0d7;
    --g-bar: var(--onocra-forest, #12452d);
    --g-bar-text: #f7f3e8;
    --g-mint: #d6efe3;
    --g-mint-text: #0f3d2a;
    --g-accent: #f29b1d;
    --g-focus: #1a7f4e;
    --g-pdf: #c0392b;
    --g-docx: #2b6cb0;
    --g-html: #2f855a;

    max-width: 68rem;
    margin: 0 auto;
    padding: 1.25rem 1rem 3.5rem;
    color: var(--g-text);
  }
  :global(.dark) .guides,
  :global([data-theme='dark']) .guides {
    --g-card: #16211c;
    --g-text: #e8efe9;
    --g-muted: #a7b8ad;
    --g-line: #2c3b33;
    --g-bar: #0d2a1d;
    --g-mint: #1b3a2c;
    --g-mint-text: #cfeedd;
    --g-focus: #6fd3a0;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ---------- Breadcrumb ---------- */
  .crumbs ol {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    list-style: none; margin: 0 0 1rem; padding: 0;
    font-family: var(--font-heading, 'Georgia', serif);
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    font-weight: 800; letter-spacing: 0.01em; text-transform: uppercase;
  }
  .crumbs a { display: inline-flex; align-items: center; gap: 0.45rem; color: inherit; text-decoration: none; }
  .crumbs a:hover span { text-decoration: underline; text-underline-offset: 4px; }
  .crumbs img { border-radius: 8px; }
  .crumbs .sep { color: var(--g-muted); font-weight: 400; }

  /* ---------- Intro ---------- */
  .intro {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    background: var(--g-mint); color: var(--g-mint-text);
    border-radius: 14px; padding: 0.9rem 1.1rem; margin-bottom: 1rem;
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.04);
  }
  .intro p { margin: 0; font-size: 1.02rem; line-height: 1.45; }
  .intro-mark { flex: none; width: 56px; height: 56px; object-fit: contain; }

  /* ---------- Search + chips ---------- */
  .tools { display: grid; gap: 0.6rem; margin-bottom: 1.25rem; }
  .search {
    display: flex; align-items: center; gap: 0.6rem;
    background: var(--g-card); border: 1px solid var(--g-line); border-radius: 12px;
    padding: 0.65rem 0.9rem; color: var(--g-muted);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.05);
  }
  .search:focus-within { outline: 2px solid var(--g-focus); outline-offset: 2px; }
  .search input {
    flex: 1; min-width: 0; border: 0; background: transparent; outline: none;
    color: var(--g-text); font: inherit;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    border: 1px solid var(--g-line); background: var(--g-card); color: var(--g-text);
    border-radius: 999px; padding: 0.3rem 0.85rem; font: inherit; font-size: 0.85rem; cursor: pointer;
  }
  .chip[aria-pressed='true'] { background: var(--g-bar); color: var(--g-bar-text); border-color: var(--g-bar); }
  .chip:focus-visible, .actions a:focus-visible { outline: 2px solid var(--g-focus); outline-offset: 2px; }
  .status { margin: 0; font-size: 0.82rem; color: var(--g-muted); }

  /* ---------- Section blocks ---------- */
  .group {
    background: var(--g-card); border: 1px solid var(--g-line); border-radius: 14px;
    overflow: hidden; margin-bottom: 1.1rem; box-shadow: 0 2px 10px rgb(0 0 0 / 0.04);
  }
  .group[hidden] { display: none; }
  .group-bar {
    margin: 0; padding: 0.7rem 1rem; background: var(--g-bar); color: var(--g-bar-text);
    font-family: var(--font-heading, 'Georgia', serif);
    font-size: 1.05rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase;
  }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: start; gap: 0.4rem 0.9rem;
    padding: 0.75rem 1rem; border-top: 1px solid var(--g-line);
  }
  .row:first-child { border-top: 0; }
  .row[hidden] { display: none; }

  /* Format badge: replaces the "[ PDF ]" prefix from the mockup */
  .fmt {
    display: inline-grid; place-items: center; min-width: 3rem; padding: 0.15rem 0.4rem;
    border-radius: 6px; color: #fff; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em;
    margin-top: 0.2rem;
  }
  .fmt-pdf { background: var(--g-pdf); }
  .fmt-docx { background: var(--g-docx); }
  .fmt-html { background: var(--g-html); }

  .title { margin: 0; font-weight: 700; font-size: 1.02rem; line-height: 1.35; }
  .note { margin-left: 0.4rem; font-weight: 400; color: var(--g-muted); }

  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; margin: 0; padding: 0; justify-content: flex-end; }
  .tags li {
    background: var(--g-mint); color: var(--g-mint-text);
    border-radius: 6px; padding: 0.12rem 0.5rem; font-size: 0.78rem; white-space: nowrap;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: flex-end; }
  .actions a {
    border: 1px solid var(--g-line); border-radius: 8px; padding: 0.25rem 0.65rem;
    font-size: 0.82rem; font-weight: 600; color: var(--g-text); text-decoration: none; white-space: nowrap;
  }
  .actions a:hover { background: var(--g-mint); border-color: transparent; color: var(--g-mint-text); }
  .soon {
    border: 1px dashed var(--g-line); border-radius: 8px; padding: 0.25rem 0.65rem;
    font-size: 0.82rem; font-style: italic; color: var(--g-muted); white-space: nowrap;
  }
  .row[data-soon] .title { color: var(--g-muted); }
  /* Rows with no tags let the actions take the tag column too */
  .row:not(:has(.tags)) .actions { grid-column: 3 / -1; }

  /* ---------- Matrix thumbnails (pure CSS, no image files) ---------- */
  .previews { display: flex; gap: 0.6rem; margin-top: 0.55rem; }
  .mini {
    width: 8.5rem; height: 3.1rem; padding: 0.3rem; border: 1px solid var(--g-line); border-radius: 6px;
    display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 0.35rem; gap: 0.2rem;
    background: var(--g-card);
  }
  .mini i { grid-column: 1 / -1; background: var(--g-bar); border-radius: 2px; }
  .mini b { background: var(--g-line); border-radius: 2px; }
  .mini.alt b:nth-child(odd) { background: color-mix(in srgb, var(--g-accent) 55%, var(--g-line)); }

  /* ---------- Empty state & signature ---------- */
  .empty { text-align: center; padding: 2rem 1rem; color: var(--g-muted); }
  .signoff {
    display: flex; align-items: center; gap: 0.9rem; margin-top: 1.75rem;
    padding-top: 1.1rem; border-top: 1px dashed var(--g-line); color: var(--g-muted); font-size: 0.9rem;
  }
  .signoff img { flex: none; }
  .signoff p { margin: 0; line-height: 1.5; }

  /* ---------- Responsive ---------- */
  @media (max-width: 760px) {
    .row { grid-template-columns: auto minmax(0, 1fr); }
    .tags, .actions, .row:not(:has(.tags)) .actions { grid-column: 2; justify-content: flex-start; }
    .intro-mark { width: 44px; height: 44px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .actions a, .chip { transition: background-color 0.15s ease, color 0.15s ease; }
  }
</style>

<script>
  // Live search + format filter. Works on the server-rendered markup, so the page
  // is fully readable without JavaScript.
  const input = document.querySelector<HTMLInputElement>('#guide-search');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
  const status = document.querySelector<HTMLElement>('#guide-status');
  const empty = document.querySelector<HTMLElement>('#guide-empty');

  let format = 'All';

  function apply() {
    const q = (input?.value ?? '').trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    let shown = 0;

    items.forEach((el) => {
      const hay = el.dataset.search ?? '';
      const okText = terms.every((t) => hay.includes(t));
      const okFormat = format === 'All' || el.dataset.format === format;
      const visible = okText && okFormat;
      el.hidden = !visible;
      if (visible) shown++;
    });

    groups.forEach((g) => {
      g.hidden = !g.querySelector('[data-item]:not([hidden])');
    });

    if (status) status.textContent = `${shown} ${shown === 1 ? 'guide' : 'guides'}`;
    if (empty) empty.hidden = shown !== 0;
  }

  input?.addEventListener('input', apply);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      format = chip.dataset.format ?? 'All';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    }),
  );
</script>
