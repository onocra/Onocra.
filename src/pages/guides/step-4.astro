  ]);

  const COMPUTER_CATEGORIES = new Set([
    "mac-computers",
    "all-in-one-pc",
    "mini-pc",
  ]);

  const resolveIssueData = (category: string): IssueData | undefined => {
    const label = CATEGORY_LABELS[category];
    if (!label) return undefined;

    let cards: IssueCard[] | undefined;

    if (category === "windows-pc") cards = WINDOWS_PC_ISSUES;
    else if (GAMING_CATEGORIES.has(category)) cards = GAMING_ISSUES;
    else if (SOFTWARE_CATEGORIES.has(category)) cards = SOFTWARE_ISSUES;
    else if (LAPTOP_CATEGORIES.has(category)) cards = LAPTOP_ISSUES;
    else if (MOBILE_CATEGORIES.has(category)) cards = MOBILE_ISSUES;
    else if (INTERNET_CATEGORIES.has(category)) cards = INTERNET_ISSUES;
    else if (WIFI_CATEGORIES.has(category)) cards = WIFI_ISSUES;
    else if (COMPUTER_CATEGORIES.has(category)) cards = COMPUTER_ISSUES;
    else if (SECURITY_ISSUES[category]) cards = SECURITY_ISSUES[category];
    else if (PARENTING_ISSUES[category]) cards = PARENTING_ISSUES[category];

    if (!cards) return undefined;

    const heading = category === "windows-pc"
      ? "What problem do you need help with on your Windows PC?"
      : `Which issue do you need help with for ${label}?`;

    return { label, heading, cards };
  };

  const page = document.querySelector<HTMLElement>(".dg-step-page")!;
  const grid = document.querySelector<HTMLElement>("#dg-issue-grid")!;
  const form = document.querySelector<HTMLFormElement>("#dg-step-four-form")!;
  const button = form.querySelector<HTMLButtonElement>(".dg-continue")!;
  const status = document.querySelector<HTMLElement>("#dg-status")!;
  const areaLabel = document.querySelector<HTMLElement>("#dg-area-label")!;
  const categoryLabel = document.querySelector<HTMLElement>("#dg-category-label")!;
  const heading = document.querySelector<HTMLElement>("#dg-issue-heading")!;
  const backLink = document.querySelector<HTMLAnchorElement>("#dg-back-link")!;

  const params = new URLSearchParams(window.location.search);
  let zone: string = params.get("zone") || "";
  let area: string = params.get("area") || "";
  let category: string = params.get("category") || "";
  let savedIssue: string = "";

  try {
    zone = zone || sessionStorage.getItem("onocra-dg-zone") || "";
    area = area || sessionStorage.getItem("onocra-dg-area") || "";
    category = category || sessionStorage.getItem("onocra-dg-category") || "";
    savedIssue = sessionStorage.getItem("onocra-dg-issue") || "";
  } catch {
    // Continue without sessionStorage.
  }

  if (!zone) zone = "quick-help";

  const data = resolveIssueData(category);

  const makeIcon = (name: string): string => {
    const content = ICONS[name] ?? ICONS.settings;
    return `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">${content}</svg>`;
  };

  const renderEmptyState = (): void => {
    grid.innerHTML = `
      <div class="dg-empty">
        <strong>We need your Step 3 selection first.</strong>
        <p>Go back to Step 3 and choose the category that best matches your need.</p>
      </div>
    `;
    button.disabled = true;
  };

  if (data && area) {
    areaLabel.textContent = AREA_LABELS[area] ?? area;
    categoryLabel.textContent = data.label;
    heading.textContent = data.heading;

    grid.innerHTML = data.cards.map((card: IssueCard, index: number) => `
      <label class="dg-card" style="--card-index:${index}">
        <input type="radio" name="dg-issue" value="${card.id}" />
        <span class="dg-card-select" aria-hidden="true"></span>
        <span class="dg-icon">${makeIcon(card.icon)}</span>
        <span class="dg-card-copy">
          <strong>${card.title}</strong>
        </span>
      </label>
    `).join("");

    const radios = grid.querySelectorAll<HTMLInputElement>('input[name="dg-issue"]');

    radios.forEach((radio) => {
      if (savedIssue && radio.value === savedIssue) {
        radio.checked = true;
        radio.closest<HTMLElement>(".dg-card")?.classList.add("is-selected");
        button.disabled = false;
        status.textContent = "Issue selected. Continue to Step 5.";
      }

      radio.addEventListener("change", () => {
        grid.querySelectorAll<HTMLElement>(".dg-card").forEach((card) => {
          card.classList.remove("is-selected");
        });

        radio.closest<HTMLElement>(".dg-card")?.classList.add("is-selected");
        button.disabled = false;
        status.textContent = "Issue selected. Continue to Step 5.";

        try {
          sessionStorage.setItem("onocra-dg-zone", zone);
          sessionStorage.setItem("onocra-dg-area", area);
          sessionStorage.setItem("onocra-dg-category", category);
          sessionStorage.setItem("onocra-dg-issue", radio.value);
        } catch {
          // Continue without sessionStorage.
        }
      });
    });
  } else {
    renderEmptyState();
  }

  const step3Path = page.getAttribute("data-step3-path") || "/guides/step-3/";
  const backUrl = new URL(step3Path, window.location.origin);
  backUrl.searchParams.set("zone", zone);
  backUrl.searchParams.set("area", area);
  backLink.href = backUrl.pathname + backUrl.search;

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    const selected = form.querySelector<HTMLInputElement>('input[name="dg-issue"]:checked');
    if (!selected || !area || !category) return;

    const step5Path = page.getAttribute("data-step5-path") || "/guides/step-5/";
    const target = new URL(step5Path, window.location.origin);

    target.searchParams.set("zone", zone);
    target.searchParams.set("area", area);
    target.searchParams.set("category", category);
    target.searchParams.set("issue", selected.value);

    window.location.href = target.toString();
  });
</script>

