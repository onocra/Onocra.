---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const step3Path = getRelativeLocaleUrl(locale, "guides/step-3");
const step5Path = getRelativeLocaleUrl(locale, "guides/step-5");
---

<Layout
  title="Quick Help — Step 4 | ONOCRA"
  description="Choose the exact issue that best matches your technology problem before opening the Quick Help Matrix."
>
  <Header />

  <main
    id="main-content"
    class="dg-step-page"
    data-step3-path={step3Path}
    data-step5-path={step5Path}
  >
    <section class="dg-shell" aria-labelledby="dg-step4-title">
      <header class="dg-hero">
        <div>
          <p class="dg-eyebrow">Interactive D&amp;G Platform · Quick Help</p>
          <h1 id="dg-step4-title"><span class="dg-title-number">4.</span> Choose the issue</h1>
        </div>

        <aside class="dg-guide" aria-label="ONOCRA guide note">
          <div class="dg-guide-mark" aria-hidden="true">
            <svg viewBox="0 0 120 120" focusable="false">
              <path d="M18 73c6-23 22-38 45-40 13-1 24 5 34 18-11-1-20 3-27 13-8 11-20 19-38 22-10-1-16-6-14-13Z" fill="#d9edf5"/>
              <path d="M65 37c17-13 31-14 40-7-12 6-21 13-30 24" fill="#f4a22a"/>
              <circle cx="67" cy="44" r="3.2" fill="#153f4f"/>
              <path d="M18 78c-8 2-14 7-18 13 11 2 21 0 30-5" fill="#76a7c6"/>
            </svg>
          </div>
          <div class="dg-guide-copy">
            <strong>Diagnostics &amp; Guides</strong>
            <p>Choose the issue that most closely matches what is happening. Step 5 will show the relevant Quick Help Matrix.</p>
          </div>
        </aside>
      </header>

      <nav class="dg-progress" aria-label="Diagnostics and Guidance progress">
        <div class="dg-step is-complete">
          <span class="dg-step-number">✓</span>
          <span><strong>1 · Main purpose</strong><small>Fix a Problem</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step is-complete">
          <span class="dg-step-number">✓</span>
          <span><strong>2 · Technology area</strong><small id="dg-area-label">Selected area</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step is-complete">
          <span class="dg-step-number">✓</span>
          <span><strong>3 · Category</strong><small id="dg-category-label">Selected category</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step is-active" aria-current="step">
          <span class="dg-step-number">4</span>
          <span><strong>Choose the issue</strong><small>Exact problem</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step">
          <span class="dg-step-number">5</span>
          <span><strong>Quick Help Matrix</strong><small>Relevant help only</small></span>
        </div>
      </nav>

      <form class="dg-form" id="dg-step-four-form">
        <div class="dg-section-heading">
          <div>
            <h2 id="dg-issue-heading">Which issue do you need help with?</h2>
          </div>
        </div>

        <fieldset>
          <legend class="sr-only">Choose an issue</legend>
          <div class="dg-card-grid" id="dg-issue-grid"></div>
        </fieldset>

        <div class="dg-footer-row">
          <a class="dg-back" id="dg-back-link" href={step3Path}>
            <span aria-hidden="true">←</span>
            Back to Step 3
          </a>

          <button type="submit" class="dg-continue" disabled>
            Continue to Step 5
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <p class="dg-status" id="dg-status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <Footer />
</Layout>

