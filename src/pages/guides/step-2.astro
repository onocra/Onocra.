---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const step1Path = getRelativeLocaleUrl(locale, "guides");
const step3Path = getRelativeLocaleUrl(locale, "guides/step-3");
---

<Layout
  title="Interactive D&G — Step 2 | ONOCRA"
  description="Choose the technology area most relevant to your selected ONOCRA route."
>
  <Header />

  <main
    id="main-content"
    class="dg-step-page"
    data-step1-path={step1Path}
    data-step3-path={step3Path}
  >
    <section class="dg-shell" aria-labelledby="dg-step2-title">
      <header class="dg-hero">
        <div>
          <p class="dg-eyebrow">Interactive D&amp;G Platform</p>
          <h1 id="dg-step2-title"><span class="dg-title-number">2.</span> Choose your technology area</h1>
        </div>

        <aside class="dg-guide" aria-label="ONOCRA guide note">
          <div class="dg-guide-mark" aria-hidden="true">
            <img
              class="dg-guide-pelican"
              src="/guides/pelican-guide.png"
              alt=""
              width="120"
              height="120"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="dg-guide-copy">
            <p id="dg-guide-copy">
              Choose the technology area closest to your need. I’ll guide you through the next step.
            </p>
          </div>
        </aside>
      </header>

      <nav class="dg-progress" aria-label="Diagnostics and Guidance progress">
        <div class="dg-step is-complete">
          <span class="dg-step-number">✓</span>
          <span><strong>1 · Main purpose</strong><small id="dg-purpose-label">Selected purpose</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step is-active" aria-current="step">
          <span class="dg-step-number">2</span>
          <span><strong>Choose your area</strong><small>Technology area</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step">
          <span class="dg-step-number">3</span>
          <span><strong>Choose a category</strong><small>More specific</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step">
          <span class="dg-step-number">4</span>
          <span><strong>Refine your need</strong><small>Exact topic or issue</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step">
          <span class="dg-step-number">5</span>
          <span><strong>Your ONOCRA platform</strong><small>Exact interaction you need</small></span>
        </div>
      </nav>

      <!-- Keep Step 1 form styling hook intentionally. -->
      <form class="dg-form" id="dg-step-one-form">
        <section class="dg-question-box" aria-labelledby="dg-area-heading">
          <h2 id="dg-area-heading">What would you like to watch and learn about?</h2>
          <p id="dg-area-intro">
            Choose the technology area for demonstrations, explainers and visual guidance.
          </p>
        </section>

        <fieldset>
          <legend class="sr-only">Choose a technology area</legend>
          <div class="dg-area-grid" id="dg-area-grid"></div>
        </fieldset>

        <div class="dg-footer-row dg-step2-footer">
          <a class="dg-back" id="dg-back-link" href={step1Path}>
            <span aria-hidden="true">←</span>
            Back to Step 1
          </a>

          <button type="submit" class="dg-continue" disabled>
            Continue to Step 3
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <p class="dg-selection-status" id="dg-status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  type AreaOption = {
    id: string;
    title: string;
    tone: string;
    scene: string;
  };

  type ZoneConfig = {
    label: string;
    heading: string;
    intro: string;
    guide: string;
    areas: AreaOption[];
  };

  const EIGHT_TECH_AREAS: AreaOption[] = [
    { id: "phones", title: "Phones", tone: "blue", scene: "phone" },
    { id: "tablets", title: "Tablets", tone: "green", scene: "tablet" },
    { id: "home-internet", title: "Home Internet", tone: "gold", scene: "internet" },
    { id: "home-wifi", title: "Home Wi‑Fi", tone: "purple", scene: "wifi" },
    { id: "computers", title: "Computers", tone: "red", scene: "computer" },
    { id: "laptops", title: "Laptops", tone: "blue", scene: "laptop" },
    { id: "digital-security", title: "Digital Security", tone: "green", scene: "security" },
    { id: "digital-parenting", title: "Digital Parenting", tone: "gold", scene: "parenting" },
  ];

  const SKILL_AREAS: AreaOption[] = [
    { id: "digital-skills-ai", title: "Digital Skills & AI", tone: "blue", scene: "skills" },
    { id: "it-support", title: "IT Support & Troubleshooting", tone: "green", scene: "computer" },
    { id: "networking-wifi", title: "Networking & Wi‑Fi", tone: "gold", scene: "wifi" },
    { id: "cybersecurity", title: "Digital Safety & Cybersecurity", tone: "purple", scene: "security" },
  ];

  const PEER_AREAS: AreaOption[] = [
    { id: "phones", title: "Phones & Tablets", tone: "blue", scene: "phone" },
    { id: "home-internet", title: "Internet & Wi‑Fi", tone: "green", scene: "wifi" },
    { id: "computers", title: "Computers & Laptops", tone: "gold", scene: "computer" },
    { id: "digital-security", title: "Digital Security", tone: "red", scene: "security" },
    { id: "learning-certification", title: "Learning & Certification", tone: "purple", scene: "skills" },
    { id: "general-tech", title: "General Technology", tone: "green", scene: "parenting" },
  ];

  const ZONE_CONFIG: Record<string, ZoneConfig> = {
    "quick-help": {
      label: "Fix a Problem",
      heading: "What do you need help with?",
      intro: "Choose the technology area closest to your problem.",
      guide: "Choose the technology area closest to your need. I’ll guide you through the next step.",
      areas: EIGHT_TECH_AREAS,
    },
    "read-learn": {
      label: "Read and Learn",
      heading: "What would you like to read and learn about?",
      intro: "Choose the technology area you want to understand better.",
      guide: "Choose the area you want to understand. I’ll guide you to the most relevant reading and learning route.",
      areas: EIGHT_TECH_AREAS,
    },
    "watch-learn": {
      label: "Watch and Learn",
      heading: "What would you like to watch and learn about?",
      intro: "Choose the technology area for demonstrations, explainers and visual guidance.",
      guide: "Choose the area you want to see explained or demonstrated. I’ll guide you to the right visual learning route.",
      areas: EIGHT_TECH_AREAS,
    },
    "build-skills": {
      label: "Build My Skills",
      heading: "Which skill area do you want to develop?",
      intro: "Choose the learning family that best matches the skills you want to build.",
      guide: "Choose the skill area closest to your goal. I’ll guide you toward the right structured learning route.",
      areas: SKILL_AREAS,
    },
    "peer-guidance": {
      label: "Peer Guidance",
      heading: "What would you like guidance or discussion about?",
      intro: "Choose the area closest to your question.",
      guide: "Choose the area closest to your question. I’ll guide you toward the right discussion and advice space.",
      areas: PEER_AREAS,
    },
  };

  const badgeIcon = (scene: string): string => {
    const icons: Record<string, string> = {
      phone: '<rect x="7" y="2.5" width="10" height="19" rx="2.2"/><path d="M10 18h4"/>',
      tablet: '<rect x="4" y="2.5" width="16" height="19" rx="2.2"/><circle cx="12" cy="18.5" r=".7" fill="currentColor" stroke="none"/>',
      internet: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.8 2.8 4.2 5.7 4.2 8.5S14.8 17.7 12 20.5c-2.8-2.8-4.2-5.7-4.2-8.5S9.2 6.3 12 3.5Z"/>',
      wifi: '<path d="M3 9c5-4 13-4 18 0M6 12.2c3.5-3 8.5-3 12 0M9 15.3c2-1.5 4-1.5 6 0"/><circle cx="12" cy="18.4" r="1.2" fill="currentColor" stroke="none"/>',
      computer: '<rect x="3" y="4" width="18" height="12" rx="1.7"/><path d="M8.5 20h7M12 16v4"/>',
      laptop: '<path d="M5 5h14v10H5z"/><path d="M3 18h18l-1.2 2H4.2L3 18Z"/>',
      security: '<path d="M12 3 4.5 6v5.8c0 4.7 3.2 7.7 7.5 9.2 4.3-1.5 7.5-4.5 7.5-9.2V6L12 3Z"/><path d="m9 12 2 2 4-4"/>',
      parenting: '<circle cx="8" cy="8" r="2.8"/><circle cx="17" cy="9" r="2.4"/><path d="M2.8 20c.8-3.8 2.9-5.8 5.2-5.8s4.5 2 5.2 5.8M13.5 19c.6-2.9 2-4.4 4-4.4 1.9 0 3.5 1.6 4 4.4"/>',
      skills: '<path d="m2.5 8 9.5-4.8L21.5 8 12 12.8 2.5 8Z"/><path d="M6 10.5V16c3.5 2.6 8.5 2.6 12 0v-5.5M21.5 8v6"/>',
    };

    const path = icons[scene] ?? icons.phone;
    return `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${path}</svg>`;
  };

  const illustration = (scene: string): string => {
    const markups: Record<string, string> = {
      phone: '<span class="art-phone"><i></i></span>',
      tablet: '<span class="art-tablet"><i></i></span>',
      internet: '<span class="art-globe"><i></i><b></b></span>',
      wifi: '<span class="art-wifi"><i></i><b></b><em></em><strong></strong></span>',
      computer: '<span class="art-monitor"><i></i></span>',
      laptop: '<span class="art-laptop"><i></i></span>',
      security: '<span class="art-shield"></span>',
      parenting: '<span class="art-family"><i></i><i></i><i></i></span>',
      skills: '<span class="art-skills"><i></i></span>',
    };
    return markups[scene] ?? markups.phone;
  };

  const page = document.querySelector<HTMLElement>(".dg-step-page")!;
  const form = document.querySelector<HTMLFormElement>("#dg-step-one-form")!;
  const grid = document.querySelector<HTMLElement>("#dg-area-grid")!;
  const continueButton = form.querySelector<HTMLButtonElement>(".dg-continue")!;
  const status = document.querySelector<HTMLElement>("#dg-status")!;
  const purposeLabel = document.querySelector<HTMLElement>("#dg-purpose-label")!;
  const heading = document.querySelector<HTMLElement>("#dg-area-heading")!;
  const intro = document.querySelector<HTMLElement>("#dg-area-intro")!;
  const guideCopy = document.querySelector<HTMLElement>("#dg-guide-copy")!;
  const backLink = document.querySelector<HTMLAnchorElement>("#dg-back-link")!;

  const params = new URLSearchParams(window.location.search);
  let zone = params.get("zone") || "";
  let savedArea = "";

  try {
    zone = zone || sessionStorage.getItem("onocra-dg-zone") || "";
    savedArea = sessionStorage.getItem("onocra-dg-area") || "";
  } catch {}

  if (!ZONE_CONFIG[zone]) zone = "quick-help";
  const config = ZONE_CONFIG[zone] ?? ZONE_CONFIG["quick-help"];

  purposeLabel.textContent = config.label;
  heading.textContent = config.heading;
  intro.textContent = config.intro;
  guideCopy.textContent = config.guide;

  grid.innerHTML = config.areas.map((area, index) => `
    <article class="dg-area-card dg-card--${area.tone} dg-area-card--${area.id}" data-area-card>
      <div class="dg-area-image" aria-hidden="true">
        <span class="dg-area-large-symbol dg-icon--${area.scene}">
          ${badgeIcon(area.scene)}
        </span>
      </div>

      <label class="dg-area-title" for="area-${area.id}">
        <input id="area-${area.id}" type="radio" name="dg-area" value="${area.id}" />
        <span class="dg-card-radio" aria-hidden="true"></span>
        <span class="dg-area-title-text">${area.title}</span>
      </label>
    </article>
  `).join("");

  const radios = grid.querySelectorAll<HTMLInputElement>('input[name="dg-area"]');

  radios.forEach((radio) => {
    if (savedArea && radio.value === savedArea && config.areas.some((item) => item.id === savedArea)) {
      radio.checked = true;
      radio.closest<HTMLElement>("[data-area-card]")?.classList.add("is-selected");
      continueButton.disabled = false;
    }

    radio.addEventListener("change", () => {
      grid.querySelectorAll<HTMLElement>("[data-area-card]").forEach((card) => card.classList.remove("is-selected"));
      radio.closest<HTMLElement>("[data-area-card]")?.classList.add("is-selected");
      continueButton.disabled = false;
      status.textContent = "Technology area selected. Continue to Step 3.";

      try {
        sessionStorage.setItem("onocra-dg-zone", zone);
        sessionStorage.setItem("onocra-dg-area", radio.value);
        sessionStorage.removeItem("onocra-dg-category");
        sessionStorage.removeItem("onocra-dg-issue");
      } catch {}
    });
  });

  backLink.href = page.getAttribute("data-step1-path") || "/guides/";

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    const selected = form.querySelector<HTMLInputElement>('input[name="dg-area"]:checked');
    if (!selected) return;

    const step3Path = page.getAttribute("data-step3-path") || "/guides/step-3/";
    const target = new URL(step3Path, window.location.origin);
    target.searchParams.set("zone", zone);
    target.searchParams.set("area", selected.value);

    window.location.href = target.toString();
  });
</script>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 90% 9%, rgba(163, 207, 168, 0.13), transparent 25rem),
      linear-gradient(180deg, #fffef9 0%, #fbfaf5 100%);
  }

  .dg-step-page {
    --dg-forest: #0d584b;
    --dg-forest-2: #164d43;
    --dg-ink: #173d48;
    --dg-muted: #5f7180;
    --dg-line: #d9e4dc;
    --dg-orange: #f47a17;
    --dg-cream: #fffdf6;
    padding: clamp(1rem, 2.2vw, 2rem);
  }

  .dg-shell {
    width: min(1540px, 100%);
    margin: 0 auto;
  }

  .dg-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 1.05rem;
  }

  .dg-eyebrow {
    margin: 0 0 .3rem;
    color: var(--dg-orange);
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .dg-hero h1 {
    margin: 0;
    color: var(--dg-forest-2);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.25rem, 4.4vw, 4.5rem);
    line-height: .98;
    letter-spacing: -.035em;
  }

  .dg-subtitle {
    max-width: 950px;
    margin: .8rem 0 0;
    color: #556b79;
    font-size: clamp(.85rem, 1.15vw, 1.02rem);
    line-height: 1.58;
  }

  .dg-values {
    display: inline-flex;
    flex-wrap: wrap;
    gap: .55rem .8rem;
    align-items: center;
    margin-top: 1rem;
    padding: .55rem 1rem;
    border: 1px solid #d5e5d7;
    border-radius: 999px;
    background: #f2f8ef;
    color: #244f47;
    font-size: .83rem;
    font-weight: 700;
  }

  .dg-values i {
    width: .3rem;
    height: .3rem;
    border-radius: 50%;
    background: #3c7e6d;
  }

  .dg-guide {
    display: flex;
    gap: .75rem;
    align-items: center;
    padding: .9rem 1rem;
    border: 1px solid #cadccf;
    border-radius: 1.15rem;
    background: linear-gradient(135deg, #f9fcf7, #eef7ef);
    box-shadow: 0 12px 30px rgba(30, 73, 63, .07);
  }

  .dg-guide-mark {
    flex: 0 0 70px;
  }

  .dg-guide p {
    margin: 0;
    color: #274f4a;
    font-size: .72rem;
    line-height: 1.45;
  }

  .dg-progress {
    display: grid;
    grid-template-columns: 1fr 28px 1fr 28px 1fr 28px 1fr 28px 1fr;
    align-items: center;
    margin: 0 0 1.25rem;
  }

  .dg-step {
    min-height: 68px;
    display: flex;
    gap: .7rem;
    align-items: center;
    padding: .56rem .68rem;
    border: 1px solid #e2e7e3;
    border-radius: 1.05rem;
    background: rgba(255,255,255,.74);
    color: #8a959c;
  }

  .dg-step.is-active {
    border-color: #c7ddca;
    background: #edf7eb;
    color: #214f47;
  }

  .dg-step-number {
    display: grid;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 50%;
    background: #aab2b5;
    color: #fff;
    font-family: Georgia, serif;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .dg-step.is-active .dg-step-number {
    background: var(--dg-forest);
  }

  .dg-step strong,
  .dg-step small {
    display: block;
  }

  .dg-step strong {
    font-family: Georgia, serif;
    font-size: .84rem;
  }

  .dg-step small {
    margin-top: .12rem;
    font-size: .6rem;
    line-height: 1.25;
  }

  .dg-connector {
    height: 2px;
    background: #c8d0cd;
  }

  .dg-form {
    padding: clamp(1rem, 1.5vw, 1.45rem);
    border: 1px solid #e1dfd4;
    border-radius: 1.4rem;
    background: rgba(255,253,247,.9);
    box-shadow: 0 16px 38px rgba(45, 73, 65, .06);
  }

  .dg-form fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .dg-card-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: .75rem;
  }

  .dg-card {
    --card-accent: #168de2;
    --card-tint: #eef7fd;
    position: relative;
    display: flex;
    min-height: 308px;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 1.15rem;
    background: linear-gradient(180deg, rgba(255,255,255,.96), var(--card-tint));
    box-shadow: 0 10px 26px rgba(21, 66, 75, .07);
    cursor: pointer;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }

  .dg-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 34px rgba(21, 66, 75, .11);
  }

  .dg-card:focus-within {
    outline: 3px solid rgba(14, 88, 75, .2);
    outline-offset: 3px;
  }

  .dg-card.is-selected {
    border-color: var(--card-accent);
    box-shadow: 0 18px 38px rgba(21, 66, 75, .14);
  }

  .dg-card--green { --card-accent: #159150; --card-tint: #eef8ef; }
  .dg-card--red { --card-accent: #e93232; --card-tint: #fdf1ef; }
  .dg-card--gold { --card-accent: #d99a13; --card-tint: #fff8e7; }
  .dg-card--purple { --card-accent: #6944bd; --card-tint: #f5f0fd; }

  .dg-card input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .dg-card-radio {
    position: absolute;
    z-index: 4;
    top: .85rem;
    right: .85rem;
    width: 1.55rem;
    height: 1.55rem;
    border: 2px solid #8fa7b3;
    border-radius: 50%;
    background: #fff;
  }

  .dg-card.is-selected .dg-card-radio {
    border-color: var(--card-accent);
    box-shadow: inset 0 0 0 5px #fff;
    background: var(--card-accent);
  }

  .dg-card-visual {
    position: relative;
    display: block;
    height: 112px;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 30%, rgba(255,255,255,.8), transparent 38%),
      linear-gradient(135deg, var(--card-tint), #fff);
  }

  .dg-icon-badge {
    position: absolute;
    z-index: 3;
    left: .8rem;
    bottom: -.02rem;
    display: grid;
    width: 3.35rem;
    height: 3.35rem;
    place-items: center;
    border: 4px solid #fff;
    border-radius: 50%;
    background: var(--card-accent);
    color: #fff;
    box-shadow: 0 5px 12px rgba(0,0,0,.12);
  }

  .dg-icon-badge svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .dg-scene {
    position: absolute;
    inset: 0;
  }

  .scene-orb {
    position: absolute;
    right: -1.2rem;
    top: -1.4rem;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--card-accent) 13%, transparent);
  }

  .scene-device.phone {
    position: absolute;
    left: 50%;
    top: 18px;
    width: 68px;
    height: 112px;
    transform: translateX(-50%) rotate(-4deg);
    border: 5px solid #163f53;
    border-radius: 15px;
    background: linear-gradient(145deg, #55bdea, #2d5aaf 45%, #8fcf9e);
    box-shadow: 0 10px 22px rgba(26, 70, 91, .18);
  }

  .scene-device.phone i,
  .scene-device.phone b {
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,.9);
  }

  .scene-device.phone i { width: 14px; height: 14px; left: 12px; top: 26px; box-shadow: 22px 0 0 rgba(255,255,255,.88), 0 24px 0 rgba(255,255,255,.75), 22px 24px 0 rgba(255,255,255,.8); }
  .scene-device.phone b { width: 18px; height: 4px; left: 20px; top: 7px; border-radius: 999px; }

  .scene-book {
    position: absolute;
    left: 50%;
    top: 44px;
    width: 108px;
    height: 68px;
    transform: translateX(-50%);
    border-radius: 8px 8px 14px 14px;
    background: #fff;
    box-shadow: 0 12px 24px rgba(27, 80, 58, .15);
  }

  .scene-book i {
    position: absolute;
    top: 8px;
    width: 45%;
    height: 54px;
    border: 2px solid #61a977;
    background: repeating-linear-gradient(180deg, #fff 0 8px, #d9eedf 8px 10px);
  }

  .scene-book i:first-child { left: 5px; transform: skewY(3deg); }
  .scene-book i:last-child { right: 5px; transform: skewY(-3deg); }

  .scene-screen {
    position: absolute;
    left: 50%;
    top: 30px;
    width: 132px;
    height: 82px;
    transform: translateX(-50%);
    border: 6px solid #243e55;
    border-radius: 9px;
