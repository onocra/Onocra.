  const laneIconSvg = (name: string): string => {
    const icons: Record<string, string> = {
      "⚡": '<path d="M13.2 2 5 13h6l-.2 9L19 11h-6l.2-9Z"/>',
      "✓": '<circle cx="12" cy="12" r="9"/><path d="m8 12 2.6 2.6L16.5 9"/>',
      "→": '<path d="M4 12h14M13 7l5 5-5 5"/>',
      "!": '<path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5M12 17.2v.2"/>',
    };
    const body = icons[name] ?? icons["✓"];
    return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
  };

  const page = document.querySelector<HTMLElement>(".dg-step-page")!;
  const matrix = document.querySelector<HTMLElement>("#qh-matrix")!;
  const params = new URLSearchParams(window.location.search);

  let zone = clean(params.get("zone"));
  let area = clean(params.get("area"));
  let category = clean(params.get("category"));
  let issue = clean(params.get("issue"));

  try {
    zone = zone || sessionStorage.getItem("onocra-dg-zone") || "";
    area = area || sessionStorage.getItem("onocra-dg-area") || "";
    category = category || sessionStorage.getItem("onocra-dg-category") || "";
    issue = issue || sessionStorage.getItem("onocra-dg-issue") || "";
  } catch {}

  const areaLabel = AREA_LABELS[area] || area || "Technology area";
  const categoryLabel = CATEGORY_LABELS[category] || category || "Category";
  const issueLabel = ISSUE_LOOKUP[issue]?.title || issue || "Selected issue";

  document.querySelector<HTMLElement>("#qh-area-chip")!.textContent = areaLabel;
  document.querySelector<HTMLElement>("#qh-category-chip")!.textContent = categoryLabel;
  document.querySelector<HTMLElement>("#qh-issue-chip")!.textContent = issueLabel;
  document.querySelector<HTMLElement>("#qh-issue-title")!.textContent = issueLabel;

  document.querySelector<HTMLElement>("#dg-area-progress")!.textContent = areaLabel;
  document.querySelector<HTMLElement>("#dg-category-progress")!.textContent = categoryLabel;
  document.querySelector<HTMLElement>("#dg-issue-progress")!.textContent = issueLabel;

  const lanes = buildMatrix(issue, category, area);

  matrix.innerHTML = lanes.map((lane, laneIndex) => `
    <article class="qh-lane qh-lane--${lane.accent}">
      <header class="qh-lane-head">
        <div class="qh-lane-icon" aria-hidden="true">${laneIconSvg(lane.icon)}</div>
        <div>
          <span>${lane.eyebrow}</span>
          <h3>${lane.title}</h3>
        </div>
      </header>

      <ol class="qh-actions">
        ${lane.items.map((item, itemIndex) => `
          <li>
            <span class="qh-action-number">${String(itemIndex + 1).padStart(2, "0")}</span>
            <p>${item}</p>
          </li>
        `).join("")}
      </ol>

      <div class="qh-lane-foot">
        <span>Lane ${String(laneIndex + 1).padStart(2, "0")}</span>
        <i aria-hidden="true"></i>
        <span>${laneIndex === 0 ? "Begin here" : laneIndex === 3 ? "Only if needed" : "Continue if needed"}</span>
      </div>
    </article>
  `).join("");


  const quickVideoLink = document.querySelector<HTMLAnchorElement>("#qh-video-fix")!;
  const tutorialLink = document.querySelector<HTMLAnchorElement>("#qh-video-tutorial")!;
  const watchLearnLink = document.querySelector<HTMLAnchorElement>("#qh-watch-learn")!;

  const videoQuery = encodeURIComponent(`${areaLabel} ${categoryLabel} ${issueLabel} quick fix tutorial`);
  const tutorialQuery = encodeURIComponent(`${areaLabel} ${categoryLabel} ${issueLabel} step by step tutorial`);

  quickVideoLink.href = `https://www.youtube.com/results?search_query=${videoQuery}`;
  tutorialLink.href = `https://www.youtube.com/results?search_query=${tutorialQuery}`;

  const step2Path = page.getAttribute("data-step2-path") || "/guides/step-2/";
  const watchTarget = new URL(step2Path, window.location.origin);
  watchTarget.searchParams.set("zone", "watch-learn");
  if (area) watchTarget.searchParams.set("area", area);
  watchLearnLink.href = watchTarget.pathname + watchTarget.search;

  const backLink = document.querySelector<HTMLAnchorElement>("#qh-back-link")!;
  const step4Path = page.getAttribute("data-step4-path") || "/guides/step-4/";
  const back = new URL(step4Path, window.location.origin);
  if (zone) back.searchParams.set("zone", zone);
  if (area) back.searchParams.set("area", area);
  if (category) back.searchParams.set("category", category);
  backLink.href = back.pathname + back.search;
</script>

