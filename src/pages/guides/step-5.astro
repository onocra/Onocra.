      escalate = [
        "Back up important data before deeper repairs or resets.",
        "Seek hardware diagnostics if crashes, heat or slowdowns persist after a clean restart.",
        "Stop using the device if overheating becomes severe or there is a burning smell.",
      ];
    } else if (includesAny(key, ["app", "software", "update", "install", "browser", "wont-open", "launch"])) {
      start = [
        "Close the affected app completely and reopen it.",
        "Restart the device.",
        "Check for an app update and an operating-system update.",
      ];
      check = [
        "Confirm there is enough free storage for the app and its updates.",
        "Check the app's permissions, account sign-in and internet access.",
        "Confirm the service itself is not experiencing an outage.",
