---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const step4Path = getRelativeLocaleUrl(locale, "guides/step-4");
const step2Path = getRelativeLocaleUrl(locale, "guides/step-2");
const step1Path = getRelativeLocaleUrl(locale, "guides");
---

<Layout
  title="Quick Help Matrix — Step 5 | ONOCRA"
  description="ONOCRA Quick Help Matrix: immediate practical actions based on your selected technology area, category and issue."
>
  <Header />

  <main
    id="main-content"
    class="dg-step-page"
    data-step4-path={step4Path}
    data-step2-path={step2Path}
    data-step1-path={step1Path}
  >
    <section class="dg-shell" aria-labelledby="dg-step5-title">
      <header class="dg-hero">
        <div>
          <p class="dg-eyebrow">Interactive D&amp;G Platform · Quick Help</p>
          <h1 id="dg-step5-title"><span class="dg-title-number">5.</span> Your Quick Help Matrix</h1>
          <p class="dg-subtitle">
            A focused action plan based on the choices you made in Steps 1–4.
          </p>
        </div>

        <aside class="dg-guide" aria-label="ONOCRA guide note">
          <div class="dg-guide-mark" aria-hidden="true">
            <img
              class="dg-guide-pelican"
              src="/guides/pelican-guide.png"
              alt=""
              width="120"
              height="120"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="dg-guide-copy">
            <p>Start at the left and move across only as needed. The quickest, lowest-risk actions come first.</p>
          </div>
        </aside>
      </header>

      <nav class="dg-progress" aria-label="Diagnostics and Guidance progress">
        <div class="dg-step is-complete">
          <span class="dg-step-number">✓</span>
          <span><strong>1 · Main purpose</strong><small>Fix a Problem</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step is-complete">
          <span class="dg-step-number">✓</span>
          <span><strong>2 · Technology area</strong><small id="dg-area-progress">Selected area</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step is-complete">
          <span class="dg-step-number">✓</span>
          <span><strong>3 · Category</strong><small id="dg-category-progress">Selected category</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step is-complete">
          <span class="dg-step-number">✓</span>
          <span><strong>4 · Issue</strong><small id="dg-issue-progress">Selected issue</small></span>
        </div>
        <span class="dg-connector" aria-hidden="true"></span>

        <div class="dg-step is-active" aria-current="step">
          <span class="dg-step-number">5</span>
          <span><strong>Quick Help Matrix</strong><small>Your action plan</small></span>
        </div>
      </nav>

      <section class="qh-platform" aria-labelledby="qh-title">
        <div class="qh-topbar">
          <div class="qh-brand">
            <span class="qh-live-dot" aria-hidden="true"></span>
            <div>
              <p class="qh-kicker">ONOCRA QUICK HELP</p>
              <h2 id="qh-title">Your action matrix is ready</h2>
            </div>
          </div>

          <div class="qh-ready">
            <span>READY</span>
            <strong id="qh-issue-title">Selected issue</strong>
          </div>
        </div>

        <div class="qh-route" aria-label="Your selected route">
          <span class="qh-route-chip qh-route-chip--area" id="qh-area-chip">Area</span>
          <span class="qh-route-arrow" aria-hidden="true">→</span>
          <span class="qh-route-chip qh-route-chip--category" id="qh-category-chip">Category</span>
          <span class="qh-route-arrow" aria-hidden="true">→</span>
          <span class="qh-route-chip qh-route-chip--issue" id="qh-issue-chip">Issue</span>
        </div>

        <div class="qh-command-strip">
          <div>
            <span class="qh-command-number">01</span>
            <strong>Start with the simplest fix.</strong>
          </div>
          <div>
            <span class="qh-command-number">02</span>
            <strong>Check before changing more settings.</strong>
          </div>
          <div>
            <span class="qh-command-number">03</span>
            <strong>Escalate only when the basics fail.</strong>
          </div>
        </div>

        <div class="qh-matrix" id="qh-matrix" aria-live="polite"></div>

        <section class="qh-media-panel" aria-labelledby="qh-media-title">
          <div class="qh-media-head">
            <div class="qh-media-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="3" y="5" width="18" height="14" rx="3"></rect>
                <path d="m10 9 5 3-5 3V9Z"></path>
              </svg>
            </div>
            <div>
              <p>WATCH &amp; LEARN</p>
              <h3 id="qh-media-title">Videos &amp; Tutorials</h3>
              <span>Open a visual walkthrough for the issue you selected.</span>
            </div>
          </div>

          <div class="qh-media-links">
            <a id="qh-video-fix" class="qh-media-link qh-media-link--video" href="#" target="_blank" rel="noopener noreferrer">
              <span class="qh-media-link-icon" aria-hidden="true">▶</span>
              <span>
                <strong>Quick Fix Videos</strong>
                <small>Watch practical visual fixes</small>
              </span>
              <b aria-hidden="true">↗</b>
            </a>

            <a id="qh-video-tutorial" class="qh-media-link qh-media-link--tutorial" href="#" target="_blank" rel="noopener noreferrer">
              <span class="qh-media-link-icon" aria-hidden="true">▤</span>
              <span>
                <strong>Step-by-Step Tutorials</strong>
                <small>See the full process visually</small>
              </span>
              <b aria-hidden="true">↗</b>
            </a>

            <a id="qh-watch-learn" class="qh-media-link qh-media-link--onocra" href="#">
              <span class="qh-media-link-icon" aria-hidden="true">◎</span>
              <span>
                <strong>ONOCRA Watch &amp; Learn</strong>
                <small>Continue in ONOCRA’s visual-learning route</small>
              </span>
              <b aria-hidden="true">→</b>
            </a>
          </div>
        </section>

        <div class="qh-footer qh-footer--lower">
          <a class="qh-back" id="qh-back-link" href={step4Path}>
            <span aria-hidden="true">←</span>
            Change the issue
          </a>

          <a class="qh-restart" href={step1Path}>
            Start again
            <span aria-hidden="true">↻</span>
          </a>
        </div>
      </section>
    </section>
  </main>

  <Footer />
</Layout>

