  type MatrixLane = {
    id: string;
    eyebrow: string;
    title: string;
    icon: string;
    accent: string;
    items: string[];
  };

  const clean = (value: string | null): string => value || "";

  const includesAny = (value: string, words: string[]): boolean =>
    words.some((word) => value.includes(word));

  const buildMatrix = (issue: string, category: string, area: string): MatrixLane[] => {
    const key = `${issue} ${category} ${area}`.toLowerCase();

    let start = [
      "Restart the affected device and wait for it to fully reconnect.",
      "Repeat the action once after the restart.",
      "Note any exact error message, warning light or unusual behaviour.",
    ];

    let check = [
      "Confirm software, apps or firmware are up to date.",
      "Check cables, power, connections and the relevant settings.",
      "Test one simple alternative to isolate whether the problem is device-specific.",
    ];

    let next = [
      "Try the same task using another app, account, cable, network or device where possible.",
      "Undo only the most recent setting or installation change you recognise.",
      "Keep important files or account details backed up before resets or reinstallations.",
    ];

    let escalate = [
      "Avoid factory resets until simpler checks and backups are complete.",
      "Use the manufacturer, service provider or account provider if the fault persists.",
      "If there is heat, swelling, burning smell, physical damage or electrical risk, stop using the device.",
    ];

    if (includesAny(key, ["battery", "charging"])) {
      start = [
        "Use a known-good charger, cable and wall outlet.",
        "Inspect the charging port for visible debris or damage without inserting metal objects.",
        "Restart the device, then reconnect power and check whether charging begins normally.",
      ];
      check = [
        "Check battery usage for an app consuming unusually high power.",
        "Confirm the device is not extremely hot or cold while charging.",
        "Install pending system updates if the battery level safely allows it.",
      ];
      next = [
        "Test another compatible charger or cable.",
        "Temporarily disable high-drain features and compare battery behaviour.",
        "Back up important data if battery reliability is deteriorating.",
      ];
      escalate = [
        "Stop using or charging the device if the battery is swollen, leaking or unusually hot.",
        "Use authorised service if charging remains intermittent with known-good accessories.",
