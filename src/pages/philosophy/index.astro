          <g fill="url(#phFocusLand)" filter="url(#phFocusShadow)" opacity=".96">
            <!-- North America -->
            <path d="M92 174c34-44 91-71 153-66 45 4 80 24 110 54l-12 28-32 12-18 34-38 9-18 32-45 1-21-26-37-11-29-25-13-42Z"/>
            <!-- Central / South America -->
            <path d="M263 278c27 0 51 18 65 48l-7 32-20 31-8 58-25 39-22-15 3-45-14-35-17-34 8-31 18-28Z"/>
            <!-- Greenland -->
            <path d="M315 85c30-17 63-12 81 13l-12 28-38 9-27-13-8-21Z"/>
            <!-- Europe -->
            <path d="M449 160c31-24 72-28 108-15l18 18-7 20-30 7-15 23-31 0-17-15-29-4-9-18Z"/>
            <!-- Africa -->
            <path d="M484 217c44-16 97-8 127 25l4 45-19 38-16 54-34 51-31-15-15-50-23-50-18-44 7-35Z"/>
            <!-- Middle East -->
            <path d="M599 231c34-8 64-2 88 18l-10 29-34 11-26-11-21-21Z"/>
            <!-- Asia -->
            <path d="M576 153c68-42 166-44 244-9l63 37 12 37-33 19-48-3-30 22-47-8-32 18-41-16-39-2-20-25-43-10-19-28Z"/>
            <!-- Japan / SE Asia -->
            <path d="M829 269c24-12 42-7 52 11l-9 20-23 1-12-15Z"/>
            <path d="M735 290c36 5 60 21 73 49l-20 29-36-10-24-33Z"/>
            <!-- Australia -->
            <path d="M769 385c40-19 88-8 111 25l-8 35-34 24-47-8-28-36Z"/>
          </g>

          <!-- exact initial-focus markers -->
          <g class="ph-focus-pin ph-focus-pin--primary">
            <circle cx="222" cy="213" r="11"/><circle class="halo" cx="222" cy="213" r="22"/>
            <text x="247" y="208">United States</text>
          </g>
          <g class="ph-focus-pin ph-focus-pin--primary">
            <circle cx="489" cy="174" r="11"/><circle class="halo" cx="489" cy="174" r="22"/>
            <text x="438" y="143">United Kingdom</text>
          </g>
          <g class="ph-focus-pin ph-focus-pin--primary">
            <circle cx="526" cy="181" r="11"/><circle class="halo" cx="526" cy="181" r="22"/>
            <text x="548" y="177">Germany</text>
          </g>

          <!-- long-term direction markers -->
          <g class="ph-focus-pin ph-focus-pin--future">
            <circle cx="533" cy="205" r="7"/><text x="548" y="218">Europe</text>
          </g>
          <g class="ph-focus-pin ph-focus-pin--future">
            <circle cx="540" cy="300" r="7"/><text x="553" y="317">Africa</text>
          </g>
          <g class="ph-focus-pin ph-focus-pin--future">
            <circle cx="635" cy="271" r="7"/><text x="650" y="266">Gulf</text>
          </g>
          <g class="ph-focus-pin ph-focus-pin--future">
            <circle cx="803" cy="318" r="7"/><text x="819" y="314">Asia-Pacific</text>
          </g>

          <g class="ph-focus-routes" fill="none" stroke="#d39843" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="6 8" opacity=".72">
            <path d="M526 181C570 170 608 188 635 271"/>
            <path d="M526 181C635 144 750 186 803 318"/>
            <path d="M526 181C517 215 522 257 540 300"/>
          </g>
        </svg>

        <div class="ph-focus-footer">
          <div class="ph-focus-flags" aria-label="ONOCRA initial markets">
            <span><img src="/internet/flag-us.png" alt="United States flag"/>US</span>
            <span><img src="/internet/flag-uk.png" alt="United Kingdom flag"/>UK</span>
            <span><img src="/internet/flag-germany.png" alt="Germany flag"/>Germany</span>
          </div>

          <div class="ph-focus-legend" aria-label="Map legend">
            <span><i class="ph-dot ph-dot--initial"></i>Initial focus</span>
            <span><i class="ph-dot ph-dot--future"></i>Longer-term direction</span>
          </div>

          <div class="ph-focus-compass" aria-hidden="true">🧭</div>
        </div>
      </figure>
    </section>

    <!-- 9. THE ONOCRA PROMISE -->
    <section id="onocra-promise" class="ph-block ph-promise ph-promise-v3" aria-labelledby="promise-title">
      <svg class="ph-botanical ph-botanical--promise-a" aria-hidden="true"><use href="#ph-sprig"/></svg>
      <svg class="ph-botanical ph-botanical--promise-b" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <header class="ph-section-head ph-section-head--center">
        <p class="ph-kicker">THE ONOCRA PROMISE</p>
        <h2 id="promise-title">We shall make technology clearer before your decision.</h2>
        <p class="ph-promise-intro">
          Three principles sit underneath that promise: care for the person, authenticity in the guidance,
          and perseverance in helping make difficult technology easier to navigate.
        </p>
      </header>

      <div class="ph-promise-portraits">
        {promiseCards.map((card) => (
          <article class="ph-promise-card">
            <div class="ph-promise-image">
              <img src={card.image} alt={card.alt} loading="lazy" decoding="async" />
            </div>
            <div class="ph-promise-copy">
              <h3>{card.title}</h3>
              <p>{card.subtitle}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 10. CONTINUE WITH ONOCRA -->
    <section id="explore-onocra" class="ph-block ph-continue" aria-labelledby="continue-title">
      <svg class="ph-botanical ph-botanical--continue" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <div>
        <p class="ph-kicker">CONTINUE WITH ONOCRA</p>
        <h2 id="continue-title">You now know why ONOCRA exists.</h2>
        <p>
          Begin from our home page and choose the path that matches what you need —
          Fix, Decode, Compare or Choose — in the right sequence and with the wider
          ONOCRA context around it.
        </p>
      </div>

      <a class="ph-home-cta" href={homePath}>
        <span>Begin at ONOCRA Home</span><b aria-hidden="true">→</b>
      </a>
    </section>

    <!-- Portrait-video modal -->
    <dialog class="ph-video-dialog" data-ph-video-dialog aria-label="ONOCRA Philosophy in Motion">
      <div class="ph-dialog-inner">
        <button class="ph-dialog-close" type="button" data-ph-close-video aria-label="Close video">×</button>
        <video data-ph-dialog-video controls playsinline preload="metadata" poster="/philosophy.png">
          <source src="/philosophy.mp4" type="video/mp4" />
          Your browser does not support HTML video.
        </video>
      </div>
    </dialog>
  </main>

  <PhilosophyFooter />
</Layout>

<style is:global>
  .philosophy-page {
    --ph-forest: #173a2f;
    --ph-forest-deep: #0d2d25;
    --ph-green: #4f8a63;
    --ph-sage: #eaf3e8;
    --ph-sage-soft: #f4f8ef;
    --ph-cream: #fff9ee;
    --ph-ivory: #fffdf7;
    --ph-orange: #e87524;
    --ph-gold: #d4a94b;
    --ph-muted: #617069;
    --ph-line: #dfe3d8;
    --ph-shadow: 0 12px 28px -24px rgba(18,53,42,.45);

    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 1480px;
    margin: 0 auto;
    padding: 2px 4px 10px 2px;
    color: var(--ph-forest);
    font-family: var(--font-manrope), Arial, sans-serif;
  }

  .philosophy-page *,
  .philosophy-page *::before,
  .philosophy-page *::after { box-sizing: border-box; }

  .ph-svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .ph-block {
    position: relative;
    overflow: hidden;
    margin: 0 0 4px;
    padding: clamp(14px, 1.55vw, 24px);
    border: 1px solid var(--ph-line);
    border-radius: 13px;
    background:
      radial-gradient(circle at 100% 0, rgba(207,225,198,.20), transparent 24%),
      linear-gradient(135deg, rgba(255,253,247,.98), rgba(248,251,244,.98));
    box-shadow: var(--ph-shadow);
  }

  .ph-block + .ph-block { margin-top: 0; }

  .ph-botanical {
    position: absolute;
    z-index: 0;
    width: 230px;
    height: 230px;
    pointer-events: none;
    opacity: .16;
  }

  .ph-block > :not(.ph-botanical) { position: relative; z-index: 1; }

  .ph-section-head { margin: 0 0 10px; }
  .ph-section-head--wide { max-width: 980px; }
  .ph-section-head--center { max-width: 980px; margin-inline: auto; text-align: center; }

  .ph-kicker {
    position: relative;
    width: min(100%, 620px);
    margin: 0 0 8px;
    padding-bottom: 8px;
    color: #bf571f;
