  /* ==========================================================
     BP REFINEMENT — 21 OCT 2026
     Tight sidebar alignment, media scale, flags, botanical balance,
     working-philosophy watermark and BP-style region map.
     ========================================================== */
  @media (min-width: 900px) {
    .philosophy-page {
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 2px 4px 10px 4px !important;
    }

    .ph-block {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .ph-section-head,
    .ph-hero-copy,
    .ph-motion-copy,
    .ph-logo-copy,
