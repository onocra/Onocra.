  .philosophy-page *::after { box-sizing: border-box; }

  .ph-svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .ph-block {
    position: relative;
    overflow: hidden;
    margin: 0 0 4px;
    padding: clamp(14px, 1.55vw, 24px);
    border: 1px solid var(--ph-line);
    border-radius: 13px;
    background:
      radial-gradient(circle at 100% 0, rgba(207,225,198,.20), transparent 24%),
      linear-gradient(135deg, rgba(255,253,247,.98), rgba(248,251,244,.98));
    box-shadow: var(--ph-shadow);
  }

  .ph-block + .ph-block { margin-top: 0; }

  .ph-botanical {
    position: absolute;
    z-index: 0;
    width: 230px;
    height: 230px;
    pointer-events: none;
    opacity: .16;
  }

  .ph-block > :not(.ph-botanical) { position: relative; z-index: 1; }

  .ph-section-head { margin: 0 0 10px; }
  .ph-section-head--wide { max-width: 980px; }
  .ph-section-head--center { max-width: 980px; margin-inline: auto; text-align: center; }

  .ph-kicker {
    position: relative;
    width: min(100%, 620px);
