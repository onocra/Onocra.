            <!-- Europe -->
            <path d="M449 160c31-24 72-28 108-15l18 18-7 20-30 7-15 23-31 0-17-15-29-4-9-18Z"/>
            <!-- Africa -->
            <path d="M484 217c44-16 97-8 127 25l4 45-19 38-16 54-34 51-31-15-15-50-23-50-18-44 7-35Z"/>
            <!-- Middle East -->
            <path d="M599 231c34-8 64-2 88 18l-10 29-34 11-26-11-21-21Z"/>
            <!-- Asia -->
            <path d="M576 153c68-42 166-44 244-9l63 37 12 37-33 19-48-3-30 22-47-8-32 18-41-16-39-2-20-25-43-10-19-28Z"/>
            <!-- Japan / SE Asia -->
            <path d="M829 269c24-12 42-7 52 11l-9 20-23 1-12-15Z"/>
            <path d="M735 290c36 5 60 21 73 49l-20 29-36-10-24-33Z"/>
