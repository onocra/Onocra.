---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import PhilosophyHeader from "@/components/philosophy/Header.astro";
import PhilosophyFooter from "@/components/philosophy/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const philosophySchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Our Core Philosophy",
  description:
    "Why ONOCRA exists, why the pelican sits at the heart of our identity, and how Fix, Decode, Compare and Choose help ordinary households navigate technology safely and confidently.",
  mainEntity: {
    "@type": "Organization",
    name: "ONOCRA",
    slogan: "TechnoNavigation Made Easy",
    description:
      "People-first technology guidance for ordinary households, including seniors, parents, children and everyday technology decision-makers."
  }
};

const childRisk = [
  {
    country: "US",
    flag: "🇺🇸",
    value: "17%",
    headline: "electronically bullied",
    text: "Among US high-school students who frequently used social media, 17% reported electronic bullying in the previous 12 months.",
    source: "CDC · Youth Risk Behavior Survey 2023",
    href: "https://www.cdc.gov/mmwr/volumes/73/su/su7304a3.htm"
  },
  {
    country: "UK",
    flag: "🇬🇧",
    value: "19.1%",
    headline: "experienced online bullying",
    text: "An estimated 19.1% of children aged 10–15 in England and Wales experienced an online bullying behaviour in the previous year.",
    source: "ONS · Crime Survey for England & Wales",
    href: "https://www.ons.gov.uk/peoplepopulationandcommunity/crimeandjustice/bulletins/bullyingandonlineexperiencesamongchildreninenglandandwales/yearendingmarch2023"
  },
  {
    country: "Germany",
    flag: "🇩🇪",
    value: "≈7%",
    headline: "reported cyberbullying experience",
    text: "Germany's HBSC study found around 7% of surveyed 11-, 13- and 15-year-olds reported cyberbullying experience as a target and/or perpetrator.",
    source: "Robert Koch Institute · HBSC Germany 2022",
    href: "https://www.rki.de/DE/Aktuelles/Publikationen/Journal-of-Health-Monitoring/GBEDownloadsJ/Focus/JHealthMonit_2024_01_Mobbing.html"
  }
];

const olderRisk = [
  {
    country: "US",
    flag: "🇺🇸",
    value: "$7.7bn+",
    headline: "reported internet-crime losses",
    text: "In 2025, people over 60 made more than 201,000 IC3 complaints and reported losses exceeding $7.7 billion.",
    source: "FBI · Internet Crime Complaint Center 2025",
    href: "https://www.fbi.gov/news/stories/scammers-target-older-adult-victims",
    source2: null,
    href2: null
  },
  {
    country: "UK",
    flag: "🇬🇧",
    value: "62%",
    headline: "of courier-fraud reports",
    text: "People aged 76–96 accounted for around 62% of UK courier-fraud reports in 2025; older and vulnerable people remain a primary target.",
    source: "City of London Police · 2026",
    href: "https://www.cityoflondon.police.uk/news/city-of-london/news/2026/june/over-70s-targeted-as-courier-fraud-exceeds-21-million-in-2025-with-london-and-home-counties-hit-hardest/",
    source2: null,
    href2: null
  },
  {
    country: "Germany",
    flag: "🇩🇪",
    value: "87%",
    headline: "of ages 65–74 recently used the internet",
    text: "Half of Germans aged 65–74 used online banking in 2025. The BKA also warns that impersonation and shock-call scams frequently target older people.",
    source: "Destatis · Internet use by age, 2025",
    href: "https://www.destatis.de/EN/Themes/Society-Environment/Income-Consumption-Living-Conditions/Use-Information-Technologies/Tables/use-internet-sex-age-mz-ikt.html",
    source2: "BKA · Fraud-crime warning",
    href2: "https://www.bka.de/SharedDocs/Kurzmeldungen/DE/Kurzmeldungen/250425_Entwicklung_Betrugskriminalit%C3%A4t.html"
  }
];

const workHubs = [
  {
    id: "phones",
    icon: "▣",
    title: "Phones & Tablets",
    examples: [
      ["FIX", "Why is my eSIM not working? Why is my phone battery draining?"],
      ["DECODE", "Which chipset is better? What do RAM, refresh rate and nits mean?"],
      ["COMPARE", "iPhone vs Samsung vs Pixel. New generation vs older generation."],
      ["CHOOSE", "Best phone for seniors, students, parents or budget buyers."]
    ]
  },
  {
    id: "internet",
    icon: "⌁",
    title: "Home Internet & Wi-Fi",
    examples: [
      ["FIX", "Why is my Wi-Fi slow? Why does my router keep disconnecting?"],
      ["DECODE", "What is mesh Wi-Fi? What do bands, speeds and router lights mean?"],
      ["COMPARE", "Routers, mesh systems, broadband options and service providers."],
      ["CHOOSE", "The right setup for home size, coverage, work and streaming."]
    ]
  },
  {
    id: "computers",
    icon: "▰",
    title: "Computers & Laptops",
    examples: [
      ["FIX", "Why is my laptop slow, overheating, freezing or failing to update?"],
      ["DECODE", "What do SSD, RAM, processors, generations and graphics mean?"],
      ["COMPARE", "MacBook vs Windows laptop. Models, generations and value."],
      ["CHOOSE", "Best laptop for study, work, family use or content creation."]
    ]
  },
  {
    id: "security",
    icon: "◈",
    title: "Digital Safety & Security",
    examples: [
      ["FIX", "What should I do after a scam message, suspicious link or account alert?"],
      ["DECODE", "What are phishing, MFA, passkeys, identity theft and online scams?"],
      ["COMPARE", "Password managers, security tools and parental-control options."],
      ["CHOOSE", "The safest practical protection for your household."]
    ]
  }
];
---

<Layout
  title="Our Core Philosophy — ONOCRA"
  description="ONOCRA's people-first philosophy: technology help for seniors, parents and families; digital parenting and online safety; scam prevention; and clearer Fix, Decode, Compare and Choose guidance."
>
  <PhilosophyHeader />

  <main id="main-content" class="philosophy-page">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(philosophySchema)}
    />

    <!-- Reusable botanical artwork. Decorative only. -->
    <svg class="ph-svg-defs" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="phLeaf" x1="0" y1="1" x2="1" y2="0">
          <stop stop-color="#2b7453"/>
          <stop offset=".55" stop-color="#79ae79"/>
          <stop offset="1" stop-color="#c7dca4"/>
        </linearGradient>
        <linearGradient id="phLeafPale" x1="0" y1="1" x2="1" y2="0">
          <stop stop-color="#78a487"/>
          <stop offset="1" stop-color="#dce8c9"/>
        </linearGradient>
        <radialGradient id="phFlower">
          <stop stop-color="#fffef3"/>
          <stop offset=".78" stop-color="#f4ecd0"/>
          <stop offset="1" stop-color="#d8dec2"/>
        </radialGradient>
        <symbol id="ph-sprig" viewBox="0 0 230 230">
          <g fill="none" stroke="#6c9874" stroke-width="2.2" stroke-linecap="round">
            <path d="M10 225C39 162 82 118 130 78S193 23 223 3"/>
            <path d="M76 123C49 106 39 81 41 49"/>
            <path d="M104 98C130 109 157 103 181 87"/>
            <path d="M145 65C137 42 146 21 167 5"/>
          </g>
          <g fill="url(#phLeaf)" stroke="#447b58" stroke-width=".6">
            <path d="M34 178C2 166 4 132 22 118C48 129 55 157 34 178Z"/>
            <path d="M55 148C29 143 20 119 30 98C58 104 70 127 55 148Z"/>
            <path d="M75 126C91 131 112 119 120 99C94 94 76 106 75 126Z"/>
            <path d="M72 99C50 84 48 59 63 42C87 56 91 82 72 99Z"/>
            <path d="M109 96C128 103 153 91 162 69C135 63 113 74 109 96Z"/>
            <path d="M139 70C119 49 126 25 145 12C164 31 162 55 139 70Z"/>
            <path d="M168 49C191 57 211 45 222 25C196 19 175 29 168 49Z"/>
          </g>
          <g fill="url(#phFlower)" stroke="#c8bd8e" stroke-width=".7" transform="translate(107 123) scale(.9)">
            <ellipse cy="-11" rx="7" ry="12"/>
            <ellipse cy="-11" rx="7" ry="12" transform="rotate(72)"/>
            <ellipse cy="-11" rx="7" ry="12" transform="rotate(144)"/>
            <ellipse cy="-11" rx="7" ry="12" transform="rotate(216)"/>
            <ellipse cy="-11" rx="7" ry="12" transform="rotate(288)"/>
            <circle r="5" fill="#e0ad45" stroke="none"/>
          </g>
          <g fill="#d8a851">
            <circle cx="187" cy="74" r="3.5"/><circle cx="198" cy="68" r="2.7"/><circle cx="204" cy="79" r="2.3"/>
          </g>
        </symbol>
      </defs>
    </svg>

    <!-- 1. WHY ONOCRA EXISTS -->
    <section class="ph-block ph-hero" aria-labelledby="philosophy-title">
      <svg class="ph-botanical ph-botanical--hero" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <div class="ph-hero-copy">
        <header class="ph-section-head ph-section-head--hero">
          <p class="ph-kicker">WHY ONOCRA EXISTS</p>
          <h1 id="philosophy-title">Our Core<br />Philosophy</h1>
        </header>

        <p class="ph-deck">
          Why ONOCRA exists — and how our pelican reflects the way we help
          ordinary households navigate technology.
        </p>

        <p class="ph-lead">
          <strong>Technology should help people, not overwhelm them.</strong>
          ONOCRA exists to reduce confusion, explain what matters and help
          ordinary households make safer, clearer and smarter technology decisions.
        </p>

        <p class="ph-copy">
          From smartphone help for seniors and parental controls to Wi-Fi
          troubleshooting, scam prevention and technology buying guidance, our
          purpose is to make everyday technology easier to understand and safer to use.
        </p>

        <div class="ph-hero-tags" aria-label="ONOCRA philosophy themes">
          <span>People-first</span><span>Family technology</span><span>Digital safety</span><span>Independent guidance</span>
        </div>
      </div>

      <figure class="ph-hero-visual">
        <img
          src="/philosophy.png"
          alt="ONOCRA pelican family illustrating Fix, Decode, Compare and Choose"
          width="1280"
          height="1536"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </section>

    <!-- 2. PHILOSOPHY IN MOTION -->
    <section id="philosophy-video" class="ph-block ph-motion" aria-labelledby="philosophy-video-title">
      <svg class="ph-botanical ph-botanical--motion" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <div class="ph-motion-media">
        <div class="ph-phone-frame">
          <video
            controls
            preload="metadata"
            playsinline
            poster="/philosophy.png"
            aria-label="ONOCRA philosophy in motion"
          >
            <source src="/philosophy.mp4" type="video/mp4" />
            Your browser does not support HTML video.
          </video>
        </div>
        <button class="ph-expand-video" type="button" data-ph-open-video>
          <span aria-hidden="true">▶</span> Watch larger
        </button>
      </div>

      <div class="ph-motion-copy">
        <header class="ph-section-head">
          <p class="ph-kicker">PHILOSOPHY IN MOTION</p>
          <h2 id="philosophy-video-title">See what one caring guide looks like in everyday life.</h2>
        </header>

        <p>
          ONOCRA's short-form videos turn the same philosophy into quick,
          understandable guidance for the moments when households need help most:
          a suspicious message, a confusing setting, a weak Wi-Fi connection,
          a device decision or a child's online-safety concern.
        </p>

        <ul class="ph-tick-list">
          <li>Practical everyday scenarios</li>
          <li>Clear, caring explanations</li>
          <li>Family-focused technology guidance</li>
          <li>Designed for Shorts, Reels and TikTok as well as the web</li>
        </ul>

        <p class="ph-motion-signature">
          <strong>One caring guide.</strong> Helping ordinary households navigate technology.
        </p>
      </div>
    </section>

    <!-- 3. WHY THIS MATTERS -->
    <section id="why-it-matters" class="ph-block ph-evidence" aria-labelledby="why-title">
      <svg class="ph-botanical ph-botanical--evidence" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <header class="ph-section-head ph-section-head--wide">
        <p class="ph-kicker">WHY THIS MATTERS</p>
        <h2 id="why-title">Technology confidence is increasingly a family-safety issue.</h2>
        <p>
          ONOCRA's mission is shaped by real digital risks. These national indicators
          use different age groups and methodologies, so they should not be read as
          direct country-to-country comparisons.
        </p>
      </header>

      <div class="ph-evidence-band">
        <div class="ph-evidence-intro">
          <span class="ph-round-icon" aria-hidden="true">♟</span>
          <div>
            <h3>Children &amp; families</h3>
            <p>
              Digital parenting is not about fear. It is about helping children build
              independence while parents understand parental controls, privacy,
              cyberbullying, suspicious contact and safer online behaviour.
            </p>
          </div>
        </div>

        <div class="ph-country-grid">
          {childRisk.map((item) => (
            <article class="ph-stat-card">
              <div class="ph-country"><span>{item.flag}</span>{item.country}</div>
              <strong class="ph-stat">{item.value}</strong>
              <h4>{item.headline}</h4>
              <p>{item.text}</p>
              <a href={item.href} target="_blank" rel="noopener noreferrer">{item.source} ↗</a>
            </article>
          ))}
        </div>
      </div>

      <div class="ph-evidence-band ph-evidence-band--older">
        <div class="ph-evidence-intro">
          <span class="ph-round-icon" aria-hidden="true">♧</span>
          <div>
            <h3>Older adults &amp; seniors</h3>
            <p>
              Age can bring changes in eyesight, hearing, dexterity, memory or digital
              confidence. Clear guidance around smartphones, passwords, online banking,
              suspicious calls and scam messages can therefore matter far beyond convenience.
            </p>
          </div>
        </div>

        <div class="ph-country-grid">
          {olderRisk.map((item) => (
            <article class="ph-stat-card">
              <div class="ph-country"><span>{item.flag}</span>{item.country}</div>
              <strong class="ph-stat">{item.value}</strong>
              <h4>{item.headline}</h4>
              <p>{item.text}</p>
              <a href={item.href} target="_blank" rel="noopener noreferrer">{item.source} ↗</a>
              {item.href2 && item.source2 && (
                <a href={item.href2} target="_blank" rel="noopener noreferrer">{item.source2} ↗</a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. WHAT ONOCRA STANDS FOR -->
    <section id="what-we-stand-for" class="ph-block ph-stands" aria-labelledby="stands-title">
      <svg class="ph-botanical ph-botanical--stands" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <header class="ph-section-head ph-section-head--wide">
        <p class="ph-kicker">WHAT ONOCRA STANDS FOR</p>
        <h2 id="stands-title">Technology guidance built around people.</h2>
        <p>
          ONOCRA is designed for real households — not only for enthusiasts who already
          understand technical language.
        </p>
      </header>

      <div class="ph-people-grid">
        <article class="ph-person-card">
          <span class="ph-person-icon" aria-hidden="true">♧</span>
          <h3>Older adults &amp; seniors</h3>
          <p>
            Clear smartphone setup, accessibility, Wi-Fi help, password guidance and scam
            prevention — explained patiently and without assuming prior knowledge.
          </p>
          <span class="ph-search-intent">smartphone help for seniors · online scam prevention</span>
        </article>

        <article class="ph-person-card">
          <span class="ph-person-icon" aria-hidden="true">◉</span>
          <h3>Children &amp; teenagers</h3>
          <p>
            Support for safer online independence, privacy, parental controls, cyberbullying
            awareness, suspicious contact and age-appropriate technology choices.
          </p>
          <span class="ph-search-intent">digital parenting · parental controls · online safety</span>
        </article>

        <article class="ph-person-card">
          <span class="ph-person-icon" aria-hidden="true">⌂</span>
          <h3>Parents &amp; household decision-makers</h3>
          <p>
            Practical help for mothers, fathers, caregivers and anyone managing devices,
            subscriptions, broadband, passwords, purchases and family digital safety.
          </p>
          <span class="ph-search-intent">family technology help · safer technology choices</span>
        </article>
      </div>
    </section>

    <!-- 5. THE MEANING OF OUR LOGO -->
    <section id="meaning-of-logo" class="ph-block ph-logo-story" aria-labelledby="logo-title">
      <svg class="ph-botanical ph-botanical--logo-a" aria-hidden="true"><use href="#ph-sprig"/></svg>
      <svg class="ph-botanical ph-botanical--logo-b" aria-hidden="true"><use href="#ph-sprig"/></svg>
      <svg class="ph-botanical ph-botanical--logo-c" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <div class="ph-logo-copy">
        <header class="ph-section-head">
          <p class="ph-kicker">THE MEANING OF OUR LOGO</p>
          <h2 id="logo-title">ONOCRA and the pelican belong together.</h2>
        </header>

        <p>
          The name <strong>ONOCRA</strong> is inspired by <em>onocrotalus</em> —
          a name whose roots reach back to the ancient Greek <em>onokrotalos</em>,
          used for the pelican. The Great White Pelican still carries that heritage
          in its scientific name, <em>Pelecanus onocrotalus</em>.
        </p>

        <p>
          We shortened that heritage into <strong>ONOCRA.</strong> for a modern purpose:
          <strong>TechnoNavigation Made Easy.</strong>
        </p>

        <p>
          Our pelican is therefore more than a mascot. The bird and the name share the
          same origin, while the pelican's long association with care and protection
          expresses the purpose we want ONOCRA to serve.
        </p>

        <p>
          It can represent an older parent trying to use a smartphone safely, a child
          finding a path through the online world, a mother protecting her household
          from scams, or anyone simply trying to understand what technology is asking
          them to do.
        </p>

        <blockquote>
          <strong>The name explains the bird.</strong><br />
          The bird explains the purpose.
        </blockquote>

        <details class="ph-etymology">
          <summary>Where the name comes from</summary>
          <p>
            Ancient Greek <em>onokrotalos</em> is historically associated with the
            pelican. ONOCRA is our shortened brand form inspired by that heritage,
            rather than a claim that the modern word itself was an established
            historical name.
          </p>
          <div class="ph-source-links">
            <a href="https://ebird.org/species/grwpel1" target="_blank" rel="noopener noreferrer">Cornell eBird · Great White Pelican ↗</a>
            <a href="https://atlas.perseus.tufts.edu/" target="_blank" rel="noopener noreferrer">Perseus Digital Library · Greek lexicons ↗</a>
          </div>
        </details>
      </div>

      <figure class="ph-logo-art">
        <div class="ph-logo-halo" aria-hidden="true"></div>
        <img
          src="/onocraphilosophy.png"
          alt="Hands caring for the ONOCRA pelican and chicks emblem"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <strong>One caring guide, helping.</strong>
          Care · protection · clarity · perseverance
        </figcaption>
      </figure>
    </section>

    <!-- 6. THE ONOCRA WORKING PHILOSOPHY -->
    <section id="four-ways" class="ph-block ph-working" aria-labelledby="working-title">
      <header class="ph-section-head ph-section-head--wide">
        <p class="ph-kicker">THE ONOCRA WORKING PHILOSOPHY</p>
        <h2 id="working-title">One caring guide. Four ways to help.</h2>
        <p>Across the technology topics ordinary households use every day.</p>
      </header>

      <div class="ph-work-grid">
        {workHubs.map((hub) => (
          <article class={`ph-work-card ph-work-card--${hub.id}`}>
            <header>
              <span aria-hidden="true">{hub.icon}</span>
              <h3>{hub.title}</h3>
            </header>

            <div class="ph-work-body">
              {hub.examples.map(([action, text]) => (
                <div class="ph-work-row">
                  <span class={`ph-action ph-action--${action.toLowerCase()}`}>{action}</span>
                  <p>{text}</p>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>

      <p class="ph-working-note">
        Fix what is going wrong. Decode what technology means. Compare without
        commercial pressure. Choose with greater confidence.
      </p>
    </section>

    <!-- 7. HOW WE WORK -->
    <section id="how-we-work" class="ph-block ph-how" aria-labelledby="how-title">
      <svg class="ph-botanical ph-botanical--how" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <header class="ph-section-head ph-section-head--wide">
        <p class="ph-kicker">HOW WE WORK</p>
        <h2 id="how-title">A philosophy only matters if it changes the work.</h2>
      </header>

      <div class="ph-how-grid">
        <article><span>⚖</span><h3>Independent guidance</h3><p>Commercial relationships should not dictate recommendations or retailer ordering.</p></article>
        <article><span>▤</span><h3>Evidence before assertion</h3><p>Manufacturer information and credible third-party research are clearly separated and attributed.</p></article>
        <article><span>◌</span><h3>Explain, don't overwhelm</h3><p>Specifications and jargon are translated into practical consequences for ordinary users.</p></article>
        <article><span>♟</span><h3>Different people, different answers</h3><p>The right technology depends on needs, age, household role, budget and priorities.</p></article>
        <article><span>◈</span><h3>Safety before convenience</h3><p>Especially where scams, privacy, children, older adults or financial harm are involved.</p></article>
      </div>
    </section>

    <!-- 8. WHERE WE BEGIN -->
    <section id="where-we-begin" class="ph-block ph-regions" aria-labelledby="regions-title">
      <svg class="ph-botanical ph-botanical--regions" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <div>
        <header class="ph-section-head">
          <p class="ph-kicker">WHERE WE BEGIN — AND WHERE WE WANT TO GO</p>
          <h2 id="regions-title">Beginning with the United States, United Kingdom and Germany.</h2>
        </header>

        <p>
          ONOCRA is initially building its consumer guidance around households in the
          <strong>United States, United Kingdom and Germany</strong>, including
          region-relevant products, services, pricing, terminology and digital-safety resources.
        </p>
        <p>
          Our longer-term vision is to extend that approach into
          <strong>other European markets, the Gulf and Asia-Pacific</strong>, adapting
          ONOCRA to the way households in each region actually buy, use and protect technology.
        </p>
      </div>

      <div class="ph-region-art" aria-label="Initial ONOCRA regions">
        <div class="ph-region-primary"><span>🇺🇸</span><b>United States</b><small>Initial focus</small></div>
        <div class="ph-region-primary"><span>🇬🇧</span><b>United Kingdom</b><small>Initial focus</small></div>
        <div class="ph-region-primary"><span>🇩🇪</span><b>Germany</b><small>Initial focus</small></div>
        <div class="ph-region-future">
          <span>EU</span><span>Gulf</span><span>Asia-Pacific</span>
          <small>Longer-term expansion vision</small>
        </div>
      </div>
    </section>

    <!-- 9. THE ONOCRA PROMISE -->
    <section id="onocra-promise" class="ph-block ph-promise" aria-labelledby="promise-title">
      <svg class="ph-botanical ph-botanical--promise-a" aria-hidden="true"><use href="#ph-sprig"/></svg>
      <svg class="ph-botanical ph-botanical--promise-b" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <header class="ph-section-head ph-section-head--center">
        <p class="ph-kicker">THE ONOCRA PROMISE</p>
        <h2 id="promise-title">We will try to make technology clearer before asking you to make a decision.</h2>
      </header>

      <div class="ph-promise-grid">
        <div><span>♡</span><strong>Care</strong><small>before complexity.</small></div>
        <div><span>◌</span><strong>Clarity</strong><small>before jargon.</small></div>
        <div><span>▤</span><strong>Evidence</strong><small>before persuasion.</small></div>
        <div><span>♟</span><strong>People</strong><small>before products.</small></div>
      </div>
    </section>

    <!-- 10. CONTINUE WITH ONOCRA -->
