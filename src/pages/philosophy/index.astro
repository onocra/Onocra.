            <text x="247" y="208">United States</text>
          </g>
          <g class="ph-focus-pin ph-focus-pin--primary">
            <circle cx="489" cy="174" r="11"/><circle class="halo" cx="489" cy="174" r="22"/>
            <text x="438" y="143">United Kingdom</text>
