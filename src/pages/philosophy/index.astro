    margin: 8px 0 0;
    color: var(--ph-muted);
    font-size: .92rem;
    line-height: 1.5;
  }

  /* HERO */
  .ph-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(420px, .97fr);
    gap: 5px;
    min-height: 610px;
