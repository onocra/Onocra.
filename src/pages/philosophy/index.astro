      grid-template-columns: 1fr;
    }

    .ph-tick-list { grid-template-columns: 1fr; }
    .ph-region-art { grid-template-columns: 1fr; }
    .ph-region-future { grid-column: 1; }

    .ph-work-row {
      grid-template-columns: 70px minmax(0,1fr);
      min-height: 0;
    }

    .ph-section-head h2,
    .ph-continue h2 { font-size: clamp(1.65rem, 8vw, 2.3rem); }

    .ph-hero h1 { font-size: clamp(2.9rem, 14vw, 4.5rem); }

    .ph-logo-story { min-height: 0; }
    .ph-logo-art { min-height: 360px; }
