        <div class="ph-focus-compass" aria-hidden="true">🧭</div>
      </figure>
    </section>

    <!-- 9. THE ONOCRA PROMISE -->
    <section id="onocra-promise" class="ph-block ph-promise ph-promise-v3" aria-labelledby="promise-title">
      <svg class="ph-botanical ph-botanical--promise-a" aria-hidden="true"><use href="#ph-sprig"/></svg>
      <svg class="ph-botanical ph-botanical--promise-b" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <header class="ph-section-head ph-section-head--center">
        <p class="ph-kicker">THE ONOCRA PROMISE</p>
        <h2 id="promise-title">We shall make technology clearer before your decision.</h2>
        <p class="ph-promise-intro">
          Three principles sit underneath that promise: care for the person, authenticity in the guidance,
          and perseverance in helping make difficult technology easier to navigate.
        </p>
      </header>

      <div class="ph-promise-portraits">
        {promiseCards.map((card) => (
          <article class="ph-promise-card">
            <div class="ph-promise-image">
              <img src={card.image} alt={card.alt} loading="lazy" decoding="async" />
            </div>
            <div class="ph-promise-copy">
              <h3>{card.title}</h3>
              <p>{card.subtitle}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 10. CONTINUE WITH ONOCRA -->
    <section id="explore-onocra" class="ph-block ph-continue" aria-labelledby="continue-title">
      <svg class="ph-botanical ph-botanical--continue" aria-hidden="true"><use href="#ph-sprig"/></svg>

      <div>
        <p class="ph-kicker">CONTINUE WITH ONOCRA</p>
        <h2 id="continue-title">You now know why ONOCRA exists.</h2>
        <p>
          Begin from our home page and choose the path that matches what you need —
          Fix, Decode, Compare or Choose — in the right sequence and with the wider
          ONOCRA context around it.
        </p>
      </div>

      <a class="ph-home-cta" href={homePath}>
        <span>Begin at ONOCRA Home</span><b aria-hidden="true">→</b>
      </a>
    </section>

    <!-- Portrait-video modal -->
    <dialog class="ph-video-dialog" data-ph-video-dialog aria-label="ONOCRA Philosophy in Motion">
      <div class="ph-dialog-inner">
        <button class="ph-dialog-close" type="button" data-ph-close-video aria-label="Close video">×</button>
        <video data-ph-dialog-video controls playsinline preload="metadata" poster="/philosophy.png">
          <source src="/philosophy.mp4" type="video/mp4" />
          Your browser does not support HTML video.
        </video>
      </div>
    </dialog>
  </main>

  <PhilosophyFooter />
</Layout>

<style is:global>
  .philosophy-page {
    --ph-forest: #173a2f;
    --ph-forest-deep: #0d2d25;
    --ph-green: #4f8a63;
    --ph-sage: #eaf3e8;
    --ph-sage-soft: #f4f8ef;
    --ph-cream: #fff9ee;
    --ph-ivory: #fffdf7;
    --ph-orange: #e87524;
    --ph-gold: #d4a94b;
    --ph-muted: #617069;
    --ph-line: #dfe3d8;
    --ph-shadow: 0 12px 28px -24px rgba(18,53,42,.45);

    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 1480px;
    margin: 0 auto;
    padding: 2px 4px 10px 2px;
