    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: 7px;
  }

  .ph-source-links a {
    color: #a85a2a;
    font-size: .64rem;
    font-weight: 800;
    text-decoration: none;
  }

  .ph-logo-art {
    position: relative;
    display: grid;
    min-height: 520px;
    place-items: center;
    align-content: center;
    margin: 0;
    overflow: hidden;
    border: 1px solid #dce5d7;
    border-radius: 10px;
    background:
      radial-gradient(circle at 50% 48%, rgba(255,255,255,.98) 0 28%, rgba(242,248,233,.76) 50%, rgba(255,247,230,.8) 100%);
  }

  .ph-logo-art::before,
  .ph-logo-art::after {
    content: "";
    position: absolute;
    inset: 11% 12%;
    border: 1px solid rgba(89,140,96,.18);
    border-radius: 50%;
