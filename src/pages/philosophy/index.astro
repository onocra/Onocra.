    font-size: .64rem;
    font-weight: 800;
    text-decoration: none;
  }

  .ph-logo-art {
    position: relative;
    display: grid;
    min-height: 520px;
    place-items: center;
    align-content: center;
    margin: 0;
    overflow: hidden;
    border: 1px solid #dce5d7;
    border-radius: 10px;
