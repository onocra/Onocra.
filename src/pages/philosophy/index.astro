    font-weight: 900;
    letter-spacing: .18em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .ph-kicker::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(46%, 250px);
    height: 2.5px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--ph-orange), #f3aa5d);
  }

  .ph-section-head--center .ph-kicker {
    margin-inline: auto;
  }

  .ph-section-head--center .ph-kicker::after {
    left: 27%;
    width: 46%;
  }

  .ph-section-head h2,
  .ph-continue h2 {
    margin: 0;
    color: var(--ph-forest);
    font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
    font-size: clamp(1.8rem, 3.1vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -.038em;
    line-height: .98;
  }

  .ph-section-head > p:last-child:not(.ph-kicker) {
