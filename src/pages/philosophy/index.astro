  .ph-etymology {
    margin-top: 12px;
    border-top: 1px solid #dce3d6;
    padding-top: 9px;
  }

  .ph-etymology summary {
    cursor: pointer;
    color: #2d6f51;
    font-size: .72rem;
    font-weight: 900;
  }

  .ph-etymology p {
    margin: 8px 0 0;
    color: #67756e;
    font-size: .72rem;
    line-height: 1.45;
  }

  .ph-source-links {
