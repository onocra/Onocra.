  .ph-botanical--logo-a { right: -45px; top: -45px; width: 310px; height: 310px; opacity: .25; transform: scaleX(-1) rotate(18deg); }
  .ph-botanical--logo-b { left: 47%; bottom: -75px; width: 300px; height: 300px; opacity: .18; transform: rotate(-17deg); }
  .ph-botanical--logo-c { right: 29%; top: 28%; width: 190px; height: 190px; opacity: .09; transform: rotate(85deg); }

  /* WORKING PHILOSOPHY */
  .ph-working {
    background:
      radial-gradient(circle at 2% 98%, rgba(220,235,207,.34), transparent 19%),
      linear-gradient(135deg, #fffdf7, #f7fbf3);
  }

  .ph-work-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 5px;
  }

  .ph-work-card {
    overflow: hidden;
    border: 1px solid #d5dfd3;
    border-radius: 9px;
    background: rgba(255,255,252,.94);
  }

  .ph-work-card > header {
    display: flex;
    min-height: 48px;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    color: white;
  }

  .ph-work-card > header span { font-size: 1.1rem; }
  .ph-work-card > header h3 { margin: 0; font-size: .86rem; line-height: 1.15; }

  .ph-work-card--phones > header { background: linear-gradient(90deg,#3469c9,#5686db); }
  .ph-work-card--internet > header { background: linear-gradient(90deg,#e66d24,#f1a43f); }
  .ph-work-card--computers > header { background: linear-gradient(90deg,#348044,#63a94d); }
  .ph-work-card--security > header { background: linear-gradient(90deg,#6550bc,#8564d9); }

  .ph-work-body { padding: 4px; }

  .ph-work-row {
    display: grid;
    grid-template-columns: 74px minmax(0,1fr);
    gap: 6px;
    align-items: start;
    min-height: 72px;
    padding: 8px 6px;
    border-bottom: 1px solid #e4e7df;
  }

  .ph-work-row:last-child { border-bottom: 0; }

  .ph-work-row p {
    margin: 0;
    color: #53635c;
    font-size: .67rem;
    line-height: 1.4;
  }

  .ph-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 25px;
    padding: 5px 7px;
    border-radius: 999px;
    font-size: .59rem;
    font-weight: 900;
    letter-spacing: .035em;
  }

  .ph-action--fix { color:#17633f; background:#e2f2e6; }
  .ph-action--decode { color:#245da6; background:#e5effb; }
  .ph-action--compare { color:#af4f28; background:#fbe9df; }
  .ph-action--choose { color:#6548a8; background:#eee8fb; }

  .ph-working-note {
    margin: 9px 0 0;
    text-align: center;
    color: var(--ph-forest);
    font-family: ui-serif, Georgia, serif;
    font-size: .87rem;
    font-weight: 800;
  }

  /* HOW WE WORK */
  .ph-how-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0,1fr));
    gap: 5px;
  }

  .ph-how-grid article {
    padding: 11px;
    border: 1px solid #dce4d8;
    border-radius: 9px;
    background: rgba(255,255,252,.84);
  }

  .ph-how-grid span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    background: #edf5ea;
    color: #2a6f4f;
    font-weight: 900;
  }

  .ph-how-grid h3 {
    margin: 8px 0 0;
    font-family: ui-serif, Georgia, serif;
    font-size: .9rem;
    line-height: 1.05;
  }

  .ph-how-grid p {
    margin: 6px 0 0;
    color: var(--ph-muted);
    font-size: .64rem;
    line-height: 1.4;
  }

  .ph-botanical--how { right: 19%; bottom: -120px; opacity: .08; transform: rotate(15deg); }

  /* REGIONS */
  .ph-regions {
    display: grid;
    grid-template-columns: minmax(0,1.3fr) minmax(360px,.7fr);
    gap: 6px;
    align-items: center;
  }

  .ph-regions > div:first-of-type { padding: 6px 12px; }

  .ph-regions p {
    max-width: 860px;
    margin: 8px 0 0;
    color: var(--ph-muted);
    font-size: .82rem;
    line-height: 1.55;
  }

  .ph-regions strong { color: var(--ph-forest); }

  .ph-region-art {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 5px;
    padding: 6px;
    border: 1px solid #dbe4d7;
    border-radius: 10px;
    background: rgba(244,249,239,.78);
  }

  .ph-region-primary {
    display: grid;
    place-items: center;
    min-height: 105px;
    padding: 8px;
    border: 1px solid #dfe4d8;
    border-radius: 8px;
    background: rgba(255,255,252,.9);
    text-align: center;
  }

  .ph-region-primary span { font-size: 1.55rem; }
  .ph-region-primary b { margin-top: 4px; font-size: .68rem; }
  .ph-region-primary small { margin-top: 2px; color: #a65a2b; font-size: .55rem; font-weight: 800; }

  .ph-region-future {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 5px;
    padding-top: 6px;
    border-top: 1px solid #dce4d8;
  }

  .ph-region-future > span {
    padding: 5px 8px;
    border-radius: 999px;
    background: #e8f2e4;
    color: #45634f;
    font-size: .6rem;
    font-weight: 900;
  }

  .ph-region-future small {
    flex-basis: 100%;
    text-align: center;
    color: #718078;
    font-size: .55rem;
  }

  .ph-botanical--regions { left: -72px; bottom: -108px; opacity: .1; transform: rotate(-6deg); }

  /* PROMISE */
  .ph-promise {
    text-align: center;
    padding-block: 22px 18px;
    background:
      radial-gradient(circle at 0 100%, rgba(207,227,196,.42), transparent 22%),
      radial-gradient(circle at 100% 0, rgba(247,221,172,.25), transparent 20%),
      #fffdf7;
  }

  .ph-promise-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 5px;
    max-width: 900px;
    margin: 12px auto 0;
  }

  .ph-promise-grid div {
    display: grid;
    place-items: center;
    min-height: 92px;
    padding: 8px;
    border: 1px solid #dde4d9;
    border-radius: 9px;
    background: rgba(255,255,252,.82);
  }

  .ph-promise-grid span { color: #c35c24; font-size: 1.3rem; }
  .ph-promise-grid strong { margin-top: 4px; font-family: ui-serif, Georgia, serif; font-size: .9rem; }
  .ph-promise-grid small { color: var(--ph-muted); font-size: .6rem; }

  .ph-botanical--promise-a { left: -70px; bottom: -80px; opacity: .16; transform: rotate(-8deg); }
  .ph-botanical--promise-b { right: -78px; top: -86px; opacity: .13; transform: scaleX(-1) rotate(-9deg); }

  /* FINAL HOME JOURNEY */
  .ph-continue {
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 18px 22px;
    background:
      linear-gradient(100deg, rgba(238,246,232,.96), rgba(255,249,236,.96));
  }

  .ph-continue h2 { font-size: clamp(1.55rem, 2.6vw, 2.45rem); }

  .ph-continue p:not(.ph-kicker) {
    max-width: 820px;
    margin: 7px 0 0;
    color: var(--ph-muted);
    font-size: .8rem;
    line-height: 1.5;
  }

  .ph-home-cta {
    display: inline-flex;
    min-width: 220px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 15px;
    border: 1px solid #316b50;
    border-radius: 999px;
    background: var(--ph-forest);
    color: #fffdf7;
    font-size: .76rem;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 10px 22px -16px rgba(12,45,35,.8);
  }

  .ph-home-cta b { color: #f2aa65; font-size: 1.1rem; }
  .ph-home-cta:hover { background: #225740; }

  .ph-botanical--continue { right: 19%; top: -84px; opacity: .11; transform: rotate(44deg); }

  /* VIDEO DIALOG */
  .ph-video-dialog {
    width: min(94vw, 500px);
    max-height: 94vh;
    padding: 0;
    border: 0;
    border-radius: 26px;
    background: transparent;
    overflow: visible;
  }

  .ph-video-dialog::backdrop {
    background: rgba(7,21,17,.82);
    backdrop-filter: blur(5px);
  }

  .ph-dialog-inner {
    position: relative;
    margin: auto;
    padding: 8px;
    border-radius: 27px;
    background: #173a2f;
    box-shadow: 0 28px 80px rgba(0,0,0,.5);
  }

  .ph-dialog-inner video {
    display: block;
    width: min(82vw, 420px);
    max-height: 88vh;
    aspect-ratio: 9 / 16;
    object-fit: contain;
    border-radius: 21px;
    background: #09140f;
  }

  .ph-dialog-close {
    position: absolute;
    z-index: 5;
    right: -12px;
    top: -12px;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid rgba(255,255,255,.55);
    border-radius: 50%;
    background: #fffdf7;
    color: var(--ph-forest);
    font-size: 1.35rem;
    cursor: pointer;
  }

  /* Dark theme */
  html:is(.dark,[data-theme="dark"]) .philosophy-page {
    --ph-forest: #e8f3eb;
    --ph-forest-deep: #f3f8f4;
    --ph-muted: #b8c7bf;
    --ph-line: #41554a;
  }

  html:is(.dark,[data-theme="dark"]) .ph-block,
  html:is(.dark,[data-theme="dark"]) .ph-hero-copy,
  html:is(.dark,[data-theme="dark"]) .ph-hero-visual,
  html:is(.dark,[data-theme="dark"]) .ph-motion-media,
  html:is(.dark,[data-theme="dark"]) .ph-motion-copy,
  html:is(.dark,[data-theme="dark"]) .ph-stat-card,
  html:is(.dark,[data-theme="dark"]) .ph-person-card,
  html:is(.dark,[data-theme="dark"]) .ph-logo-art,
  html:is(.dark,[data-theme="dark"]) .ph-work-card,
  html:is(.dark,[data-theme="dark"]) .ph-how-grid article,
  html:is(.dark,[data-theme="dark"]) .ph-region-primary,
  html:is(.dark,[data-theme="dark"]) .ph-promise-grid div {
    background: #1c2c26;
    border-color: #42564b;
  }

  html:is(.dark,[data-theme="dark"]) .ph-block {
    background:
      radial-gradient(circle at 100% 0, rgba(81,112,84,.18), transparent 24%),
      #192822;
  }

  html:is(.dark,[data-theme="dark"]) .ph-evidence-intro,
  html:is(.dark,[data-theme="dark"]) .ph-region-art,
  html:is(.dark,[data-theme="dark"]) .ph-tick-list li {
    background: #22352d;
    border-color: #455c50;
  }

  html:is(.dark,[data-theme="dark"]) .ph-search-intent,
  html:is(.dark,[data-theme="dark"]) .ph-stat-card a,
  html:is(.dark,[data-theme="dark"]) .ph-source-links a { color: #ffad76; }

  html:is(.dark,[data-theme="dark"]) .ph-kicker { color: #ff9b5b; }
  html:is(.dark,[data-theme="dark"]) .ph-work-card { background:#203129; }
  html:is(.dark,[data-theme="dark"]) .ph-continue { background:#203129; }

  /* Desktop: make sidebar + page read as one continuous canvas. */
  @media (min-width: 900px) {
    html:has(.ph-hub-header) .onocra-site-content {
      column-gap: 0 !important;
      gap: 0 !important;
    }

    html:has(.ph-hub-header) .philosophy-page {
      margin-left: 0 !important;
      padding-left: 2px !important;
    }

    html:has(.ph-hub-header) .ph-sidebar {
      margin-right: 0 !important;
    }
  }

  @media (max-width: 1180px) {
    .ph-hero { grid-template-columns: minmax(0,1fr) minmax(360px,.9fr); }
    .ph-work-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .ph-how-grid { grid-template-columns: repeat(3, minmax(0,1fr)); }
    .ph-regions { grid-template-columns: 1fr; }
    .ph-region-art { max-width: 680px; }
  }

  @media (max-width: 899px) {
    .philosophy-page { padding: 3px 5px 8px; }
    .ph-block { padding: 12px; border-radius: 11px; }

    .ph-hero,
    .ph-motion,
    .ph-logo-story {
      grid-template-columns: 1fr;
    }

    .ph-hero { min-height: 0; }
    .ph-hero-copy { padding: 24px 18px; }
    .ph-hero-visual { min-height: 0; }
    .ph-hero-visual img { height: auto; max-height: none; }

    .ph-motion { min-height: 0; }
    .ph-motion-media { order: 1; }
    .ph-motion-copy { order: 0; padding: 18px; }
    .ph-phone-frame { width: min(78vw, 330px); }

    .ph-evidence-band { grid-template-columns: 1fr; }
    .ph-country-grid { grid-template-columns: repeat(3, minmax(0,1fr)); }
    .ph-people-grid { grid-template-columns: 1fr; }
    .ph-logo-art { min-height: 420px; }
    .ph-how-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .ph-continue { grid-template-columns: 1fr; }
    .ph-home-cta { width: fit-content; min-width: 210px; }

