  }

  .ph-dialog-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 14px;
    background:
      radial-gradient(circle at 50% 48%, rgba(61,105,86,.35), transparent 54%),
      #10251f;
