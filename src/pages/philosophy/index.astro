        </svg>

        <div class="ph-focus-flags" aria-label="ONOCRA initial markets">
          <span><img src="/internet/flag-us.png" alt="United States flag"/>US</span>
          <span><img src="/internet/flag-uk.png" alt="United Kingdom flag"/>UK</span>
          <span><img src="/internet/flag-germany.png" alt="Germany flag"/>Germany</span>
        </div>

        <div class="ph-focus-legend">
          <span><i class="ph-dot ph-dot--initial"></i>Initial focus</span>
          <span><i class="ph-dot ph-dot--future"></i>Longer-term direction</span>
