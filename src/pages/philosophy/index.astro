<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-ph-video-dialog]");
    const open = document.querySelector("[data-ph-open-video]");
    const close = document.querySelector("[data-ph-close-video]");

    if (!(dialog instanceof HTMLDialogElement)) return;

    const dialogVideo = dialog.querySelector("video");

    open?.addEventListener("click", () => {
      if (!dialog.open) dialog.showModal();
      dialogVideo?.play().catch(() => {});
    });

    const closeDialog = () => {
      dialogVideo?.pause();
      dialog.close();
    };

    close?.addEventListener("click", closeDialog);

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeDialog();
    });

    dialog.addEventListener("cancel", () => {
      dialogVideo?.pause();
    });
  })();
</script>
