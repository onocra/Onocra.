    font-size: .67rem;
  }

  /* WHAT ONOCRA STANDS FOR — use the previously vacant right-side air intentionally. */
  .ph-stands {
    min-height: 390px;
    padding-right: clamp(160px, 19vw, 310px);
  }

  .ph-botanical--stands {
    right: 4%;
    top: -62px;
    width: 330px;
    height: 330px;
    opacity: .18;
    transform: rotate(28deg);
  }

  .ph-botanical--stands-fill {
    right: -54px;
    bottom: -70px;
    width: 330px;
    height: 330px;
    opacity: .22;
    transform: scaleX(-1) rotate(-12deg);
  }

  /* ONE CARING GUIDE — artwork now fills most of its visual panel. */
  .ph-logo-story {
    grid-template-columns: minmax(0, 1fr) minmax(420px, 1fr);
  }

  .ph-logo-art {
    min-height: 600px;
    padding: 8px;
  }

  .ph-logo-art img {
    width: min(100%, 590px);
