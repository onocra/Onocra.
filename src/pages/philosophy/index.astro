<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-ph-video-dialog]");
    const openButton = document.querySelector("[data-ph-open-video]");
    const closeButton = document.querySelector("[data-ph-close-video]");
    const inlineVideo = document.querySelector("[data-ph-inline-video]");
    const dialogVideo = document.querySelector("[data-ph-dialog-video]");

    if (!(dialog instanceof HTMLDialogElement)) return;
    if (!(inlineVideo instanceof HTMLVideoElement)) return;
    if (!(dialogVideo instanceof HTMLVideoElement)) return;

    let closingFromEnded = false;

    const openLarge = async () => {
      try {
        dialogVideo.currentTime = Number.isFinite(inlineVideo.currentTime)
          ? inlineVideo.currentTime
          : 0;
      } catch {}

      inlineVideo.pause();
      if (!dialog.open) dialog.showModal();

      try {
        await dialogVideo.play();
      } catch {
        /* Native controls remain available if autoplay is blocked. */
      }
    };

    const closeLarge = ({ reset = false } = {}) => {
      dialogVideo.pause();

      try {
        if (reset) {
          dialogVideo.currentTime = 0;
          inlineVideo.currentTime = 0;
        } else {
          inlineVideo.currentTime = dialogVideo.currentTime;
        }
      } catch {}

      if (dialog.open) dialog.close();
    };

    openButton?.addEventListener("click", openLarge);
    closeButton?.addEventListener("click", () => closeLarge());

    dialogVideo.addEventListener("ended", () => {
      closingFromEnded = true;
      closeLarge({ reset: true });
      requestAnimationFrame(() => {
        inlineVideo.scrollIntoView({ behavior: "smooth", block: "center" });
        closingFromEnded = false;
      });
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeLarge();
    });

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeLarge();
    });

    dialog.addEventListener("close", () => {
      dialogVideo.pause();
      if (!closingFromEnded) {
        try { inlineVideo.currentTime = dialogVideo.currentTime; } catch {}
      }
    });
  })();
</script>
