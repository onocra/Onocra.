    box-shadow: 0 8px 20px rgba(0,0,0,.18);
  }

  /* WHY THIS MATTERS — image flags from the exact homepage/public paths. */
  .ph-country {
    min-height: 24px;
  }

  .ph-country img {
    display: block;
    width: 30px;
    height: 20px;
    flex: 0 0 30px;
    object-fit: cover;
    border: 1px solid rgba(37,73,57,.14);
    border-radius: 3px;
    box-shadow: 0 2px 6px rgba(23,58,47,.08);
  }

