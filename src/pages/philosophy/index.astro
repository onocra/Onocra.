      text-align: left !important;
    }

    .ph-section-head--center {
      text-align: center !important;
    }
  }

  /* HERO — make the supplied portrait artwork sit exactly in its own panel. */
  .ph-hero {
    grid-template-columns: minmax(0, 1.08fr) minmax(430px, .92fr);
    align-items: stretch;
  }

  .ph-hero-visual {
    min-height: 0;
    aspect-ratio: 5 / 6;
    padding: 0;
    background: #fffdf7;
  }

  .ph-hero-visual img {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    object-position: center;
  }

  /* PHILOSOPHY IN MOTION — portrait video now dominates its side of the section. */
