---
import Layout from "@/layouts/Layout.astro";
import PhonesHeader from "@/components/Phones/Header.astro";
import PhonesFooter from "@/components/Phones/Footer.astro";

// Blueprint catalogue only. Product variants, prices and ratings require source validation.
const brands = ['Apple','Samsung','Google','Motorola','Fitbit','Garmin','OnePlus','Xiaomi'];
const models = [
  { brand: 'Apple', name: 'iPhone 16', tier: 'Premium', year: '2024' },
  { brand: 'Apple', name: 'iPhone 16e', tier: 'Mid-range', year: '2025' },
  { brand: 'Apple', name: 'iPhone 17', tier: 'Premium', year: '2025' },
  { brand: 'Samsung', name: 'Galaxy S25', tier: 'Premium', year: '2025' },
  { brand: 'Samsung', name: 'Galaxy A56', tier: 'Mid-range', year: '2025' },
  { brand: 'Samsung', name: 'Galaxy A36', tier: 'Entry', year: '2025' },
  { brand: 'Google', name: 'Pixel 9a', tier: 'Mid-range', year: '2025' },
  { brand: 'Google', name: 'Pixel 10', tier: 'Premium', year: '2025' },
  { brand: 'Google', name: 'Pixel 8a', tier: 'Mid-range', year: '2024' },
  { brand: 'Motorola', name: 'Edge 60', tier: 'Mid-range', year: '2025' },
  { brand: 'Motorola', name: 'Moto G Power (2025)', tier: 'Entry', year: '2025' },
  { brand: 'OnePlus', name: 'OnePlus 13', tier: 'Premium', year: '2025' },
  { brand: 'OnePlus', name: 'OnePlus 13R', tier: 'Mid-range', year: '2025' },
  { brand: 'Xiaomi', name: 'Xiaomi 15', tier: 'Premium', year: '2025' },
  { brand: 'Xiaomi', name: 'Redmi Note 14 Pro', tier: 'Mid-range', year: '2025' },
];
const criteria = [
  ['Camera & video','15%'], ['Battery & charging','15%'], ['Display','10%'],
  ['Performance','10%'], ['Software & security','10%'], ['Build & durability','10%'],
  ['Ease of use & accessibility','5%'], ['Connectivity & features','5%'],
];
const regional = [['Local price & value','8%'],['Network compatibility','4%'],['Warranty, service & repair','4%'],['Regional features & support','4%']];
---
<Layout>
  <PhonesHeader />
  <main class="review-page" id="main-content">
    <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/phones/">Phones, Tablets & Wearables</a><span>›</span><strong>Phone Reviews</strong></nav>
    <div class="review-grid">
      <aside class="review-art">
        <p class="eyebrow">ONOCRA · SMARTER CHOICES</p>
        <img src="/phones/phonescompare.png" alt="ONOCRA pelican comparing two smartphones" loading="eager" />
        <h2>Two phones. One better choice for you.</h2>
        <p>Compare evidence, not advertising. Find out what matters before you buy.</p>
        <div class="art-points"><span>✓ Independent sources</span><span>✓ Side-by-side analysis</span><span>✓ US & EU buying guidance</span></div>
      </aside>
      <div class="review-workspace">
        <div class="intro"><p class="eyebrow">REVIEWS · COMPARE WITH CONFIDENCE</p><h1>Choose your phone, compare with confidence</h1><p>Pick a brand and budget tier, browse matching models, then add up to three to your comparison cart. Verified results will lead to a regional buying choice.</p></div>
        <nav class="category-tabs" aria-label="Device review categories"><a class="active" href="/phones/reviews/" aria-current="page">▣ Phones</a><a href="/phones/tablets/reviews/" data-future="true">▤ Tablets <small>Coming next</small></a><a href="/phones/wearables/reviews/" data-future="true">◉ Wearables <small>Coming next</small></a></nav>
        <section aria-labelledby="brand-heading" class="browse"><div class="section-title"><h2 id="brand-heading">Choose a brand</h2><span>8 covered brands · model catalogue under validation</span></div>
          <div class="brand-grid"><button type="button" class="brand active" data-brand="All" aria-pressed="true">All brands</button>{brands.map(brand => <button type="button" class="brand" data-brand={brand} aria-pressed="false">{brand}</button>)}</div>
          <div class="filters"><label>Budget tier<select id="tier-filter"><option value="All">All tiers</option><option value="Entry">Entry · up to $X</option><option value="Mid-range">Mid-range · $X–$Y</option><option value="Premium">Premium · above $Y</option></select></label><label>Release year<select id="year-filter"><option value="All">All years</option><option value="2025">2025</option><option value="2024">2024</option></select></label><label>Search model<input id="model-search" type="search" placeholder="e.g. Galaxy or Pixel" /></label><button id="reset-filters" class="reset" type="button">↺ Reset</button></div>
          <p class="research-note"><strong>Budget thresholds $X and $Y are placeholders until US/EU price research is complete.</strong> Fitbit and Garmin are covered under wearables, not smartphone model listings. <strong>Research preview:</strong> These are illustrative catalogue entries, not a validated ranking. Final model eligibility, budget tiers and US/EU prices will be checked against current market evidence.</p>
        </section>
        <section class="catalogue" aria-labelledby="models-heading"><div class="section-title"><h2 id="models-heading">Explore phone models</h2><span id="result-count">Models available for preview</span></div>
          <div class="model-grid" id="model-grid">{models.map((model, index) => <article class="model-card" data-brand={model.brand} data-tier={model.tier} data-year={model.year} data-name={model.name.toLowerCase()}><div class="model-visual" aria-hidden="true"><span class="phone-silhouette"><i></i><i></i><i></i></span></div><span class="model-brand">{model.brand}</span><h3>{model.name}</h3><span class="tier">{model.tier} · provisional</span><p class="model-meta">{model.year} · US/EU pricing pending</p><button type="button" class="select-model" data-index={index} aria-pressed="false">＋ Add to comparison</button></article>)}</div>
          <p id="empty-message" hidden>No matching models in this preview. Try clearing your filters.</p>
        </section>
        <section class="compare-panel" id="compare" aria-labelledby="compare-heading"><div class="section-title"><div><p class="eyebrow">COMPARE WITH CONFIDENCE</p><h2 id="compare-heading">Compare up to three phones</h2></div><button id="clear-compare" class="reset" type="button">Clear selection</button></div><p>Select models above. The framework is functional; numerical scores will appear only after model-level validation.</p><div id="comparison-slots" class="comparison-slots" aria-live="polite"><div class="empty-slot">＋ Choose your first model</div><div class="empty-slot">＋ Choose your second model</div><div class="empty-slot">＋ Optional third model</div></div><div id="comparison-results" hidden><h3>ONOCRA Evaluation Transparency Matrix</h3><p class="small-note">The proposed common 80% criteria and regional 20% factors are shown below. Expert weightings and device findings must be verified against each publisher's current methodology.</p><div class="table-scroll"><table><thead><tr><th>Evaluation criterion</th><th>ONOCRA proposal</th><th>Which?</th><th>Consumer Reports</th><th>Selected models</th></tr></thead><tbody>{criteria.map(([criterion,weight]) => <tr><th>{criterion}</th><td>{weight}</td><td>See source methodology</td><td>Weight not publicly confirmed</td><td>Evidence pending</td></tr>)}<tr class="regional-heading"><th colspan="5">Market-specific buying factors — US or EU (20%)</th></tr>{regional.map(([criterion,weight]) => <tr><th>{criterion}</th><td>{weight}</td><td>Not directly comparable</td><td>Not directly comparable</td><td>US/EU research pending</td></tr>)}</tbody></table></div><p class="small-note">Published Which? categories do not map one-to-one to these ONOCRA categories. Do not interpret the table as an endorsement by any external publisher.</p></div></section>

        <section class="purchase-path" id="choose" aria-labelledby="purchase-title"><p class="eyebrow">STEP 3 · CHOOSE SMARTER</p><h2 id="purchase-title">Ready to choose your best-fit phone?</h2><p>After model-specific ONOCRA scores and US/EU prices are verified, this step will present the strongest fit for your priorities, explain the trade-offs, and link to a dedicated Choose / affiliate-pricing page.</p><div class="purchase-actions"><label>Buying market<select id="buying-market"><option value="US">United States</option><option value="EU">European Union</option></select></label><button type="button" disabled title="Requires validated device evidence and merchant offers">Choose & compare buying offers · coming soon</button></div><small>No live price, merchant availability, model ranking or affiliate offer is claimed at this stage.</small></section>
      </div>
    </div>
  </main>
  <PhonesFooter />
</Layout>
<script define:vars={{ models }}>
  const brandButtons=[...document.querySelectorAll('[data-brand].brand')];
  const cards=[...document.querySelectorAll('.model-card')];
  const tier=document.querySelector('#tier-filter'),year=document.querySelector('#year-filter'),search=document.querySelector('#model-search');
  const chosen=[];let brand='All';
  function filter(){let count=0;for(const card of cards){const ok=(brand==='All'||card.dataset.brand===brand)&&(tier.value==='All'||card.dataset.tier===tier.value)&&(year.value==='All'||card.dataset.year===year.value)&&card.dataset.name.includes(search.value.trim().toLowerCase());card.hidden=!ok;if(ok)count++;}document.querySelector('#result-count').textContent=count+' models in this preview';document.querySelector('#empty-message').hidden=count!==0;}
  brandButtons.forEach(b=>b.addEventListener('click',()=>{brand=b.dataset.brand;brandButtons.forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-pressed',String(x===b));});filter();}));
  [tier,year,search].forEach(el=>el.addEventListener(el===search?'input':'change',filter));
  document.querySelector('#reset-filters').addEventListener('click',()=>{brand='All';tier.value='All';year.value='All';search.value='';brandButtons.forEach(b=>{b.classList.toggle('active',b.dataset.brand==='All');b.setAttribute('aria-pressed',String(b.dataset.brand==='All'));});filter();});
  function render(){const slots=document.querySelector('#comparison-slots');slots.replaceChildren();for(let i=0;i<3;i++){const idx=chosen[i];const el=document.createElement('div');if(idx===undefined){el.className='empty-slot';el.textContent=i===2?'＋ Optional third model':`＋ Choose model ${i+1}`;}else{el.className='selected-slot';const title=document.createElement('strong');title.textContent=models[idx].name;const sub=document.createElement('small');sub.textContent=models[idx].brand+' · '+models[idx].tier;const btn=document.createElement('button');btn.type='button';btn.textContent='Remove ×';btn.addEventListener('click',()=>{chosen.splice(i,1);render();});el.append(title,sub,btn);}slots.append(el);}document.querySelector('#comparison-results').hidden=chosen.length<2;document.querySelectorAll('.select-model').forEach(btn=>{const selected=chosen.includes(Number(btn.dataset.index));btn.textContent=selected?'✓ Selected':'＋ Add to comparison';btn.setAttribute('aria-pressed',String(selected));});}
  document.querySelectorAll('.select-model').forEach(btn=>btn.addEventListener('click',()=>{const idx=Number(btn.dataset.index),position=chosen.indexOf(idx);if(position!==-1)chosen.splice(position,1);else if(chosen.length<3)chosen.push(idx);else{document.querySelector('#compare').scrollIntoView({behavior:'smooth',block:'start'});return;}render();if(chosen.length===2)document.querySelector('#compare').scrollIntoView({behavior:'smooth',block:'start'});}));
  document.querySelector('#clear-compare').addEventListener('click',()=>{chosen.length=0;render();});
  document.querySelectorAll('[data-future]').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();link.title='This category is planned for a later implementation stage.';}));
  const params=new URLSearchParams(window.location.search);const requestedBrand=params.get('brand');const requestedTier=params.get('tier');if(requestedBrand&&brands.includes(requestedBrand)){brand=requestedBrand;brandButtons.forEach(b=>{const yes=b.dataset.brand===brand;b.classList.toggle('active',yes);b.setAttribute('aria-pressed',String(yes));});}if(requestedTier&&['Entry','Mid-range','Premium'].includes(requestedTier))tier.value=requestedTier;filter();render();
</script>
<style>
  .review-page{max-width:1480px;margin:auto;padding:24px clamp(16px,3vw,42px) 70px;color:#163b39}.crumb{display:flex;gap:11px;flex-wrap:wrap;font-size:13px;margin-bottom:22px}.crumb a{color:#326e7c;text-decoration:none}.crumb span{color:#92a7aa}.review-grid{display:grid;grid-template-columns:minmax(230px,25%) minmax(0,1fr);gap:24px;align-items:start}.review-art{position:sticky;top:18px;padding:24px 19px 28px;border:1px solid #d5e4db;border-radius:22px;background:linear-gradient(165deg,#e5f5ec,#fef8e8 70%);overflow:hidden}.review-art img{width:100%;aspect-ratio:4/4.6;object-fit:cover;object-position:center;border-radius:18px;margin:14px 0}.review-art h2{font:700 clamp(25px,2.6vw,37px)/1.12 Georgia,serif;color:#103c37;margin:0 0 10px}.review-art p{line-height:1.5}.art-points{display:grid;gap:9px;margin-top:16px;font-size:13px;font-weight:600}.eyebrow{color:#ad5843;font-size:11px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.review-workspace{min-width:0}.intro h1{font:700 clamp(30px,4vw,50px)/1.08 Georgia,serif;color:#0c3b35;margin:7px 0 10px}.intro>p:last-child{color:#526a6a;line-height:1.55;margin-bottom:22px}.category-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:22px}.category-tabs a{text-align:center;border:1px solid #d8e4e7;border-radius:11px;padding:14px 8px;text-decoration:none;color:#183d4b;font-weight:700;background:white}.category-tabs .active{background:#137e67;color:white}.category-tabs small{display:block;font-weight:400;font-size:10px}.browse,.catalogue,.compare-panel,.methodology{margin:0 0 21px;padding:19px;border:1px solid #dce7df;border-radius:18px;background:#fffdf9}.section-title{display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:14px}.section-title h2{font:700 25px Georgia,serif;margin:0;color:#143d35}.section-title span,.small-note{font-size:12px;color:#6c7d81}.brand-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.brand{border:1px solid #d6e3e2;border-radius:12px;padding:15px 6px;background:#fff;font-weight:700;color:#163f4a;cursor:pointer}.brand.active{border-color:#0b806b;background:#e2f4eb;color:#006c55}.filters{display:grid;grid-template-columns:1fr 1fr 1.3fr auto;gap:9px;margin-top:17px;align-items:end}.filters label{display:grid;gap:6px;font-size:11px;font-weight:700;color:#425c62}.filters select,.filters input{min-width:0;width:100%;padding:11px 9px;border:1px solid #d1e0e4;border-radius:10px;background:white;font:inherit;font-size:13px}.reset{border:1px solid #cbdde1;background:#f4f8f7;border-radius:10px;padding:11px 14px;color:#195968;cursor:pointer}.research-note{font-size:12px;line-height:1.5;background:#fff6e6;border-left:3px solid #d49a41;padding:10px 12px;margin:15px 0 0}.model-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}.model-card{border:1px solid #dce6e8;border-radius:14px;padding:13px;background:#fff;min-width:0}.model-card[hidden]{display:none}.model-visual{height:116px;display:grid;place-items:center;background:linear-gradient(135deg,#eaf6f7,#f8f2ec);border-radius:10px}.phone-silhouette{position:relative;width:55px;height:94px;border:4px solid #1e3b49;border-radius:12px;background:linear-gradient(150deg,#67b7c4,#b3b3e5,#f4d2bb);box-shadow:10px 4px 0 #9ca5ae}.phone-silhouette i{position:absolute;width:7px;height:7px;background:#26495b;border-radius:50%;left:7px;top:8px}.phone-silhouette i:nth-child(2){left:18px}.phone-silhouette i:nth-child(3){top:19px}.model-brand{display:block;color:#74878b;font-size:11px;margin-top:11px}.model-card h3{font:700 17px Georgia,serif;margin:3px 0 7px;color:#153c3b}.tier{display:inline-block;border-radius:30px;background:#edf3ed;color:#4d675b;padding:4px 8px;font-size:10px}.model-meta{font-size:11px;color:#718186;min-height:27px}.select-model{width:100%;background:#edf6f1;border:1px solid #b8d9c9;border-radius:9px;padding:9px 4px;color:#08725d;font-size:12px;font-weight:700;cursor:pointer}.select-model[aria-pressed=true]{background:#147c65;color:#fff}.compare-panel{background:#f3f8f7}.compare-panel>p{font-size:13px;color:#5e7476}.comparison-slots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin:18px 0}.empty-slot,.selected-slot{min-height:90px;border:1px dashed #b9cdd0;border-radius:11px;padding:15px;background:#fff;display:flex;flex-direction:column;justify-content:center;gap:7px;font-size:12px;color:#637b7d}.selected-slot{border-style:solid;border-color:#8cbfb1;color:#133d3b}.selected-slot small{color:#6e8182}.selected-slot button{align-self:flex-start;background:none;border:0;color:#a04435;cursor:pointer;padding:0;font-size:11px}.table-scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:710px;font-size:12px}td,th{border:1px solid #dbe6e5;padding:9px;text-align:left;vertical-align:top}thead{background:#e1efe9}.regional-heading{background:#eaf4f1}.method-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:15px}.method-grid article{padding:14px;background:#f0f7f2;border-radius:11px}.method-grid strong{font-size:13px}.method-grid p{font-size:12px;line-height:1.5;color:#526b69}.methodology details{border-top:1px solid #dce6e1;padding:13px 0}.methodology summary{cursor:pointer;font-weight:700;font-size:13px}.methodology summary span{float:right}.methodology details p{font-size:13px;line-height:1.6}.methodology a{color:#0b6f87}#empty-message{padding:20px;color:#63777b}#empty-message[hidden],#comparison-results[hidden]{display:none}@media(max-width:1000px){.review-grid{grid-template-columns:minmax(180px,28%) minmax(0,1fr);gap:15px}.model-grid{grid-template-columns:repeat(3,1fr)}.filters{grid-template-columns:1fr 1fr}.review-art{position:static}}@media(max-width:690px){.review-grid{grid-template-columns:1fr}.review-art{display:grid;grid-template-columns:35% 1fr;gap:10px;align-items:center}.review-art .eyebrow{grid-column:1/-1}.review-art img{grid-row:2/5;margin:0;aspect-ratio:1/1.3}.review-art h2{font-size:23px}.review-art p{font-size:12px}.art-points{grid-column:1/-1}.model-grid,.brand-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.comparison-slots,.method-grid{grid-template-columns:1fr}.category-tabs{gap:4px}.category-tabs a{font-size:12px}.browse,.catalogue,.compare-panel,.methodology{padding:13px}.review-page{padding:16px 12px 45px}}
</style>

<style>
.purchase-path{margin:0 0 22px;padding:22px;border:1px solid #d5e4da;border-radius:18px;background:linear-gradient(120deg,#e9f6ee,#fff9e9)}
.purchase-path h2{font:700 27px Georgia,serif;color:#18483c;margin:5px 0 9px}
.purchase-path p{font-size:13px;line-height:1.6;color:#46665b}
.purchase-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin:15px 0}
.purchase-actions label{display:grid;gap:6px;font-size:12px;font-weight:700}.purchase-actions select{padding:11px;border:1px solid #bed4c7;border-radius:9px}
.purchase-actions button{padding:12px 16px;border:0;border-radius:9px;background:#a8bbb0;color:#244b3e;cursor:not-allowed;font-weight:700}
.purchase-path small{color:#667c72;font-size:11px}
</style>
