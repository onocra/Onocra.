---
import Layout from "@/layouts/Layout.astro";
import PhonesHeader from "@/components/Phones/Header.astro";
import PhonesFooter from "@/components/Phones/Footer.astro";

const params = Astro.url.searchParams;
const categories = ["phones","tablets","wearables"];
const brands = ["Apple","Samsung","Google","Xiaomi","OnePlus","Motorola","Fitbit","Garmin"];
const markets = ["US","UK","DE","FR","IT","ES","EU"];
const category = categories.includes(params.get("category") ?? "") ? params.get("category")! : "phones";
const brand = brands.includes(params.get("brand") ?? "") ? params.get("brand")! : "";
const market = markets.includes(params.get("market") ?? "") ? params.get("market")! : "US";
const tier = /^(all|under-300|300-599|600-999|1000-1500|over-1500)$/.test(params.get("tier") ?? "") ? params.get("tier")! : "all";
const intent = params.get("intent") ?? "browse";
const queryString = new URLSearchParams({category,brand,market,tier}).toString();
const modeCards = [
 {slug:"generations",title:"Compare Generations",desc:"What improved, stayed the same, or regressed between generations?",icon:"↗"},
 {slug:"across-brands",title:"Across Brands",desc:"Compare the features and trade-offs of different manufacturers.",icon:"⇄"},
 {slug:"value",title:"Value Matrix",desc:"Separate technical improvement from the extra money you would spend.",icon:"◈"},
 {slug:"match",title:"Your Match",desc:"Prioritise what matters to you, with region and budget checks.",icon:"◎"}
];
const categoryLabel: Record<string,string> = {phones:"Phones",tablets:"Tablets",wearables:"Wearables"};
---
<Layout title="Reviews & Comparisons | ONOCRA" description="Browse independent smartphone research, compare generations and explore regional buying guidance.">
  <PhonesHeader />
  <main class="review-workspace" id="main-content">
    <header class="workspace-heading">
      <p class="eyebrow">ONOCRA REVIEWS · YOUR DECISION WORKSPACE</p>
      <h1>Explore. Compare. Decide.</h1>
      <p>Clear evidence and sensible comparisons — without repeating the choices you already made.</p>
    </header>

    <section class="preferences" aria-labelledby="pref-title">
      <div class="section-title"><h2 id="pref-title">Your search preferences</h2><a href="/phones/#reviews">Change on Phones hub ↗</a></div>
      <dl>
        <div><dt>Product</dt><dd>{categoryLabel[category]}</dd></div>
        <div><dt>Brand</dt><dd>{brand || "All brands"}</dd></div>
        <div><dt>Budget</dt><dd>{tier === "all" ? "All prices" : tier.replaceAll("-", "–") + " USD"}</dd></div>
        <div><dt>Market</dt><dd>{market}</dd></div>
      </dl>
      <a class="primary-action" href={`/phones/reviews/models/?${queryString}`}>Browse matching models →</a>
      {category !== "phones" && <p class="data-note">Tablet and wearable model research is being prepared. No phone results will be presented as tablet or wearable matches.</p>}
    </section>

    <section class="comparison" aria-labelledby="mode-title">
      <div class="section-title"><div><p class="eyebrow">SELECT YOUR ROUTE</p><h2 id="mode-title">How would you like to compare?</h2></div></div>
      <div class="mode-grid">
        {modeCards.map(mode => <a class="mode-card" href={`/phones/reviews/models/?${queryString}&mode=${mode.slug}`}>
          <span class="mode-icon" aria-hidden="true">{mode.icon}</span><h3>{mode.title}</h3><p>{mode.desc}</p><span class="go">Select mode →</span>
        </a>)}
      </div>
      {intent === "compare" && <p class="context-note">Your comparison request from the Phones hub has been carried forward. Select the comparison method above.</p>}
    </section>

    <section class="reading" aria-labelledby="reading-title">
      <div class="section-title"><div><p class="eyebrow">READ · LEARN · DISCOVER</p><h2 id="reading-title">Reviews & editorial research</h2></div><a href="/posts/">Browse published articles ↗</a></div>
      <p>Original ONOCRA reviews, explainers and comparisons will appear here when published. We will not display unpublished placeholders as completed reviews.</p>
      <a class="text-link" href="/phones/reviews/methodology/">How ONOCRA evaluates devices →</a>
    </section>

    <section class="method-preview" aria-labelledby="method-title">
      <p class="eyebrow">OUR EVALUATION APPROACH · EXPLAINED</p>
      <h2 id="method-title">How we reach a verdict</h2>
      <div class="principles">
        <div><h3>Everyday Use</h3><p>Usability, battery, accessibility, reliability and practical suitability.</p></div>
        <div><h3>Technical Performance</h3><p>Verified specifications, independent benchmarks and their limitations.</p></div>
        <div><h3>Value for Money</h3><p>Local retailer pricing, software support, alternatives and upgrade costs.</p></div>
      </div>
      <p>ONOCRA cites external research; it does not claim to conduct laboratory tests. Manufacturer claims, independent findings and ONOCRA editorial conclusions remain distinguishable.</p>
      <a class="primary-action" href="/phones/reviews/methodology/">Read our detailed methodology →</a>
    </section>
  </main>
  <PhonesFooter />
</Layout>
<style>
.review-workspace{--ink:#123e2e;--edge:#83b891;--paper:#eaf7e8;max-width:1200px;margin:22px auto 48px;padding:0 16px;color:var(--ink)}
.review-workspace section,.workspace-heading{border:2px solid var(--edge);border-radius:22px;background:var(--paper);padding:clamp(18px,3vw,32px);margin-bottom:14px}
.workspace-heading{background:linear-gradient(110deg,#e6f7e6,#b6e4bd)}
.review-workspace h1,.review-workspace h2,.review-workspace h3{font-family:Georgia,"Times New Roman",serif;color:var(--ink);line-height:1.12}
.review-workspace h1{font-size:clamp(35px,5vw,62px);margin:8px 0}.review-workspace h2{font-size:clamp(25px,3vw,37px)}.review-workspace h3{font-size:23px}
.review-workspace p{line-height:1.55}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.1em;color:#bd5a25}
.section-title{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}
.review-workspace a{color:#17614c}.preferences dl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:18px 0}
.preferences dl div{background:#fffdf5;border:1px solid #b3d2ba;border-radius:12px;padding:12px;min-width:0}
.preferences dt{font-size:12px;color:#547465}.preferences dd{font-weight:750;margin:5px 0 0;overflow-wrap:anywhere}
.primary-action{display:inline-block!important;background:#62b785;color:#093b2c!important;text-decoration:none;font-weight:800;border:1px solid #429566;border-radius:12px;padding:12px 18px}
.mode-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:18px}
.mode-card{display:block;background:#f9fff8;border:1.5px solid #a6d1ad;border-radius:16px;padding:20px;text-decoration:none}
.mode-card:hover,.mode-card:focus-visible{border-color:#328c5b;box-shadow:0 5px 18px #14512b22}
.mode-card p{color:#486c58}.mode-icon{font-size:27px;color:#b45d24}.go,.text-link{font-weight:800}
.principles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:20px 0}
.principles>div{border-left:3px solid #79b18a;padding:6px 12px}.data-note,.context-note{font-size:14px;color:#5d6045}
:global(html[data-theme="dark"]) .review-workspace{--ink:#e8f7ec;--edge:#397e5b;--paper:#1d332a}
:global(html[data-theme="dark"]) .workspace-heading{background:linear-gradient(110deg,#213f32,#2c5a3e)}
:global(html[data-theme="dark"]) .preferences dl div,:global(html[data-theme="dark"]) .mode-card{background:#263e31;color:#e8f7ec}
:global(html[data-theme="dark"]) .mode-card p{color:#c5d9cb}
@media(max-width:680px){.preferences dl{grid-template-columns:repeat(2,minmax(0,1fr))}.mode-grid,.principles{grid-template-columns:1fr}.review-workspace{padding:0 10px}.review-workspace section,.workspace-heading{padding:18px}}
</style>
