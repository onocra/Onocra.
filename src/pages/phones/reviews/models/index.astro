---
// ONOCRA — Step 4: phones-only model discovery and comparison selection.
// Replace: src/pages/phones/reviews/models/index.astro
// No invented model data, popularity counts, prices or scoring.
import FlowShell from "@/components/Reviews/FlowShell.astro";
import { devices } from "@/data/devices";
import { BRANDS, REGIONS, readState, stepUrl } from "@/lib/reviewFlow";

const initial = readState(Astro.url.search);
// Publish only fields already present in devices.ts; the browser applies the
// exact release-date cutoff and filters. Release-date aliases are optional.
const publicDevices = devices.map((d) => {
  const raw = d as any;
  return {
    id: d.id, brand: d.brand, name: d.name, family: raw.family ?? "",
    category: d.category, year: d.year, summary: d.summary,
    image: raw.image, images: raw.images, status: d.status,
    releaseDate: raw.releaseDate ?? raw.releasedAt ?? raw.launchDate ?? null,
    prices: d.prices, specs: d.specs, fit: raw.fit ?? {},
    regionalSpecs: d.regionalSpecs, regionalOffers: d.regionalOffers,
    regionalVariants: d.regionalVariants,
    // Include optional explicit network evidence if it already exists in the catalogue.
    // Missing values remain unknown; never infer 5G from phone name or release year.
    fiveG: raw.fiveG ?? raw.supports5G ?? raw.is5G ?? null,
    network: raw.network ?? raw.networkSupport ?? null,
    // Measured view counts are optional. Never fabricate popularity numbers.
    popularity7d: raw.popularity7d ?? null,
    popularitySource: raw.popularitySource ?? null,
  };
});
---
<FlowShell
  step={4}
  wide
  title="Select your phone | ONOCRA"
  heading="Select Your Phone"
  lead="Choose your primary phone and compare it with up to two alternatives."
>
  <div id="onocra-step4">
    <aside class="s4-guide" aria-label="ONOCRA guide for this step">
      <div class="s4-guide-icon" aria-hidden="true"><img src="/phones/reviews/categories/pelican-step4.png" alt="" width="64" height="64" loading="eager" decoding="async" /></div>
      <div>
        <strong>ONOCRA guide — how this step works</strong>
        <p>Find a phone in the <b>numbered phone list</b> or through <b>Filters</b>. Click a model to see its photograph, specifications and price, then set it as your <b>primary phone</b>. ONOCRA will show up to <b>five relevant alternatives</b>; select <b>up to two</b> to compare with your primary phone.</p>
      </div>
    </aside>

    <div class="s4-columns" id="discovery">
      <section class="s4-panel s4-popular" aria-labelledby="s4-popular-title">
        <header class="s4-panel-head">
          <div><h2 id="s4-popular-title">① Popular &amp; Latest Phones</h2><p>Numbered compact list. Tap any phone to expand.</p></div>
          <details class="s4-help"><summary aria-label="How are phones ordered?">ⓘ</summary><div>Phones are currently numbered by release recency because ONOCRA does not yet have verified seven-day view counts. We will use genuine popularity figures once available. The numbers are <strong>list positions, not popularity scores</strong>.</div></details>
        </header>
        <div class="s4-table-head"><span>#</span><span>Phone model</span><span>Year</span><span>7d views</span><span aria-hidden="true">⌄</span></div>
        <div id="s4-popular-list" aria-live="polite"></div>
        <button class="s4-muted-button" type="button" id="s4-more-popular">Show next 10 phones ↓</button>
        <button class="s4-text-button s4-less-popular" type="button" id="s4-less-popular" hidden>↑ Show first 10 phones</button>
      </section>

      <section class="s4-panel s4-filter" aria-labelledby="s4-filter-title">
        <header class="s4-panel-head"><div><h2 id="s4-filter-title">② Find Phones Using Filters</h2><p>Search only the phone models in ONOCRA's database.</p></div></header>
        <div class="s4-filters">
          <label class="s4-field s4-wide">Search model
            <input id="s4-search" type="search" placeholder="e.g. Galaxy S25 or iPhone 16" autocomplete="off" />
          </label>
          <label class="s4-field">Brand<select id="s4-brand"><option value="">All brands</option>{BRANDS.map(b => <option value={b}>{b}</option>)}</select></label>
          <label class="s4-field">Region<select id="s4-region">{REGIONS.map(r => <option value={r.id}>{r.label}</option>)}</select></label>
          <label class="s4-field">Price range <span id="s4-currency">(USD)</span><select id="s4-price"><option value="">Any verified price</option></select></label>
          <label class="s4-field">Release year <details class="s4-inline-help"><summary title="ONOCRA comparison eligibility policy" aria-label="Read ONOCRA model eligibility policy">ⓘ</summary><div><strong>ONOCRA eligibility policy</strong><p>We include smartphones officially released from <strong>1 October 2023 onward</strong>. This is a fixed starting date, not a rolling three-year limit. As newer phones arrive, older eligible phones remain in the comparison database. A 2023 phone requires a verified October–December release month before inclusion.</p></div></details>
            <select id="s4-year"><option value="">All eligible years</option></select>
          </label>
          <label class="s4-field">RAM (minimum)<select id="s4-ram"><option value="">Any verified RAM</option></select></label>
          <label class="s4-field">ROM (minimum)<select id="s4-storage"><option value="">Any verified ROM</option></select></label>
          <label class="s4-field">5G support<select id="s4-5g"><option value="">Any / not specified</option><option value="yes">5G supported (documented)</option><option value="no">No 5G (documented)</option><option value="unknown">5G status not recorded</option></select></label>
          <label class="s4-field">Battery (minimum)<select id="s4-battery"><option value="">Any verified battery</option></select></label>
          <label class="s4-field">Screen (minimum)<select id="s4-screen"><option value="">Any verified size</option></select></label>
          <label class="s4-field">Camera (minimum MP)<select id="s4-camera"><option value="">Any verified camera</option></select></label>
          <button class="s4-action s4-search-button" type="button" id="s4-run-filter">⌕ Show matching phones</button>
        </div>
        <p class="s4-evidence-note">Filters use documented data only. Phones missing evidence for an active filter are excluded from those results.</p>
        <div id="s4-filtered" hidden><div class="s4-filtered-label"><strong id="s4-filtered-title">Matching phones</strong><button type="button" id="s4-more-filtered" class="s4-text-button" hidden>Show more ↓</button></div><div id="s4-filtered-list"></div></div>
      </section>
    </div>

    <section class="s4-panel s4-builder" id="s4-comparison" aria-labelledby="s4-compare-title">
      <header class="s4-panel-head">
        <div><h2 id="s4-compare-title">③ Build Your Comparison</h2><p>One primary phone + up to two additional phones from five suitable alternatives.</p></div>
        <span id="s4-selection-count" class="s4-count">0 of 2 added</span>
      </header>
      <div id="s4-comparison-content" aria-live="polite"><p class="s4-empty">Choose your primary phone above to see ONOCRA's shortlist.</p></div>
      <p id="s4-recommendation-note" class="s4-evidence-note" hidden></p>
    </section>
  </div>
  <div slot="nav"><a class="btn ghost" id="models-back" href={stepUrl("priorities", initial)}>← Back</a><a class="btn" id="models-next" href={stepUrl("verdict", initial)} aria-disabled="true">Continue to Step 5 →</a></div>
  <script type="application/json" id="s4-catalogue" set:html={JSON.stringify(publicDevices).replace(/</g, "\\u003c")} />
</FlowShell>

<script>
  import {readState,stepUrl,regionInfo, type RegionId, type PriorityId} from "@/lib/reviewFlow";
  type Spec = {value:string; source?:string; kind?:string; numeric?:number};
  type Offer = {value:string;storage:string;channel:string;checkedAt?:string};
  type Item = {
    id:string;brand:string;name:string;family?:string;category:string;year:number;summary?:string;
    image?:string;images?:string[];status?:string;releaseDate?:string|null;
    prices?:Record<string,{amount:number;config:string;seller:string;asOf:string}|undefined>;
    specs?:Record<string,Spec>;regionalSpecs?:Record<string,Record<string,Spec>>;
    regionalOffers?:Record<string,Offer[]>;
    regionalVariants?:Record<string,{network?:string; networks?:string; connectivity?:string; fiveG?:boolean; supports5G?:boolean; [key:string]:unknown}>;
    fiveG?: boolean|string|null; network?: string|null;
    fit?:Record<string,"strong"|"adequate"|"limited"|"unverified">;
    popularity7d?:number|null;popularitySource?:string|null;
  };
  type FilterKey = "ram"|"storage"|"battery"|"screen"|"camera";
  const MIN_DATE = "2023-10-01";
  const query = <T extends Element>(root:ParentNode, sel:string) => root.querySelector<T>(sel);
  const el=(tag:string,cls?:string,content?:string)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(content!=null)e.textContent=content;return e;};
  const num=(v:unknown)=>v===null||v===undefined||String(v).trim()===""?null:(Number.isFinite(Number(v))?Number(v):null);
  const isSafeUrl=(url:string)=>url.startsWith("/")||/^https:\/\//i.test(url);
  const displayName=(d:Item)=>d.name.toLowerCase().startsWith(d.brand.toLowerCase())?d.name:`${d.brand} ${d.name}`;

  function initStep4(){
    const root=document.getElementById("onocra-step4");
    if(!root || root.dataset.s4Ready==="yes") return;
    root.dataset.s4Ready="yes";
    const dataNode=document.querySelector<HTMLScriptElement>("#s4-catalogue");
    if(!dataNode)return;
    let all:Item[]=[];
    try { all=JSON.parse(dataNode.textContent||"[]") as Item[]; } catch { /* show empty state */ }
    const s=readState(location.search);
    const prior=s as typeof s & {brands?:string[]; compare?:string[]};
    // Phones only, regardless of obsolete category in an earlier URL.
    s.cat="phones";
    let region=s.region;
    let primary="";
    let additional:string[]=[];
    let openId="";
    const POPULAR_BATCH = 10; // Start with ten, reveal ten more on each click.
    let latestLimit=POPULAR_BATCH;
    let filteredLimit=8;
    let lastMatches:Item[]|null=null;
    let recommendationNote="";
    const byId=new Map(all.map(d=>[d.id,d]));
    const $=<T extends Element>(selector:string)=>query<T>(document,selector)!;
    const val=(id:string)=>$<HTMLSelectElement>(id).value;

    function rawSpec(d:Item,keys:string[]):Spec|undefined{
      const combined={...(d.specs||{}),...(d.regionalSpecs?.[region]||{})};
      for(const key of keys){const match=Object.entries(combined).find(([k])=>k.toLowerCase().replace(/[^a-z0-9]/g,"")===key.toLowerCase().replace(/[^a-z0-9]/g,""));if(match?.[1]?.value)return match[1];}
      return undefined;
    }
    const spec=(d:Item,keys:string[])=>rawSpec(d,keys)?.value||"";
    function releaseDate(d:Item):string|null{
      const raw=d.releaseDate||spec(d,["releaseDate","release date","release","released","launchDate","launch date","availability date"]);
      if(!raw)return null;
      const iso=raw.match(/\b(20\d\d)[\/-](\d{1,2})(?:[\/-](\d{1,2}))?\b/);
      if(iso){const [_,y,m,day]=iso;const month=Number(m);if(month>=1&&month<=12)return `${y}-${m.padStart(2,"0")}-${(day||"01").padStart(2,"0")}`;}
      const months:Record<string,number>={jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
      const words=raw.match(/\b(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:tember)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\s+(?:\d{1,2},?\s+)?(20\d{2})\b/i);
      if(words){const m=months[words[1].slice(0,3).toLowerCase()];return `${words[2]}-${String(m).padStart(2,"0")}-01`;}
      return null;
    }
    function eligible(d:Item){
      if(d.category!=="phones"||!Number.isInteger(d.year)||d.year<2023||d.year>new Date().getFullYear())return false;
      if(d.year>=2024)return true;
      const date=releaseDate(d);return !!date&&date>=MIN_DATE;
    }
    const inventory=all.filter(eligible);
    const price=(d:Item)=>d.prices?.[region]?.amount;
    const money=(n:number)=>`${regionInfo(region).symbol}${n.toLocaleString("en-US",{maximumFractionDigits:0})}`;
    const verify=(d:Item)=>{const p=d.prices?.[region];if(p&&Number.isFinite(p.amount))return `${money(p.amount)} · ${p.config} · ${p.asOf}`;const launch=d.regionalOffers?.[region]?.find(x=>x.channel==="official-msrp");return launch?`Historical launch MSRP: ${launch.value} (${launch.storage}); not a current retail price`:`Current ${regionInfo(region).currency} price not verified`;};
    const photo=(d:Item)=>[...(Array.isArray(d.images)?d.images:[]),...(d.image?[d.image]:[])].find(url=>typeof url==="string"&&isSafeUrl(url));
    function picture(d:Item,cls="s4-photo"){
      const wrap=el("div",cls);const url=photo(d);if(!url){wrap.append(el("span","s4-no-photo","Photo pending"));return wrap;}
      const img=document.createElement("img");img.src=url;img.alt=`${displayName(d)} product photograph`;img.loading="lazy";img.addEventListener("error",()=>{wrap.replaceChildren(el("span","s4-no-photo","Photo unavailable"));});wrap.append(img);return wrap;
    }
    function dataNumber(d:Item,key:FilterKey):number|null{
      const keys:Record<FilterKey,string[]>={
        ram:["ram","memory","memory ram"],storage:["storage","rom","internal storage","memory storage"],
        battery:["battery","batteryCapacity","battery capacity"],screen:["display","screen","screen size","display size"],
        camera:["cameras","camera","rear camera","main camera"]
      };
      const val=spec(d,keys[key]);if(!val)return null;
      let values:number[]=[];
      if(key==="storage"){
        for(const m of val.matchAll(/(\d+(?:\.\d+)?)\s*(TB|GB)\b/gi))values.push(Number(m[1])*(m[2].toUpperCase()==="TB"?1024:1));
        if(!values.length)values=[...val.matchAll(/\d+(?:\.\d+)?/g)].map(m=>Number(m[0]));
      } else if(key==="camera") values=[...val.matchAll(/(\d+(?:\.\d+)?)\s*MP\b/gi)].map(m=>Number(m[1]));
      else if(key==="battery")values=[...val.matchAll(/(\d[\d,]*)\s*mAh\b/gi)].map(m=>Number(m[1].replace(/,/g,"")));
      else if(key==="screen")values=[...val.matchAll(/(\d+(?:\.\d+)?)\s*(?:inches|inch|in\b|[″”])/gi)].map(m=>Number(m[1]));
      else values=[...val.matchAll(/(\d+(?:\.\d+)?)\s*GB\b/gi)].map(m=>Number(m[1]));
      // Values may be expressed as "8 / 12 GB" or "6.7-inch".
      if(!values.length&&(key==="screen"||key==="ram"||key==="storage")){const first=val.match(/\b\d+(?:\.\d+)?\b/);if(first)values=[Number(first[0])];}
      return values.length?Math.max(...values):null;
    }
    // Only explicitly recorded model/network evidence is sufficient for 5G filtering.
    // A missing 5G entry must NOT be treated as "No".
    function supports5g(d:Item):"yes"|"no"|"unknown"{
      if(typeof d.fiveG === "boolean")return d.fiveG?"yes":"no";
      if(typeof d.fiveG === "string"){
        const flag=d.fiveG.trim().toLowerCase();
        if(["yes","true","supported","5g","5g supported"].includes(flag))return "yes";
        if(["no","false","unsupported","not supported","non-5g"].includes(flag))return "no";
      }
      const variant=d.regionalVariants?.[region];
      if(typeof variant?.fiveG === "boolean")return variant.fiveG?"yes":"no";
      if(typeof variant?.supports5G === "boolean")return variant.supports5G?"yes":"no";
      const combined={...(d.specs||{}),...(d.regionalSpecs?.[region]||{})};
      const fields=["5g","5g support","5gSupport","network","networks","network support","connectivity","cellular","technology","mobile network"];
      const norm=(name:string)=>name.toLowerCase().replace(/[^a-z0-9]/g,"");
      const wanted=new Set(fields.map(norm));
      const recorded=Object.entries(combined)
        .filter(([key,value])=>wanted.has(norm(key)) && value?.value && value.kind!=="unverified")
        .map(([,value])=>value.value);
      const values=[...recorded,d.network,d.fiveG,variant?.network,variant?.networks,variant?.connectivity]
        .filter((v):v is string=>typeof v==="string" && !!v.trim());
      for(const value of values){
        if(/\b(?:no[ -]?5g|without[ -]?5g|5g\s*[:=]\s*(?:no|false|unsupported)|5g\s+(?:not supported|unavailable)|non[ -]?5g|4g\s+only|lte\s+only)\b/i.test(value))return "no";
        if(/\b(?:5g|nr\s*bands?|5g\s*nr)\b/i.test(value))return "yes";
      }
      return "unknown";
    }
    function miniSpecRows(d:Item){
      const aliases:[string,string[]][]=[
        ["Display",["display","screen"]],["Chipset",["chipset","processor","chip","soc"]],
        ["RAM",["ram","memory"]],["Storage",["storage","rom","internal storage"]],
        ["Camera",["cameras","camera","rear camera","main camera"]],
        ["Battery",["battery","battery capacity"]],["5G",["5g","network","connectivity"]],
      ];
      const table=el("dl","s4-spec-grid");
      for(const [name,keys] of aliases){const field=rawSpec(d,keys);if(!field?.value)continue;
        const dt=el("dt","",name),dd=el("dd","",field.value+(field.kind==="unverified"?" · unverified":""));table.append(dt,dd);
      }
      if(!table.childElementCount)table.append(el("p","s4-empty","Specifications are still being verified."));
      return table;
    }
    function openDetails(d:Item){
      const panel=el("div","s4-expanded");const body=el("div","s4-expanded-body");body.append(picture(d));
      const info=el("div","s4-model-data");info.append(el("h3","",displayName(d)),miniSpecRows(d));
      info.append(el("p","s4-price-note",verify(d)));
      const button=el("button","s4-action s4-primary-action",primary===d.id?"✓ Selected as primary":"+ Set as primary phone") as HTMLButtonElement;
      button.type="button";button.dataset.primary=d.id;info.append(button);body.append(info);panel.append(body);return panel;
    }
    function row(d:Item,position:number){
      const wrap=el("div","s4-model-row");
      const btn=el("button","s4-model-toggle") as HTMLButtonElement;btn.type="button";btn.dataset.expand=d.id;btn.setAttribute("aria-expanded",String(openId===d.id));
      btn.append(el("span","s4-rank",String(position)),el("span","s4-row-name",displayName(d)),el("span","s4-row-year",String(d.year)),el("span","s4-row-views",verifiedViews(d)?(d.popularity7d||0).toLocaleString("en-US"):"—"),el("span","s4-arrow",openId===d.id?"⌃":"⌄"));
      wrap.append(btn);if(openId===d.id)wrap.append(openDetails(d));return wrap;
    }
    // When verified ONOCRA analytics is connected, measured 7d popularity can
    // be sorted first; otherwise we rank visibly by recency, not fake hits.
    const verifiedViews=(d:Item)=>typeof d.popularity7d==="number"&&d.popularity7d>=0&&!!d.popularitySource;
    function sortLatest(items:Item[]){
      return [...items].sort((a,b)=>{
        if(verifiedViews(a)!==verifiedViews(b))return verifiedViews(a)?-1:1;
        if(verifiedViews(a)&&verifiedViews(b))return (b.popularity7d||0)-(a.popularity7d||0)||b.year-a.year;
        return b.year-a.year || displayName(a).localeCompare(displayName(b));
      });
    }
    function renderPopular(){const rootList=$<HTMLElement>("#s4-popular-list");rootList.replaceChildren();const ranked=sortLatest(inventory);
      const shown=ranked.slice(0,latestLimit);if(!shown.length)rootList.append(el("p","s4-empty","No release-eligible phone records found."));
      shown.forEach((d,i)=>rootList.append(row(d,i+1)));
      const remaining=Math.max(0,ranked.length-shown.length);
      const more=$<HTMLButtonElement>("#s4-more-popular");
      more.hidden=remaining===0;
      more.textContent=`Show next ${Math.min(POPULAR_BATCH,remaining)} phones ↓`;
      $<HTMLButtonElement>("#s4-less-popular").hidden=shown.length<=POPULAR_BATCH;
    }
    function optionList(id:string,values:number[],suffix:string){const ctrl=$<HTMLSelectElement>(id);ctrl.replaceChildren(new Option("Any",""),...values.map(n=>new Option(`${n.toLocaleString("en-US")}${suffix}`,String(n))));}
    function fillFilterChoices(){
      const years=[...new Set(inventory.map(d=>d.year))].sort((a,b)=>b-a);
      const year=$<HTMLSelectElement>("#s4-year");year.replaceChildren(new Option("All eligible years",""),...years.map(y=>new Option(y===2023?"2023 (Oct–Dec only)":String(y),String(y))));
      const choices:{id:string;key:FilterKey;unit:string}[]=[
        {id:"#s4-ram",key:"ram",unit:" GB"},{id:"#s4-storage",key:"storage",unit:" GB"},
        {id:"#s4-battery",key:"battery",unit:" mAh"},{id:"#s4-screen",key:"screen",unit:'"'},
        {id:"#s4-camera",key:"camera",unit:" MP"},
      ];
      for(const c of choices){const values=[...new Set(inventory.map(d=>dataNumber(d,c.key)).filter((n):n is number=>n!==null))].sort((a,b)=>a-b);optionList(c.id,values,c.unit);$<HTMLSelectElement>(c.id).disabled=!values.length;}
      // Keep the dropdown operable. It will show zero confirmed matches when
      // no model has network evidence, rather than silently disabling the control.
      $<HTMLSelectElement>("#s4-5g").disabled=false;
      fillPrice();
    }
    function fillPrice(){const e=$<HTMLSelectElement>("#s4-price");e.disabled=!inventory.some(d=>d.prices?.[region]?.amount!=null);e.replaceChildren(new Option("Any verified price",""),...[300,600,1000,1500,2000].map(n=>new Option(`Up to ${money(n)}`,String(n))));
      $<HTMLElement>("#s4-currency").textContent=`(${regionInfo(region).currency})`;
    }
    function filterMatches():Item[]{
      const q=$<HTMLInputElement>("#s4-search").value.trim().toLowerCase();const brand=val("#s4-brand"),yr=val("#s4-year"),pMax=num(val("#s4-price"));
      const fiveG=val("#s4-5g");const thresholds:{key:FilterKey;control:string}[]=[
        {key:"ram",control:"#s4-ram"},{key:"storage",control:"#s4-storage"},{key:"battery",control:"#s4-battery"},
        {key:"screen",control:"#s4-screen"},{key:"camera",control:"#s4-camera"}];
      return sortLatest(inventory.filter(d=>{
        if(q&&!displayName(d).toLowerCase().includes(q))return false;
        if(brand&&d.brand!==brand)return false;
        if(yr&&d.year!==Number(yr))return false;
        if(pMax!==null){const regional=price(d);if(regional==null||regional>pMax)return false;}
        if(fiveG&&supports5g(d)!==fiveG)return false;
        return thresholds.every(({key,control})=>{const min=num(val(control));if(min===null)return true;const actual=dataNumber(d,key);return actual!==null&&actual>=min;});
      }));
    }
    function renderMatches(){const outer=$<HTMLElement>("#s4-filtered");const list=$<HTMLElement>("#s4-filtered-list");list.replaceChildren();if(lastMatches===null){outer.hidden=true;return;}
      outer.hidden=false;
      $<HTMLElement>("#s4-filtered-title").textContent=`Matching phones (${lastMatches.length})`;
      lastMatches.slice(0,filteredLimit).forEach((d,i)=>list.append(row(d,i+1)));
      if(!lastMatches.length){
        const fiveG=val("#s4-5g");
        const known=inventory.some(d=>supports5g(d)!=="unknown");
        const message=(fiveG==="yes"||fiveG==="no")&&!known
          ? "No verified 5G classifications are currently recorded for this region. Add sourced network/5G fields to devices.ts; ONOCRA will not guess."
          : "No phone with documented specifications matches every selected filter. Try broadening the criteria.";
        list.append(el("p","s4-empty",message));
      }
      $<HTMLButtonElement>("#s4-more-filtered").hidden=filteredLimit>=lastMatches.length;
    }
    function scoredCandidates(selected:Item):Item[]{
      const prio=[...s.prio] as PriorityId[];
      const current=price(selected), selectedFamily=(selected.family||"").toLowerCase();
      const familyOnly=s.mode==="generations"&&!!selectedFamily;
      const budget=num(val("#s4-price"));
      recommendationNote="";
      let pool=inventory.filter(d=>d.id!==selected.id&&(!familyOnly||(d.family||"").toLowerCase()===selectedFamily));
      if(budget!=null){pool=pool.filter(d=>{const p=price(d);return p!=null&&p<=budget;});}
      if(familyOnly&&pool.length===0)recommendationNote="No other verified eligible generation is catalogued in this family. You can still continue with the primary phone.";
      const rank=(d:Item)=>{
        let score=0;
        // Documented user-priority fit contributes only where researched.
        prio.forEach((id,i)=>{const fit=d.fit?.[id];const w=prio.length-i;if(fit==="strong")score+=w*3;else if(fit==="adequate")score+=w*2;else if(fit==="limited")score+=w*0.5;});
        if(d.family&&selected.family&&d.family===selected.family)score+=s.mode==="generations"?10:1;
        if(d.year===selected.year)score+=3;else if(Math.abs(d.year-selected.year)===1)score+=2;
        const p=price(d);
        if(current!=null&&p!=null&&current>0){const gap=Math.abs(p-current)/current;score+=gap<=.15?5:gap<=.3?3:gap<=.5?1:0;}
        if(d.brand!==selected.brand&&s.mode==="brands")score+=2;
        if(p!=null)score+=1;
        return score;
      };
      const matches=pool.sort((a,b)=>rank(b)-rank(a)||b.year-a.year||displayName(a).localeCompare(displayName(b))).slice(0,5);
      if(!prio.length&&current==null&&matches.length)recommendationNote="Shortlist uses eligible release years and available technical evidence. Pricing and preference-fit evidence may be incomplete; these are suggestions, not verified performance rankings.";
      return matches;
    }
    function summaryCard(d:Item,kind:"primary"|"alternative",selected=false){
      const c=el("div",`s4-compare-card ${kind==="primary"?"s4-is-primary":""} ${selected?"s4-is-selected":""}`);
      if(kind==="primary")c.append(el("span","s4-primary-tag","✓ Primary phone"));
      else {const label=el("label","s4-pick");const input=document.createElement("input");input.type="checkbox";input.dataset.compare=d.id;input.checked=selected;input.disabled=!selected&&additional.length>=2;label.append(input,document.createTextNode(" Add to compare"));c.append(label);}
      c.append(picture(d,"s4-card-photo"),el("strong","s4-card-title",displayName(d)),el("small","s4-card-price",verify(d)));
      if(kind==="primary"){const change=el("button","s4-text-button","Change primary") as HTMLButtonElement;change.type="button";change.dataset.clearPrimary="true";c.append(change);}
      return c;
    }
    function renderBuilder(){const box=$<HTMLElement>("#s4-comparison-content");box.replaceChildren();
      const note=$<HTMLElement>("#s4-recommendation-note");note.hidden=true;
      const selected=byId.get(primary);if(!selected){$<HTMLElement>("#s4-selection-count").textContent="0 of 2 added";box.append(el("p","s4-empty","Choose your primary phone from the list or filter results above."));return;}
      const results=scoredCandidates(selected);
      additional=additional.filter(id=>results.some(d=>d.id===id)).slice(0,2);
      $<HTMLElement>("#s4-selection-count").textContent=`${additional.length} of 2 added`;
      const group=el("div","s4-comparison-grid");group.append(summaryCard(selected,"primary"));
      results.forEach(d=>group.append(summaryCard(d,"alternative",additional.includes(d.id))));box.append(group);
      if(!results.length)box.append(el("p","s4-empty","No eligible alternatives meet this journey's criteria; you may still proceed with the primary phone."));
      if(recommendationNote){note.hidden=false;note.textContent=recommendationNote;}
    }
    function updateLinks(){
      // Current ONOCRA reviewFlow.ts supports s.brands and s.compare (from supplied Step 4).
      prior.cat="phones";prior.region=region;prior.model=primary;prior.compare=[...additional];
      // Step 4 search filters must not overwrite Step 1 journey preferences.
      // Only explicitly selected models, region, and budget are carried forward.
      const chosenBudget=num(val("#s4-price"));prior.budget=chosenBudget;
      $<HTMLAnchorElement>("#models-back").href=stepUrl("priorities",prior);
      const next=$<HTMLAnchorElement>("#models-next");next.href=stepUrl("verdict",prior);
      next.setAttribute("aria-disabled",String(!primary));
    }
    function rerender(){renderPopular();renderMatches();renderBuilder();updateLinks();}
    function setPrimary(id:string){if(!inventory.some(d=>d.id===id))return;primary=id;additional=[];openId=id;rerender();$<HTMLElement>("#s4-comparison").scrollIntoView({behavior:"smooth",block:"start"});}

    // Seed only eligible primary/comparison phones from the current URL.
    primary=inventory.some(d=>d.id===s.model)?s.model:"";
    additional=(prior.compare||[]).filter(id=>id!==primary&&inventory.some(d=>d.id===id)).slice(0,2);
    const s4Brand=$<HTMLSelectElement>("#s4-brand");
    if(prior.brands?.length===1&&[...s4Brand.options].some(o=>o.value===prior.brands![0]))s4Brand.value=prior.brands[0];
    else if(s.brand&&[...s4Brand.options].some(o=>o.value===s.brand))s4Brand.value=s.brand;
    $<HTMLSelectElement>("#s4-region").value=region;
    fillFilterChoices();
    if(s.budget!=null){const select=$<HTMLSelectElement>("#s4-price");
      if(![...select.options].some(o=>o.value===String(s.budget)))select.add(new Option(`Up to ${money(s.budget)}`,String(s.budget)));
      select.value=String(s.budget);
    }
    rerender();
    root.addEventListener("click",e=>{
      const target=e.target as Element;
      const expand=target.closest<HTMLButtonElement>("[data-expand]");
      if(expand){openId=openId===expand.dataset.expand?"":expand.dataset.expand||"";renderPopular();renderMatches();return;}
      const makePrimary=target.closest<HTMLButtonElement>("[data-primary]");
      if(makePrimary){setPrimary(makePrimary.dataset.primary||"");return;}
      if(target.closest("[data-clear-primary]")){primary="";additional=[];rerender();$<HTMLElement>("#discovery").scrollIntoView({behavior:"smooth",block:"start"});}
    });
    root.addEventListener("change",e=>{
      const t=e.target as HTMLInputElement;
      if(t.matches("#s4-region")){region=t.value as RegionId;s.budget=null;fillPrice();lastMatches=null;rerender();return;}
      if(t.matches("#s4-price")){rerender();return;}
      if(t.matches("#s4-5g")){lastMatches=filterMatches();filteredLimit=8;renderMatches();return;}
      if(t.matches("[data-compare]")){const id=t.dataset.compare||"";additional=t.checked?[...additional,id].slice(0,2):additional.filter(x=>x!==id);rerender();return;}
    });
    $<HTMLButtonElement>("#s4-run-filter").addEventListener("click",()=>{lastMatches=filterMatches();filteredLimit=8;renderMatches();$<HTMLElement>("#s4-filtered").scrollIntoView({behavior:"smooth",block:"nearest"});});
    $<HTMLButtonElement>("#s4-more-popular").addEventListener("click",()=>{
      latestLimit=Math.min(inventory.length,latestLimit+POPULAR_BATCH);
      renderPopular();
    });
    $<HTMLButtonElement>("#s4-less-popular").addEventListener("click",()=>{
      latestLimit=POPULAR_BATCH;
      openId="";
      renderPopular();
      $<HTMLElement>("#s4-popular-title").scrollIntoView({behavior:"smooth",block:"start"});
    });
    $<HTMLButtonElement>("#s4-more-filtered").addEventListener("click",()=>{filteredLimit+=8;renderMatches();});
    $<HTMLAnchorElement>("#models-next").addEventListener("click",e=>{if(!primary)e.preventDefault();});
  }
  // Astro view transitions may replace page HTML without replaying a script.
  // Initialise on each visit and guard against double binding on one page.
  document.addEventListener("astro:page-load",initStep4);
  if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",initStep4,{once:true});
  else initStep4();
</script>

