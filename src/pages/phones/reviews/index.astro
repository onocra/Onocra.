---
import FlowShell from "@/components/Reviews/FlowShell.astro";
import { readState, stepUrl } from "@/lib/reviewFlow";
const initial = readState(Astro.url.search);
---
<FlowShell
  step={1}
  wide
  title="Explore or Choose | ONOCRA Reviews"
  heading="What would you like to do?"
  lead="Choose the path that suits you."
>
  <p class="guide-intro"><span class="guide-name">ONOCRA, your pelican guide</span> “I'll help you explore the differences or find what fits. Either way, your priorities will help me focus on what matters to you.”</p>

  <fieldset class="route-choices" aria-label="Choose your route">
    <legend class="sr-only">Choose one of two routes</legend>

    <label class="route-card route-card--explore">
      <input type="radio" name="route" value="brands" checked={initial.mode === "brands" || initial.mode === "generations" || initial.mode === "value"} />
      <img src="/images/reviews/explore-compare.png" alt="ONOCRA pelican discovering and comparing phones with a magnifying glass" width="661" height="318" loading="eager" />
      <span class="route-body"><strong>Explore &amp; Compare</strong><span>Explore technology, generations and competing models.</span></span>
      <span class="route-check" aria-hidden="true">✓</span>
    </label>

    <div class="route-card route-card--buy">
      <label class="route-card-main" for="route-match">
        <input id="route-match" type="radio" name="route" value="match" checked={initial.mode === "match"} />
        <img src="/images/reviews/help-me-choose.png" alt="ONOCRA pelican helping a family consider different phones" width="660" height="318" loading="eager" />
        <span class="route-body"><strong>Help Me Choose</strong><span>Find the right product for your needs and budget.</span></span>
        <span class="route-check" aria-hidden="true">✓</span>
      </label>
      <fieldset class="purchase-choices" aria-label="What are you planning to do?">
        <legend>What would you like to do?</legend>
        <label class="purchase-option">
          <input type="radio" name="purchase" value="new" />
          <span>Buy a New Phone</span>
        </label>
        <label class="purchase-option">
          <input type="radio" name="purchase" value="upgrade" />
          <span>Upgrade — Sell My Current Phone and Buy a New One</span>
        </label>
      </fieldset>
    </div>
  </fieldset>

  <p class="route-hint" id="route-hint" role="status" aria-live="polite">You can change your choice later.</p>
  <div slot="nav"><a class="btn" id="route-continue" href={stepUrl("who", {...initial, mode: initial.mode || "brands"})} aria-disabled="true">Continue →</a></div>
</FlowShell>

<script>
  import { readState, stepUrl } from "@/lib/reviewFlow";

  const choices = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="route"]'));
  const purchases = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="purchase"]'));
  const next = document.querySelector<HTMLAnchorElement>("#route-continue");
  const hint = document.querySelector<HTMLElement>("#route-hint");
  const incoming = new URLSearchParams(location.search);
  const previous = readState(location.search);

  // URL state must be read in the browser: the site is statically generated.
  const returningExplore = previous.mode === "brands" || previous.mode === "generations" || previous.mode === "value";
  const returningBuyer = previous.mode === "match";
  choices.forEach((radio) => { radio.checked = radio.value === (returningBuyer ? "match" : returningExplore ? "brands" : ""); });
  const savedPurchase = incoming.get("purchase");
  purchases.forEach((radio) => { radio.checked = returningBuyer && radio.value === savedPurchase; });

  function update() {
    const route = choices.find((radio) => radio.checked)?.value as "brands" | "match" | undefined;
    const purchase = purchases.find((radio) => radio.checked)?.value as "new" | "upgrade" | undefined;
    const ready = route === "brands" || (route === "match" && !!purchase);
    if (!next) return;

    next.setAttribute("aria-disabled", String(!ready));
    if (hint) {
      hint.textContent = route === "match" && !purchase
        ? "Choose Buy a New Phone or Upgrade to continue."
        : "You can change your choice later.";
    }

    if (!ready || !route) {
      next.href = "#";
      return;
    }

    // Explorer and buyer profiles are distinguished by mode=brands / mode=match.
    // The purchase parameter is separate from mode because both are buying routes.
    const nextState = {
      ...readState(location.search),
      mode: route,
      intent: route === "match" ? "buying" as const : "researching" as const,
      who: "" as const,
      prio: [],
      model: "",
      cat: "phones",
    };
    const url = new URL(stepUrl("who", nextState), location.origin);
    if (route === "match" && purchase) url.searchParams.set("purchase", purchase);
    else url.searchParams.delete("purchase");
    next.href = url.pathname + url.search;
  }

  choices.forEach((radio) => radio.addEventListener("change", update));
  purchases.forEach((radio) => radio.addEventListener("change", () => {
    const buyer = choices.find((choice) => choice.value === "match");
    if (buyer) buyer.checked = true;
    update();
  }));
  next?.addEventListener("click", (event) => {
    if (next.getAttribute("aria-disabled") === "true") event.preventDefault();
  });
  update();
  window.addEventListener("pageshow", update);
</script>

<style>
  .guide-intro { background: #edf3e9; border: 1px solid #cadbca; border-radius: 16px; padding: 12px 16px; line-height: 1.55; margin: 14px 0 18px; }
  .guide-name { font-weight: 750; color: #245039; display: block; margin-bottom: 3px; }
  .route-choices { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px; align-items:stretch; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .route-card { position: relative; display: flex; flex-direction: column; background: #fffdf7; border: 2px solid #bfd2c1; border-radius: 20px; padding: 10px; cursor: pointer; overflow: hidden; min-width: 0; height:100%; box-sizing:border-box; }
  .route-card:has(input[name="route"]:checked) { border-color: #2f8a52; background: #f1f7ed; box-shadow: 0 0 0 2px #bfe3c6; }
  .route-card:has(input:focus-visible) { outline: 3px solid #cf5f2f; outline-offset: 3px; }
  .route-card input[name="route"] { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .route-card img { width: 100%; aspect-ratio: 2.08; object-fit: cover; border-radius: 12px; display: block; }
  .route-body { display: flex; flex-direction: column; gap: 6px; padding: 14px 34px 10px 10px; line-height: 1.45; }
  .route-body strong { font: 700 clamp(1.2rem, 2.5vw, 1.7rem)/1.2 Georgia,serif; color: #1d4a2f; }
  .route-body span { font-size: .94rem; }
  .route-check { position: absolute; right: 18px; bottom: 22px; width: 24px; height: 24px; display: grid; place-items: center; border: 2px solid #90b59a; border-radius: 50%; color: transparent; }
  .route-card:has(input[name="route"]:checked) .route-check { background: #2f8a52; color: #fff; border-color: #2f8a52; }
  .route-card-main { display:flex; flex-direction:column; position:relative; cursor:pointer; min-width:0; }
  .route-card--buy .route-check { bottom: 19px; }
  .purchase-choices { border: 0; border-top:1px solid #d8e5d9; padding:11px 0 3px; margin: 1px 0 0; min-width:0; display:flex; flex-direction:column; gap:7px; }
  .purchase-choices legend { padding:0 2px; color:#416751; font-size:.82rem; font-weight:700; }
  .purchase-option { display:flex; align-items:center; gap:11px; padding:11px 12px; border:1px solid #c5d9c9; border-radius:12px; background:#fffef9; font-size:.88rem; line-height:1.4; color:#254b35; cursor:pointer; }
  .purchase-option:has(input:checked) { background:#e4f3e7; border-color:#378552; box-shadow:0 0 0 1px #8abb9a; }
  .purchase-option input[type="radio"] { flex:none; width:19px; height:19px; accent-color:#2f8a52; cursor:pointer; }
  .purchase-option:focus-within { outline:2px solid #cf5f2f;outline-offset:2px; }
  .route-hint { text-align: center; color: #536a59; font-size: .88rem; margin: 16px 0 0; }
  @media(max-width: 640px) { .route-choices { grid-template-columns: 1fr; } .route-card img { max-height: 230px; } }
</style>
