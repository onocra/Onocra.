---
import FlowShell from "@/components/Reviews/FlowShell.astro";
import { WHO, readState, stepUrl } from "@/lib/reviewFlow";
const initial=readState(Astro.url.search);
---
<FlowShell step={2} title="Who is it for? | ONOCRA" heading="Who will use it?" lead="A little context helps ONOCRA focus on what matters to you.">
  <div class="guide-strip">🪶 <strong>Your pelican guide:</strong> “I'll tailor the questions to the person using the product.”</div>
  <fieldset class="opt-list" aria-label="Who will use the product?">
    <legend class="sr-only">Choose who this is for</legend>
    {WHO.map(w=><label class="opt"><input type="radio" name="who" value={w.id} checked={initial.who===w.id}/><span class="ico">{w.icon}</span><span><strong>{w.label}</strong><small>{w.emphasis}</small></span></label>)}
  </fieldset>
  <h2>Are you exploring or planning to buy?</h2>
  <div class="seg" role="group" aria-label="Your intent">
    <label><input type="radio" name="intent" value="researching" checked={initial.intent!=="buying"}/>Just exploring</label>
    <label><input type="radio" name="intent" value="buying" checked={initial.intent==="buying"}/>Planning to buy</label>
  </div>
  <p id="guardian-note" class="banner" hidden>For children under 13, a parent or guardian should make the purchasing decision. Safety and parental controls will be highlighted.</p>
  <div slot="nav"><a class="btn ghost" id="who-back" href="/phones/reviews/">← Back</a><a class="btn" id="who-next" href={stepUrl("priorities",initial)} aria-disabled="true">Next →</a></div>
</FlowShell>
<script>
 import {readState,stepUrl,type WhoId} from "@/lib/reviewFlow";
 const who=[...document.querySelectorAll<HTMLInputElement>('input[name="who"]')];
 const intent=[...document.querySelectorAll<HTMLInputElement>('input[name="intent"]')];
 const back=document.querySelector<HTMLAnchorElement>('#who-back');const next=document.querySelector<HTMLAnchorElement>('#who-next');
 const guardian=document.querySelector<HTMLElement>('#guardian-note');
 function sync(){const s=readState(location.search);s.who=(who.find(x=>x.checked)?.value||'') as WhoId|'';s.intent=(intent.find(x=>x.checked)?.value||'researching') as 'researching'|'buying';
  if(back)back.href=`/phones/reviews/${new URLSearchParams(location.search).toString()?location.search:''}`;
  if(next){next.href=stepUrl('priorities',s);next.setAttribute('aria-disabled',String(!s.who));}
  if(guardian)guardian.hidden=s.who!=='under13';}
 [...who,...intent].forEach(x=>x.addEventListener('change',sync));sync();
</script>
<style>.guide-strip{background:#edf3e9;border:1px solid #cadbca;border-radius:16px;padding:14px;margin:16px 0}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.opt-list{grid-template-columns:repeat(2,minmax(0,1fr))}.seg{margin:8px 0 14px}@media(max-width:650px){.opt-list{grid-template-columns:1fr}}</style>
