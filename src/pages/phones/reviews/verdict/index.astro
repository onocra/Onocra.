  };
  const gl11Key=()=>`<div class="gl11-legend" aria-label="Meaning of GL comparison colours">
    <strong>GL impact guide</strong>
    <span><i class="gl11-disc gl11-positive" aria-hidden="true">↑</i> Green · Supported gain</span>
    <span><i class="gl11-disc gl11-same" aria-hidden="true">→</i> Yellow · Same / uncertain benefit</span>
    <span><i class="gl11-disc gl11-negative" aria-hidden="true">↓</i> Red · Documented drawback</span>
    <span><i class="gl11-disc gl11-unknown" aria-hidden="true">?</i> Grey · Evidence unavailable</span>
    <small>Colours describe the evidence, not points. Numeric scores appear only after GL validation.</small>
  </div>`;
  const gl10CategoryTable=(primary:any,other:any,cat:any,index:number):string=>{
    const category=glCheckedScore(primary,other,cat);
    return `<div class="gl10-scroll"><table class="gl10-table">
      <thead><tr><th scope="col">Area</th><th scope="col">Primary: ${safeText(primary.name,35)}</th><th scope="col">Alternative: ${safeText(other.name,35)}</th><th scope="col">Change</th><th scope="col">GL impact</th><th scope="col">Score</th></tr></thead>
      <tbody>${cat.keys.map((key:string,i:number)=>{
        const meaning=glComparisonMeaning(other,primary,key);
        const indication=gl11Indication(other,primary,key,meaning);
        const published=glRatingForRow(primary,other,cat,key);
        return `<tr class="gl10-${indication.signal}">
          <th scope="row"><small>${index+1}.${i+1}</small> ${esc(glNames[key]||key)}</th>
          <td data-label="Primary">${glShownSpec(primary,key)}</td>
          <td data-label="Alternative">${glShownSpec(other,key)}</td>
          <td data-label="Change"><span class="gl11-change gl11-${indication.signal}"><span class="gl11-arrow" aria-hidden="true">${indication.arrow}</span><b>${esc(indication.change)}</b></span></td>
          <td data-label="GL impact"><div class="gl11-impact"><span class="gl11-impact-label gl11-${indication.signal}"><span class="gl11-disc gl11-${indication.signal}" aria-hidden="true">${indication.arrow}</span>${esc(published?.impact||indication.result)}</span><small>${esc(indication.explanation)}</small></div></td>
          <td class="gl10-score-cell" data-label="Score">${published?`${published.earned}/${published.weight}`:'—'}</td>
        </tr>`;
      }).join('')}</tbody>
      <tfoot><tr><th scope="row" colspan="5">${esc(cat.name)} · category total</th><td class="gl10-score-cell">${category?`${category.earned}/${category.max}`:`— / ${cat.weight}`}</td></tr></tfoot>
    </table></div>`;
  };
  const gl7Area=(primary:any,other:any,cat:any,index:number,firstOpen=false):string=>{
    const category=glCheckedScore(primary,other,cat);
    return `<details class="gl7-area gl7-${esc(cat.key)}" data-gl10-area="${esc(cat.key)}" ${firstOpen?'open':''}>
      <summary>
        <span class="gl7-area-number">${index+1}</span>
        <span class="gl7-area-icon" aria-hidden="true">${gl7Icons[cat.key]||'●'}</span>
        <span class="gl7-area-name"><b>${esc(cat.name)}</b><small>${esc(cat.question)}</small></span>
        <span class="gl7-area-result"><b>${esc(glCategoryHighlight(primary,other,cat))}</b><small>${category?'Validated category score':'GL impact described; score pending'}</small></span>
        <span class="gl7-area-weight">${category?`${category.earned} / ${cat.weight}`:`— / ${cat.weight}`}<small>GL points</small></span>
        <span class="gl7-area-chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="gl7-area-detail">
        <p class="gl12-area-intro">${cat.keys.length} checkable subtopics · same facts used in the six-area summary and Key Changes</p>
        ${gl10CategoryTable(primary,other,cat,index)}
        <p class="gl10-category-note">${esc(cat.caveat)}</p>
      </div>
    </details>`;
  };
  const gl7Phone=(d:any,position:string):string=>{
    const photo=safePhoto(d);
    const storage=glNumber(glField(d,'storage'),'storage');
    const meta=[Number.isInteger(d.year)?String(d.year):'',storage?`${Math.round(storage.n)} ${storage.unit} starting storage`:''].filter(Boolean).join(' · ');
    return `<div class="gl7-phone gl7-${position}">
      <div class="gl7-photo">${photo?`<img src="${esc(photo)}" alt="${safeText(d.name,65)}" loading="lazy">`:'<span aria-hidden="true">▯</span>'}</div>
      <div class="gl7-phone-info"><span class="gl8-identity">${position==='primary'?'PRIMARY PHONE':'ALTERNATIVE'}</span><strong>${safeText(d.name,78)}</strong><small>${safeText(meta,85)}</small></div>
    </div>`;
  };
  const gl7Glance=(primary:any,other:any):string=>{
    // A verified increase in a directly useful quantity can be labelled an
    // improvement; specifications with untested consequences are just changes.
    const items=GL6.map((cat)=>{
      const matches: Array<{key:string;out:ReturnType<typeof glComparisonMeaning>}> = cat.keys.map((key:string)=>({key,out:glComparisonMeaning(other,primary,key)}));
      const objectiveGain=matches.find(({out})=>out.tone==='positive');
      const objectiveLoss=matches.find(({out})=>out.tone==='negative');
      const difference=matches.find(({out})=>out.tone==='neutral');
      const same=matches.find(({out})=>out.tone==='same');
      const item=objectiveGain||objectiveLoss||difference||same||null;
      const tone=item?.out.tone || 'unknown';
      const assessment=tone==='positive'?'Documented improvement'
        :tone==='negative'?'Documented drawback'
        :tone==='same'?'No recorded change'
        :tone==='neutral'?'Change recorded · benefit unverified'
        :'More evidence needed';
      const specific=item?.out.highlight || cat.name;
      return {cat,key:item?.key||cat.keys[0],assessment,specific,
        description:item?.out.impact||'Comparable evidence is still missing',tone};
    });
    return `<section class="gl7-glance" aria-label="Key changes at a glance">
      <div class="gl8-subheading"><strong>Key changes at a glance</strong><small>Six assessments drawn directly from the detailed evidence below</small></div>
      <div class="gl7-chips">${items.map(row=>`<div class="gl8-change gl13-glance-${esc(row.cat.key)} gl14-tone-${esc(row.tone)}">
        <span class="gl8-change-icon" aria-hidden="true">${gl8ChangeIcons[row.key]||gl7Icons[row.cat.key]||'✦'}</span>
        <div><span class="gl14-change-status">${esc(row.assessment)}</span><b>${esc(row.specific)}</b><small>${esc(row.description)}</small></div></div>`).join('')}</div>
    </section>`;
  };
  const gl7Card=(primary:any,other:any,index:number,isReference=false):string=>{
    const open=index===1;
    const id=`gl7-detail-${index}`;
    const kind=glPairKind(primary,other);
    const score=glIndexScore(primary,other);
    const valid=score!==null;
    const angle=valid?Math.max(0,Math.min(360,(score as number)*3.6)):0;
    const summary=score===null?'Awaiting validated GL scores':score>50?'Net technical improvement':score<50?'Net technical regression':'No net technical change';
    return `<article class="gl7-card" aria-label="Generational comparison ${index}">
      <details class="gl14-snapshot-fold" open>
      <summary class="gl7-card-heading" aria-label="Toggle at-a-glance comparison for ${safeText(other.name,60)}">
        <div><span class="gl7-alternative-tag">${isReference?'AUTOMATIC PREVIOUS-GENERATION REFERENCE':`SELECTED ALTERNATIVE ${index}`}</span>
          <p class="gl7-pair-context">${esc(kind)}</p></div>
        <span class="gl7-toggle" aria-hidden="true"><span>⌄</span></span>
      </summary>
      <div class="gl7-snapshot">
        <div class="gl7-phone-panel"><div class="gl7-snapshot-label">AT A GLANCE · SIDE-BY-SIDE</div>
          <div class="gl7-phone-versus">${gl7Phone(primary,'primary')}<span class="gl7-versus">VS</span>${gl7Phone(other,'alternative')}</div></div>
        <div class="gl7-index gl13-index"><strong>Generational Leap Index</strong>
          <div class="gl13-index-caption">Six weighted technical areas</div>
          <div class="gl13-score-orbit ${valid?'is-validated':'is-pending'}" style="--gl13-angle:${angle}deg" role="img" aria-label="${valid?`Validated GL index ${score} out of 100`:'GL Index pending validation; no numeric rating published'}">
            <div class="gl13-score-core"><b>${valid?score:'—'}</b><small>/100</small></div>
          </div>
          <span class="gl13-score-status">${esc(summary)}</span>
          <div class="gl8-scale" role="img" aria-label="GL scale: 0 significant regression, 50 no net change, 100 meaningful improvement"></div>
          <div class="gl8-ticks"><span>0</span><span>50</span><span>100</span></div>
          <p>50 = no net technical change. The index appears only after all six category scores are validated.</p>
        </div>
      </div>
      </details>
      ${gl7Glance(primary,other)}
      <section class="gl8-six" aria-label="Six assessment areas">
        <div class="gl8-subheading"><strong>Six GL assessment areas</strong><small>Select any category to see its numbered evidence</small></div>
        <div class="gl8-six-grid">${GL6.map((c,i)=>gl8CategoryCard(primary,other,c,i,index)).join('')}</div>
      </section>
      <details id="${id}" class="gl7-research" ${open?'open':''}>
        <summary class="gl7-details-heading">
          <div><h4>Detailed comparison &amp; supporting research</h4><p>Six categories, numbered subtopics and the matching GL evidence</p></div>
          <span class="gl7-research-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="gl7-details">
          <p class="gl7-guidance">The comparison uses the same evidence for each category score, Key Changes, and eventually the GL contribution to ONOCRA Verdict. Unverified claims remain unscored.</p>
          ${gl11Key()}
          <div class="gl7-areas">${GL6.map((c,i)=>gl7Area(primary,other,c,i,open&&i===0)).join('')}</div>
          <p class="gl7-note">GL measures technical change, not price. Manufacturer and independent evidence is retained under ONOCRA's editorial policy. VM assesses value.</p>
        </div>
      </details>
    </article>`;
  };
  const gl7Report=(primary:any,alternatives:any[],predecessor:any|null):string=>{
    const chosen=alternatives.filter((d:any)=>d&&d.id!==primary.id).slice(0,2);
    const candidates=chosen.length?chosen:(predecessor?[predecessor]:[]);
    return `<section class="s5-panel gl7-report" id="s5-gl" aria-labelledby="gl7-heading">
      <header class="s5-report-title gl7-title"><span class="s5-num">4</span><h2 id="gl7-heading">Generational Leap (GL)</h2><span class="s5-chip">What changed, and will it matter?</span></header>
      <p class="gl7-intro">Compare ${safeText(primary.name,72)} with ${candidates.length===1?'the selected alternative':'both selected alternatives'}. Each card shows its own phone snapshot and the same six areas of research.</p>
      <div class="gl7-cards">${candidates.map((other:any,i:number)=>gl7Card(primary,other,i+1,chosen.length===0)).join('')}
      ${!candidates.length?'<p>No eligible comparison phone is currently recorded.</p>':''}</div>
      <p class="gl7-method">GL scoring: 50 means no net change, higher indicates improvement, lower indicates regression. The six research weights are 25 / 20 / 15 / 15 / 10 / 15. Figures remain unpublished until calibrated and verified.</p>
    </section>`;
  };
  if (!model) {
    root.innerHTML = `<section class="s5-panel"><h2>No phone selected yet</h2><p>Choose a primary phone before requesting a verdict.</p><a class="s5-action" href="${esc(stepUrl("models", state))}">Select phones →</a></section>`;
  } else {
    const prev=automaticPredecessor(model);
    const topSet=prev ? (leaps.find(l=>l.to===model.id && l.from===prev.id)
      || buildAppleGLFromEvidence(prev,model)) : null;
    const chain:any[]=[];
    if(topSet){
      let cur=model.id;
      for(let i=0;i<6;i++){
        const set=leaps.find(l=>l.to===cur);if(!set)break;
        chain.push(set);cur=set.from;
      }
    }
    const hasReviewedPair=!!topSet;
    const referenceType=hasReviewedPair?'Source-linked specification comparison (not necessarily scored)':'Automatically chosen previous-generation reference';
    const counts=tally(topSet?.rows || []);
    const retailPair=prev?comparableRetailPrices(model,prev,state.region):null;
    const leapReport=hasReviewedPair
      ? buildLeapReport({model,prev,set:topSet,region:state.region})
      : provisionalGl(model,prev);
    const matrixReport=buildUpgradeMatrix({model,prev,set:topSet,region:state.region});
    const cross=selected.slice(1).filter((d:any)=>d.brand!==model.brand);
    const matrixCross=cross.length?buildCrossBrandMatrix({model,others:cross,region:state.region}):"";

    // GL and VM report scores remain available in their own detailed panels.
    const glScore=hasReviewedPair && topSet?.scoring?.validated===true ? asScore(topSet.scoring.score) : null;
    const vmScore=existingMatrixScore(matrixReport);

    const points=Object.entries(counts) as [keyof typeof counts,number][];
    const changes=points.reduce((sum,[,v])=>sum+v,0);
    const glChart=changes>0?`<div class="s5-gl-bars">${points.map(([k,v])=>`<div><b>${v}</b><div class="s5-gl-track"><i class="s5-gl-${k}" style="height:${Math.round(v/changes*100)}%"></i></div><small>${esc(k)}</small></div>`).join("")}</div>`
      : prev?`<p class="s5-quiet"><strong>${specCoverage(model,prev)} / ${comparisonSpecRows.length}</strong> recorded specifications available for comparison.<br>GL scoring pending research.</p>`
      : '<p class="s5-quiet">Immediate previous-generation reference not catalogued.</p>';
    const priceDelta=retailPair?.diff;
    const deltaDisplay=typeof priceDelta==="number" && Number.isFinite(priceDelta)
      ? `${priceDelta>=0?"+":"−"}${money(state.region,Math.abs(priceDelta))}` : null;
    const vmCrux=deltaDisplay
      ? `The difference between the recorded new-phone prices is ${deltaDisplay} in ${region.label}. What you would actually pay to change phones also depends on what you get for your old phone.`
      : `We do not have matching, checked prices for both phones in ${region.label}, so we cannot yet say whether paying more would be worthwhile.`;
    root.innerHTML = `${guide()}
      <section class="s5-panel s5-selected"><header class="s5-section-title"><span class="s5-num">2</span><h2>Your selected phones</h2><small>Primary model and up to two alternatives</small></header><div class="s5-phone-grid">${selected.map(modelCard).join("")}</div></section>
      <details class="s5-panel s5-verdict-panel gl14-verdict-fold" id="s5-verdict" open>
        <summary class="s5-report-title s5-verdict-heading">
          <span class="s5-num">3</span>${icon}<h2>ONOCRA Verdict</h2>
          <span class="s5-chip">${buying?'Based on your priorities and value':'Focused on meaningful changes and value'}</span>
          <span class="s5-only-chevron" aria-hidden="true"><span>⌄</span></span>
        </summary>
        <div class="gl14-verdict-body" id="s5-verdict-more">
          ${pairDashboard(model,selected.slice(1))}
          <p class="s5-verdict-extra"><strong>How to read this:</strong> ${buying?'Your priorities and value have the greatest weight in this journey.':'Documented technical differences and value have the greatest weight in this journey.'} Full GL and VM evidence appears below. Scores require validation for the exact phone pair, region and journey.</p>
        </div>
      </details>
      ${gl7Report(model,selected.slice(1),prev)}
      <details class="s5-panel s5-report" id="s5-vm">
        <summary><div class="s5-report-title"><span class="s5-num">5</span><h2>Value Matrix (VM)</h2><span class="s5-chip">Is it worth the money?</span><span class="s5-chevron">⌄</span></div>
          <div class="s5-fold"><div>${scoreMark(vmScore,"Value Score (VM)")}</div>
            <div class="s5-fold-text"><strong>What this means</strong><p>${safeText(reportStats(matrixReport,".vm-status")|| (vmScore===null?"We do not have enough checked information to rate value yet":"Our price-and-benefit assessment"),160)}</p><div class="s5-crux"><b>Bottom line:</b> ${safeText(vmCrux,420)}</div></div>
            <div class="s5-fold-graphic s5-cost-graphic"><strong>What we know about prices</strong><p>${deltaDisplay?`<b>${esc(deltaDisplay)}</b><small>Difference in the recorded new-phone prices</small>`:'<small>Matching local prices are missing</small>'}</p><div class="s5-balance"><span>Cost</span><i>⚖</i><span>Benefit</span></div><small>Value is not price alone.</small></div></div>
        </summary>
        <div class="s5-report-body"><h3>Full look at what you get for the price</h3><p class="s5-plain-intro">We look at the cost, the benefits you are likely to notice and any information we still need. A higher price is not automatically better value.</p>${matrixReport}${matrixCross}
          ${selected.length>1?`<section class="s5-selected-vm"><h3>Price and value for each phone you selected</h3><p>Here are the published new-phone price comparisons when we have matching, checked regional prices. A price difference alone is not a VM score.</p>${selected.slice(1).map((other:any)=>{const entry=comparableRetailPrices(model,other,state.region);return `<article class="s5-direct-pair"><h4>${safeText(model.name,70)} versus ${safeText(other.name,70)}</h4><p>${entry?`Recorded new-phone price difference: <strong>${entry.diff>=0?'+':'−'}${money(state.region,Math.abs(entry.diff))}</strong>. This is not an owned-phone upgrade cost without a matching resale estimate.`:`We do not have comparable new-phone prices for both models in ${safeText(region.label,60)}. A fair value score remains unavailable.`}</p></article>`;}).join('')}</section>`:''}
          <h3>How we compared the prices</h3>${prev?(retailPair?`<p>Current comparable new-purchase price difference in ${safeText(region.label)}: <b>${esc(deltaDisplay)}</b> (${safeText(retailPair.b.storage||retailPair.b.config)} vs ${safeText(retailPair.a.storage||retailPair.a.config)}; checked ${safeText(retailPair.a.asOf)} and ${safeText(retailPair.b.asOf)}). This is not the owned-phone upgrade cost without verified resale evidence.</p>`:`<p>Not assessed. ${safeText(pricingCaveat,500)}</p>`):"<p>We need a suitable older model to work out a fair price difference.</p>"}
        </div>
      </details>
      ${footer()}
      <p class="s5-method-footer"><a href="/phones/reviews/methodology/">How we rate phones (being completed)</a> · Editorial policy · We show which points are proven and which are our opinion.</p>`;
    if(new URLSearchParams(location.search).get('glOpen')==='1'){
      const first=root.querySelector<HTMLDetailsElement>('#gl7-detail-1');
      if(first)first.open=true;
    }
  }

  // Preserve working deep-dive controls from the existing Step 5 modules.
  root.addEventListener("click",(event:Event)=>{
    const target=event.target as HTMLElement;
    const areaJump=target.closest<HTMLButtonElement>("[data-gl8-go]");
    if(areaJump){
      const code=areaJump.getAttribute('data-gl8-go') || '';
      const [pair,category]=code.split(':');
      if(/^\d+$/.test(pair) && /^(performance|camera|battery|display|software|design)$/.test(category||'')){
        const parent=root.querySelector<HTMLElement>(`#gl7-detail-${pair}`);
        const area=parent?.querySelector<HTMLDetailsElement>(`.gl7-${category}`);
        if(parent && area){
          (parent as HTMLDetailsElement).open=true;
          area.open=true;
          area.scrollIntoView({behavior:'smooth',block:'nearest'});
        }
      }
      return;
    }
    const btn=target.closest<HTMLElement>("[data-lr]");
    if(btn){const open=btn.dataset.lr==="open";root.querySelectorAll<HTMLDetailsElement>(".lr-sec").forEach(d=>d.open=open);}
    const fold=target.closest<HTMLElement>("[data-fv]");
    if(fold){const open=fold.dataset.fv==="open";root.querySelectorAll<HTMLDetailsElement>(".fv-p").forEach(d=>d.open=open);}
    if(target.closest(".s5-switch-buy") && state.mode!=="match"){
      try{ if(state.mode==="generations"||state.mode==="brands"||state.mode==="value")sessionStorage.setItem("onocra-previous-explore-mode",state.mode); }catch{}
    }
    const showBuy=target.closest<HTMLButtonElement>("[data-buy-options]");
    if(showBuy){const box=root.querySelector<HTMLElement>("#s5-buy-options");if(box){box.hidden=!box.hidden;showBuy.setAttribute("aria-expanded",String(!box.hidden));if(!box.hidden)box.scrollIntoView({behavior:"smooth",block:"nearest"});}}
    const share=target.closest<HTMLButtonElement>("[data-share]");
    if(share){
      const url=location.href;
      (async()=>{
        try{
          if(navigator.share)await navigator.share({title:document.title,url});
          else {await navigator.clipboard.writeText(url);share.textContent="Link copied ✓";window.setTimeout(()=>{share.textContent="↗ Share Verdict"},1800);}
        }catch{/* user cancelled, permission denied or unavailable */}
      })();
    }
  });
  root.addEventListener("error",(event:Event)=>{
    const img = event.target;
    if (!(img instanceof HTMLImageElement) || !img.closest(".s5-phone-image"))return;
    const wrap=img.closest<HTMLElement>(".s5-phone-image");
    if (wrap) {img.remove();const note=document.createElement("span");note.textContent="Photo unavailable";wrap.appendChild(note);}
  },true);
  root.addEventListener("change",(event:Event)=>{
    const select=(event.target as HTMLElement).closest<HTMLSelectElement>("[data-vm-partner]");
    if(!select || !model)return;
    const other=byId(select.value);
    const host=root.querySelector<HTMLElement>(".vm-cross-body");
    if(other&&host)host.innerHTML=crossBody({model,other,region:state.region});
  });
</script>

<style is:global>
  /* Generational Leap Report. Colours and fonts come from the shared tokens (--on-*, --f-*). */
  .flow .lr { display: grid; gap: 18px; }
  .flow .lr .banner { margin: 0; }

  /* Part 1: snapshot */
  .flow .lr-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 14px; align-items: center; }
  .flow .lr-model { display: flex; gap: 16px; align-items: center; padding: 16px; background: var(--f-surface); border: 1px solid var(--f-border); border-radius: 16px; box-shadow: var(--on-shadow-sm); }
  .flow .lr-model--new { border-color: var(--f-brand); box-shadow: 0 0 0 1px var(--f-brand); }
  .flow .lr-pic { flex: none; width: 96px; height: 128px; display: grid; place-items: center; border-radius: 12px; background: var(--f-surface-2); }
  .flow .lr-pic img { width: 100%; height: 100%; object-fit: contain; }
  .flow .lr-phone { width: 46px; height: 92px; border-radius: 12px; border: 3px solid var(--f-muted); background: linear-gradient(160deg, var(--f-surface), var(--f-surface-2)); position: relative; }
  .flow .lr-phone::after { content: ""; position: absolute; top: 6px; left: 50%; width: 14px; height: 4px; margin-left: -7px; border-radius: 4px; background: var(--f-muted); }
  .flow .lr-info { min-width: 0; }
  .flow .lr-tag { margin: 0 0 4px; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--f-accent); }
  .flow .lr-info h3 { margin: 0 0 8px; font-family: var(--on-display); font-size: 1.15rem; line-height: 1.2; letter-spacing: -.01em; }
  .flow .lr-line { display: grid; grid-template-columns: 92px 1fr; gap: 8px; margin: 0 0 4px; font-size: .88rem; line-height: 1.4; }
  .flow .lr-line > span:first-child { color: var(--f-muted); }
  .flow .lr-line small { display: block; color: var(--f-muted); font-size: .78rem; }
  .flow .lr-vs { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--f-surface-2); border: 1px solid var(--f-border); font-family: var(--on-display); font-weight: 700; font-size: 1.05rem; }

  .flow .lr-glance { padding: 16px 18px 18px; border-radius: 16px; background: var(--f-brand); color: var(--f-on-brand); }
  .flow .lr-glance h3 { margin: 0 0 12px; text-align: center; font-size: .8rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: inherit; }
  .flow .lr-glance ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 14px; }
  .flow .lr-glance li { display: flex; align-items: center; gap: 10px; font-size: .92rem; font-weight: 600; line-height: 1.35; }

  /* markers: symbol + colour, never colour alone */
  .flow .lr-mk { display: inline-grid; place-items: center; flex: none; width: 22px; height: 22px; margin-right: 8px; border-radius: 50%; font-size: .7rem; font-weight: 800; border: 1px solid; vertical-align: middle; }
  .flow .lr-glance .lr-mk { margin-right: 0; }
