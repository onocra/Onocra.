---
import FlowShell from "@/components/Reviews/FlowShell.astro";
import { devices, leaps, sourcesNote } from "@/data/devices";
---

<FlowShell
  step={5}
  title="Verdict | ONOCRA Reviews"
  heading="Your verdict"
  lead="A written conclusion first, then the evidence behind it."
  wide
>
  <div id="verdict" aria-live="polite">
    <div class="empty">Loading your verdict…</div>
  </div>

  <script type="application/json" id="data" set:html={JSON.stringify({ devices, leaps, sourcesNote })} />

  <Fragment slot="nav">
    <a class="btn ghost" id="back" href="#">← Edit answers</a>
    <button class="btn" id="share" type="button">Share verdict</button>
  </Fragment>
</FlowShell>

<script>
  import {
    readState, stepUrl, fitFor, esc, money, regionInfo, priorityLabel, MODES, WHO,
  } from "../../../lib/reviewFlow";
  import { buildLeapReport } from "../../../lib/leapReport";
  import { buildUpgradeMatrix, buildCrossBrandMatrix, crossPartners, crossBody } from "../../../lib/valueMatrix";
  import { buildFinalVerdict } from "../../../lib/onocraVerdict";
  import { buildThirdPartySynopsis } from "../../../lib/thirdPartySynopsis";

  const data = JSON.parse(document.getElementById("data")!.textContent || "{}");
  const devs: any[] = data.devices;
  const leaps: any[] = data.leaps;
  const state = readState(location.search);
  const root = document.getElementById("verdict")!;
  const heading = document.getElementById("flow-heading")!;

  document.getElementById("back")!.setAttribute("href", stepUrl("models", state));

  const model = devs.find((d) => d.id === state.model);

  const STATUS: Record<string, string> = {
    improved: "▲ Improved", unchanged: "＝ Unchanged", regressed: "▼ Regressed", unverified: "? Unverified",
  };
  const KIND: Record<string, string> = {
    manufacturer: "Manufacturer claim", independent: "Independent testing",
    editorial: "ONOCRA editorial interpretation", unverified: "Evidence unavailable",
  };
  const byId = (id: string) => devs.find((d) => d.id === id);

  // Collapsible section. Same content and order as before, now a dropdown.
  const acc = (title: string, objective: string, body: string) =>
    `<details class="acc report-panel"><summary><span><strong>${title}</strong><small>${objective}</small></span><span aria-hidden="true">⌄</span></summary><div class="acc-body">${body}</div></details>`;

  function chainFor(m: any) {
    // Leap sets that end at this model, then walk back through the family.
    const out: any[] = [];
    let cur = m.id;
    for (let i = 0; i < 6; i++) {
      const set = leaps.find((l) => l.to === cur);
      if (!set) break;
      out.push(set);
      cur = set.from;
    }
    return out;
  }

  function tally(rows: any[]) {
    const t = { improved: 0, unchanged: 0, regressed: 0, unverified: 0 } as Record<string, number>;
    rows.forEach((r) => t[r.status]++);
    return t;
  }

  function leapHtml(set: any) {
    const a = byId(set.from), b = byId(set.to);
    const t = tally(set.rows);
    return `
      <div class="leap-set">
        <h3>${esc(a.name)} → ${esc(b.name)}</h3>
        <p class="meta">${t.improved} improved · ${t.unchanged} unchanged · ${t.regressed} regressed · ${t.unverified} unverified</p>
        ${set.rows.map((r: any) => `
          <details class="leap-row">
            <summary>
              <span><strong>${esc(r.feature)}</strong><br><small>${esc(r.headline)}</small></span>
              <span class="st st-${r.status}">${STATUS[r.status]}</span>
            </summary>
            <div class="body">
              <p>${esc(r.detail)}</p>
              <p class="src">${esc(KIND[r.kind])}: ${esc(r.evidence)} · confidence ${esc(r.confidence)} · as of ${esc(r.asOf)}</p>
            </div>
          </details>`).join("")}
        <p><strong>Plain-language reading:</strong> ${esc(set.verdict)}</p>
      </div>`;
  }

  function bars(m: any, fam: any[]) {
    const metrics: [string, string, string][] = [
      ["battery", "Battery capacity", "mAh"], ["display", "Display size", "in"], ["storage", "Base storage", "GB"],
    ];
    return metrics.map(([k, label, unit]) => {
      const max = Math.max(...fam.map((d) => d.specs[k].numeric || 0)) || 1;
      return `<div class="bar-row"><div class="lbl"><strong>${label}</strong><span>${unit}</span></div>${fam.map((d) => {
        const v = d.specs[k].numeric || 0;
        return `<div class="lbl" style="margin-top:4px"><span>${esc(d.name)}${d.id === m.id ? " (selected)" : ""}</span><span>${esc(d.specs[k].value)}</span></div>
          <div class="bar-track" role="img" aria-label="${esc(d.name)} ${label}: ${esc(d.specs[k].value)}"><div class="bar-fill" style="width:${Math.round((v / max) * 100)}%;${d.id === m.id ? "" : "opacity:.55"}"></div></div>`;
      }).join("")}</div>`;
    }).join("");
  }

  function specTable(fam: any[]) {
    const rows: [string, string][] = [
      ["display", "Display"], ["battery", "Battery"], ["cameras", "Rear cameras"], ["refresh", "Refresh rate"],
      ["ram", "RAM (typical)"], ["storage", "Base storage"], ["charging", "Wired charging"],
    ];
    return `<div class="tbl-wrap"><table class="tbl"><thead><tr><th>Feature</th>${fam.map((d) => `<th>${esc(d.name)}</th>`).join("")}</tr></thead><tbody>${
      rows.map(([k, l]) => `<tr><td>${l}</td>${fam.map((d) => `<td>${esc(d.specs[k].value)}</td>`).join("")}</tr>`).join("")
    }</tbody></table></div>
    <p class="flow-note">Published specifications. Chipsets and some configurations vary by region.</p>`;
  }

  function upgradeValue(m: any, prev: any) {
    const r = state.region;
    const pm = m.prices[r], pp = prev?.prices[r];
    if (!prev) return `<p>Upgrade Value needs a predecessor to compare against, and none is catalogued yet.</p>`;
    if (!pm || !pp) {
      return `<p><strong>Not assessed.</strong> Upgrade Value depends on verified prices in your country (${esc(regionInfo(r).label)}) for the exact configuration, seller and date. We hold no verified price for ${esc(!pm ? m.name : prev.name)} there yet, and we do not estimate prices.</p>`;
    }
    const diff = pm.amount - pp.amount;
    return `<p>Verified difference in ${esc(regionInfo(r).label)}: <strong>${diff >= 0 ? "+" : "−"}${money(r, Math.abs(diff))}</strong>
      (${esc(pp.config)} vs ${esc(pm.config)}; prices as of ${esc(pm.asOf)}). Weigh this against the improvements above: the same cost can be good value for one visitor and poor value for another.</p>`;
  }

  // Rebuilds the final verdict for a chosen comparison partner (set inside render()).
  let fvFor: ((other: any | null) => string) | null = null;

  function render() {
    const fam = devs.filter((d) => d.family === model.family).sort((a, b) => a.generation - b.generation);
    const idx = fam.findIndex((d) => d.id === model.id);
    const prev = idx > 0 ? fam[idx - 1] : null;
    const chain = chainFor(model);
    const mode = MODES.find((x) => x.id === state.mode);
    const who = WHO.find((x) => x.id === state.who);
    const fit = state.prio.length ? fitFor(model.fit, state.prio) : null;

    heading.textContent = `ONOCRA Hero Verdict`;

    const topSet = chain[0];
    const headline = topSet
      ? (topSet.rows.filter((r: any) => r.status === "improved").length > 3 ? "Several real improvements" : "An incremental step")
      : "Preliminary profile";
    const recommendation = topSet
      ? topSet.verdict
      : `We do not yet hold a verified predecessor comparison for ${model.name}, so we cannot say whether upgrading is worthwhile. Treat this page as a profile, not a recommendation.`;
    const cta = state.intent === "buying"
      ? "Since you are planning to buy, check the buying options below. Confirm the exact configuration and price in your country first."
      : "Since you are researching, there is no rush: saving this page lets you revisit it when prices change.";

    // The ONOCRA final verdict: index first, five folded panels. Compared model is the predecessor,
    // or the first other-brand model when the visitor chose the "Across brands" route.
    const defaultOther = state.compare.length ? byId(state.compare[0]) : prev;
    fvFor = (other: any | null) =>
      buildFinalVerdict({
        model, other, devs, region: state.region,
        recommendation, summary: model.summary, cta,
        modeLabel: mode?.label, whoLabel: who?.label, intent: state.intent,
        prioLabels: state.prio.map((p: string) => priorityLabel(p)),
        fit: fit ? { label: fit.label, evidenced: fit.evidenced, total: fit.total } : null,
        tradeoffs: model.tradeoffs ?? [],
        leap: topSet ? tally(topSet.rows) : null,
      });

    const parts: string[] = [];
    const explore = state.mode !== 'match';
    const chosen = [model,...state.compare.map(byId).filter((d:any)=>d&&d.category===model.category&&d.id!==model.id)].slice(0,3);
    const selectedPartner = chosen[1] ?? prev;
    const regionalNames = state.region==='US' ? 'Consumer Reports and PCMag' : 'Which? and Notebookcheck';
    parts.push(`<section class="step5-box guide-box"><div class="guide-head"><img src="/phones/brand/iconsimple.png" alt="ONOCRA pelican"/><div><h2>A note from your ONOCRA guide</h2><p>Here is what the research can—and cannot—tell us about your selected models.</p></div></div>
      <div class="framework-grid">
        <p><strong>Generational Leap</strong>Tracks what actually improved, stayed the same or declined between generations. Missing evidence remains unverified.</p>
        <p><strong>Value Matrix</strong>Weighs useful improvements against verified market prices and trade-offs. Missing prices prevent a reliable value conclusion.</p>
        <p><strong>Independent Parties</strong>Summarises attributable research from ${regionalNames}, when an exact model review is available.</p>
        <p><strong>ONOCRA Framework</strong>Separates published evidence from editorial interpretation and personal fit. ONOCRA does not claim to run laboratory tests. <a href="/phones/reviews/methodology/">Detailed methodology →</a></p>
      </div></section>`);
    parts.push(`<section class="step5-box"><h2>Selected models</h2><div class="chosen-models">${chosen.map((d:any,i:number)=>`<div><small>${i===0?'PRIMARY MODEL':`COMPARISON ${i}`}</small><strong>${esc(d.brand)} · ${esc(d.name)}</strong></div>`).join('')}</div></section>`);
    parts.push(`<section class="step5-box verdict-box"><div class="verdict-heading"><div><small>ONOCRA EDITORIAL ASSESSMENT</small><h2>ONOCRA VERDICT</h2></div><img src="/phones/brand/iconsimple.png" alt="ONOCRA editorial signature"/></div>
      <p class="tagline">${esc(headline)}</p>
      ${model.status==='specimen'?'<p class="banner">Preliminary research specimen. Unverified findings and prices are not established facts.</p>':''}
      <div class="fv-host">${fvFor(selectedPartner)}</div>
      <div class="verdict-graphic"><div><strong>Evidence snapshot</strong><small>Count of catalogued generational findings, not a product quality score</small></div>
      ${topSet ? Object.entries(tally(topSet.rows)).map(([key,value])=>`<div class="evidence-bar"><span>${esc(key)}</span><meter min="0" max="${topSet.rows.length||1}" value="${value}">${value}</meter><b>${value}</b></div>`).join('') : '<p>Not enough verified generational findings to plot an evidence snapshot.</p>'}</div>
      <p class="flow-note">The editorial module publishes its supporting points only where source data supports them; ONOCRA will not pad the verdict to 10–12 invented claims.</p>
    </section>`);
    const leapBody = buildLeapReport({model,prev,set:topSet??null,region:state.region});
    parts.push(acc('Generational Leap Report','What changed across generations, and why those changes matter.',
      explore ? `${leapBody||'<p>No detailed leap report catalogued yet.</p>'}<h3>Evidence detail</h3>${chain.length?chain.map(leapHtml).join(''):'<p>Predecessor evidence is not yet verified.</p>'}`
      : `<p>${esc(topSet?.verdict||'A reliable generational conclusion is not yet available.')}</p>${leapBody||''}`));
    const matrixBody = buildUpgradeMatrix({model,prev,set:topSet??null,region:state.region});
    const cross = chosen.slice(1).filter((d:any)=>d.brand!==model.brand);
    parts.push(acc('Value Matrix','Examines practical benefits, regional cost and upgrade trade-offs.',
      `${matrixBody}${cross.length?buildCrossBrandMatrix({model,others:cross,region:state.region}):''}${explore?`<h3>Price evidence</h3>${upgradeValue(model,prev)}`:''}`));
    parts.push(acc('Independent Third-Party Reviews Synopsis',`Attributed findings from ${regionalNames}; missing coverage is not a negative rating.`,
      buildThirdPartySynopsis({modelIds:chosen.map((d:any)=>d.id),devices:devs,region:state.region,route:explore?'explore':'choose'})));
    if(fit) parts.push(`<section class="step5-box"><h2>Your personal match</h2><p>${esc(fit.label)} · ${fit.evidenced} of ${fit.total} priorities have rated evidence. This is separate from ONOCRA's editorial verdict.</p></section>`);
    root.innerHTML = parts.join("");
  }

  // Generational Leap Report: expand / collapse every side-by-side section.
  root.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-lr]");
    if (!btn) return;
    const open = btn.dataset.lr === "open";
    root.querySelectorAll<HTMLDetailsElement>(".lr-sec").forEach((d) => (d.open = open));
  });

  // Final verdict: expand / collapse every panel.
  root.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-fv]");
    if (!btn) return;
    const open = btn.dataset.fv === "open";
    root.querySelectorAll<HTMLDetailsElement>(".fv-p").forEach((d) => (d.open = open));
  });

  // Cross-brand Value Matrix: switch the comparison partner without leaving the page.
  root.addEventListener("change", (e) => {
    const sel = (e.target as HTMLElement).closest<HTMLSelectElement>("[data-vm-partner]");
    if (!sel || !model) return;
    const other = devs.find((d) => d.id === sel.value);
    const host = root.querySelector<HTMLElement>(".vm-cross-body");
    if (other && host) host.innerHTML = crossBody({ model, other, region: state.region });
    const fvHost = root.querySelector<HTMLElement>(".fv-host");
    if (other && fvHost && fvFor) fvHost.innerHTML = fvFor(other);
  });

  // Rendered last so every helper above is initialised.
  if (!model) {
    root.innerHTML = `<div class="empty">No model selected yet. <a href="${stepUrl("models", state)}">Choose a model</a>.</div>`;
  } else render();

  document.getElementById("share")!.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const url = location.href;
    try {
      if (navigator.share) await navigator.share({ title: document.title, url });
      else { await navigator.clipboard.writeText(url); btn.textContent = "Link copied ✓"; setTimeout(() => (btn.textContent = "Share verdict"), 2000); }
    } catch { /* cancelled */ }
  });
</script>

<style is:global>
  /* Generational Leap Report. Colours and fonts come from the shared tokens (--on-*, --f-*). */
  .flow .lr { display: grid; gap: 18px; }
  .flow .lr .banner { margin: 0; }

  /* Part 1: snapshot */
  .flow .lr-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 14px; align-items: center; }
  .flow .lr-model { display: flex; gap: 16px; align-items: center; padding: 16px; background: var(--f-surface); border: 1px solid var(--f-border); border-radius: 16px; box-shadow: var(--on-shadow-sm); }
  .flow .lr-model--new { border-color: var(--f-brand); box-shadow: 0 0 0 1px var(--f-brand); }
  .flow .lr-pic { flex: none; width: 96px; height: 128px; display: grid; place-items: center; border-radius: 12px; background: var(--f-surface-2); }
  .flow .lr-pic img { width: 100%; height: 100%; object-fit: contain; }
  .flow .lr-phone { width: 46px; height: 92px; border-radius: 12px; border: 3px solid var(--f-muted); background: linear-gradient(160deg, var(--f-surface), var(--f-surface-2)); position: relative; }
  .flow .lr-phone::after { content: ""; position: absolute; top: 6px; left: 50%; width: 14px; height: 4px; margin-left: -7px; border-radius: 4px; background: var(--f-muted); }
  .flow .lr-info { min-width: 0; }
  .flow .lr-tag { margin: 0 0 4px; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--f-accent); }
  .flow .lr-info h3 { margin: 0 0 8px; font-family: var(--on-display); font-size: 1.15rem; line-height: 1.2; letter-spacing: -.01em; }
  .flow .lr-line { display: grid; grid-template-columns: 92px 1fr; gap: 8px; margin: 0 0 4px; font-size: .88rem; line-height: 1.4; }
  .flow .lr-line > span:first-child { color: var(--f-muted); }
  .flow .lr-line small { display: block; color: var(--f-muted); font-size: .78rem; }
  .flow .lr-vs { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--f-surface-2); border: 1px solid var(--f-border); font-family: var(--on-display); font-weight: 700; font-size: 1.05rem; }

  .flow .lr-glance { padding: 16px 18px 18px; border-radius: 16px; background: var(--f-brand); color: var(--f-on-brand); }
  .flow .lr-glance h3 { margin: 0 0 12px; text-align: center; font-size: .8rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: inherit; }
  .flow .lr-glance ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 14px; }
  .flow .lr-glance li { display: flex; align-items: center; gap: 10px; font-size: .92rem; font-weight: 600; line-height: 1.35; }

  /* markers: symbol + colour, never colour alone */
  .flow .lr-mk { display: inline-grid; place-items: center; flex: none; width: 22px; height: 22px; margin-right: 8px; border-radius: 50%; font-size: .7rem; font-weight: 800; border: 1px solid; vertical-align: middle; }
  .flow .lr-glance .lr-mk { margin-right: 0; }
  .flow .lr-mk--better { background: var(--st-improved-bg); color: var(--st-improved-fg); border-color: var(--st-improved-bd); }
  .flow .lr-mk--same { background: var(--st-unchanged-bg); color: var(--st-unchanged-fg); border-color: var(--st-unchanged-bd); }
  .flow .lr-mk--worse { background: var(--st-regressed-bg); color: var(--st-regressed-fg); border-color: var(--st-regressed-bd); }
  .flow .lr-mk--unknown { background: var(--st-unverified-bg); color: var(--st-unverified-fg); border-color: var(--st-unverified-bd); }

  /* Part 2: expandable deep-dive */
  .flow .lr-adv { border: 1px solid var(--f-border); border-radius: 16px; background: var(--f-surface); overflow: hidden; }
  .flow .lr-adv > summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 14px; padding: 15px 18px; cursor: pointer; list-style: none; font-weight: 800; background: var(--f-surface-2); transition: background .15s; }
  .flow .lr-adv > summary::-webkit-details-marker, .flow .lr-sec > summary::-webkit-details-marker { display: none; }
  .flow .lr-adv > summary::after { content: ""; flex: none; width: 9px; height: 9px; margin-left: auto; border-right: 2px solid var(--f-muted); border-bottom: 2px solid var(--f-muted); transform: rotate(45deg); transition: transform .2s; }
  .flow .lr-adv[open] > summary::after { transform: rotate(-135deg); }
  .flow .lr-adv > summary:hover { background: color-mix(in srgb, var(--f-surface-2) 70%, var(--f-brand-tint)); }
  .flow .lr-adv > summary:focus-visible, .flow .lr-sec > summary:focus-visible { outline: 3px solid var(--f-ring); outline-offset: -3px; }
  .flow .lr-sec-c { font-size: .8rem; font-weight: 600; color: var(--f-muted); }
  .flow .lr-adv[open] > summary { border-bottom: 1px solid var(--f-border); }
  .flow .lr-adv > :not(summary) { margin-inline: 16px; }
  .flow .lr-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; margin-top: 14px; margin-bottom: 4px; }
  .flow .lr-legend { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0; font-size: .8rem; color: var(--f-text-2); }
  .flow .lr-legend .lr-mk { width: 20px; height: 20px; margin-right: 6px; }
  .flow .lr-btns { display: flex; gap: 8px; }
  .flow .lr-btn { min-height: 34px; padding: 6px 14px; border-radius: 10px; border: 1px solid var(--f-border); background: var(--f-surface); color: var(--f-text); font: inherit; font-size: .82rem; font-weight: 700; cursor: pointer; transition: background .15s, border-color .15s; }
  .flow .lr-btn:hover { background: var(--f-surface-2); border-color: var(--f-brand); }
  .flow .lr-btn:focus-visible { outline: 3px solid var(--f-ring); outline-offset: 2px; }

  .flow .lr-sec { border: 1px solid var(--f-border); border-radius: 14px; margin: 12px 16px; background: var(--f-surface); overflow: hidden; }
  .flow .lr-sec > summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 12px; padding: 12px 16px; cursor: pointer; list-style: none; transition: background .15s; }
  .flow .lr-sec > summary:hover { background: var(--f-surface-2); }
  .flow .lr-sec[open] > summary { background: var(--f-surface-2); border-bottom: 1px solid var(--f-border); }
  .flow .lr-sec-t { display: flex; align-items: center; gap: 10px; }
  .flow .lr-sec-t h3 { margin: 0; font-size: 1rem; }
  .flow .lr-ico { font-size: 1.2rem; line-height: 1; }
  .flow .lr-tw { overflow-x: auto; }
  .flow .lr-tbl { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .flow .lr-tbl th, .flow .lr-tbl td { padding: 11px 14px; border-bottom: 1px solid var(--f-border); text-align: left; vertical-align: top; }
  .flow .lr-tbl tbody tr:last-child > * { border-bottom: 0; }
  .flow .lr-tbl thead th { font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--f-muted); background: var(--f-surface); }
  .flow .lr-tbl thead th:nth-child(2) { text-align: center; }
  /* the middle column is the anchor: older model left, newer model right */
  .flow .lr-tbl tbody th { width: 26%; text-align: center; font-weight: 800; background: var(--f-surface-2); border-inline: 1px solid var(--f-border); }
  .flow .lr-tbl td { width: 37%; font-variant-numeric: tabular-nums; }
  .flow .lr-note { display: block; margin-top: 2px; color: var(--f-muted); font-size: .8rem; margin-left: 30px; }
  .flow .lr-tbl td[data-label="Previous"] .lr-note { margin-left: 0; }
  .flow .lr-tbl td:last-child > span:not(.lr-mk):not(.sr-only) { vertical-align: middle; }

  @media (max-width: 760px) {
    .flow .lr-hero { grid-template-columns: 1fr; }
    .flow .lr-vs { justify-self: center; width: 40px; height: 40px; }
    .flow .lr-glance ul { grid-template-columns: 1fr; }
    .flow .lr-sec { margin-inline: 10px; }
    .flow .lr-adv > :not(summary) { margin-inline: 10px; }
    /* stack each row as: specification, previous, new */
    .flow .lr-tbl thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .flow .lr-tbl, .flow .lr-tbl tbody, .flow .lr-tbl tr, .flow .lr-tbl th, .flow .lr-tbl td { display: block; width: 100%; }
    .flow .lr-tbl tr { padding: 4px 0 8px; border-bottom: 1px solid var(--f-border); }
    .flow .lr-tbl tbody tr:last-child { border-bottom: 0; }
    .flow .lr-tbl tbody th { order: -1; border: 0; background: none; text-align: left; padding: 10px 14px 2px; width: 100%; }
    .flow .lr-tbl tbody tr { display: flex; flex-direction: column; }
    .flow .lr-tbl td { border: 0; padding: 3px 14px; }
