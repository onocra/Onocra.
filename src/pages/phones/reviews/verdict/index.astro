  // Facts can be displayed before the separately calibrated numerical GL index.
  // Price, resale and purchase recommendation are outside this GL report.
  const GL6 = [
    {key:'performance',name:'Performance',weight:25,question:'Is it faster for the things you do?',keys:['chipset','ram','storage','cpuTest','gpuTest'],caveat:'A newer chip name or more memory does not prove faster everyday use. Comparable CPU, GPU and sustained-speed tests are needed.'},
    {key:'camera',name:'Cameras & video',weight:20,question:'Will photos or video actually improve?',keys:['cameras','zoom','cameraTest','videoTest'],caveat:'More megapixels or an extra lens do not prove better photos. Matched photo, zoom and video testing is needed.'},
    {key:'battery',name:'Battery & charging',weight:15,question:'Will it last longer or charge more quickly?',keys:['battery','charging','enduranceTest','fullChargeTest'],caveat:'An “all-day” claim, battery capacity or charging watts do not tell us actual endurance or full-charge time.'},
    {key:'display',name:'Display',weight:15,question:'Will the screen look or feel better?',keys:['display','refresh','brightness'],caveat:'A bigger screen may be useful, but it is not automatically a better screen. Verified brightness, contrast and other tests matter.'},
    {key:'software',name:'Software & security',weight:10,question:'What genuinely useful changes and protections are new?',keys:['software','support','security'],caveat:'A newer iOS version alone does not guarantee longer support or a feature unavailable on the older model.'},
    {key:'design',name:'Design & connectivity',weight:15,question:'Is it more comfortable, durable or useful?',keys:['dimensions','connectivity','ipRating','sim','network'],caveat:'A different material or wireless version alone is not proof of greater durability or a noticeable everyday benefit.'},
  ] as const;
  const glNames:Record<string,string>={
    chipset:'Processor',ram:'Memory (RAM)',storage:'Storage choices',cpuTest:'Measured CPU speed',gpuTest:'Measured graphics speed',
    cameras:'Camera equipment',zoom:'Zoom capabilities',cameraTest:'Tested photo quality',videoTest:'Tested video quality',
    battery:'Published battery information',charging:'Charging features',enduranceTest:'Measured battery life',fullChargeTest:'Tested full-charge time',
    display:'Screen and panel',refresh:'Screen refresh rate',brightness:'Published screen brightness',
    software:'Software features',support:'Guaranteed update period',security:'Security improvements',
    dimensions:'Size, weight & materials',connectivity:'Connections',ipRating:'Water and dust protection',sim:'SIM options',network:'Mobile network'
  };
  const glField=(device:any,field:string):any|null=>{
    if(!device)return null;
    const record=glApple[device.id];
    if(device.brand==='Apple' && record){
      const local=record.regions?.[state.region];
      // Narrow subtopics reuse the original attributable manufacturer source;
      // derived figures are stated specifications, never independent lab results.
      let evidence=(field==='sim'||field==='network')?local?.[field]:local?.specifications?.[field] ?? record.common?.[field];
      if(field==='refresh'||field==='brightness'){
        const base=local?.specifications?.display ?? record.common?.display;
        const txt=String(base?.value??'');
        const match=field==='refresh' ? txt.match(/(\d{2,3})\s*(?:Hz|hertz)\b/i)
          : txt.match(/(?:up to\s*)?(\d[\d,]*)\s*nits\b/i);
        evidence=base && match ? {...base,value:`${match[1]} ${field==='refresh'?'Hz':'nits'} (${field==='refresh'?'published refresh rate':'published brightness claim'})`} : undefined;
      } else if(field==='ipRating'){
        const base=local?.specifications?.connectivity ?? record.common?.connectivity;
        const match=String(base?.value??'').match(/\bIP\d{2}\b/i);
        evidence=base&&match?{...base,value:`${match[0].toUpperCase()} (claimed protection rating)`}:undefined;
      } else if(field==='zoom'){
        const base=local?.specifications?.cameras ?? record.common?.cameras;
        const txt=String(base?.value??'');
        const match=txt.match(/(?:\b\d+(?:\.\d+)?x\s*(?:optical(?:-quality)?|zoom)\b|\btelephoto\b)/i);
        evidence=base&&match?{...base,value:`${match[0]} (published camera capability)`}:undefined;
      }
      // Independent tests and explicit support commitments require their own
      // comparable records; never derive them from a chipset name or iOS number.
      if(!evidence || typeof evidence.value!=='string'||!evidence.value.trim()||!safeExternal(evidence.source))return null;
      return {...evidence,sourceType:/^https:\/\/(?:[^/]+\.)?apple\.com\//i.test(evidence.source)?'Apple manufacturer':'Outside source'};
    }
    const mapped:Record<string,string>={ram:'ram',storage:'storage',cameras:'cameras',battery:'battery',charging:'charging',display:'display'};
    const item=device.specs?.[mapped[field]];
    if(!item || item.kind==='unverified'||!item.value||!safeExternal(item.source))return null;
    return {value:item.value,source:item.source,checkedAt:'Not recorded in current catalogue export',confidence:'not graded',sourceType:item.kind};
  };
  const glNumber=(s:any,key:string):{n:number,unit:string}|null=>{
    if(!s)return null;
    const val=String(s.value);
    let m:RegExpMatchArray|null=null;
    if(key==='display')m=val.match(/(\d+(?:\.\d+)?)\s*(?:-?inch|["“”])/i);
    if(key==='ram')m=val.match(/(\d+(?:\.\d+)?)\s*GB\b/i);
    if(key==='refresh')m=val.match(/(\d+(?:\.\d+)?)\s*Hz\b/i);
    if(key==='brightness')m=val.match(/(\d[\d,]*)\s*nits\b/i);
    if(key==='storage'){
      const all=[...val.matchAll(/(\d+(?:\.\d+)?)\s*(GB|TB)\b/gi)].map(z=>Number(z[1])*(z[2].toUpperCase()==='TB'?1024:1));
      if(all.length)return {n:Math.min(...all),unit:'GB'};
    }
    if(key==='dimensions')m=val.match(/(?:;|,|\s)(\d+(?:\.\d+)?)\s*g\b/i);
    if(!m)return null;
    const n=Number(m[1]);return Number.isFinite(n)&&n>0?{n,unit:key==='display'?'in':key==='ram'?'GB':key==='refresh'?'Hz':key==='brightness'?'nits':'g'}:null;
  };
  const glMetricBars=(primary:any,other:any,field:string,a:any,b:any):string=>{
    const old=glNumber(a,field),now=glNumber(b,field);
    if(!old||!now||old.unit!==now.unit)return '';
    const limit=Math.max(old.n,now.n);
    const delta=(now.n-old.n)/old.n*100;
    const fmt=(n:number)=>Number(n.toFixed(2)).toLocaleString('en-US');
    const label=field==='dimensions'?'Recorded weight difference':field==='display'?'Screen-size difference':field==='storage'?'Starting-storage difference':field==='refresh'?'Published refresh-rate difference':field==='brightness'?'Published brightness specification':'RAM-capacity difference';
    return `<div class="gl6-bars"><div><span>${safeText(other.name,35)}</span><i><b style="width:${(old.n/limit*100).toFixed(2)}%;background:#a8c3c7"></b></i><em>${fmt(old.n)} ${old.unit}</em></div><div><span>${safeText(primary.name,35)}</span><i><b style="width:${(now.n/limit*100).toFixed(2)}%;background:#36918b"></b></i><em>${fmt(now.n)} ${now.unit}</em></div><small>${esc(label)}: ${delta>0?'+':''}${delta.toFixed(1)}%. This is a physical/specification difference, not an ONOCRA quality score.</small></div>`;
  };
  const glPairKind=(current:any,other:any):string=>{
