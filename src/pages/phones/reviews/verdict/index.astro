<style is:global>
  /* Value Matrix: a folded crux with the working one tap away. Uses the shared tokens. */
  .flow .vm { display: grid; gap: 14px; }
  .flow .vm-pick { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 0 0 14px; font-size: .9rem; font-weight: 700; color: var(--f-text-2); }
  .flow .vm-pick select { min-height: 40px; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--f-border); background: var(--f-surface); color: var(--f-text); font: inherit; font-weight: 600; }
  .flow .vm-pick select:focus { outline: 3px solid var(--f-ring); border-color: var(--f-brand); }

  /* the crux: always visible */
  .flow .vm-crux { padding: 18px 20px; border: 1px solid var(--f-border); border-radius: 16px; background: var(--f-surface); box-shadow: var(--on-shadow-sm); }
  .flow .vm-status { display: block; margin: 0 0 14px; padding: 10px 16px; border-radius: 10px; font-size: .95rem; font-weight: 800; letter-spacing: .02em; text-align: center; border: 1px solid; }
  .flow .vm-status span { margin-right: 8px; font-size: .68rem; letter-spacing: .14em; opacity: .85; }
  .flow .vm-status--go { background: var(--st-improved-bg); color: var(--st-improved-fg); border-color: var(--st-improved-bd); }
  .flow .vm-status--consider { background: var(--st-unverified-bg); color: var(--st-unverified-fg); border-color: var(--st-unverified-bd); }
  .flow .vm-status--skip { background: var(--st-regressed-bg); color: var(--st-regressed-fg); border-color: var(--st-regressed-bd); }
  .flow .vm-status--neutral { background: var(--st-unchanged-bg); color: var(--st-unchanged-fg); border-color: var(--st-unchanged-bd); }
  .flow .vm-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .flow .vm-head strong { font-family: var(--on-display); font-size: 1.7rem; line-height: 1.1; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .flow .vm-head span { color: var(--f-muted); font-size: .9rem; }
  .flow .vm-line { margin: 10px 0 12px; color: var(--f-text-2); line-height: 1.55; }
  .flow .vm-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .flow .vm-chips li { padding: 6px 12px; border-radius: 99px; background: var(--f-surface-2); border: 1px solid var(--f-border); font-size: .82rem; font-weight: 600; }
  .flow .vm-chips li span { margin-right: 4px; color: var(--f-muted); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }

  /* the working: folded */
  .flow .vm-more { border: 1px solid var(--f-border); border-radius: 16px; background: var(--f-surface); overflow: hidden; }
  .flow .vm-more > summary { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 14px; padding: 14px 18px; cursor: pointer; list-style: none; font-weight: 800; background: var(--f-surface-2); transition: background .15s; }
  .flow .vm-more > summary::-webkit-details-marker, .flow .vm-sub > summary::-webkit-details-marker { display: none; }
  .flow .vm-more > summary small { color: var(--f-muted); font-weight: 600; font-size: .8rem; }
  .flow .vm-more > summary::after { content: ""; margin-left: auto; width: 9px; height: 9px; border-right: 2px solid var(--f-muted); border-bottom: 2px solid var(--f-muted); transform: rotate(45deg); transition: transform .2s; }
  .flow .vm-more[open] > summary::after { transform: rotate(-135deg); }
  .flow .vm-more[open] > summary { border-bottom: 1px solid var(--f-border); }
  .flow .vm-more > summary:hover { background: color-mix(in srgb, var(--f-surface-2) 70%, var(--f-brand-tint)); }
  .flow .vm-more > summary:focus-visible, .flow .vm-sub > summary:focus-visible { outline: 3px solid var(--f-ring); outline-offset: -3px; }
  .flow .vm-sub { margin: 12px 14px; border: 1px solid var(--f-border); border-radius: 12px; background: var(--f-surface); overflow: hidden; }
  .flow .vm-sub > summary { padding: 11px 14px; cursor: pointer; list-style: none; font-weight: 700; font-size: .92rem; display: flex; justify-content: space-between; align-items: center; transition: background .15s; }
  .flow .vm-sub > summary::after { content: ""; width: 8px; height: 8px; border-right: 2px solid var(--f-muted); border-bottom: 2px solid var(--f-muted); transform: rotate(45deg); transition: transform .2s; }
  .flow .vm-sub[open] > summary::after { transform: rotate(-135deg); }
  .flow .vm-sub > summary:hover { background: var(--f-surface-2); }
  .flow .vm-sub[open] > summary { background: var(--f-surface-2); border-bottom: 1px solid var(--f-border); }
  .flow .vm-sub-b { padding: 14px 16px; font-size: .92rem; line-height: 1.6; }
  .flow .vm-sub-b > :first-child { margin-top: 0; }
  .flow .vm-sub-b small { color: var(--f-muted); }

  /* score gauge and factor bars */
  .flow .vm-score { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 18px; align-items: start; }
  .flow .vm-gauge { width: 132px; height: 132px; }
  .flow .vm-g-bg { fill: none; stroke: var(--f-surface-2); stroke-width: 12; }
  .flow .vm-g-fg { fill: none; stroke: var(--f-brand); stroke-width: 12; stroke-linecap: round; }
  .flow .vm-gauge--off .vm-g-bg { stroke: var(--f-border); stroke-dasharray: 4 7; }
  .flow .vm-g-n { font-family: var(--on-display); font-size: 30px; font-weight: 700; fill: var(--f-text); }
  .flow .vm-g-s { font-size: 10px; font-weight: 600; fill: var(--f-muted); }
  .flow .vm-pils { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .flow .vm-pil p { margin: 4px 0 0; color: var(--f-text-2); }
  .flow .vm-pil-h { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .flow .vm-pil-h small { color: var(--f-muted); font-size: .75rem; font-weight: 600; }
  .flow .vm-row { display: grid; grid-template-columns: auto minmax(0, 1fr) 52px; align-items: center; gap: 10px; margin-top: 6px; }
