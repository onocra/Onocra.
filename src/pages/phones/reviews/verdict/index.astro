      if(key==='ram')return {change,impact:d>0?'More memory; speed benefit untested':'Less memory; practical effect untested',tone:'neutral',highlight:'Memory amount differs'};
      if(key==='dimensions')return {change,impact:d<0?'Lighter to carry; durability not assessed':'Heavier to carry; handling may differ',tone:'neutral',highlight:'Phone weight differs'};
      if(key==='display')return {change,impact:'Different screen size; quality not established',tone:'neutral',highlight:'Screen size differs'};
      if(key==='refresh')return {change,impact:'Different published refresh rate; smoothness varies by use',tone:'neutral',highlight:'Screen refresh rate differs'};
      if(key==='brightness')return {change,impact:'Different published brightness rating; testing needed',tone:'neutral',highlight:'Screen brightness claim differs'};
    }
    if(String(a.value).trim().toLowerCase()===String(b.value).trim().toLowerCase())return {change:'Same listed details',impact:'No verified change in this specification',tone:'same',highlight:'Same listed details'};
    const dic:Record<string,{impact:string,highlight:string}>={
      chipset:{impact:'Different chip; speed improvement needs comparable tests',highlight:'Processor generation differs'},
      cameras:{impact:'Camera features differ; photo quality needs comparison tests',highlight:'Camera features differ'},
      battery:{impact:'Published battery claims differ; runtime not yet tested',highlight:'Battery claims differ'},
      charging:{impact:'Charging options differ; full-charge speed not confirmed',highlight:'Charging options differ'},
      software:{impact:'Software features differ; remaining support period is not confirmed',highlight:'Software capabilities differ'},
      connectivity:{impact:'Connection features differ; practical benefit varies',highlight:'Connection features differ'},
      sim:{impact:'SIM options differ by market',highlight:'SIM options differ'},
      network:{impact:'Network support differs by region',highlight:'Network bands differ'},
      display:{impact:'Display details differ; screen quality still needs assessment',highlight:'Display features differ'},
      zoom:{impact:'Available zoom equipment differs; picture quality needs testing',highlight:'Zoom features differ'},
      ipRating:{impact:'Published protection rating differs; independent durability not established',highlight:'Protection rating differs'},
      dimensions:{impact:'Physical design differs; durability not proven',highlight:'Design details differ'},
    };
