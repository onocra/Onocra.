    return Math.round(parts.reduce((sum,x)=>sum+(x?.earned||0),0)*10)/10;
  };
  const glRatingForRow=(primary:any,other:any,cat:any,key:string):GlAssessedRow|null=>{
    if(!glCheckedScore(primary,other,cat))return null;
