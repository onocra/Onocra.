  type Gl11Signal = 'positive'|'same'|'negative'|'neutral'|'unknown';
  const gl11Indication=(older:any,newer:any,key:string,meaning:ReturnType<typeof glComparisonMeaning>):{signal:Gl11Signal;arrow:string;change:string;result:string;explanation:string}=>{
    const signal=meaning.tone as Gl11Signal;
