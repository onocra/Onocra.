---
import FlowShell from "@/components/Reviews/FlowShell.astro";
import { devices, leaps, sourcesNote } from "@/data/devices";
---

<FlowShell
  step={5}
  title="Your ONOCRA Verdict | ONOCRA Reviews"
  heading="Your ONOCRA Verdict"
  lead="Clear answers to help you compare phones and decide what suits you."
  wide
>
  <div id="verdict" aria-live="polite"><div class="empty">Loading your verdict…</div></div>
  <script type="application/json" id="data" set:html={JSON.stringify({ devices, leaps, sourcesNote })} />
</FlowShell>

<script>
  import {
    readState, stepUrl, esc, money, regionInfo,
    type ModeId,
  } from "../../../../lib/reviewFlow";
  import { buildLeapReport } from "../../../../lib/leapReport";
  import { buildUpgradeMatrix, buildCrossBrandMatrix, crossBody } from "../../../../lib/valueMatrix";
  import { comparableRetailPrices, pricingCaveat } from "../../../../lib/priceComparability";
  import { buildAppleGLFromEvidence, appleEvidenceSynopsis } from "../../../../lib/appleVerdictBridge";

  // BP-05: design/dashboard layer. It uses the existing research modules without
  // manufacturing a number from a count of improvements or unverified prices.
  const element = document.getElementById("data");
  const payload = JSON.parse(element?.textContent || "{}");
  const devs: any[] = Array.isArray(payload.devices) ? payload.devices : [];
  const leaps: any[] = Array.isArray(payload.leaps) ? payload.leaps : [];
  const state = readState(location.search);
  const region = regionInfo(state.region);
  const root = document.getElementById("verdict")!;
  const heading = document.getElementById("flow-heading");
  if (heading) heading.textContent = "Your ONOCRA Verdict";

  // Retain global specifications when a region overrides only some fields.
  devs.forEach((d: any) => {
    const override = d.regionalSpecs?.[state.region];
    if (override && typeof override === "object") d.specs = { ...(d.specs || {}), ...override };
  });

  const byId = (id: string) => devs.find(d => d.id === id);
  const model = byId(state.model);
  const buying = state.mode === "match";
  const mix = buying
    ? { technical: 15, value: 30, fit: 45, ownership: 10 }
    : { technical: 45, value: 30, fit: 15, ownership: 10 };
  const LEGEND = [
    { key: "technical", label: "What has changed", color: "#3d997b" },
    { key: "value", label: "Worth the price", color: "#e9a044" },
    { key: "fit", label: "What matters to you", color: "#729bd8" },
    { key: "ownership", label: "Long-term use", color: "#a4a4a4" },
  ] as const;

  const safePhoto = (d: any): string | null => {
    const urls = [...(Array.isArray(d?.images) ? d.images : []), ...(d?.image ? [d.image] : [])];
    const url = urls.find((x: unknown) => typeof x === "string" && (/^\/(?!\/)/.test(x) || /^https:\/\//i.test(x)));
    return typeof url === "string" ? url : null;
  };
  const safeExternal = (v: unknown): string | null => {
    if (typeof v !== "string") return null;
    try { const url = new URL(v); return url.protocol === "https:" ? url.href : null; } catch { return null; }
  };
  const asScore = (v: unknown): number | null => {
    if (typeof v !== "number" || !Number.isFinite(v) || v < 0 || v > 100) return null;
    return Math.round(v);
  };
  const tally = (rows: any[]) => {
    const result = { improved: 0, unchanged: 0, regressed: 0, unverified: 0 };
    rows.forEach(r => { const key = r?.status as keyof typeof result; if (key in result) result[key]++; });
    return result;
  };
  const safeText = (v: unknown, max = 260) => esc(String(v ?? "").slice(0,max));
  const scoreMark = (value: number | null, caption: string) =>
    `<div class="s5-score"><div class="s5-score-n">${value == null ? "—" : value}<span>${value == null ? "" : "/100"}</span></div><small>${esc(caption)}</small>${value == null ? '<em title="We do not have enough checked information for a fair number.">Score not ready</em>' : ''}</div>`;
  const reportStats = (html: string, query: string) => {
    const tpl = document.createElement("template"); tpl.innerHTML = html;
    return tpl.content.querySelector(query)?.textContent?.replace(/\s+/g," ").trim() || "";
  };
  // Only use an existing module's explicit score output. Never extract random numbers
  // from explanatory text; do not treat evidence counts as GL magnitude.
  const existingMatrixScore = (html: string): number | null => {
    const tpl = document.createElement("template"); tpl.innerHTML = html;
    if (tpl.content.querySelector(".vm-gauge--off")) return null;
    const raw = tpl.content.querySelector(".vm-g-n")?.textContent?.trim() || "";
    if (!/^\d{1,3}(?:\/100)?$/.test(raw)) return null;
    return asScore(Number(raw.replace("/100", "")));
  };
  const stackedWeights = (type: "explore" | "buy") => {
    const x = type === "buy" ? {technical:15,value:30,fit:45,ownership:10} : {technical:45,value:30,fit:15,ownership:10};
    return `<div class="s5-weights" role="img" aria-label="Technical ${x.technical} percent, Value ${x.value} percent, Personal Fit ${x.fit} percent, Ownership ${x.ownership} percent">${LEGEND.map(o=>`<span style="width:${x[o.key]}%;background:${o.color}">${x[o.key]}%</span>`).join("")}</div>`;
  };
  const selected = model
    ? [model, ...state.compare.map(byId).filter((d:any) => d && d.id !== model.id && d.category === model.category)]
        .filter((d:any,i:number,all:any[])=>all.findIndex(x=>x.id===d.id)===i).slice(0,3)
    : [];

  // Generational reference is automatic. Prefer the immediately preceding model
  // in the SAME product line and tier. If missing, fall back to the immediately
  // previous numbered generation's standard model before premium variants.
  // Never silently jump back two or three generations or treat Pro as like-for-like.
  type SeriesKey = { line: string; number: number; tier: string };
  const seriesKey = (d: any): SeriesKey | null => {
    const name = String(d?.name || "").toLowerCase();
    const m = name.match(/(iphone|galaxy\s+s|pixel|oneplus|xiaomi|motorola\s+edge|motorola\s+razr)\s*(\d{1,3})(?=\b|[a-z])/i);
    if (!m) return null;
    const tail = name.slice(m.index! + m[0].length).trim();
    const tier = /^(?:pro\s+max|pro\s+xl|ultra)\b/.test(tail) ? "ultra"
      : /^pro\b/.test(tail) ? "pro"
      : /^(?:plus|xl)\b|^\+/.test(tail) ? "plus"
      : /^(?:e|a|fe)(?![a-z])/.test(tail) ? "entry" : "standard";
    return { line: m[1].replace(/\s+/g, " ").trim(), number: Number(m[2]), tier };
  };
  const automaticPredecessor = (current: any): any | null => {
    if (!current) return null;
    const key = seriesKey(current);
    const orderByTier: Record<string,string[]> = {
      entry: ["entry","standard","plus","pro","ultra"],
      standard: ["standard","entry","plus","pro","ultra"],
      plus: ["plus","standard","pro","ultra","entry"],
      pro: ["pro","standard","ultra","plus","entry"],
      ultra: ["ultra","pro","standard","plus","entry"],
    };
    if (key) {
      const candidates = devs.filter(d => {
        const older = seriesKey(d);
        return d.id !== current.id && d.brand === current.brand && d.category === current.category
          && older?.line === key.line && older.number === key.number - 1;
      });
      const tiers = orderByTier[key.tier] || orderByTier.standard;
      candidates.sort((a,b) => tiers.indexOf(seriesKey(a)?.tier || "standard")
        - tiers.indexOf(seriesKey(b)?.tier || "standard") || String(a.name).localeCompare(String(b.name)));
      return candidates[0] || null;
    }
    // Only for unnamed-number product families, require a previous calendar year
    // in the same explicit catalogue family; do not guess a distant generation.
    const year = Number(current.year || String(current.releaseDate || "").slice(0,4));
    if (!current.family || !year) return null;
    return devs.find(d => d.id !== current.id && d.brand === current.brand
      && d.category === current.category && d.family === current.family
      && Number(d.year || String(d.releaseDate || "").slice(0,4)) === year - 1) || null;
  };
  // Raw specification comparisons do not claim measured performance, scoring,
  // or a generation-to-generation improvement where no reviewed pair exists.
  const comparisonSpecRows:[string,string][]=[
    ['display','Display'],['refresh','Refresh rate'],['battery','Battery size'],
    ['ram','Memory (RAM)'],['storage','Storage space'],['cameras','Main cameras'],['charging','Charging by cable'],
  ];
  const specCell=(d:any,k:string)=>{
    const o=d?.specs?.[k];
    if(!o || o.kind==='unverified' || !o.value)return '<span class="s5-unknown">No checked information</span>';
    const src=String(o.source||"");
    const link=/^https:\/\/[^\s]+$/i.test(src)
      ? `<a href="${esc(src)}" target="_blank" rel="noopener noreferrer">Evidence source ↗</a>`
      : src ? safeText(src,76) : "";
    return `${safeText(o.value,140)}${link?`<small class="s5-spec-source">${link} · ${safeText(o.kind||'source not classified',26)}</small>`:''}`;
  };
  const specCoverage=(current:any,reference:any)=>comparisonSpecRows.filter(([k])=>
    current?.specs?.[k]?.value && current.specs[k].kind!=='unverified'
    && reference?.specs?.[k]?.value && reference.specs[k].kind!=='unverified').length;
  const specComparisonTable = (first:any,second:any, firstTag:string, secondTag:string):string => {
    const complete=comparisonSpecRows.filter(([k])=>first?.specs?.[k]?.value || second?.specs?.[k]?.value);
    return complete.length
      ? `<div class="s5-spec-wrap"><table class="s5-spec-table"><thead><tr><th>Specification</th><th>${safeText(first.name,70)} · ${esc(firstTag)}</th><th>${safeText(second.name,70)} · ${esc(secondTag)}</th></tr></thead><tbody>${complete.map(([k,label])=>`<tr><th scope="row">${esc(label)}</th><td>${specCell(first,k)}</td><td>${specCell(second,k)}</td></tr>`).join('')}</tbody></table></div>`
      : '<p>We do not yet have enough checked details to compare these two phones fairly.</p>';
  };
  const provisionalGl=(current:any,reference:any):string=>{
    if(!reference)return '<p>We do not yet have enough information about last year’s matching phone to compare it fairly.</p>';
    const a=seriesKey(current),b=seriesKey(reference);
    const sameTier=!!a&&!!b&&a.tier===b.tier;
    return `<div class="s5-reference-comparison">
      <p class="s5-evidence-warning"><strong>Automatic last-generation reference: ${safeText(reference.name,85)}.</strong> ${sameTier?'This is the closest match from the previous generation.':'We used the closest available model from last year because the matching version is missing from our records.'} These details show what the makers say about each phone. They don't prove which one feels better in everyday use.</p>
      ${specComparisonTable(reference,current,'previous generation','primary')}
      <p class="flow-note">We have checked ${specCoverage(current,reference)} of ${comparisonSpecRows.length} phone details for both models. A bigger number does not always mean a better experience.</p>
    </div>`;
  };
  const directComparison=(current:any,other:any,index:number):string=>{
    if(!other)return '';
    const sameBrand=current.brand===other.brand;
    return `<section class="s5-direct-pair" aria-label="Comparison ${index}">
      <h3>Comparison ${index}: ${safeText(current.name,80)} versus ${safeText(other.name,80)}</h3>
      <p class="s5-pair-caption">These are two phones you picked to compare. ${sameBrand?'They are from the same brand.':'They are from different brands.'} This shows what each phone offers today, not how much it improved from last year.</p>
      ${specComparisonTable(current,other,'primary',`comparison ${index}`)}
      <p class="flow-note">We have checked ${specCoverage(current,other)} of ${comparisonSpecRows.length} details for both phones. To say which is faster, takes better photos or lasts longer on a charge, we need reliable tests of both phones.</p>
    </section>`;
  };

  const modelCard = (d:any, i:number) => {
    const photo = safePhoto(d);
    const recorded = d.prices?.[state.region];
    const price = typeof recorded?.amount === "number" && Number.isFinite(recorded.amount)
      ? money(state.region, recorded.amount) : null;
    const date = recorded?.asOf ? ` · ${safeText(recorded.asOf,22)}` : "";
    return `<article class="s5-phone s5-phone-${i}">
      <div class="s5-phone-label">${i===0?"PRIMARY PHONE":`COMPARISON ${i}`}</div>
      <div class="s5-phone-body">
        <div class="s5-phone-image">${photo?`<img src="${esc(photo)}" alt="${safeText(d.name,65)}" loading="lazy"/>`:'<span>Photo pending</span>'}</div>
        <div><strong>${safeText(d.name,90)}</strong><small>${safeText(d.brand,32)}${d.releaseDate?` · ${safeText(String(d.releaseDate).slice(0,4),4)}`:''}</small>
          <p class="s5-recorded">${price ? `${esc(price)} <span>recorded${date}</span>` : "Price not checked yet"}</p>
        </div>
      </div>
    </article>`;
  };

  const guide = () => `<section class="s5-guide">
    <div class="s5-guide-top">
      <img class="s5-pelican" src="/phones/reviews/categories/pelican-step5.png" alt="ONOCRA pelican guide" loading="lazy"/>
      <div><h2>A note from your ONOCRA guide</h2><p>We look at the same phone facts for everyone. If you are exploring, we focus on what is new. If you want to buy, we pay more attention to the features you care about and whether the phone is worth its price.</p></div>
    </div>
    <div class="s5-guide-method">
      <div class="s5-method-title">How ONOCRA weighs the different things that matter</div>
      <div class="s5-journey-grid">
        <article class="s5-journey ${!buying?'is-active':''}">
          <div class="s5-journey-title"><span aria-hidden="true">⌕</span><div><strong>Explore &amp; Compare</strong><p>We look mainly at what has improved and whether it is worth the money.</p></div></div>
          ${stackedWeights("explore")}
          <small>GL 45% · VM 30% · Personal Fit 15% · Ownership 10%</small>
        </article>
        <article class="s5-journey ${buying?'is-active':''}">
          <div class="s5-journey-title"><span aria-hidden="true">♧</span><div><strong>Help Me Choose</strong><p>We look mainly at your needs and what you get for the price.</p></div></div>
          ${stackedWeights("buy")}
          <small>GL 15% · VM 30% · Personal Fit 45% · Ownership 10%</small>
        </article>
        <div class="s5-legend">${LEGEND.map(o=>`<div><i style="background:${o.color}"></i><span>${esc(o.label)}</span></div>`).join("")}</div>
      </div>
      <p class="s5-guide-note"><strong>What does this mean for you?</strong> If you care most about the camera, it matters more in your buying advice. If you want to see what changed from last year, we give those changes more importance. <a href="/phones/reviews/methodology/">Scoring methodology →</a></p>
      <p class="s5-guide-caveat"><b>What Changed (GL)</b>: what is better, unchanged or worse than last year? <b>Value Matrix (VM)</b>: is the extra cost worth it? <b>Your Needs</b>: does this phone suit what matters to you? <b>Long-term Use</b>: will it remain supported and practical to keep?</p>
      <p class="s5-guide-caveat">When comparing different brands, we compare what the phones can do today. These percentages show how much each part matters—not how good a phone is. A score appears only when we have enough checked information.</p>
    </div>
  </section>`;

  const icon = `<img class="s5-seal" src="/phones/reviews/categories/faviconsignature.png" alt="ONOCRA O-dot editorial seal"/>`;

  function leapDetail(set: any): string {
    const t = tally(Array.isArray(set.rows)?set.rows:[]);
    const from = byId(set.from), to = byId(set.to);
    const states: Record<string,string> = {improved:"▲ Improved",unchanged:"= Unchanged",regressed:"▼ Regressed",unverified:"? Unverified"};
    const kinds: Record<string,string> = { manufacturer:"Manufacturer claim",independent:"Independent testing",editorial:"Editorial interpretation",unverified:"Evidence unavailable"};
    return `<section class="s5-leap-chain"><h3>${safeText(from?.name || set.from,90)} → ${safeText(to?.name || set.to,90)}</h3>
      <p class="flow-note">${t.improved} improved · ${t.unchanged} unchanged · ${t.regressed} regressed · ${t.unverified} unverified</p>
      ${set.rows.map((r:any)=>`<details class="leap-row"><summary><strong>${safeText(r.feature,70)}</strong> · ${safeText(r.headline,180)} <span class="st st-${esc(r.status)}">${states[r.status] || '? Unverified'}</span></summary><div class="body"><p>${safeText(r.detail,1500)}</p><p class="src">${kinds[r.kind] || 'Source type unverified'}: ${safeText(r.evidence,420)} · Confidence ${safeText(r.confidence,30)} · as of ${safeText(r.asOf,40)}</p></div></details>`).join('')}
      <p><strong>What these changes mean:</strong> ${safeText(set.verdict,1800)}</p></section>`;
  }

  // ONOCRA pair scoring contract. Each model may carry documented pair-specific
  // 0–100 sub-scores after the scoring engine has validated that exact comparison,
  // region and journey. No fallback to a score for another model/pair.
  // Example schema: model.comparisonScores[otherId].explore.US =
  // {validated:true, technical:80, value:70, fit:75, ownership:90}.
  type Parts = { technical:number|null; value:number|null; fit:number|null; ownership:number|null };
  const pairScores = (primary:any, other:any): {parts:Parts; earned:Parts; total:number|null} => {
    const record = primary?.comparisonScores?.[other.id]?.[buying ? "buy" : "explore"]?.[state.region];
    const parts:Parts = {technical:null,value:null,fit:null,ownership:null};
    const earned:Parts = {technical:null,value:null,fit:null,ownership:null};
    if (record?.validated === true) {
      (Object.keys(parts) as (keyof Parts)[]).forEach(key => {
        parts[key] = asScore(record[key]);
        if (parts[key] !== null) earned[key] = Math.round((parts[key] as number) * mix[key] / 100);
      });
    }
    const all = Object.values(earned).every(n=>n!==null);
    return {parts,earned,total:all ? (Object.values(earned) as number[]).reduce((a,b)=>a+b,0) : null};
  };
  const pairReason = (primary:any, other:any) => {
    const match = leaps.find(l => l.from === other.id && l.to === primary.id)
      || buildAppleGLFromEvidence(other,primary);
    const appleSummary = appleEvidenceSynopsis(other,primary);
    const comparable = comparableRetailPrices(primary,other,state.region);
    const first = buying ? 'price' : 'changes';
    const tech = appleSummary
      ? safeText(appleSummary,430)
      : match
      ? safeText(match.verdict,430)
      : primary.brand !== other.brand
        ? `These phones are from different brands. We compare their recorded features, not one brand's yearly improvements.`
        : `We can compare the published details of these two models, but a checked year-to-year improvement review for this exact pairing is not yet available.`;
    const value = comparable
      ? `The recorded like-for-like new-phone price difference is ${comparable.diff>=0?'+':'−'}${money(state.region,Math.abs(comparable.diff))}. If you already own ${safeText(other.name,55)}, its resale value also matters.`
      : `We do not yet have comparable, checked prices for both models in ${safeText(region.label,65)}. So we cannot responsibly say which is better value.`;
    const sentence = first==='price'
      ? `For ${safeText(primary.name,65)} against ${safeText(other.name,65)}, compare the features you care about and the price of each phone before deciding. ${comparable?'We have comparable price evidence, but the benefits still need weighing.':'Checked comparable prices are still missing.'}`
      : `For ${safeText(primary.name,65)} against ${safeText(other.name,65)}, the main question is whether the differences would matter in day-to-day use. ${match?'A documented GL assessment is available below.':'We cannot yet confirm how much of a real-world improvement this pairing offers.'}`;
    return {tech,value,sentence,match};
  };
  const scoreLine = (score:number|null,max:number,color:string) => {
    const fill = score===null ? '' : `<i style="width:${Math.max(0,Math.min(100,(score/max)*100))}%;background:${color}"></i>`;
    return `<div class="s5-pair-track" role="img" aria-label="${score===null?'Awaiting verified rating':`${score} of ${max} points`}">${fill}</div><b class="s5-pair-points">${score===null?'—':score}<span>/${max}</span></b>`;
  };
  const pairDashboard = (primary:any, alternatives:any[]) => {
    if (!alternatives.length) return `<p class="s5-quiet">Choose one or two phones in Step 4 to see a comparison score and recommendation.</p>`;
    const pairs = alternatives.map((other:any,i:number) => {
      const scores=pairScores(primary,other);
      return {other,i,scores,reason:pairReason(primary,other)};
    });
    const partDefs = [
      {key:'technical', label:'What has changed', color:'#3d997b'},
      {key:'value', label:'Worth the price', color:'#e9a044'},
      {key:'fit', label:'What matters to you', color:'#729bd8'},
      {key:'ownership', label:'Long-term use', color:'#a4a4a4'},
    ] as const;
    return `<div class="s5-pair-board">
      <div class="s5-pair-totals">${pairs.map(p=>`<article class="s5-pair-total">
        <span>Against ${safeText(p.other.name,70)}</span>
        <strong>${p.scores.total===null?'—':p.scores.total}<small>/100</small></strong>
        <span class="s5-pair-score-caption">ONOCRA comparison score</span>
      </article>`).join('')}</div>
      <div class="s5-pair-scores">
        <h3>How the two comparisons score</h3>
        <p class="s5-pair-help">Each bar shows points earned, not just a percentage weight. The four points add up to the score above.</p>
        ${partDefs.map(part=>`<div class="s5-pair-factor">
          <div class="s5-pair-factor-label">${part.label}</div>
          <div class="s5-pair-lines">${pairs.map(p=>`<div class="s5-pair-line"><small>${safeText(p.other.name,55)}</small>${scoreLine(p.scores.earned[part.key],mix[part.key],part.color)}</div>`).join('')}</div>
        </div>`).join('')}
      </div>
      <div class="s5-pair-recommendations">
        <h3>Our simple recommendation</h3>
        <div class="s5-pair-recs">${pairs.map(p=>`<article class="s5-pair-rec">
          <strong>Compared with ${safeText(p.other.name,70)}</strong>
          <p>${p.reason.sentence}</p>
          <button class="s5-pair-more" type="button" data-s5-pair-details="${p.i}" aria-expanded="false" aria-controls="s5-pair-detail-${p.i}">Why we say this <span aria-hidden="true">⌄</span></button>
          <div id="s5-pair-detail-${p.i}" class="s5-pair-detail" hidden>
            <h4>${buying?'1. What has changed (brief)':'1. What has changed (GL)'}</h4>
            <p>${p.reason.tech}</p>
            <h4>2. Is it worth the price? (VM)</h4>
            <p>${p.reason.value}</p>
            <p class="s5-pair-evidence">For deeper technical and price evidence, see the GL and VM sections immediately below.</p>
          </div>
        </article>`).join('')}</div>
      </div>
      ${pairs.some(p=>p.scores.total===null)?`<p class="s5-pair-unscored">The comparison facts and price checks above can be read now. An overall score appears only after all four scoring factors are validated for this exact pair, journey and country.</p>`:''}
    </div>`;
  };

  function currentOffers(): string {
    const links: string[]=[];
    selected.forEach((d:any)=>{
      const candidates=[...(Array.isArray(d.regionalOffers?.[state.region])?d.regionalOffers[state.region]:[]),...(Array.isArray(d.buyLinks?.[state.region])?d.buyLinks[state.region]:[]),...(Array.isArray(d.affiliateOffers?.[state.region])?d.affiliateOffers[state.region]:[])];
      candidates.forEach((o:any)=>{
        if(o?.channel === "official-msrp") return; // historical launch data is not a live buy offer
        const href = safeExternal(o?.url || o?.affiliateUrl || o?.href || o?.link);
        if(!href)return;
        const label = o?.seller || o?.retailer || o?.merchant || o?.name || 'Retailer';
        links.push(`<a href="${esc(href)}" target="_blank" rel="nofollow sponsored noopener noreferrer">${safeText(d.name,70)} · ${safeText(label,70)} ↗</a>`);
      });
    });
    return `<div class="s5-buy-options" id="s5-buy-options" hidden><h3>Where to buy in ${safeText(region.label,55)}</h3>
      ${links.length ? `<div class="s5-buy-links">${links.join("")}</div>` : `<p>We do not yet have checked shopping links for these exact phones in ${safeText(region.label,55)}. We would rather show no links than send you to a seller we have not checked.</p>`}
      <p class="s5-disclosure">Some shopping links may earn ONOCRA a commission if you buy through them. That does not change our ratings. Check the model, storage size, price and seller terms before you buy.</p></div>`;
  }

  function footer(): string {
    const models = stepUrl("models",state);
    let origin: ModeId = "generations";
    const fromQuery = new URLSearchParams(location.search).get("fromMode");
    try {
      const v = fromQuery || sessionStorage.getItem("onocra-previous-explore-mode");
      if(v === "brands" || v === "value" || v === "generations")origin = v;
    } catch { /* storage may be blocked */ }
    const buyState = {...state,mode:"match" as const,intent:"buying" as const};
    const buyHref=stepUrl(state.prio.length?"verdict":"priorities",buyState);
    const backHref=stepUrl("verdict",{...state,mode:origin,intent:"researching" as const});
    const a=(url:string,label:string,cls="")=>`<a class="s5-action ${cls}" href="${esc(url)}">${esc(label)}</a>`;
    return `<section class="s5-next"><h2>What would you like to do next?</h2>
      <p>${buying?"You can compare another phone, look at shopping choices, or go back to exploring.":"You can keep comparing phones or switch to buying advice. We will keep the phones and priorities you selected."}</p>
      <div class="s5-actions">
        ${a(models,buying?"← Compare More Phones":"← Explore More Phones")}
        ${buying?`<button type="button" class="s5-action s5-primary" data-buy-options>♧ View Buying Options</button>`:a(buyHref,"♧ Help Me Choose & Buy","s5-primary s5-switch-buy")}
        <button type="button" class="s5-action" data-share>↗ Share Verdict</button>
      </div>
      ${buying?`<div class="s5-other-mode">${a(backHref,"← Switch to Explore & Compare mode")}</div>`:""}
      ${buying?currentOffers():""}
    </section>`;
  }

  if (!model) {
    root.innerHTML = `<section class="s5-panel"><h2>No phone selected yet</h2><p>Choose a primary phone before requesting a verdict.</p><a class="s5-action" href="${esc(stepUrl("models", state))}">Select phones →</a></section>`;
  } else {
    const prev=automaticPredecessor(model);
    const topSet=prev ? (leaps.find(l=>l.to===model.id && l.from===prev.id)
      || buildAppleGLFromEvidence(prev,model)) : null;
    const chain:any[]=[];
    if(topSet){
      let cur=model.id;
      for(let i=0;i<6;i++){
        const set=leaps.find(l=>l.to===cur);if(!set)break;
        chain.push(set);cur=set.from;
      }
    }
    const hasReviewedPair=!!topSet;
    const referenceType=hasReviewedPair?'Source-linked specification comparison (not necessarily scored)':'Automatically chosen previous-generation reference';
    const counts=tally(topSet?.rows || []);
    const retailPair=prev?comparableRetailPrices(model,prev,state.region):null;
    const leapReport=hasReviewedPair
      ? buildLeapReport({model,prev,set:topSet,region:state.region})
      : provisionalGl(model,prev);
    const matrixReport=buildUpgradeMatrix({model,prev,set:topSet,region:state.region});
    const cross=selected.slice(1).filter((d:any)=>d.brand!==model.brand);
    const matrixCross=cross.length?buildCrossBrandMatrix({model,others:cross,region:state.region}):"";

    // GL and VM report scores remain available in their own detailed panels.
    const glScore=hasReviewedPair && topSet?.scoring?.validated===true ? asScore(topSet.scoring.score) : null;
    const vmScore=existingMatrixScore(matrixReport);

    const points=Object.entries(counts) as [keyof typeof counts,number][];
    const changes=points.reduce((sum,[,v])=>sum+v,0);
    const glChart=changes>0?`<div class="s5-gl-bars">${points.map(([k,v])=>`<div><b>${v}</b><div class="s5-gl-track"><i class="s5-gl-${k}" style="height:${Math.round(v/changes*100)}%"></i></div><small>${esc(k)}</small></div>`).join("")}</div>`
      : prev?`<p class="s5-quiet"><strong>${specCoverage(model,prev)} / ${comparisonSpecRows.length}</strong> recorded specifications available for comparison.<br>GL scoring pending research.</p>`
      : '<p class="s5-quiet">Immediate previous-generation reference not catalogued.</p>';
    const priceDelta=retailPair?.diff;
    const deltaDisplay=typeof priceDelta==="number" && Number.isFinite(priceDelta)
      ? `${priceDelta>=0?"+":"−"}${money(state.region,Math.abs(priceDelta))}` : null;
    const vmCrux=deltaDisplay
      ? `The difference between the recorded new-phone prices is ${deltaDisplay} in ${region.label}. What you would actually pay to change phones also depends on what you get for your old phone.`
      : `We do not have matching, checked prices for both phones in ${region.label}, so we cannot yet say whether paying more would be worthwhile.`;
    root.innerHTML = `${guide()}
      <section class="s5-panel s5-selected"><header class="s5-section-title"><span class="s5-num">2</span><h2>Your selected phones</h2><small>Primary model and up to two alternatives</small></header><div class="s5-phone-grid">${selected.map(modelCard).join("")}</div></section>
      <section class="s5-panel s5-verdict-panel" id="s5-verdict">
        <div class="s5-report-title s5-verdict-heading">
          <span class="s5-num">3</span>${icon}<h2>ONOCRA Verdict</h2>
          <span class="s5-chip">${buying?'Based on your priorities and value':'Focused on meaningful changes and value'}</span>
          <button type="button" class="s5-only-chevron" data-s5-verdict-toggle aria-expanded="false" aria-controls="s5-verdict-more" title="Show or hide the detailed comparison" aria-label="Expand ONOCRA Verdict details"><span aria-hidden="true">⌄</span></button>
        </div>
        ${pairDashboard(model,selected.slice(1))}
        <div id="s5-verdict-more" class="s5-verdict-extra" hidden>
          <p><strong>How to read this:</strong> Each comparison is rated on the four parts explained by our pelican guide. ${buying?'Your priorities and getting good value carry the most weight.':'Meaningful changes and their value carry the most weight.'} The recommendation above explains what the checked information tells us. Full GL and VM research appears below.</p>
        </div>
      </section>
      <details class="s5-panel s5-report" id="s5-gl">
        <summary><div class="s5-report-title"><span class="s5-num">4</span><h2>${selected.length>1?"What Changed (GL) &amp; Compare Your Phones":"What Changed (GL)"}</h2><span class="s5-chip">What actually changed?</span><span class="s5-chevron">⌄</span></div>
          <div class="s5-fold"><div>${scoreMark(glScore,"Change Score (GL)")}</div>
            <div class="s5-fold-text"><strong>What this means</strong><p>${prev?`Compared with ${safeText(prev.name,72)} (${referenceType}).`:"We do not yet have a suitable model from last year in our records."}</p>
            <div class="s5-crux"><b>Bottom line:</b> ${safeText(topSet?.verdict||(prev?`We compared the recorded details with ${prev.name}. We cannot yet give a fair score for how much better it is.`:"We have not yet recorded the right model from last year, so there is no GL score yet."),290)}${selected.length>1?` <span class="s5-crux-extra">Also see direct comparisons against ${selected.slice(1).map((d:any)=>safeText(d.name,50)).join(' and ')} when expanded.</span>`:''}</div></div>
            <div class="s5-fold-graphic"><strong>What our research found</strong>${glChart}<small>These counts do not tell you which phone is best.</small></div></div>
        </summary>
        <div class="s5-report-body"><p class="s5-evidence-warning">To rate how much the phone has improved, we need to check how useful each change is—not just count the changes.</p>
          <p class="s5-plain-intro">This section shows what actually changed since the previous generation. A longer list of changes does not always mean a worthwhile upgrade.</p><section class="s5-auto-reference"><h3>Your phone compared with last year’s closest model</h3>
            <p>${prev ? `Comparing <strong>${safeText(model.name,90)}</strong> with <strong>${safeText(prev.name,90)}</strong> (${safeText(referenceType)}).` : `The immediately previous generation is not in the catalogue for ${safeText(model.name,90)}.`}</p>
          </section>
          ${leapReport || '<p>Generational Leap report not catalogued yet.</p>'}
          ${chain.length?`<h3>More details about what changed</h3>${chain.map(leapDetail).join("")}`:'<p>We do not yet have a full year-to-year review of these two models.</p>'}
          ${selected.length>1?`<section class="s5-selected-direct"><h3>Compare your chosen phone with both alternatives</h3><p class="s5-pair-caption">These are the other phones you chose in Step 4. We show the differences that matter for comparing phones today; they are not changes from one year to the next.</p>${selected.slice(1).map((other:any,i:number)=>directComparison(model,other,i+1)).join('')}</section>`:''}
        </div>
      </details>
      <details class="s5-panel s5-report" id="s5-vm">
        <summary><div class="s5-report-title"><span class="s5-num">5</span><h2>Value Matrix (VM)</h2><span class="s5-chip">Is it worth the money?</span><span class="s5-chevron">⌄</span></div>
          <div class="s5-fold"><div>${scoreMark(vmScore,"Value Score (VM)")}</div>
            <div class="s5-fold-text"><strong>What this means</strong><p>${safeText(reportStats(matrixReport,".vm-status")|| (vmScore===null?"We do not have enough checked information to rate value yet":"Our price-and-benefit assessment"),160)}</p><div class="s5-crux"><b>Bottom line:</b> ${safeText(vmCrux,420)}</div></div>
            <div class="s5-fold-graphic s5-cost-graphic"><strong>What we know about prices</strong><p>${deltaDisplay?`<b>${esc(deltaDisplay)}</b><small>Difference in the recorded new-phone prices</small>`:'<small>Matching local prices are missing</small>'}</p><div class="s5-balance"><span>Cost</span><i>⚖</i><span>Benefit</span></div><small>Value is not price alone.</small></div></div>
        </summary>
        <div class="s5-report-body"><h3>Full look at what you get for the price</h3><p class="s5-plain-intro">We look at the cost, the benefits you are likely to notice and any information we still need. A higher price is not automatically better value.</p>${matrixReport}${matrixCross}
          ${selected.length>1?`<section class="s5-selected-vm"><h3>Price and value for each phone you selected</h3><p>Here are the published new-phone price comparisons when we have matching, checked regional prices. A price difference alone is not a VM score.</p>${selected.slice(1).map((other:any)=>{const entry=comparableRetailPrices(model,other,state.region);return `<article class="s5-direct-pair"><h4>${safeText(model.name,70)} versus ${safeText(other.name,70)}</h4><p>${entry?`Recorded new-phone price difference: <strong>${entry.diff>=0?'+':'−'}${money(state.region,Math.abs(entry.diff))}</strong>. This is not an owned-phone upgrade cost without a matching resale estimate.`:`We do not have comparable new-phone prices for both models in ${safeText(region.label,60)}. A fair value score remains unavailable.`}</p></article>`;}).join('')}</section>`:''}
          <h3>How we compared the prices</h3>${prev?(retailPair?`<p>Current comparable new-purchase price difference in ${safeText(region.label)}: <b>${esc(deltaDisplay)}</b> (${safeText(retailPair.b.storage||retailPair.b.config)} vs ${safeText(retailPair.a.storage||retailPair.a.config)}; checked ${safeText(retailPair.a.asOf)} and ${safeText(retailPair.b.asOf)}). This is not the owned-phone upgrade cost without verified resale evidence.</p>`:`<p>Not assessed. ${safeText(pricingCaveat,500)}</p>`):"<p>We need a suitable older model to work out a fair price difference.</p>"}
        </div>
      </details>
      ${footer()}
      <p class="s5-method-footer"><a href="/phones/reviews/methodology/">How we rate phones (being completed)</a> · Editorial policy · We show which points are proven and which are our opinion.</p>`;
    if(new URLSearchParams(location.search).get('glOpen')==='1'){
      const gl=root.querySelector<HTMLDetailsElement>('#s5-gl');
      if(gl)gl.open=true;
    }
  }

  // Preserve working deep-dive controls from the existing Step 5 modules.
  root.addEventListener("click",(event:Event)=>{
    const target=event.target as HTMLElement;
    const verdictToggle=target.closest<HTMLButtonElement>("[data-s5-verdict-toggle]");
    if(verdictToggle){
      const extra=root.querySelector<HTMLElement>("#s5-verdict-more");
      if(extra){ extra.hidden=!extra.hidden; verdictToggle.setAttribute("aria-expanded",String(!extra.hidden)); }
      return;
    }
    const detailsToggle=target.closest<HTMLButtonElement>("[data-s5-pair-details]");
    if(detailsToggle){
      const id=detailsToggle.getAttribute("data-s5-pair-details");
      const box=root.querySelector<HTMLElement>(`#s5-pair-detail-${id}`);
      if(box){box.hidden=!box.hidden;detailsToggle.setAttribute("aria-expanded",String(!box.hidden));}
      return;
    }
    const btn=target.closest<HTMLElement>("[data-lr]");
    if(btn){const open=btn.dataset.lr==="open";root.querySelectorAll<HTMLDetailsElement>(".lr-sec").forEach(d=>d.open=open);}
    const fold=target.closest<HTMLElement>("[data-fv]");
    if(fold){const open=fold.dataset.fv==="open";root.querySelectorAll<HTMLDetailsElement>(".fv-p").forEach(d=>d.open=open);}
    if(target.closest(".s5-switch-buy") && state.mode!=="match"){
      try{ if(state.mode==="generations"||state.mode==="brands"||state.mode==="value")sessionStorage.setItem("onocra-previous-explore-mode",state.mode); }catch{}
    }
    const showBuy=target.closest<HTMLButtonElement>("[data-buy-options]");
    if(showBuy){const box=root.querySelector<HTMLElement>("#s5-buy-options");if(box){box.hidden=!box.hidden;showBuy.setAttribute("aria-expanded",String(!box.hidden));if(!box.hidden)box.scrollIntoView({behavior:"smooth",block:"nearest"});}}
    const share=target.closest<HTMLButtonElement>("[data-share]");
    if(share){
      const url=location.href;
      (async()=>{
        try{
          if(navigator.share)await navigator.share({title:document.title,url});
          else {await navigator.clipboard.writeText(url);share.textContent="Link copied ✓";window.setTimeout(()=>{share.textContent="↗ Share Verdict"},1800);}
        }catch{/* user cancelled, permission denied or unavailable */}
      })();
    }
  });
  root.addEventListener("error",(event:Event)=>{
    const img = event.target;
    if (!(img instanceof HTMLImageElement) || !img.closest(".s5-phone-image"))return;
    const wrap=img.closest<HTMLElement>(".s5-phone-image");
    if (wrap) {img.remove();const note=document.createElement("span");note.textContent="Photo unavailable";wrap.appendChild(note);}
  },true);
  root.addEventListener("change",(event:Event)=>{
    const select=(event.target as HTMLElement).closest<HTMLSelectElement>("[data-vm-partner]");
    if(!select || !model)return;
    const other=byId(select.value);
    const host=root.querySelector<HTMLElement>(".vm-cross-body");
    if(other&&host)host.innerHTML=crossBody({model,other,region:state.region});
  });
</script>

<style is:global>
