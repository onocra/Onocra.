      if(key==='dimensions')return {signal:'neutral',arrow:rise?'↑':'↓',change:rise?'Heavier phone':'Lighter phone',result:'Trade-off',explanation:meaning.impact};
      if(key==='display')return {signal:'neutral',arrow:rise?'↑':'↓',change:rise?'Larger screen':'Smaller screen',result:'Preference varies',explanation:meaning.impact};
      if(key==='refresh')return {signal:'neutral',arrow:rise?'↑':'↓',change:rise?'Higher rated Hz':'Lower rated Hz',result:'Benefit depends on use',explanation:meaning.impact};
      if(key==='brightness')return {signal:'neutral',arrow:rise?'↑':'↓',change:rise?'Higher rated nits':'Lower rated nits',result:'Claimed specification',explanation:meaning.impact};
    }
