    const a=seriesKey(current),b=seriesKey(other);
    if(a&&b&&a.line===b.line&&a.number===b.number+1&&a.tier===b.tier)return 'Direct generational comparison';
    if(a&&b&&a.line===b.line&&a.number===b.number+1)return 'Previous generation · different model tier';
    return 'Same-brand technical comparison';
  };
  const glSourceRow=(primary:any,other:any,field:string):string=>{
    const old=glField(other,field),now=glField(primary,field);
    const oldText=old?safeText(old.value,340):'Not documented';
    const newText=now?safeText(now.value,340):'Not documented';
    const same=old&&now&&String(old.value).trim().toLowerCase()===String(now.value).trim().toLowerCase();
    const status= !old||!now?'Not comparable':same?'Same recorded description':'Recorded difference';
    const src=(e:any)=>e?`<a href="${esc(e.source)}" target="_blank" rel="noopener noreferrer">${esc(e.sourceType||'Source')} ↗</a>${e.checkedAt?` · checked ${safeText(e.checkedAt,20)}`:''}${e.confidence?` · stated confidence ${safeText(e.confidence,12)}`:''}`:'Source not in website research';
    return `<div class="gl6-evidence-row"><div class="gl6-evidence-top"><b>${esc(glNames[field]||field)}</b><span class="gl6-mark">${status}</span></div>
      <div class="gl6-values"><div><small>${safeText(other.name,55)}</small><p>${oldText}</p><small>${src(old)}</small></div><div><small>${safeText(primary.name,55)}</small><p>${newText}</p><small>${src(now)}</small></div></div>
      ${old&&now?glMetricBars(primary,other,field,old,now):''}</div>`;
  };
  // BP08: visual-only GL presentation refinement.
  // No scores are inferred from product specifications or coverage counts.
  // Each card retains separate summary and keyboard-accessible evidence controls.
  // BP12: coloured pictograms on bevelled 3D-style badges (pure CSS + text;
  // no additional files or icon dependencies required).
  const gl7Icons: Record<string,string> = {
    performance:'🚀',camera:'📸',battery:'🔋',display:'📱',software:'🛡️',design:'📡'
  };
  const gl8ChangeIcons:Record<string,string>={
    chipset:'⚡',ram:'🧠',storage:'💾',cpuTest:'🚀',gpuTest:'🎮',
    cameras:'📸',zoom:'🔭',cameraTest:'🖼️',videoTest:'🎥',
    battery:'🔋',charging:'⚡',enduranceTest:'⏱️',fullChargeTest:'🔌',
    display:'📱',refresh:'✨',brightness:'☀️',software:'🛡️',support:'📅',security:'🔒',
    dimensions:'📐',connectivity:'📡',ipRating:'💧',sim:'📲',network:'🌐'
  };
  const gl7ShortChange: Record<string,string> = {
    chipset:'Processor',ram:'Memory',storage:'Storage choices',cameras:'Camera features',
    battery:'Battery information',charging:'Charging options',display:'Display',
    software:'Software features',dimensions:'Size and materials',connectivity:'Connections',
    sim:'SIM options',network:'Mobile network'
  };
  const gl7FieldChange=(a:any,b:any,key:string):'different'|'same'|'missing'=>{
    const x=glField(a,key),y=glField(b,key);
    if(!x||!y)return 'missing';
    return String(x.value).trim().toLowerCase()===String(y.value).trim().toLowerCase()?'same':'different';
  };
  const gl7CategoryStatus=(primary:any,other:any,cat:any):string=>{
    const differences=cat.keys.filter((k:string)=>gl7FieldChange(other,primary,k)==='different').length;
    const sourced=cat.keys.filter((k:string)=>gl7FieldChange(other,primary,k)!=='missing').length;
    if(!sourced)return 'Research gap';
    if(!differences)return 'No difference in recorded details';
    return differences===1?'A recorded difference':`${differences} recorded differences`;
  };
  // BP10: one evidence ledger per pairing. The six GL summaries and the Index
  // read their figures from this same ledger. Published numbers require reviewed
  // item-level judgements with approved category allocations; research coverage
  // and a changed description are never treated as a score.
  type GlAssessedRow = {weight:number; earned:number; impact:string; validated:true};
  type GlCategoryRating = {validated:true; rows:Record<string,GlAssessedRow>};
  const glRatings=(primary:any,other:any):Record<string,GlCategoryRating>|null=>{
    const pair=primary?.glAssessments?.[other.id]?.[state.region];
    if(pair?.validated!==true || !pair.categories)return null;
    return pair.categories as Record<string,GlCategoryRating>;
  };
  const glCheckedScore=(primary:any,other:any,cat:any):{earned:number,max:number}|null=>{
    const category=glRatings(primary,other)?.[cat.key];
    if(category?.validated!==true || !category.rows)return null;
    const expected=cat.keys as readonly string[];
    const keys=Object.keys(category.rows);
    if(keys.length!==expected.length || !expected.every(k=>keys.includes(k)))return null;
    let earned=0,weight=0;
    for(const key of expected){
      const r=category.rows[key];
      if(r?.validated!==true || !Number.isFinite(r.earned) || !Number.isFinite(r.weight)
        || r.weight<=0 || r.earned<0 || r.earned>r.weight || !String(r.impact||'').trim())return null;
      earned+=r.earned;weight+=r.weight;
    }
    if(Math.abs(weight-cat.weight)>0.00001)return null;
    return {earned:Math.round(earned*10)/10,max:cat.weight};
  };
  const glIndexScore=(primary:any,other:any):number|null=>{
    const parts=GL6.map(c=>glCheckedScore(primary,other,c));
