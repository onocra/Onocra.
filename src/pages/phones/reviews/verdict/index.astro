  .flow .vm-who { min-width: 64px; font-size: .78rem; font-weight: 700; color: var(--f-muted); }
  .flow .vm-track { height: 9px; border-radius: 99px; background: var(--f-surface-2); overflow: hidden; }
  .flow .vm-fill { display: block; height: 100%; border-radius: 99px; }
  .flow .vm-fill--hi { background: var(--st-improved-fg); }
  .flow .vm-fill--mid { background: var(--st-unverified-fg); }
  .flow .vm-fill--lo { background: var(--st-regressed-fg); }
  .flow .vm-val { font-size: .8rem; font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
  .flow .vm-tot { margin: 14px 0 0; font-size: 1rem; }

  @media (max-width: 640px) {
    .flow .vm-score { grid-template-columns: 1fr; justify-items: center; }
    .flow .vm-score > div:last-child { width: 100%; }
    .flow .vm-head strong { font-size: 1.45rem; }
    .flow .vm-sub { margin-inline: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .flow .vm-more > summary::after, .flow .vm-sub > summary::after { transition: none; } }
</style>

<style is:global>
