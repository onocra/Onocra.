---
import FlowShell from "@/components/Reviews/FlowShell.astro";
import { PRIORITIES,readState,stepUrl } from "@/lib/reviewFlow";
const initial=readState(Astro.url.search);
---
<FlowShell step={3} title="What matters most? | ONOCRA" heading="What matters most to you?" lead="Tap your most important factor first. Choose from one to five; your tap order sets the ranking." kicker="choose 1–5">
 <p class="guide-strip">🪶 <strong>Your pelican guide:</strong> “I'll focus our comparison on your priorities. ONOCRA's independent editorial findings stay the same.”</p>
 <div class="tiles" id="priority-tiles">
  {PRIORITIES.map(p=><button class="tile" type="button" data-prio={p.id} aria-pressed={initial.prio.includes(p.id)}><span class="ico">{p.icon}</span><strong>{p.label}</strong><span class="badge" hidden></span></button>)}
 </div>
 <p id="priority-status" class="status" aria-live="polite"></p>
 <div slot="nav"><a class="btn ghost" id="priority-back" href={stepUrl("who",initial)}>← Back</a><a class="btn" id="priority-next" href={stepUrl("models",initial)}>Next →</a></div>
</FlowShell>
<script>
 import {readState,stepUrl,MAX_PRIORITIES,type PriorityId} from "@/lib/reviewFlow";
 const s=readState(location.search);let ranked=[...s.prio];
 const tiles=[...document.querySelectorAll<HTMLButtonElement>('[data-prio]')];
 const status=document.querySelector<HTMLElement>('#priority-status');const next=document.querySelector<HTMLAnchorElement>('#priority-next');const back=document.querySelector<HTMLAnchorElement>('#priority-back');
 function render(){tiles.forEach(t=>{const id=t.dataset.prio as PriorityId;const n=ranked.indexOf(id);t.setAttribute('aria-pressed',String(n>=0));t.disabled=n<0&&ranked.length>=MAX_PRIORITIES;const badge=t.querySelector<HTMLElement>('.badge');if(badge){badge.hidden=n<0;badge.textContent=n<0?'':String(n+1);}});
  if(status)status.textContent=ranked.length?`${ranked.length} of 5 selected, ranked by tap order. Tap again to remove.`:'Select at least one priority to continue.';
  if(next){next.href=stepUrl('models',{...s,prio:ranked});next.setAttribute('aria-disabled',String(!ranked.length));}
  if(back)back.href=stepUrl('who',{...s,prio:ranked});}
 tiles.forEach(t=>t.addEventListener('click',()=>{const id=t.dataset.prio as PriorityId;ranked=ranked.includes(id)?ranked.filter(x=>x!==id):ranked.length<MAX_PRIORITIES?[...ranked,id]:ranked;render();}));render();
</script>
<style>.guide-strip{background:#edf3e9;border:1px solid #cadbca;border-radius:16px;padding:14px;margin:16px 0}.tiles{grid-template-columns:repeat(4,minmax(0,1fr))}.status{color:#315841;font-size:.9rem;margin:14px 0}@media(max-width:680px){.tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>
