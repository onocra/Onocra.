---
import Layout from "@/layouts/Layout.astro";
import PhonesHeader from "@/components/Phones/Header.astro";
import PhonesFooter from "@/components/Phones/Footer.astro";

const specs = [
  { label: "Display size", values: ["6.2 inches", "6.2 inches", "6.3 inches"], status: "Improved", note: "The S26 gains a slightly larger screen. A larger diagonal alone does not prove a better display experience." },
  { label: "Battery capacity", values: ["4,000 mAh", "4,000 mAh", "4,300 mAh"], status: "Improved", note: "Capacity rises by 7.5% versus S25; measured endurance needs separate, comparable testing." },
  { label: "Rear camera arrangement", values: ["50 + 12 + 10 MP", "50 + 12 + 10 MP", "50 + 12 + 10 MP"], status: "Unchanged", note: "Headline megapixel arrangement is unchanged. Image processing and sensor details require separate verification." },
  { label: "Maximum display refresh rate", values: ["120 Hz", "120 Hz", "120 Hz"], status: "Unchanged", note: "Same headline refresh-rate specification across these generations." },
  { label: "RAM (reference configuration)", values: ["8 GB", "12 GB", "12 GB"], status: "Unchanged", note: "The S25-to-S26 reference configuration remains 12 GB. Verify country and variant before publication." },
  { label: "Base US storage", values: ["128 GB", "128 GB", "256 GB"], status: "Improved", note: "Higher starting storage in the US reference configuration; not a substitute for checking the precise model sold locally." },
  { label: "Rated wired charging", values: ["25 W", "25 W", "25 W"], status: "Unchanged", note: "Identical headline rated power does not necessarily imply identical measured charging time." },
  { label: "Regional processor performance", values: ["Region-specific", "Region-specific", "Region-specific"], status: "Unverified", note: "A fair processor comparison requires exact regional chipset variants and independent, comparable benchmarks." },
  { label: "Measured battery endurance", values: ["See independent tests", "See independent tests", "See independent tests"], status: "Unverified", note: "Do not infer real-world battery life from mAh alone. Record the laboratory method and source date." },
];
const statuses = { Improved: "improved", Unchanged: "unchanged", Regressed: "regressed", Unverified: "unverified" };
const priorities = ["Price & Value", "Battery", "Camera", "Brand & Ecosystem", "Display", "Longevity & Software Support", "Storage", "Gaming Performance"];
---
<Layout>
  <PhonesHeader />
  <main class="bp04" id="main-content">
    <div class="crumb"><a href="/phones/">Phones</a><span>›</span><a href="/phones/reviews/">Reviews</a><span>›</span>Generational Leap</div>
    <section class="hero">
      <p class="eyebrow">ONOCRA · BP-04 · GENERATIONAL INTELLIGENCE</p>
      <h1>Samsung Galaxy S26 <em>Generational Leap</em></h1>
      <p class="lead">What actually changed between the standard Galaxy S24, S25 and S26—and does it matter in everyday life?</p>
      <div class="notice"><strong>Research specimen, not a published buying verdict.</strong> The reference specifications below are drawn from our working blueprint. Source-level verification, regional variants and independent tests must be completed before publication. No scores or prices are invented.</div>
      <div class="generation-grid" aria-label="Compared generations">
        <div class="generation"><span>2024 · Previous</span><strong>Galaxy S24</strong><small>Standard model</small></div>
        <div class="generation"><span>2025 · Previous</span><strong>Galaxy S25</strong><small>Standard model</small></div>
        <div class="generation current"><span>2026 · Focus</span><strong>Galaxy S26</strong><small>Standard model</small></div>
      </div>
    </section>
    <section class="panel" aria-labelledby="summary-heading">
      <p class="eyebrow">01 · EXECUTIVE ASSESSMENT</p>
      <h2 id="summary-heading">An incremental evolution, not a complete reinvention</h2>
      <p>The working comparison indicates a larger screen, higher battery capacity and increased US base storage for the S26. Headline rear-camera resolution and wired charging remain similar. Regional processor differences and real-world battery results require properly attributed testing.</p>
      <div class="takeaways"><div><b>Where it progresses</b><p>Display size, battery capacity and base storage.</p></div><div><b>Where it holds steady</b><p>Headline rear cameras, refresh rate and rated wired charging.</p></div><div><b>What needs verification</b><p>Processor gains, measured endurance and camera output.</p></div></div>
    </section>
    <section class="panel" aria-labelledby="spec-heading">
      <p class="eyebrow">02 · SPECIFICATION INTELLIGENCE</p>
      <h2 id="spec-heading">Three generations, feature by feature</h2>
      <p class="hint">Select any feature to reveal what its specification change actually means.</p>
      <div class="table-scroll" tabindex="0" aria-label="Scrollable three-generation specification comparison"><table><thead><tr><th scope="col">Feature</th><th scope="col">Galaxy S24</th><th scope="col">Galaxy S25</th><th scope="col">Galaxy S26</th><th scope="col">S25 → S26</th></tr></thead><tbody>{specs.map((s) => <tr><th scope="row">{s.label}</th>{s.values.map(v => <td>{v}</td>)}<td><span class={`status ${statuses[s.status as keyof typeof statuses]}`}>{s.status}</span></td></tr>)}</tbody></table></div>
      <div class="details-grid">{specs.map((s) => <details><summary>{s.label}<span class={`status ${statuses[s.status as keyof typeof statuses]}`}>{s.status}</span></summary><p>{s.note}</p></details>)}</div>
    </section>
    <section class="panel" aria-labelledby="priority-heading">
      <p class="eyebrow">03 · PERSONAL RELEVANCE</p><h2 id="priority-heading">Which improvements matter to you?</h2><p>Choose up to five priorities. This specimen highlights your choices without pretending to calculate a validated match score.</p>
      <div class="priority-grid" id="priorities">{priorities.map((p, i) => <label class="priority"><input type="checkbox" value={p} /><span class="priority-index" aria-hidden="true">{i+1}</span><span>{p}</span></label>)}</div>
      <p id="priority-count" class="hint" aria-live="polite">0 of 5 selected</p>
    </section>
    <section class="panel" aria-labelledby="verdict-heading">
      <p class="eyebrow">04 · ONOCRA INTERPRETATION</p><h2 id="verdict-heading">Should you upgrade?</h2>
      <div class="verdict-grid"><article><h3>Already own the S25?</h3><p>Based on the listed headline specifications alone, the differences appear incremental. A purchase recommendation needs your priorities, device condition and verified upgrade cost.</p></article><article><h3>Still using the S24?</h3><p>There are more cumulative changes to consider. Assess battery condition, remaining software support, actual performance needs and the price of upgrading.</p></article></div>
      <div class="distinction"><div><h3>Generational Leap</h3><p>What changed technically, independent of price.</p></div><div><h3>Upgrade Value</h3><p>Whether those changes justify the verified additional cost in your country.</p></div></div>
    </section>
    <section class="panel evidence" aria-labelledby="evidence-heading"><p class="eyebrow">05 · EVIDENCE & PUBLICATION</p><h2 id="evidence-heading">How ONOCRA validates this analysis</h2><p>Before public release, every factual comparison must be linked to a manufacturer specification or attributable independent test, including date, country/variant and evidence confidence. We cite published research; we do not claim to conduct laboratory tests ourselves.</p><p><strong>Research references to verify:</strong> <a href="https://www.samsung.com/" target="_blank" rel="noopener noreferrer">Samsung</a> · <a href="https://www.gsmarena.com/" target="_blank" rel="noopener noreferrer">GSMArena</a> · <a href="https://www.tomsguide.com/" target="_blank" rel="noopener noreferrer">Tom's Guide</a>. These are research destinations, not row-level citations yet.</p><a class="back-link" href="/phones/reviews/methodology/">Read ONOCRA's methodology →</a></section>
  </main>
  <PhonesFooter />
</Layout>
<script>
  const inputs = Array.from(document.querySelectorAll<HTMLInputElement>('#priorities input[type="checkbox"]'));
  const count = document.getElementById('priority-count');
  function refresh() {
    const chosen = inputs.filter(input => input.checked);
    inputs.forEach(input => { input.disabled = !input.checked && chosen.length >= 5; input.closest('label')?.classList.toggle('selected', input.checked); });
    if (count) count.textContent = `${chosen.length} of 5 selected${chosen.length ? ' · ' + chosen.map(input => input.value).join(' · ') : ''}`;
  }
  inputs.forEach(input => input.addEventListener('change', refresh));
  refresh();
</script>
<style>
  .bp04{--forest:#234a3c;--sage:#dce9dc;--mint:#f0f6ee;--cream:#fffdf7;--orange:#c57935;color:var(--forest);background:var(--cream);max-width:1180px;margin:auto;padding:28px 22px 80px;font-family:inherit}
  .crumb{display:flex;gap:10px;align-items:center;font-size:.84rem;margin:4px 0 22px;flex-wrap:wrap}.crumb a,.back-link{color:var(--forest);text-underline-offset:3px}.hero,.panel{border:1px solid #b8ceb8;border-radius:22px;background:#fffefa;padding:clamp(22px,4vw,40px);margin-bottom:22px;box-shadow:0 2px 0 #e6eee2}.hero{background:linear-gradient(135deg,#f4f8ed,#fffdf7)}.eyebrow{font-size:.74rem;font-weight:800;letter-spacing:.13em;color:#6b846e;margin:0 0 12px}.bp04 h1,.bp04 h2,.bp04 h3{font-family:Georgia,serif;line-height:1.2;color:var(--forest)}.bp04 h1{font-size:clamp(2rem,5vw,3.7rem);margin:0 0 12px}.bp04 h1 em{display:block;font-weight:400;color:var(--orange)}.bp04 h2{font-size:clamp(1.55rem,3vw,2.15rem);margin:0 0 14px}.bp04 h3{font-size:1.18rem;margin:0 0 9px}.bp04 p{line-height:1.7}.lead{font-size:1.13rem;max-width:780px}.notice{border-left:4px solid var(--orange);padding:14px 18px;background:#fff3e6;border-radius:9px;font-size:.91rem;line-height:1.6;margin:22px 0}.generation-grid,.takeaways,.verdict-grid,.distinction{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.generation,.takeaways>div,.verdict-grid article,.distinction>div{border:1px solid #bfd1be;border-radius:14px;background:var(--mint);padding:19px}.generation span,.generation small{display:block;color:#627e6a;font-size:.8rem}.generation strong{display:block;font:700 1.4rem Georgia,serif;margin:10px 0}.generation.current{background:#d6e8d6;border:2px solid #608b67}.takeaways{margin-top:18px}.takeaways p{margin:6px 0 0;font-size:.9rem}.table-scroll{overflow-x:auto;border:1px solid #cfddca;border-radius:13px;margin:20px 0}.bp04 table{width:100%;border-collapse:collapse;min-width:760px;text-align:left}.bp04 th,.bp04 td{padding:14px;border-bottom:1px solid #e2e9df;font-size:.89rem}.bp04 thead{background:#dce9dc}.bp04 tbody tr:nth-child(even){background:#f7faf4}.bp04 tbody th{font-weight:650;position:sticky;left:0;background:#f2f7ef;min-width:160px}.status{display:inline-block;border-radius:30px;padding:5px 9px;font-size:.72rem;font-weight:750;white-space:nowrap;background:#e8eae8;color:#40554a}.status.improved{background:#d7efdb;color:#20653a}.status.unverified{background:#fff0d5;color:#885f1c}.status.regressed{background:#ffe0dc;color:#933d36}.details-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.details-grid details{border:1px solid #cadac6;border-radius:12px;background:#f8fbf5;padding:14px}.details-grid summary{cursor:pointer;font-weight:650;display:flex;justify-content:space-between;align-items:center;gap:8px}.details-grid details p{font-size:.89rem;margin:12px 0 0}.hint{font-size:.88rem;color:#64776a}.priority-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.priority{border:1px solid #b9cfb9;border-radius:12px;background:var(--mint);padding:15px;display:flex;gap:9px;align-items:center;cursor:pointer;font-size:.89rem}.priority.selected{border:2px solid #438553;background:#dcefdc}.priority:has(input:disabled){opacity:.55;cursor:not-allowed}.priority-index{color:var(--orange);font-weight:800}.priority input{accent-color:#327e47}.verdict-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.distinction{grid-template-columns:repeat(2,minmax(0,1fr));margin-top:14px}.evidence{font-size:.92rem}.back-link{display:inline-block;font-weight:700;margin-top:8px}@media(max-width:760px){.generation-grid,.takeaways{grid-template-columns:1fr}.priority-grid,.details-grid,.verdict-grid,.distinction{grid-template-columns:repeat(2,minmax(0,1fr))}.bp04{padding:16px 12px 50px}.hero,.panel{border-radius:15px;padding:19px}.generation{padding:14px}.generation strong{font-size:1.16rem}}@media(max-width:450px){.details-grid,.verdict-grid,.distinction{grid-template-columns:1fr}.priority-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<style is:global>
  /* ONOCRA BP-04 — Compact typography */

  main h1 {
    font-size: clamp(1.5rem, 2.5vw, 2.4rem) !important;
    line-height: 1.15 !important;
  }

  main h2 {
    font-size: clamp(1.15rem, 1.8vw, 1.65rem) !important;
    line-height: 1.25 !important;
  }

  main h3 {
    font-size: 1.05rem !important;
    line-height: 1.3 !important;
  }

  main p,
  main li,
  main td,
  main th,
  main label,
  main button,
  main select {
    font-size: 0.85rem !important;
    line-height: 1.5 !important;
  }

  main small {
    font-size: 0.75rem !important;
  }

  @media (max-width: 640px) {
    main h1 {
      font-size: 1.5rem !important;
    }

    main p,
    main li,
    main td,
    main th {
      font-size: 0.82rem !important;
    }
  }
</style>
