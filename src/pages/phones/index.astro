<script>

  // The question panels are server-rendered, so switching categories never
  // depends on JSON parsing or constructing new HTML in the browser.
  const quickSection = document.getElementById("quick-help");
  if (quickSection) {
    const tabs = quickSection.querySelectorAll<HTMLButtonElement>(".quick-tab");
    const groups = quickSection.querySelectorAll<HTMLElement>("[data-question-group]");
    const heading = quickSection.querySelector<HTMLElement>("#quick-category-heading");
    const count = quickSection.querySelector<HTMLElement>("#quick-results-count");
    const names: Record<string,string> = { phones: "Phone questions", tablets: "Tablet questions", wearables: "Wearables & accessories" };
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const category = tab.dataset.category || "phones";
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-pressed", String(active));
        });
        groups.forEach((group) => { group.hidden = group.dataset.questionGroup !== category; });
        const selected = quickSection.querySelector<HTMLElement>(`[data-question-group="${category}"]`);
        if (heading) heading.textContent = names[category] || "Questions";
        if (count) count.textContent = `${selected?.querySelectorAll("details").length || 0} questions`;
      });
    });
  }

  const micButton = document.querySelector("#phones-mic");
  const searchInput = document.querySelector("#phones-search");
  const imageInput = document.querySelector("#phones-image");
  const imageName = document.querySelector("#image-name");

  interface SpeechRecognitionResultEventLike {
    results: {
      [index: number]: {
        [index: number]: {
          transcript: string;
        };
      };
    };
  }

  interface SpeechRecognitionLike {
    lang: string;
    interimResults: boolean;
    maxAlternatives: number;
    start: () => void;
    onresult:
      | ((event: SpeechRecognitionResultEventLike) => void)
      | null;
  }

  interface SpeechRecognitionConstructor {
    new (): SpeechRecognitionLike;
  }

  interface SpeechRecognitionWindow extends Window {
    SpeechRecognition?: SpeechRecognitionConstructor;
    webkitSpeechRecognition?: SpeechRecognitionConstructor;
  }

  if (
    micButton instanceof HTMLButtonElement &&
    searchInput instanceof HTMLInputElement
  ) {
    micButton.addEventListener("click", () => {
      const speechWindow = window as SpeechRecognitionWindow;

      const Recognition =
        speechWindow.SpeechRecognition ??
        speechWindow.webkitSpeechRecognition;

      if (!Recognition) {
        searchInput.placeholder =
          "Voice input is not supported by this browser.";
        return;
      }

      const recognition = new Recognition();

      recognition.lang = "en-US";
      recognition.interimResults = false;
      recognition.maxAlternatives = 1;

      recognition.onresult = event => {
        const transcript = event.results[0][0].transcript;

        searchInput.value = transcript;
        searchInput.focus();
      };

      recognition.start();
    });
  }

  if (
    imageInput instanceof HTMLInputElement &&
    imageName instanceof HTMLElement
  ) {
    imageInput.addEventListener("change", () => {
      const file = imageInput.files?.[0];

      imageName.textContent = file
        ? `Selected image: ${file.name}`
        : "";
    });
  }

  // These forms require a real submission endpoint; never imply a response was received.
  const feedbackForm = document.getElementById('phones-feedback');
  feedbackForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = document.getElementById('phones-feedback-status');
    if (status) status.textContent = 'Thanks for taking the time. Online submission is not connected yet; your answers have not been sent.';
  });
  document.getElementById('phones-loop-subscribe')?.addEventListener('click', () => {
    const status = document.getElementById('phones-loop-status');
    if (status) status.textContent = 'Newsletter signup is coming soon. Your email address has not been sent or stored.';
  });

</script>

