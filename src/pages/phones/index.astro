---
import Layout from "@/layouts/Layout.astro";
import PhonesHeader from "@/components/Phones/Header.astro";
import PhonesFooter from "@/components/Phones/Footer.astro";

const quickHelp = [
  {category: 'phones', question: 'Switching from iPhone to Android—or back?', answer: 'Back up your old phone, check what transfers, and use the official Apple or Android migration tools. Move messages, photos, contacts and accounts before wiping the old device.'},
  {category: 'phones', question: 'Why is my phone battery draining so quickly?', answer: 'Check battery usage by app, recent updates, screen brightness and background activity. If the battery is swollen or unusually hot, stop using the device and seek qualified service.'},
  {category: 'phones', question: 'My phone screen is scratched. Repair or protect it?', answer: 'A shallow cosmetic scratch may only need a screen protector. Deep cracks, sharp edges or touch/display faults deserve professional inspection; compare repair costs with replacement.'},
  {category: 'phones', question: 'Seven things to do when buying a new phone', answer: 'Check software support, battery life, storage, carrier compatibility, warranty, repairability and total price. Back up your old phone and plan your account transfer before purchase.'},
  {category: 'phones', question: 'What is an IMEI, and why keep a record?', answer: 'An IMEI is a device identifier used by mobile networks. Record it privately from the phone settings or original packaging; it can help with carrier reports or proof of device details after loss or theft.'},
  {category: 'phones', question: 'Why is my phone so slow?', answer: 'Restart, check free storage, update the operating system and identify unusually demanding apps. Back up important data before considering a reset; avoid unverified cleaning apps.'},
  {category: 'phones', question: 'My phone will not charge. What should I check?', answer: 'Try a known-good compatible charger and cable, inspect the port for visible debris without inserting metal objects, and check for heat or moisture warnings. Seek service if damage is suspected.'},
  {category: 'phones', question: 'Should I repair my phone or upgrade?', answer: 'Compare repair quote, age, remaining security-update support, battery condition and replacement cost. A sound phone with ongoing updates may be worth repairing.'},
  {category: 'phones', question: 'How do I move photos and contacts safely?', answer: 'Back up photos and contacts to a trusted account or computer, verify the backup, and use the manufacturer transfer method. Check that everything arrived before deleting data from the old device.'},
  {category: 'phones', question: 'How do I protect my phone if it is lost or stolen?', answer: 'Enable a strong screen lock, device-finding features, account recovery and backups now. If lost, use official find/lock tools and contact your carrier; never share verification codes.'},
  {category: 'tablets', question: 'Which tablet should I choose for home or school?', answer: 'Match the tablet to reading, video calls, school apps, keyboard or stylus needs, storage and parental controls. Compare the complete cost including accessories.'},
  {category: 'tablets', question: 'My tablet is slow or running out of space', answer: 'Review storage usage, remove unused downloads, restart and update the device. Back up files before deleting anything important or resetting.'},
  {category: 'tablets', question: 'Why is my tablet battery draining fast?', answer: 'Check screen brightness, video streaming, battery usage and app updates. An aging battery may need service; avoid continued use if swelling is visible.'},
  {category: 'tablets', question: 'How do I set up a child-friendly tablet?', answer: 'Create an age-appropriate child profile, review app permissions, purchase restrictions, screen-time controls and content settings, then discuss family rules together.'},
  {category: 'tablets', question: 'My stylus or keyboard will not connect', answer: 'Check model compatibility, charge level, pairing instructions and software updates. Re-pair using the manufacturer instructions; some accessories work only with particular tablet generations.'},
  {category: 'wearables', question: 'My smartwatch will not pair with my phone', answer: 'Confirm phone and watch compatibility, charge both devices, update companion apps and follow the official pairing flow. Remove stale Bluetooth pairings only when the manufacturer recommends it.'},
  {category: 'wearables', question: 'Why does my smartwatch battery run down?', answer: 'Review always-on display, GPS workouts, notifications, cellular use and battery health. Compare current runtime with the maker’s guidance for your model.'},
  {category: 'wearables', question: 'How accurate are heart-rate and sleep readings?', answer: 'Wearable readings are estimates affected by fit, movement and sensors. They can help spot patterns but are not a substitute for medical assessment or emergency care.'},
  {category: 'wearables', question: 'My fitness tracker stopped counting steps', answer: 'Check fit, activity permissions, syncing and firmware updates. Confirm that the correct wrist and device settings are selected.'},
  {category: 'wearables', question: 'My earbuds will not connect or only one works', answer: 'Charge the case and both earbuds, clean contact points as instructed, check audio balance and re-pair through the official app or Bluetooth settings.'},
  {category: 'wearables', question: 'What should I check before buying a smartwatch?', answer: 'Check phone compatibility, battery life, comfort, accessibility, repair support, subscriptions and which health features are available in your country.'},
  {category: 'wearables', question: 'How do I protect my hearing with headphones?', answer: 'Keep listening volume moderate, take breaks and enable device volume warnings where available. Persistent ringing or hearing changes warrant professional advice.'},
];
---

<Layout>

  <!-- ========================================
       PHONES HUB HEADER
  ========================================= -->
  <PhonesHeader />

  <main id="main-content" class="phones-hub">
<!-- ========================================
         HERO
    ========================================= -->
    <section class="phones-hero">
      <div class="hero-copy">
        <p class="eyebrow">ONOCRA DEVICE HUB</p>

        <h1>
          Phones, Tablets<br />
          &amp; Wearables
        </h1>

        <p class="hero-subtitle">
          Phones · Tablets · Watches · Accessories
        </p>

        <p class="brand-scope">We focus on 8 trusted brands</p>
        <div class="brand-row" aria-label="Eight brands covered by ONOCRA">
          <span>Apple</span>
          <span>Samsung</span>
          <span>Google</span>
          <span>Motorola</span>
          <span>Fitbit</span>
          <span>Garmin</span>
          <span>OnePlus</span>
          <span>Xiaomi</span>
        </div>

        <p class="hero-message">
          Get help, clear advice and confident decisions for the devices
          your family uses every day.
        </p>
      </div>

      <div class="hero-art">
        <img
          src="/phonestablets.png"
          alt="Phones, tablets and wearable technology"
        />
      </div>
    </section>

    <!-- ========================================
         ASK ONOCRA
    ========================================= -->
    <section class="ask-section" aria-labelledby="ask-heading">

      <div class="ask-heading">
        <p class="eyebrow">START HERE</p>

        <h2 id="ask-heading">
          How can ONOCRA help you today?
        </h2>

        <p>
          Describe the problem, product or question. We’ll help you find
          the clearest route.
        </p>
      </div>

      <div class="ask-tools-row">
      <form
        class="ask-box"
        action="/search/"
        method="get"
        role="search"
      >
        <div class="search-field">

          <span class="search-symbol" aria-hidden="true">
            ⌕
          </span>

          <input
            id="phones-search"
            name="q"
            type="search"
            placeholder="Ask about your phone, tablet, watch or accessories..."
            aria-label="Ask ONOCRA"
          />

          <button
            class="icon-button"
            id="phones-mic"
            type="button"
            aria-label="Use microphone"
            title="Use microphone"
          >
            ♫
          </button>

          <label
            class="icon-button"
            for="phones-image"
            aria-label="Choose an image"
            title="Choose an image"
          >
            ▣
          </label>

          <input
            id="phones-image"
            class="visually-hidden"
            type="file"
            accept="image/*"
          />

          <button
            class="search-button"
            type="submit"
          >
            Search
          </button>

        </div>

        <p
          id="image-name"
          class="image-name"
          aria-live="polite"
        ></p>
      </form>
      <div class="try-row" aria-label="Try these searches"><span>Try:</span>
        {['Switching iPhone to Android', 'Phone battery draining', 'What is IMEI?', 'Best tablet for family', 'Watch not pairing'].map((term) => (
          <a class="try-chip" href={`/search/?q=${encodeURIComponent(term)}`}>{term}</a>
        ))}
      </div>
      </div>
      <details class="video-browser"><summary><span aria-hidden="true">▶</span> Browse video solutions <small>Find a short tutorial for your question</small></summary>
        <div class="video-browser-body"><p>Explore these five popular video topics. Links open YouTube searches; ONOCRA videos can replace them when published.</p>
          <div class="video-topic-row">{['Phone battery draining','Transfer to a new phone','Tablet parental controls','Pair a smartwatch','Fix Bluetooth earbuds'].map((topic) => (<a href={`https://www.youtube.com/results?search_query=${encodeURIComponent(topic + ' official tutorial')}`} target="_blank" rel="noopener noreferrer">▶ {topic} ↗</a>))}</div>
          <p class="video-help-note">Don't see your solution? No problem — <a href="#quick-help">explore Quick Help for 22 practical answers →</a></p>
        </div>
      </details>
    </section>

    <section class="mid-ad" aria-label="Advertisement"><span>ADVERTISEMENT</span></section>

    <!-- COMMIT 2: EXPLORE YOUR DEVICES -->
    <section class="device-section" aria-labelledby="device-heading">
      <div class="device-heading"><p class="eyebrow">EXPLORE YOUR DEVICES</p><h2 id="device-heading">Find help for your device</h2><p>Choose a device, then follow the route that fits your needs.</p></div>
      <div class="device-grid">
        <article class="device-card phones-card">
          <a class="device-image" href="/phones/smartphones/" aria-label="Explore Phones"><img src="/phones/phones.png" alt="Phones" loading="lazy" /></a>
          <div class="device-copy"><h3>Phones</h3><p>iPhone, Galaxy, Pixel, Motorola and more</p>
            <details class="device-dropdown"><summary>Explore services <span aria-hidden="true">⌄</span></summary><div class="device-menu">
              <a href="/phones/fix/">Fix <small>Resolve common problems</small></a>
              <a href="/phones/decode/">Decode <small>Understand features and terms</small></a>
              <a href="/phones/compare/">Compare <small>Compare models and options</small></a>
              <a href="/phones/choose/">Choose <small>Find what suits your needs</small></a>
            </div></details>
          </div>
        </article>
        <article class="device-card tablets-card">
          <a class="device-image" href="/phones/tablets/" aria-label="Explore Tablets"><img src="/phones/tablets.png" alt="Tablets" loading="lazy" /></a>
          <div class="device-copy"><h3>Tablets</h3><p>iPad, Galaxy Tab and Android tablets</p>
            <details class="device-dropdown"><summary>Explore services <span aria-hidden="true">⌄</span></summary><div class="device-menu">
              <a href="/phones/fix/">Fix <small>Resolve common problems</small></a>
              <a href="/phones/decode/">Decode <small>Understand features and terms</small></a>
              <a href="/phones/compare/">Compare <small>Compare models and options</small></a>
              <a href="/phones/choose/">Choose <small>Find what suits your needs</small></a>
            </div></details>
          </div>
        </article>
        <article class="device-card smartwatches-card">
          <a class="device-image" href="/phones/watches/" aria-label="Explore Smartwatches"><img src="/phones/smartwatches.png" alt="Smartwatches" loading="lazy" /></a>
          <div class="device-copy"><h3>Smartwatches</h3><p>Apple Watch, Galaxy Watch, Garmin and Fitbit</p>
            <details class="device-dropdown"><summary>Explore services <span aria-hidden="true">⌄</span></summary><div class="device-menu">
              <a href="/phones/fix/">Fix <small>Resolve common problems</small></a>
              <a href="/phones/decode/">Decode <small>Understand features and terms</small></a>
              <a href="/phones/compare/">Compare <small>Compare models and options</small></a>
              <a href="/phones/choose/">Choose <small>Find what suits your needs</small></a>
            </div></details>
          </div>
        </article>
        <article class="device-card wearables-card">
          <a class="device-image" href="/phones/accessories/" aria-label="Explore Wearables"><img src="/phones/wearables.png" alt="Wearables" loading="lazy" /></a>
          <div class="device-copy"><h3>Wearables</h3><p>Earbuds, headphones, chargers and cases</p>
            <details class="device-dropdown"><summary>Explore services <span aria-hidden="true">⌄</span></summary><div class="device-menu">
              <a href="/phones/fix/">Fix <small>Resolve common problems</small></a>
              <a href="/phones/decode/">Decode <small>Understand features and terms</small></a>
              <a href="/phones/compare/">Compare <small>Compare models and options</small></a>
              <a href="/phones/choose/">Choose <small>Find what suits your needs</small></a>
            </div></details>
          </div>
        </article>
      </div>
    </section>

    <!-- QUICK HELP — 22 researched household questions -->
    <section class="popular-section" aria-labelledby="popular-heading" id="quick-help" data-quick-help={JSON.stringify(quickHelp)}>
      <div class="popular-header">
        <div><p class="eyebrow">QUICK HELP · PRACTICAL ANSWERS</p><h2 id="popular-heading">What can we help you with?</h2>
        <p class="quick-intro">Everyday answers for the devices your family uses. Choose a category, then open a question.</p></div>
        <span class="quick-count">22 helpful topics</span>
      </div>
      <div class="quick-layout">
        <nav class="quick-categories" aria-label="Quick help device categories">
          <button type="button" class="quick-tab is-active" data-category="phones" aria-pressed="true"><span>Phones</span><small>10 questions</small></button>
          <button type="button" class="quick-tab" data-category="tablets" aria-pressed="false"><span>Tablets</span><small>5 questions</small></button>
          <button type="button" class="quick-tab" data-category="wearables" aria-pressed="false"><span>Wearables &amp; accessories</span><small>7 questions</small></button>
        </nav>
        <div class="quick-content">
          <div class="quick-topline"><h3 id="quick-category-heading">Phone questions</h3><span id="quick-results-count">10 questions</span></div>
          <div class="quick-questions" id="quick-questions">
            {(['phones','tablets','wearables'] as const).map((category) => (
              <div class="quick-question-group" data-question-group={category} hidden={category !== 'phones'}>
                {quickHelp.filter((item) => item.category === category).map((item) => (
                  <details class="quick-question"><summary><span>{item.question}</span><span class="quick-plus" aria-hidden="true">+</span></summary><div class="quick-answer"><p>{item.answer}</p><a href={`/search/?q=${encodeURIComponent(item.question)}`}>Explore this topic →</a></div></details>
                ))}
              </div>
            ))}
          </div>
          <p class="quick-note">Short guidance to get started. For device-specific instructions, check the manufacturer's current support guidance before changing settings.</p>
        </div>
      </div>
    </section>

    <!-- GUIDES + DIGITAL PARENTING | LATEST FROM ONOCRA -->
    <section class="editorial-section" aria-label="Guides, digital parenting and latest ONOCRA topics">
      <div class="editorial-left-stack">
        <section class="guides-panel" aria-labelledby="guides-heading">
          <div class="guides-heading">
            <div><p class="eyebrow">GUIDES · STEP BY STEP</p><h2 id="guides-heading">Helpful guides for everyday devices</h2><p>Open a guide for practical steps, then find a video demonstration when useful.</p></div>
            <img src="/phones/guides.png" alt="ONOCRA guides for phones, tablets and wearables" loading="lazy" />
          </div>
          <div class="guide-questions">
            {[
              {title:'Move from iPhone to Android safely',description:'Back up both devices, use the official transfer tools, check your photos, contacts and messages, then verify everything before resetting your old phone.',query:'official switch from iPhone to Android transfer guide'},
              {title:'Fix a phone that will not charge',description:'Check a compatible cable and adapter, inspect for moisture or visible damage, and try another outlet. Do not insert metal objects into the charging port.',query:'official phone not charging troubleshooting Apple Samsung'},
              {title:'Set up a tablet for children or family',description:'Create separate profiles where supported, enable purchase restrictions, review age-appropriate apps and privacy settings, and agree on screen-time rules.',query:'official iPad Android tablet parental controls setup'},
              {title:'Pair a smartwatch with your phone',description:'Confirm compatibility, charge both devices, install the official companion app and follow its pairing steps. Update the software if pairing fails.',query:'official Apple Watch Galaxy Watch Fitbit Garmin pairing tutorial'},
              {title:'Fix earbuds or headphones that will not connect',description:'Charge the device, check Bluetooth and audio output, remove an outdated pairing when appropriate, and follow the maker’s reset instructions.',query:'official bluetooth earbuds headphones pairing troubleshooting'}
            ].map((guide) => (
              <details class="guide-item"><summary><span>{guide.title}</span><span class="guide-plus" aria-hidden="true">+</span></summary>
                <div class="guide-detail"><p>{guide.description}</p><div class="guide-actions"><a href={`/search/?q=${encodeURIComponent(guide.title)}`}>Explore full guidance →</a><a href={`https://www.youtube.com/results?search_query=${encodeURIComponent(guide.query)}`} target="_blank" rel="noopener noreferrer">Find a video tutorial ↗</a></div></div>
              </details>
            ))}
          </div>
          <a class="guides-view-all" href="/search/?q=phone%20tablet%20wearable%20guides">View all guides →</a>
        </section>
        <section class="parenting-panel" aria-labelledby="parenting-heading">
          <div class="parenting-top-layout">
            <div class="parenting-top-copy">
              <p class="eyebrow">DIGITAL PARENTING · FAMILY FIRST</p>
              <h2 id="parenting-heading">Helping families use<br />devices safely</h2>
              <p class="parenting-intro">Simple, age-aware steps for phones, tablets and wearables used by children and teenagers.</p>
            </div>
            <img class="parenting-feature-image" src="/phones/phoneparenting.png" alt="Digital parenting and safer family device use" loading="lazy" />
          </div>
          {[
            {title:'Set up a child’s first phone',description:'Start with a family account, strong device lock, approved contacts, app permissions and a shared plan for safe use.'},
            {title:'Make a tablet suitable for younger children',description:'Choose an age-appropriate profile, restrict purchases, review content settings and test the controls together.'},
            {title:'Manage screen time without constant arguments',description:'Agree on device-free times, sleep routines and realistic limits. Review the rules as your child grows.'},
            {title:'Location sharing and smartwatch safety',description:'Check who can see location, emergency contacts, messaging permissions and the privacy trade-offs of tracking features.'},
            {title:'Spot scams, bullying and risky messages',description:'Teach children not to share passwords or codes, how to block/report unwanted contact, and when to ask a trusted adult for help.'}
          ].map((topic) => (
            <details class="guide-item"><summary><span>{topic.title}</span><span class="guide-plus" aria-hidden="true">+</span></summary><div class="guide-detail"><p>{topic.description}</p><a href={`/search/?q=${encodeURIComponent(topic.title)}`}>Explore guidance →</a></div></details>
          ))}
          <a class="guides-view-all" href="/digital-parenting/">Explore Digital Parenting →</a>
        </section>
      </div>
      <aside class="editorial-latest" aria-labelledby="editorial-latest-heading">
        <p class="eyebrow">READ · LEARN · DISCOVER</p>
        <h2 id="editorial-latest-heading">Latest from ONOCRA</h2>
        <p class="latest-intro">Phone, tablet and wearable stories, with our featured article space ready for publication.</p>
        <div class="featured-article" aria-label="Featured article reserved for publication">
          <div class="featured-visual"><span>FEATURED ARTICLE</span><span class="featured-icon" aria-hidden="true">✦</span><small>Image reserved</small></div>
          <div class="featured-copy"><span class="featured-label">COMING SOON · EDITOR'S PICK</span><h3>Our next featured device story</h3><p>This space will display the article image, title, short introduction and link once an ONOCRA story is published.</p></div>
        </div>
        <div class="latest-topic-list">
          {[
            {label:'Phones',title:'What matters most when choosing a new smartphone?',description:'Software updates, battery, storage, camera and long-term value.'},
            {label:'Tablets',title:'Choosing a tablet for family, work or study',description:'Screen size, stylus, keyboard, parental controls and total cost.'},
            {label:'Smartwatches',title:'Before buying a smartwatch: check compatibility',description:'Phone pairing, battery, comfort, subscriptions and regional features.'},
            {label:'Wearables',title:'Earbuds or over-ear headphones?',description:'Comfort, noise control, battery life and listening safety.'},
            {label:'Digital safety',title:'Protect accounts on your mobile devices',description:'Updates, strong locks, backups and recovery settings.'}
          ].map((topic) => (
            <details class="latest-topic"><summary><span><small>{topic.label}</small>{topic.title}</span><span aria-hidden="true">⌄</span></summary><div class="latest-topic-body"><p>{topic.description}</p><a href={`/search/?q=${encodeURIComponent(topic.title)}`}>Explore topic →</a></div></details>
          ))}
        </div>
        <a class="latest-view-all" href="/posts/">View published articles →</a>
      </aside>
    </section>

    <section class="mid-ad route-ad" aria-label="Advertisement"><span>ADVERTISEMENT</span></section>

    <section class="onocra-route" id="onocra-route" aria-labelledby="route-heading">
      <div class="route-heading route-heading-with-image">
        <div class="route-heading-copy">
          <p class="eyebrow">ONOCRA ROUTE · BEYOND OUR COVERED BRANDS</p>
          <h2 id="route-heading">More brands, official help<br class="route-desktop-break" /> and useful resources</h2>
          <p>Our main coverage focuses on eight brands. For other devices, follow these links to manufacturers’ own websites and support resources.</p>
        </div>
        <img class="route-heading-image" src="/phones/phoneroute.png" alt="Explore more phone, tablet and wearable brands with ONOCRA" loading="lazy" decoding="async" />
      </div>
      <div class="route-directories">
        {[
          {title:'Phones',description:'10 additional phone brands',brands:[
            {name:'HMD / Nokia',url:'https://www.hmd.com/',note:'Phones and device information'},
            {name:'Sony Xperia',url:'https://www.sony.com/',note:'Xperia phones and support'},
            {name:'Nothing',url:'https://nothing.tech/',note:'Nothing phones and accessories'},
            {name:'HONOR',url:'https://www.honor.com/',note:'Phones, software and support'},
            {name:'OPPO',url:'https://www.oppo.com/',note:'Smartphones and support'},
            {name:'vivo',url:'https://www.vivo.com/',note:'Smartphones and help'},
            {name:'realme',url:'https://www.realme.com/',note:'Phones and accessories'},
            {name:'ASUS',url:'https://www.asus.com/',note:'Zenfone and ROG Phone resources'},
            {name:'TCL',url:'https://www.tcl.com/',note:'Phones and support'},
            {name:'Fairphone',url:'https://www.fairphone.com/',note:'Repairable phones and support'}]},
          {title:'Tablets',description:'More tablet manufacturers',brands:[
            {name:'Lenovo',url:'https://www.lenovo.com/',note:'Android tablets and support'},
            {name:'Amazon Fire',url:'https://www.amazon.com/fire-tablets/',note:'Fire tablets and related information'},
            {name:'Microsoft Surface',url:'https://www.microsoft.com/surface',note:'Surface devices and support'},
            {name:'HUAWEI',url:'https://consumer.huawei.com/',note:'MatePad tablets and support'},
            {name:'HONOR',url:'https://www.honor.com/',note:'HONOR Pad models'},
            {name:'TCL',url:'https://www.tcl.com/',note:'TCL tablets'}]},
          {title:'Wearables',description:'Watches, audio and fitness technology',brands:[
            {name:'Bose',url:'https://www.bose.com/',note:'Headphones and earbuds'},
            {name:'Sony',url:'https://www.sony.com/',note:'Headphones and audio support'},
            {name:'JBL',url:'https://www.jbl.com/',note:'Wireless earbuds and headphones'},
            {name:'Jabra',url:'https://www.jabra.com/',note:'Audio products and support'},
            {name:'Polar',url:'https://www.polar.com/',note:'Sports watches and fitness devices'},
            {name:'Suunto',url:'https://www.suunto.com/',note:'Sports watches and guidance'},
            {name:'WHOOP',url:'https://www.whoop.com/',note:'Fitness wearables'},
            {name:'Oura',url:'https://ouraring.com/',note:'Smart rings and support'}]}
        ].map((group) => (
          <details class="route-category"><summary><span><strong>{group.title}</strong><small>{group.description}</small></span><span class="route-plus" aria-hidden="true">+</span></summary>
            <div class="route-brand-list">{group.brands.map((brand) => (
              <details class="route-brand"><summary><span>{brand.name}</span><span class="route-plus" aria-hidden="true">+</span></summary><div class="route-brand-body"><p>{brand.note}. Check availability and support for your country.</p><a href={brand.url} target="_blank" rel="noopener noreferrer">Visit official manufacturer website ↗</a></div></details>
            ))}</div>
          </details>
        ))}
      </div>
      <p class="route-disclaimer">External manufacturer links open in a new tab. Product ranges and support pages vary by country. ONOCRA is independent of these brands.</p>
    </section>


    <!-- ONOCRA REVIEWS: compact green editorial layout; blue evidence and methodology -->
    <section class="phones-reviews review-v8" id="reviews" aria-labelledby="phones-reviews-heading">
      <header class="rv8-intro"><span class="rv8-kicker">REVIEWS · COMPARE WITH CONFIDENCE</span><h2 id="phones-reviews-heading">Clear answers, sensible comparisons</h2><p>and independent evidence — made for everyday households.</p></header>
      <div class="rv8-main">
        <article class="rv8-left">
          <div class="rv8-left-top"><div><h3>Understand<br />before you buy</h3><p>From everyday essentials to flagship innovation, ONOCRA explains how devices perform in real life — and whether they are worth your money.</p></div><img src="/phones/phonesreviews.png" alt="ONOCRA pelican introducing device reviews" loading="lazy" /></div>
          <ul class="rv8-checks"><li>Honest, plain-language reviews</li><li>Real-world usefulness, not just specs</li><li>Side-by-side device comparisons</li><li>US and EU market guidance</li><li>Evidence from independent reviewers</li><li>Simple buying advice for every budget</li><li>Updates on new models and software</li><li>Tips for safer and smarter device use</li></ul>
        </article>
        <div class="rv8-right">
          <form id="onocra-review-find" action="/phones/reviews/" method="get" class="rv8-find">
            <h3>What would you compare?</h3><p>Select the right category, brand, budget and region to find devices for you.</p>
            <div class="rv8-fields">
              <label>1. Select product<select id="review-product" name="category"><option value="phones">Phones</option><option value="tablets">Tablets</option><option value="wearables">Wearables</option></select></label>
