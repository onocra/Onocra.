---
import Layout from "@/layouts/Layout.astro";
import PhonesHeader from "@/components/Phones/Header.astro";
import PhonesFooter from "@/components/Phones/Footer.astro";

const quickHelp = [
  {category: 'phones', question: 'Switching from iPhone to Android—or back?', answer: 'Back up your old phone, check what transfers, and use the official Apple or Android migration tools. Move messages, photos, contacts and accounts before wiping the old device.'},
  {category: 'phones', question: 'Why is my phone battery draining so quickly?', answer: 'Check battery usage by app, recent updates, screen brightness and background activity. If the battery is swollen or unusually hot, stop using the device and seek qualified service.'},
  {category: 'phones', question: 'My phone screen is scratched. Repair or protect it?', answer: 'A shallow cosmetic scratch may only need a screen protector. Deep cracks, sharp edges or touch/display faults deserve professional inspection; compare repair costs with replacement.'},
  {category: 'phones', question: 'Seven things to do when buying a new phone', answer: 'Check software support, battery life, storage, carrier compatibility, warranty, repairability and total price. Back up your old phone and plan your account transfer before purchase.'},
  {category: 'phones', question: 'What is an IMEI, and why keep a record?', answer: 'An IMEI is a device identifier used by mobile networks. Record it privately from the phone settings or original packaging; it can help with carrier reports or proof of device details after loss or theft.'},
  {category: 'phones', question: 'Why is my phone so slow?', answer: 'Restart, check free storage, update the operating system and identify unusually demanding apps. Back up important data before considering a reset; avoid unverified cleaning apps.'},
  {category: 'phones', question: 'My phone will not charge. What should I check?', answer: 'Try a known-good compatible charger and cable, inspect the port for visible debris without inserting metal objects, and check for heat or moisture warnings. Seek service if damage is suspected.'},
  {category: 'phones', question: 'Should I repair my phone or upgrade?', answer: 'Compare repair quote, age, remaining security-update support, battery condition and replacement cost. A sound phone with ongoing updates may be worth repairing.'},
  {category: 'phones', question: 'How do I move photos and contacts safely?', answer: 'Back up photos and contacts to a trusted account or computer, verify the backup, and use the manufacturer transfer method. Check that everything arrived before deleting data from the old device.'},
  {category: 'phones', question: 'How do I protect my phone if it is lost or stolen?', answer: 'Enable a strong screen lock, device-finding features, account recovery and backups now. If lost, use official find/lock tools and contact your carrier; never share verification codes.'},
  {category: 'tablets', question: 'Which tablet should I choose for home or school?', answer: 'Match the tablet to reading, video calls, school apps, keyboard or stylus needs, storage and parental controls. Compare the complete cost including accessories.'},
  {category: 'tablets', question: 'My tablet is slow or running out of space', answer: 'Review storage usage, remove unused downloads, restart and update the device. Back up files before deleting anything important or resetting.'},
  {category: 'tablets', question: 'Why is my tablet battery draining fast?', answer: 'Check screen brightness, video streaming, battery usage and app updates. An aging battery may need service; avoid continued use if swelling is visible.'},
  {category: 'tablets', question: 'How do I set up a child-friendly tablet?', answer: 'Create an age-appropriate child profile, review app permissions, purchase restrictions, screen-time controls and content settings, then discuss family rules together.'},
  {category: 'tablets', question: 'My stylus or keyboard will not connect', answer: 'Check model compatibility, charge level, pairing instructions and software updates. Re-pair using the manufacturer instructions; some accessories work only with particular tablet generations.'},
  {category: 'wearables', question: 'My smartwatch will not pair with my phone', answer: 'Confirm phone and watch compatibility, charge both devices, update companion apps and follow the official pairing flow. Remove stale Bluetooth pairings only when the manufacturer recommends it.'},
  {category: 'wearables', question: 'Why does my smartwatch battery run down?', answer: 'Review always-on display, GPS workouts, notifications, cellular use and battery health. Compare current runtime with the maker’s guidance for your model.'},
  {category: 'wearables', question: 'How accurate are heart-rate and sleep readings?', answer: 'Wearable readings are estimates affected by fit, movement and sensors. They can help spot patterns but are not a substitute for medical assessment or emergency care.'},
  {category: 'wearables', question: 'My fitness tracker stopped counting steps', answer: 'Check fit, activity permissions, syncing and firmware updates. Confirm that the correct wrist and device settings are selected.'},
  {category: 'wearables', question: 'My earbuds will not connect or only one works', answer: 'Charge the case and both earbuds, clean contact points as instructed, check audio balance and re-pair through the official app or Bluetooth settings.'},
  {category: 'wearables', question: 'What should I check before buying a smartwatch?', answer: 'Check phone compatibility, battery life, comfort, accessibility, repair support, subscriptions and which health features are available in your country.'},
  {category: 'wearables', question: 'How do I protect my hearing with headphones?', answer: 'Keep listening volume moderate, take breaks and enable device volume warnings where available. Persistent ringing or hearing changes warrant professional advice.'},
];
---

<Layout>

  <!-- ========================================
       PHONES HUB HEADER
  ========================================= -->
  <PhonesHeader />

  <main id="main-content" class="phones-hub">
<!-- ========================================
         HERO
    ========================================= -->
    <section class="phones-hero">
      <div class="hero-copy">
        <p class="eyebrow">ONOCRA DEVICE HUB</p>

        <h1>
          Phones, Tablets<br />
          &amp; Wearables
        </h1>

        <p class="hero-subtitle">
          Phones · Tablets · Watches · Accessories
        </p>

        <p class="brand-scope">We focus on 8 trusted brands</p>
        <div class="brand-row" aria-label="Eight brands covered by ONOCRA">
          <span>Apple</span>
          <span>Samsung</span>
          <span>Google</span>
          <span>Motorola</span>
          <span>Fitbit</span>
          <span>Garmin</span>
          <span>OnePlus</span>
          <span>Xiaomi</span>
        </div>

        <p class="hero-message">
          Get help, clear advice and confident decisions for the devices
          your family uses every day.
        </p>
      </div>

      <div class="hero-art">
        <img
          src="/phonestablets.png"
          alt="Phones, tablets and wearable technology"
        />
      </div>
    </section>

    <!-- ========================================
         ASK ONOCRA
    ========================================= -->
    <section class="ask-section" aria-labelledby="ask-heading">

      <div class="ask-heading">
        <p class="eyebrow">START HERE</p>

        <h2 id="ask-heading">
          How can ONOCRA help you today?
        </h2>

        <p>
          Describe the problem, product or question. We’ll help you find
          the clearest route.
        </p>
      </div>

      <div class="ask-tools-row">
      <form
        class="ask-box"
        action="/search/"
        method="get"
        role="search"
      >
        <div class="search-field">

          <span class="search-symbol" aria-hidden="true">
            ⌕
          </span>

          <input
            id="phones-search"
            name="q"
            type="search"
            placeholder="Ask about your phone, tablet, watch or accessories..."
            aria-label="Ask ONOCRA"
          />

          <button
            class="icon-button"
            id="phones-mic"
            type="button"
            aria-label="Use microphone"
            title="Use microphone"
          >
            ♫
          </button>

          <label
            class="icon-button"
            for="phones-image"
            aria-label="Choose an image"
            title="Choose an image"
          >
            ▣
          </label>

          <input
            id="phones-image"
            class="visually-hidden"
            type="file"
            accept="image/*"
          />

          <button
            class="search-button"
            type="submit"
          >
            Search
          </button>

        </div>

        <p
          id="image-name"
          class="image-name"
          aria-live="polite"
        ></p>
      </form>
      <div class="try-row" aria-label="Try these searches"><span>Try:</span>
        {['Switching iPhone to Android', 'Phone battery draining', 'What is IMEI?', 'Best tablet for family', 'Watch not pairing'].map((term) => (
          <a class="try-chip" href={`/search/?q=${encodeURIComponent(term)}`}>{term}</a>
        ))}
