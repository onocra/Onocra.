---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <main id="main-content" class="phones-hub">

    <!-- =========================================
         ADVERTISEMENT SPACE 1
    ========================================== -->
    <section class="top-ad" aria-label="Advertisement">
      <span>ADVERTISEMENT</span>
    </section>

    <!-- =========================================
         HERO
    ========================================== -->
    <section class="phones-hero">
      <div class="hero-copy">
        <p class="eyebrow">ONOCRA DEVICE HUB</p>

        <h1>
          Phones, Tablets<br />
          &amp; Wearables
        </h1>

        <p class="hero-subtitle">
          Phones · Tablets · Watches · Accessories
        </p>

        <div class="brand-row" aria-label="Brands covered">
          <span>Apple</span>
          <span>Samsung</span>
          <span>Google</span>
          <span>Motorola</span>
          <span>Fitbit</span>
          <span>Garmin</span>
          <span>OnePlus</span>
          <span>Xiaomi</span>
        </div>

        <p class="hero-message">
          Get help, clear advice and confident decisions for the devices
          your family uses every day.
        </p>
      </div>

      <div class="hero-art">
        <img
          src="/phonestablets.png"
          alt="Phones, tablets and wearable technology"
        />
      </div>
    </section>

    <!-- =========================================
         DEVICE CATEGORIES
    ========================================== -->
    <section class="device-section" aria-labelledby="device-heading">
      <h2 id="device-heading">Explore your devices</h2>

      <div class="device-grid">

        <a class="device-card phones-card" href="/phones/smartphones/">
          <div class="device-image">
            <img src="/mobiles.png" alt="" />
          </div>

          <div class="device-copy">
            <h3>Phones</h3>
            <p>iPhone, Galaxy, Pixel, Motorola &amp; more</p>
            <span>Explore Phones →</span>
          </div>
        </a>

        <a class="device-card tablets-card" href="/phones/tablets/">
          <div class="device-image">
            <img src="/tablets.png" alt="" />
          </div>

          <div class="device-copy">
            <h3>Tablets</h3>
            <p>iPad, Galaxy Tab, Android tablets &amp; more</p>
            <span>Explore Tablets →</span>
          </div>
        </a>

        <a class="device-card watches-card" href="/phones/watches/">
          <div class="device-image">
            <img src="/watches.png" alt="" />
          </div>

          <div class="device-copy">
            <h3>Smartwatches</h3>
            <p>Apple Watch, Galaxy Watch, Garmin &amp; Fitbit</p>
            <span>Explore Watches →</span>
          </div>
        </a>

        <a class="device-card accessories-card" href="/phones/accessories/">
          <div class="device-image">
            <img src="/wearables.png" alt="" />
          </div>

          <div class="device-copy">
            <h3>Accessories</h3>
            <p>Earbuds, chargers, cases, trackers &amp; more</p>
            <span>Explore Accessories →</span>
          </div>
        </a>

      </div>
    </section>

    <!-- =========================================
         ASK ONOCRA
    ========================================== -->
    <section class="ask-section" aria-labelledby="ask-heading">

      <div class="ask-heading">
        <p class="eyebrow">START HERE</p>

        <h2 id="ask-heading">
          How can ONOCRA help you today?
        </h2>

        <p>
          Describe the problem, product or question. We’ll help you find
          the clearest route.
        </p>
      </div>

      <form
        class="ask-box"
        action="/search/"
        method="get"
        role="search"
      >
        <div class="search-field">

          <span class="search-symbol" aria-hidden="true">
            ⌕
          </span>

          <input
            id="phones-search"
            name="q"
            type="search"
            placeholder="Ask about your phone, tablet, watch or accessories..."
            aria-label="Ask ONOCRA"
          />

          <button
            class="icon-button"
            id="phones-mic"
            type="button"
            aria-label="Use microphone"
            title="Use microphone"
          >
            ♫
          </button>

          <label
            class="icon-button"
            for="phones-image"
            aria-label="Choose an image"
            title="Choose an image"
          >
            ▣
          </label>

          <input
            id="phones-image"
            class="visually-hidden"
            type="file"
            accept="image/*"
          />

          <button
            class="search-button"
            type="submit"
          >
            Search
          </button>

        </div>

        <p
          id="image-name"
          class="image-name"
          aria-live="polite"
        ></p>

      </form>
    </section>

    <!-- =========================================
         POPULAR AT ONOCRA
    ========================================== -->
    <section
      class="popular-section"
      aria-labelledby="popular-heading"
    >
      <div class="popular-header">

        <div class="popular-title">
          <span class="popular-fire" aria-hidden="true">
            🔥
          </span>

          <div>
            <p class="eyebrow">QUICK HELP</p>
            <h2 id="popular-heading">
              Popular at ONOCRA
            </h2>
          </div>
        </div>

        <a
          href="/search/"
          class="popular-view-all"
        >
          View all →
        </a>

      </div>

      <div class="popular-grid">

        <a
          class="popular-card popular-blue"
          href="/search/?q=iPhone%20won%27t%20connect%20to%20Wi-Fi"
        >
          <span class="popular-number">01</span>

          <div>
            <h3>iPhone won’t connect to Wi-Fi</h3>
            <p>
              Try the safest and simplest fixes first.
            </p>
          </div>

          <span class="popular-arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a
          class="popular-card popular-green"
          href="/search/?q=Should%20I%20upgrade%20my%20phone"
        >
          <span class="popular-number">02</span>

          <div>
            <h3>Should I upgrade my phone?</h3>
            <p>
              See whether upgrading really makes sense for you.
            </p>
          </div>

          <span class="popular-arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a
          class="popular-card popular-orange"
          href="/search/?q=Best%20tablets%20for%20students"
        >
          <span class="popular-number">03</span>

          <div>
            <h3>Best tablets for students</h3>
            <p>
              Compare practical choices for study and everyday use.
            </p>
          </div>

          <span class="popular-arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a
          class="popular-card popular-sage"
          href="/search/?q=How%20to%20set%20up%20a%20first%20phone"
        >
          <span class="popular-number">04</span>

          <div>
            <h3>How to set up a first phone</h3>
            <p>
              A simple starting point for families and first-time users.
            </p>
          </div>

          <span class="popular-arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a
          class="popular-card popular-red"
          href="/search/?q=Is%20this%20a%20scam%20text"
        >
          <span class="popular-number">05</span>

          <div>
            <h3>Is this a scam text?</h3>
            <p>
              Know what to check before you tap, reply or pay.
            </p>
          </div>

          <span class="popular-arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a
          class="popular-card popular-purple"
          href="/search/?q=How%20do%20I%20apply%20parental%20controls"
        >
          <span class="popular-number">06</span>

          <div>
            <h3>How do I apply parental controls?</h3>
            <p>
              Find the right controls for your child’s device.
            </p>
          </div>

          <span class="popular-arrow" aria-hidden="true">
            →
          </span>
        </a>

      </div>
    </section>

  </main>
</Layout>

<script>
  const micButton = document.querySelector("#phones-mic");
  const searchInput = document.querySelector("#phones-search");
  const imageInput = document.querySelector("#phones-image");
  const imageName = document.querySelector("#image-name");

  interface SpeechRecognitionResultEventLike {
    results: {
      [index: number]: {
        [index: number]: {
          transcript: string;
        };
      };
    };
  }

  interface SpeechRecognitionLike {
    lang: string;
    interimResults: boolean;
    maxAlternatives: number;
    start: () => void;
    onresult:
      | ((event: SpeechRecognitionResultEventLike) => void)
      | null;
  }

  interface SpeechRecognitionConstructor {
    new (): SpeechRecognitionLike;
  }

  interface SpeechRecognitionWindow extends Window {
    SpeechRecognition?: SpeechRecognitionConstructor;
    webkitSpeechRecognition?: SpeechRecognitionConstructor;
  }

  if (
    micButton instanceof HTMLButtonElement &&
    searchInput instanceof HTMLInputElement
  ) {
    micButton.addEventListener("click", () => {
      const speechWindow = window as SpeechRecognitionWindow;

      const Recognition =
        speechWindow.SpeechRecognition ??
        speechWindow.webkitSpeechRecognition;

      if (!Recognition) {
        searchInput.placeholder =
          "Voice input is not supported by this browser.";
        return;
      }

      const recognition = new Recognition();

      recognition.lang = "en-US";
      recognition.interimResults = false;
      recognition.maxAlternatives = 1;

      recognition.onresult = event => {
        const transcript =
          event.results[0][0].transcript;

        searchInput.value = transcript;
        searchInput.focus();
      };

      recognition.start();
    });
  }

  if (
    imageInput instanceof HTMLInputElement &&
    imageName instanceof HTMLElement
  ) {
    imageInput.addEventListener("change", () => {
      const file = imageInput.files?.[0];

      imageName.textContent = file
        ? `Selected image: ${file.name}`
        : "";
    });
  }
</script>

<style>
  .phones-hub {
    --hub-forest: #073d32;
    --hub-green: #14624d;
    --hub-orange: #f56622;
    --hub-blue: #1269b0;
    --hub-ink: #17334a;
    --hub-cream: #f8eedc;
    --hub-sage: #e6efe5;

    width: min(100% - 32px, 1240px);
    margin: 0 auto;
    padding: 20px 0 72px;
    color: var(--hub-ink);
  }

  /* =========================================
     ADVERTISEMENT SPACE 1
  ========================================== */

  .top-ad {
    min-height: 104px;
    margin-bottom: 24px;

    border: 1px dashed #c9c1b4;
    border-radius: 18px;

    background:
      radial-gradient(
        circle at 15% 30%,
        rgba(18, 105, 176, 0.06),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #fbf3e6,
        #f7eddd
      );

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .top-ad span {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #7c817f;
  }

  /* =========================================
     HERO
  ========================================== */

  .phones-hero {
    min-height: 410px;
    padding: 42px 48px;

    border: 1px solid rgba(7, 61, 50, 0.12);
    border-radius: 28px;

    background:
      radial-gradient(
        circle at 85% 18%,
        rgba(18, 105, 176, 0.1),
        transparent 30%
      ),
      radial-gradient(
        circle at 8% 90%,
        rgba(245, 102, 34, 0.07),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #fffaf1 0%,
        #f8efdf 100%
      );

    display: grid;

    grid-template-columns:
      minmax(0, 1.02fr)
      minmax(390px, 0.98fr);

    align-items: center;
    gap: 24px;

    overflow: hidden;
  }

  .eyebrow {
    margin: 0 0 9px;

    color: var(--hub-orange);

    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .hero-copy h1 {
    max-width: 660px;
    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(46px, 5vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.045em;

    color: var(--hub-forest);
  }

  .hero-subtitle {
    margin: 17px 0 18px;

    font-size: 17px;
    font-weight: 700;

    color: var(--hub-green);
  }

  .brand-row {
    display: flex;
    flex-wrap: wrap;

    gap: 7px;

    max-width: 620px;
    margin-bottom: 20px;
  }

  .brand-row span {
    padding: 6px 10px;

    border:
      1px solid
      rgba(7, 61, 50, 0.13);

    border-radius: 999px;

    background:
      rgba(255, 255, 255, 0.68);

    font-size: 11px;
    font-weight: 700;

    color: #4c5c5b;
  }

  .hero-message {
    max-width: 600px;
    margin: 0;

    font-size: 17px;
    line-height: 1.55;

    color: #455e66;
  }

  .hero-art {
    min-width: 0;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-art img {
    display: block;

    width: 100%;
    max-width: 570px;
    max-height: 355px;

    object-fit: contain;
  }

  /* =========================================
     DEVICE CATEGORIES
  ========================================== */

  .device-section {
    padding: 48px 0 44px;
  }

  .device-section > h2 {
    margin: 0 0 20px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 31px;
    line-height: 1.1;

    color: var(--hub-forest);
  }

  .device-grid {
    display: grid;

    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 16px;
  }

  .device-card {
    min-width: 0;
    min-height: 310px;

    padding: 18px 18px 20px;

    border:
      1px solid
      rgba(7, 61, 50, 0.11);

    border-radius: 22px;

    text-decoration: none;
    color: var(--hub-ink);

    display: flex;
    flex-direction: column;

    overflow: hidden;

    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .device-card:hover {
    transform: translateY(-3px);

    box-shadow:
      0 14px 32px
      rgba(23, 51, 74, 0.1);
  }

  .phones-card {
    background: #e7f1f7;
  }

  .tablets-card {
    background: #fbe8da;
  }

  .watches-card {
    background: #e6efe5;
  }

  .accessories-card {
    background: #eee9f5;
  }

  .device-image {
    height: 172px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .device-image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;
  }

  .device-copy {
    margin-top: auto;
  }

  .device-copy h3 {
    margin: 12px 0 5px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 25px;

    color: var(--hub-forest);
  }

  .device-copy p {
    min-height: 42px;

    margin: 0 0 12px;

    font-size: 13px;
    line-height: 1.45;

    color: #53666a;
  }

  .device-copy span {
    font-size: 13px;
    font-weight: 800;

    color: var(--hub-green);
  }

  /* =========================================
     ASK ONOCRA
  ========================================== */

  .ask-section {
    padding: 34px 38px 38px;

    border:
      1px solid
      rgba(7, 61, 50, 0.12);

    border-radius: 26px;

    background:
      radial-gradient(
        circle at 90% 10%,
        rgba(20, 98, 77, 0.09),
        transparent 27%
      ),
      #fffaf2;
  }

  .ask-heading {
    text-align: center;
  }

  .ask-heading h2 {
    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(30px, 3vw, 43px);

    line-height: 1.1;

    color: var(--hub-forest);
  }

  .ask-heading > p:last-child {
    max-width: 650px;

    margin:
      10px auto
      24px;

    font-size: 15px;
    line-height: 1.55;

    color: #617075;
  }

  .ask-box {
    max-width: 920px;
    margin: 0 auto;
  }

  .search-field {
    min-height: 62px;

    padding:
      7px
      8px
      7px
      17px;

    border:
      1px solid
      rgba(7, 61, 50, 0.22);

    border-radius: 18px;

    background: #ffffff;

    display: flex;
    align-items: center;

    gap: 8px;

    box-shadow:
      0 8px 26px
      rgba(23, 51, 74, 0.07);
  }

  .search-symbol {
    flex: 0 0 auto;

    font-size: 25px;

    color: #73817f;
  }

  .search-field input[type="search"] {
    min-width: 0;
    flex: 1;

    border: 0;
    outline: 0;

    background: transparent;

    font: inherit;
    font-size: 15px;

    color: var(--hub-ink);
  }

  .search-field
    input[type="search"]::placeholder {
    color: #8a9696;
  }

  .icon-button {
    width: 39px;
    height: 39px;

    flex: 0 0 39px;

    padding: 0;

    border: 0;
    border-radius: 10px;

    background: transparent;

    color: var(--hub-green);

    font-size: 20px;

    cursor: pointer;

    display: grid;
    place-items: center;
  }

  .icon-button:hover {
    background: var(--hub-sage);
  }

  .search-button {
    height: 46px;

    padding: 0 25px;

    border: 0;
    border-radius: 12px;

    background: var(--hub-green);

    color: #ffffff;

    font-size: 14px;
    font-weight: 800;

    cursor: pointer;
  }

  .search-button:hover {
    background: var(--hub-forest);
  }

  .image-name {
    min-height: 18px;

    margin:
      7px
      5px
      0;

    font-size: 12px;

    color: #617075;
  }

  .visually-hidden {
    position: absolute !important;

    width: 1px !important;
    height: 1px !important;

    padding: 0 !important;
    margin: -1px !important;

    overflow: hidden !important;

    clip:
      rect(0, 0, 0, 0) !important;

    white-space: nowrap !important;

    border: 0 !important;
  }

  /* =========================================
     POPULAR AT ONOCRA
  ========================================== */

  .popular-section {
    padding: 46px 0 48px;
  }

  .popular-header {
    margin-bottom: 20px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 20px;
  }

  .popular-title {
    display: flex;
    align-items: center;

    gap: 13px;
  }

  .popular-title .eyebrow {
    margin-bottom: 4px;
  }

  .popular-fire {
    width: 48px;
    height: 48px;

    flex: 0 0 48px;

    border-radius: 50%;

    background: #fbe8da;

    display: grid;
    place-items: center;

    font-size: 24px;
  }

  .popular-header h2 {
    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 31px;
    line-height: 1.1;

    color: var(--hub-forest);
  }

  .popular-view-all {
    flex: 0 0 auto;

    padding-bottom: 3px;

    color: var(--hub-green);

    font-size: 13px;
    font-weight: 800;

    text-decoration: none;
  }

  .popular-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 14px;
  }

  .popular-card {
    position: relative;

    min-height: 142px;

    padding:
      20px
      50px
      20px
      20px;

    border:
      1px solid
      rgba(7, 61, 50, 0.1);

    border-radius: 20px;

    color: var(--hub-ink);
    text-decoration: none;

    display: flex;
    align-items: flex-start;

    gap: 13px;

    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .popular-card:hover {
    transform: translateY(-3px);

    box-shadow:
      0 12px 28px
      rgba(23, 51, 74, 0.09);
  }

  .popular-number {
    flex: 0 0 auto;

    margin-top: 2px;

    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.08em;

    color: var(--hub-green);
  }

  .popular-card h3 {
    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 19px;
    line-height: 1.2;

    color: var(--hub-forest);
  }

  .popular-card p {
    margin: 8px 0 0;

    font-size: 12px;
    line-height: 1.45;

    color: #5d6d70;
  }

  .popular-arrow {
    position: absolute;

    right: 18px;
    bottom: 17px;

    font-size: 20px;
    font-weight: 700;

    color: var(--hub-green);
  }

  .popular-blue {
    background: #e7f1f7;
  }

  .popular-green {
    background: #e6efe5;
  }

  .popular-orange {
    background: #fbe8da;
  }

  .popular-sage {
    background: #edf3e8;
  }

  .popular-red {
    background: #f6e7e4;
  }

  .popular-purple {
    background: #eee9f5;
  }

  /* =========================================
     TABLET
  ========================================== */

  @media (max-width: 1050px) {
    .phones-hero {
      grid-template-columns:
        minmax(0, 1fr)
        minmax(300px, 0.85fr);

      padding: 38px 34px;
    }

    .device-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .popular-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  /* =========================================
     MOBILE
  ========================================== */

  @media (max-width: 720px) {
    .phones-hub {
      width:
        min(100% - 22px, 1240px);

      padding-top: 12px;
    }

    .top-ad {
      min-height: 70px;
      margin-bottom: 14px;
      border-radius: 14px;
    }

    .phones-hero {
      min-height: 0;

      padding:
        28px
        21px
        20px;

      border-radius: 22px;

      grid-template-columns: 1fr;

      gap: 16px;
    }

    .hero-copy h1 {
      font-size:
        clamp(40px, 13vw, 56px);
    }

    .hero-subtitle {
      font-size: 14px;
    }

    .hero-message {
      font-size: 15px;
    }

    .hero-art img {
      max-height: 280px;
    }

    .device-section {
      padding: 36px 0;
    }

    .device-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 10px;
    }

    .device-card {
      min-height: 255px;

      padding: 12px;

      border-radius: 17px;
    }

    .device-image {
      height: 125px;
    }

    .device-copy h3 {
      font-size: 20px;
    }

