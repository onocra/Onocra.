---
// ONOCRA Phones Hub — Useful Now section.
// Mount using: import UsefulNow from '@/components/UsefulNow.astro';
// and <UsefulNow /> in src/pages/phones/index.astro.
const socials = [
  { label: 'YouTube', image: '/homepage/youtube.png', url: 'https://www.youtube.com/' },
  { label: 'TikTok', image: '/homepage/tiktok.png', url: 'https://www.tiktok.com/' },
  { label: 'Instagram', image: '/homepage/instragram.png', url: 'https://www.instagram.com/' },
  { label: 'Facebook', image: '/homepage/facebook.png', url: 'https://www.facebook.com/' },
  { label: 'X', image: '/homepage/x.png', url: 'https://x.com/' },
  { label: 'Pinterest', image: '/homepage/pinterest.png', url: 'https://www.pinterest.com/' },
];
const questions = [
  'Did you find the advice you needed?',
  'Were the instructions easy to understand?',
  'Did the comparisons help you evaluate your options?',
  'Would you recommend ONOCRA to someone in your household?',
];
---
<section class="useful-wrap" id="useful-now" aria-labelledby="useful-title">
  <div class="useful-grid">
    <div class="feedback-column">
      <div class="eyebrow">YOUR VOICE MATTERS</div>
      <h2 id="useful-title">Useful Now?</h2>
      <p class="intro">Tell us how helpful you found ONOCRA. Your feedback helps us improve.</p>
      <div class="feedback-body">
        <img class="pelican" src="/phones/useful-pelican.png" alt="ONOCRA pelican giving a friendly thumbs-up" loading="lazy" />
        <form class="feedback-form" id="onocra-feedback">
          {questions.map((question, i) => (
            <details class="qa">
              <summary><span>{question}</span><span class="toggle" aria-hidden="true"></span></summary>
              <fieldset>
                <legend class="sr-only">{question}</legend>
                <label><input type="radio" name={`answer-${i + 1}`} value="Yes" /> Yes</label>
                <label><input type="radio" name={`answer-${i + 1}`} value="No" /> No</label>
              </fieldset>
            </details>
          ))}
          <details class="qa">
            <summary><span>Any other feedback you'd like to share?</span><span class="toggle" aria-hidden="true"></span></summary>
            <label class="comment-label" for="onocra-comment">Your comments</label>
            <textarea id="onocra-comment" name="comment" rows="3" placeholder="Tell us what worked or what we could improve..."></textarea>
          </details>
          <button type="submit" class="submit">Submit my feedback <span aria-hidden="true">→</span></button>
          <p class="form-status" id="onocra-feedback-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
    <aside class="loop-column" aria-labelledby="loop-title">
      <div class="eyebrow">STAY IN THE LOOP</div>
      <h2 id="loop-title">Useful technology, without the noise.</h2>
      <p>Follow ONOCRA for practical household tech tips, latest updates and smarter digital decisions.</p>
      <div class="subscribe-row">
        <label for="loop-email" class="sr-only">Your email address</label>
        <input id="loop-email" type="email" autocomplete="email" placeholder="Your email address" />
        <button type="button" id="loop-subscribe">Subscribe <span aria-hidden="true">→</span></button>
      </div>
      <p id="loop-status" class="form-status" role="status" aria-live="polite"></p>
      <div class="follow-label">FOLLOW ONOCRA</div>
      <nav class="social-grid" aria-label="ONOCRA social media">
        {socials.map(s => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${s.label}`} title={s.label}>
            <img src={s.image} alt="" loading="lazy" /><span>{s.label}</span>
          </a>
        ))}
      </nav>
    </aside>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('#onocra-feedback');
  const feedbackStatus = document.querySelector<HTMLElement>('#onocra-feedback-status');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (feedbackStatus) feedbackStatus.textContent = 'Feedback submission is not connected yet. Please connect a secure form endpoint before publishing this button as active.';
  });
  document.querySelector('#loop-subscribe')?.addEventListener('click', () => {
    const status = document.querySelector<HTMLElement>('#loop-status');
    if (status) status.textContent = 'Newsletter signup is coming soon.';
  });
</script>
<style>
  .useful-wrap{--forest:#245d4b;--ink:#173e37;--line:#d9e7dd;--cream:#fbfaf2;color:var(--ink);background:linear-gradient(135deg,#f7fbf6,#fffdf5);border:1px solid var(--line);border-radius:24px;padding:clamp(20px,3vw,42px);margin-block:18px}
  .useful-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(22px,3vw,44px);align-items:stretch}
  .feedback-column,.loop-column{min-width:0}.loop-column{border-left:1px solid var(--line);padding-left:clamp(22px,3vw,44px);display:flex;flex-direction:column;justify-content:center}
  .eyebrow{font-size:.74rem;font-weight:800;letter-spacing:.15em;color:#ae6a45;text-transform:uppercase;width:max-content;padding-bottom:8px;border-bottom:3px solid #39856c;margin-bottom:12px}
  h2{font-family:Georgia,serif;font-size:clamp(1.7rem,2.4vw,2.65rem);line-height:1.14;margin:0 0 12px;color:var(--ink)}.intro,.loop-column>p{font-size:1rem;line-height:1.6;color:#52695f;margin:0 0 24px}
  .feedback-body{display:grid;grid-template-columns:minmax(130px,.36fr) minmax(0,.64fr);align-items:center;gap:12px}.pelican{width:100%;height:auto;max-height:390px;object-fit:contain;align-self:center;filter:drop-shadow(0 8px 10px #143b2d16)}
  .feedback-form{min-width:0}.qa{border-bottom:1px solid var(--line)}.qa:first-child{border-top:1px solid var(--line)}.qa summary{list-style:none;cursor:pointer;padding:13px 4px;display:flex;align-items:center;justify-content:space-between;gap:14px;font-weight:650;font-size:.92rem}.qa summary::-webkit-details-marker{display:none}.toggle::after{content:'+';font-size:1.5rem;font-weight:300}.qa[open] .toggle::after{content:'−'}.qa fieldset{border:0;margin:0;padding:0 4px 15px;display:flex;gap:18px}.qa fieldset label{display:flex;align-items:center;gap:6px;cursor:pointer;font-size:.9rem}.qa input[type=radio]{accent-color:var(--forest)}.comment-label{display:block;font-size:.83rem;margin:0 4px 8px}.qa textarea{box-sizing:border-box;width:100%;border:1px solid #b7cdc1;border-radius:9px;padding:11px;font:inherit;background:white;color:#173e37;resize:vertical}
  .submit,.subscribe-row button{border:0;background:var(--forest);color:white;font:inherit;font-weight:700;border-radius:10px;padding:12px 17px;cursor:pointer}.submit{margin-top:18px;width:100%;display:flex;justify-content:space-between;align-items:center}.submit:hover,.subscribe-row button:hover{background:#174c3d}.form-status{font-size:.79rem;color:#6d5140;line-height:1.4;margin:9px 0 0}
  .subscribe-row{display:flex;gap:8px;margin:4px 0 16px}.subscribe-row input{min-width:0;flex:1;border:1px solid #c6d8ce;background:#fff;color:#173e37;border-radius:10px;padding:12px;font:inherit}.follow-label{font-size:.77rem;letter-spacing:.13em;font-weight:800;margin:20px 0 14px;color:var(--forest)}
  .social-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.social-grid a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:92px;border:1px solid #d8e6dd;border-radius:14px;background:#ffffffc9;text-decoration:none;color:#274d43;font-weight:650;font-size:.83rem;transition:transform .15s,border-color .15s}.social-grid a:hover{transform:translateY(-2px);border-color:#448a70}.social-grid img{width:43px;height:43px;object-fit:contain}
  :global(.dark) .useful-wrap,:global([data-theme='dark']) .useful-wrap{--ink:#e5f5ec;--line:#36534a;background:linear-gradient(135deg,#142b27,#1b342e)}
  :global(.dark) .intro,:global(.dark) .loop-column>p,:global([data-theme='dark']) .intro,:global([data-theme='dark']) .loop-column>p{color:#c5d7ce}
  :global(.dark) .social-grid a,:global([data-theme='dark']) .social-grid a{background:#28463b;color:#eff8f1;border-color:#426053}
  @media(max-width:1000px){.useful-grid{grid-template-columns:1fr}.loop-column{border-left:0;border-top:1px solid var(--line);padding:26px 0 0}.social-grid{grid-template-columns:repeat(6,minmax(0,1fr))}}
  @media(max-width:650px){.feedback-body{grid-template-columns:1fr}.pelican{max-width:240px;max-height:220px;margin:auto}.social-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.subscribe-row{flex-wrap:wrap}.subscribe-row input{flex-basis:100%}}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
