  }

  .tablets-card {
    background: #fbe8da;
  }

  .watches-card {
    background: #e6efe5;
  }

  .accessories-card {
    background: #eee9f5;
  }

  .device-image {
    height: 172px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .device-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .device-copy {
    margin-top: auto;
  }

  .device-copy h3 {
    margin: 12px 0 5px;
    font-family:
      Georgia,
      "Times New Roman",
      serif;
    font-size: 25px;
    color: var(--hub-forest);
  }

  .device-copy p {
    min-height: 42px;
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.45;
    color: #53666a;
  }

  .device-copy span {
    font-size: 13px;
    font-weight: 800;
    color: var(--hub-green);
  }

  /* ASK ONOCRA */

  .ask-section {
    padding: 34px 38px 38px;
    border: 1px solid rgba(7, 61, 50, 0.12);
    border-radius: 26px;

    background:
      radial-gradient(
        circle at 90% 10%,
