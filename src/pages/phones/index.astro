      linear-gradient(
        135deg,
        #fffaf1 0%,
        #f8efdf 100%
      );

    display: grid;
    grid-template-columns:
      minmax(0, 1.02fr)
      minmax(390px, 0.98fr);

    align-items: center;
    gap: 24px;
    overflow: hidden;
  }

  .eyebrow {
    margin: 0 0 9px;
    color: var(--hub-orange);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .hero-copy h1 {
    max-width: 660px;
    margin: 0;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: clamp(46px, 5vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--hub-forest);
  }

  .hero-subtitle {
    margin: 17px 0 18px;
    font-size: 17px;
    font-weight: 700;
    color: var(--hub-green);
  }

  .brand-row {
