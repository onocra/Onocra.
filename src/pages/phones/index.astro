<script>
  const product = document.querySelector<HTMLSelectElement>('#review-product');
  const brand = document.querySelector<HTMLSelectElement>('#review-brand');
  const budgetCategory = document.querySelector<HTMLSelectElement>('#review-budget-category');
  const tier = document.querySelector<HTMLSelectElement>('#review-tier');
  const market = document.querySelector<HTMLSelectElement>('#review-market');
  const summary = document.querySelector<HTMLElement>('#review-budget-summary');
  const picker = document.querySelector<HTMLDetailsElement>('#review-budget-picker');
  const links = document.querySelectorAll<HTMLAnchorElement>('.rv8-brand-grid [data-review-brand]');
  const brands: Record<string,string[]> = {
    phones: ['Apple','Samsung','Google','Xiaomi','OnePlus','Motorola'],
    tablets: ['Apple','Samsung','Google','Xiaomi','OnePlus','Motorola'],
    wearables: ['Apple','Samsung','Google','Xiaomi','OnePlus','Motorola','Fitbit','Garmin']
  };
  const budgets: Record<string,Array<[string,string]>> = {
    phones: [['all','All prices'],['under-200','Under $200'],['200-500','$200–$500'],['500-1000','$500–$1,000'],['1000-1500','$1,000–$1,500'],['over-1500','Over $1,500']],
    tablets: [['all','All prices'],['under-100','Under $100'],['100-250','$100–$250'],['250-500','$250–$500'],['500-1000','$500–$1,000'],['over-1000','Over $1,000']],
    wearables: [['all','All prices'],['under-10','Under $10'],['11-50','$11–$50'],['51-100','$51–$100'],['101-250','$101–$250'],['251-500','$251–$500'],['over-500','Over $500']]
  };
  function updateLinks() {
    const category=product?.value||'phones';
    links.forEach(link=>{
      const name=link.dataset.reviewBrand||'';
      link.hidden=!brands[category].includes(name);
      link.href='/phones/reviews/?'+new URLSearchParams({category,brand:name,tier:tier?.value||'all',market:market?.value||'US'}).toString();
    });
  }
  function refreshCategory(category:string) {
    if(product) product.value=category;
    if(budgetCategory) budgetCategory.value=category;
    if(brand){brand.replaceChildren(new Option('All brands',''));brands[category].forEach(name=>brand.add(new Option(name,name)));}
    if(tier){tier.replaceChildren();budgets[category].forEach(([value,label])=>tier.add(new Option(label,value)));}
    refreshSummary(); updateLinks();
  }
  function refreshSummary(){if(summary&&tier){summary.innerHTML='';summary.append(document.createTextNode(tier.selectedOptions[0]?.textContent||'All prices'));const arrow=document.createElement('span');arrow.setAttribute('aria-hidden','true');arrow.textContent='⌄';summary.append(arrow);}}
  product?.addEventListener('change',()=>refreshCategory(product.value));
  budgetCategory?.addEventListener('change',()=>refreshCategory(budgetCategory.value));
  tier?.addEventListener('change',()=>{refreshSummary();updateLinks();if(picker)picker.open=false;});
  market?.addEventListener('change',updateLinks);
  refreshCategory(product?.value||'phones');
</script>

