    font-weight: 700;
    color: #4c5c5b;
  }

  .hero-message {
    max-width: 600px;
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: #455e66;
  }

  .hero-art {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-art img {
    display: block;
    width: 100%;
    max-width: 570px;
    max-height: 355px;
    object-fit: contain;
  }

  /* DEVICE CATEGORIES */

  .device-section {
    padding: 48px 0 44px;
  }

  .device-section > h2 {
    margin: 0 0 20px;
    font-family:
      Georgia,
      "Times New Roman",
      serif;
    font-size: 31px;
    line-height: 1.1;
    color: var(--hub-forest);
  }

  .device-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .device-card {
    min-width: 0;
    min-height: 310px;
    padding: 18px 18px 20px;
    border: 1px solid rgba(7, 61, 50, 0.11);
    border-radius: 22px;
    text-decoration: none;
    color: var(--hub-ink);

    display: flex;
    flex-direction: column;
    overflow: hidden;

    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
