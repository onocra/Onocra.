    padding: 20px 0 72px;
    color: var(--hub-ink);
  }

  /* ADVERTISEMENT */

  .top-ad {
    min-height: 104px;
    margin-bottom: 24px;
    border: 1px dashed #c9c1b4;
    border-radius: 18px;

    background:
      radial-gradient(
