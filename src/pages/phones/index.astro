    line-height: 1.55;
    color: #617075;
  }

  .ask-box {
    max-width: 920px;
    margin: 0 auto;
  }

  .search-field {
    min-height: 62px;
    padding: 7px 8px 7px 17px;
    border: 1px solid rgba(7, 61, 50, 0.22);
    border-radius: 18px;
    background: #ffffff;

    display: flex;
    align-items: center;
    gap: 8px;

