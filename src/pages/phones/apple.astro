---
import { applePhones, activeApplePhones } from '../../data/applePhones';
import { appleRegionalData, regions } from '../../data/appleRegionalData';
const activeSlugs = new Set(activeApplePhones.map((phone) => phone.slug));
const specFields = [
  ['display', 'Display'], ['chipset', 'Chipset'], ['ram', 'RAM'],
  ['storage', 'Storage'], ['cameras', 'Cameras'], ['battery', 'Battery'],
  ['charging', 'Charging'], ['software', 'Software'],
  ['dimensions', 'Dimensions'], ['connectivity', 'Connectivity'],
] as const;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Apple iPhone Gallery | ONOCRA.</title>
  <meta name="description" content="Browse ONOCRA's curated Apple iPhones with region-specific specifications and price evidence." />
</head>
<body>
<main class="gallery">
  <a class="back" href="/phones/">← Phones</a>
  <header>
    <p class="eyebrow">ONOCRA. / Phones / Apple</p>
    <h1>Explore Apple iPhones</h1>
    <p>Explore the phones. Open the details only when you need them.</p>
    <p class="notice">A curated selection focusing on models from the last three years and selected US, UK and German variants. Older models are retained as comparison references. Availability and configurations vary by market.</p>
  </header>
  <section class="tools" aria-label="Gallery controls">
    <label>Region
      <select id="region">
        {regions.map((r) => <option value={r.code}>{r.label} ({r.currency})</option>)}
      </select>
    </label>
    <label>Search models<input id="search" type="search" placeholder="e.g. iPhone 16 Pro" /></label>
    <label>Generation<select id="generation"><option value="all">All generations</option>{[2026,2025,2024,2023,2022].map((y) => <option value={y}>{y}</option>)}</select></label>
    <label>Family<select id="family"><option value="all">All families</option>{['Standard','Plus','Pro','Pro Max','Air','e'].map((f) => <option value={f}>{f}</option>)}</select></label>
    <label class="toggle"><input id="older" type="checkbox" /> Include older reference models</label>
  </section>
  <p id="count" aria-live="polite"></p>
  <section class="cards" aria-label="Apple phone gallery">
    {applePhones.map((phone) => (
      <article class="card" data-slug={phone.slug} data-name={phone.name.toLowerCase()} data-year={phone.year} data-family={phone.family} data-active={activeSlugs.has(phone.slug) ? 'true' : 'false'} data-status={phone.status}>
        <div class="picture"><img src={phone.image} alt={`${phone.name} product views`} loading="lazy" /><span class="missing-note" hidden>Image unavailable — check filename</span></div>
        <div class="card-main">
          <p class="meta">{phone.year} · {phone.family}</p>
          <h2>{phone.name}</h2>
          {phone.status === 'verify' && <p class="warning">Release or specification verification pending</p>}
          <details class="detail"><summary>Technical specifications</summary><div class="detail-body spec-panel" data-section="specs"><p class="muted">Select a region to see verified specifications.</p></div></details>
          <details class="detail"><summary>Regional variants &amp; SIM</summary><div class="detail-body variant-panel" data-section="variant"><p class="muted">Regional research pending.</p></div></details>
          <details class="detail"><summary>Storage &amp; pricing</summary><div class="detail-body price-panel" data-section="price"><p class="muted">Regional price research pending.</p></div></details>
          <div class="actions"><label><input class="compare" type="checkbox" value={phone.slug} disabled={phone.status === 'verify'} /> Compare</label><a href={`/phones/reviews/?model=${encodeURIComponent(phone.slug)}`}>Explore →</a></div>
        </div>
      </article>
    ))}
  </section>
  <p id="empty" hidden>No models match your filters.</p>
  <p class="footnote">Sources and observation dates appear alongside verified evidence. Blank evidence is never replaced with estimates. Current retail offers, MSRP and resale/buyback valuations are separate categories.</p>
</main>
<aside class="compare-bar" id="compareBar" hidden><span id="selection">0 of 3 selected</span><button id="clear" type="button">Clear</button><button id="start" type="button">Start comparison →</button></aside>
<script define:vars={{ research: appleRegionalData, fields: specFields }}>
  // Server-authored, serializable data; rendered only after explicit user expansion.
  const cards = Array.from(document.querySelectorAll('.card'));
  const search = document.querySelector('#search');
  const generation = document.querySelector('#generation');
  const family = document.querySelector('#family');
  const older = document.querySelector('#older');
  const region = document.querySelector('#region');
  const count = document.querySelector('#count');
  const empty = document.querySelector('#empty');
  const bar = document.querySelector('#compareBar');
  const selection = document.querySelector('#selection');
  const boxes = Array.from(document.querySelectorAll('.compare'));
  const selected = () => boxes.filter((b) => b.checked);
  const escapeHTML = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const missing = '<p class="muted">Not yet verified for this region.</p>';
  function evidence(e) {
    if (!e?.value || !e?.source || !e?.checkedAt) return missing;
    const safeURL = /^https:\/\//i.test(e.source) ? e.source : null;
    const source = safeURL ? `<a href="${escapeHTML(safeURL)}" target="_blank" rel="noopener noreferrer">Source ↗</a>` : 'Source not linked';
    return `<span>${escapeHTML(e.value)}</span><small>${source} · checked ${escapeHTML(e.checkedAt)} · ${escapeHTML(e.confidence)} confidence${e.note ? ' · '+escapeHTML(e.note) : ''}</small>`;
  }
  function line(label, e) { return `<div class="datum"><strong>${escapeHTML(label)}</strong><div>${evidence(e)}</div></div>`; }
  function renderCard(card) {
    const record = research[card.dataset.slug] || {};
    const local = record.regions?.[region.value] || {};
    const common = record.common || {};
    const specs = card.querySelector('.spec-panel');
    const variants = card.querySelector('.variant-panel');
    const prices = card.querySelector('.price-panel');
    specs.innerHTML = fields.map(([key, label]) => line(label, local.specifications?.[key] || common[key])).join('');
    variants.innerHTML = [line('Model number', local.modelNumber),line('Availability',local.availability),line('SIM / eSIM',local.sim),line('Network',local.network)].join('');
    const items = (local.prices || []).filter((p) => p?.value && p?.source && p?.checkedAt && p?.currency === ({US:'USD',UK:'GBP',DE:'EUR'}[region.value]));
    prices.innerHTML = items.length ? items.map((p) => line(`${p.storage} · ${p.channel}${p.condition ? ' · '+p.condition : ''}`,p)).join('') : missing;
  }
  function update() {
    let visible = 0;
    cards.forEach((card) => {
      const show = (card.dataset.name || '').includes(search.value.toLowerCase().trim()) && (generation.value === 'all' || card.dataset.year === generation.value) && (family.value === 'all' || card.dataset.family === family.value) && (older.checked || card.dataset.active === 'true');
      card.hidden = !show;
      if (show) visible++;
    });
    count.textContent = `${visible} models shown · ${region.options[region.selectedIndex].text}`;
    empty.hidden = visible !== 0;
    const n = selected().length;
    bar.hidden = n === 0;
    selection.textContent = `${n} of 3 phones selected`;
    boxes.forEach((box) => {const card = box.closest('.card');box.disabled = card.dataset.status === 'verify' || (!box.checked && n >= 3);});
  }
  [search,generation,family,older].forEach((el) => el.addEventListener('input',update));
  region.addEventListener('change', () => { cards.forEach(renderCard); update(); });
  boxes.forEach((box) => box.addEventListener('change',update));
  document.querySelector('#clear').addEventListener('click', () => { selected().forEach((b) => b.checked = false);update(); });
  document.querySelector('#start').addEventListener('click', () => { const models = selected().map((b) => b.value).join(','); if (models) window.location.href = `/phones/reviews/?models=${encodeURIComponent(models)}&region=${encodeURIComponent(region.value)}`; });
  document.querySelectorAll('.picture img').forEach((img) => img.addEventListener('error', () => { img.hidden = true;img.parentElement.querySelector('.missing-note').hidden = false; }));
  cards.forEach((card) => {
    card.querySelectorAll('details').forEach((detail) => detail.addEventListener('toggle', () => { if (detail.open) {card.querySelectorAll('details').forEach((other) => {if(other !== detail) other.open = false;});renderCard(card);} }));
  });
  cards.forEach(renderCard);
  update();
</script>
</body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(body){margin:0;background:#f8fbfd;color:#102a43;font-family:Manrope,system-ui,sans-serif}
  .gallery{max-width:1200px;margin:auto;padding:30px 24px 110px}.back,.actions a{color:#087eba;font-weight:750;text-decoration:none}.eyebrow{color:#087eba;font-size:.78rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}h1{font-family:Georgia,serif;font-size:clamp(2rem,4vw,3.1rem);margin:.5rem 0}header>p{max-width:860px;line-height:1.6}.notice{padding:12px 16px;background:#eaf3f8;border-left:3px solid #087eba;border-radius:8px;font-size:.88rem}
  .tools{display:flex;align-items:end;flex-wrap:wrap;gap:14px;margin:26px 0 12px}.tools label{display:grid;gap:6px;font-size:.82rem;font-weight:700}.tools input[type=search],.tools select{background:#fff;border:1px solid #d8e5ed;border-radius:9px;padding:10px 12px;color:#102a43;min-width:145px}.tools input[type=search]{min-width:220px}.tools .toggle{display:flex;align-items:center;gap:8px;padding-bottom:10px}#count,.meta,.footnote{color:#60768a;font-size:.82rem}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:16px;margin-top:18px}.card{background:white;border:1px solid #d8e5ed;border-radius:16px;overflow:hidden;box-shadow:0 3px 10px #102a4308}.card[hidden],#empty[hidden],.compare-bar[hidden]{display:none}.picture{height:210px;background:#f1f7f9;display:flex;justify-content:center;align-items:center;padding:10px}.picture img{max-width:100%;height:100%;object-fit:contain}.picture img[hidden]{display:none}.missing-note{font-size:.8rem;color:#687b89}.missing-note[hidden]{display:none}.card-main{padding:15px}.meta{margin:0}h2{font-size:1.05rem;margin:7px 0 12px}.warning{font-size:.75rem;color:#8a5b00}
  .detail{border:1px solid #e0eaf0;border-radius:9px;margin:7px 0;overflow:hidden}.detail summary{list-style:none;cursor:pointer;padding:10px 11px;font-size:.8rem;font-weight:750;display:flex;justify-content:space-between;gap:8px;background:#f7fbfd}.detail summary::-webkit-details-marker{display:none}.detail summary:after{content:'⌄';color:#087eba}.detail[open] summary:after{content:'⌃'}.detail-body{padding:9px 11px;max-height:320px;overflow:auto}.detail-body :global(.datum){border-bottom:1px solid #eef2f5;padding:7px 0;font-size:.78rem}.detail-body :global(.datum strong){display:block;margin-bottom:4px}.detail-body :global(.datum small){display:block;color:#61768a;font-size:.7rem;line-height:1.4;margin-top:4px}.detail-body :global(a){color:#087eba}.detail-body :global(.muted){color:#748596;font-size:.78rem}
  .actions{display:flex;align-items:center;justify-content:space-between;margin-top:13px;gap:10px}.actions label,.actions a{font-size:.82rem}.actions label{display:flex;align-items:center;gap:6px}.compare-bar{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:center;gap:10px;background:#102a43;color:white;padding:12px max(20px,calc((100vw - 1200px)/2));z-index:20}.compare-bar span{margin-right:auto}.compare-bar button{border:0;border-radius:8px;padding:10px 12px;cursor:pointer}.compare-bar #start{background:#087eba;color:white;font-weight:700}.footnote{margin-top:25px;line-height:1.5}
  @media(max-width:600px){.gallery{padding:20px 12px 110px}.cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.picture{height:145px}.card-main{padding:9px}h2{font-size:.9rem}.tools{gap:9px}.tools input[type=search]{min-width:0;width:100%}.actions{flex-wrap:wrap}.compare-bar{padding:10px;font-size:.8rem}.compare-bar button{font-size:.75rem;padding:9px}}
</style>
