<header class="phones-header" id="phones-header">
  <div class="phones-header-inner">

    <!-- BREADCRUMB -->
    <nav class="phones-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>

      <span class="breadcrumb-arrow" aria-hidden="true">›</span>

      <span class="breadcrumb-current">
        Phones, Tablets &amp; Wearables
      </span>
    </nav>

    <!-- HEADER ACTIONS -->
    <div class="phones-header-actions">

      <!-- SEARCH -->
      <a
        class="header-action"
        href="/search/"
        aria-label="Search ONOCRA"
        title="Search"
      >
        <span class="search-icon" aria-hidden="true"></span>
        <span class="action-label">Search</span>
      </a>

      <!-- THEME -->
      <button
        class="header-action theme-action"
        id="phones-theme-toggle"
        type="button"
        aria-label="Switch to darker theme"
        aria-pressed="false"
        title="Change appearance"
      >
        <span class="theme-icon theme-sun" aria-hidden="true">
          ☼
        </span>

        <span class="theme-icon theme-moon" aria-hidden="true">
          ☾
        </span>

        <span class="action-label">
          Theme
        </span>
      </button>

      <!-- MENU -->
      <div class="menu-wrapper">

        <button
          class="header-action menu-action"
          id="phones-menu-button"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="phones-menu-panel"
          title="Menu"
        >
          <span class="menu-icon" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>

          <span class="action-label">
            Menu
          </span>
        </button>

        <!-- DROPDOWN MENU -->
        <div
          class="phones-menu-panel"
          id="phones-menu-panel"
          aria-hidden="true"
        >

          <div class="menu-heading">
            <span class="menu-heading-small">
              EXPLORE ONOCRA
            </span>

            <strong>
              TechnoNavigation made easy.
            </strong>
          </div>

          <nav
            class="menu-links"
            aria-label="ONOCRA navigation"
          >

            <a href="/">
              <span class="menu-link-icon">⌂</span>

              <span>
                <strong>Home</strong>
                <small>Start at ONOCRA</small>
              </span>
            </a>

            <a
              href="/phones/"
              class="active-menu-link"
            >
              <span class="menu-link-icon">▣</span>

              <span>
                <strong>
                  Phones, Tablets &amp; Wearables
                </strong>

                <small>
                  Help for your everyday devices
                </small>
              </span>
            </a>

            <a href="/search/?q=Home%20Internet%20Wi-Fi">
              <span class="menu-link-icon">⌁</span>

              <span>
                <strong>
                  Home Internet &amp; Wi-Fi
                </strong>

                <small>
                  Connections, routers and networks
                </small>
              </span>
            </a>

            <a href="/search/?q=Computers%20Laptops">
              <span class="menu-link-icon">▰</span>

              <span>
                <strong>
                  Computers &amp; Laptops
                </strong>

                <small>
                  PCs, Macs and everyday computing
                </small>
              </span>
            </a>

            <a href="/search/?q=Safety%20Security">
              <span class="menu-link-icon">◇</span>

              <span>
                <strong>
                  Safety &amp; Security
                </strong>

                <small>
                  Scams, privacy and safer technology
                </small>
              </span>
            </a>

            <a href="/search/?q=Smart%20Home">
              <span class="menu-link-icon">⌂</span>

              <span>
                <strong>Smart Home</strong>

                <small>
                  Connected technology around the home
                </small>
              </span>
            </a>

            <a href="/search/?q=Apps%20Online%20Services">
              <span class="menu-link-icon">▦</span>

              <span>
                <strong>
                  Apps &amp; Online Services
                </strong>

                <small>
                  Everyday apps and digital services
                </small>
              </span>
            </a>

          </nav>

          <div class="menu-divider"></div>

          <nav
            class="menu-secondary"
            aria-label="More from ONOCRA"
          >
            <a href="/phones/safety/">
              Digital Safety
            </a>

            <a href="/phones/parenting/">
              Digital Parenting
            </a>

            <a href="/phones/reviews/">
              Reviews
            </a>

            <a href="/phones/guides/">
              Guides
            </a>

            <a href="/about/">
              About
            </a>
          </nav>

        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const menuButton =
      document.getElementById("phones-menu-button");

    const menuPanel =
      document.getElementById("phones-menu-panel");

    const themeButton =
      document.getElementById("phones-theme-toggle");

    const root =
      document.documentElement;

    /* MENU */

    const closeMenu = () => {
      if (!menuButton || !menuPanel) return;

      menuButton.setAttribute(
        "aria-expanded",
        "false"
      );

      menuButton.setAttribute(
        "aria-label",
        "Open menu"
      );

      menuPanel.setAttribute(
        "aria-hidden",
        "true"
      );

      menuPanel.classList.remove(
        "menu-open"
      );
    };

    const openMenu = () => {
      if (!menuButton || !menuPanel) return;

      menuButton.setAttribute(
        "aria-expanded",
        "true"
      );

      menuButton.setAttribute(
        "aria-label",
        "Close menu"
      );

      menuPanel.setAttribute(
        "aria-hidden",
        "false"
      );

      menuPanel.classList.add(
        "menu-open"
      );
    };

    if (menuButton && menuPanel) {
      menuButton.addEventListener(
        "click",
        event => {
          event.stopPropagation();

          const isOpen =
            menuButton.getAttribute(
              "aria-expanded"
            ) === "true";

          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        }
      );

      menuPanel.addEventListener(
        "click",
        event => {
          event.stopPropagation();
        }
      );

      document.addEventListener(
        "click",
        () => {
          closeMenu();
        }
      );

      document.addEventListener(
        "keydown",
        event => {
          if (event.key === "Escape") {
            closeMenu();
          }
        }
      );

      const menuLinks =
        menuPanel.querySelectorAll("a");

      menuLinks.forEach(link => {
        link.addEventListener(
          "click",
          () => {
            closeMenu();
          }
        );
      });
    }

    /* THEME */

    const applyTheme = theme => {
      const darker =
        theme === "onocra-darker";

      if (darker) {
        root.setAttribute(
          "data-onocra-appearance",
          "darker"
        );
      } else {
        root.removeAttribute(
          "data-onocra-appearance"
        );
      }

      if (themeButton) {
        themeButton.setAttribute(
          "aria-pressed",
          darker ? "true" : "false"
        );

        themeButton.setAttribute(
          "aria-label",
          darker
            ? "Switch to light theme"
            : "Switch to darker theme"
        );

        themeButton.setAttribute(
          "title",
          darker
            ? "Switch to light appearance"
            : "Switch to darker appearance"
        );
      }
    };

    let savedTheme = null;

    try {
      savedTheme =
        localStorage.getItem(
          "onocra-appearance"
        );
    } catch (error) {
      savedTheme = null;
    }

    applyTheme(
      savedTheme === "onocra-darker"
        ? "onocra-darker"
        : "light"
    );

    if (themeButton) {
      themeButton.addEventListener(
        "click",
        event => {
          event.stopPropagation();

          const darker =
            root.getAttribute(
              "data-onocra-appearance"
            ) === "darker";

          const nextTheme =
            darker
              ? "light"
              : "onocra-darker";

          try {
            localStorage.setItem(
              "onocra-appearance",
              nextTheme
            );
          } catch (error) {
            /* Continue without storage. */
          }

          applyTheme(nextTheme);
        }
      );
    }
  })();
</script>

<style>
  /* ========================================
     HEADER — LIGHT
  ========================================= */

  .phones-header {
    position: relative;
    z-index: 100;

    width: 100%;

    border-bottom:
      1px solid rgba(7, 61, 50, 0.12);

    background:
      rgba(255, 249, 239, 0.96);

    transition:
      background 0.22s ease,
      border-color 0.22s ease;
  }

  .phones-header-inner {
    width: min(100% - 32px, 1240px);
    min-height: 62px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;
  }

  /* BREADCRUMB */

  .phones-breadcrumb {
    min-width: 0;

    display: flex;
    align-items: center;

    gap: 9px;

    font-size: 13px;
    line-height: 1.2;
  }

  .phones-breadcrumb a {
    color: #14624d;

    font-weight: 800;
    text-decoration: none;
  }

  .phones-breadcrumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumb-arrow {
    color: #8b9692;

    font-size: 20px;
    line-height: 1;
  }

  .breadcrumb-current {
    overflow: hidden;

    color: #5e6c70;

    font-weight: 600;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ACTIONS */

  .phones-header-actions {
    position: relative;

    flex: 0 0 auto;

    display: flex;
    align-items: center;

    gap: 5px;
  }

  .header-action {
    min-height: 38px;
    padding: 0 10px;

    border: 0;
    border-radius: 10px;

    background: transparent;
    color: #073d32;

    font: inherit;
    font-size: 12px;
    font-weight: 700;

    text-decoration: none;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    transition:
      background 0.16s ease,
      color 0.16s ease,
      transform 0.16s ease;
  }

  .header-action:hover {
    background: #e6efe5;
  }

  .header-action:active {
    transform: scale(0.96);
  }

  /* SEARCH */

  .search-icon {
    position: relative;

    width: 17px;
    height: 17px;

    border: 2px solid #073d32;
    border-radius: 50%;

    display: block;
  }

  .search-icon::after {
    content: "";

    position: absolute;

    width: 7px;
    height: 2px;

    right: -5px;
    bottom: -2px;

    border-radius: 999px;

    background: #073d32;

    transform: rotate(45deg);
  }

  /* THEME */

  .theme-action {
    background: #e6efe5;
  }

  .theme-icon {
    width: 20px;

    display: grid;
    place-items: center;

    font-size: 22px;
    line-height: 1;

    color: #f56622;
  }

  .theme-moon {
    display: none;
  }

  /* MENU BUTTON */

  .menu-wrapper {
    position: relative;
  }

  .menu-icon {
    width: 20px;
    height: 16px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .menu-icon i {
    display: block;

    width: 100%;
    height: 2px;

    border-radius: 999px;

    background: #073d32;

    transition:
      transform 0.18s ease,
      opacity 0.18s ease;
  }

  .menu-action[aria-expanded="true"]
    .menu-icon i:nth-child(1) {
    transform:
      translateY(7px)
      rotate(45deg);
  }

  .menu-action[aria-expanded="true"]
    .menu-icon i:nth-child(2) {
    opacity: 0;
  }

  .menu-action[aria-expanded="true"]
    .menu-icon i:nth-child(3) {
    transform:
      translateY(-7px)
      rotate(-45deg);
  }

  /* DROPDOWN */

  .phones-menu-panel {
    position: absolute;

    top: calc(100% + 13px);
    right: 0;

    width: min(390px, calc(100vw - 24px));

    max-height:
      min(650px, calc(100vh - 90px));

    padding: 18px;

    border:
      1px solid rgba(7, 61, 50, 0.14);

    border-radius: 19px;

    background: #fffaf1;

    box-shadow:
      0 20px 50px
      rgba(23, 51, 74, 0.18);

    overflow-y: auto;

    opacity: 0;
    visibility: hidden;

    transform: translateY(-7px);

    pointer-events: none;

    transition:
      opacity 0.18s ease,
      visibility 0.18s ease,
      transform 0.18s ease;
  }

  .phones-menu-panel.menu-open {
    opacity: 1;
    visibility: visible;

    transform: translateY(0);

    pointer-events: auto;
  }

  .menu-heading {
    padding: 3px 5px 14px;
  }

  .menu-heading-small {
    display: block;

    margin-bottom: 5px;

    color: #f56622;

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.15em;
  }

  .menu-heading strong {
    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 20px;
    line-height: 1.15;

    color: #073d32;
  }

  .menu-links {
    display: flex;
    flex-direction: column;

    gap: 4px;
  }

  .menu-links > a {
    min-height: 55px;
    padding: 8px 9px;

    border-radius: 12px;

    color: #17334a;
    text-decoration: none;

    display: grid;

    grid-template-columns:
      35px
      minmax(0, 1fr);

    align-items: center;

    gap: 9px;

    transition:
      background 0.15s ease;
  }

  .menu-links > a:hover {
    background: #e6efe5;
  }

  .menu-links > a.active-menu-link {
    background: #e6efe5;
  }

  .menu-link-icon {
    width: 35px;
    height: 35px;

    border-radius: 10px;

    background: #f3ead9;
    color: #14624d;

    display: grid;
    place-items: center;

    font-size: 18px;
    font-weight: 800;
  }

  .menu-links strong {
    display: block;

    font-size: 13px;
    line-height: 1.2;

    color: #073d32;
  }

  .menu-links small {
    display: block;

    margin-top: 2px;

    font-size: 10px;
    line-height: 1.3;

    color: #6b7779;
  }

  .menu-divider {
    height: 1px;

    margin: 13px 4px;

    background:
      rgba(7, 61, 50, 0.11);
  }

  .menu-secondary {
    display: flex;
    flex-wrap: wrap;

    gap: 7px;
  }

  .menu-secondary a {
    padding: 7px 10px;

    border:
      1px solid rgba(7, 61, 50, 0.12);

    border-radius: 999px;

    background: #ffffff;
    color: #14624d;

    font-size: 10px;
    font-weight: 800;

    text-decoration: none;
  }

  .menu-secondary a:hover {
    background: #e6efe5;
  }

  /* ========================================
     ONOCRA DARK THEME
  ========================================= */

  :global(
    html[data-onocra-appearance="darker"]
  ) {
    --background: #181e26;
    --foreground: #f5f3ed;
    --muted: #242b35;
    --muted-foreground: #aab2bc;
    --border: #343d48;

    background: #181e26;

    color-scheme: dark;
  }

  :global(
    html[data-onocra-appearance="darker"] body
  ) {
    background: #181e26 !important;
    color: #f5f3ed;
  }

  /* DARK HEADER */

  :global(
    html[data-onocra-appearance="darker"]
    .phones-header
  ) {
    border-bottom-color: #343d48;
    background: #1d242d;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .phones-breadcrumb a
  ) {
    color: #9fd4bf !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .breadcrumb-arrow
  ) {
    color: #76818e;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .breadcrumb-current
  ) {
    color: #b8c0c8;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .header-action
  ) {
    color: #f5f3ed;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .header-action:hover
  ) {
    background: #2a323d;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .theme-action
  ) {
    background: #2a323d;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .search-icon
  ) {
    border-color: #f5f3ed;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .search-icon::after
  ) {
    background: #f5f3ed;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-icon i
  ) {
    background: #f5f3ed;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .theme-sun
  ) {
    display: none;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .theme-moon
  ) {
    display: grid;
    color: #f0c85a;
  }

  /* DARK MENU */

  :global(
    html[data-onocra-appearance="darker"]
    .phones-menu-panel
  ) {
    border-color: #343d48;

    background: #202731;

    box-shadow:
      0 22px 55px
      rgba(0, 0, 0, 0.42);
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-heading strong
  ) {
    color: #fff8ed !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-links > a
  ) {
    color: #f5f3ed;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-links > a:hover
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .menu-links > a.active-menu-link
  ) {
    background: #2a323d;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-links strong
  ) {
    color: #f5f3ed !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-links small
  ) {
    color: #aab2bc;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-link-icon
  ) {
    background: #303944;
    color: #9fd4bf;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-divider
  ) {
    background: #343d48;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-secondary a
  ) {
    border-color: #3a4450;

    background: #252d37;
    color: #dce2e7;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .menu-secondary a:hover
  ) {
    background: #303944;
  }

  /* ========================================
     DARK PHONES HUB
  ========================================= */

  :global(
    html[data-onocra-appearance="darker"]
    .phones-hub
  ) {
    color: #e9edf0;
  }

  /* ADVERTISEMENTS */

  :global(
    html[data-onocra-appearance="darker"]
    .top-ad
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .mid-ad
  ) {
    border-color: #46505c;

    background:
      linear-gradient(
        135deg,
        #202731,
        #252d37
      );
  }

  /* HERO */

  :global(
    html[data-onocra-appearance="darker"]
    .phones-hero
  ) {
    border-color: #343d48;

    background:
      radial-gradient(
        circle at 86% 18%,
        rgba(18, 105, 176, 0.14),
        transparent 31%
      ),
      radial-gradient(
        circle at 8% 90%,
        rgba(245, 102, 34, 0.07),
        transparent 27%
      ),
      linear-gradient(
        135deg,
        #202731,
        #1b222b
      );
  }

  :global(
    html[data-onocra-appearance="darker"]
    .phones-hero h1
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .hero-copy h1
  ) {
    color: #fff8ed !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .hero-eyebrow
  ) {
    color: #ff7540 !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .hero-subtitle
  ) {
    color: #9fd4bf !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .hero-message
  ) {
    color: #d2d7dc !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .brand-row span
  ) {
    border-color: #414b57;

    background: #29313b;
    color: #dce2e7 !important;
  }

  /* ========================================
     ALL MAJOR SECTION HEADINGS
  ========================================= */

  :global(
    html[data-onocra-appearance="darker"]
    .phones-hub h2
  ) {
    color: #fff8ed !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .device-section > h2
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .ask-heading h2
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .popular-header h2
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .navigation-heading h2
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .section-heading h2
  ) {
    color: #fff8ed !important;
  }

  /* ========================================
     DEVICE CARDS
  ========================================= */

  :global(
    html[data-onocra-appearance="darker"]
    .device-card
  ) {
    border-color: #3b4652;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .device-card h3
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .device-copy h3
  ) {
    color: #fff8ed !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .device-card p
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .device-copy p
  ) {
    color: #b8c0c8 !important;
  }

  :global(
    html[data-onocra-appearance="darker"]
    .device-card a
  ),
  :global(
    html[data-onocra-appearance="darker"]
    .device-copy span
  ) {
    color: #9fd4bf !important;
  }

  /* ========================================
     ASK ONOCRA
  ========================================= */

  :global(
