---
---

<header class="phones-header">
  <div class="phones-header-inner">

    <!-- BREADCRUMB -->
    <nav class="phones-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>

      <span class="breadcrumb-arrow" aria-hidden="true">›</span>

      <span class="breadcrumb-current">
        Phones, Tablets &amp; Wearables
      </span>
    </nav>

    <!-- HEADER ACTIONS -->
    <div class="phones-header-actions">

      <a
        class="header-action"
        href="/search/"
        aria-label="Search ONOCRA"
        title="Search"
      >
        <span class="search-icon" aria-hidden="true"></span>
        <span class="action-label">Search</span>
      </a>

      <button
        class="header-action"
        id="phones-theme-toggle"
        type="button"
        aria-label="Change appearance"
        title="Change appearance"
      >
        <span class="theme-icon" aria-hidden="true">☼</span>
        <span class="action-label">Theme</span>
      </button>

      <button
        class="header-action menu-action"
        id="phones-menu-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        title="Menu"
      >
        <span class="menu-icon" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>

        <span class="action-label">Menu</span>
      </button>

    </div>

  </div>
</header>

<style>
  .phones-header {
    width: 100%;
    border-bottom: 1px solid rgba(7, 61, 50, 0.12);
    background: rgba(255, 249, 239, 0.96);
  }

  .phones-header-inner {
    width: min(100% - 32px, 1240px);
    min-height: 62px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;
  }

  /* ========================================
     BREADCRUMB
  ========================================= */

  .phones-breadcrumb {
    min-width: 0;

    display: flex;
    align-items: center;

    gap: 9px;

    font-size: 13px;
    line-height: 1.2;
  }

  .phones-breadcrumb a {
    color: #14624d;
    font-weight: 800;
    text-decoration: none;
  }

  .phones-breadcrumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .breadcrumb-arrow {
    color: #8b9692;
    font-size: 20px;
    line-height: 1;
  }

  .breadcrumb-current {
    overflow: hidden;

    color: #5e6c70;

    font-weight: 600;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ========================================
     ACTIONS
  ========================================= */

  .phones-header-actions {
    flex: 0 0 auto;

    display: flex;
    align-items: center;

    gap: 5px;
  }

  .header-action {
    min-height: 38px;
    padding: 0 10px;

    border: 0;
    border-radius: 10px;

    background: transparent;
    color: #073d32;

    font: inherit;
    font-size: 12px;
    font-weight: 700;

    text-decoration: none;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    transition:
      background 0.16s ease,
      color 0.16s ease;
  }

  .header-action:hover {
    background: #e6efe5;
  }

  /* SEARCH */

  .search-icon {
    position: relative;

    width: 17px;
    height: 17px;

    border: 2px solid #073d32;
    border-radius: 50%;

    display: block;
  }

  .search-icon::after {
    content: "";

    position: absolute;

    width: 7px;
    height: 2px;

    right: -5px;
    bottom: -2px;

    border-radius: 999px;

    background: #073d32;

    transform: rotate(45deg);
    transform-origin: center;
  }

  /* THEME */

  .theme-icon {
    width: 20px;

    display: grid;
    place-items: center;

    font-size: 22px;
    line-height: 1;

    color: #f56622;
  }

  /* MENU */

  .menu-icon {
    width: 20px;
    height: 16px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .menu-icon i {
    display: block;

    width: 100%;
    height: 2px;

    border-radius: 999px;

    background: #073d32;
  }

  /* ========================================
     MOBILE
  ========================================= */

  @media (max-width: 720px) {
    .phones-header-inner {
      width: min(100% - 22px, 1240px);
      min-height: 56px;

      gap: 10px;
    }

    .phones-breadcrumb {
      min-width: 0;

      gap: 6px;

      font-size: 12px;
    }

    .breadcrumb-arrow {
      font-size: 17px;
    }

    .breadcrumb-current {
      max-width: 150px;
    }

    .phones-header-actions {
      gap: 1px;
    }

    .header-action {
      width: 37px;
      min-height: 37px;

      padding: 0;

      border-radius: 9px;
    }

    .action-label {
      display: none;
    }
  }

  @media (max-width: 430px) {
    .breadcrumb-current {
      max-width: 112px;
    }

    .phones-breadcrumb {
      font-size: 11px;
    }

    .phones-header-actions {
      flex-shrink: 0;
    }

    .header-action {
      width: 34px;
      min-height: 34px;
    }
  }
</style>
