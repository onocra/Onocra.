---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? "en";
const homeURL = getRelativeLocaleUrl(locale, "");
const searchURL = getRelativeLocaleUrl(locale, "search");
const currentYear = new Date().getFullYear();

const exploreLinks = [
  { label: "Fix", href: `${homeURL}#fix` },
  { label: "Decode", href: `${homeURL}#decode` },
  { label: "Compare", href: `${homeURL}#compare` },
  { label: "Choose", href: `${homeURL}#choose` },
];

const resourceLinks = [
  { label: "Reviews", href: `${homeURL}#reviews` },
  { label: "Updates", href: `${homeURL}#updates` },
  { label: "Digital Parenting", href: `${homeURL}#digital-parenting` },
  { label: "Digital Safety", href: `${homeURL}#digital-safety` },
  { label: "Guides", href: `${homeURL}#guides` },
  { label: "Topics", href: `${homeURL}#topics` },
];

const aboutLinks = [
  { label: "Our mission", href: `${homeURL}#about` },
  { label: "How we research", href: `${homeURL}#research` },
  { label: "How we use AI", href: `${homeURL}#ai` },
  { label: "Editorial standards", href: `${homeURL}#editorial-standards` },
  { label: "Contact", href: `${homeURL}#contact` },
];

const helpLinks = [
  { label: "Ask ONOCRA", href: `${homeURL}#ask-onocra` },
  { label: "ONOCRA Routes", href: `${homeURL}#routes` },
  { label: "Community guidelines", href: `${homeURL}#community-guidelines` },
  { label: "Privacy", href: `${homeURL}#privacy` },
  { label: "Terms", href: `${homeURL}#terms` },
  { label: "Cookies", href: `${homeURL}#cookies` },
];
---

<footer
  class:list={[
    "app-layout border-border bg-background border-t",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <!-- =========================================
       MAIN FOOTER
  ========================================== -->
  <div class="py-10 sm:py-12">
    <div
      class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.35fr_0.8fr_1fr_1.15fr_1.15fr_1.35fr]"
    >
      <!-- =====================================
           ONOCRA BRAND
      ====================================== -->
      <div>
        <a
          href={homeURL}
          class="inline-flex items-center gap-3 no-underline"
          aria-label="ONOCRA home"
        >
          <img
            src="/file_0000000083088208b5fec963887cd25a.png"
            alt=""
            class="h-16 w-16 shrink-0 object-contain"
            loading="lazy"
          />

          <div
            class="font-serif text-[1.55rem] leading-none font-black tracking-[0.035em] text-[var(--onocra-forest)]"
          >
            ONOCRA<span class="text-[var(--onocra-orange)]">.</span>
          </div>
        </a>

        <p
          class="text-muted-foreground mt-4 max-w-[14rem] text-sm leading-relaxed"
        >
          Everyday technology.<br />
          Clear answers.<br />
          Smarter living.
        </p>
      </div>

      <!-- =====================================
           EXPLORE
      ====================================== -->
      <div>
        <h2
          class="text-sm font-extrabold text-[var(--onocra-forest)]"
        >
          Explore
        </h2>

        <nav class="mt-3 flex flex-col gap-2" aria-label="Explore">
          {
            exploreLinks.map(item => (
              <a
                href={item.href}
                class="text-muted-foreground hover:text-accent text-sm no-underline transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- =====================================
           RESOURCES
      ====================================== -->
      <div>
        <h2
          class="text-sm font-extrabold text-[var(--onocra-forest)]"
        >
          Resources
        </h2>

        <nav class="mt-3 flex flex-col gap-2" aria-label="Resources">
          {
            resourceLinks.map(item => (
              <a
                href={item.href}
                class="text-muted-foreground hover:text-accent text-sm no-underline transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- =====================================
           ABOUT ONOCRA
      ====================================== -->
      <div>
        <h2
          class="text-sm font-extrabold text-[var(--onocra-forest)]"
        >
          About ONOCRA
        </h2>

        <nav class="mt-3 flex flex-col gap-2" aria-label="About ONOCRA">
          {
            aboutLinks.map(item => (
              <a
                href={item.href}
                class="text-muted-foreground hover:text-accent text-sm no-underline transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- =====================================
           HELP & LEGAL
      ====================================== -->
      <div>
        <h2
          class="text-sm font-extrabold text-[var(--onocra-forest)]"
        >
          Help &amp; Legal
        </h2>

        <nav class="mt-3 flex flex-col gap-2" aria-label="Help and legal">
          {
            helpLinks.map(item => (
              <a
                href={item.href}
                class="text-muted-foreground hover:text-accent text-sm no-underline transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- =====================================
           FOLLOW ONOCRA
      ====================================== -->
      <div>
        <h2
          class="text-sm font-extrabold text-[var(--onocra-forest)]"
        >
          Follow ONOCRA
        </h2>

        <div class="mt-4 flex flex-wrap items-center gap-3">

          <!-- YOUTUBE -->
          <a
            href="#"
            aria-label="ONOCRA on YouTube"
            class="flex h-9 w-9 items-center justify-center rounded-full no-underline transition-transform hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-7 w-7"
              aria-hidden="true"
            >
              <path
                fill="#FF0000"
                d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z"
              />
              <path fill="white" d="m9.6 15.6 6.3-3.6-6.3-3.6v7.2Z" />
            </svg>
          </a>

          <!-- TIKTOK -->
          <a
            href="#"
            aria-label="ONOCRA on TikTok"
            class="flex h-9 w-9 items-center justify-center rounded-full no-underline transition-transform hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M16.7 3c.3 2.1 1.5 3.4 3.6 3.6v3.1c-1.3.1-2.5-.3-3.6-1v6.2a6 6 0 1 1-5.2-5.9v3.2a2.8 2.8 0 1 0 2 2.7V3h3.2Z" />
            </svg>
          </a>

          <!-- INSTAGRAM -->
          <a
            href="#"
            aria-label="ONOCRA on Instagram"
            class="flex h-9 w-9 items-center justify-center rounded-full no-underline transition-transform hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>

          <!-- FACEBOOK -->
          <a
            href="#"
            aria-label="ONOCRA on Facebook"
            class="flex h-9 w-9 items-center justify-center rounded-full no-underline transition-transform hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M13.7 22v-9h3l.5-3.5h-3.5V7.3c0-1 .3-1.7 1.8-1.7h1.9V2.5c-.3 0-1.5-.1-2.8-.1-2.8 0-4.7 1.7-4.7 4.8v2.3H6.8V13h3.1v9h3.8Z" />
            </svg>
          </a>

          <!-- X -->
          <a
            href="#"
            aria-label="ONOCRA on X"
            class="flex h-9 w-9 items-center justify-center rounded-full no-underline transition-transform hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M18.9 2H22l-6.8 7.8L23.2 22H17l-4.9-6.4L6.5 22H3.4l7.2-8.3L2.9 2h6.4l4.4 5.8L18.9 2Zm-1.1 17.8h1.7L8.4 4H6.6l11.2 15.8Z" />
            </svg>
          </a>

          <!-- PINTEREST -->
          <a
            href="#"
            aria-label="ONOCRA on Pinterest"
            class="flex h-9 w-9 items-center justify-center rounded-full no-underline transition-transform hover:-translate-y-0.5"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-7 w-7"
              fill="#BD081C"
              aria-hidden="true"
            >
              <path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-1.6 0-3.5.4-5.2l1.3-5.5s-.3-.7-.3-1.8c0-1.7 1-3 2.2-3 1 0 1.5.8 1.5 1.7 0 1-.7 2.6-1 4-.3 1.2.6 2.2 1.8 2.2 2.2 0 3.7-2.8 3.7-6 0-2.5-2-4.4-5.2-4.4-3.8 0-6.2 2.8-6.2 6 0 1.1.3 1.9.8 2.5.2.2.2.3.2.6l-.3 1.1c-.1.4-.4.5-.8.3-2.1-.9-3.1-3.3-3.1-6 0-4.4 3.7-9.6 11-9.6 5.9 0 9.8 4.3 9.8 8.9 0 6.1-3.4 10.6-8.4 10.6-1.7 0-3.3-.9-3.8-1.9l-1 4c-.4 1.6-1.2 3.1-1.9 4.2.9.3 1.9.4 2.9.4A10 10 0 0 0 12 2Z" />
            </svg>
          </a>
        </div>

        <p
          class="text-muted-foreground mt-5 max-w-[15rem] text-sm leading-relaxed"
        >
          Technology for real homes.<br />
          Real people. Real solutions.
        </p>
      </div>
    </div>
  </div>

  <!-- =========================================
       LOWER FOOTER
  ========================================== -->
  <div
    class="border-border flex flex-col gap-4 border-t py-5 text-sm sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-muted-foreground">
      © {currentYear} ONOCRA. All rights reserved.
    </p>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <a
        href={searchURL}
        class="text-muted-foreground hover:text-accent no-underline"
      >
        Search
      </a>

      <a
        href={`${homeURL}#privacy`}
        class="text-muted-foreground hover:text-accent no-underline"
      >
        Privacy
      </a>

      <a
        href={`${homeURL}#terms`}
        class="text-muted-foreground hover:text-accent no-underline"
      >
        Terms
      </a>

      <a
        href={`${homeURL}#cookies`}
        class="text-muted-foreground hover:text-accent no-underline"
      >
        Cookies
      </a>
    </div>
  </div>
</footer>
