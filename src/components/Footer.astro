---
/**
 * ONOCRA homepage footer — BP33 (compact botanical footer)
 * Target: src/components/Footer.astro
 *
 * Matches the locked BP31 homepage header background, full bleed and three sprigs.
 * Signature source: public/phones/brand/faviconsignature.png (already uploaded).
 * The four primary hub pages can later use the same visual system.
 * Preserves all six site links, social icon order, existing URLs and Astro props.
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"footer"> & {
  noMarginTop?: boolean;
};

const { class: className, noMarginTop = false, ...attrs } = Astro.props;
---

<footer class:list={["computers-footer", "onocra-brand-footer", { "no-margin-top": noMarginTop }, className]} {...attrs}>
  <!-- Decorative botanical branches mirror the locked homepage header. -->
  <svg class="footer-botanical footer-botanical--left" viewBox="0 0 180 170" aria-hidden="true" focusable="false">
    <g class="footer-sprig-stem">
      <path d="M7 169 C20 134 39 102 69 73 C103 40 129 24 169 -4" />
      <path d="M41 105 C24 88 20 64 27 36" />
      <path d="M58 83 C80 92 102 90 122 79" />
      <path d="M91 52 C84 29 92 12 109 -3" />
      <path d="M120 29 C137 35 154 31 171 22" />
    </g>
    <g class="footer-sprig-leaves">
      <path d="M18 139 C1 120 3 99 10 88 C30 101 34 124 18 139 Z" />
      <path d="M34 118 C12 110 5 91 8 74 C29 80 43 101 34 118 Z" />
      <path d="M43 102 C58 104 75 94 81 77 C62 71 45 83 43 102 Z" />
