---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"footer">;

const { class: className, ...attrs } = Astro.props;
---

<footer class:list={["computers-footer", className]} {...attrs}>
  <div class="computers-footer-inner">

    <!-- SIGNATURE / BRAND -->
    <a class="footer-brand" href="/" aria-label="ONOCRA home">
      <img
        src="/signature.png"
        alt="ONOCRA"
        class="footer-signature"
        loading="lazy"
      />
      <span class="footer-tagline">TechnoNavigation Made Easy</span>
    </a>

    <!-- SITE LINKS -->
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/sitemap-index.xml">Sitemap</a>
      <a href="/archives/">Archives</a>
    </nav>

    <!-- SOCIALS -->
    <nav class="footer-socials" aria-label="ONOCRA social links">
      <a href="#" class="social-link social-x" aria-label="ONOCRA on X" title="X">𝕏</a>

      <a href="#" class="social-link" aria-label="ONOCRA on YouTube" title="YouTube">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/>
        </svg>
      </a>

      <a href="#" class="social-link social-tiktok" aria-label="ONOCRA on TikTok" title="TikTok">♪</a>

      <a href="#" class="social-link" aria-label="ONOCRA on Pinterest" title="Pinterest">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0a12 12 0 0 0-4.4 23.2c-.1-1.9 0-4.1.5-6.1l1.5-6.3s-.4-.8-.4-2c0-1.9 1.1-3.3 2.5-3.3 1.2 0 1.7.9 1.7 2 0 1.2-.7 2.9-1.1 4.5-.3 1.3.7 2.4 2 2.4 2.4 0 4.2-2.5 4.2-6.1 0-3.2-2.3-5.4-5.6-5.4-3.8 0-6.1 2.9-6.1 5.8 0 1.2.4 2.4 1 3 .1.1.1.3.1.5l-.4 1.5c-.1.5-.5.6-.9.4-2.2-1-3.5-4.1-3.5-6.6C3.1 4.1 6.9 1 13.1 1c5.3 0 9.4 3.8 9.4 8.8 0 5.2-3.3 9.4-7.8 9.4-1.5 0-3-.8-3.4-1.7l-.9 3.6c-.3 1.3-1.3 2.9-1.9 3.8A12 12 0 1 0 12 0Z"/>
        </svg>
      </a>

      <a href="#" class="social-link" aria-label="ONOCRA on Facebook" title="Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.3c0-3 1.8-4.7 4.6-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.3l-.5 3.5h-2.8v8.4A12 12 0 0 0 24 12Z"/>
        </svg>
      </a>

      <a href="#" class="social-link" aria-label="ONOCRA on Instagram" title="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6Zm9.2 1.5a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 6.9a5.1 5.1 0 1 1 0 10.2 5.1 5.1 0 0 1 0-10.2Zm0 2a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Z"/>
        </svg>
      </a>

      <a href="mailto:hello@onocra.com" class="social-link" aria-label="Email ONOCRA" title="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 4h18a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3Zm0 2 9 6 9-6H3Zm19 2.4-9.4 6.3a1 1 0 0 1-1.2 0L2 8.4V17a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1V8.4Z"/>
        </svg>
      </a>
    </nav>

  </div>
</footer>

<style>
  .computers-footer {
    position: relative;
    width: 100%;
    background: #fff9ef;
    border-top: 0;
    box-shadow: 0 -4px 12px rgba(7, 61, 50, 0.06);
  }

  /* Thin dimensional edge — same family as sidebar, not a flat heavy bar */
  .computers-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(
      180deg,
      #174f40 0%,
      #2e745f 48%,
      #8db7a6 49%,
      rgba(221, 236, 229, 0.95) 100%
    );
    box-shadow: 0 2px 5px rgba(8, 48, 38, 0.14);
    pointer-events: none;
  }

  .computers-footer-inner {
    width: min(100% - 32px, 1240px);
    min-height: 68px;
    margin: 0 auto;
    padding: 6px 0 4px;
    display: grid;
    grid-template-columns: 112px 1fr auto;
    align-items: center;
    gap: 24px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: #073d32;
    text-decoration: none;
    line-height: 1;
  }

  .footer-signature {
    display: block;
    width: auto;
    height: 34px;
    max-width: 100px;
    object-fit: contain;
  }

  .footer-tagline {
    margin-top: 2px;
    color: #5e6c70;
    font-size: 7px;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
  }

  .footer-links a {
    color: #17334a;
    font-size: 9px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #14624d;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 9px;
  }

  .social-link {
    width: 17px;
    height: 17px;
    display: grid;
    place-items: center;
    color: #102a43;
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .social-link:hover {
    color: #14624d;
    transform: translateY(-1px);
  }

  .social-link svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .social-x {
    font-family: Arial, sans-serif;
    font-size: 17px;
    font-weight: 500;
  }

  .social-tiktok {
    font-family: Arial, sans-serif;
    font-size: 19px;
    font-weight: 900;
  }

  /* Current ONOCRA dark-theme system */
  :global(html[data-theme="dark"]) .computers-footer,
  :global(html.dark) .computers-footer {
    background: #181e26;
    box-shadow: 0 -4px 14px rgba(0, 0, 0, 0.20);
  }

  :global(html[data-theme="dark"]) .computers-footer::before,
  :global(html.dark) .computers-footer::before {
    background: linear-gradient(
      180deg,
      #4c8d76 0%,
      #2c6957 48%,
      #163f35 49%,
      #0b2824 100%
    );
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.24);
  }

  :global(html[data-theme="dark"]) .footer-tagline,
  :global(html.dark) .footer-tagline {
    color: #aab2bc;
  }

  :global(html[data-theme="dark"]) .footer-links a,
  :global(html.dark) .footer-links a {
    color: #dce2e7;
  }

  :global(html[data-theme="dark"]) .footer-links a:hover,
  :global(html.dark) .footer-links a:hover {
    color: #9fd4bf;
  }

  :global(html[data-theme="dark"]) .social-link,
  :global(html.dark) .social-link {
    color: #f5f3ed;
  }

  :global(html[data-theme="dark"]) .social-link:hover,
  :global(html.dark) .social-link:hover {
    color: #9fd4bf;
  }

  @media (max-width: 900px) {
    .computers-footer-inner {
      grid-template-columns: auto 1fr;
      gap: 8px 18px;
      padding: 10px 0;
    }

    .footer-links {
      justify-content: flex-end;
      gap: 10px 14px;
    }

    .footer-socials {
      grid-column: 1 / -1;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .computers-footer-inner {
      width: min(100% - 30px, 1240px);
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 9px;
      padding: 13px 0 14px;
    }

    .footer-brand {
      align-items: center;
    }

    .footer-signature {
      height: 32px;
      max-width: 94px;
    }

    .footer-tagline {
      font-size: 7px;
    }

    .footer-links {
      justify-content: center;
      gap: 7px 14px;
    }

    .footer-links a {
      font-size: 9px;
    }

    .footer-socials {
      grid-column: auto;
      justify-content: center;
      gap: 12px;
    }

    .social-link {
      width: 20px;
      height: 20px;
    }

    .social-link svg {
      width: 17px;
      height: 17px;
    }
  }
</style>
