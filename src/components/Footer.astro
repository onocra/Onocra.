      <path d="M18 139 C1 120 3 99 10 88 C30 101 34 124 18 139 Z" />
      <path d="M34 118 C12 110 5 91 8 74 C29 80 43 101 34 118 Z" />
      <path d="M43 102 C58 104 75 94 81 77 C62 71 45 83 43 102 Z" />
      <path d="M44 77 C24 68 17 46 27 29 C49 40 57 62 44 77 Z" />
      <path d="M66 78 C83 82 103 73 112 54 C89 49 69 59 66 78 Z" />
      <path d="M84 59 C68 42 74 22 88 9 C106 26 105 44 84 59 Z" />
      <path d="M104 45 C122 52 140 43 152 26 C129 20 110 28 104 45 Z" />
      <path d="M125 27 C119 10 127 -2 143 -10 C154 6 145 22 125 27 Z" />
      <path d="M61 83 C61 65 78 54 94 55 C96 74 79 88 61 83 Z" />
      <path d="M111 82 C125 65 142 66 155 74 C148 91 130 93 111 82 Z" />
      <path d="M24 63 C9 47 9 29 21 17 C40 31 41 49 24 63 Z" />
    </g>
    <g class="footer-sprig-veins">
      <path d="M18 134Q17 114 11 92M34 113Q23 94 9 78M47 98Q61 86 78 80M44 74Q33 53 27 33M69 76Q91 61 109 56M85 55Q84 31 88 13M108 43Q129 34 150 27M126 24Q134 8 141 -4" />
    </g>
    <g class="footer-sprig-berries">
      <circle cx="153" cy="22" r="4"/><circle cx="161" cy="17" r="3"/><circle cx="166" cy="29" r="2.8" />
      <circle cx="97" cy="91" r="3.3"/><circle cx="105" cy="97" r="2.5"/>
    </g>
  </svg>

  <div class="computers-footer-inner">
    <!-- Signature at the extreme left, followed by ONOCRA's three pelican values. -->
    <div class="footer-identity">
      <a class="footer-brand" href="/" aria-label="ONOCRA home">
        <img
          src="/phones/brand/faviconsignature.png"
          alt="ONOCRA O. signature"
          class="footer-signature"
          width="112"
          height="112"
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="footer-values" aria-label="ONOCRA values">
        <span>Caring</span>
        <span>Authenticity</span>
        <span>Perseverance</span>
      </div>
    </div>

    <!-- Six approved site links: font size doubled from the former 9px to 18px. -->
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/sitemap-index.xml">Sitemap</a>
      <a href="/archives/">Archives</a>
    </nav>

    <!-- Original social order retained; '#' placeholders await real profile URLs. -->
    <nav class="footer-socials" aria-label="ONOCRA social links">
      <a href="#" class="social-link social-x" aria-label="ONOCRA on X" title="X">𝕏</a>
      <a href="#" class="social-link" aria-label="ONOCRA on YouTube" title="YouTube">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>
      </a>
      <a href="#" class="social-link social-tiktok" aria-label="ONOCRA on TikTok" title="TikTok">♪</a>
      <a href="#" class="social-link" aria-label="ONOCRA on Pinterest" title="Pinterest">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0a12 12 0 0 0-4.4 23.2c-.1-1.9 0-4.1.5-6.1l1.5-6.3s-.4-.8-.4-2c0-1.9 1.1-3.3 2.5-3.3 1.2 0 1.7.9 1.7 2 0 1.2-.7 2.9-1.1 4.5-.3 1.3.7 2.4 2 2.4 2.4 0 4.2-2.5 4.2-6.1 0-3.2-2.3-5.4-5.6-5.4-3.8 0-6.1 2.9-6.1 5.8 0 1.2.4 2.4 1 3 .1.1.1.3.1.5l-.4 1.5c-.1.5-.5.6-.9.4-2.2-1-3.5-4.1-3.5-6.6C3.1 4.1 6.9 1 13.1 1c5.3 0 9.4 3.8 9.4 8.8 0 5.2-3.3 9.4-7.8 9.4-1.5 0-3-.8-3.4-1.7l-.9 3.6c-.3 1.3-1.3 2.9-1.9 3.8A12 12 0 1 0 12 0Z"/></svg>
      </a>
      <a href="#" class="social-link" aria-label="ONOCRA on Facebook" title="Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.3c0-3 1.8-4.7 4.6-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.3l-.5 3.5h-2.8v8.4A12 12 0 0 0 24 12Z"/></svg>
      </a>
      <a href="#" class="social-link" aria-label="ONOCRA on Instagram" title="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6Zm9.2 1.5a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 6.9a5.1 5.1 0 1 1 0 10.2 5.1 5.1 0 0 1 0-10.2Zm0 2a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2Z"/></svg>
      </a>
      <a href="mailto:hello@onocra.com" class="social-link" aria-label="Email ONOCRA" title="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3Zm0 2 9 6 9-6H3Zm19 2.4-9.4 6.3a1 1 0 0 1-1.2 0L2 8.4V17a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1V8.4Z"/></svg>
      </a>
    </nav>
  </div>
</footer>

<style>
  /* BP33 — homepage footer uses the exact approved header gradient in both themes.
     Full-bleed correction accounts for Layout.astro's 136px desktop sidebar;
     unlike percentage viewport offsets it reaches the actual left window edge. */
  .computers-footer {
    position: relative;
    isolation: isolate;
    z-index: 65;
    width: calc(100% + 136px);
    max-width: none;
    margin: 0 0 0 -136px;
    padding: 0;
    overflow: hidden;
    box-sizing: border-box;
    color: #173a2f;
    font-family: var(--font-manrope), Arial, sans-serif;
    background: linear-gradient(120deg, #fffaf0 0%, #fcfaf5 45%, #fbf7ed 100%);
    border-top: 2px solid #9ba892;
    box-shadow: 0 -2px 9px rgba(47, 54, 37, .08);
  }
  .computers-footer, .computers-footer * { box-sizing: border-box; }
  .computers-footer.no-margin-top { margin-top: 0; }

  /* Three positions repeat the botanical shapes of the homepage header. */
  .footer-botanical {
    position: absolute;
    width: 144px;
    height: 136px;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
    opacity: .31;
  }
  .footer-botanical--left   { left: -17px; bottom: -32px; transform: rotate(9deg); }
  .footer-botanical--middle { left: 49%; top: -35px; width: 118px; height: 114px; transform: rotate(7deg); opacity: .19; }
  .footer-botanical--right  { right: -20px; top: -25px; transform: scaleX(-1) rotate(8deg); }
  .footer-sprig-stem path { stroke: #98a57b; stroke-width: 1.6; fill: none; stroke-linecap: round; }
  .footer-sprig-leaves path { fill: #bac5a1; stroke: #9eaa86; stroke-width: .75; stroke-linejoin: round; }
  .footer-sprig-leaves path:nth-child(3n) { fill: #d2d8ba; }
  .footer-sprig-leaves path:nth-child(4n) { fill: #aab993; }
  .footer-sprig-veins path { fill: none; stroke: #899b78; stroke-width: .65; opacity: .58; }
  .footer-sprig-berries circle { fill: #c9ad74; stroke: #b59a66; stroke-width: .5; }

  /* All three footer groups share a single compact horizontal row on desktop. */
  .computers-footer-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 91px;
    padding: 9px 14px 9px 8px;
    display: grid;
    grid-template-columns: minmax(310px, 330px) minmax(465px, 1fr) minmax(260px, 264px);
    align-items: center;
    column-gap: 13px;
    row-gap: 6px;
  }
  .footer-identity { display: flex; align-items: center; justify-content: flex-start; min-width: 0; gap: 10px; }
  .footer-brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    padding-right: 10px;
    border-right: 1px solid rgba(157, 129, 70, .6);
    color: inherit;
    text-decoration: none;
    line-height: 1;
  }
  .footer-signature {
    display: block;
    width: 69px;
    height: 69px;
    max-width: none;
    object-fit: contain;
    filter: none;
  }
  .footer-values {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: 0;
    min-width: 0;
    white-space: nowrap;
    color: #1b6247;
    font-family: "Segoe Print", "Segoe Script", "Brush Script MT", Georgia, cursive;
    font-size: 14px;
    line-height: 1.3;
    font-style: italic;
    font-weight: 700;
    letter-spacing: -.02em;
  }
  .footer-values span { white-space: nowrap; }
  .footer-values span:not(:last-child)::after {
    content: "·";
    display: inline;
    margin: 0 5px;
    color: #b17a2e;
    border: 0;
  }

  /* Preserve approved 18px links, not the small BP31 prefooter typography. */
  .footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    min-width: 0;
    gap: 9px clamp(12px, 1.35vw, 21px);
    padding: 0;
  }
  .footer-links a {
    color: #173a2f;
    font-family: var(--font-manrope), Arial, sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    text-decoration: none;
    transition: color .15s ease;
  }
  .footer-links a:hover { color: #c26921; text-decoration: underline; text-underline-offset: 4px; }

  /* All SEVEN icons: explicit non-shrinking width and sufficient column space.
     +10% icon artwork vs BP32; 10.35px retains the enlarged group spacing. */
  .footer-socials {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 10.35px;
    min-width: max-content;
    padding: 0;
    overflow: visible;
  }
  .social-link {
    display: inline-grid;
    place-items: center;
    flex: 0 0 27px;
    width: 27px;
    height: 30px;
    min-width: 27px;
    opacity: 1;
    visibility: visible;
    line-height: 1;
    text-align: center;
    color: #173a2f;
    text-decoration: none;
    transition: color .15s ease, transform .15s ease;
  }
  .social-link svg {
    display: block;
    width: 18.2px;
    height: 18.2px;
    max-width: none;
    fill: currentColor;
    stroke: none;
  }
  .social-x { font: 500 20.6px/1 Arial, sans-serif; }
  .social-tiktok { font: 900 23px/1 Arial, sans-serif; }
  .social-link:hover { color: #c26921; transform: translateY(-2px); }
  .footer-brand:focus-visible, .footer-links a:focus-visible, .social-link:focus-visible {
    outline: 2px solid #b87924;
    outline-offset: 3px;
  }

  :global(html[data-theme="dark"]) .computers-footer,
  :global(html.dark) .computers-footer {
    background: linear-gradient(120deg, #1a252a, #222d31);
    border-top-color: #6e8578;
    color: #f0f5ec;
    box-shadow: 0 -2px 9px rgba(0,0,0,.2);
  }
  :global(html[data-theme="dark"]) .footer-botanical,
  :global(html.dark) .footer-botanical { opacity: .21; }
  :global(html[data-theme="dark"]) .footer-botanical--middle,
  :global(html.dark) .footer-botanical--middle { opacity: .15; }
  :global(html[data-theme="dark"]) .footer-sprig-leaves path,
  :global(html.dark) .footer-sprig-leaves path { fill: #92ad99; stroke: #b0c6af; }
  :global(html[data-theme="dark"]) .footer-sprig-leaves path:nth-child(3n),
  :global(html.dark) .footer-sprig-leaves path:nth-child(3n) { fill: #829c84; }
  :global(html[data-theme="dark"]) .footer-sprig-berries circle,
  :global(html.dark) .footer-sprig-berries circle { fill: #ceb477; }
  :global(html[data-theme="dark"]) .footer-brand,
  :global(html.dark) .footer-brand { border-right-color: rgba(220, 186, 112, .55); }
  :global(html[data-theme="dark"]) .footer-values,
  :global(html.dark) .footer-values { color: #f0d59a; }
  :global(html[data-theme="dark"]) .footer-links a,
  :global(html.dark) .footer-links a,
  :global(html[data-theme="dark"]) .social-link,
  :global(html.dark) .social-link { color: #eff4eb; }
  :global(html[data-theme="dark"]) .footer-links a:hover,
  :global(html.dark) .footer-links a:hover,
  :global(html[data-theme="dark"]) .social-link:hover,
  :global(html.dark) .social-link:hover { color: #ffcd83; }

  /* A second row is intentional on narrower devices rather than hiding icons. */
  @media (max-width: 1250px) {
    .computers-footer-inner {
      grid-template-columns: minmax(0, 1fr) max-content;
      min-height: 112px;
      padding: 10px 14px 10px 10px;
      column-gap: 12px;
      row-gap: 8px;
    }
    .footer-identity { grid-column: 1; grid-row: 1; }
    .footer-socials { grid-column: 2; grid-row: 1; }
    .footer-links { grid-column: 1 / -1; grid-row: 2; justify-content: center; }
  }
  @media (max-width: 899px) {
    /* Sidebar is absent here; the footer already spans the entire page. */
    .computers-footer { width: 100%; margin-left: 0; }
  }
  @media (max-width: 680px) {
    .computers-footer-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      padding: 12px 12px 14px;
      row-gap: 10px;
    }
    .footer-identity { grid-row: auto; grid-column: 1; justify-content: center; }
    .footer-signature { width: 57px; height: 57px; }
    .footer-values { font-size: 13.5px; }
    .footer-socials { grid-row: auto; grid-column: 1; justify-content: center; }
    .footer-links { grid-row: auto; grid-column: 1; justify-content: center; gap: 8px 14px; }
    .footer-links a { font-size: 18px; }
    .footer-botanical--middle { opacity: .12; }
  }
  @media (max-width: 390px) {
    .footer-values { font-size: 12px; }
    .footer-signature { width: 50px; height: 50px; }
    .footer-brand { padding-right: 7px; }
    .footer-identity { gap: 7px; }
    .footer-socials { gap: 5px; }
  }
</style>
