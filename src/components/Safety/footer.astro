<style>

  .safety-footer {
    width: 100%;
    border-top: 1px solid rgba(7, 61, 50, 0.12);
    background: #fff9ef;
  }


  .safety-footer-inner {
    width: min(100% - 32px, 1240px);
    min-height: 72px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 30px;
  }


  /* BRAND */

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    color: #073d32;
    text-decoration: none;
    line-height: 1;
  }


  .footer-wordmark {
    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }


  .footer-dot {
    color: #f56622;
  }


  .footer-tagline {
    margin-top: 4px;

    color: #5e6c70;

    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }


  /* LINKS */

  .footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;

    gap: 22px;
  }


  .footer-links a {
    color: #17334a;

    font-size: 10px;
    font-weight: 600;

    text-decoration: none;

    transition: color 0.15s ease;
  }


  .footer-links a:hover {
    color: #14624d;

    text-decoration: underline;
    text-underline-offset: 3px;
  }


  /* SOCIALS */

  .footer-socials {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 11px;
  }


  .social-link {
    width: 19px;
    height: 19px;

    display: grid;
    place-items: center;

    color: #102a43;
    text-decoration: none;

    transition:
      color 0.15s ease,
      transform 0.15s ease;
  }


  .social-link:hover {
    color: #14624d;

    transform: translateY(-1px);
  }


  .social-link svg {
    width: 17px;
    height: 17px;

    fill: currentColor;
  }


  .social-x {
    font-family: Arial, sans-serif;
    font-size: 19px;
    font-weight: 500;
  }


  .social-tiktok {
    font-family: Arial, sans-serif;
    font-size: 22px;
    font-weight: 900;
  }


  /* ========================================
     DARK APPEARANCE
  ========================================= */

  :global(
    html[data-onocra-appearance="darker"]
    .safety-footer
  ) {
    border-top-color: #343d48;
    background: #181e26;
  }


  :global(
    html[data-onocra-appearance="darker"]
    .footer-wordmark
  ) {
    color: #fff8ed;
  }


  :global(
    html[data-onocra-appearance="darker"]
    .footer-tagline
  ) {
    color: #aab2bc;
  }


  :global(
    html[data-onocra-appearance="darker"]
    .footer-links a
  ) {
    color: #dce2e7;
  }


  :global(
    html[data-onocra-appearance="darker"]
    .footer-links a:hover
  ) {
    color: #9fd4bf;
  }


  :global(
    html[data-onocra-appearance="darker"]
    .social-link
  ) {
    color: #f5f3ed;
  }


  :global(
    html[data-onocra-appearance="darker"]
    .social-link:hover
  ) {
    color: #9fd4bf;
  }


  /* ========================================
     TABLET
  ========================================= */

  @media (max-width: 900px) {

    .safety-footer-inner {
      grid-template-columns: auto 1fr;

      gap: 16px 24px;

      padding: 16px 0;
    }


    .footer-links {
      justify-content: flex-end;

      gap: 14px;
    }


    .footer-socials {
      grid-column: 1 / -1;

      justify-content: center;
    }

  }


  /* ========================================
     MOBILE
  ========================================= */

  @media (max-width: 600px) {

    .safety-footer-inner {
      width: min(100% - 30px, 1240px);

      min-height: 0;

      grid-template-columns: 1fr;

      gap: 14px;

      padding: 20px 0 22px;
    }


    .footer-brand {
      align-items: center;
    }


    .footer-wordmark {
      font-size: 23px;
    }


    .footer-tagline {
      font-size: 9px;
    }


    .footer-links {
      justify-content: center;

      gap: 10px 18px;
    }


    .footer-links a {
      font-size: 10px;
    }


    .footer-socials {
      grid-column: auto;

      justify-content: center;

      gap: 15px;
    }


    .social-link {
      width: 22px;
      height: 22px;
    }


    .social-link svg {
      width: 18px;
      height: 18px;
    }

  }

</style>
