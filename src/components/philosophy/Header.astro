---
/**
 * ONOCRA Core Philosophy header
 * Target: src/components/philosophy/Header.astro
 *
 * Uses the approved Core Philosophy header/sidebar visual system:
 * horizontal ONOCRA logo, botanical treatment, Search + Theme controls,
 * compact four-part navigation and the same page-only sidebar geometry.
 *
 * Navigation is page-specific for the Core Philosophy page.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const homeURL = url("");
const searchURL = url("search");

const journeyGroups = [
  {
    id: "why",
    label: "WHY ONOCRA",
    title: "Why ONOCRA Exists",
    summary: "The belief behind caring, practical technology guidance.",
    links: [
      { label: "Our Core Philosophy", path: "/philosophy/" },
      { label: "Technology Should Help People", path: "/philosophy/#what-we-stand-for" },
      { label: "Why It Matters", path: "/philosophy/#why-it-matters" },
    ],
  },
  {
    id: "symbol",
    label: "OUR SYMBOL",
    title: "The Pelican and Four Chicks",
    summary: "The meaning behind ONOCRA’s care, guidance and protection.",
    links: [
      { label: "Meaning of Our Logo", path: "/philosophy/#meaning-of-logo" },
      { label: "See Our Philosophy in Motion", path: "/philosophy/#philosophy-video" },
      { label: "One Caring Guide", path: "/philosophy/#meaning-of-logo" },
    ],
  },
  {
    id: "ways",
    label: "FOUR WAYS",
    title: "Fix · Decode · Compare · Choose",
    summary: "The four working principles behind ONOCRA guidance.",
    links: [
      { label: "Four Simple Ways We Help", path: "/philosophy/#four-ways" },
      { label: "How Our Philosophy Guides Our Work", path: "/philosophy/#how-we-work" },
      { label: "Explore ONOCRA", path: "/philosophy/#explore-onocra" },
    ],
  },
  {
    id: "promise",
    label: "OUR PROMISE",
    title: "Human, Calm and Useful",
    summary: "The standard we aim to bring to every ONOCRA experience.",
    links: [
      { label: "The ONOCRA Promise", path: "/philosophy/#onocra-promise" },
      { label: "Why It Matters", path: "/philosophy/#why-it-matters" },
      { label: "Back to ONOCRA Home", path: "/" },
    ],
  },
];

const sidebarLinks = [
  { icon: "⌂", label: "Home", path: homeURL },
  { icon: "◎", label: "Our Core Philosophy", path: "/philosophy/" },
  { icon: "▶", label: "Philosophy in Motion", path: "/philosophy/#philosophy-video" },
  { icon: "✦", label: "What ONOCRA Stands For", path: "/philosophy/#what-we-stand-for" },
  { icon: "◉", label: "Meaning of Our Logo", path: "/philosophy/#meaning-of-logo" },
  { icon: "4", label: "Four Simple Ways We Help", path: "/philosophy/#four-ways" },
  { icon: "✓", label: "How Our Philosophy Guides Our Work", path: "/philosophy/#how-we-work" },
  { icon: "?", label: "Why It Matters", path: "/philosophy/#why-it-matters" },
  { icon: "◆", label: "The ONOCRA Promise", path: "/philosophy/#onocra-promise" },
  { icon: "➜", label: "Explore ONOCRA", path: "/philosophy/#explore-onocra" },
  { icon: "✉", label: "Contact", path: "/contact/" },
];
