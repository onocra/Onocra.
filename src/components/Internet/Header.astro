<script>
  // One delegated set of listeners for the whole site. The guard stops double-binding,
  // and delegation keeps everything working after ClientRouter page swaps.
  const w = window as unknown as { __onocraHubBar?: boolean; __theme?: { value: string } };
  if (!w.__onocraHubBar) {
    w.__onocraHubBar = true;

    const closeAll = (except?: Element | null) => {
      document.querySelectorAll<HTMLElement>('[data-hb-toggle][aria-expanded="true"]').forEach((btn) => {
        if (btn === except) return;
        btn.setAttribute("aria-expanded", "false");
        document.getElementById(btn.getAttribute("aria-controls") || "")?.setAttribute("hidden", "");
      });
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      // Keep only one desktop journey dropdown open and close it after navigation.
      const journeySummary = target.closest<HTMLElement>(".ph-journey-button");
      if (journeySummary) {
        const current = journeySummary.closest<HTMLDetailsElement>(".ph-journey-group");
        document.querySelectorAll<HTMLDetailsElement>(".ph-journey-group[open]").forEach((d) => { if (d !== current) d.open = false; });
      }
      if (target.closest(".ph-journey-dropdown a")) {
        target.closest<HTMLDetailsElement>(".ph-journey-group")?.removeAttribute("open");
      }

      const toggle = target.closest<HTMLElement>("[data-hb-toggle]");
      if (toggle) {
        const wasOpen = toggle.getAttribute("aria-expanded") === "true";
        closeAll();
        if (!wasOpen) {
          toggle.setAttribute("aria-expanded", "true");
          document.getElementById(toggle.getAttribute("aria-controls") || "")?.removeAttribute("hidden");
        }
        return;
      }

      if (target.closest("[data-hb-theme]")) {
        // The existing src/scripts/theme.ts binds to #theme-btn and owns this action.
        return;
      }

      // clicking a link inside a panel, or anywhere outside one, closes the open panel
      if (target.closest(".hb-panel a") || !target.closest(".hb-panel")) closeAll();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = document.querySelector<HTMLElement>('[data-hb-toggle][aria-expanded="true"]');
      closeAll();
      open?.focus();
    });

    document.addEventListener("astro:before-swap", () => closeAll());
  }
</script>

<script>
  // Sidebar section highlighting is page-only; independent of the shared menu handler.
  const phBP18 = window as unknown as { __onocraPhonesSidebarBP18?: boolean };
  if (!phBP18.__onocraPhonesSidebarBP18) {
    phBP18.__onocraPhonesSidebarBP18 = true;
    const refreshActive = () => {
      const hash = window.location.hash;
      document.querySelectorAll<HTMLAnchorElement>(".ph-sidebar [data-ph-side-link]").forEach(a => {
        const active = !!hash && a.getAttribute("href") === hash;
        a.classList.toggle("active", active);
        if(active) a.setAttribute("aria-current", "location"); else a.removeAttribute("aria-current");
      });
    };
    window.addEventListener("hashchange", refreshActive);
    document.addEventListener("astro:page-load", refreshActive);
    refreshActive();
  }


  // BP72 — journey accordion behaviour is intentionally independent of the
  // legacy hubbar guard above. Opening one stage always closes the other three.
  // Clicking outside the journey navigation, choosing a destination, or Escape
  // also closes any open journey menu.
  const journeyState = window as unknown as { __onocraJourneyAccordion?: boolean };
  if (!journeyState.__onocraJourneyAccordion) {
    journeyState.__onocraJourneyAccordion = true;

    const journeyGroups = () =>
      Array.from(document.querySelectorAll<HTMLDetailsElement>(".ph-journey-group"));

    journeyGroups().forEach((group) => {
      group.addEventListener("toggle", () => {
        if (!group.open) return;
        journeyGroups().forEach((other) => {
          if (other !== group) other.open = false;
        });
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.closest(".ph-journey-dropdown a")) {
        journeyGroups().forEach((group) => { group.open = false; });
        return;
      }
      if (!target.closest(".ph-journey-nav")) {
        journeyGroups().forEach((group) => { group.open = false; });
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openGroup = document.querySelector<HTMLDetailsElement>(".ph-journey-group[open]");
      const summary = openGroup?.querySelector<HTMLElement>("summary");
      journeyGroups().forEach((group) => { group.open = false; });
      summary?.focus();
    });
  }
</script>

