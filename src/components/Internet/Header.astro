---
/**
 * ONOCRA Internet & Wi-Fi header — based on the approved BP39 Phones hub shell.
 * Copies the homepage header's visual system (BP11), keeping its horizontal
 * logo, Search and Theme control; replaces four hub pills with breadcrumbs.
 * Adds page-only navigation using the homepage sidebar's EXACT class system
 * and 15% wider (156.4px) sidebar. No changes to Layout.astro or BP17 index content.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const homeURL = url("");
const searchURL = url("search");

const links = [
  {label: "Home", path: homeURL, icon: '<path d="m3 11 9-8 9 8M5 10v10h14V10M9 20v-6h6v6" />'},
  {label: "Explore Connections", path: "#device-heading", icon: '<path d="M2 8a15 15 0 0 1 20 0M5 12a10 10 0 0 1 14 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="20" r="1"/>'},
  {label: "Quick Help", path: "#quick-help", icon: '<circle cx="12" cy="12" r="10"/><path d="M9 9a3 3 0 0 1 6 0c0 2-3 3-3 5M12 18h.01" />'},
  {label: "Diagnostics & Guides", path: "#guides-heading", icon: '<path d="m14.7 6.3-8.5 8.5M3 17l4 4M13 3l8 8M13 3v5h5" />'},
  {label: "Digital Parenting", path: "#parenting-heading", icon: '<circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2 20c.5-4 3-6 6-6s5.5 2 6 6M13 15c4-3 8 0 9 4" />'},
  {label: "Latest & Learning", path: "#editorial-latest-heading", icon: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h8M8 15h5" />'},
  {label: "Reviews & Comparisons", path: "#reviews", icon: '<path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5" />'},
  {label: "Choose", path: "#choose", icon: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6" />'},
  {label: "ONOCRA Routes", path: "#onocra-route", icon: '<path d="M4 6h11m-3-3 3 3-3 3M20 18H9m3-3-3 3 3 3M6 6v12" />'},
  {label: "Useful Now", path: "#useful-now", icon: '<path d="m12 3 2.8 6 6.7.7-5 4.6 1.5 6.7-6-3.4-6 3.4 1.5-6.7-5-4.6L9.2 9Z" />'},
];
---
<header class="hubbar ph-hub-header" data-hubbar>
  <svg class="hb-leaves hb-leaves--left" viewBox="0 0 180 170" aria-hidden="true" focusable="false">
  <g class="internet-net-lines" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 151 C24 125 39 115 66 106 S111 73 151 18" />
    <path d="M16 142 Q48 151 70 120 Q92 89 123 86" />
    <path d="M60 109 Q60 65 91 42" />
    <path d="M88 96 Q110 113 154 96" />
    <path d="M22 108 Q45 83 68 108" />
    <path d="M29 100 Q45 86 60 100" />
    <path d="M36 95 Q45 88 53 95" />
    <path d="M105 53 Q123 29 143 53" />
    <path d="M110 47 Q123 33 138 47" />
    <path d="M116 43 Q123 37 131 43" />
  </g>
  <g class="internet-net-nodes">
    <circle cx="8" cy="151" r="4"/><circle cx="66" cy="106" r="5"/>
    <circle cx="91" cy="42" r="4"/><circle cx="123" cy="86" r="4"/>
    <circle cx="151" cy="18" r="5"/><circle cx="154" cy="96" r="4"/>
    <circle cx="45" cy="92" r="3"/><circle cx="123" cy="40" r="3"/>
  </g>
  </svg>
  <svg class="hb-leaves hb-leaves--mid" viewBox="0 0 180 170" aria-hidden="true" focusable="false">
  <g class="internet-net-lines" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 151 C24 125 39 115 66 106 S111 73 151 18" />
    <path d="M16 142 Q48 151 70 120 Q92 89 123 86" />
    <path d="M60 109 Q60 65 91 42" />
    <path d="M88 96 Q110 113 154 96" />
    <path d="M22 108 Q45 83 68 108" />
    <path d="M29 100 Q45 86 60 100" />
    <path d="M36 95 Q45 88 53 95" />
    <path d="M105 53 Q123 29 143 53" />
    <path d="M110 47 Q123 33 138 47" />
    <path d="M116 43 Q123 37 131 43" />
  </g>
  <g class="internet-net-nodes">
    <circle cx="8" cy="151" r="4"/><circle cx="66" cy="106" r="5"/>
    <circle cx="91" cy="42" r="4"/><circle cx="123" cy="86" r="4"/>
    <circle cx="151" cy="18" r="5"/><circle cx="154" cy="96" r="4"/>
    <circle cx="45" cy="92" r="3"/><circle cx="123" cy="40" r="3"/>
  </g>
  </svg>
  <svg class="hb-leaves hb-leaves--right" viewBox="0 0 180 170" aria-hidden="true" focusable="false">
  <g class="internet-net-lines" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8 151 C24 125 39 115 66 106 S111 73 151 18" />
    <path d="M16 142 Q48 151 70 120 Q92 89 123 86" />
    <path d="M60 109 Q60 65 91 42" />
    <path d="M88 96 Q110 113 154 96" />
    <path d="M22 108 Q45 83 68 108" />
    <path d="M29 100 Q45 86 60 100" />
    <path d="M36 95 Q45 88 53 95" />
    <path d="M105 53 Q123 29 143 53" />
    <path d="M110 47 Q123 33 138 47" />
    <path d="M116 43 Q123 37 131 43" />
  </g>
  <g class="internet-net-nodes">
    <circle cx="8" cy="151" r="4"/><circle cx="66" cy="106" r="5"/>
    <circle cx="91" cy="42" r="4"/><circle cx="123" cy="86" r="4"/>
    <circle cx="151" cy="18" r="5"/><circle cx="154" cy="96" r="4"/>
    <circle cx="45" cy="92" r="3"/><circle cx="123" cy="40" r="3"/>
  </g>
  </svg>


  <div class="hb-utility-row">
    <a href={homeURL} class="hb-logo" aria-label="ONOCRA Home — TechnoNavigation Made Easy">
      <!-- Same approved dual-artwork approach as the locked homepage header. -->
      <img class="hb-logo-light" src="/Header/logonamehero.png" alt="ONOCRA — TechnoNavigation Made Easy" width="2048" height="682" loading="eager" decoding="async" />
      <img class="hb-logo-dark" src="/Header/logonamehero-dark.png" alt="" aria-hidden="true" width="2172" height="724" loading="eager" decoding="async" />
    </a>
    <div class="hb-tools">
      <form class="hb-search" action={searchURL} method="get" role="search">
        <label class="hb-sr" for="hb-q">Search ONOCRA</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2"></path></svg>
        <input id="hb-q" name="q" type="search" placeholder="Search…" autocomplete="off" />
      </form>
      <button id="theme-btn" type="button" class="hb-icon" aria-label="Switch between light and dark theme" title="Change appearance">
        <svg class="hb-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path></svg>
        <svg class="hb-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path></svg>
      </button>
      <button type="button" class="hb-icon hb-menu-button" data-hb-toggle aria-expanded="false" aria-controls="hb-menu" aria-label="Open Home Internet and Wi-Fi navigation">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
  <div class="hb-nav-row">
    <nav class="ph-breadcrumb" aria-label="Breadcrumb">
      <a href={homeURL} class="ph-crumb-home">Home</a>
      <span class="ph-crumb-chevron" aria-hidden="true">›</span>
      <span aria-current="page" class="ph-crumb-current">Home Internet &amp; Wi-Fi</span>
    </nav>
  </div>
  <nav class="hb-panel hb-menu ph-mobile-nav" id="hb-menu" aria-label="Home Internet and Wi-Fi navigation" hidden>
    {links.map((item) => (
      <a href={item.path}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
</header>

<!-- Page-only sidebar. Layout's original sidebar remains unchanged on all other pages. -->
<aside class="onocra-sidebar ph-sidebar" aria-label="Home Internet and Wi-Fi section navigation">
  <svg class="ph-sidebar-leaf internet-sidebar-decor" viewBox="0 0 136 280" aria-hidden="true" focusable="false">
    <path class="internet-net-lines" d="M20 260Q90 225 60 168T106 16M21 175Q60 137 106 164M56 95Q22 61 42 20" fill="none" stroke="currentColor" stroke-width="2"/>
    <g class="internet-net-nodes"><circle cx="20" cy="260" r="6"/><circle cx="60" cy="168" r="5"/><circle cx="106" cy="16" r="5"/><circle cx="21" cy="175" r="4"/><circle cx="106" cy="164" r="4"/><circle cx="42" cy="20" r="4"/></g>
    <path d="M48 115Q65 95 82 115M53 110Q65 99 76 110M59 105Q65 102 70 105" stroke="currentColor" fill="none" stroke-width="3" stroke-linecap="round"/>
  </svg>
  <div class="onocra-sidebar-inner">
    <nav class="onocra-sidebar-nav" aria-label="Home Internet and Wi-Fi links">
      {links.map((item) => (
        <a href={item.path} data-ph-side-link>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
          <span class="onocra-sidebar-nav-label">{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</aside>

<style is:global>
  .hubbar {
    --hb-bg: rgba(255, 250, 241, 0.9);
    --hb-surface: var(--on-surface);
    --hb-border: var(--on-line);
    --hb-text: var(--on-ink);
    --hb-muted: var(--on-muted);
    --hb-brand: var(--on-forest);
    --hb-accent: var(--on-accent-text);
    --hb-hover: var(--on-surface-2);
    position: sticky;
    top: 0;
    z-index: 45;
    background: var(--hb-bg);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--hb-border);
    box-shadow: 0 10px 24px -20px rgba(20, 35, 43, 0.45);
    color: var(--hb-text);
    font-family: var(--on-sans);
  }
  html[data-theme="dark"] .hubbar {
    --hb-bg: rgba(24, 31, 40, 0.88);
  }
  .hubbar *,
  .hubbar *::before,
  .hubbar *::after {
    box-sizing: border-box;
  }
  .hubbar svg {
    width: 18px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hubbar a {
    color: inherit;
    text-decoration: none;
  }
  .hubbar button:not(.hb-pill) {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  /* Hub buttons set their own controlled type size rather than inheriting the
     page font. The former generic .hubbar button rule overrode .hb-pill. */
  .hubbar button.hb-pill {
    font-family: var(--font-manrope), Arial, sans-serif;
    font-size: clamp(10px, .73vw, 11px);
    font-weight: 700;
    color: #1d322b;
    cursor: pointer;
  }
  .hubbar :focus-visible {
    outline: 3px solid var(--on-ring);
    outline-offset: 2px;
  }
  .hb-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hb-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    padding: 9px 20px;
    min-height: 58px;
  }

  /* ---------- hub pills ---------- */
  .hb-hubs {
    display: flex;
    gap: 6px;
    min-width: 0;
  }
  .hb-hub {
    position: relative;
  }
  .hb-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 12px 0 6px;
    border-radius: 999px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: -0.005em;
    white-space: nowrap;
    box-shadow: var(--on-shadow-sm);
    transition: background-color 0.15s, border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .hb-pill:hover {
    border-color: color-mix(in srgb, var(--hub) 55%, var(--hb-border));
    transform: translateY(-1px);
    box-shadow: 0 6px 14px -8px color-mix(in srgb, var(--hub) 60%, transparent);
  }
  .hb-pill[aria-expanded="true"] {
    background: color-mix(in srgb, var(--hub) 10%, var(--hb-surface));
    border-color: var(--hub);
    transform: none;
  }
  .hb-pill.is-active {
    border-color: var(--hub);
    box-shadow: inset 0 0 0 1px var(--hub);
  }
  .hb-ico {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--hub);
    background: color-mix(in srgb, var(--hub) 14%, transparent);
  }
  .hb-ico svg {
    width: 16px;
    height: 16px;
  }
  .hb-chev {
    width: 14px !important;
    height: 14px !important;
    color: var(--hb-muted);
    transition: transform 0.18s;
  }
  .hb-pill[aria-expanded="true"] .hb-chev {
    transform: rotate(180deg);
  }

  /* ---------- dropdowns ---------- */
  .hb-panel[hidden] {
    display: none;
  }
  @keyframes hb-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hb-drop {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    width: 300px;
    padding: 14px 12px 12px;
    background: var(--hb-surface);
    border: 1px solid var(--hb-border);
    border-top: 3px solid var(--hub);
    border-radius: 16px;
    box-shadow: var(--on-shadow-pop);
    animation: hb-in 0.16s ease-out;
  }
  .hb-drop-title {
    margin: 0 6px 10px;
    font-family: var(--on-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .hb-actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .hb-act {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 12px;
    padding: 8px 8px;
    border-radius: 12px;
    transition: background-color 0.12s;
  }
  .hb-act:hover {
    background: var(--hb-hover);
  }
  .hb-act-ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    color: var(--hub);
    background: color-mix(in srgb, var(--hub) 12%, transparent);
  }
  .hb-act-txt {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .hb-act-txt strong {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
  }
  .hb-act-txt span {
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--hb-muted);
  }
  .hb-go {
    width: 14px !important;
    height: 14px !important;
    color: var(--hb-muted);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.12s, transform 0.12s;
  }
  .hb-act:hover .hb-go,
  .hb-act:focus-visible .hb-go {
    opacity: 1;
    transform: none;
  }
  .hb-extras {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin: 8px 6px 0;
    padding-top: 10px;
    border-top: 1px solid var(--hb-border);
  }
  .hb-extras span {
    flex: 1 1 100%;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hb-muted);
  }
  .hb-extras a {
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    font-size: 12px;
    font-weight: 600;
  }
  .hb-extras a:hover {
    background: var(--hb-hover);
    border-color: var(--hb-brand);
  }
  .hb-all {
    display: block;
    margin: 8px 6px 0;
    padding-top: 11px;
    border-top: 1px solid var(--hb-border);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--hb-brand);
  }
  .hb-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- tools ---------- */
  .hb-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hb-latest {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: var(--on-shadow-sm);
    transition: background-color 0.15s;
  }
  .hb-latest:hover {
    background: var(--hb-hover);
  }
  .hb-search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .hb-search svg {
    position: absolute;
    left: 13px;
    color: var(--hb-muted);
    pointer-events: none;
  }
  .hb-search input {
    width: 200px;
    height: 40px;
    padding: 0 14px 0 38px;
    border-radius: 999px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    color: var(--hb-text);
    font: inherit;
    font-size: 13.5px;
    box-shadow: var(--on-shadow-sm);
    transition: width 0.2s, border-color 0.15s;
  }
  .hb-search input:focus {
    width: 260px;
    border-color: var(--hb-brand);
    outline: 3px solid var(--on-ring);
    outline-offset: 0;
  }
  .hb-search input::placeholder {
    color: var(--hb-muted);
  }
  .hb-icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    box-shadow: var(--on-shadow-sm);
    transition: background-color 0.15s;
  }
  .hb-icon:hover {
    background: var(--hb-hover);
  }
  .hb-moon {
    display: none;
  }
  html[data-theme="dark"] .hb-sun {
    display: none;
  }
  html[data-theme="dark"] .hb-moon {
    display: block;
  }

  /* ---------- mobile bits ---------- */
  .hb-mobile {
    display: none;
    align-items: center;
    gap: 10px;
  }
  .hb-brand {
    font-family: var(--on-display);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--hb-brand);
  }
  .hubbar .hb-panel[hidden] { display: none !important; }
  .hb-menu {
    display: grid;
    gap: 2px;
    padding: 8px;
    background: var(--hb-surface);
    border-top: 1px solid var(--hb-border);
  }
  .hb-menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 14.5px;
    font-weight: 600;
  }
  .hb-menu a:hover {
    background: var(--hb-hover);
  }

  /* ---------- breakpoints ---------- */
  @media (max-width: 1180px) {
    .hb-latest span {
      display: none;
    }
    .hb-latest {
      width: 40px;
      padding: 0;
      justify-content: center;
    }
    .hb-search input:focus {
      width: 200px;
    }
  }
  @media (max-width: 899px) {
    .hb-row {
      padding: 8px 14px;
    }
    .hb-mobile {
      display: flex;
    }
    .hb-latest {
      display: none;
    }
    .hb-search input,
    .hb-search input:focus {
      width: 140px;
    }
    .hb-hubs {
      order: 3;
      flex: 1 1 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .hb-hub {
      position: static;
    }
    .hb-pill {
      width: 100%;
    }
    .hb-name {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hb-chev {
      margin-left: auto;
    }
    .hb-drop {
      left: 8px;
      right: 8px;
      width: auto;
      top: 100%;
      margin-top: 4px;
    }
  }
  @media (min-width: 900px) {
    .hb-menu {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hubbar *,
    .hb-drop {
      transition: none !important;
      animation: none !important;
    }
  }

  /* -------------------------------------------------------------
   * BP05: approved spacious, full-width fixed header.
   * Logo left, utility buttons at top right, four hubs below/right.
   * Matches ivory site canvas; leaves are low-contrast decoration.
   * ------------------------------------------------------------- */
  :root { --onocra-header-height: 150px; --onocra-sidebar-width: 188px; }
  .hubbar {
    position: fixed;
    inset: 0 0 auto 0;
    width: 100%;
    height: var(--onocra-header-height);
    z-index: 150;
    overflow: visible;
    background: linear-gradient(120deg, #fffaf0 0%, #fcfaf5 45%, #fbf7ed 100%);
    border-bottom: 1px solid #ded9cd;
    box-shadow: 0 3px 12px rgba(47, 54, 37, .06);
    backdrop-filter: none;
    color: #173a2f;
  }
  html[data-theme="dark"] .hubbar {
    background: linear-gradient(120deg, #1a252a, #222d31);
    border-color: #3d4c49;
  }
  .hb-leaves {
    position: absolute; top: 0; width: 140px; height: 142px;
