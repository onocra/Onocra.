---
/**
 * ONOCRA Internet & Wi-Fi header — based on the approved BP39 Phones hub shell.
 * Copies the homepage header's visual system (BP11), keeping its horizontal
 * logo, Search and Theme control; replaces four hub pills with breadcrumbs.
 * Adds page-only navigation using the homepage sidebar's EXACT class system
 * and 15% wider (156.4px) sidebar. No changes to Layout.astro or BP17 index content.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const homeURL = url("");
const searchURL = url("search");

const journeyGroups = [
  {
    id: "fix",
    label: "FIX",
    title: "Fix Your Home Internet & Wi-Fi",
    summary: "Troubleshoot connection, coverage and setup problems.",
    links: [
      { label: "How can ONOCRA help you today?", path: "#ask-heading" },
      { label: "Quick Help", path: "#quick-help" },
      { label: "Diagnostics & Guides", path: "#guides-heading" },
    ],
  },
  {
    id: "decode",
    label: "DECODE",
    title: "Understand Internet & Wi-Fi",
    summary: "Build the know-how before comparing your options.",
    links: [
      { label: "Internet & Wi-Fi Technology", path: "#device-heading" },
      { label: "Guides", path: "#guides-heading" },
      { label: "Latest from ONOCRA", path: "#editorial-latest-heading" },
      { label: "Digital Security & Parenting", path: "#parenting-heading" },
    ],
  },
  {
    id: "compare",
    label: "COMPARE",
    title: "Compare Your Options",
    summary: "Compare service, equipment, value, safety and family fit.",
    links: [
      { label: "Reviews & Comparisons", path: "#reviews" },
      { label: "Compare Home Internet", path: "/internet/reviews/?category=internet" },
      { label: "Compare Wi-Fi & Mesh", path: "/internet/reviews/?category=wifi" },
      { label: "Compare Internet + Wi-Fi", path: "/internet/reviews/?category=both" },
    ],
  },
  {
    id: "choose",
    label: "CHOOSE",
    title: "Choose What You Buy",
    summary: "Move from comparison to the right household solution.",
    links: [
      { label: "Choose Your Connection", path: "#choose" },
      { label: "Internet Service & Providers", path: "#onocra-route" },
      { label: "Wi-Fi & Mesh Equipment", path: "#choose" },
      { label: "Internet + Wi-Fi Together", path: "#choose" },
    ],
  },
];

const sidebarLinks = [
  { label: "Home", path: homeURL },
  { label: "ONOCRA Help", path: "#ask-heading" },
  { label: "Explore Your Connections", path: "#device-heading" },
  { label: "Quick Help", path: "#quick-help" },
  { label: "Practical Answers", path: "#quick-help" },
  { label: "Diagnostics & Guides", path: "#guides-heading" },
  { label: "Latest from ONOCRA", path: "#editorial-latest-heading" },
  { label: "Digital Parenting", path: "#parenting-heading" },
  { label: "Reviews & Comparisons", path: "#reviews" },
  { label: "Choose the Right Connection", path: "#choose" },
  { label: "Stay in the Loop", path: "#phones-loop-heading" },
  { label: "Contact", path: "/contact/" },
];
