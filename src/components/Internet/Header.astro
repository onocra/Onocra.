<style is:global>
  .hubbar {
    --hb-bg: rgba(255, 250, 241, 0.9);
    --hb-surface: var(--on-surface);
    --hb-border: var(--on-line);
    --hb-text: var(--on-ink);
    --hb-muted: var(--on-muted);
    --hb-brand: var(--on-forest);
    --hb-accent: var(--on-accent-text);
    --hb-hover: var(--on-surface-2);
    position: sticky;
    top: 0;
    z-index: 45;
    background: var(--hb-bg);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--hb-border);
    box-shadow: 0 10px 24px -20px rgba(20, 35, 43, 0.45);
    color: var(--hb-text);
    font-family: var(--on-sans);
  }
  html[data-theme="dark"] .hubbar {
    --hb-bg: rgba(24, 31, 40, 0.88);
  }
  .hubbar *,
  .hubbar *::before,
  .hubbar *::after {
    box-sizing: border-box;
  }
  .hubbar svg {
    width: 18px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hubbar a {
    color: inherit;
    text-decoration: none;
  }
  .hubbar button:not(.hb-pill) {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  /* Hub buttons set their own controlled type size rather than inheriting the
     page font. The former generic .hubbar button rule overrode .hb-pill. */
  .hubbar button.hb-pill {
    font-family: var(--font-manrope), Arial, sans-serif;
    font-size: clamp(10px, .73vw, 11px);
    font-weight: 700;
    color: #1d322b;
    cursor: pointer;
  }
  .hubbar :focus-visible {
    outline: 3px solid var(--on-ring);
    outline-offset: 2px;
  }
  .hb-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hb-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    padding: 9px 20px;
    min-height: 58px;
  }

  /* ---------- hub pills ---------- */
  .hb-hubs {
    display: flex;
    gap: 6px;
    min-width: 0;
  }
  .hb-hub {
    position: relative;
  }
  .hb-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 12px 0 6px;
    border-radius: 999px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: -0.005em;
    white-space: nowrap;
    box-shadow: var(--on-shadow-sm);
    transition: background-color 0.15s, border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .hb-pill:hover {
    border-color: color-mix(in srgb, var(--hub) 55%, var(--hb-border));
    transform: translateY(-1px);
    box-shadow: 0 6px 14px -8px color-mix(in srgb, var(--hub) 60%, transparent);
  }
  .hb-pill[aria-expanded="true"] {
    background: color-mix(in srgb, var(--hub) 10%, var(--hb-surface));
    border-color: var(--hub);
    transform: none;
  }
  .hb-pill.is-active {
    border-color: var(--hub);
    box-shadow: inset 0 0 0 1px var(--hub);
  }
  .hb-ico {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--hub);
    background: color-mix(in srgb, var(--hub) 14%, transparent);
  }
  .hb-ico svg {
    width: 16px;
    height: 16px;
  }
  .hb-chev {
    width: 14px !important;
    height: 14px !important;
    color: var(--hb-muted);
    transition: transform 0.18s;
  }
  .hb-pill[aria-expanded="true"] .hb-chev {
    transform: rotate(180deg);
  }

  /* ---------- dropdowns ---------- */
  .hb-panel[hidden] {
    display: none;
  }
  @keyframes hb-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hb-drop {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    width: 300px;
    padding: 14px 12px 12px;
    background: var(--hb-surface);
    border: 1px solid var(--hb-border);
    border-top: 3px solid var(--hub);
    border-radius: 16px;
    box-shadow: var(--on-shadow-pop);
    animation: hb-in 0.16s ease-out;
  }
  .hb-drop-title {
    margin: 0 6px 10px;
    font-family: var(--on-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .hb-actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .hb-act {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 12px;
    padding: 8px 8px;
    border-radius: 12px;
    transition: background-color 0.12s;
  }
  .hb-act:hover {
    background: var(--hb-hover);
  }
  .hb-act-ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    color: var(--hub);
    background: color-mix(in srgb, var(--hub) 12%, transparent);
  }
  .hb-act-txt {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .hb-act-txt strong {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
  }
  .hb-act-txt span {
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--hb-muted);
  }
  .hb-go {
    width: 14px !important;
    height: 14px !important;
    color: var(--hb-muted);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.12s, transform 0.12s;
  }
  .hb-act:hover .hb-go,
  .hb-act:focus-visible .hb-go {
    opacity: 1;
    transform: none;
  }
  .hb-extras {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin: 8px 6px 0;
    padding-top: 10px;
    border-top: 1px solid var(--hb-border);
  }
  .hb-extras span {
    flex: 1 1 100%;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hb-muted);
  }
  .hb-extras a {
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    font-size: 12px;
    font-weight: 600;
  }
  .hb-extras a:hover {
    background: var(--hb-hover);
    border-color: var(--hb-brand);
  }
  .hb-all {
    display: block;
    margin: 8px 6px 0;
    padding-top: 11px;
    border-top: 1px solid var(--hb-border);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--hb-brand);
  }
  .hb-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- tools ---------- */
  .hb-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hb-latest {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: var(--on-shadow-sm);
    transition: background-color 0.15s;
  }
  .hb-latest:hover {
    background: var(--hb-hover);
  }
  .hb-search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .hb-search svg {
    position: absolute;
    left: 13px;
    color: var(--hb-muted);
    pointer-events: none;
  }
  .hb-search input {
    width: 200px;
    height: 40px;
    padding: 0 14px 0 38px;
    border-radius: 999px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    color: var(--hb-text);
    font: inherit;
    font-size: 13.5px;
    box-shadow: var(--on-shadow-sm);
    transition: width 0.2s, border-color 0.15s;
  }
  .hb-search input:focus {
    width: 260px;
    border-color: var(--hb-brand);
    outline: 3px solid var(--on-ring);
    outline-offset: 0;
  }
  .hb-search input::placeholder {
    color: var(--hb-muted);
  }
  .hb-icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    box-shadow: var(--on-shadow-sm);
    transition: background-color 0.15s;
  }
  .hb-icon:hover {
    background: var(--hb-hover);
  }
  .hb-moon {
    display: none;
  }
  html[data-theme="dark"] .hb-sun {
    display: none;
  }
  html[data-theme="dark"] .hb-moon {
    display: block;
  }

  /* ---------- mobile bits ---------- */
  .hb-mobile {
    display: none;
    align-items: center;
    gap: 10px;
  }
  .hb-brand {
    font-family: var(--on-display);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--hb-brand);
  }
  .hubbar .hb-panel[hidden] { display: none !important; }
  .hb-menu {
    display: grid;
    gap: 2px;
    padding: 8px;
    background: var(--hb-surface);
    border-top: 1px solid var(--hb-border);
  }
  .hb-menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 14.5px;
    font-weight: 600;
  }
  .hb-menu a:hover {
    background: var(--hb-hover);
  }

  /* ---------- breakpoints ---------- */
  @media (max-width: 1180px) {
    .hb-latest span {
      display: none;
    }
    .hb-latest {
      width: 40px;
      padding: 0;
      justify-content: center;
    }
    .hb-search input:focus {
      width: 200px;
    }
  }
  @media (max-width: 899px) {
    .hb-row {
      padding: 8px 14px;
    }
    .hb-mobile {
      display: flex;
    }
    .hb-latest {
      display: none;
    }
    .hb-search input,
    .hb-search input:focus {
      width: 140px;
    }
    .hb-hubs {
      order: 3;
      flex: 1 1 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .hb-hub {
      position: static;
    }
    .hb-pill {
      width: 100%;
    }
    .hb-name {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hb-chev {
      margin-left: auto;
    }
    .hb-drop {
      left: 8px;
      right: 8px;
      width: auto;
      top: 100%;
      margin-top: 4px;
    }
  }
  @media (min-width: 900px) {
    .hb-menu {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hubbar *,
    .hb-drop {
      transition: none !important;
      animation: none !important;
    }
  }

  /* -------------------------------------------------------------
   * BP05: approved spacious, full-width fixed header.
   * Logo left, utility buttons at top right, four hubs below/right.
   * Matches ivory site canvas; leaves are low-contrast decoration.
   * ------------------------------------------------------------- */
  :root { --onocra-header-height: 150px; --onocra-sidebar-width: 188px; }
  .hubbar {
    position: fixed;
    inset: 0 0 auto 0;
    width: 100%;
    height: var(--onocra-header-height);
    z-index: 150;
    overflow: visible;
    background: linear-gradient(120deg, #fffaf0 0%, #fcfaf5 45%, #fbf7ed 100%);
    border-bottom: 1px solid #ded9cd;
    box-shadow: 0 3px 12px rgba(47, 54, 37, .06);
    backdrop-filter: none;
    color: #173a2f;
  }
  html[data-theme="dark"] .hubbar {
    background: linear-gradient(120deg, #1a252a, #222d31);
    border-color: #3d4c49;
  }
  .hb-leaves {
    position: absolute; top: 0; width: 140px; height: 142px;
    fill: none; stroke: #a5ac7d; stroke-width: 1.3;
    opacity: .27; pointer-events: none; z-index: 0;
  }
  .hb-leaves--left { left: 2px; top: -4px; width: 124px; height: 132px; transform: rotate(9deg); opacity: .3; }
  .hb-leaves--right { right: -18px; top: 0; width: 156px; height: 148px; transform: scaleX(-1) rotate(8deg); }
  .hb-leaves--mid { left: clamp(395px, 34vw, 520px); top: -6px; width: 112px; height: 118px; transform: rotate(7deg); opacity: .24; }
  html[data-theme="dark"] .hb-leaves { opacity: .13; }
  .hb-utility-row {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px clamp(16px, 3vw, 42px) 0 clamp(8px, 2vw, 22px);
    gap: 12px; min-height: 0;
    pointer-events: none;
  }
  .hb-logo { display: flex; align-items: center; justify-content: flex-start; min-width: 0; flex: 0 0 auto; z-index: 1; pointer-events: auto; }
  .hb-logo img {
    display: block; width: clamp(420px, 39vw, 565px); height: auto;
    max-height: 140px; max-width: none; object-fit: contain; object-position: left center;
    /* Keep the pelican proportionally correct and visually centred. */
  }
  .hb-utility-row .hb-tools {
    align-self: flex-start; margin: 0; gap: 11px; z-index: 6;
    display: flex; flex: 0 0 auto; pointer-events: auto;
  }
  .hb-utility-row .hb-icon {
    display: inline-grid; place-items: center; height: 44px; width: 44px;
    color: #132c27; border-radius: 50%; border: 1px solid #e7e1d5;
    background: #fffdfa;
    box-shadow: 0 4px 8px rgba(37, 58, 40, .12), inset 0 1px 1px rgba(255,255,255,.98);
  }
  .hb-utility-row .hb-icon:hover { background: #f5f2e8; }
  html[data-theme="dark"] .hb-utility-row .hb-icon { background: #25353a; color: #e9f2eb; border-color: #536662; }
  .hb-search { position: relative; flex: 0 0 44px; height: 44px; }
  .hb-search svg { left: 13px; width: 18px; height: 18px; z-index: 2; }
  .hb-search input {
    position: absolute; right: 0; top: 0;
    width: 44px; height: 44px; border: 1px solid #e7e1d5;
    border-radius: 999px; padding: 0 13px 0 41px;
    background: #fffdfa; color: #153f33; cursor: text;
    font-size: 13px;
    box-shadow: 0 4px 8px rgba(37, 58, 40, .12), inset 0 1px 1px rgba(255,255,255,.98);
    transition: width .22s ease, box-shadow .22s ease;
  }
  .hb-search input::placeholder { color: transparent; }
  .hb-search input:focus, .hb-search input:not(:placeholder-shown) {
    width: min(250px, 70vw); border-color: #9cafa3;
    box-shadow: 0 5px 16px rgba(33, 56, 44, .16);
    outline: 2px solid #df9b44; outline-offset: 1px;
  }
  .hb-search input:focus::placeholder { color: #65736d; }
  html[data-theme="dark"] .hb-search input { background: #25353a; color: #eef3f1; border-color: #536662; }
  .hb-menu-button { display: none !important; }
  .hb-nav-row {
    position: absolute; right: clamp(16px, 2vw, 32px); bottom: 31px;
    left: max(640px, 45vw);
    padding: 0; z-index: 5;
    display: flex; justify-content: flex-end;
  }
  .hb-hubs {
    display: flex; width: auto; max-width: 100%; gap: 6px;
    justify-content: flex-end; align-items: center;
  }
  .hb-hub { position: relative; min-width: 0; flex: 0 0 auto; }
  .hubbar button.hb-pill {
    display: inline-flex; width: auto; min-width: 0; height: 45px;
    align-items: center; justify-content: center; gap: 5px;
    padding: 3px 7px 4px 4px;
    font-family: var(--font-manrope), Arial, sans-serif;
    font-size: clamp(10px, .73vw, 11px); font-weight: 700;
    letter-spacing: -.025em; line-height: 1.1; white-space: nowrap;
    background: linear-gradient(165deg,#fffefa 0%,#fcfbf8 55%,#ebe8df 100%);
    border: 1px solid #e0d8c7; border-bottom: 2px solid #d2c8b6;
    border-radius: 26px; color: #1d322b;
    box-shadow: 0 4px 0 rgba(121, 110, 84, .09), 0 7px 12px rgba(55, 51, 37, .13), inset 0 2px 1px #fff;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  .hb-pill:hover,.hb-pill:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--hub) 35%, #ded4c2);
    box-shadow: 0 5px 0 rgba(121,110,84,.09),0 10px 16px rgba(55,51,37,.19),inset 0 2px 1px #fff;
  }
  .hb-pill[aria-expanded="true"] { background: linear-gradient(165deg,#fffefa,#e8f2eb); border-color: var(--hub); }
  .hb-pill.is-active { border-color: color-mix(in srgb, var(--hub) 35%, #e0d8c7); box-shadow: 0 4px 12px rgba(40,63,52,.18); }
  .hb-ico { display: grid; place-items: center; flex: 0 0 28px; width: 28px; height: 28px; border-radius: 50%; }
  .hb-ico svg { width: 15px; height: 15px; }
  .hb-name { min-width: 0; max-width: 100%; overflow: hidden; text-overflow: clip; white-space: nowrap; }
  .hb-chev { width: 13px !important; height: 13px !important; flex: 0 0 13px; }
  .hubbar .hb-drop { z-index: 155; top: calc(100% + 10px); }
  html[data-theme="dark"] .hb-pill {
    color: #ecf6f1; border-color: #40554c; border-bottom-color: #33483e;
    background: linear-gradient(165deg, #34473f, #27362f);
    box-shadow: 0 4px 12px rgba(0,0,0,.35), inset 0 1px 1px rgba(255,255,255,.08);
  }
  /* Header never masks anchor navigation; root padding is adjusted by Layout. */
  html:has(.hubbar) { scroll-padding-top: calc(var(--onocra-header-height) + 12px); }

  /* Standard laptops: compress pills enough to preserve a visible logo-to-nav gap. */
  @media (min-width: 1361px) and (max-width: 1500px) {
    .hb-nav-row { left: max(690px, 49vw); bottom: 28px; }
    .hb-hubs { gap: 5px; }
    .hubbar button.hb-pill { font-size: 10px; gap: 4px; padding: 3px 6px 4px 4px; }
    .hb-ico { width: 26px; height: 26px; flex-basis: 26px; }
    .hb-ico svg { width: 16px; height: 16px; }
    .hb-chev { width: 11px !important; height: 11px !important; flex-basis: 11px; }
  }

  /* Medium desktops: keep large identity at top, add one full-width hub row below. */
  @media (min-width: 900px) and (max-width: 1360px) {
    :root { --onocra-header-height: 166px; }
    .hb-utility-row { padding: 8px 18px 0 14px; }
    .hb-logo img { width: clamp(360px, 39vw, 500px); height: auto; max-height: 124px; }
    .hb-nav-row { left: auto; right: 16px; bottom: 24px; }
    .hb-hubs { gap: 5px; }
    .hubbar button.hb-pill { height: 39px; font-size: 10px; gap: 4px; padding: 3px 6px 3px 5px; }
    .hb-ico { flex-basis: 25px; width: 25px; height: 25px; }
    .hb-ico svg { width: 15px; height: 15px; }
    .hb-chev { width: 11px !important; height: 11px !important; flex-basis: 11px; }
  }
  @media (max-width: 899px) {
    :root { --onocra-header-height: 168px; }
    .hubbar { height: var(--onocra-header-height); }
    .hb-utility-row { padding: 8px 12px 0; height: 75px; min-height: 0; }
    .hb-logo img { width: clamp(210px, 39vw, 340px); height: auto; max-height: 74px; }
    .hb-leaves--mid { display: none; }
    .hb-utility-row .hb-tools { gap: 7px; }
    .hb-utility-row .hb-icon, .hb-search, .hb-search input { width: 36px; height: 36px; flex-basis: 36px; }
    .hb-search svg { width: 16px; height: 16px; left: 10px; }
    .hb-search input:focus { width: min(210px, 62vw); }
    .hb-menu-button { display: inline-grid !important; }
    .hb-nav-row { position: absolute; left: 10px; right: 10px; bottom: 9px; padding: 0; }
    .hb-hubs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; gap: 7px; }
    .hb-hub { position: static; }
    .hubbar button.hb-pill { width: 100%; height: 36px; padding: 3px 8px; justify-content: flex-start; font-size: 11px; }
    .hb-ico { flex: 0 0 24px; width: 24px; height: 24px; }
    .hb-ico svg { width: 15px; height: 15px; }
    .hb-chev { margin-left: auto; }
    .hubbar .hb-drop { top: 100%; left: 8px; right: 8px; width: auto; }
    .hb-leaves { width: 84px; height: 84px; opacity: .18; }
  }
  @media (max-width: 510px) {
    :root { --onocra-header-height: 161px; }
    .hb-utility-row { padding: 6px 8px 0; }
    .hb-logo img { width: clamp(160px, 41vw, 220px); height: auto; max-height: 62px; }
    .hb-utility-row .hb-tools { gap: 5px; }
    .hb-utility-row .hb-icon, .hb-search, .hb-search input { width: 32px; height: 32px; flex-basis: 32px; }
    .hb-search svg { left: 8px; }
    .hubbar button.hb-pill { font-size: 10px; gap: 4px; padding: 3px 5px; }
    .hb-ico { flex-basis: 23px; width: 23px; height: 23px; }
    .hb-ico svg { width: 14px; height: 14px; }
    .hb-chev { width: 11px !important; height: 11px !important; }
  }
  @media (min-width: 900px) { .hb-menu { display: none !important; } }
  @media (prefers-reduced-motion: reduce) {
    .hb-pill, .hb-search input { transition: none !important; }
  }

  /* =============================================================
   * BP09 — final header refinements (dropdown fit + dark contrast)
   * These intentionally come LAST to override the older HubBar rules.
   * ============================================================= */

  /* A single compact typographic scale for the four hub controls AND
     every dropdown row. Never rely on site-wide button defaults here. */
  .hubbar .hb-drop {
    box-sizing: border-box;
    width: min(290px, calc(100vw - 24px));
    max-height: calc(100vh - var(--onocra-header-height, 150px) - 14px);
    max-height: calc(100dvh - var(--onocra-header-height, 150px) - 14px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 11px 11px 10px;
    color: var(--hb-text);
    background: var(--hb-surface);
    border-color: var(--hb-border);
    scrollbar-width: thin;
  }
  .hubbar .hb-drop-title {
    font-family: var(--on-display);
    font-size: 12.5px;
    line-height: 1.2;
    font-weight: 700;
    overflow-wrap: anywhere;
    margin: 0 3px 8px;
    color: var(--hb-text);
  }
  .hubbar .hb-actions { gap: 1px; }
  .hubbar .hb-act {
    grid-template-columns: 28px minmax(0, 1fr) 12px;
    gap: 8px;
    padding: 6px 5px;
    min-height: 42px;
  }
  .hubbar .hb-act-ico { width: 28px; height: 28px; border-radius: 8px; }
  .hubbar .hb-act-ico svg { width: 15px; height: 15px; }
  .hubbar .hb-act-txt { min-width: 0; }
  .hubbar .hb-act-txt strong {
    font-family: var(--font-manrope), Arial, sans-serif;
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1.24;
    color: var(--hb-text);
    overflow-wrap: anywhere;
  }
  .hubbar .hb-act-txt span {
    font-family: var(--font-manrope), Arial, sans-serif;
    font-size: 10px;
    line-height: 1.25;
    color: var(--hb-muted);
    overflow-wrap: anywhere;
  }
  .hubbar .hb-go { width: 12px !important; height: 12px !important; }
  .hubbar .hb-extras { gap: 5px; margin: 7px 3px 0; padding-top: 8px; }
  .hubbar .hb-extras > span { font-size: 9.5px; letter-spacing: .055em; }
  .hubbar .hb-extras a { font-size: 10px; padding: 5px 7px; }
  .hubbar .hb-all {
    margin: 7px 3px 0;
    padding-top: 9px;
