---
import Layout from "@/layouts/Layout.astro";
import PhonesHeader from "@/components/Phones/Header.astro";
import PhonesFooter from "@/components/Phones/Footer.astro";

interface Props {
  step: number;          // 1..5
  total?: number;
  title: string;         // page <title>
  heading: string;       // serif question
  lead?: string;
  kicker?: string;       // e.g. "pick up to 5"
  wide?: boolean;
}
const { step, total = 5, title, heading, lead, kicker, wide = false } = Astro.props;
const pct = Math.round((step / total) * 100);
const steps = ["Route", "Who", "Priorities", "Models", "Verdict"];
---

<Layout title={title}>
  <PhonesHeader />
  <main class={`flow ${wide ? "flow--wide" : ""}`}>
    <section class="flow-card" aria-labelledby="flow-heading">
      <p class="flow-step">
        Step {step} of {total}{kicker ? ` · ${kicker}` : ""}
      </p>
      <div class="flow-bar" role="progressbar" aria-valuemin="1" aria-valuemax={total} aria-valuenow={step}>
        <span style={`width:${pct}%`}></span>
      </div>
      <ol class="flow-crumbs" aria-label="Progress">
        {steps.map((s, i) => (
          <li aria-current={i + 1 === step ? "step" : undefined} class={i + 1 < step ? "done" : ""}>{s}</li>
        ))}
      </ol>
      <h1 id="flow-heading" tabindex="-1">{heading}</h1>
      {lead && <p class="flow-lead">{lead}</p>}

      <slot />

      <p class="flow-note">
        ONOCRA cites published evidence and does not run laboratory tests.
        <a href="/phones/reviews/methodology/">How we evaluate</a>
      </p>
    </section>

    <div class="flow-nav">
      <slot name="nav" />
    </div>
  </main>
  <PhonesFooter />
</Layout>

<script>
  // Move focus to the step heading for keyboard and screen-reader users.
  document.getElementById("flow-heading")?.focus({ preventScroll: true });
</script>

<style is:global>
  .flow {
    --onocra-cream: #faf6ea;
    --onocra-mint: #e6f4e3;
    --onocra-mint-deep: #bfe3c6;
    --onocra-sage: #8fbf9f;
    --onocra-green: #86cf9b;
    --onocra-green-dark: #2f8a52;
    --onocra-forest: #1d4a2f;
    --onocra-orange: #cf5f2f;
    --onocra-line: #cfe3d2;
  }
  .flow { background: var(--onocra-cream); color: var(--onocra-forest); padding: 20px 16px 110px; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
  .flow-card { max-width: 560px; margin: 0 auto; background: #fcf9f0; border: 2px solid var(--onocra-forest); border-radius: 28px; padding: 22px 18px; }
  .flow--wide .flow-card { max-width: 960px; }
  .flow h1 { font-family: Georgia, "Source Serif Pro", serif; font-size: 1.7rem; line-height: 1.15; margin: 14px 0 8px; outline: none; }
  .flow h2 { font-family: Georgia, serif; font-size: 1.25rem; margin: 22px 0 8px; }
  .flow h3 { font-size: 1rem; margin: 0 0 4px; }
  .flow-step { margin: 0 0 8px; font-size: .9rem; opacity: .75; }
  .flow-bar { height: 8px; background: var(--onocra-line); border-radius: 99px; overflow: hidden; }
  .flow-bar span { display: block; height: 100%; background: var(--onocra-green-dark); border-radius: 99px; }
  .flow-crumbs { display: flex; gap: 6px; list-style: none; padding: 0; margin: 10px 0 0; font-size: .72rem; flex-wrap: wrap; }
  .flow-crumbs li { padding: 2px 8px; border-radius: 99px; background: var(--onocra-mint); opacity: .7; }
  .flow-crumbs li.done { opacity: 1; }
  .flow-crumbs li[aria-current="step"] { background: var(--onocra-forest); color: #fff; opacity: 1; }
  .flow-lead { margin: 0 0 14px; line-height: 1.5; }
  .flow-note { margin-top: 22px; font-size: .78rem; opacity: .75; }
  .flow-note a { color: var(--onocra-forest); }

  /* selectable cards */
  .opt-list { display: grid; gap: 10px; border: 0; padding: 0; margin: 14px 0 0; }
  .opt { position: relative; display: flex; gap: 12px; align-items: center; background: var(--onocra-mint); border: 1.5px solid var(--onocra-sage); border-radius: 18px; padding: 14px; cursor: pointer; min-height: 64px; }
  .opt input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .opt:has(input:checked) { background: var(--onocra-mint-deep); border: 3px solid var(--onocra-green-dark); padding: 12.5px; }
  .opt:has(input:checked)::after { content: "✓"; position: absolute; right: 12px; top: 8px; font-weight: 700; color: var(--onocra-green-dark); }
  .opt:has(input:focus-visible) { outline: 3px solid var(--onocra-orange); outline-offset: 2px; }
  .opt .ico { font-size: 1.5rem; }
  .opt small { display: block; opacity: .75; margin-top: 2px; }

  /* priority tiles */
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 14px; }
  .tile { position: relative; background: var(--onocra-mint); border: 1.5px solid var(--onocra-sage); border-radius: 18px; padding: 16px 8px; text-align: center; font: inherit; color: inherit; cursor: pointer; min-height: 84px; }
  .tile[aria-pressed="true"] { background: var(--onocra-mint-deep); border: 3px solid var(--onocra-green-dark); }
  .tile[disabled] { opacity: .45; cursor: not-allowed; }
  .tile .ico { display: block; font-size: 1.4rem; }
  .tile .badge { position: absolute; top: -8px; right: -4px; width: 26px; height: 26px; border-radius: 50%; background: var(--onocra-orange); color: #fff; font-size: .85rem; font-weight: 700; display: grid; place-items: center; }

  /* form fields */
  .field { margin-top: 14px; }
  .field label { display: block; font-size: .9rem; margin-bottom: 4px; }
  .field select, .field input[type="search"] { width: 100%; padding: 12px; border-radius: 12px; border: 1.5px solid var(--onocra-sage); background: #fff; font: inherit; color: inherit; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .seg { display: inline-flex; border: 1.5px solid var(--onocra-sage); border-radius: 99px; overflow: hidden; }
  .seg label { padding: 8px 14px; cursor: pointer; font-size: .9rem; position: relative; }
  .seg input { position: absolute; opacity: 0; inset: 0; }
  .seg label:has(input:checked) { background: var(--onocra-green-dark); color: #fff; }
  .seg label:has(input:focus-visible) { outline: 3px solid var(--onocra-orange); }

  /* chips, pills, cards */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; padding: 0; list-style: none; }
  .chip { padding: 4px 12px; border-radius: 99px; background: var(--onocra-mint); border: 1px solid var(--onocra-sage); font-size: .85rem; }
  .tag-prio { color: var(--onocra-orange); font-size: .85rem; }
  .card { background: var(--onocra-mint); border: 1.5px solid var(--onocra-sage); border-radius: 18px; padding: 14px; margin: 10px 0; }
  .card.is-selected { background: var(--onocra-mint-deep); border: 3px solid var(--onocra-green-dark); padding: 12.5px; }
  .card .meta { opacity: .8; font-size: .9rem; margin: 2px 0; }
  .tagline { font-family: Georgia, serif; font-style: italic; color: var(--onocra-orange); border-bottom: 3px solid var(--onocra-orange); padding-bottom: 4px; margin: 4px 0 12px; font-size: 1.15rem; }
  .banner { background: #fff3e0; border: 1.5px solid var(--onocra-orange); border-radius: 14px; padding: 10px 12px; font-size: .88rem; margin: 12px 0; }
  .empty { background: var(--onocra-mint); border: 1.5px dashed var(--onocra-sage); border-radius: 14px; padding: 14px; }

  /* status labels: icon + word, never colour alone */
  .st { display: inline-block; padding: 2px 10px; border-radius: 99px; font-size: .78rem; font-weight: 700; border: 1.5px solid; white-space: nowrap; }
  .st-improved { background: #d6f0dc; border-color: var(--onocra-green-dark); }
  .st-unchanged { background: #eef0e8; border-color: #8a9a8c; }
  .st-regressed { background: #fde2d6; border-color: var(--onocra-orange); }
  .st-unverified { background: #fff3cf; border-color: #b58a1b; }

  /* buttons and sticky nav */
  .btn { display: inline-block; text-align: center; padding: 14px 20px; border-radius: 16px; border: 1.5px solid var(--onocra-green-dark); background: var(--onocra-green); color: var(--onocra-forest); font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
  .btn:hover { background: #75c58d; }
  .btn.ghost { background: transparent; }
  .btn[aria-disabled="true"], .btn[disabled] { opacity: .45; pointer-events: none; }
  .flow .flow-nav { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 10px; justify-content: space-between; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: rgba(250,246,234,.96); border-top: 1px solid var(--onocra-line); z-index: 20; }
  .flow-nav .btn { flex: 1; max-width: 280px; }
  .flow-nav .btn:last-child:not(:first-child) { margin-left: auto; }

  /* verdict pieces */
  .bar-row { margin: 8px 0; }
  .bar-row .lbl { display: flex; justify-content: space-between; font-size: .88rem; }
  .bar-track { height: 12px; background: var(--onocra-line); border-radius: 99px; overflow: hidden; }
  .bar-fill { height: 100%; background: var(--onocra-green-dark); border-radius: 99px; }
  .leap-row { border: 1.5px solid var(--onocra-sage); border-radius: 14px; background: var(--onocra-mint); margin: 8px 0; }
  .leap-row summary { cursor: pointer; padding: 12px; display: flex; gap: 10px; align-items: center; justify-content: space-between; list-style: none; }
  .leap-row summary::-webkit-details-marker { display: none; }
  .leap-row .body { padding: 0 12px 12px; font-size: .92rem; line-height: 1.5; }
  .leap-row .src { font-size: .8rem; opacity: .8; margin-top: 6px; }
  .tbl-wrap { overflow-x: auto; }
  .tbl { border-collapse: collapse; width: 100%; font-size: .9rem; min-width: 420px; }
  .tbl th, .tbl td { padding: 8px 10px; border-bottom: 1px solid var(--onocra-line); text-align: left; }
  .tbl th:first-child, .tbl td:first-child { position: sticky; left: 0; background: #fcf9f0; }
  .grid-2 { display: grid; gap: 12px; }
  @media (min-width: 720px) { .grid-2 { grid-template-columns: 1fr 1fr; } }
  .sec { border-top: 1px solid var(--onocra-line); margin-top: 18px; padding-top: 4px; }
</style>
