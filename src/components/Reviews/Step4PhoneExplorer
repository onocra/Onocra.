---
import type { Step4Phone } from "@/lib/step4Catalogue";
interface Props { phones: Step4Phone[] }
const { phones } = Astro.props;
// Astro safe-JSON script: user/editorial text must never terminate this element.
const payload = JSON.stringify(phones).replace(/</g, "\\u003c");
---
<section class="s4" id="onocra-s4" aria-label="Step 4 smartphone model selection">
  <header class="s4-head">
    <div><p class="s4-kicker">SMARTPHONE REVIEW JOURNEY · STEP 4 OF 5</p>
      <h2>Select Your Phone</h2><p>Choose your primary smartphone, then compare it with up to <strong>2 additional phones</strong>.</p></div>
    <aside class="s4-guide"><strong>💡 ONOCRA guide for this step</strong>
      <ol><li>Choose from the numbered phone list, <strong>or</strong> find a phone using filters.</li>
      <li>Click a phone to expand its image, specifications and price. Set it as your primary phone.</li>
      <li>ONOCRA suggests up to <strong>5 competitive phones</strong>; pick up to <strong>2</strong> to compare.</li></ol>
    </aside>
  </header>
  <div class="s4-duo">
    <section class="s4-panel s4-popular" aria-label="Popular and latest phones">
      <div class="s4-panel-title"><div><h3>1 · Popular & Latest Phones</h3>
        <small id="s4-ranking-label">Numbered by most recent release; authentic popularity when available.</small></div></div>
      <div class="s4-listhead"><span># &nbsp; Phone model</span><span id="s4-ranking-heading">Release</span></div>
      <div id="s4-popular-list" aria-live="polite"></div>
      <button type="button" class="s4-more" id="s4-more-popular">Show more phones ↓</button>
    </section>
    <section class="s4-panel s4-filter" aria-label="Find phones using filters">
      <div class="s4-panel-title"><h3>2 · Find Phones Using Filters</h3><small>Phones only; all selected data must be supported by ONOCRA's database.</small></div>
      <label class="s4-full">Search model<input id="s4-q" type="search" placeholder="e.g. Galaxy S25, iPhone 16" autocomplete="off"/></label>
      <div class="s4-form">
        <label>Brand<select id="s4-brand"><option value="">All brands</option></select></label>
        <label>Region<select id="s4-region"><option value="US">United States</option><option value="UK">United Kingdom</option><option value="DE">Germany</option><option value="FR">France</option><option value="IT">Italy</option><option value="ES">Spain</option></select></label>
        <label>Price range · US$<select id="s4-price"><option value="">Any verified US price</option><option value="0-500">Under $500</option><option value="500-800">$500–$799</option><option value="800-1200">$800–$1,199</option><option value="1200-999999">$1,200+</option></select></label>
        <label>Release year <button type="button" id="s4-policy-toggle" class="s4-info" aria-label="Why October 2023 onward?" aria-expanded="false" aria-controls="s4-policy">ⓘ</button>
          <select id="s4-year"><option value="">All eligible dates</option></select></label>
        <label>RAM (GB)<select id="s4-ram"><option value="">Any</option></select></label>
        <label>Storage / ROM (GB)<select id="s4-storage"><option value="">Any</option></select></label>
        <label>5G support<select id="s4-5g"><option value="">Any</option><option value="yes">Yes</option><option value="no">No</option></select></label>
        <label>Battery (mAh)<select id="s4-battery"><option value="">Any</option><option value="4000">4,000+</option><option value="5000">5,000+</option><option value="6000">6,000+</option></select></label>
        <label>Screen (inches)<select id="s4-screen"><option value="">Any</option><option value="0-6.2">Up to 6.2</option><option value="6.2-6.7">6.2–6.7</option><option value="6.7-99">6.7+</option></select></label>
        <label>Camera (MP)<select id="s4-camera"><option value="">Any</option><option value="48">48+</option><option value="50">50+</option><option value="100">100+</option></select></label>
      </div>
      <div id="s4-policy" class="s4-policy" hidden tabindex="-1"><strong>ONOCRA's comparison policy</strong>
        <p>Our comparison catalogue starts with phones officially released on or after <strong>1 October 2023</strong>. This is a fixed starting date, not a rolling three-year cutoff. Eligible older models remain available for comparison as new phones are added.</p>
        <p>Actual availability, current value and remaining software support still matter when assessing older phones.</p></div>
      <p class="s4-note" id="s4-filter-note">Optional filters use only known fields. Unknown data is never guessed.</p>
      <div class="s4-listhead"><span>Search results</span><span id="s4-count"></span></div>
      <div id="s4-results" aria-live="polite"></div>
      <button type="button" class="s4-more" id="s4-more-results">Show more matching phones ↓</button>
    </section>
  </div>
  <section class="s4-build" id="s4-builder" aria-label="Build your comparison" tabindex="-1">
    <header><div><h3>3 · Build Your Comparison</h3>
      <p>Your primary phone plus up to <strong>5 recommended alternatives</strong>. Select <strong>no more than 2</strong> additional phones.</p></div>
      <strong id="s4-progress">0 of 2 alternatives</strong></header>
    <div id="s4-primary" class="s4-primary-empty">Select a primary phone from either list above to see personalised candidates here.</div>
    <div id="s4-suggestions" class="s4-candidates" aria-live="polite"></div>
    <p class="s4-note" id="s4-match-note">Recommendations are candidates based on available research, not laboratory scores or an editorial verdict.</p>
  </section>
  <nav class="s4-actions" aria-label="Review journey navigation">
    <a class="s4-back" id="s4-back" href="/phones/reviews/priorities/">← Back to Priorities</a>
    <a class="s4-next is-disabled" id="s4-next" aria-disabled="true">Continue to Step 5 →</a>
  </nav>
  <script id="s4-data" type="application/json" set:html={payload} />
</section>
<script>
  import { readState, stepUrl } from "@/lib/reviewFlow";
  import type { Step4Phone, Step4Region } from "@/lib/step4Catalogue";
  function initStep4() {
    const root=document.getElementById("onocra-s4");
    if (!root || root.dataset.ready==="1") return;
    root.dataset.ready="1";
    const $=<T extends HTMLElement>(id:string)=>root.querySelector<T>(`#${id}`)!;
    const all=JSON.parse($("s4-data").textContent||"[]") as Step4Phone[];
    const cutoff="2023-10-01";
    const eligible=all.filter(p=>p && p.id && p.releaseDate>=cutoff);
    const prior=readState(window.location.search);
    let primary=eligible.find(p=>p.id===prior.model)?.id ?? "";
    let chosen=(prior.compare||[]).filter((id:string)=>id!==primary && eligible.some(p=>p.id===id)).slice(0,2);
    let opened="", showPopular=8, showResults=6;
    const controls=["brand","region","price","year","ram","storage","5g","battery","screen","camera","q"];
    const el=(s:string)=>$<HTMLInputElement|HTMLSelectElement>(`s4-${s}`);
    const esc=(s:unknown)=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]||c));
    const get=(id:string)=>eligible.find(p=>p.id===id);
    const currency=(region:Step4Region)=>({US:"USD",UK:"GBP",DE:"EUR",FR:"EUR",IT:"EUR",ES:"EUR"}[region]);
    const price=(p:Step4Phone, region:Step4Region)=>{
      const q=p.prices?.[region];
      return q && Number.isFinite(q.amount) ? new Intl.NumberFormat("en",{style:"currency",currency:q.currency||currency(region),maximumFractionDigits:0}).format(q.amount) : "Price not verified";
    };
    const photo=(p:Step4Phone)=> p.image && /^https?:\/\//.test(p.image) || p.image?.startsWith("/")
      ? `<img src="${esc(p.image)}" alt="${esc(p.name)}" loading="lazy"/>`
      : `<div class="s4-noimage" aria-label="No photo provided">📱<small>Image pending</small></div>`;
    const rowDetails=(p:Step4Phone)=>{
      const items: [string, string | undefined][] = [
        ["Display",p.display],["Processor",p.processor],["RAM",p.ram],["Storage",p.storage],
        ["Camera",p.camera],["Battery",p.battery],["Charging",p.charging],["Released",p.releaseDate]
      ];
      const region=el("region").value as Step4Region;
      const pr=p.prices?.[region];
      return `<div class="s4-expanded"><div class="s4-photo">${photo(p)}</div><div class="s4-specs">
        <strong>${esc(p.name)}</strong>
        <dl>${items.filter(x=>x[1]).map(([k,v])=>`<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join("")}
        <div><dt>${esc(region)} price</dt><dd>${esc(price(p,region))}</dd></div></dl>
        ${pr?.source?`<small>Price source: ${esc(pr.source)}${pr.asOf?` · ${esc(pr.asOf)}`:""}${pr.config?` · ${esc(pr.config)}`:""}</small>`:""}
        <button class="s4-set" data-primary="${esc(p.id)}" type="button">${primary===p.id?"✓ Primary phone selected":"+ Set as primary phone"}</button>
      </div></div>`;
    };
    const entry=(p:Step4Phone,i:number,ranked=false)=>{
      const key=`${ranked?"popular":"filter"}:${p.id}`;
      const popTitle=p.popularity?` title="${esc(p.popularity.source)} · as of ${esc(p.popularity.asOf)}"`:"";
      const metric=p.popularity;
      const label=ranked&&metric ? `${metric.count.toLocaleString("en")} ${metric.kind==="views7d"?"7d views":"saves"}` : p.releaseDate.slice(0,4);
      return `<article class="s4-entry"><button class="s4-line" type="button" data-open="${esc(key)}" aria-expanded="${opened===key}">
        <span class="s4-number">${ranked?i+1:"›"}</span><span class="s4-name">${esc(p.name)}</span>
        <span class="s4-number s4-metric"${popTitle}>${esc(label)}</span><span aria-hidden="true">${opened===key?"⌃":"⌄"}</span></button>
        ${opened===key?rowDetails(p):""}</article>`;
    };
    const metricPhones=eligible.filter(p=>p.popularity?.count!==undefined);
    const ranked=metricPhones.length>=3 && metricPhones.every(p=>p.popularity?.kind===metricPhones[0].popularity?.kind);
    const popular=(ranked?metricPhones:eligible).slice().sort((a,b)=>ranked
      ? (b.popularity!.count-a.popularity!.count) || b.releaseDate.localeCompare(a.releaseDate)
      : b.releaseDate.localeCompare(a.releaseDate) || a.name.localeCompare(b.name));
    $("s4-ranking-label").textContent=ranked
      ? `Ranked using real ${metricPhones[0].popularity!.kind==="views7d"?"7-day page views":"favourites"}; source and date required.`
      : "Numbered by latest eligible release. Popularity data will appear when verified.";
    $("s4-ranking-heading").textContent=ranked?(metricPhones[0].popularity?.kind==="views7d"?"7-day views":"Favourites"):"Year";
    const selected=(id:string)=>get(id)!;
    const selectValues=(name:string, vals:string[])=>{const e=el(name) as HTMLSelectElement;
      vals.forEach(v=>{const o=document.createElement("option");o.value=v;o.textContent=v;e.append(o)});
      e.disabled=!vals.length;
    };
    selectValues("brand",[...new Set(eligible.map(p=>p.brand))].sort());
    selectValues("year",[...new Set(eligible.map(p=>p.releaseDate.slice(0,4)))].sort((a,b)=>b.localeCompare(a)));
    selectValues("ram",[...new Set(eligible.map(p=>p.ramGB).filter((n):n is number=>typeof n==="number"))].sort((a,b)=>a-b).map(String));
    selectValues("storage",[...new Set(eligible.map(p=>p.storageGB).filter((n):n is number=>typeof n==="number"))].sort((a,b)=>a-b).map(String));
    el("region").value=prior.region||"US";
    for (const id of ["5g","battery","screen","camera"]){
      const available=eligible.some(p=>id==="5g"?typeof p.fiveG==="boolean":id==="battery"?typeof p.batteryMah==="number":id==="screen"?typeof p.screenInches==="number":typeof p.mainCameraMP==="number");
      el(id).disabled=!available;
      if (!available) el(id).title="Not available until verified fields are added to the catalogue";
    }
    const results=()=>eligible.filter(p=>{
      const q=el("q").value.trim().toLowerCase();
      if(q && !(p.name+" "+p.brand).toLowerCase().includes(q)) return false;
      if(el("brand").value && p.brand!==el("brand").value) return false;
      if(el("year").value && !p.releaseDate.startsWith(el("year").value)) return false;
      if(el("ram").value && p.ramGB!==Number(el("ram").value)) return false;
      if(el("storage").value && p.storageGB!==Number(el("storage").value)) return false;
      const pc=el("price").value;
      if(pc){const us=p.prices?.US?.amount;if(!Number.isFinite(us))return false;const [lo,hi]=pc.split("-").map(Number);if(us! < lo || us! >= hi)return false;}
      const fg=el("5g").value;
      if(fg && (typeof p.fiveG!=="boolean"||p.fiveG!==(fg==="yes")))return false;
      if(el("battery").value && !(typeof p.batteryMah==="number" && p.batteryMah>=+el("battery").value))return false;
      if(el("camera").value && !(typeof p.mainCameraMP==="number" && p.mainCameraMP>=+el("camera").value))return false;
      const ss=el("screen").value;
      if(ss){if(typeof p.screenInches!=="number")return false;const [lo,hi]=ss.split("-").map(Number);if(p.screenInches<lo||p.screenInches>=hi)return false;}
      return true;
    }).sort((a,b)=>b.releaseDate.localeCompare(a.releaseDate)||a.name.localeCompare(b.name));
    const recommend=(p:Step4Phone)=>{
      const region=el("region").value as Step4Region, base=p.prices?.[region]?.amount;
      const mode=prior.mode;
      const allowedBrands=(prior.brands||[]) as string[];
      return eligible.filter(x=>x.id!==p.id)
        .filter(x=>mode!=="generations" || (!!p.family && x.family===p.family && x.brand===p.brand))
        .filter(x=>mode!=="brands" || !allowedBrands.length || allowedBrands.includes(x.brand))
        .map(x=>{
        let score=0;
        // Internal ordering only; never published as a benchmark or editorial score.
        if(base && x.prices?.[region]?.amount){const ratio=x.prices[region]!.amount/base;
          score+=ratio>=0.7&&ratio<=1.3?30:ratio>=0.5&&ratio<=1.6?10:0;}
        if(p.brand!==x.brand) score+=1;
        for(const [idx,pr] of (prior.prio||[]).entries()){
          const fit=x.fit?.[pr];
          if(fit==="strong")score+=Math.max(1,5-idx)*2;
          if(fit==="adequate")score+=Math.max(1,5-idx);
        }
        return {p:x,score};
      }).sort((a,b)=>b.score-a.score||b.p.releaseDate.localeCompare(a.p.releaseDate)||a.p.name.localeCompare(b.p.name)).slice(0,5).map(x=>x.p);
    };
    const redraw=()=>{
      $("s4-popular-list").innerHTML=popular.slice(0,showPopular).map((p,i)=>entry(p,i,true)).join("")||"<p class='s4-note'>No eligible model records yet.</p>";
      $("s4-more-popular").hidden=popular.length<=showPopular;
      const rs=results();
      $("s4-count").textContent=`${rs.length} eligible`;
      $("s4-results").innerHTML=rs.slice(0,showResults).map((p,i)=>entry(p,i)).join("")||"<p class='s4-note'>No matches with verified filter fields. Try fewer filters.</p>";
      $("s4-more-results").hidden=rs.length<=showResults;
      const p=get(primary);
      $("s4-primary").innerHTML=p?`<div class="s4-primary-selected"><span class="s4-chip">✓ Primary</span> <strong>${esc(p.name)}</strong><span>${esc(price(p,el("region").value as Step4Region))}</span><button type="button" data-clear="1">Change</button></div>`:"Select a primary phone from either list above to see personalised candidates here.";
      const cards=p?recommend(p):[];
      chosen=chosen.filter(id=>cards.some(c=>c.id===id)).slice(0,2);
      $("s4-suggestions").innerHTML=cards.map(c=>`<label class="s4-candidate ${chosen.includes(c.id)?"is-checked":""}"><input type="checkbox" data-compare="${esc(c.id)}" ${chosen.includes(c.id)?"checked":""} ${chosen.length>=2 && !chosen.includes(c.id)?"disabled":""} aria-label="Compare ${esc(c.name)}"/><span>${photo(c)}</span><strong>${esc(c.name)}</strong><small>${esc(price(c,el("region").value as Step4Region))}</small></label>`).join("");
      $("s4-match-note").textContent=p?(cards.length ? "Up to five candidate alternatives, ordered by available regional price and researched priorities. These are not measured benchmark scores." : "No other eligible models yet; add researched models to enable comparisons.") : "Recommendations appear after choosing a primary phone.";
      $("s4-progress").textContent=`${chosen.length} of 2 alternatives`;
      const next=$("s4-next") as HTMLAnchorElement;
      const back=$("s4-back") as HTMLAnchorElement;
      const nextState={...prior,region:el("region").value as Step4Region,model:primary,compare:chosen};
      back.href=stepUrl("priorities",nextState);
      if(primary){next.href=stepUrl("verdict",nextState);next.classList.remove("is-disabled");next.removeAttribute("aria-disabled")}
      else {next.removeAttribute("href");next.classList.add("is-disabled");next.setAttribute("aria-disabled","true")}
    };
    const refresh=()=>redraw();
    $("s4-policy-toggle").addEventListener("click",()=>{
      const p=$("s4-policy");p.hidden=!p.hidden;
      $("s4-policy-toggle").setAttribute("aria-expanded",String(!p.hidden));
      if(!p.hidden)p.focus();
    });
    for(const id of controls) el(id).addEventListener(id==="q"?"input":"change",()=>{showResults=6;opened="";refresh()});
    $("s4-more-popular").addEventListener("click",()=>{showPopular+=8;refresh()});
    $("s4-more-results").addEventListener("click",()=>{showResults+=6;refresh()});
    root.addEventListener("click",e=>{
      const target=e.target as HTMLElement;
      const open=target.closest<HTMLElement>("[data-open]")?.dataset.open;
      if(open){opened=opened===open?"":open;refresh();return;}
      const newPrimary=target.closest<HTMLElement>("[data-primary]")?.dataset.primary;
      if(newPrimary){primary=newPrimary;chosen=[];opened="";refresh();$("s4-builder").scrollIntoView({behavior:"smooth",block:"start"});return;}
      if(target.closest("[data-clear]")){primary="";chosen=[];refresh();return;}
    });
    root.addEventListener("change",e=>{
      const t=e.target as HTMLInputElement;
      if(!t.matches("[data-compare]"))return;
      const id=t.dataset.compare!;
      if(t.checked){if(chosen.length>=2){t.checked=false;return;}chosen.push(id)}
      else chosen=chosen.filter(x=>x!==id);
      refresh();
    });
    refresh();
  }
  initStep4();
  document.addEventListener("astro:page-load",initStep4);
</script>
<style is:global>
  #onocra-s4{--s4-green:#1b7753;--s4-blue:#2668ba;color:#16312b;font-family:inherit;max-width:1320px;margin:auto}
  #onocra-s4 *{box-sizing:border-box}
  #onocra-s4 .s4-head{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(270px,1fr);gap:18px;align-items:start;margin-bottom:16px}
  #onocra-s4 .s4-kicker{font-size:10px;letter-spacing:.14em;color:#426c5a;font-weight:700;margin:0 0 6px}
  #onocra-s4 h2{font-size:clamp(24px,2.8vw,31px);line-height:1.15;margin:0 0 6px}
  #onocra-s4 .s4-head p{margin-top:0;font-size:13px;color:#4d5c58}
  #onocra-s4 .s4-guide{background:#eaf6ed;border:1px solid #cfe9d8;padding:12px 15px;border-radius:11px;font-size:11px;line-height:1.5}
  #onocra-s4 .s4-guide strong{font-size:12px}
  #onocra-s4 .s4-guide ol{padding-left:17px;margin:6px 0 0}
  #onocra-s4 .s4-duo{display:grid;grid-template-columns:1fr 1fr;gap:13px;align-items:start}
  #onocra-s4 .s4-panel,#onocra-s4 .s4-build{background:#fff;border:1px solid #cbdcd3;border-radius:13px;padding:12px;box-shadow:0 2px 14px rgba(20,70,45,.04)}
  #onocra-s4 .s4-filter{border-color:#c9d9f3;background:#fafcff}
  #onocra-s4 .s4-panel-title{margin:0 0 10px}
  #onocra-s4 h3{font-size:17px;line-height:1.3;margin:0 0 3px;font-weight:700}
  #onocra-s4 small,#onocra-s4 .s4-panel-title small{font-size:10px;color:#697671}
  #onocra-s4 .s4-listhead{display:flex;justify-content:space-between;background:#eaf2ed;padding:7px 8px;margin-bottom:4px;font-size:11px;font-weight:700;border-radius:5px}
  #onocra-s4 .s4-filter .s4-listhead{background:#e9f0fb;margin-top:8px}
  #onocra-s4 .s4-entry{border-bottom:1px solid #edf0ed}
  #onocra-s4 .s4-line{width:100%;display:grid;grid-template-columns:20px minmax(0,1fr) auto 16px;gap:7px;align-items:center;text-align:left;border:0;border-radius:5px;padding:8px 5px;color:inherit;background:transparent;font-size:12px;cursor:pointer}
  #onocra-s4 .s4-line:hover,#onocra-s4 .s4-line[aria-expanded="true"]{background:#f0f7f2}
  #onocra-s4 .s4-number{font-size:10px;color:#66776e;font-variant-numeric:tabular-nums}
  #onocra-s4 .s4-name{font-size:12px;font-weight:650}
  #onocra-s4 .s4-metric{white-space:nowrap}
  #onocra-s4 .s4-expanded{display:grid;grid-template-columns:105px minmax(0,1fr);gap:11px;background:#f7faf8;border:1px solid #dceadf;border-radius:8px;margin:1px 0 6px;padding:9px;max-width:100%}
  #onocra-s4 .s4-photo{height:125px;display:flex;align-items:center;justify-content:center;overflow:hidden}
  #onocra-s4 .s4-photo img{max-width:100%;max-height:120px;object-fit:contain}
  #onocra-s4 .s4-noimage{font-size:32px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#6b8b7c}
  #onocra-s4 .s4-noimage small{font-size:9px}
  #onocra-s4 .s4-specs{min-width:0}
  #onocra-s4 .s4-specs>strong{font-size:12px;display:block;margin:0 0 5px}
  #onocra-s4 .s4-specs dl{margin:0}
  #onocra-s4 .s4-specs dl>div{display:grid;grid-template-columns:70px minmax(0,1fr);gap:5px;border-bottom:1px solid #e4eae5;padding:2px 0;font-size:10px;line-height:1.25}
  #onocra-s4 .s4-specs dt{font-weight:700;color:#66766c}
  #onocra-s4 .s4-specs dd{margin:0;overflow-wrap:anywhere}
  #onocra-s4 .s4-specs>small{display:block;margin:5px 0;line-height:1.2}
  #onocra-s4 .s4-set{background:#1b7753;border:0;color:white;border-radius:6px;font-size:11px;font-weight:700;padding:8px 10px;margin-top:7px;cursor:pointer}
  #onocra-s4 .s4-more{font-size:11px;width:100%;background:#f1f4f6;border:1px solid #dce3e4;color:#24483c;border-radius:7px;padding:9px;margin-top:8px;cursor:pointer}
  #onocra-s4 [hidden]{display:none!important}
  #onocra-s4 .s4-form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px 8px}
