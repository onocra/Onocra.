---
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "en";
const homeURL = getRelativeLocaleUrl(locale, "");
const searchURL = getRelativeLocaleUrl(locale, "search");

const currentPath = Astro.url.pathname;

const mainNav = [
  {
    label: "FIX",
    description: "Solve issues",
    href: `${homeURL}#fix`,
  },
  {
    label: "DECODE",
    description: "Understand technology",
    href: `${homeURL}#decode`,
  },
  {
    label: "COMPARE",
    description: "Your options",
    href: `${homeURL}#compare`,
  },
  {
    label: "CHOOSE",
    description: "Find what fits",
    href: `${homeURL}#choose`,
  },
];

const secondaryNav = [
  {
    label: "Reviews",
    href: `${homeURL}#reviews`,
  },
  {
    label: "Updates",
    href: `${homeURL}#updates`,
  },
  {
    label: "Digital Parenting",
    href: `${homeURL}#digital-parenting`,
  },
  {
    label: "Digital Safety",
    href: `${homeURL}#digital-safety`,
  },
  {
    label: "Guides",
    href: `${homeURL}#guides`,
  },
  {
    label: "ONOCRA Routes",
    href: `${homeURL}#routes`,
  },
];
---

<a
  href="#main-content"
  class="fixed top-3 left-3 z-[100] -translate-y-24 rounded-md bg-accent px-4 py-2 font-semibold text-accent-foreground transition-transform focus:translate-y-0"
>
  Skip to content
</a>

<!-- =========================================
     ONOCRA SITE HEADER
========================================== -->
<header
  id="top"
  class="border-border bg-background relative z-50 border-b"
  aria-label="ONOCRA site header"
>
  <!-- =========================================
       TOP HEADER
  ========================================== -->
  <div class="app-layout">
    <div
      class="flex min-h-20 items-center justify-between gap-4 py-2 md:min-h-[82px]"
    >
      <!-- =====================================
           BRAND
           Desktop brand moves to sidebar later.
           Retained here until sidebar is built.
      ====================================== -->
      <a
        href={homeURL}
        class="flex min-w-0 shrink-0 items-center gap-3 no-underline"
        aria-label="ONOCRA home"
      >
        <img
          src="/file_0000000083088208b5fec963887cd25a.png"
          alt=""
          class="h-[4.2rem] w-[4.2rem] shrink-0 object-contain sm:h-[4.6rem] sm:w-[4.6rem]"
        />

        <div>
          <div
            class="whitespace-nowrap font-serif text-[1.8rem] leading-none font-black tracking-[0.035em] text-[var(--onocra-forest)] sm:text-[2rem]"
            aria-label="ONOCRA"
          >
            ONOCRA<span class="text-[var(--onocra-orange)]">.</span>
          </div>

          <p
            class="text-muted-foreground mt-1 hidden text-[0.68rem] font-semibold sm:block"
          >
            For every householder. Everyday solutions.
          </p>
        </div>
      </a>

      <!-- =====================================
           DESKTOP SEARCH + ASK
      ====================================== -->
      <div
        class="hidden min-w-0 flex-1 items-center justify-end gap-2 md:flex"
      >
        <!-- SEARCH -->
        <form
          action={searchURL}
          method="get"
          class="border-border flex w-full max-w-[22rem] items-center rounded-xl border bg-[var(--onocra-cream)] px-3 shadow-sm"
          role="search"
        >
          <svg
            class="h-4.5 w-4.5 shrink-0 text-[var(--onocra-forest)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>

          <input
            type="search"
            name="q"
            aria-label="Search ONOCRA"
            placeholder="Search ONOCRA..."
            class="text-foreground min-w-0 flex-1 bg-transparent px-3 py-2.5 text-sm outline-none"
          />

          <button
            type="submit"
            aria-label="Search"
            class="text-sm font-bold text-[var(--onocra-forest)]"
          >
            Search
          </button>
        </form>

        <!-- ASK ONOCRA SHORTCUT -->
        <a
          href={`${homeURL}#ask-onocra`}
          class="whitespace-nowrap rounded-xl bg-[var(--onocra-sage)] px-4 py-2.5 text-sm font-extrabold text-[var(--onocra-forest)] no-underline transition hover:bg-[var(--onocra-green)] hover:text-white"
        >
          Ask ONOCRA
        </a>
      </div>

      <!-- =====================================
           MOBILE MENU BUTTON
      ====================================== -->
      <button
        id="onocra-menu-button"
        type="button"
        class="border-border flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border text-[var(--onocra-forest)] md:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="onocra-mobile-menu"
      >
        <span class="sr-only">Menu</span>

        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          class="h-6 w-6"
        >
          <path d="M4 6h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- =========================================
       DESKTOP PRIMARY NAVIGATION
       FIX / DECODE / COMPARE / CHOOSE
  ========================================== -->
  <div class="border-border hidden border-t md:block">
    <div class="app-layout py-2.5">
      <nav
        class="grid grid-cols-4 gap-2.5 lg:gap-3"
        aria-label="Primary navigation"
      >
        {
          mainNav.map(item => (
            <a
              href={item.href}
              class="group flex min-h-[66px] flex-col items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--onocra-sage)] px-3 py-2.5 text-center no-underline transition duration-200 hover:-translate-y-0.5 hover:border-[var(--onocra-green)] hover:shadow-sm"
            >
              <span
                class="block text-base font-extrabold tracking-[0.08em] text-[var(--onocra-forest)] lg:text-lg"
              >
                {item.label}
              </span>

              <span
                class="mt-0.5 block text-[0.68rem] font-semibold leading-tight text-[var(--onocra-ink)] lg:text-xs"
              >
                {item.description}
              </span>
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <!-- =========================================
       MOBILE MENU
  ========================================== -->
  <div
    id="onocra-mobile-menu"
    class="border-border bg-background hidden border-t px-4 py-4 md:hidden"
  >
    <nav aria-label="Mobile navigation">

      <!-- FOUR MAIN DOMAINS -->
      <div class="grid grid-cols-2 gap-2.5">
        {
          mainNav.map(item => (
            <a
              href={item.href}
              class="flex min-h-[74px] flex-col items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--onocra-sage)] p-3 text-center no-underline"
            >
              <span
                class="block text-base font-extrabold tracking-[0.06em] text-[var(--onocra-forest)]"
              >
                {item.label}
              </span>

              <span
                class="mt-1 block text-xs font-medium leading-snug text-[var(--onocra-ink)]"
              >
                {item.description}
              </span>
            </a>
          ))
        }
      </div>

      <!-- MOBILE SEARCH -->
      <form
        action={searchURL}
        method="get"
        class="border-border mt-4 flex items-center rounded-xl border bg-[var(--onocra-cream)] px-3"
        role="search"
      >
        <svg
          class="h-5 w-5 shrink-0 text-[var(--onocra-forest)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>

        <input
          type="search"
          name="q"
          aria-label="Search ONOCRA"
          placeholder="Search ONOCRA..."
          class="text-foreground min-w-0 flex-1 bg-transparent px-3 py-3 text-sm outline-none"
        />

        <button
          type="submit"
          class="font-bold text-[var(--onocra-forest)]"
          aria-label="Search"
        >
          →
        </button>
      </form>

      <!-- SECONDARY NAVIGATION -->
      <div class="border-border mt-4 grid grid-cols-2 gap-x-5 border-t pt-3">
        {
          secondaryNav.map(item => (
            <a
              href={item.href}
              class="text-foreground hover:text-accent border-border/60 border-b py-2.5 text-sm font-semibold no-underline"
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <!-- ASK ONOCRA -->
      <a
        href={`${homeURL}#ask-onocra`}
        class="mt-4 flex items-center justify-center rounded-xl bg-[var(--onocra-sage)] px-4 py-3 text-sm font-extrabold text-[var(--onocra-forest)] no-underline"
      >
        Ask ONOCRA
      </a>
    </nav>
  </div>
</header>

<!-- =========================================
     MOBILE MENU SCRIPT
========================================== -->
<script>
  const setupOnocraMenu = () => {
    const button = document.querySelector<HTMLButtonElement>(
      "#onocra-menu-button"
    );

    const menu = document.querySelector<HTMLElement>(
      "#onocra-mobile-menu"
    );

    if (!button || !menu || button.dataset.ready === "true") return;

    button.dataset.ready = "true";

    const closeMenu = () => {
      menu.classList.add("hidden");
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-label", "Open navigation");
    };

    button.addEventListener("click", () => {
      const isOpen =
        button.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeMenu();
      } else {
        menu.classList.remove("hidden");
        button.setAttribute("aria-expanded", "true");
        button.setAttribute("aria-label", "Close navigation");
      }
    });

    menu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closeMenu);
    });
  };

  setupOnocraMenu();

  document.addEventListener("astro:page-load", setupOnocraMenu);
</script>
