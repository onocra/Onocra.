    <a href={homeURL} class="hb-logo" aria-label="ONOCRA Home — TechnoNavigation Made Easy">
      <!-- Independent complete PNG assets: no masks, cropping or overlapping letters. -->
      <img class="hb-logo-light" src="/Header/logonamehero.png" alt="ONOCRA — TechnoNavigation Made Easy" width="2048" height="682" loading="eager" decoding="async" />
      <img class="hb-logo-dark" src="/Header/logonamehero-dark.png" alt="" aria-hidden="true" width="2172" height="724" loading="eager" decoding="async" />
