---
import { getRelativeLocaleUrl } from "astro:i18n";

const homeURL = getRelativeLocaleUrl(Astro.currentLocale ?? "en", "");
const searchURL = getRelativeLocaleUrl(Astro.currentLocale ?? "en", "search");

const currentPath = Astro.url.pathname;

const mainNav = [
  {
    label: "FIX",
    description: "Solve a tech problem",
    href: `${homeURL}#fix`,
  },
  {
    label: "DECODE",
    description: "Understand technology",
    href: `${homeURL}#decode`,
  },
  {
    label: "COMPARE",
    description: "See what really differs",
    href: `${homeURL}#compare`,
  },
  {
    label: "CHOOSE",
    description: "Find the right solution",
    href: `${homeURL}#choose`,
  },
];

const secondaryNav = [
  {
    label: "REVIEWS",
    href: `${homeURL}#reviews`,
  },
  {
    label: "UPDATES",
    href: `${homeURL}#updates`,
  },
  {
    label: "DIGITAL PARENTING",
    href: `${homeURL}#digital-parenting`,
  },
  {
    label: "DIGITAL SAFETY",
    href: `${homeURL}#digital-safety`,
  },
];
---

<a
  href="#main-content"
  class="fixed top-3 left-3 z-[100] -translate-y-24 rounded-md bg-accent px-4 py-2 font-semibold text-accent-foreground transition-transform focus:translate-y-0"
>
  Skip to content
</a>

<!-- =========================================
     ONOCRA SITE HEADER
========================================== -->
<header
  class="border-border bg-background relative z-50 border-b"
  aria-label="ONOCRA site header"
>
  <!-- =========================================
       BRAND + SECONDARY NAVIGATION
  ========================================== -->
  <div class="app-layout">
    <div
      class="flex min-h-20 items-center justify-between gap-5 py-2 lg:min-h-[92px]"
    >
      <!-- BRAND -->
      <a
        href={homeURL}
        class="flex min-w-0 shrink-0 items-center gap-3 no-underline"
        aria-label="ONOCRA home"
      >
        <img
          src="/file_0000000083088208b5fec963887cd25a.png"
          alt=""
          class="h-[4.2rem] w-[4.2rem] shrink-0 object-contain sm:h-[4.6rem] sm:w-[4.6rem]"
        />

        <div>
          <div
            class="whitespace-nowrap font-serif text-[1.8rem] leading-none font-black tracking-[0.035em] text-[var(--onocra-forest)] sm:text-[2rem]"
            aria-label="ONOCRA"
          >
            ONOCRA<span class="text-[var(--onocra-orange)]">.</span>
          </div>

          <p
            class="text-muted-foreground mt-1 hidden text-[0.68rem] font-semibold sm:block"
          >
            For every householder. Everyday solutions.
          </p>
        </div>
      </a>

      <!-- DESKTOP SECONDARY NAV -->
      <nav
        class="hidden items-center gap-1 lg:flex"
        aria-label="Site navigation"
      >
        {
          secondaryNav.map(item => (
            <a
              href={item.href}
              class="text-foreground hover:text-accent rounded-lg px-2.5 py-2 text-[0.72rem] font-bold no-underline transition-colors xl:px-3 xl:text-[0.76rem]"
            >
              {item.label}
            </a>
          ))
        }

        <a
          href={searchURL}
          class:list={[
            "text-foreground hover:text-accent rounded-lg px-3 py-2 text-[0.76rem] font-bold no-underline transition-colors",
            currentPath.includes("/search") && "text-accent",
          ]}
        >
          SEARCH
        </a>

        <a
          href={`${homeURL}#ask-onocra`}
          class="bg-accent text-accent-foreground ml-1 rounded-xl px-4 py-2.5 text-[0.76rem] font-extrabold no-underline"
        >
          ASK ONOCRA
        </a>
      </nav>

      <!-- MOBILE MENU BUTTON -->
      <button
        id="onocra-menu-button"
        type="button"
        class="border-border flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border text-[var(--onocra-forest)] lg:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="onocra-mobile-menu"
      >
        <span class="sr-only">Menu</span>

        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          class="h-6 w-6"
        >
          <path d="M4 6h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- =========================================
       DESKTOP PRIMARY INTENT NAVIGATION
       FIX / DECODE / COMPARE / CHOOSE
  ========================================== -->
  <div class="border-border hidden border-t lg:block">
    <div class="app-layout py-3">
      <nav
        class="grid grid-cols-4 gap-3"
        aria-label="Primary navigation"
      >
        {
          mainNav.map(item => (
            <a
              href={item.href}
              class="group rounded-xl border border-[var(--onocra-green)] bg-[var(--onocra-green)] px-4 py-3 text-center no-underline transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <span
                class="block text-sm font-extrabold tracking-[0.08em] text-white"
              >
                {item.label}
              </span>

              <span
                class="mt-1 block text-[0.76rem] font-semibold leading-snug text-white/90"
              >
                {item.description}
              </span>
            </a>
          ))
        }
      </nav>
    </div>
  </div>

  <!-- =========================================
       MOBILE / TABLET MENU
  ========================================== -->
  <div
    id="onocra-mobile-menu"
    class="border-border bg-background hidden border-t px-4 py-5 lg:hidden"
  >
    <nav aria-label="Mobile navigation">
      <div class="grid grid-cols-2 gap-2">
        {
          mainNav.map(item => (
            <a
              href={item.href}
              class="rounded-xl border border-[var(--onocra-green)] bg-[var(--onocra-green)] p-3 text-center no-underline"
            >
              <span class="block text-sm font-extrabold text-white">
                {item.label}
              </span>

              <span
                class="mt-1 block text-xs leading-snug text-white/90"
              >
                {item.description}
              </span>
            </a>
          ))
        }
      </div>

      <div class="border-border mt-5 border-t pt-4">
        {
          secondaryNav.map(item => (
            <a
              href={item.href}
              class="text-foreground hover:text-accent block py-2 text-sm font-semibold no-underline"
            >
              {item.label}
            </a>
          ))
        }

        <a
          href={searchURL}
          class:list={[
            "text-foreground hover:text-accent block py-2 text-sm font-semibold no-underline",
            currentPath.includes("/search") && "text-accent",
          ]}
        >
          SEARCH
        </a>

        <a
          href={`${homeURL}#ask-onocra`}
          class="bg-accent text-accent-foreground mt-3 flex items-center justify-center rounded-lg px-4 py-3 text-sm font-bold no-underline"
        >
          ASK ONOCRA
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- =========================================
     MOBILE MENU SCRIPT
========================================== -->
<script>
  const setupOnocraMenu = () => {
    const button = document.querySelector<HTMLButtonElement>(
      "#onocra-menu-button"
    );

    const menu = document.querySelector<HTMLElement>(
      "#onocra-mobile-menu"
    );

    if (!button || !menu || button.dataset.ready === "true") return;

    button.dataset.ready = "true";

    const closeMenu = () => {
      menu.classList.add("hidden");
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-label", "Open navigation");
    };

    button.addEventListener("click", () => {
      const isOpen =
        button.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeMenu();
      } else {
        menu.classList.remove("hidden");
        button.setAttribute("aria-expanded", "true");
        button.setAttribute("aria-label", "Close navigation");
      }
    });

    menu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closeMenu);
    });
  };

  setupOnocraMenu();

  document.addEventListener("astro:page-load", setupOnocraMenu);
</script>
