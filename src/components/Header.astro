---
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "en";
const homeURL = getRelativeLocaleUrl(locale, "");
const searchURL = getRelativeLocaleUrl(locale, "search");

const mainNav = [
  {
    label: "FIX",
    description: "Solve issues",
    href: `${homeURL}#fix`,
    journey: "fix",
  },
  {
    label: "DECODE",
    description: "Understand technology",
    href: `${homeURL}#decode`,
    journey: "decode",
  },
  {
    label: "COMPARE",
    description: "Research & compare",
    href: `${homeURL}#compare`,
    journey: "compare",
  },
  {
    label: "CHOOSE",
    description: "Buy smarter",
    href: `${homeURL}#choose`,
    journey: "choose",
  },
];

const secondaryNav = [
  {
    label: "Reviews",
    href: `${homeURL}#reviews`,
  },
  {
    label: "Updates",
    href: `${homeURL}#updates`,
  },
  {
    label: "Digital Parenting",
    href: `${homeURL}#digital-parenting`,
  },
  {
    label: "Digital Safety",
    href: `${homeURL}#digital-safety`,
  },
  {
    label: "Guides",
    href: `${homeURL}#guides`,
  },
  {
    label: "ONOCRA Routes",
    href: `${homeURL}#routes`,
  },
];

const journeyClasses = {
  fix: {
    card: "border-[#b8d8ea] bg-[#e7f3f9] hover:border-[#4c96bd]",
    icon: "bg-[#d3eaf5] text-[#1269b0]",
    label: "text-[#105c91]",
  },
  decode: {
    card: "border-[#bdd9cb] bg-[#e6f1e9] hover:border-[#4f9275]",
    icon: "bg-[#d3e8da] text-[#14624d]",
    label: "text-[#0f5844]",
  },
  compare: {
    card: "border-[#efcfb8] bg-[#faeadf] hover:border-[#df8a4d]",
    icon: "bg-[#f6dcc9] text-[#c85b19]",
    label: "text-[#b64f15]",
  },
  choose: {
    card: "border-[#d8cbe5] bg-[#f0eaf5] hover:border-[#9274ad]",
    icon: "bg-[#e5d9ef] text-[#765394]",
    label: "text-[#674783]",
  },
};
---

<a
  href="#main-content"
  class="fixed top-3 left-3 z-[100] -translate-y-24 rounded-md bg-accent px-4 py-2 font-semibold text-accent-foreground transition-transform focus:translate-y-0"
>
  Skip to content
</a>

<!-- =========================================
     ONOCRA SITE HEADER

     DESKTOP:
     Sidebar owns ONOCRA branding.
     Header remains compact and functional.

     MOBILE:
     Branding remains visible because the
     permanent sidebar is hidden.
========================================== -->

<header
  id="top"
  class="border-border bg-background relative z-50 border-b"
  aria-label="ONOCRA site header"
>

  <!-- =========================================
       COMPACT TOP HEADER
  ========================================== -->

  <div class="app-layout">

    <div
      class="flex min-h-20 items-center justify-between gap-4 py-2 md:min-h-[48px] md:py-1.5"
    >

      <!-- =====================================
           MOBILE BRAND ONLY
      ====================================== -->

      <a
        href={homeURL}
        class="flex min-w-0 shrink-0 items-center gap-3 no-underline md:hidden"
        aria-label="ONOCRA home"
      >

        <img
          src="/logo.png"
          alt=""
          class="h-[4.2rem] w-[4.2rem] shrink-0 object-contain"
        />

        <div>

          <div
            class="whitespace-nowrap font-serif text-[1.8rem] leading-none font-black tracking-[0.035em] text-[var(--onocra-forest)]"
            aria-label="ONOCRA"
          >
            ONOCRA<span class="text-[var(--onocra-orange)]">.</span>
          </div>

          <p
            class="text-muted-foreground mt-1 hidden text-[0.68rem] font-semibold sm:block"
          >
            For every householder. Everyday solutions.
          </p>

        </div>

      </a>


      <!-- =====================================
           DESKTOP COMPACT SEARCH + ASK
      ====================================== -->

      <div
        class="hidden min-w-0 flex-1 items-center justify-end gap-2 md:flex"
      >

        <!-- SEARCH -->

        <form
          action={searchURL}
          method="get"
          class="border-border flex h-[36px] w-full max-w-[25rem] items-center rounded-lg border bg-[var(--onocra-cream)] px-3 shadow-sm"
          role="search"
        >

          <svg
            class="h-4 w-4 shrink-0 text-[var(--onocra-forest)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>

          <input
            type="search"
            name="q"
            aria-label="Search ONOCRA"
            placeholder="Search ONOCRA..."
            class="text-foreground min-w-0 flex-1 bg-transparent px-2.5 py-1 text-[0.78rem] outline-none"
          />

          <button
            type="submit"
            aria-label="Search"
            class="text-[0.75rem] font-bold text-[var(--onocra-forest)]"
          >
            Search
          </button>

        </form>


        <!-- ASK ONOCRA -->

        <a
          href={`${homeURL}#ask-onocra`}
          class="flex h-[36px] items-center whitespace-nowrap rounded-lg bg-[var(--onocra-sage)] px-4 text-[0.78rem] font-extrabold text-[var(--onocra-forest)] no-underline transition hover:bg-[var(--onocra-green)] hover:text-white"
        >
          Ask ONOCRA
        </a>

      </div>


      <!-- =====================================
           MOBILE MENU BUTTON
      ====================================== -->

      <button
        id="onocra-menu-button"
        type="button"
        class="border-border flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border text-[var(--onocra-forest)] md:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="onocra-mobile-menu"
      >

        <span class="sr-only">
          Menu
        </span>

        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          class="h-6 w-6"
        >
          <path d="M4 6h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 18h16"></path>
        </svg>

      </button>

    </div>

  </div>


  <!-- =========================================
       DESKTOP PRIMARY JOURNEYS

       FIX / DECODE / COMPARE / CHOOSE
  ========================================== -->

  <div
    class="border-border hidden border-t md:block"
  >

    <div class="app-layout py-1.5">

      <nav
        class="grid grid-cols-4 gap-2"
        aria-label="Primary navigation"
      >

        {
          mainNav.map(item => {

            const style =
              journeyClasses[
                item.journey as keyof typeof journeyClasses
              ];

            return (

              <a
                href={item.href}
                class={`group flex min-h-[46px] items-center justify-center gap-2 rounded-lg border px-2 py-1 text-center no-underline transition duration-200 hover:shadow-sm ${style.card}`}
              >

                <!-- JOURNEY ICON -->

                <span
                  class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-full ${style.icon}`}
                  aria-hidden="true"
                >

                  {
                    item.journey === "fix" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                      >
                        <path d="M14.7 6.3a4 4 0 0 0-5-5L12 3.6 9.6 6 7.3 3.7a4 4 0 0 0 5 5l-7.6 7.6a2 2 0 1 0 2.8 2.8l7.6-7.6a4 4 0 0 0 5-5L17.8 8.8 15.4 11l-2.3-2.3 1.6-2.4Z"></path>
                      </svg>
                    )
                  }

                  {
                    item.journey === "decode" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                      >
                        <path d="M9 18h6"></path>
                        <path d="M10 22h4"></path>
                        <path d="M8.5 14.5A7 7 0 1 1 15.5 14.5C14.5 15.2 14 16 14 17h-4c0-1-.5-1.8-1.5-2.5Z"></path>
                      </svg>
                    )
                  }

                  {
                    item.journey === "compare" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                      >
                        <path d="M12 3v18"></path>
                        <path d="M5 6h14"></path>
                        <path d="m5 6-3 6h6L5 6Z"></path>
                        <path d="m19 6-3 6h6l-3-6Z"></path>
                        <path d="M3 12a3 3 0 0 0 4 0"></path>
                        <path d="M17 12a3 3 0 0 0 4 0"></path>
                      </svg>
                    )
                  }

                  {
                    item.journey === "choose" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-4 w-4"
                      >
                        <circle cx="9" cy="20" r="1"></circle>
                        <circle cx="18" cy="20" r="1"></circle>
                        <path d="M3 4h2l2.4 10.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H7"></path>
                      </svg>
                    )
                  }

                </span>


                <!-- JOURNEY TEXT -->

                <span class="min-w-0">

                  <span
                    class={`block text-[0.82rem] font-extrabold leading-none tracking-[0.08em] lg:text-[0.9rem] ${style.label}`}
                  >
                    {item.label}
                  </span>

                  <span
                    class="mt-1 block whitespace-nowrap text-[0.60rem] font-semibold leading-none text-[var(--onocra-ink)] lg:text-[0.66rem]"
                  >
                    {item.description}
                  </span>

                </span>

              </a>

            );

          })
        }

      </nav>

    </div>

  </div>


  <!-- =========================================
       MOBILE MENU
  ========================================== -->

  <div
    id="onocra-mobile-menu"
    class="border-border bg-background hidden border-t px-4 py-4 md:hidden"
  >

    <nav aria-label="Mobile navigation">


      <!-- FOUR PRIMARY JOURNEYS -->

      <div class="grid grid-cols-2 gap-2.5">

        {
          mainNav.map(item => {

            const style =
              journeyClasses[
                item.journey as keyof typeof journeyClasses
              ];

            return (

              <a
                href={item.href}
                class={`flex min-h-[74px] items-center justify-center gap-2.5 rounded-xl border p-3 text-center no-underline ${style.card}`}
              >

                <!-- MOBILE ICON -->

                <span
                  class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${style.icon}`}
                  aria-hidden="true"
                >

                  {
                    item.journey === "fix" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-[18px] w-[18px]"
                      >
                        <path d="M14.7 6.3a4 4 0 0 0-5-5L12 3.6 9.6 6 7.3 3.7a4 4 0 0 0 5 5l-7.6 7.6a2 2 0 1 0 2.8 2.8l7.6-7.6a4 4 0 0 0 5-5L17.8 8.8 15.4 11l-2.3-2.3 1.6-2.4Z"></path>
                      </svg>
                    )
                  }

                  {
                    item.journey === "decode" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-[18px] w-[18px]"
                      >
                        <path d="M9 18h6"></path>
                        <path d="M10 22h4"></path>
                        <path d="M8.5 14.5A7 7 0 1 1 15.5 14.5C14.5 15.2 14 16 14 17h-4c0-1-.5-1.8-1.5-2.5Z"></path>
                      </svg>
                    )
                  }

                  {
                    item.journey === "compare" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-[18px] w-[18px]"
                      >
                        <path d="M12 3v18"></path>
                        <path d="M5 6h14"></path>
                        <path d="m5 6-3 6h6L5 6Z"></path>
                        <path d="m19 6-3 6h6l-3-6Z"></path>
                        <path d="M3 12a3 3 0 0 0 4 0"></path>
                        <path d="M17 12a3 3 0 0 0 4 0"></path>
                      </svg>
                    )
                  }

                  {
                    item.journey === "choose" && (
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-[18px] w-[18px]"
                      >
                        <circle cx="9" cy="20" r="1"></circle>
                        <circle cx="18" cy="20" r="1"></circle>
                        <path d="M3 4h2l2.4 10.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H7"></path>
                      </svg>
                    )
                  }

                </span>


                <!-- MOBILE TEXT -->

                <span class="min-w-0 text-left">

                  <span
                    class={`block text-sm font-extrabold tracking-[0.06em] ${style.label}`}
                  >
                    {item.label}
                  </span>

                  <span
                    class="mt-1 block text-[0.68rem] font-medium leading-tight text-[var(--onocra-ink)]"
                  >
                    {item.description}
                  </span>

                </span>

              </a>

            );

          })
        }

      </div>


      <!-- MOBILE SEARCH -->

      <form
        action={searchURL}
        method="get"
        class="border-border mt-4 flex items-center rounded-xl border bg-[var(--onocra-cream)] px-3"
        role="search"
      >

        <svg
          class="h-5 w-5 shrink-0 text-[var(--onocra-forest)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>

        <input
          type="search"
          name="q"
          aria-label="Search ONOCRA"
          placeholder="Search ONOCRA..."
          class="text-foreground min-w-0 flex-1 bg-transparent px-3 py-3 text-sm outline-none"
        />

        <button
          type="submit"
          class="font-bold text-[var(--onocra-forest)]"
          aria-label="Search"
        >
          →
        </button>

      </form>


      <!-- SECONDARY NAVIGATION -->

      <div
        class="border-border mt-4 grid grid-cols-2 gap-x-5 border-t pt-3"
      >

        {
          secondaryNav.map(item => (

            <a
              href={item.href}
              class="text-foreground hover:text-accent border-border/60 border-b py-2.5 text-sm font-semibold no-underline"
            >
              {item.label}
            </a>

          ))
        }

      </div>


      <!-- ASK ONOCRA -->

      <a
        href={`${homeURL}#ask-onocra`}
        class="mt-4 flex items-center justify-center rounded-xl bg-[var(--onocra-sage)] px-4 py-3 text-sm font-extrabold text-[var(--onocra-forest)] no-underline"
      >
        Ask ONOCRA
      </a>

    </nav>

  </div>

</header>


<!-- =========================================
     MOBILE MENU SCRIPT
========================================== -->

<script>

  const setupOnocraMenu = () => {

    const button =
      document.querySelector<HTMLButtonElement>(
        "#onocra-menu-button"
      );

    const menu =
      document.querySelector<HTMLElement>(
        "#onocra-mobile-menu"
      );

    if (
      !button ||
      !menu ||
      button.dataset.ready === "true"
    ) {
      return;
    }

    button.dataset.ready = "true";


    const closeMenu = () => {

      menu.classList.add("hidden");

      button.setAttribute(
        "aria-expanded",
        "false"
      );

      button.setAttribute(
        "aria-label",
        "Open navigation"
      );

    };


    button.addEventListener(
      "click",
      () => {

        const isOpen =
          button.getAttribute(
            "aria-expanded"
          ) === "true";

        if (isOpen) {

          closeMenu();

        } else {

          menu.classList.remove(
            "hidden"
          );

          button.setAttribute(
            "aria-expanded",
            "true"
          );

          button.setAttribute(
            "aria-label",
            "Close navigation"
          );

        }

      }
    );


    menu
      .querySelectorAll("a")
      .forEach(link => {

        link.addEventListener(
          "click",
          closeMenu
        );

      });

  };


  setupOnocraMenu();

  document.addEventListener(
    "astro:page-load",
    setupOnocraMenu
  );

</script>
