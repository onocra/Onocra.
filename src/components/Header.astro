---
/**
 * ONOCRA Header BP08 — controlled hub typography, retaining approved BP07 design.
 *  - Fixed, full-viewport-width header: horizontal brand on left.
 *  - Search and Theme in upper-right; four glossy hub pills grouped lower-right.
 *  - No duplicated brand in the sidebar; mobile adapts to two hub rows.
 *  - Latest from ONOCRA lives in the fixed sidebar / mobile menu.
 *  - Below 900px it also carries the sidebar links in a menu (the sidebar is desktop-only).
 *
 * This file replaces src/components/Header.astro.
 * Hub and comparison pages keep their current headers until those pages are refined.
 *
 * EDIT HERE: the HUBS list below (names, paths, destinations).
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { SITE_NAV } from "@/data/siteNav";

const locale = Astro.currentLocale ?? config.site.lang;
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const homeURL = url("");
const searchURL = url("search");
// Hubs without their own pages yet fall back to a site search for that topic.
const searchFor = (text: string) => `${url("search/")}?q=${encodeURIComponent(text)}`;
const currentPath = Astro.url.pathname;

const ACTIONS = [
  {
    id: "fix",
    label: "Fix",
    hint: "Solve a problem step by step",
    icon: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.1L3.6 17.1a1.8 1.8 0 0 0 2.6 2.6l5.7-5.7a4 4 0 0 0 5.1-5.4l-2.5 2.5-2.2-.5-.5-2.2 2.5-2.5Z"></path>',
  },
  {
    id: "decode",
    label: "Decode",
    hint: "Understand the jargon",
    icon: '<path d="M9 18h6M10 21h4"></path><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z"></path>',
  },
  {
    id: "compare",
    label: "Compare",
    hint: "Options side by side",
    icon: '<path d="M12 4v16M7 20h10"></path><path d="M5 7h14"></path><path d="m5 7-3 6a3 3 0 0 0 6 0L5 7Z"></path><path d="m19 7-3 6a3 3 0 0 0 6 0l-3-6Z"></path>',
  },
  {
    id: "choose",
    label: "Choose",
    hint: "Pick with confidence",
    icon: '<circle cx="12" cy="12" r="8.5"></circle><path d="m8.5 12.2 2.4 2.4 4.6-5"></path>',
  },
] as const;

type Hub = {
  id: string;
  title: string; // full name, shown in the dropdown
  short: string; // slim pill label
  home?: string; // hub landing page; omit while the hub has no page (falls back to search)
  color: string;
  icon: string;
  /** per-action page paths; any action left out falls back to a search for that topic */
  to?: Partial<Record<(typeof ACTIONS)[number]["id"], string>>;
  /** extra quick links shown under the actions */
  extras?: { label: string; path: string }[];
};

const HUBS: Hub[] = [
  {
    id: "phones",
    title: "Phones & Tablets",
    short: "Phones & Tablets",
    home: "phones/",
    color: "#d9540f",
    icon: '<rect x="7" y="2.5" width="10" height="19" rx="2.2"></rect><path d="M11 18.5h2"></path>',
    to: { fix: "phones/", compare: "phones/reviews/", choose: "phones/reviews/" },
    extras: [
      { label: "Digital Parenting", path: "#digital-parenting" },
      { label: "Reviews & Comparisons", path: "phones/reviews/" },
    ],
  },
  {
    id: "internet",
    title: "Home Internet & Wi-Fi",
    short: "Home Wi-Fi",
    color: "#2f7fb8",
    icon: '<path d="M2.5 9.5a14 14 0 0 1 19 0"></path><path d="M5.5 13a9.5 9.5 0 0 1 13 0"></path><path d="M8.7 16.4a5 5 0 0 1 6.6 0"></path><circle cx="12" cy="19.6" r="1"></circle>',
  },
  {
    id: "computers",
    title: "Computers & Laptops",
    short: "Computers",
    color: "#5a5fc4",
    icon: '<rect x="4" y="5" width="16" height="11" rx="1.6"></rect><path d="M2 19.5h20"></path>',
  },
  {
    id: "safety",
    title: "Digital Security",
    short: "Digital Security",
    color: "#2e8b57",
    icon: '<path d="M12 3 4.5 6v5.5c0 4.5 3.1 7.6 7.5 9.5 4.4-1.9 7.5-5 7.5-9.5V6L12 3Z"></path><path d="m9 12 2.2 2.2L15.2 10"></path>',
  },
];

const hubs = HUBS.map((h) => {
  const href = h.home ? url(h.home) : searchFor(h.title);
  return {
    ...h,
    href,
    active: !!h.home && currentPath.startsWith(url(h.home).replace(/\/$/, "")),
    actions: ACTIONS.map((a) => ({
      ...a,
      href: h.to?.[a.id] ? url(h.to[a.id]!) : searchFor(`${h.short} ${a.label.toLowerCase()}`),
    })),
    extras: (h.extras ?? []).map((e) => ({ ...e, href: e.path.startsWith("#") ? `${homeURL}${e.path}` : url(e.path) })),
  };
});
---

