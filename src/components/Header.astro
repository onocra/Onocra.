---
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "en";
const homeURL = getRelativeLocaleUrl(locale, "");
const searchURL = getRelativeLocaleUrl(locale, "search");

const technologyDomains = [
  {
    title: "Phones, Tablets & Wearables",
    image: "/Header/headerphone.png",
    href: "/phones/",
    theme: "phone",
  },
  {
    title: "Home Internet & Wi-Fi",
    image: "/Header/headerwifi.png",
    href: "/internet/",
    theme: "wifi",
  },
  {
    title: "Computers & Laptops",
    image: "/Header/headerlaptop.png",
    href: "/computers/",
    theme: "computer",
  },
  {
    title: "Safety & Security",
    image: "/Header/headersafety.png",
    href: "/safety/",
    theme: "safety",
  },
];

const domainClasses = {
  phone: "border-[#d6dadd] bg-[#f1f2f2] dark:border-[#394653] dark:bg-[#202934]",
  wifi: "border-[#d6dadd] bg-[#f1f2f2] dark:border-[#394653] dark:bg-[#202934]",
  computer: "border-[#d6dadd] bg-[#f1f2f2] dark:border-[#394653] dark:bg-[#202934]",
  safety: "border-[#d6dadd] bg-[#f1f2f2] dark:border-[#394653] dark:bg-[#202934]",
};

const mobileNav = [
  {
    label: "FIX",
    description: "Solve an issue",
    href: `${homeURL}#fix`,
    className: "border-[#b8d8ea] bg-[#e7f3f9] text-[#105c91]",
  },
  {
    label: "DECODE",
    description: "Understand technology",
    href: `${homeURL}#decode`,
    className: "border-[#bdd9cb] bg-[#e6f1e9] text-[#0f5844]",
  },
  {
    label: "COMPARE",
    description: "Research & compare",
    href: `${homeURL}#compare`,
    className: "border-[#efcfb8] bg-[#faeadf] text-[#b64f15]",
  },
  {
    label: "CHOOSE",
    description: "Buy smarter",
    href: `${homeURL}#choose`,
    className: "border-[#d8cbe5] bg-[#f0eaf5] text-[#674783]",
  },
];

const secondaryNav = [
  { label: "Reviews", href: `${homeURL}#reviews` },
  { label: "Updates", href: `${homeURL}#updates` },
  { label: "Digital Parenting", href: `${homeURL}#digital-parenting` },
  { label: "Guides", href: `${homeURL}#guides` },
];
---

<a
  href="#main-content"
  class="fixed top-3 left-3 z-[200] -translate-y-24 rounded-md bg-accent px-4 py-2 font-semibold text-accent-foreground transition-transform focus:translate-y-0"
>
  Skip to content
</a>

<header
  id="top"
  class="fixed top-0 right-0 left-0 z-[100] border-b border-border bg-background/95 shadow-[0_2px_10px_rgba(15,42,67,0.06)] backdrop-blur-md md:left-[136px]"
  aria-label="ONOCRA site header"
>
  <div class="app-layout">
    <div class="flex min-h-[48px] items-center justify-between gap-3 py-1.5">
      <a
        href={homeURL}
        class="flex min-w-0 items-center gap-2.5 no-underline md:hidden"
        aria-label="ONOCRA home"
      >
        <div class="relative h-[4.2rem] w-[4.2rem] shrink-0 overflow-hidden">
          <img
            src="/homepage/LOGO.png"
            alt=""
            class="absolute top-0 left-1/2 h-[13.4rem] w-auto max-w-none -translate-x-1/2 object-contain"
          />
        </div>

        <div
          class="whitespace-nowrap font-serif text-[1.75rem] leading-none font-black tracking-[0.055em] text-[#315e4c] dark:text-[#eef4f1]"
        >
          NOCRA<span class="ml-[0.06em] text-[#f56622]">.</span>
        </div>
      </a>

      <div class="hidden flex-1 md:block"></div>

      <div class="hidden shrink-0 items-center justify-end gap-2.5 md:flex">
        <a
          href={`${homeURL}#updates`}
          class="flex h-[25px] shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-[#d6dadd] bg-[#f1f2f2] px-3 text-[0.46rem] font-semibold text-[#315e4c] no-underline shadow-sm transition hover:border-[#91bea1] hover:bg-[#d4eadb] dark:border-[#43505b] dark:bg-[#27333a] dark:text-[#cbe4d7]"
          aria-label="Latest from ONOCRA"
        >
          <svg viewBox="0 0 24 24" class="h-3 w-3" aria-hidden="true">
            <path
              d="M4 5h16v14H4z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
            ></path>
            <path
              d="M7 8h5M7 12h10M7 16h10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
          </svg>
          <span>Latest from ONOCRA</span>
        </a>

        <form
          action={searchURL}
          method="get"
          class="flex h-[25px] w-[205px] shrink-0 items-center rounded-full border border-[#d6dadd] bg-[#f1f2f2] px-3 text-[#315e4c] shadow-sm dark:border-[#43505b] dark:bg-[#27333a] dark:text-[#cbe4d7]"
          role="search"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-3 w-3 shrink-0 text-[#315e4c] dark:text-[#cbe4d7]"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="6.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            ></circle>
            <path
              d="m16 16 4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
          </svg>

          <input
            type="search"
            name="q"
            aria-label="Search ONOCRA"
            placeholder="Search..."
            class="min-w-0 flex-1 bg-transparent px-2 py-0.5 text-[0.47rem] text-[#315e4c] placeholder:text-[#587365] outline-none dark:text-[#cbe4d7] dark:placeholder:text-[#a9c9bb]"
          />
          <button type="submit" class="sr-only">Search</button>
        </form>

        <button
          id="theme-btn"
          type="button"
          class="flex h-[36px] w-[36px] shrink-0 items-center justify-center rounded-full border border-[#d6dadd] bg-[#f1f2f2] text-[#315e4c] shadow-sm transition hover:scale-[1.04] hover:bg-[#ffe9a5] dark:bg-[#29323d] dark:text-[#f3ca58]"
          aria-label="light"
          title="Change appearance"
        >
          <svg
            class="h-[18px] w-[18px] dark:hidden"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
          </svg>

          <svg
            class="hidden h-[18px] w-[18px] dark:block"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.3 8.3 0 1 0 11.2 11.2Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>
      </div>

      <div class="flex items-center gap-2 md:hidden">
        <button
          id="onocra-mobile-theme"
          type="button"
          class="flex h-[38px] w-[38px] items-center justify-center rounded-full border border-border bg-[#fff3cc] text-[#c98713] dark:bg-[#29323d] dark:text-[#f3ca58]"
          aria-label="Change theme"
        >
          <svg
            class="h-[18px] w-[18px] dark:hidden"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            ></path>
          </svg>
          <svg
            class="hidden h-[18px] w-[18px] dark:block"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.3 8.3 0 1 0 11.2 11.2Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
            ></path>
          </svg>
        </button>

        <button
          id="onocra-menu-button"
          type="button"
          class="flex h-[38px] w-[38px] items-center justify-center rounded-lg border border-border bg-background"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="onocra-mobile-menu"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="hidden border-t border-border md:block">
    <div class="app-layout py-1">
      <nav class="ml-auto grid w-[70%] grid-cols-4 gap-1.5" aria-label="Technology topics">
        {
          technologyDomains.map(domain => {
            const cardClass =
              domainClasses[domain.theme as keyof typeof domainClasses];

            return (
              <a
                href={domain.href}
                class={`group relative flex min-h-[72px] flex-col overflow-hidden rounded-[14px] border no-underline shadow-sm transition duration-200 hover:-translate-y-[1px] hover:shadow-md ${cardClass}`}
              >
                <div class="flex flex-1 items-center gap-1.5 px-2 pt-1">
                  <div class="flex h-[43px] w-[36%] shrink-0 items-center justify-center">
                    <img
                      src={domain.image}
                      alt=""
                      loading="eager"
                      class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.04]"
                    />
                  </div>

                  <div class="flex min-w-0 flex-1 items-center justify-between gap-1.5">
                    <h2
                      class="m-0 font-serif text-[0.60rem] font-black leading-[1.04] tracking-[-0.015em] text-[#315e4c] dark:text-[#cbe4d7] lg:text-[0.67rem]"
                    >
                      {domain.title}
                    </h2>

                    <span
                      class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white/65 text-[#14624d] transition-transform duration-200 group-hover:translate-x-0.5 dark:bg-white/10 dark:text-[#9fd4bf]"
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 24 24" class="h-3 w-3">
                        <path
                          d="m9 6 6 6-6 6"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        ></path>
                      </svg>
                    </span>
                  </div>
                </div>

                <div class="px-2 pb-1.5 pt-0">
                  <div
                    class="flex items-center justify-between whitespace-nowrap text-[0.37rem] font-extrabold tracking-[0.01em] text-[#315e4c] lg:text-[0.41rem]"
                    aria-label="Fix, Decode, Compare and Choose"
                  >
                    <span class="text-[#315e4c] dark:text-white">FIX</span>
                    <span class="text-[#82919a]">·</span>
                    <span class="text-[#315e4c] dark:text-white">DECODE</span>
                    <span class="text-[#82919a]">·</span>
                    <span class="text-[#315e4c] dark:text-white">COMPARE</span>
                    <span class="text-[#82919a]">·</span>
                    <span class="text-[#315e4c] dark:text-white">CHOOSE</span>
                  </div>
                </div>
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>

  <div
    id="onocra-mobile-menu"
    class="hidden border-t border-border bg-background px-4 py-4 md:hidden"
  >
    <nav aria-label="Mobile navigation">
      <div class="grid grid-cols-2 gap-2.5">
        {
          mobileNav.map(item => (
            <a
              href={item.href}
              class={`flex min-h-[72px] flex-col justify-center rounded-xl border p-3 no-underline ${item.className}`}
            >
              <strong class="text-[0.8rem] tracking-[0.06em]">
                {item.label}
              </strong>
              <span class="mt-1 text-[0.67rem] font-medium text-[#17334a]">
                {item.description}
              </span>
            </a>
          ))
        }
      </div>

      <form
        action={searchURL}
        method="get"
        class="mt-4 flex items-center rounded-xl border border-border bg-[#fffaf1] px-3 dark:bg-[#202731]"
        role="search"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" aria-hidden="true">
          <circle
            cx="11"
            cy="11"
            r="6.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          ></circle>
          <path
            d="m16 16 4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          ></path>
        </svg>

        <input
          type="search"
          name="q"
          placeholder="Search ONOCRA..."
          aria-label="Search ONOCRA"
          class="min-w-0 flex-1 bg-transparent px-3 py-3 text-sm outline-none"
        />
      </form>

      <div class="mt-4 grid grid-cols-2 gap-x-5 border-t border-border pt-3">
        {
          secondaryNav.map(item => (
            <a
              href={item.href}
              class="border-b border-border/60 py-2.5 text-sm font-semibold text-foreground no-underline hover:text-accent"
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>


<!-- Keeps page content below the fixed header -->
<div aria-hidden="true" class="h-[73px] md:h-[128px]"></div>

<script>
  const setupOnocraHeader = () => {
    const menuButton =
      document.querySelector<HTMLButtonElement>("#onocra-menu-button");

    const menu =
      document.querySelector<HTMLElement>("#onocra-mobile-menu");

    if (
      menuButton &&
      menu &&
      menuButton.dataset.ready !== "true"
    ) {
      menuButton.dataset.ready = "true";

      menuButton.addEventListener("click", () => {
        const isOpen =
          menuButton.getAttribute("aria-expanded") === "true";

        menuButton.setAttribute(
          "aria-expanded",
          String(!isOpen)
        );

        menuButton.setAttribute(
          "aria-label",
          isOpen ? "Open menu" : "Close menu"
        );

        menu.classList.toggle("hidden", isOpen);
      });

      menu.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => {
          menu.classList.add("hidden");
          menuButton.setAttribute("aria-expanded", "false");
          menuButton.setAttribute("aria-label", "Open menu");
        });
      });
    }

    const mobileTheme =
      document.querySelector<HTMLButtonElement>("#onocra-mobile-theme");

    if (
      mobileTheme &&
      mobileTheme.dataset.ready !== "true"
    ) {
      mobileTheme.dataset.ready = "true";

      mobileTheme.addEventListener("click", () => {
        document
          .querySelector<HTMLButtonElement>("#theme-btn")
          ?.click();
      });
    }
  };

  setupOnocraHeader();

  document.addEventListener(
    "astro:page-load",
    setupOnocraHeader
  );
</script>
