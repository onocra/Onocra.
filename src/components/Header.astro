<script>
  // One delegated set of listeners for the whole site. The guard stops double-binding,
  // and delegation keeps everything working after ClientRouter page swaps.
  const w = window as unknown as { __onocraHubBar?: boolean; __theme?: { value: string } };
  if (!w.__onocraHubBar) {
    w.__onocraHubBar = true;

    const closeAll = (except?: Element | null) => {
      document.querySelectorAll<HTMLElement>('[data-hb-toggle][aria-expanded="true"]').forEach((btn) => {
        if (btn === except) return;
        btn.setAttribute("aria-expanded", "false");
        document.getElementById(btn.getAttribute("aria-controls") || "")?.setAttribute("hidden", "");
      });
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      const toggle = target.closest<HTMLElement>("[data-hb-toggle]");
      if (toggle) {
        const wasOpen = toggle.getAttribute("aria-expanded") === "true";
        closeAll();
        if (!wasOpen) {
          toggle.setAttribute("aria-expanded", "true");
          document.getElementById(toggle.getAttribute("aria-controls") || "")?.removeAttribute("hidden");
        }
        return;
      }

      if (target.closest("[data-hb-theme]")) {
        // The existing src/scripts/theme.ts binds to #theme-btn and owns this action.
        return;
      }

      // clicking a link inside a panel, or anywhere outside one, closes the open panel
      if (target.closest(".hb-panel a") || !target.closest(".hb-panel")) closeAll();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = document.querySelector<HTMLElement>('[data-hb-toggle][aria-expanded="true"]');
      closeAll();
      open?.focus();
    });

    document.addEventListener("astro:before-swap", () => closeAll());
  }
</script>

