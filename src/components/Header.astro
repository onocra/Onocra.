---
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale ?? "en";
const homeURL = getRelativeLocaleUrl(locale, "");
const searchURL = getRelativeLocaleUrl(locale, "search");

const mainNav = [
  {
    label: "FIX",
    description: "Solve issues",
    href: `${homeURL}#fix`,
    journey: "fix",
  },
  {
    label: "DECODE",
    description: "Understand technology",
    href: `${homeURL}#decode`,
    journey: "decode",
  },
  {
    label: "COMPARE",
    description: "Research & compare",
    href: `${homeURL}#compare`,
    journey: "compare",
  },
  {
    label: "CHOOSE",
    description: "Buy smarter",
    href: `${homeURL}#choose`,
    journey: "choose",
  },
];

const technologyDomains = [
  {
    title: "Phones, Tablets & Wearables",
    image: "/Header/headerphone.png",
    href: `${homeURL}#phones-tablets-wearables`,
    theme: "phone",
    arrow: "bg-[#bfe7fa] text-[#1269b0]",
  },
  {
    title: "Home Internet & Wi-Fi",
    image: "/Header/headerwifi.png",
    href: `${homeURL}#home-internet-wifi`,
    theme: "wifi",
    arrow: "bg-[#bfeccf] text-[#14624d]",
  },
  {
    title: "Computers & Laptops",
    image: "/Header/headerlaptop.png",
    href: `${homeURL}#computers-laptops`,
    theme: "computer",
    arrow: "bg-[#ffe5ad] text-[#c85b19]",
  },
  {
    title: "Safety & Security",
    image: "/Header/headersafety.png",
    href: `${homeURL}#safety-security`,
    theme: "safety",
    arrow: "bg-[#e5d4f6] text-[#674783]",
  },
];

const domainClasses = {
  phone:
    "border-[#cfe3ee] bg-[#eaf6fc]",
  wifi:
    "border-[#d4e8d8] bg-[#edf7ed]",
  computer:
    "border-[#eee0c5] bg-[#fff5dd]",
  safety:
    "border-[#e4d8ee] bg-[#f5ecfb]",
};

const secondaryNav = [
  {
    label: "Reviews",
    href: `${homeURL}#reviews`,
  },
  {
    label: "Updates",
    href: `${homeURL}#updates`,
  },
  {
    label: "Digital Parenting",
    href: `${homeURL}#digital-parenting`,
  },
  {
    label: "Guides",
    href: `${homeURL}#guides`,
  },
  {
    label: "ONOCRA Routes",
    href: `${homeURL}#routes`,
  },
];

const journeyClasses = {
  fix: {
    card: "border-[#b8d8ea] bg-[#e7f3f9] hover:border-[#4c96bd]",
    icon: "text-[#1269b0]",
    label: "text-[#105c91]",
  },
  decode: {
    card: "border-[#bdd9cb] bg-[#e6f1e9] hover:border-[#4f9275]",
    icon: "text-[#14624d]",
    label: "text-[#0f5844]",
  },
  compare: {
    card: "border-[#efcfb8] bg-[#faeadf] hover:border-[#df8a4d]",
    icon: "text-[#c85b19]",
    label: "text-[#b64f15]",
  },
  choose: {
    card: "border-[#d8cbe5] bg-[#f0eaf5] hover:border-[#9274ad]",
    icon: "text-[#765394]",
    label: "text-[#674783]",
  },
};
---

<a
  href="#main-content"
  class="fixed top-3 left-3 z-[100] -translate-y-24 rounded-md bg-accent px-4 py-2 font-semibold text-accent-foreground transition-transform focus:translate-y-0"
>
  Skip to content
</a>

<!-- =========================================
     ONOCRA SITE HEADER
========================================== -->

<header
  id="top"
  class="border-border bg-background relative z-50 border-b"
  aria-label="ONOCRA site header"
>

  <!-- =========================================
       TOP UTILITY BAR
  ========================================== -->

  <div class="app-layout">

    <div
      class="flex min-h-20 items-center justify-between gap-4 py-2 md:min-h-[48px] md:py-1.5"
    >

      <!-- =====================================
           MOBILE BRAND ONLY
      ====================================== -->

      <a
        href={homeURL}
        class="flex min-w-0 shrink-0 items-center gap-3 no-underline md:hidden"
        aria-label="ONOCRA home"
      >

        <img
          src="/logo.png"
          alt=""
          class="h-[4.2rem] w-[4.2rem] shrink-0 object-contain"
        />

        <div>

          <div
            class="whitespace-nowrap font-serif text-[1.8rem] leading-none font-black tracking-[0.035em] text-[var(--onocra-forest)]"
            aria-label="ONOCRA"
          >
            ONOCRA<span class="text-[var(--onocra-orange)]">.</span>
          </div>

          <p
            class="text-muted-foreground mt-1 hidden text-[0.68rem] font-semibold sm:block"
          >
            For every householder. Everyday solutions.
          </p>

        </div>

      </a>


      <!-- =====================================
           DESKTOP UTILITIES
           LATEST + SEARCH
      ====================================== -->

      <div
        class="hidden min-w-0 flex-1 items-center justify-end gap-3 md:flex"
      >

        <!-- LATEST FROM ONOCRA -->

        <a
          href={`${homeURL}#updates`}
          class="flex h-[36px] shrink-0 items-center gap-2 whitespace-nowrap rounded-full
                 border border-[#eadfc8] bg-[#fff4d8] px-4
                 text-[0.76rem] font-semibold text-[#765522]
                 no-underline shadow-sm transition
                 hover:border-[#dfc999] hover:bg-[#ffefc4]"
          aria-label="Latest from ONOCRA"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <rect
              x="5"
              y="3"
              width="14"
              height="18"
              rx="2"
            ></rect>

            <path d="M9 7h6"></path>
            <path d="M9 11h6"></path>
            <path d="M9 15h4"></path>
          </svg>

          <span>
            Latest from ONOCRA
          </span>

        </a>


        <!-- SEARCH -->

        <form
          action={searchURL}
          method="get"
          class="border-border flex h-[36px] w-[220px] shrink-0 items-center
       rounded-full border bg-[var(--onocra-cream)] px-3 shadow-sm"
          role="search"
        >

          <svg
            class="h-4 w-4 shrink-0 text-[var(--onocra-forest)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="7"
            ></circle>

            <path
              d="m20 20-3.5-3.5"
            ></path>
          </svg>

          <input
            type="search"
            name="q"
            aria-label="Search ONOCRA"
            placeholder="Search..."
            class="text-foreground min-w-0 flex-1 bg-transparent px-2.5 py-1 text-[0.78rem] outline-none"
          />

          <button
  type="submit"
  aria-label="Search"
  class="sr-only"
>
  Search
</button>

        </form>

      </div>


      <!-- =====================================
           MOBILE MENU BUTTON
      ====================================== -->

      <button
        id="onocra-menu-button"
        type="button"
        class="border-border flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border text-[var(--onocra-forest)] md:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="onocra-mobile-menu"
      >

        <span class="sr-only">
          Menu
        </span>

        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          class="h-6 w-6"
        >
          <path d="M4 6h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 18h16"></path>
        </svg>

      </button>

    </div>

  </div>

 <!-- =========================================
     DESKTOP TECHNOLOGY DOMAINS
========================================== -->

<div class="border-border hidden border-t md:block">

  <div class="app-layout py-3">

    <nav
      class="grid grid-cols-4 gap-3"
      aria-label="Technology topics"
    >

      {
        technologyDomains.map(domain => {

          const cardClass =
            domainClasses[
              domain.theme as keyof typeof domainClasses
            ];

          return (

            <a
              href={domain.href}
              class={`group relative flex min-h-[188px] flex-col overflow-hidden
                      rounded-[18px] border no-underline shadow-sm
                      transition duration-200
                      hover:-translate-y-[1px] hover:shadow-md
                      ${cardClass}`}
            >

              <!-- DOMAIN IMAGE -->

              <div
                class="flex h-[100px] items-center justify-center overflow-hidden px-4 pt-2"
              >

                <img
                  src={domain.image}
                  alt=""
                  loading="eager"
                  class="h-full w-full object-contain transition duration-300
                         group-hover:scale-[1.025]"
                />

              </div>


              <!-- DOMAIN CONTENT -->

              <div
                class="flex flex-1 flex-col justify-between px-4 pb-3 pt-1"
              >

                <!-- TITLE + ARROW -->

                <div
                  class="flex items-start justify-between gap-2"
                >

                  <h2
                    class="m-0 max-w-[85%] font-serif
                           text-[1.05rem] font-black leading-[1.02]
                           tracking-[-0.015em]
                           text-[var(--onocra-ink)]
                           lg:text-[1.18rem]"
                  >
                    {domain.title}
                  </h2>


                  <span
                    class={`mt-0.5 flex h-8 w-8 shrink-0
                            items-center justify-center rounded-full
                            transition-transform duration-200
                            group-hover:translate-x-0.5
                            ${domain.arrow}`}
                    aria-hidden="true"
                  >

                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4"
                    >
                      <path d="M5 12h14"></path>
                      <path d="m13 6 6 6-6 6"></path>
                    </svg>

                  </span>

                </div>


                <!-- FIX / DECODE / COMPARE / CHOOSE -->

                <div
                  class="mt-3 flex items-center justify-between
                         whitespace-nowrap text-[0.57rem]
                         font-extrabold tracking-[0.035em]
                         lg:text-[0.64rem]"
                  aria-label="Available help: Fix, Decode, Compare and Choose"
                >

                  <span class="text-[#1269b0]">
                    FIX
                  </span>

                  <span
                    class="text-[var(--onocra-ink)]/30"
                    aria-hidden="true"
                  >
                    ·
                  </span>

                  <span class="text-[#16805f]">
                    DECODE
                  </span>

                  <span
                    class="text-[var(--onocra-ink)]/30"
                    aria-hidden="true"
                  >
                    ·
                  </span>

                  <span class="text-[#df641b]">
                    COMPARE
                  </span>

                  <span
                    class="text-[var(--onocra-ink)]/30"
                    aria-hidden="true"
                  >
                    ·
                  </span>

                  <span class="text-[#6736a5]">
                    CHOOSE
                  </span>

                </div>

              </div>

            </a>

          );

        })
      }

    </nav>

  </div>

</div>

  <!-- =========================================
       MOBILE MENU
  ========================================== -->

  <div
    id="onocra-mobile-menu"
    class="border-border bg-background hidden border-t px-4 py-4 md:hidden"
  >

    <nav aria-label="Mobile navigation">


      <!-- FOUR PRIMARY JOURNEYS -->

      <div class="grid grid-cols-2 gap-2.5">

        {
          mainNav.map(item => {

            const style =
              journeyClasses[
                item.journey as keyof typeof journeyClasses
              ];

            return (

              <a
                href={item.href}
                class={`flex min-h-[74px] items-center justify-center gap-3 rounded-xl border p-3 text-center no-underline ${style.card}`}
              >

                <span
                  class={`flex shrink-0 items-center justify-center ${style.icon}`}
                  aria-hidden="true"
                >

                  {
                    item.journey === "fix" && (

                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-7 w-7"
                      >
                        <path d="M14.7 6.3a4 4 0 0 0-5-5L12 3.6 9.6 6 7.3 3.7a4 4 0 0 0 5 5l-7.6 7.6a2 2 0 1 0 2.8 2.8l7.6-7.6a4 4 0 0 0 5-5L17.8 8.8 15.4 11l-2.3-2.3 1.6-2.4Z"></path>
                      </svg>

                    )
                  }


                  {
                    item.journey === "decode" && (

                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-7 w-7"
                      >
                        <path d="M9 18h6"></path>
                        <path d="M10 22h4"></path>
                        <path d="M8.5 14.5A7 7 0 1 1 15.5 14.5C14.5 15.2 14 16 14 17h-4c0-1-.5-1.8-1.5-2.5Z"></path>
                      </svg>

                    )
                  }


                  {
                    item.journey === "compare" && (

                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-7 w-7"
                      >
                        <path d="M12 3v18"></path>
                        <path d="M5 6h14"></path>
                        <path d="m5 6-3 6h6L5 6Z"></path>
                        <path d="m19 6-3 6h6l-3-6Z"></path>
                        <path d="M3 12a3 3 0 0 0 4 0"></path>
                        <path d="M17 12a3 3 0 0 0 4 0"></path>
                      </svg>

                    )
                  }


                  {
                    item.journey === "choose" && (

                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-7 w-7"
                      >
                        <circle cx="9" cy="20" r="1"></circle>
                        <circle cx="18" cy="20" r="1"></circle>
                        <path d="M3 4h2l2.4 10.4a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 8H7"></path>
                      </svg>

                    )
                  }

                </span>


                <span class="min-w-0 text-left">

                  <span
                    class={`block text-sm font-extrabold tracking-[0.06em] ${style.label}`}
                  >
                    {item.label}
                  </span>

                  <span
                    class="mt-1 block text-[0.68rem] font-medium leading-tight text-[var(--onocra-ink)]"
                  >
                    {item.description}
                  </span>

                </span>

              </a>

            );

          })
        }

      </div>


      <!-- =====================================
           MOBILE SEARCH
      ====================================== -->

      <form
        action={searchURL}
        method="get"
        class="border-border mt-4 flex items-center rounded-xl border bg-[var(--onocra-cream)] px-3"
        role="search"
      >

        <svg
          class="h-5 w-5 shrink-0 text-[var(--onocra-forest)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>

        <input
          type="search"
          name="q"
          aria-label="Search ONOCRA"
          placeholder="Search ONOCRA..."
          class="text-foreground min-w-0 flex-1 bg-transparent px-3 py-3 text-sm outline-none"
        />

        <button
          type="submit"
          class="font-bold text-[var(--onocra-forest)]"
          aria-label="Search"
        >
          →
        </button>

      </form>


      <!-- =====================================
           SECONDARY MOBILE NAVIGATION
      ====================================== -->

      <div
        class="border-border mt-4 grid grid-cols-2 gap-x-5 border-t pt-3"
      >

        {
          secondaryNav.map(item => (

            <a
              href={item.href}
              class="text-foreground hover:text-accent border-border/60 border-b py-2.5 text-sm font-semibold no-underline"
            >
              {item.label}
            </a>

          ))
        }

      </div>

    </nav>

  </div>

</header>


<!-- =========================================
     MOBILE MENU SCRIPT
========================================== -->

<script>

  const setupOnocraMenu = () => {

    const button =
      document.querySelector<HTMLButtonElement>(
        "#onocra-menu-button"
      );

    const menu =
      document.querySelector<HTMLElement>(
        "#onocra-mobile-menu"
      );

    if (
      !button ||
      !menu ||
      button.dataset.ready === "true"
    ) {
      return;
    }

    button.dataset.ready = "true";


    const closeMenu = () => {

      menu.classList.add("hidden");

      button.setAttribute(
        "aria-expanded",
        "false"
      );

      button.setAttribute(
        "aria-label",
        "Open navigation"
      );

    };


    button.addEventListener(
      "click",
      () => {

        const isOpen =
          button.getAttribute(
            "aria-expanded"
          ) === "true";

        if (isOpen) {

          closeMenu();

        } else {

          menu.classList.remove(
            "hidden"
          );

          button.setAttribute(
            "aria-expanded",
            "true"
          );

          button.setAttribute(
            "aria-label",
            "Close navigation"
          );

        }

      }
    );


    menu
      .querySelectorAll("a")
      .forEach(link => {

        link.addEventListener(
          "click",
          closeMenu
        );

      });

  };


  setupOnocraMenu();

  document.addEventListener(
    "astro:page-load",
    setupOnocraMenu
  );

</script>
