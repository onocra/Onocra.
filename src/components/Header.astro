---
/**
 * ONOCRA Header: the slim, sticky top bar (V3 navigation adapted for Phase 1).
 *
 *  - Four slim hub pills. Each opens a dropdown with Fix / Decode / Compare / Choose.
 *  - "Latest from ONOCRA", search and the light/dark switch stay always reachable.
 *  - Below 900px it also carries the sidebar links in a menu (the sidebar is desktop-only).
 *
 * This file replaces src/components/Header.astro.
 * Hub and comparison pages keep their current headers until those pages are refined.
 *
 * EDIT HERE: the HUBS list below (names, paths, destinations).
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { SITE_NAV } from "@/data/siteNav";

const locale = Astro.currentLocale ?? config.site.lang;
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const homeURL = url("");
const searchURL = url("search");
// Hubs without their own pages yet fall back to a site search for that topic.
const searchFor = (text: string) => `${url("search/")}?q=${encodeURIComponent(text)}`;
const currentPath = Astro.url.pathname;

const ACTIONS = [
  {
    id: "fix",
    label: "Fix",
    hint: "Solve a problem step by step",
    icon: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.1L3.6 17.1a1.8 1.8 0 0 0 2.6 2.6l5.7-5.7a4 4 0 0 0 5.1-5.4l-2.5 2.5-2.2-.5-.5-2.2 2.5-2.5Z"></path>',
  },
  {
    id: "decode",
    label: "Decode",
    hint: "Understand the jargon",
    icon: '<path d="M9 18h6M10 21h4"></path><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z"></path>',
  },
  {
    id: "compare",
    label: "Compare",
    hint: "Options side by side",
    icon: '<path d="M12 4v16M7 20h10"></path><path d="M5 7h14"></path><path d="m5 7-3 6a3 3 0 0 0 6 0L5 7Z"></path><path d="m19 7-3 6a3 3 0 0 0 6 0l-3-6Z"></path>',
  },
  {
    id: "choose",
    label: "Choose",
    hint: "Pick with confidence",
    icon: '<circle cx="12" cy="12" r="8.5"></circle><path d="m8.5 12.2 2.4 2.4 4.6-5"></path>',
  },
] as const;

type Hub = {
  id: string;
  title: string; // full name, shown in the dropdown
  short: string; // slim pill label
  home?: string; // hub landing page; omit while the hub has no page (falls back to search)
  color: string;
  icon: string;
  /** per-action page paths; any action left out falls back to a search for that topic */
  to?: Partial<Record<(typeof ACTIONS)[number]["id"], string>>;
  /** extra quick links shown under the actions */
  extras?: { label: string; path: string }[];
};

const HUBS: Hub[] = [
  {
    id: "phones",
    title: "Phones & Tablets",
    short: "Phones & Tablets",
    home: "phones/",
    color: "#d9540f",
    icon: '<rect x="7" y="2.5" width="10" height="19" rx="2.2"></rect><path d="M11 18.5h2"></path>',
    to: { fix: "phones/", compare: "phones/reviews/", choose: "phones/reviews/" },
    extras: [
      { label: "Digital Parenting", path: "#digital-parenting" },
      { label: "Reviews & Comparisons", path: "phones/reviews/" },
    ],
  },
  {
    id: "internet",
    title: "Home Internet & Wi-Fi",
    short: "Home Wi-Fi",
    color: "#2f7fb8",
    icon: '<path d="M2.5 9.5a14 14 0 0 1 19 0"></path><path d="M5.5 13a9.5 9.5 0 0 1 13 0"></path><path d="M8.7 16.4a5 5 0 0 1 6.6 0"></path><circle cx="12" cy="19.6" r="1"></circle>',
  },
  {
    id: "computers",
    title: "Computers & Laptops",
    short: "Computers",
    color: "#5a5fc4",
    icon: '<rect x="4" y="5" width="16" height="11" rx="1.6"></rect><path d="M2 19.5h20"></path>',
  },
  {
    id: "safety",
    title: "Digital Security",
    short: "Digital Security",
    color: "#2e8b57",
    icon: '<path d="M12 3 4.5 6v5.5c0 4.5 3.1 7.6 7.5 9.5 4.4-1.9 7.5-5 7.5-9.5V6L12 3Z"></path><path d="m9 12 2.2 2.2L15.2 10"></path>',
  },
];

const hubs = HUBS.map((h) => {
  const href = h.home ? url(h.home) : searchFor(h.title);
  return {
    ...h,
    href,
    active: !!h.home && currentPath.startsWith(url(h.home).replace(/\/$/, "")),
    actions: ACTIONS.map((a) => ({
      ...a,
      href: h.to?.[a.id] ? url(h.to[a.id]!) : searchFor(`${h.short} ${a.label.toLowerCase()}`),
    })),
    extras: (h.extras ?? []).map((e) => ({ ...e, href: e.path.startsWith("#") ? `${homeURL}${e.path}` : url(e.path) })),
  };
});
---

<header class="hubbar" data-hubbar>
  <div class="hb-row">
    <!-- Mobile: menu + wordmark (the sidebar is hidden below 900px) -->
    <div class="hb-mobile">
      <button
        type="button"
        class="hb-icon"
        data-hb-toggle
        aria-expanded="false"
        aria-controls="hb-menu"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
      <a class="hb-brand" href={homeURL}>ONOCRA<span aria-hidden="true" style="color:var(--onocra-orange)">.</span></a>
    </div>

    <!-- Hub pills -->
    <nav class="hb-hubs" aria-label="Technology hubs">
      {
        hubs.map((h) => (
          <div class="hb-hub" style={`--hub:${h.color}`}>
            <button
              type="button"
              class:list={["hb-pill", { "is-active": h.active }]}
              data-hb-toggle
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls={`hb-${h.id}`}
              aria-label={`${h.title}: Fix, Decode, Compare, Choose`}
            >
              <span class="hb-ico">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={h.icon} />
              </span>
              <span class="hb-name">{h.short}</span>
              <svg class="hb-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            </button>

            <div class="hb-panel hb-drop" id={`hb-${h.id}`} hidden>
              <p class="hb-drop-title">{h.title}</p>
              <ul class="hb-actions">
                {h.actions.map((a) => (
                  <li>
                    <a href={a.href} class={`hb-act hb-act-${a.id}`}>
                      <span class="hb-act-ico">
                        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={a.icon} />
                      </span>
                      <span class="hb-act-txt">
                        <strong>{a.label}</strong>
                        <span>{a.hint}</span>
                      </span>
                      <svg class="hb-go" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
                    </a>
                  </li>
                ))}
              </ul>
              {h.extras.length > 0 && (
                <div class="hb-extras">
                  <span>Also in {h.short}</span>
                  {h.extras.map((e) => (
                    <a href={e.href}>{e.label}</a>
                  ))}
                </div>
              )}
              <a class="hb-all" href={h.href}>Open the {h.short} hub →</a>
            </div>
          </div>
        ))
      }
    </nav>

    <!-- Always-reachable tools -->
    <div class="hb-tools">
      <a class="hb-latest" href={`${homeURL}#updates`} aria-label="Latest from ONOCRA">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v18H5z"></path><path d="M8 7h8M8 11h8M8 15h5"></path></svg>
        <span>Latest from ONOCRA</span>
      </a>

      <form class="hb-search" action={searchURL} method="get" role="search">
        <label class="hb-sr" for="hb-q">Search ONOCRA</label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2"></path></svg>
        <input id="hb-q" name="q" type="search" placeholder="Search…" autocomplete="off" />
      </form>

      <button id="theme-btn" type="button" class="hb-icon" data-hb-theme aria-label="Switch between light and dark theme">
        <svg class="hb-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path></svg>
        <svg class="hb-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu: same links as the sidebar -->
  <nav class="hb-panel hb-menu" id="hb-menu" aria-label="ONOCRA navigation" hidden>
    {
      SITE_NAV.map((item) => (
        <a href={`${homeURL}${item.hash}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
          <span>{item.label}</span>
        </a>
      ))
    }
  </nav>
</header>

<style is:global>
  .hubbar {
    --hb-bg: rgba(255, 250, 241, 0.9);
    --hb-surface: var(--on-surface);
    --hb-border: var(--on-line);
    --hb-text: var(--on-ink);
    --hb-muted: var(--on-muted);
    --hb-brand: var(--on-forest);
    --hb-accent: var(--on-accent-text);
    --hb-hover: var(--on-surface-2);
    position: sticky;
    top: 0;
    z-index: 45;
    background: var(--hb-bg);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--hb-border);
    box-shadow: 0 10px 24px -20px rgba(20, 35, 43, 0.45);
    color: var(--hb-text);
    font-family: var(--on-sans);
  }
  html[data-theme="dark"] .hubbar {
    --hb-bg: rgba(24, 31, 40, 0.88);
  }
  .hubbar *,
  .hubbar *::before,
  .hubbar *::after {
    box-sizing: border-box;
  }
  .hubbar svg {
    width: 18px;
    height: 18px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hubbar a {
    color: inherit;
    text-decoration: none;
  }
  .hubbar button {
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .hubbar :focus-visible {
    outline: 3px solid var(--on-ring);
    outline-offset: 2px;
  }
  .hb-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hb-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    padding: 9px 20px;
    min-height: 58px;
  }

  /* ---------- hub pills ---------- */
  .hb-hubs {
    display: flex;
    gap: 6px;
    min-width: 0;
  }
  .hb-hub {
    position: relative;
  }
  .hb-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 12px 0 6px;
    border-radius: 999px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: -0.005em;
    white-space: nowrap;
    box-shadow: var(--on-shadow-sm);
    transition: background-color 0.15s, border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .hb-pill:hover {
    border-color: color-mix(in srgb, var(--hub) 55%, var(--hb-border));
    transform: translateY(-1px);
    box-shadow: 0 6px 14px -8px color-mix(in srgb, var(--hub) 60%, transparent);
  }
  .hb-pill[aria-expanded="true"] {
    background: color-mix(in srgb, var(--hub) 10%, var(--hb-surface));
    border-color: var(--hub);
    transform: none;
  }
  .hb-pill.is-active {
    border-color: var(--hub);
    box-shadow: inset 0 0 0 1px var(--hub);
  }
  .hb-ico {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--hub);
    background: color-mix(in srgb, var(--hub) 14%, transparent);
  }
  .hb-ico svg {
    width: 16px;
    height: 16px;
  }
  .hb-chev {
    width: 14px !important;
    height: 14px !important;
    color: var(--hb-muted);
    transition: transform 0.18s;
  }
  .hb-pill[aria-expanded="true"] .hb-chev {
    transform: rotate(180deg);
  }

  /* ---------- dropdowns ---------- */
  .hb-panel[hidden] {
    display: none;
  }
  @keyframes hb-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hb-drop {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    width: 300px;
    padding: 14px 12px 12px;
    background: var(--hb-surface);
    border: 1px solid var(--hb-border);
    border-top: 3px solid var(--hub);
    border-radius: 16px;
    box-shadow: var(--on-shadow-pop);
    animation: hb-in 0.16s ease-out;
  }
  .hb-drop-title {
    margin: 0 6px 10px;
    font-family: var(--on-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .hb-actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .hb-act {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 12px;
    padding: 8px 8px;
    border-radius: 12px;
    transition: background-color 0.12s;
  }
  .hb-act:hover {
    background: var(--hb-hover);
  }
  .hb-act-ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    color: var(--hub);
    background: color-mix(in srgb, var(--hub) 12%, transparent);
  }
  .hb-act-txt {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .hb-act-txt strong {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
  }
  .hb-act-txt span {
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--hb-muted);
  }
  .hb-go {
    width: 14px !important;
    height: 14px !important;
    color: var(--hb-muted);
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.12s, transform 0.12s;
  }
  .hb-act:hover .hb-go,
  .hb-act:focus-visible .hb-go {
    opacity: 1;
    transform: none;
  }
  .hb-extras {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin: 8px 6px 0;
    padding-top: 10px;
    border-top: 1px solid var(--hb-border);
  }
  .hb-extras span {
    flex: 1 1 100%;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hb-muted);
  }
  .hb-extras a {
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    font-size: 12px;
    font-weight: 600;
  }
  .hb-extras a:hover {
    background: var(--hb-hover);
    border-color: var(--hb-brand);
  }
  .hb-all {
    display: block;
    margin: 8px 6px 0;
    padding-top: 11px;
    border-top: 1px solid var(--hb-border);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--hb-brand);
  }
  .hb-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- tools ---------- */
  .hb-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hb-latest {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: var(--on-shadow-sm);
    transition: background-color 0.15s;
  }
  .hb-latest:hover {
    background: var(--hb-hover);
  }
  .hb-search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .hb-search svg {
    position: absolute;
    left: 13px;
    color: var(--hb-muted);
    pointer-events: none;
  }
  .hb-search input {
    width: 200px;
    height: 40px;
    padding: 0 14px 0 38px;
    border-radius: 999px;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    color: var(--hb-text);
    font: inherit;
    font-size: 13.5px;
    box-shadow: var(--on-shadow-sm);
    transition: width 0.2s, border-color 0.15s;
  }
  .hb-search input:focus {
    width: 260px;
    border-color: var(--hb-brand);
    outline: 3px solid var(--on-ring);
    outline-offset: 0;
  }
  .hb-search input::placeholder {
    color: var(--hb-muted);
  }
  .hb-icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--hb-border);
    background: var(--hb-surface);
    box-shadow: var(--on-shadow-sm);
    transition: background-color 0.15s;
  }
  .hb-icon:hover {
    background: var(--hb-hover);
  }
  .hb-moon {
    display: none;
  }
  html[data-theme="dark"] .hb-sun {
    display: none;
  }
  html[data-theme="dark"] .hb-moon {
    display: block;
  }

  /* ---------- mobile bits ---------- */
  .hb-mobile {
    display: none;
    align-items: center;
    gap: 10px;
  }
  .hb-brand {
    font-family: var(--on-display);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--hb-brand);
  }
  .hubbar .hb-panel[hidden] { display: none !important; }
  .hb-menu {
    display: grid;
    gap: 2px;
    padding: 8px;
    background: var(--hb-surface);
    border-top: 1px solid var(--hb-border);
  }
  .hb-menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 14.5px;
    font-weight: 600;
  }
  .hb-menu a:hover {
    background: var(--hb-hover);
  }

  /* ---------- breakpoints ---------- */
  @media (max-width: 1180px) {
    .hb-latest span {
      display: none;
    }
    .hb-latest {
      width: 40px;
      padding: 0;
      justify-content: center;
    }
    .hb-search input:focus {
      width: 200px;
    }
  }
  @media (max-width: 899px) {
    .hb-row {
      padding: 8px 14px;
    }
    .hb-mobile {
      display: flex;
    }
    .hb-latest {
      display: none;
    }
    .hb-search input,
    .hb-search input:focus {
      width: 140px;
    }
    .hb-hubs {
      order: 3;
      flex: 1 1 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .hb-hub {
      position: static;
    }
    .hb-pill {
      width: 100%;
    }
    .hb-name {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hb-chev {
      margin-left: auto;
    }
    .hb-drop {
      left: 8px;
      right: 8px;
      width: auto;
      top: 100%;
      margin-top: 4px;
    }
  }
  @media (min-width: 900px) {
    .hb-menu {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hubbar *,
    .hb-drop {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  // One delegated set of listeners for the whole site. The guard stops double-binding,
  // and delegation keeps everything working after ClientRouter page swaps.
  const w = window as unknown as { __onocraHubBar?: boolean; __theme?: { value: string } };
  if (!w.__onocraHubBar) {
    w.__onocraHubBar = true;

    const closeAll = (except?: Element | null) => {
      document.querySelectorAll<HTMLElement>('[data-hb-toggle][aria-expanded="true"]').forEach((btn) => {
        if (btn === except) return;
        btn.setAttribute("aria-expanded", "false");
        document.getElementById(btn.getAttribute("aria-controls") || "")?.setAttribute("hidden", "");
      });
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      const toggle = target.closest<HTMLElement>("[data-hb-toggle]");
      if (toggle) {
        const wasOpen = toggle.getAttribute("aria-expanded") === "true";
        closeAll();
        if (!wasOpen) {
          toggle.setAttribute("aria-expanded", "true");
          document.getElementById(toggle.getAttribute("aria-controls") || "")?.removeAttribute("hidden");
        }
        return;
      }

      if (target.closest("[data-hb-theme]")) {
        // The existing src/scripts/theme.ts binds to #theme-btn and owns this action.
        return;
      }

      // clicking a link inside a panel, or anywhere outside one, closes the open panel
      if (target.closest(".hb-panel a") || !target.closest(".hb-panel")) closeAll();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = document.querySelector<HTMLElement>('[data-hb-toggle][aria-expanded="true"]');
      closeAll();
      open?.focus();
    });

    document.addEventListener("astro:before-swap", () => closeAll());
  }
</script>
