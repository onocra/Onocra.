---

---

<header class="computers-header">
  <div class="computers-header-inner">

    <!-- ========================================
         BREADCRUMB
    ========================================= -->

    <nav
      class="computers-breadcrumb"
      aria-label="Breadcrumb"
    >
      <a href="/">Home</a>

      <span
        class="breadcrumb-arrow"
        aria-hidden="true"
      >
        ›
      </span>

      <span class="breadcrumb-current">
        Computers &amp; Laptops
      </span>
    </nav>


    <!-- ========================================
         HEADER ACTIONS
    ========================================= -->

    <div class="computers-header-actions">

      <!-- SEARCH -->

      <a
        class="header-action"
        href="/search/"
        aria-label="Search ONOCRA"
        title="Search"
      >
        <span
          class="search-icon"
          aria-hidden="true"
        ></span>

        <span class="action-label">
          Search
        </span>
      </a>


      <!-- THEME -->

      <button
        class="header-action theme-action"
        id="computers-theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        title="Change appearance"
      >
        <span
          class="theme-icon"
          id="computers-theme-icon"
          aria-hidden="true"
        >
          ☼
        </span>

        <span class="action-label">
          Theme
        </span>
      </button>


      <!-- MENU -->

      <div class="menu-wrap">

        <button
          class="header-action menu-action"
          id="computers-menu-button"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="computers-menu"
          title="Menu"
        >
          <span
            class="menu-icon"
            aria-hidden="true"
          >
            <i></i>
            <i></i>
            <i></i>
          </span>

          <span class="action-label">
            Menu
          </span>
        </button>


        <!-- ====================================
             DROPDOWN MENU
        ===================================== -->

        <div
          class="header-menu"
          id="computers-menu"
          hidden
        >

          <a href="/">
            Home
          </a>

          <a href="/phones/">
            Phones, Tablets &amp; Wearables
          </a>

          <a href="/internet/">
            Home Internet &amp; Wi-Fi
          </a>

          <a
            href="/computers/"
            class="current-menu-item"
            aria-current="page"
          >
            Computers &amp; Laptops
          </a>

          <a href="/search/?q=Safety%20Security">
            Safety &amp; Security
          </a>

          <a href="/search/?q=Smart%20Home">
            Smart Home
          </a>

          <a href="/search/?q=Apps%20Online%20Services">
            Apps &amp; Online Services
          </a>

          <div class="menu-divider"></div>

          <a href="/search/?q=Digital%20Safety">
            Digital Safety
          </a>

          <a href="/search/?q=Digital%20Parenting">
            Digital Parenting
          </a>

          <a href="/search/?q=Reviews">
            Reviews
          </a>

          <a href="/search/?q=Guides%20Resources">
            Guides &amp; Resources
          </a>

        </div>

      </div>

    </div>

  </div>
</header>


<script>
  const themeButton =
    document.querySelector("#computers-theme-toggle");

  const themeIcon =
    document.querySelector("#computers-theme-icon");

  const menuButton =
    document.querySelector("#computers-menu-button");

  const menu =
    document.querySelector("#computers-menu");


  /* ==========================================
     THEME
  =========================================== */

  const setTheme = (
    theme: "light" | "dark"
  ) => {
    const root =
      document.documentElement;

    root.setAttribute(
      "data-theme",
      theme
    );

    root.classList.toggle(
      "dark",
      theme === "dark"
    );

    localStorage.setItem(
      "theme",
      theme
    );

    if (themeIcon instanceof HTMLElement) {
      themeIcon.textContent =
        theme === "dark"
          ? "☾"
          : "☼";
    }

    if (themeButton instanceof HTMLButtonElement) {
      themeButton.setAttribute(
        "aria-label",
        theme === "dark"
          ? "Switch to light theme"
          : "Switch to dark theme"
      );
    }
  };


  const savedTheme =
    localStorage.getItem("theme");

  const initialTheme =
    savedTheme === "dark"
      ? "dark"
      : "light";

  setTheme(initialTheme);


  if (
    themeButton instanceof
      HTMLButtonElement
  ) {
    themeButton.addEventListener(
      "click",
      () => {
        const currentTheme =
          document.documentElement
            .getAttribute("data-theme");

        setTheme(
          currentTheme === "dark"
            ? "light"
            : "dark"
        );
      }
    );
  }


  /* ==========================================
     MENU
  =========================================== */

  const closeMenu = () => {
    if (!(menu instanceof HTMLElement)) {
      return;
    }

    menu.hidden = true;

    if (
      menuButton instanceof
        HTMLButtonElement
    ) {
      menuButton.setAttribute(
        "aria-expanded",
        "false"
      );
    }
  };


  const openMenu = () => {
    if (!(menu instanceof HTMLElement)) {
      return;
    }

    menu.hidden = false;

    if (
      menuButton instanceof
        HTMLButtonElement
    ) {
      menuButton.setAttribute(
        "aria-expanded",
        "true"
      );
    }
  };


  if (
    menuButton instanceof
      HTMLButtonElement &&
    menu instanceof HTMLElement
  ) {
    menuButton.addEventListener(
      "click",
      event => {
        event.stopPropagation();

        const isOpen =
          menuButton.getAttribute(
            "aria-expanded"
          ) === "true";

        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      }
    );


    menu.addEventListener(
      "click",
      event => {
        event.stopPropagation();
      }
    );


    document.addEventListener(
      "click",
      () => {
        closeMenu();
      }
    );


    document.addEventListener(
      "keydown",
      event => {
        if (event.key === "Escape") {
          closeMenu();
        }
      }
    );
  }
</script>


<style>

  /* ==========================================
     HEADER
  =========================================== */

  .computers-header {
    position: relative;
    z-index: 50;

    width: 100%;

    border-bottom:
      1px solid
      rgba(7, 61, 50, 0.12);

    background:
      rgba(255, 249, 239, 0.97);
  }


  .computers-header-inner {
    width:
      min(100% - 32px, 1240px);

    min-height: 62px;

    margin:
      0 auto;

    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 24px;
  }


  /* ==========================================
     BREADCRUMB
  =========================================== */

  .computers-breadcrumb {
    min-width: 0;

    display: flex;

    align-items: center;

    gap: 9px;

    font-size: 13px;

    line-height: 1.2;
  }


  .computers-breadcrumb a {
    color: #14624d;

    font-weight: 800;

    text-decoration: none;
  }


  .computers-breadcrumb a:hover {
    text-decoration: underline;

    text-underline-offset: 3px;
  }


  .breadcrumb-arrow {
    color: #8b9692;

    font-size: 20px;

    line-height: 1;
  }


  .breadcrumb-current {
    overflow: hidden;

    color: #5e6c70;

    font-weight: 700;

    text-overflow: ellipsis;

    white-space: nowrap;
  }


  /* ==========================================
     ACTIONS
  =========================================== */

  .computers-header-actions {
    position: relative;

    flex: 0 0 auto;

    display: flex;

    align-items: center;

    gap: 5px;
  }


  .header-action {
    min-height: 38px;

    padding:
      0 10px;

    border: 0;

    border-radius: 10px;

    background: transparent;

    color: #073d32;

    font: inherit;

    font-size: 12px;

    font-weight: 700;

    text-decoration: none;

    cursor: pointer;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    transition:
      background 0.16s ease,
      color 0.16s ease;
  }


  .header-action:hover {
    background: #e6efe5;
  }


  /* ==========================================
     SEARCH ICON
  =========================================== */

  .search-icon {
    position: relative;

    width: 17px;

    height: 17px;

    display: block;

    border:
      2px solid
      currentColor;

    border-radius: 50%;
  }


  .search-icon::after {
    content: "";

    position: absolute;

    width: 7px;

    height: 2px;

    right: -5px;

    bottom: -2px;

    border-radius: 999px;

    background: currentColor;

    transform:
      rotate(45deg);

    transform-origin: center;
  }


  /* ==========================================
     THEME ICON
  =========================================== */

  .theme-action {
    background: #edf3e8;
  }


  .theme-icon {
    width: 20px;

    display: grid;

    place-items: center;

    color: #f56622;

    font-size: 22px;

    line-height: 1;
  }


  /* ==========================================
     MENU ICON
  =========================================== */

  .menu-wrap {
    position: relative;
  }


  .menu-icon {
    width: 20px;

    height: 16px;

    display: flex;

    flex-direction: column;

    justify-content:
      space-between;
  }


  .menu-icon i {
    display: block;

    width: 100%;

    height: 2px;

    border-radius: 999px;

    background: currentColor;
  }


  /* ==========================================
     DROPDOWN
  =========================================== */

  .header-menu {
    position: absolute;

    top: calc(100% + 10px);

    right: 0;

    width: 260px;

    padding: 8px;

    border:
      1px solid
      rgba(7, 61, 50, 0.14);

    border-radius: 16px;

    background: #fffaf1;

    box-shadow:
      0 18px 45px
      rgba(23, 51, 74, 0.18);
  }


  .header-menu[hidden] {
    display: none;
  }


  .header-menu a {
    min-height: 42px;

    padding:
      9px 12px;

    border-radius: 10px;

    display: flex;

    align-items: center;

    color: #17334a;

    font-size: 12px;

    font-weight: 700;

    line-height: 1.3;

    text-decoration: none;
  }


  .header-menu a:hover {
    background: #e6efe5;
  }


  .header-menu
  .current-menu-item {
    background: #dcefe5;

    color: #073d32;
  }


  .menu-divider {
    height: 1px;

    margin:
      6px 5px;

    background:
      rgba(7, 61, 50, 0.12);
  }


  /* ==========================================
     DARK THEME
     BINANCE-STYLE CHARCOAL / BLACK
  =========================================== */

  :global(
    html[data-theme="dark"]
  )
  .computers-header {
    border-bottom-color:
      rgba(255, 255, 255, 0.09);

    background:
      #1e2631;
  }


  :global(
    html[data-theme="dark"]
  )
  .computers-breadcrumb a {
    color: #62d2ad;
  }


  :global(
    html[data-theme="dark"]
  )
  .breadcrumb-arrow {
    color: #8d99a6;
  }


  :global(
    html[data-theme="dark"]
  )
  .breadcrumb-current {
    color: #d5dbe1;
  }


  :global(
    html[data-theme="dark"]
  )
  .header-action {
    color: #f3f5f7;
  }


  :global(
    html[data-theme="dark"]
  )
  .header-action:hover {
    background:
      rgba(255, 255, 255, 0.07);
  }


  :global(
    html[data-theme="dark"]
  )
  .theme-action {
    background: #2a3441;
  }


  :global(
    html[data-theme="dark"]
  )
  .theme-icon {
    color: #f2c94c;
  }


  :global(
    html[data-theme="dark"]
  )
  .header-menu {
    border-color:
      rgba(255, 255, 255, 0.1);

    background: #202833;

    box-shadow:
      0 20px 48px
      rgba(0, 0, 0, 0.35);
  }


  :global(
    html[data-theme="dark"]
  )
  .header-menu a {
    color: #e9edf1;
  }


  :global(
    html[data-theme="dark"]
  )
  .header-menu a:hover {
    background:
      rgba(255, 255, 255, 0.07);
  }


  :global(
    html[data-theme="dark"]
  )
  .header-menu
  .current-menu-item {
    background:
      rgba(55, 190, 145, 0.15);

    color: #7bd7b8;
  }


  :global(
    html[data-theme="dark"]
  )
  .menu-divider {
    background:
      rgba(255, 255, 255, 0.1);
  }


  /* ==========================================
     MOBILE
  =========================================== */

  @media (max-width: 720px) {

    .computers-header-inner {
      width:
        min(100% - 22px, 1240px);

      min-height: 56px;

      gap: 10px;
    }


    .computers-breadcrumb {
      min-width: 0;

      gap: 6px;

      font-size: 12px;
    }


    .breadcrumb-arrow {
      font-size: 17px;
    }


    .breadcrumb-current {
      max-width: 155px;
    }


    .computers-header-actions {
      gap: 1px;
    }


    .header-action {
      width: 37px;

      min-height: 37px;

      padding: 0;

      border-radius: 9px;
    }


    .action-label {
      display: none;
    }


    .header-menu {
      width:
        min(280px, calc(100vw - 22px));

      right: 0;
    }

  }


  @media (max-width: 430px) {

    .breadcrumb-current {
      max-width: 120px;
    }


    .computers-breadcrumb {
      font-size: 11px;
    }


    .computers-header-actions {
      flex-shrink: 0;
    }


    .header-action {
      width: 34px;

      min-height: 34px;
    }

  }

</style>
