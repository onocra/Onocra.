---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const socialImageURL = new URL(
  ogImage,
  Astro.site ?? Astro.url
);

const locale =
  Astro.currentLocale ?? config.site.lang;

const rssHref = getRelativeLocaleUrl(
  locale,
  "rss.xml"
);

const homeURL = getRelativeLocaleUrl(
  locale,
  ""
);

const searchURL = getRelativeLocaleUrl(
  locale,
  "search"
);

const currentPath = Astro.url.pathname;

const isHome =
  currentPath === "/" ||
  currentPath === homeURL;

const isPhones =
  currentPath.startsWith("/phones");

const isInternet =
  currentPath.startsWith("/internet");
---

<!doctype html>

<html
  dir={site.dir ?? "ltr"}
  lang={locale}
  class="overflow-y-scroll scroll-smooth"
  data-theme="light"
>
  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href={getAssetPath("favicon.svg")}
    />

    <link
      rel="icon"
      href={getAssetPath("favicon.ico")}
    />

    <link
      rel="canonical"
      href={canonicalURL}
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <Font
      cssVariable="--font-manrope"
      preload={[
        {
          subset: "latin",
          weight: 400,
          style: "normal",
        },
        {
          subset: "latin",
          weight: 700,
          style: "normal",
        },
      ]}
    />

    <!-- ==========================================
         PRIMARY META
    =========================================== -->

    <title>{title}</title>

    <meta
      name="title"
      content={title}
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="author"
      content={site.author}
    />

    <link
      rel="sitemap"
      href={getAssetPath("sitemap-index.xml")}
    />

    <!-- ==========================================
         OPEN GRAPH
    =========================================== -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content={site.title}
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:image"
      content={socialImageURL}
    />

    <!-- ==========================================
         TWITTER / X
    =========================================== -->

    <meta
      property="twitter:card"
      content="summary_large_image"
    />

    <meta
      property="twitter:url"
      content={canonicalURL}
    />

    <meta
      property="twitter:title"
      content={title}
    />

    <meta
      property="twitter:description"
      content={description}
    />

    <meta
      property="twitter:image"
      content={socialImageURL}
    />

    <!-- ==========================================
         RSS
    =========================================== -->

    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <meta
      name="theme-color"
      content="#fff9ef"
    />

    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!-- ==========================================
         KEEP ONOCRA LIGHT INITIALLY
    =========================================== -->

    <script is:inline>
      (function () {
        const root =
          document.documentElement;

        root.setAttribute(
          "data-theme",
          "light"
        );

        root.classList.remove("dark");

        localStorage.setItem(
          "theme",
          "light"
        );

        window.__theme = {
          value: "light",
        };
      })();
    </script>

    <ClientRouter />

    <!-- ==========================================
         ONOCRA DESKTOP SIDEBAR
    =========================================== -->

    <style is:global>

      /* ==========================================
         BASE / MOBILE
      =========================================== */

      .onocra-site-shell {
        width: 100%;
        min-height: 100svh;
      }

      .onocra-sidebar {
        display: none;
      }

      .onocra-site-content {
        width: 100%;
        min-width: 0;
      }


      /* ==========================================
         DESKTOP SIDEBAR
      =========================================== */

      @media (min-width: 900px) {

        .onocra-site-shell {
          display: grid;

          grid-template-columns:
            136px minmax(0, 1fr);

          align-items: stretch;

          min-height: 100svh;
        }


        /* ========================================
           SIDEBAR RAIL
        ======================================== */

        .onocra-sidebar {
          display: block;

          min-height: 100%;

          background:
            linear-gradient(
              180deg,
              #eef7f0 0%,
              #f4f8ef 100%
            );

          border-right:
            1px solid
            rgba(7, 61, 50, 0.12);
        }


        .onocra-sidebar-inner {
          width: 100%;

          min-height: 100svh;

          display: flex;

          flex-direction: column;

          align-items: center;

          padding:
            14px 8px 28px;
        }


        /* ========================================
           BRANDING
        ======================================== */

        .onocra-brand-zone {
          width: 100%;

          display: flex;

          flex-direction: column;

          align-items: center;

          flex: 0 0 auto;
        }


        .onocra-logo-link {
          width: 100%;

          height: 100px;

          display: flex;

          align-items: center;

          justify-content: center;

          text-decoration: none;
        }


        .onocra-logo {
          display: block;

          width: 92px;

          height: 92px;

          object-fit: contain;
        }


        .onocra-vertical-wordmark {
          width: 100%;

          display: flex;

          flex-direction: column;

          align-items: center;

          justify-content: center;

          gap: 8px;

          padding:
            5px 0 13px;

          font-family:
            Georgia,
            "Times New Roman",
            serif;

          font-size: 34px;

          line-height: 1;

          font-weight: 700;

          color: #073d32;

          text-decoration: none;
        }


        .onocra-vertical-wordmark span {
          display: block;
        }


        .onocra-dot {
          width: 11px;

          height: 11px;

          display: block;

          flex-shrink: 0;

          margin-top: 1px;

          border-radius: 999px;

          background: #f56622;

          font-size: 0;
        }


        /* ========================================
           DIVIDER
        ======================================== */

        .onocra-brand-divider {
          width: calc(100% - 20px);

          height: 1px;

          margin:
            0 auto 10px;

          background:
            rgba(7, 61, 50, 0.14);
        }


        /* ========================================
           NAVIGATION
        ======================================== */

        .onocra-sidebar-nav {
          width: 100%;

          display: flex;

          flex-direction: column;

          gap: 3px;
        }


        .onocra-sidebar-nav a {
          width: 100%;

          min-height: 52px;

          padding:
            7px 7px;

          border-radius: 10px;

          display: grid;

          grid-template-columns:
            30px minmax(0, 1fr);

          align-items: center;

          gap: 6px;

          color: #17334a;

          text-decoration: none;

          transition:
            background-color 160ms ease,
            color 160ms ease,
            transform 160ms ease;
        }


        .onocra-sidebar-nav a:hover {
          background:
            rgba(255, 255, 255, 0.72);

          transform:
            translateX(1px);
        }


        .onocra-sidebar-nav a.active {
          background: #d9efe5;

          box-shadow:
            inset 3px 0 0 #14624d;
        }


        .onocra-sidebar-nav svg {
          width: 22px;

          height: 22px;

          justify-self: center;

          fill: none;

          stroke: currentColor;

          stroke-width: 1.8;

          stroke-linecap: round;

          stroke-linejoin: round;
        }


        .onocra-sidebar-nav-label {
          display: block;

          color: inherit;

          font-family:
            var(--font-manrope),
            Arial,
            sans-serif;

          font-size: 9.5px;

          line-height: 1.22;

          font-weight: 700;

          letter-spacing: 0;

          text-align: left;

          text-transform: none;
        }


        .onocra-sidebar-nav a.active
        .onocra-sidebar-nav-label {
          color: #073d32;
          font-weight: 800;
        }


        .onocra-sidebar-nav a.active svg {
          stroke: #073d32;
        }


        /* ========================================
           DARK THEME SIDEBAR
        ======================================== */

        html[data-theme="dark"]
        .onocra-sidebar {
          background:
            linear-gradient(
              180deg,
              #202833,
              #1b232d
            );

          border-right-color:
            rgba(255, 255, 255, 0.09);
        }


        html[data-theme="dark"]
        .onocra-vertical-wordmark {
          color: #f7f1e7;
        }


        html[data-theme="dark"]
        .onocra-brand-divider {
          background:
            rgba(255, 255, 255, 0.14);
        }


        html[data-theme="dark"]
        .onocra-sidebar-nav a {
          color: #e6ebef;
        }


        html[data-theme="dark"]
        .onocra-sidebar-nav a:hover {
          background:
            rgba(255, 255, 255, 0.07);
        }


        html[data-theme="dark"]
        .onocra-sidebar-nav a.active {
          background:
            rgba(55, 190, 145, 0.16);

          box-shadow:
            inset 3px 0 0 #37be91;
        }


        html[data-theme="dark"]
        .onocra-sidebar-nav a.active
        .onocra-sidebar-nav-label {
          color: #f5f7f8;
        }


        html[data-theme="dark"]
        .onocra-sidebar-nav a.active svg {
          stroke: #62d2ad;
        }

      }

    </style>

  </head>


  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground min-h-svh"
  >

    <div class="onocra-site-shell">


      <!-- ========================================
           DESKTOP SIDEBAR
      ========================================= -->

      <aside
        class="onocra-sidebar"
        aria-label="ONOCRA sidebar"
      >

        <div class="onocra-sidebar-inner">


          <!-- ====================================
               BRAND
          ===================================== -->

          <div class="onocra-brand-zone">

            <a
              href={homeURL}
              aria-label="ONOCRA home"
              class="onocra-logo-link"
            >

              <img
                src="/logo.png"
                alt="ONOCRA pelican and chicks"
                class="onocra-logo"
              />

            </a>


            <a
              href={homeURL}
              aria-label="ONOCRA home"
              class="onocra-vertical-wordmark"
            >

              <span>N</span>
              <span>O</span>
              <span>C</span>
              <span>R</span>
              <span>A</span>

              <span
                class="onocra-dot"
                aria-hidden="true"
              ></span>

            </a>

          </div>


          <div
            class="onocra-brand-divider"
            aria-hidden="true"
          ></div>


          <!-- ====================================
               NAVIGATION
          ===================================== -->

          <nav
            class="onocra-sidebar-nav"
            aria-label="ONOCRA navigation"
          >


            <!-- HOME -->

            <a
              href={homeURL}
              class:list={{ active: isHome }}
              aria-current={isHome ? "page" : undefined}
            >

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m3 11 9-8 9 8"></path>
                <path d="M5 10v10h14V10"></path>
                <path d="M9 20v-6h6v6"></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Home
              </span>

            </a>


            <!-- CONTACT -->

            <a
              href={`${homeURL}#contact`}
            >

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="3"
                  y="5"
                  width="18"
                  height="14"
                  rx="2"
                ></rect>

                <path d="m3 7 9 6 9-6"></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Contact
              </span>

            </a>


            <!-- PHONES -->

            <a
              href="/phones/"
              class:list={{ active: isPhones }}
              aria-current={isPhones ? "page" : undefined}
            >

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="7"
                  y="2"
                  width="10"
                  height="20"
                  rx="2"
                ></rect>

                <path d="M10 5h4"></path>
                <path d="M11 19h2"></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Phones, Tablets &amp; Wearables
              </span>

            </a>


            <!-- HOME INTERNET -->

            <a
              href="/internet/"
              class:list={{ active: isInternet }}
              aria-current={isInternet ? "page" : undefined}
            >

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12.5a10 10 0 0 1 14 0"></path>
                <path d="M8 15.5a6 6 0 0 1 8 0"></path>
                <path d="M11 18.5a2 2 0 0 1 2 0"></path>
                <circle cx="12" cy="20" r=".5"></circle>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Home Internet &amp; Wi-Fi
              </span>

            </a>


            <!-- COMPUTERS -->

            <a href="/search/?q=Computers%20Laptops">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="4"
                  y="4"
                  width="16"
                  height="11"
                  rx="1"
                ></rect>

                <path d="M2 19h20"></path>
                <path d="m6 15-2 4"></path>
                <path d="m18 15 2 4"></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Computers &amp; Laptops
              </span>

            </a>


            <!-- SAFETY & SECURITY -->

            <a href="/search/?q=Safety%20Security">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"
                ></path>

                <path d="m9 12 2 2 4-5"></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Safety &amp; Security
              </span>

            </a>


            <!-- SMART HOME -->

            <a href="/search/?q=Smart%20Home">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m3 11 9-8 9 8"></path>
                <path d="M5 10v10h14V10"></path>
                <path d="M9 20v-6h6v6"></path>
                <path d="M8 9h8"></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Smart Home
              </span>

            </a>


            <!-- APPS -->

            <a href="/search/?q=Apps%20Online%20Services">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="6" height="6" rx="1"></rect>
                <rect x="15" y="3" width="6" height="6" rx="1"></rect>
                <rect x="3" y="15" width="6" height="6" rx="1"></rect>
                <rect x="15" y="15" width="6" height="6" rx="1"></rect>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Apps &amp; Online Services
              </span>

            </a>


            <!-- DIGITAL SAFETY -->

            <a href="/search/?q=Digital%20Safety">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"
                ></path>

                <path d="M9 12h6"></path>
                <path d="M12 9v6"></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Digital Safety
              </span>

            </a>


            <!-- DIGITAL PARENTING -->

            <a href="/search/?q=Digital%20Parenting">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="8" cy="8" r="3"></circle>
                <circle cx="17" cy="9" r="2.5"></circle>

                <path
                  d="M2.5 20c.4-4 2.3-6 5.5-6s5.1 2 5.5 6"
                ></path>

                <path
                  d="M13 15c1-.9 2.3-1.4 4-1.4 2.7 0 4.3 1.8 4.5 5.4"
                ></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Digital Parenting
              </span>

            </a>


            <!-- REVIEWS -->

            <a href="/search/?q=Reviews">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"
                ></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Reviews
              </span>

            </a>


            <!-- GUIDES -->

            <a href="/search/?q=Guides%20Resources">

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22V5.5Z"
                ></path>

                <path
                  d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22V5.5Z"
                ></path>
              </svg>

              <span class="onocra-sidebar-nav-label">
                Guides
              </span>

            </a>


            <!-- MORE -->

            <a href={`${homeURL}#topics`}>

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle
                  cx="5"
                  cy="12"
                  r="1.2"
                  fill="currentColor"
                  stroke="none"
                ></circle>

                <circle
                  cx="12"
                  cy="12"
                  r="1.2"
                  fill="currentColor"
                  stroke="none"
                ></circle>

                <circle
                  cx="19"
                  cy="12"
                  r="1.2"
                  fill="currentColor"
                  stroke="none"
                ></circle>
              </svg>

              <span class="onocra-sidebar-nav-label">
                More
              </span>

            </a>

          </nav>

        </div>

      </aside>


      <!-- ========================================
           EXISTING WEBSITE CONTENT
      ========================================= -->

      <div class="onocra-site-content">

        <slot />

      </div>

    </div>


    <script>
      import "@/scripts/theme";
    </script>

  </body>

</html>
