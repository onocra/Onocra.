---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);

const locale = Astro.currentLocale ?? config.site.lang;

const rssHref = getRelativeLocaleUrl(
  locale,
  "rss.xml"
);

const homeURL = getRelativeLocaleUrl(
  locale,
  ""
);

const searchURL = getRelativeLocaleUrl(
  locale,
  "search"
);
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={locale}
  class="overflow-y-scroll scroll-smooth"
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href={getAssetPath("favicon.svg")}
    />

    <link
      rel="icon"
      href={getAssetPath("favicon.ico")}
    />

    <link
      rel="canonical"
      href={canonicalURL}
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <Font
      cssVariable="--font-manrope"
      preload={[
        {
          subset: "latin",
          weight: 400,
          style: "normal",
        },
        {
          subset: "latin",
          weight: 700,
          style: "normal",
        },
      ]}
    />

    <!-- Primary meta -->
    <title>{title}</title>

    <meta
      name="title"
      content={title}
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="author"
      content={site.author}
    />

    <link
      rel="sitemap"
      href={getAssetPath("sitemap-index.xml")}
    />

    <!-- Open Graph -->
    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content={site.title}
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:image"
      content={socialImageURL}
    />

    <!-- Twitter / X -->
    <meta
      property="twitter:card"
      content="summary_large_image"
    />

    <meta
      property="twitter:url"
      content={canonicalURL}
    />

    <meta
      property="twitter:title"
      content={title}
    />

    <meta
      property="twitter:description"
      content={description}
    />

    <meta
      property="twitter:image"
      content={socialImageURL}
    />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <meta
      name="theme-color"
      content="#fff9ef"
    />

    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!-- Keep ONOCRA light -->
    <script is:inline>
      (function () {
        const root = document.documentElement;

        root.setAttribute("data-theme", "light");
        root.classList.remove("dark");

        localStorage.setItem("theme", "light");

        window.__theme = {
          value: "light",
        };
      })();
    </script>

    <ClientRouter />

    <!-- =====================================================
         ONOCRA DESKTOP SIDEBAR SHELL
         Explicit CSS so it does not depend on Tailwind
         responsive utility generation.
    ====================================================== -->
    <style is:global>
      .onocra-site-shell {
        min-height: 100svh;
        width: 100%;
      }

      .onocra-sidebar {
        display: none;
      }

      .onocra-site-content {
        min-width: 0;
        width: 100%;
      }

      @media (min-width: 900px) {
        .onocra-site-shell {
          display: grid;
          grid-template-columns: 118px minmax(0, 1fr);
          align-items: stretch;
        }

        .onocra-sidebar {
          display: block;
          min-height: 100%;
          background: var(--onocra-sage);
          border-right: 1px solid var(--border);
        }

        .onocra-sidebar-inner {
          position: sticky;
          top: 0;
          height: 100svh;
        }
      }
    </style>
  </head>

  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground min-h-svh"
  >
    <!-- =====================================================
         ONOCRA SITE SHELL
    ====================================================== -->
    <div class="onocra-site-shell">

      <!-- ===================================================
           DESKTOP SIDEBAR
      ==================================================== -->
      <aside
        class="onocra-sidebar"
        aria-label="ONOCRA sidebar"
      >
        <div
          class="onocra-sidebar-inner flex flex-col items-center px-3 py-5"
        >
          <!-- PELICAN -->
          <a
            href={homeURL}
            aria-label="ONOCRA home"
            class="flex h-[78px] w-[78px] shrink-0 items-center justify-center"
          >
            <img
              src="/file_0000000083088208b5fec963887cd25a.png"
              alt="ONOCRA pelican"
              class="max-h-full max-w-full object-contain"
            />
          </a>

          <!-- VERTICAL ONOCRA WORDMARK -->
          <a
            href={homeURL}
            aria-label="ONOCRA home"
            class="mt-3 flex flex-col items-center font-serif text-[1.72rem] font-bold leading-[0.92] tracking-[0.08em] text-[var(--onocra-forest)]"
          >
            <span>O</span>
            <span>N</span>
            <span>O</span>
            <span>C</span>
            <span>R</span>
            <span>A</span>
            <span class="mt-1 text-[var(--onocra-orange)]">.</span>
          </a>

          <!-- DIVIDER -->
          <div
            class="my-5 h-px w-12 bg-[var(--onocra-forest)]/15"
            aria-hidden="true"
          ></div>

          <!-- NAVIGATION -->
          <nav
            class="flex w-full flex-col items-center gap-2"
            aria-label="ONOCRA quick navigation"
          >
            <!-- HOME -->
            <a
              href={homeURL}
              class="flex w-full flex-col items-center justify-center rounded-2xl px-2 py-3 text-[var(--onocra-forest)] transition hover:bg-white/65"
              aria-label="Home"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m3 11 9-8 9 8"></path>
                <path d="M5 10v10h14V10"></path>
                <path d="M9 20v-6h6v6"></path>
              </svg>

              <span
                class="mt-1.5 text-[0.68rem] font-bold tracking-[0.08em] uppercase"
              >
                Home
              </span>
            </a>

            <!-- SEARCH -->
            <a
              href={searchURL}
              class="flex w-full flex-col items-center justify-center rounded-2xl px-2 py-3 text-[var(--onocra-forest)] transition hover:bg-white/65"
              aria-label="Search ONOCRA"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>

              <span
                class="mt-1.5 text-[0.68rem] font-bold tracking-[0.08em] uppercase"
              >
                Search
              </span>
            </a>

            <!-- MENU -->
            <a
              href={`${homeURL}#topics`}
              class="flex w-full flex-col items-center justify-center rounded-2xl px-2 py-3 text-[var(--onocra-forest)] transition hover:bg-white/65"
              aria-label="ONOCRA menu"
            >
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 7h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 17h16"></path>
              </svg>

              <span
                class="mt-1.5 text-[0.68rem] font-bold tracking-[0.08em] uppercase"
              >
                Menu
              </span>
            </a>
          </nav>

          <!-- BOTTOM SIGNATURE -->
          <div class="mt-auto pb-1">
            <span
              class="block [writing-mode:vertical-rl] rotate-180 text-[0.58rem] font-bold tracking-[0.22em] text-[var(--onocra-forest)]/45 uppercase"
            >
              TechnoNavigation
            </span>
          </div>
        </div>
      </aside>

      <!-- ===================================================
           EXISTING WEBSITE
      ==================================================== -->
      <div class="onocra-site-content">
        <slot />
      </div>

    </div>

    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
