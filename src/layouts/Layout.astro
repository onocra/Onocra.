---

import { Font } from "astro:assets";

import { ClientRouter } from "astro:transitions";

import { getRelativeLocaleUrl } from "astro:i18n";

import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";

import { getAssetPath } from "@/utils/withBase";

import config from "@/config";

import "@/styles/global.css";

 

type Props = {

  title?: string;

  description?: string;

  ogImage?: string;

  canonicalURL?: string;

};

 

const { site } = config;

 

const {

  title = site.title,

  description = site.description,

  ogImage = resolveDefaultOgImagePath(config),

  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,

} = Astro.props;

 

const socialImageURL = new URL(

  ogImage,

  Astro.site ?? Astro.url

);

 

const locale =

  Astro.currentLocale ?? config.site.lang;

 

const rssHref = getRelativeLocaleUrl(

  locale,

  "rss.xml"

);

 

const homeURL = getRelativeLocaleUrl(

  locale,

  ""

);

 

const searchURL = getRelativeLocaleUrl(

  locale,

  "search"

);

 

const currentPath = Astro.url.pathname;

 

const isHome =

  currentPath === "/" ||

  currentPath === homeURL;

 

const isPhones =

  currentPath.startsWith("/phones");

 

const isInternet =

  currentPath.startsWith("/internet");

 

const isComputers =

  currentPath.startsWith("/computers");


const isSafety =
  currentPath.startsWith("/safety");

---

 

<!doctype html>

 

<html

  dir={site.dir ?? "ltr"}

  lang={locale}

  class="overflow-y-scroll scroll-smooth"

  data-theme="light"

>

  <head>

 

    <meta charset="UTF-8" />

 

    <meta

      name="viewport"

      content="width=device-width, initial-scale=1"

    />

 

    <link

      rel="icon"

      type="image/svg+xml"

      href={getAssetPath("favicon.svg")}

    />

 

    <link

      rel="icon"

      href={getAssetPath("favicon.ico")}

    />

 

    <link

      rel="canonical"

      href={canonicalURL}

    />

 

    <meta

      name="generator"

      content={Astro.generator}

    />

 

    <Font

      cssVariable="--font-manrope"

      preload={[

        {

          subset: "latin",

          weight: 400,

          style: "normal",

        },

        {

          subset: "latin",

          weight: 700,

          style: "normal",

        },

      ]}

    />

 

    <!-- ==========================================

         PRIMARY META

    =========================================== -->

 

    <title>{title}</title>

 

    <meta

      name="title"

      content={title}

    />

 

    <meta

      name="description"

      content={description}

    />

 

    <meta

      name="author"

      content={site.author}

    />

 

    <link

      rel="sitemap"

      href={getAssetPath("sitemap-index.xml")}

    />

 

    <!-- ==========================================

         OPEN GRAPH

    =========================================== -->

 

    <meta

      property="og:type"

      content="website"

    />

 

    <meta

      property="og:site_name"

      content={site.title}

    />

 

    <meta

      property="og:title"

      content={title}

    />

 

    <meta

      property="og:description"

      content={description}

    />

 

    <meta

      property="og:url"

      content={canonicalURL}

    />

 

    <meta

      property="og:image"

      content={socialImageURL}

    />

 

    <!-- ==========================================

         TWITTER / X

    =========================================== -->

 

    <meta

      property="twitter:card"

      content="summary_large_image"

    />

 

    <meta

      property="twitter:url"

      content={canonicalURL}

    />

 

    <meta

      property="twitter:title"

      content={title}

    />

 

    <meta

      property="twitter:description"

      content={description}

    />

 

    <meta

      property="twitter:image"

      content={socialImageURL}

    />

 

    <!-- ==========================================

         RSS

    =========================================== -->

 

    <link

      rel="alternate"

      type="application/rss+xml"

      title={site.title}

      href={new URL(rssHref, Astro.site)}

    />

 

    <meta

      name="theme-color"

      content="#fff9ef"

    />

 

    <slot name="head" />

 

    {

      site.googleVerification && (

        <meta

          name="google-site-verification"

          content={site.googleVerification}

        />

      )

    }

 

    <!-- ==========================================

         ONOCRA THEME — INITIALISE BEFORE PAINT

    =========================================== -->

 

    <script is:inline>

      (() => {

        const root = document.documentElement;

 

        let theme = "light";

 

        try {

          const saved = localStorage.getItem("theme");

 

          if (saved === "dark" || saved === "light") {

            theme = saved;

          } else if (

            window.matchMedia &&

            window.matchMedia("(prefers-color-scheme: dark)").matches

          ) {

            theme = "dark";

          }

        } catch (error) {

          theme = "light";

        }

 

        root.setAttribute("data-theme", theme);

        root.classList.toggle("dark", theme === "dark");

 

        window.__theme = {

          value: theme,

        };

      })();

    </script>

 

    <ClientRouter />

 

    <!-- ==========================================

         ONOCRA DESKTOP SIDEBAR

    =========================================== -->

 

    <style is:global>

 

      /* ==========================================

         BASE / MOBILE

      =========================================== */

 

      .onocra-site-shell {

        width: 100%;

        min-height: 100svh;

      }

 

            @media (min-width: 900px) {

        .onocra-sidebar {
                  display: block;
                  position: fixed;
                  inset: 0 auto 0 0;
                  z-index: 60;
                  width: 136px;
                  height: 100svh;
                  overflow: hidden;

                  /* LIGHT THEME — independent of the ivory page canvas */
                  background: linear-gradient(
                    180deg,
                    #245f4d 0%,
                    #1d5646 48%,
                    #174b3d 100%
                  );

                  border-right: 12px solid #0a352b;

                  box-shadow:
                    inset -2px 0 0 rgba(225, 239, 233, 0.22),
                    inset -8px 0 16px rgba(4, 38, 30, 0.18),
                    5px 0 0 rgba(99, 143, 126, 0.34),
                    10px 0 18px rgba(5, 42, 33, 0.30),
                    18px 0 34px rgba(5, 42, 33, 0.14);
                }

                .onocra-site-content {
                  grid-column: 2;
                  min-width: 0;
          padding-left: 64px;
        }

                .onocra-sidebar-inner {
                  width: 100%;
                  height: 100svh;
                  display: flex;
                  flex-direction: column;
                  align-items: center;
                  padding: 10px 8px 14px;
                }

                .onocra-brand-zone {
                  width: 100%;
                  display: flex;
                  flex-direction: column;
                  align-items: center;
                  flex: 0 0 auto;
                }

                .onocra-logo-link {
                  width: 100%;
                  height: 286px;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  text-decoration: none;
                }

                .onocra-logo {
                  display: block;
                  width: 126px;
                  height: 276px;
                  object-fit: contain;
                }

                .onocra-brand-divider {
                  width: calc(100% - 18px);
                  height: 2px;
                  margin: 0 auto 9px;
                  border-radius: 999px;
                  background: rgba(232, 243, 238, 0.58);
                  box-shadow: 0 1px 0 rgba(3, 33, 26, 0.72), 0 3px 8px rgba(3, 33, 26, 0.14);
                }

                .onocra-sidebar-nav {
                  width: 100%;
                  display: flex;
                  flex-direction: column;
                  gap: 2px;
                }

                .onocra-sidebar-nav a {
                  width: 100%;
                  min-height: 56px;
                  padding: 5px 7px;
                  border-radius: 10px;
                  display: grid;
                  grid-template-columns: 30px minmax(0, 1fr);
                  align-items: center;
                  gap: 6px;
                  color: #f5f8f6;
                  text-decoration: none;
                  transition: background-color 160ms ease, color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
                }

                .onocra-sidebar-nav a:hover {
                  background: rgba(255, 255, 255, 0.12);
                  box-shadow: inset 0 0 0 1px rgba(235, 246, 241, 0.14), 0 3px 8px rgba(2, 30, 23, 0.14);
                  transform: translateX(1px);
                }

                .onocra-sidebar-nav a.active {
                  background: rgba(194, 222, 210, 0.25);
                  box-shadow: inset 5px 0 0 #b9decf, inset 0 0 0 1px rgba(238, 248, 244, 0.16), 0 5px 12px rgba(2, 30, 23, 0.22);
                }

                .onocra-sidebar-nav svg {
                  width: 22px;
                  height: 22px;
                  justify-self: center;
                  fill: none;
                  stroke: currentColor;
                  stroke-width: 1.8;
                  stroke-linecap: round;
                  stroke-linejoin: round;
                }

                .onocra-sidebar-nav-label {
                  display: block;
                  color: inherit;
                  font-family: var(--font-manrope), Arial, sans-serif;
                  font-size: 13px;
                  line-height: 1.22;
                  font-weight: 700;
                  letter-spacing: 0;
                  text-align: left;
                  text-transform: none;
                }

                .onocra-sidebar-nav a.active .onocra-sidebar-nav-label {
                  color: #ffffff;
                  font-weight: 800;
                }

                .onocra-sidebar-nav a.active svg {
                  stroke: #ffffff;
                }

                /* DARK THEME — keep approved dark treatment */
                html[data-theme="dark"] .onocra-sidebar {
                  background: linear-gradient(180deg, #202833, #1b232d);
                  border-right: 12px solid #111820;
                  box-shadow:
                    inset -2px 0 0 rgba(255, 255, 255, 0.07),
                    5px 0 0 rgba(50, 64, 77, 0.52),
                    10px 0 18px rgba(0, 0, 0, 0.26);
                }

                html[data-theme="dark"] .onocra-brand-divider {
                  background: rgba(255, 255, 255, 0.14);
                  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.55);
                }

                html[data-theme="dark"] .onocra-sidebar-nav a {
                  color: #e6ebef;
                }

                html[data-theme="dark"] .onocra-sidebar-nav a:hover {
                  background: rgba(255, 255, 255, 0.07);
                }

                html[data-theme="dark"] .onocra-sidebar-nav a.active {
                  background: rgba(55, 190, 145, 0.16);
                  box-shadow: inset 3px 0 0 #37be91;
                }

                html[data-theme="dark"] .onocra-sidebar-nav a.active .onocra-sidebar-nav-label {
                  color: #f5f7f8;
                }

                html[data-theme="dark"] .onocra-sidebar-nav a.active svg {
                  stroke: #62d2ad;
                }


      }

    </style>

 

  </head>

 

 

  <body

    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground min-h-svh"

  >

 

    <div class="onocra-site-shell">

 

 

      <!-- ========================================

           DESKTOP SIDEBAR

      ========================================= -->

 

      <aside

        class="onocra-sidebar"

        aria-label="ONOCRA sidebar"

      >

 

        <div class="onocra-sidebar-inner">

 

 

          <!-- ====================================

               BRAND

          ===================================== -->

 

          <div class="onocra-brand-zone">

 

            <a

              href={homeURL}

              aria-label="ONOCRA home"

              class="onocra-logo-link"

            >

 

              <img

                src="/homepage/LOGO.png"

                alt="ONOCRA pelican and chicks"

                class="onocra-logo"

              />

 

            </a>

 

          </div>

 

 

          <div

            class="onocra-brand-divider"

            aria-hidden="true"

          ></div>

 

 

          <!-- ====================================

               NAVIGATION

          ===================================== -->

 

          <nav class="onocra-sidebar-nav" aria-label="ONOCRA navigation">
            <a href={homeURL} class:list={{ active: isHome }} aria-current={isHome ? "page" : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path></svg>
              <span class="onocra-sidebar-nav-label">Home</span>
            </a>
            <a href={`${homeURL}#digital-parenting`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="8" r="3"></circle><circle cx="17" cy="9" r="2.5"></circle><path d="M2.5 20c.4-4 2.3-6 5.5-6s5.1 2 5.5 6"></path><path d="M13 15c1-.9 2.3-1.4 4-1.4 2.7 0 4.3 1.8 4.5 5.4"></path></svg>
              <span class="onocra-sidebar-nav-label">Digital Parenting</span>
            </a>
            <a href={`${homeURL}#routes`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h11"></path><path d="m12 3 3 3-3 3"></path><path d="M20 18H9"></path><path d="m12 15-3 3 3 3"></path><path d="M6 6v12"></path></svg>
              <span class="onocra-sidebar-nav-label">ONOCRA Routes</span>
            </a>
            <a href={`${homeURL}#guides`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H11v17H7.5A3.5 3.5 0 0 0 4 22V5.5Z"></path><path d="M20 5.5A3.5 3.5 0 0 0 16.5 2H13v17h3.5A3.5 3.5 0 0 1 20 22V5.5Z"></path></svg>
              <span class="onocra-sidebar-nav-label">Guides</span>
            </a>
            <a href={`${homeURL}#reviews`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v18H5z"></path><path d="M8 7h8"></path><path d="M8 11h8"></path><path d="M8 15h5"></path></svg>
              <span class="onocra-sidebar-nav-label">Reviews</span>
            </a>
            <a href={`${homeURL}#contact`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
              <span class="onocra-sidebar-nav-label">Contact</span>
            </a>
            <a href={`${homeURL}#affiliates`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.1 1.1"></path>
                <path d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.1-1.1"></path>
              </svg>
              <span class="onocra-sidebar-nav-label">Affiliates</span>
            </a>
          </nav>

 

        </div>

 

      </aside>

 

 

      <!-- ========================================

           EXISTING WEBSITE CONTENT

      ========================================= -->

 

      <div class="onocra-site-content">

 

        <slot />

 

      </div>

 

    </div>

 

 

    <script>

      import "@/scripts/theme";

    </script>

 

  </body>

 

</html>
