---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import { SITE_NAV } from "@/data/siteNav";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  /** Flow pages (e.g. the phone comparison) set this so the sidebar compacts
   *  and makes room for the step panel passed in through <slot name="sidebar" />. */
  flow?: boolean;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  flow = false,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
const locale = Astro.currentLocale ?? config.site.lang;
const rssHref = getRelativeLocaleUrl(locale, "rss.xml");
const homeURL = getRelativeLocaleUrl(locale, "");

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/" || currentPath === homeURL;
const isReviews = currentPath.includes("/reviews");

const isActive = (id: string) =>
  id === "home" ? isHome : id === "reviews" ? isReviews : false;
---

<!doctype html>

<html
  dir={site.dir ?? "ltr"}
  lang={locale}
  class="overflow-y-scroll scroll-smooth"
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="icon" href={getAssetPath("favicon.ico")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <Font
      cssVariable="--font-manrope"
      preload={[
        { subset: "latin", weight: 400, style: "normal" },
        { subset: "latin", weight: 700, style: "normal" },
      ]}
    />

    <!-- PRIMARY META -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- OPEN GRAPH -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- TWITTER / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <meta name="theme-color" content="#fff9ef" />

    <slot name="head" />

    {
      site.googleVerification && (
        <meta name="google-site-verification" content={site.googleVerification} />
      )
    }

    <!-- THEME: initialise before paint -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = "light";
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") {
            theme = saved;
          } else if (
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches
          ) {
            theme = "dark";
          }
        } catch (error) {
          theme = "light";
        }
        root.setAttribute("data-theme", theme);
        root.classList.toggle("dark", theme === "dark");
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />

    <!-- ONOCRA DESIGN TOKENS: one palette and type scale shared by the sidebar,
         HubBar and the comparison flow. Change a colour here and all three follow. -->
    <style is:global>
      :root {
        /* ink and surfaces (warm paper, not stark white) */
        --on-ink: #14232b;
        --on-ink-2: #3a4a53;
        --on-muted: #596971;
        --on-surface: #ffffff;
        --on-surface-2: #f6f1e6;
        --on-line: #e3dac8;

        /* brand: forest green. Accent: ONOCRA orange, used sparingly */
        --on-forest: #1d5646;
        --on-forest-strong: #12392d;
        --on-forest-tint: #e6f0ea;
        --on-brand-ink: #ffffff; /* text on a forest fill */
        --on-accent: #d9540f;
        --on-accent-text: #b04109; /* 5.4:1 on white, safe for small text */
        --on-accent-tint: #fdeee2;

        --on-ring: rgba(29, 86, 70, 0.42);
        --on-shadow-sm: 0 1px 2px rgba(20, 35, 43, 0.06);
        --on-shadow-md: 0 1px 2px rgba(20, 35, 43, 0.05), 0 14px 34px -12px rgba(20, 35, 43, 0.16);
        --on-shadow-pop: 0 2px 6px rgba(20, 35, 43, 0.08), 0 22px 48px -14px rgba(20, 35, 43, 0.28);

        /* type. Add "Source Serif 4" to your Astro fonts for the best result; the stack falls back cleanly. */
        --on-display: "Source Serif 4", "Source Serif Pro", Charter, "Iowan Old Style", "Palatino Linotype", Georgia, serif;
        --on-sans: var(--font-manrope), ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      }
      html[data-theme="dark"] {
        --on-ink: #e9f0f2;
        --on-ink-2: #c4d0d6;
        --on-muted: #9db0b8;
        --on-surface: #1f2933;
        --on-surface-2: #27323d;
        --on-line: #36434f;
        --on-forest: #7fcfae;
        --on-forest-strong: #a8e2c8;
        --on-forest-tint: #213a32;
        --on-brand-ink: #0c2a20;
        --on-accent: #ff8a4d;
        --on-accent-text: #ffa06e;
        --on-accent-tint: #3a2a22;
        --on-ring: rgba(127, 207, 174, 0.5);
        --on-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.35);
        --on-shadow-md: 0 1px 2px rgba(0, 0, 0, 0.3), 0 14px 34px -12px rgba(0, 0, 0, 0.55);
        --on-shadow-pop: 0 2px 6px rgba(0, 0, 0, 0.4), 0 22px 48px -14px rgba(0, 0, 0, 0.7);
      }
      html {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        -webkit-text-size-adjust: 100%;
      }
    </style>

    <!-- ONOCRA SIDEBAR -->
    <style is:global>
      /* ---------- base / mobile: the sidebar is desktop-only.
         Below 900px the HubBar menu button carries the same links. ---------- */
      .onocra-site-shell {
        width: 100%;
        min-height: 100svh;
      }
      .onocra-sidebar {
        display: none;
      }
      /* Sticky HubBar must not hide anchor targets such as #reviews */
      html {
        scroll-padding-top: 84px;
      }

      @media (min-width: 900px) {
        .onocra-sidebar {
          display: block;
          position: fixed;
          inset: 0 auto 0 0;
          z-index: 60;
          width: 136px;
          height: 100svh;
          overflow: hidden;

          /* LIGHT THEME: independent of the ivory page canvas */
          background: linear-gradient(180deg, #d6e8dc 0%, #c1dbcb 54%, #b6d3c3 100%);
          border-right: 8px solid #a1c3b0;
          box-shadow:
            inset -2px 0 0 rgba(255, 255, 255, 0.32),
            3px 0 10px rgba(8, 67, 48, 0.12);
        }

        .onocra-site-content {
          grid-column: 2;
          min-width: 0;
          padding-left: 136px;
        }

        /* The inner column scrolls (scrollbar hidden) so nothing is ever cut off
           on short screens, which matters once a flow panel is added below the nav. */
        .onocra-sidebar-inner {
          width: 100%;
          height: 100svh;
          display: flex;
          flex-direction: column;
          align-items: center;
          padding: 10px 8px 14px;
          overflow-y: auto;
          overflow-x: hidden;
          scrollbar-width: none;
        }
        .onocra-sidebar-inner::-webkit-scrollbar {
          display: none;
        }

        .onocra-brand-zone {
          width: 100%;
          display: flex;
          flex-direction: column;
          align-items: center;
          flex: 0 0 auto;
        }

        .onocra-logo-link {
          width: 100%;
          height: 286px;
          display: flex;
          align-items: center;
          justify-content: center;
          text-decoration: none;
        }

        .onocra-logo {
          display: block;
          width: 126px;
          height: 276px;
          object-fit: contain;
        }

        .onocra-brand-divider {
          flex: 0 0 auto;
          width: calc(100% - 18px);
          height: 2px;
          margin: 0 auto 9px;
          border-radius: 999px;
          background: rgba(24, 85, 60, 0.35);
          box-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
        }

        .onocra-sidebar-nav {
          flex: 0 0 auto;
          width: 100%;
          display: flex;
          flex-direction: column;
          gap: 2px;
        }

        .onocra-sidebar-nav a {
          width: 100%;
          min-height: 56px;
          padding: 5px 7px;
          border-radius: 10px;
          display: grid;
          grid-template-columns: 30px minmax(0, 1fr);
          align-items: center;
          gap: 6px;
          color: #214d3c;
          text-decoration: none;
          transition: background-color 160ms ease, color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
        }

        .onocra-sidebar-nav a:hover {
          background: rgba(255, 255, 255, 0.48);
          box-shadow: inset 0 0 0 1px rgba(25, 99, 67, 0.12);
          transform: translateX(1px);
        }

        .onocra-sidebar-nav a.active {
          background: rgba(255, 255, 255, 0.64);
          box-shadow: inset 4px 0 0 #2b785b, inset 0 0 0 1px rgba(43, 120, 91, 0.18);
        }

        .onocra-sidebar-nav svg {
          width: 22px;
          height: 22px;
          justify-self: center;
          fill: none;
          stroke: currentColor;
          stroke-width: 1.8;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .onocra-sidebar-nav-label {
          display: block;
          color: inherit;
          font-family: var(--font-manrope), Arial, sans-serif;
          font-size: 13px;
          line-height: 1.22;
          font-weight: 700;
          letter-spacing: 0.005em;
          text-align: left;
          text-transform: none;
        }

        .onocra-sidebar-nav a.active .onocra-sidebar-nav-label {
          color: #174c38;
          font-weight: 800;
        }

        .onocra-sidebar-nav a.active svg {
          stroke: #174c38;
        }

        /* ---------- OPTIONAL FLOW MODE (not enabled in locked Reviews): compact the brand and nav to make room for the
           step panel. To keep the full-size logo on flow pages, delete the
           four rules in this block that mention .onocra-logo-link / .onocra-logo. ---------- */
        .has-flow .onocra-logo-link {
          height: 196px;
        }
        .has-flow .onocra-logo {
          width: 92px;
          height: 188px;
        }
        .has-flow .onocra-sidebar-nav {
          gap: 0;
        }
        .has-flow .onocra-sidebar-nav a {
          min-height: 40px;
          padding-block: 3px;
        }
        .has-flow .onocra-sidebar-nav-label {
          font-size: 12.5px;
        }
        .onocra-sidebar-extra {
          flex: 0 0 auto;
          width: 100%;
        }
        /* short laptop screens: compact further so the step panel is visible without scrolling */
        @media (max-height: 760px) {
          .has-flow .onocra-logo-link {
            height: 128px;
          }
          .has-flow .onocra-logo {
            width: 60px;
            height: 122px;
          }
          .has-flow .onocra-sidebar-nav a {
            min-height: 34px;
          }
        }

        /* DARK THEME: keep approved dark treatment */
        html[data-theme="dark"] .onocra-sidebar {
          background: linear-gradient(180deg, #202833, #1b232d);
          border-right: 12px solid #111820;
          box-shadow:
            inset -2px 0 0 rgba(255, 255, 255, 0.07),
            5px 0 0 rgba(50, 64, 77, 0.52),
            10px 0 18px rgba(0, 0, 0, 0.26);
        }

        html[data-theme="dark"] .onocra-brand-divider {
          background: rgba(255, 255, 255, 0.14);
          box-shadow: 0 1px 0 rgba(0, 0, 0, 0.55);
        }

        html[data-theme="dark"] .onocra-sidebar-nav a {
          color: #e6ebef;
        }

        html[data-theme="dark"] .onocra-sidebar-nav a:hover {
          background: rgba(255, 255, 255, 0.07);
        }

        html[data-theme="dark"] .onocra-sidebar-nav a.active {
          background: rgba(55, 190, 145, 0.16);
          box-shadow: inset 3px 0 0 #37be91;
        }

        html[data-theme="dark"] .onocra-sidebar-nav a.active .onocra-sidebar-nav-label {
          color: #f5f7f8;
        }

        html[data-theme="dark"] .onocra-sidebar-nav a.active svg {
          stroke: #62d2ad;
        }
      }
    </style>
  </head>

  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground min-h-svh"
  >
    <div class:list={["onocra-site-shell", { "has-flow": flow }]}>
      <!-- DESKTOP SIDEBAR (frozen on every page) -->
      <aside class="onocra-sidebar" aria-label="ONOCRA sidebar">
        <div class="onocra-sidebar-inner">
          <div class="onocra-brand-zone">
            <a href={homeURL} aria-label="ONOCRA home" class="onocra-logo-link">
              <img
                src="/homepage/LOGO.png"
                alt="ONOCRA pelican and chicks"
                class="onocra-logo"
              />
            </a>
          </div>

          <div class="onocra-brand-divider" aria-hidden="true"></div>

          <nav class="onocra-sidebar-nav" aria-label="ONOCRA navigation">
            {
              SITE_NAV.map((item) => (
                <a
                  href={`${homeURL}${item.hash}`}
                  class:list={{ active: isActive(item.id) }}
                  aria-current={isActive(item.id) && item.id === "home" ? "page" : undefined}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
                  <span class="onocra-sidebar-nav-label">{item.label}</span>
                </a>
              ))
            }
          </nav>

          <!-- Page-specific panel, e.g. the comparison steps. Empty on other pages. -->
          <div class="onocra-sidebar-extra">
            <slot name="sidebar" />
          </div>
        </div>
      </aside>

      <!-- PAGE CONTENT -->
      <div class="onocra-site-content">
        <slot />
      </div>
    </div>

    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
