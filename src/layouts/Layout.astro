---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;

const socialImageURL = new URL(
  ogImage,
  Astro.site ?? Astro.url
);

const locale =
  Astro.currentLocale ?? config.site.lang;

const rssHref = getRelativeLocaleUrl(
  locale,
  "rss.xml"
);

const homeURL = getRelativeLocaleUrl(
  locale,
  ""
);

const searchURL = getRelativeLocaleUrl(
  locale,
  "search"
);
---

<!doctype html>

<html
  dir={site.dir ?? "ltr"}
  lang={locale}
  class="overflow-y-scroll scroll-smooth"
  data-theme="light"
>
  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href={getAssetPath("favicon.svg")}
    />

    <link
      rel="icon"
      href={getAssetPath("favicon.ico")}
    />

    <link
      rel="canonical"
      href={canonicalURL}
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <Font
      cssVariable="--font-manrope"
      preload={[
        {
          subset: "latin",
          weight: 400,
          style: "normal",
        },
        {
          subset: "latin",
          weight: 700,
          style: "normal",
        },
      ]}
    />

    <!-- ==========================================
         PRIMARY META
    =========================================== -->

    <title>{title}</title>

    <meta
      name="title"
      content={title}
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="author"
      content={site.author}
    />

    <link
      rel="sitemap"
      href={getAssetPath("sitemap-index.xml")}
    />

    <!-- ==========================================
         OPEN GRAPH
    =========================================== -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content={site.title}
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:image"
      content={socialImageURL}
    />

    <!-- ==========================================
         TWITTER / X
    =========================================== -->

    <meta
      property="twitter:card"
      content="summary_large_image"
    />

    <meta
      property="twitter:url"
      content={canonicalURL}
    />

    <meta
      property="twitter:title"
      content={title}
    />

    <meta
      property="twitter:description"
      content={description}
    />

    <meta
      property="twitter:image"
      content={socialImageURL}
    />

    <!-- ==========================================
         RSS
    =========================================== -->

    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- ONOCRA browser colour -->

    <meta
      name="theme-color"
      content="#fff9ef"
    />

    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!-- ==========================================
         KEEP ONOCRA LIGHT
    =========================================== -->

    <script is:inline>
      (function () {
        const root =
          document.documentElement;

        root.setAttribute(
          "data-theme",
          "light"
        );

        root.classList.remove("dark");

        localStorage.setItem(
          "theme",
          "light"
        );

        window.__theme = {
          value: "light",
        };
      })();
    </script>

    <ClientRouter />

    <!-- ==========================================
         ONOCRA SIDEBAR
         OPTION 2 — EDITORIAL & ELEGANT
    =========================================== -->

    <style is:global>

      /* ==========================================
         BASE / MOBILE

         Mobile remains normal.
         Sidebar does not exist visually.
      =========================================== */

      .onocra-site-shell {
        width: 100%;
        min-height: 100svh;
      }

      .onocra-sidebar {
        display: none;
      }

      .onocra-site-content {
        width: 100%;
        min-width: 0;
      }


      /* ==========================================
         DESKTOP
      =========================================== */

      @media (min-width: 900px) {

        /* ========================================
           SITE SHELL
        ======================================== */

        .onocra-site-shell {
          display: grid;

          grid-template-columns:
            122px minmax(0, 1fr);

          align-items: stretch;
        }


        /* ========================================
           SIDEBAR RAIL
        ======================================== */

        .onocra-sidebar {
          display: block;

          min-height: 100%;

          background:
            var(--onocra-sage);

          border-right:
            1px solid
            rgba(7, 61, 50, 0.14);
        }


        .onocra-sidebar-inner {
          width: 100%;

          min-height: 100svh;

          display: flex;

          flex-direction: column;

          align-items: center;

          padding:
            12px 10px 32px;
        }


        /* ========================================
           BRAND ZONE

           Approximately 85% of opening viewport.
        ======================================== */

        .onocra-brand-zone {
          width: 100%;

          height: 84svh;

          min-height: 610px;

          display: flex;

          flex-direction: column;

          align-items: center;
        }


        /* ========================================
           LOGO

           THIS IS THE FIRST "O" OF ONOCRA
        ======================================== */

        .onocra-logo-link {
          width: 100%;

          height: 112px;

          flex-shrink: 0;

          display: flex;

          align-items: center;

          justify-content: center;

          text-decoration: none;
        }


        .onocra-logo {
          display: block;

          width: 100px;

          height: 100px;

          object-fit: contain;
        }


        /* ========================================
           REMAINING WORDMARK

           N
           O
           C
           R
           A
           .
        ======================================== */

        .onocra-vertical-wordmark {
  width: 100%;

  flex: 1;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: flex-start;

  gap: 30px;

  padding: 20px 0 18px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 42px;

  line-height: 1;

  font-weight: 700;

  color: #073d32;

  text-decoration: none;
}

.onocra-vertical-wordmark span {
  display: block;
}

.onocra-dot {
  width: 15px;

  height: 15px;

  display: block;

  border-radius: 999px;

  background: #f56622;

  font-size: 0;

  margin-top: 2px;
}


        /* ========================================
           DIVIDER
        ======================================== */

        .onocra-brand-divider {
          width: 54px;

          height: 1px;

          flex-shrink: 0;

          margin:
            0 auto 12px;

          background:
            rgba(7, 61, 50, 0.25);
        }


        /* ========================================
           NAVIGATION

           Home starts around bottom of opening
           screen. More controls follow as page
           continues downward.
        ======================================== */

        .onocra-sidebar-nav {
          width: 100%;

          display: flex;

          flex-direction: column;

          align-items: center;

          gap: 8px;
        }


        .onocra-sidebar-nav a {
          width: 100%;

          min-height: 82px;

          display: flex;

          flex-direction: column;

          align-items: center;

          justify-content: center;

          padding:
            10px 3px;

          border-radius: 16px;

          color: #073d32;

          text-decoration: none;

          transition:
            background-color 160ms ease,
            transform 160ms ease;
        }


        .onocra-sidebar-nav a:hover {
          background:
            rgba(255, 255, 255, 0.68);

          transform:
            translateY(-1px);
        }


        .onocra-sidebar-nav svg {
          width: 23px;

          height: 23px;

          stroke: #073d32;

          stroke-width: 2;
        }


        .onocra-sidebar-nav-label {
          display: block;

          margin-top: 7px;

          color: #073d32;

          font-family:
            var(--font-manrope),
            Arial,
            sans-serif;

          font-size: 10px;

          line-height: 1.15;

          font-weight: 700;

          letter-spacing: 0.08em;

          text-align: center;

          text-transform: uppercase;
        }

      }

    </style>

  </head>


  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground min-h-svh"
  >

    <!-- ==========================================
         ONOCRA SITE SHELL
    =========================================== -->

    <div class="onocra-site-shell">


      <!-- ========================================
           DESKTOP SIDEBAR
      ========================================= -->

      <aside
        class="onocra-sidebar"
        aria-label="ONOCRA sidebar"
      >

        <div class="onocra-sidebar-inner">


          <!-- ====================================
               BRANDING ZONE
          ===================================== -->

          <div class="onocra-brand-zone">


            <!-- ================================
                 LOGO = FIRST O

                 File:
                 public/logo.png
            ================================= -->

            <a
              href={homeURL}
              aria-label="ONOCRA home"
              class="onocra-logo-link"
            >

              <img
                src="/logo.png"
                alt="ONOCRA pelican and chicks"
                class="onocra-logo"
              />

            </a>


            <!-- ================================
                 N O C R A .
            ================================= -->

            <a
              href={homeURL}
              aria-label="ONOCRA home"
              class="onocra-vertical-wordmark"
            >

              <span>N</span>

              <span>O</span>

              <span>C</span>

              <span>R</span>

              <span>A</span>

              <span
                class="onocra-dot"
                aria-hidden="true"
              ></span>

            </a>

          </div>


          <!-- ====================================
               DIVIDER
          ===================================== -->

          <div
            class="onocra-brand-divider"
            aria-hidden="true"
          ></div>


          <!-- ====================================
               SIDEBAR NAVIGATION
          ===================================== -->

          <nav
            class="onocra-sidebar-nav"
            aria-label="ONOCRA quick navigation"
          >


            <!-- HOME -->

            <a
              href={homeURL}
              aria-label="Home"
            >

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >

                <path
                  d="m3 11 9-8 9 8"
                ></path>

                <path
                  d="M5 10v10h14V10"
                ></path>

                <path
                  d="M9 20v-6h6v6"
                ></path>

              </svg>

              <span
                class="onocra-sidebar-nav-label"
              >
                Home
              </span>

            </a>


            <!-- SEARCH -->

            <a
              href={searchURL}
              aria-label="Search ONOCRA"
            >

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >

                <circle
                  cx="11"
                  cy="11"
                  r="7"
                ></circle>

                <path
                  d="m20 20-3.5-3.5"
                ></path>

              </svg>

              <span
                class="onocra-sidebar-nav-label"
              >
                Search
              </span>

            </a>


            <!-- MENU -->

            <a
              href={`${homeURL}#topics`}
              aria-label="ONOCRA menu"
            >

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >

                <path
                  d="M4 7h16"
                ></path>

                <path
                  d="M4 12h16"
                ></path>

                <path
                  d="M4 17h16"
                ></path>

              </svg>

              <span
                class="onocra-sidebar-nav-label"
              >
                Menu
              </span>

            </a>


            <!-- CONTACT -->

            <a
              href={`${homeURL}#contact`}
              aria-label="Contact ONOCRA"
            >

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >

                <rect
                  x="3"
                  y="5"
                  width="18"
                  height="14"
                  rx="2"
                ></rect>

                <path
                  d="m3 7 9 6 9-6"
                ></path>

              </svg>

              <span
                class="onocra-sidebar-nav-label"
              >
                Contact
              </span>

            </a>

          </nav>

        </div>

      </aside>


      <!-- ========================================
           ALL EXISTING WEBSITE CONTENT
      ========================================= -->

      <div class="onocra-site-content">

        <slot />

      </div>

    </div>


    <script>
      import "@/scripts/theme";
    </script>

  </body>

</html>
